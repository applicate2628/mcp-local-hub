+func TestPortProbeTestHelperAdmission(t *testing.T) {
+	bin := portProbeFixtureBinaries(t)
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	const output = "port-probe fixture\n"
+	for _, tc := range []struct {
+		name, image, role string
+		args              []string
+		wantExit          int
+		wantOutput        string
+		wantCalls         []string
+	}{
+		{name: "ordinary netstat", image: "netstat", args: []string{"-ano"}, wantOutput: output, wantCalls: []string{"netstat"}},
+		{name: "unexpected wmic argv retains witness", image: "wmic", args: []string{"unexpected-query"}, wantExit: 93, wantCalls: []string{"wmic"}},
+		{name: "port plus oracle", image: "netstat", role: "oracle", args: []string{"-ano"}, wantExit: 3},
+		{name: "port plus vault", image: "netstat", role: "vault", args: []string{"-ano"}, wantExit: 3},
+		{name: "oracle plus port", role: "oracle", args: []string{callerStartTimeOracleSelector}, wantExit: 3},
+		{name: "vault plus port", role: "vault", args: []string{"-test.run=^TestVaultFlockHelperProcess$"}, wantExit: 3},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := usePortProbeFixture(t, bin, map[string]portProbeFixtureReply{
+				"netstat": {Output: output},
+				"wmic":    {Output: output},
+			})
+			dir := os.Getenv(portProbeFixtureDirEnv)
+			childImage := exe
+			if tc.image != "" {
+				name := tc.image
+				if runtime.GOOS == "windows" {
+					name += ".exe"
+				}
+				childImage = filepath.Join(bin, name)
+			}
+			env := os.Environ()
+			switch tc.role {
+			case "oracle":
+				env = append(env, callerStartTimeChildStateDirEnv+"="+callerStartTimeChildRole,
+					callerStartTimeChildDelayEnv+"="+callerStartTimeOracleDelayValue())
+			case "vault":
+				// Keep the negative-control child finite even if role admission
+				// regresses: it sees only these private, pre-released fixture paths.
+				release := filepath.Join(dir, "release")
+				if err := os.WriteFile(release, []byte("release"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				env = append(env, "MCPHUB_TEST_HOLD_VAULT_LOCK=1",
+					"MCPHUB_TEST_VAULT_PATH="+filepath.Join(dir, "vault"),
+					"MCPHUB_TEST_READY_PATH="+filepath.Join(dir, "ready"),
+					"MCPHUB_TEST_RELEASE_PATH="+release)
+			}
+			ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, childImage, tc.args...)
+			process.NoConsole(cmd)
+			cmd.WaitDelay = time.Second
+			cmd.Env = env
+			var stdout, stderr bytes.Buffer
+			cmd.Stdout, cmd.Stderr = &stdout, &stderr
+			// Run is the sole wait owner and settles this original fixture
+			// child before t.TempDir cleanup. No installed tool is executed.
+			runErr := cmd.Run()
+			if ctx.Err() != nil {
+				t.Fatalf("fixture child exceeded its deadline: %v", ctx.Err())
+			}
+			exitCode := 0
+			if runErr != nil {
+				var exitErr *exec.ExitError
+				if !errors.As(runErr, &exitErr) {
+					t.Fatalf("fixture child did not settle with an exit: %v", runErr)
+				}
+				exitCode = exitErr.ExitCode()
+			}
+			gotCalls := calls()
+			if exitCode != tc.wantExit || stdout.String() != tc.wantOutput || !reflect.DeepEqual(gotCalls, tc.wantCalls) {
+				t.Fatalf("exit=%d stdout=%q calls=%v stderr=%q, want exit=%d stdout=%q calls=%v",
+					exitCode, stdout.String(), gotCalls, stderr.String(), tc.wantExit, tc.wantOutput, tc.wantCalls)
+			}
+			if tc.role != "" {
+				if !strings.Contains(stderr.String(), "invalid") {
+					t.Fatalf("mixed role did not fail at TestMain admission: %q", stderr.String())
+				}
+				for _, leaf := range []string{"calls.txt", "ready", "vault.lock"} {
+					if _, err := os.Lstat(filepath.Join(dir, leaf)); !errors.Is(err, os.ErrNotExist) {
+						t.Fatalf("mixed role reached fixture I/O for %s: %v", leaf, err)
+					}
+				}
+			}
+		})
+	}
+}

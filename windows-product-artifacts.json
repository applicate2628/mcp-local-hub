{
  "schemaVersion": 4,
  "identityManifest": {
    "schema": "windows-product-identity-v2",
    "filename": "windows-product-identity.json"
  },
  "artifacts": [
    {
      "role": "product",
      "filename": "mcphub-product/mcphub.exe",
      "source": "./cmd/mcphub",
      "subsystem": 2,
      "productMetadata": true,
      "npmPayload": true,
      "npmBin": false
    },
    {
      "role": "launcher",
      "filename": "mcphub.exe",
      "source": "./cmd/mcphub-launcher",
      "subsystem": 3,
      "productMetadata": false,
      "npmPayload": true,
      "npmBin": false
    }
  ],
  "runtimePayload": {
    "schema": "hub-runtime-payload-v1",
    "releaseDescriptors": [
      "runtimes/python/release.yaml",
      "runtimes/uv/release.yaml"
    ],
    "filename": "mcphub-product/runtime-payload.json"
  }
}

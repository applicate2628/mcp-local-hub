===== BEGIN corrupt_release_test.go =====
Original-SHA256: 926bc14f26a51ec2f3a7f9d88d780e99c5f2f434a2ee560f7e9d072657d8f20c
Sanitized-content-SHA256: 926bc14f26a51ec2f3a7f9d88d780e99c5f2f434a2ee560f7e9d072657d8f20c

//go:build windows && amd64 && cgo
package caller
import("testing";"path/filepath")
func TestCorruptReleasePreservesDeallocationFact(t *testing.T){
 l,child,dir:=setup(t)
 o,_,err:=l.New(child,dir,[]string{"exit",filepath.Join(dir,"released"),"0","x"})
 if err!=nil{t.Fatal(err)};own(t,o)
 if _,err=o.Admit(true);err!=nil{t.Fatal(err)}
 out,err:=o.Finish(3000);if err!=nil||out.State!=complete{t.Fatalf("finish: %+v %v",out,err)}
 if err=o.Release();err==nil{t.Fatal("negative DLL did not corrupt release metadata")}
 if err=o.Release();err!=nil{t.Fatal("cleared native pointer was reused")}
 if err=l.Close();err!=nil{t.Fatalf("completed deallocation lost when response failed: %v",err)}
}
===== END corrupt_release_test.go =====


package caller
import("testing";"path/filepath")
// Scratch-only regression, run against an owned DLL with exactly one corrupted
// create-result size field. No runtime hooks are added to the committed code.
func TestCorruptCreateRetainsTransferredOwner(t *testing.T){
 l,child,dir:=setup(t)
 o,_,err:=l.New(child,dir,[]string{"exit",filepath.Join(dir,"never-admitted"),"0","x"})
 if o==nil { t.Fatal("transferred native owner discarded after metadata validation failure") }
 own(t,o)
 if err==nil { t.Fatal("negative DLL did not corrupt metadata") }
 if e:=l.Close();e==nil { t.Fatal("unload allowed while transferred owner remains live") }
}

index 0000000000000000000000000000000000000000..58cc84ca14fd26b277a63b47017aa100a2d99e48
--- /dev/null
+++ b/internal/process/rust_owner_foreground_windows_test.go
@@ -0,0 +1,290 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Callback fixtures exercise foreground observation and the sole facade wait;
+// they create no native child and make no claim of native process settlement.
+func TestRustForegroundWaitCancellationKeepsSoleWaitAndCache(t *testing.T) {
+	for _, knownBeforeCancel := range []bool{false, true} {
+		t.Run(fmt.Sprintf("known-before-cancel=%t", knownBeforeCancel), func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls, badCall := 0, false
+			owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				calls++
+				badCall = badCall || raw != 0x4242 || ms == 0 || ms > 50 || size != 32
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, PID: 42}
+				if calls > 1 || knownBeforeCancel {
+					// Root exit does not establish completion of the live Job member.
+					out.Flags, out.RootExit, out.Active = 3, 259, 1
+				}
+				if calls == 1 {
+					cancel()
+				}
+				return 0
+			}))
+			child := &rustContainedChild{owner: owner, library: owner.library}
+			original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+			first := original.WaitOriginalContext(ctx)
+			if !errors.Is(first.Error, context.Canceled) || first.Known != knownBeforeCancel ||
+				child.waitStarted.Load() != knownBeforeCancel || child.waitReturned.Load() != knownBeforeCancel ||
+				owner.cachedRootWait().Known != knownBeforeCancel || calls != 1 || badCall {
+				t.Fatalf("cancel-only observation consumed or lost the sole wait: root=%+v started=%t returned=%t calls=%d bad=%t",
+					first, child.waitStarted.Load(), child.waitReturned.Load(), calls, badCall)
+			}
+			select {
+			case <-original.waitDone:
+				if !knownBeforeCancel {
+					t.Fatal("pending canceled observation completed the sole waiter")
+				}
+			default:
+				if knownBeforeCancel {
+					t.Fatal("known root was not received by the sole waiter")
+				}
+			}
+			fresh, cancelFresh := context.WithCancel(context.Background())
+			defer cancelFresh()
+			want := OriginalRootWait{Known: true, ExitCode: 259}
+			got := original.WaitOriginalContext(fresh)
+			wantCalls := 2
+			if knownBeforeCancel {
+				wantCalls = 1
+			}
+			if got != want || calls != wantCalls || !child.waitStarted.Load() || !child.waitReturned.Load() ||
+				owner.raw != 0x4242 || owner.closeStarted || owner.library.activeOwners.Load() != 1 {
+				t.Fatalf("fresh foreground wait lost cache or closed live custody: got=%+v calls=%d", got, calls)
+			}
+			leave, err := owner.memberGate.enterQuery(nil)
+			if err != nil {
+				t.Fatalf("root observation sealed member queries: %v", err)
+			}
+			leave()
+			if got := original.WaitOriginal(); got != want || calls != wantCalls {
+				t.Fatalf("existing sole waiter was entered again: got=%+v calls=%d", got, calls)
+			}
+
+			// Simulate later allocation release. Historical root replay needs
+			// neither a live module nor another native observation.
+			owner.raw = 0
+			owner.library.ready = false
+			owner.library.closeAttempted = true
+			owner.library.activeOwners.Store(0)
+			if got := original.WaitOriginalContext(fresh); got != want || calls != wantCalls {
+				t.Fatalf("released original root cache touched native state: got=%+v calls=%d", got, calls)
+			}
+		})
+	}
+}
+
+func TestRustForegroundWaitLeavesStopAvailable(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	entered := make(chan struct{})
+	var waitCalls, stopCalls atomic.Int32
+	var stopped, badCall atomic.Bool
+	owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		if raw != 0x4242 || ms == 0 || ms > 50 || size != 32 {
+			badCall.Store(true)
+		}
+		if waitCalls.Add(1) == 1 {
+			close(entered)
+		}
+		*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, PID: 42}
+		if stopped.Load() {
+			*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 71}
+		}
+		return 0
+	}))
+	owner.library.procedures["mh_stop1"] = syscall.NewCallback(func(raw, code uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		stopCalls.Add(1)
+		if raw != 0x4242 || code != 71 || size != 48 {
+			badCall.Store(true)
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		stopped.Store(true)
+		return 0
+	})
+	child := &rustContainedChild{owner: owner, library: owner.library}
+	original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	waitDone := make(chan OriginalRootWait, 1)
+	stopDone := make(chan error, 1)
+	waitJoined, stopStarted, stopJoined := false, false, false
+	t.Cleanup(func() {
+		cancel()
+		if !waitJoined {
+			select {
+			case <-waitDone:
+			case <-time.After(3 * time.Second):
+				t.Error("foreground observer did not join")
+			}
+		}
+		if stopStarted && !stopJoined {
+			select {
+			case <-stopDone:
+			case <-time.After(3 * time.Second):
+				t.Error("Stop did not join")
+			}
+		}
+	})
+	go func() { waitDone <- original.WaitOriginalContext(ctx) }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("cancel-only foreground observer did not enter native wait")
+	}
+	stopStarted = true
+	go func() {
+		_, err := owner.Stop(71)
+		stopDone <- err
+	}()
+	select {
+	case err := <-stopDone:
+		stopJoined = true
+		if err != nil {
+			t.Fatalf("Stop was unavailable during pending foreground wait: %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("foreground wait prevented Stop from entering")
+	}
+	select {
+	case result := <-waitDone:
+		waitJoined = true
+		if result != (OriginalRootWait{Known: true, ExitCode: 71}) {
+			t.Fatalf("foreground observer lost stopped root: %+v", result)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("foreground wait did not observe root after Stop")
+	}
+	if stopCalls.Load() != 1 || waitCalls.Load() < 2 || badCall.Load() ||
+		!child.waitStarted.Load() || !child.waitReturned.Load() || owner.closeStarted || owner.raw != 0x4242 {
+		t.Fatalf("Stop/sole-wait/native-close separation changed: waits=%d stops=%d bad=%t",
+			waitCalls.Load(), stopCalls.Load(), badCall.Load())
+	}
+	before := waitCalls.Load()
+	if result := original.WaitOriginalContext(ctx); result != (OriginalRootWait{Known: true, ExitCode: 71}) || waitCalls.Load() != before {
+		t.Fatalf("completed foreground wait entered another native wait: %+v", result)
+	}
+}
+
+func TestRustForegroundWaitCancellationWhileLockContended(t *testing.T) {
+	for _, libraryLock := range []bool{false, true} {
+		t.Run(fmt.Sprintf("library-lock=%t", libraryLock), func(t *testing.T) {
+			calls := 0
+			owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				calls++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, Flags: 3, PID: 42, RootExit: 7, Active: 1}
+				return 0
+			}))
+			child := &rustContainedChild{owner: owner, library: owner.library}
+			original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+			ctx, cancel := context.WithCancel(context.Background())
+			blocked := make(chan struct{}, 1)
+			lock := &owner.mu
+			if libraryLock {
+				lock = &owner.library.mu
+			}
+			lock.Lock()
+			held, joined := true, false
+			done := make(chan OriginalRootWait, 1)
+			t.Cleanup(func() {
+				cancel()
+				if held {
+					lock.Unlock()
+				}
+				if !joined {
+					select {
+					case <-done:
+					case <-time.After(3 * time.Second):
+						t.Error("foreground lock observer did not join")
+					}
+				}
+			})
+			go func() { done <- original.WaitOriginalContext(rustRootWaitBlockedContext{ctx, blocked}) }()
+			select {
+			case <-blocked:
+			case <-time.After(3 * time.Second):
+				t.Fatal("foreground observer did not reach held lock")
+			}
+			cancel()
+			select {
+			case result := <-done:
+				joined = true
+				if !errors.Is(result.Error, context.Canceled) || result.Known || calls != 0 ||
+					child.waitStarted.Load() || child.waitReturned.Load() || owner.closeStarted {
+					t.Fatalf("lock cancellation entered native or sole wait: root=%+v calls=%d", result, calls)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("canceled foreground observation waited for unrelated lock release")
+			}
+			select {
+			case <-original.waitDone:
+				t.Fatal("lock cancellation consumed the sole wait result")
+			default:
+			}
+			lock.Unlock()
+			held = false
+			fresh, cancelFresh := context.WithCancel(context.Background())
+			defer cancelFresh()
+			if result := original.WaitOriginalContext(fresh); result != (OriginalRootWait{Known: true, ExitCode: 7}) || calls != 1 {
+				t.Fatalf("lock cancellation poisoned later root observation: root=%+v calls=%d", result, calls)
+			}
+		})
+	}
+}
+
+func TestRustForegroundWaitKeepsFiniteTerminalGuards(t *testing.T) {
+	for _, cached := range []bool{false, true} {
+		t.Run(fmt.Sprintf("cached=%t", cached), func(t *testing.T) {
+			waitCalls, stopCalls := 0, 0
+			owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				waitCalls++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+				return 0
+			}))
+			owner.library.procedures["mh_stop1"] = syscall.NewCallback(func(raw, code uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				stopCalls++
+				*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+				return 0
+			})
+			if cached {
+				owner.rootWait.Store(&rustRootWaitResult{Known: true, PID: 42, ExitCode: 7})
+			}
+			child := &rustContainedChild{owner: owner, library: owner.library}
+			original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if root, err := owner.WaitRootWithin(ctx); err == nil || root != (rustRootWaitResult{}) {
+				t.Fatalf("finite root API accepted deadline-free context: root=%+v err=%v", root, err)
+			}
+			if result, err := owner.FinishWithin(ctx); err == nil || result != (rustOwnerOutcome{}) {
+				t.Fatalf("finite finish API accepted deadline-free context: result=%+v err=%v", result, err)
+			}
+			if _, err := original.ObserveOriginal(ctx, false); err == nil {
+				t.Fatal("terminal observation accepted deadline-free context")
+			}
+			owner.memberGate.mu.Lock()
+			sealed, active, bounded := owner.memberGate.sealed, owner.memberGate.terminalActive, owner.memberGate.terminalBound
+			owner.memberGate.mu.Unlock()
+			if waitCalls != 0 || stopCalls != 0 || owner.closeStarted || sealed || active || bounded || child.waitStarted.Load() {
+				t.Fatalf("finite-context refusal entered native work or sealed custody: waits=%d stops=%d sealed=%t active=%t bounded=%t",
+					waitCalls, stopCalls, sealed, active, bounded)
+			}
+			wantCalls := 1
+			if cached {
+				wantCalls = 0
+			}
+			if result := original.WaitOriginalContext(ctx); result != (OriginalRootWait{Known: true, ExitCode: 7}) || waitCalls != wantCalls {
+				t.Fatalf("foreground context inherited finite-terminal restriction: result=%+v calls=%d", result, waitCalls)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_identity_windows.go b/internal/process/rust_owner_identity_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..ceffd4bfbd079c095eb44da2bf2f24ccb2d375c9
--- /dev/null
+++ b/internal/process/rust_owner_identity_windows.go
@@ -0,0 +1,246 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+)
+
+// Fixed identity ABI from experiments/rust-process-owner/ffi/include/identity_v1.h.
+type rustOwnerIdentityABI struct {
+	Size, Version, PID, JobMembership uint32
+	CreationTime100ns                 uint64
+	WaitState, SIDLen                 uint32
+	Image                             rustOwnerUTF16
+	SID                               [68]byte
+	Reserved                          uint32
+}
+type rustOwnerIdentityReport struct {
+	Size, Version, Stage, QueryErrorKind uint32
+	QueryNativeError, TokenCloseError    int32
+}
+type rustOwnerIdentityValue struct {
+	PID               uint32
+	CreationTime100ns uint64
+	JobMembership     uint32
+	WaitState         uint32
+	ImageUTF16        []uint16
+	TokenUserSID      []byte
+}
+
+var errRustOwnerIdentity = errors.New("invalid original Rust owner identity")
+
+var (
+	_ [120 - unsafe.Sizeof(rustOwnerIdentityABI{})]byte
+	_ [unsafe.Sizeof(rustOwnerIdentityABI{}) - 120]byte
+	_ [24 - unsafe.Sizeof(rustOwnerIdentityReport{})]byte
+	_ [unsafe.Sizeof(rustOwnerIdentityReport{}) - 24]byte
+)
+
+func copyRustOwnerIdentity(pointer *rustOwnerIdentityABI, bytes uintptr) (rustOwnerIdentityValue, error) {
+	reject := func(reason string) (rustOwnerIdentityValue, error) {
+		return rustOwnerIdentityValue{}, fmt.Errorf("%w: %s", errRustOwnerIdentity, reason)
+	}
+	if pointer == nil || bytes != 120 || uintptr(unsafe.Pointer(pointer))%unsafe.Alignof(rustOwnerIdentityABI{}) != 0 {
+		return reject("identity buffer layout")
+	}
+	raw := pointer
+	value := rustOwnerIdentityValue{
+		PID: raw.PID, CreationTime100ns: raw.CreationTime100ns,
+		JobMembership: raw.JobMembership, WaitState: raw.WaitState,
+	}
+	if raw.Size != 120 || raw.Version != 1 || raw.Reserved != 0 ||
+		value.PID == 0 || value.CreationTime100ns == 0 ||
+		(value.JobMembership != 1 && value.JobMembership != 2) ||
+		(value.WaitState != 1 && value.WaitState != 2) ||
+		(value.WaitState == 1 && value.JobMembership != 1) {
+		return reject("missing or inconsistent process facts")
+	}
+	n := int(raw.SIDLen)
+	if n < 8 || n > len(raw.SID) || raw.SID[0] != 1 || raw.SID[1] > 15 ||
+		n != 8+4*int(raw.SID[1]) {
+		return reject("invalid TokenUser SID")
+	}
+	for _, unused := range raw.SID[n:] {
+		if unused != 0 {
+			return reject("nonzero unused SID bytes")
+		}
+	}
+	if raw.Image.Data == nil || raw.Image.Len == 0 || raw.Image.Len > 32768 ||
+		uintptr(unsafe.Pointer(raw.Image.Data))%unsafe.Alignof(uint16(0)) != 0 {
+		return reject("invalid process image view")
+	}
+	value.ImageUTF16 = append([]uint16(nil), unsafe.Slice(raw.Image.Data, int(raw.Image.Len))...)
+	for _, unit := range value.ImageUTF16 {
+		if unit == 0 {
+			return reject("embedded NUL in process image")
+		}
+	}
+	value.TokenUserSID = append([]byte(nil), raw.SID[:n]...)
+	return value, nil
+}
+
+type rustOwnerIdentityQueryError struct {
+	Stage, Kind        uint32
+	Native, TokenClose int32
+}
+
+func (e *rustOwnerIdentityQueryError) Error() string {
+	return fmt.Sprintf("Rust owner identity stage=%d kind=%d native=%d token_close=%d",
+		e.Stage, e.Kind, e.Native, e.TokenClose)
+}
+func (e *rustOwnerIdentityQueryError) Unwrap() []error {
+	var causes []error
+	if e.Native != 0 {
+		causes = append(causes, syscall.Errno(uint32(e.Native)))
+	}
+	if e.TokenClose != 0 {
+		causes = append(causes, syscall.Errno(uint32(e.TokenClose)))
+	}
+	return causes
+}
+
+func decodeRustOwnerIdentityReport(r rustOwnerIdentityReport) (uint32, error) {
+	invalid := func(reason string) (uint32, error) {
+		return 0, fmt.Errorf("%w: %s", errRustOwnerIdentity, reason)
+	}
+	if r.Size != 24 || r.Version != 1 || r.Stage > 7 || r.QueryErrorKind > 4 ||
+		(r.QueryErrorKind == 1) != (r.QueryNativeError != 0) ||
+		(r.TokenCloseError != 0 && r.Stage != 6) {
+		return invalid("incompatible identity report")
+	}
+	failed := r.QueryErrorKind != 0 || r.TokenCloseError != 0
+	if r.Stage == 0 || r.Stage == 7 {
+		if failed {
+			return invalid("identity completion contradicts failure")
+		}
+		return r.Stage, nil
+	}
+	if !failed {
+		return invalid("identity failure omitted error")
+	}
+	return r.Stage, &rustOwnerIdentityQueryError{Stage: r.Stage, Kind: r.QueryErrorKind,
+		Native: r.QueryNativeError, TokenClose: r.TokenCloseError}
+}
+
+type rustOwnerQueryCall struct {
+	count int
+	value rustOwnerIdentityValue
+	err   error
+}
+
+// A Windows callback address cannot be unregistered. Allocate one per process,
+// not one per query. The opaque token is never a Go pointer exposed to Rust.
+var rustOwnerQueryCalls sync.Map
+var rustOwnerQuerySequence atomic.Uint64
+var rustOwnerQueryCallback = syscall.NewCallback(func(pointer *rustOwnerIdentityABI, bytes, token uintptr) (ret uintptr) {
+	stateValue, ok := rustOwnerQueryCalls.Load(token)
+	if !ok {
+		return 0
+	}
+	state := stateValue.(*rustOwnerQueryCall)
+	defer func() {
+		if v := recover(); v != nil {
+			state.value = rustOwnerIdentityValue{}
+			state.err = errors.Join(state.err, fmt.Errorf("%w: receiver panic", errRustOwnerIdentity))
+		}
+	}()
+	state.count++
+	if state.count != 1 {
+		state.value = rustOwnerIdentityValue{}
+		state.err = errors.Join(state.err, fmt.Errorf("%w: duplicate receiver", errRustOwnerIdentity))
+		return 0
+	}
+	state.value, state.err = copyRustOwnerIdentity(pointer, bytes)
+	return 0
+})
+
+// QueryIdentity reads original retained-process facts without admission/resume.
+// The callback copies all native memory synchronously; no raw pointer escapes.
+func (owner *rustNativeOwner) QueryIdentity() (rustOwnerIdentityValue, error) {
+	if owner == nil || owner.memberGate == nil {
+		return rustOwnerIdentityValue{}, errors.New("missing original Rust query custody")
+	}
+	exit, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	defer exit()
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	return owner.queryIdentityLocked(nil)
+}
+
+// queryIdentityLocked is used for SID formatting while retaining the same
+// owner lock through query, conversion and receipt validation.
+func (owner *rustNativeOwner) queryIdentityLocked(ctx context.Context) (rustOwnerIdentityValue, error) {
+	library := owner.library
+	if library == nil {
+		return rustOwnerIdentityValue{}, errors.New("original Rust library unavailable")
+	}
+	if ctx == nil {
+		library.mu.Lock()
+	} else if err := lockRustCreatorContext(ctx, &library.mu); err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	defer library.mu.Unlock()
+	if owner.raw == 0 || !library.ready || library.closeAttempted {
+		return rustOwnerIdentityValue{}, errors.New("Rust original owner was released")
+	}
+	address := library.procedures["mh_query_identity1"]
+	if address == 0 {
+		return rustOwnerIdentityValue{}, errors.New("read-only identity export unsupported")
+	}
+	token := uintptr(rustOwnerQuerySequence.Add(1))
+	if token == 0 {
+		return rustOwnerIdentityValue{}, errors.New("identity token exhausted")
+	}
+	state := &rustOwnerQueryCall{}
+	rustOwnerQueryCalls.Store(token, state)
+	defer rustOwnerQueryCalls.Delete(token)
+	var report rustOwnerIdentityReport
+	var output rustOwnerOutcome
+	// Rust completes the outcome after the Go receiver returns. Keep both
+	// caller-owned records at fixed addresses throughout that reentry.
+	var pinned runtime.Pinner
+	pinned.Pin(&report)
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(address,
+		owner.raw, 1, rustOwnerQueryCallback, token,
+		uintptr(unsafe.Pointer(&report)), uintptr(unsafe.Sizeof(report)),
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	outcome, outErr := decodeRustOwnerOutcome(uint32(status), output)
+	stage, reportErr := decodeRustOwnerIdentityReport(report)
+	var coherenceErr error
+	switch stage {
+	case 0:
+		if (uint32(status) != 1 && uint32(status) != 2 && uint32(status) != 5) || state.count != 0 {
+			coherenceErr = fmt.Errorf("%w: preflight and receiver contradict", errRustOwnerIdentity)
+		}
+	case 7:
+		if status != 0 || state.count != 1 || outcome.PID != state.value.PID ||
+			(outcome.Flags&1 != 0 && state.value.WaitState != 2) {
+			coherenceErr = fmt.Errorf("%w: completed query contradicts owner", errRustOwnerIdentity)
+		}
+	default:
+		if uint32(status) != 5 || state.count != 0 {
+			coherenceErr = fmt.Errorf("%w: failed query published identity", errRustOwnerIdentity)
+		}
+	}
+	if outcome.State != 0 || outcome.Flags&2 != 0 {
+		coherenceErr = errors.Join(coherenceErr, fmt.Errorf("%w: query reported settlement", errRustOwnerIdentity))
+	}
+	if err := errors.Join(outErr, reportErr, state.err, coherenceErr); err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	return state.value, nil
+}

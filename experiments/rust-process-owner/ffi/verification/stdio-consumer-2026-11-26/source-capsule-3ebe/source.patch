+ * Snapshot pre/post/rows/acquisition completeness remain historical after close;
+ * only resource close fields update. Snapshot copy never queries native state. */
+typedef void (*mh_members_snapshot_receive_fn)(
+    const mh_members_snapshot*, uint32_t, uintptr_t);
+typedef uint32_t (*mh_members_snapshot_fn)(mh_owner*, uint32_t version,
+    uint64_t generation, mh_members_snapshot_receive_fn, uintptr_t,
+    mh_members_report*, uint32_t, mh_out*, uint32_t);
+
+/* Revalidate the same retained handles and immutable complete baseline.
+ * required_pid=0 checks the whole set; nonzero additionally requires that PID.
+ * Uses one absolute deadline from budget_ms (0..60000), never reopens by PID,

+// Run ONLY with the separately qualified immutable pre-v3 native tuple.
+// Normal full Go gates have no integration tuple and retain the native fixture skip.
+// A new v3 DLL is deliberately not accepted as a successful legacy-refusal test.
+func TestRustOwnerForegroundV3OldNativeDLLRefusal(t *testing.T) {
+	var source *os.File
+	t.Cleanup(func() {
+		if source != nil {
+			if err := source.Close(); err != nil {
+				t.Error(err)
+			}
+		}
+	})
+	f := newRustFacadeNativeFixture(t) // original recovery precedes source close
+	missing := filepath.Join(f.cwd, "v3-legacy-never-created.exe")
+	rustIONativeAbsent(t, missing)
+	var err error
+	source, err = os.OpenFile(os.DevNull, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// No child can use the source even if a wrong DLL understands v3: the
+	// deliberately missing absolute image still prevents CreateProcess success.
+	address := f.library.procedures["mh_create_io1"]
+	calls, status := 0, uint32(0)
+	f.library.procedures["mh_create_io1"] = syscall.NewCallback(func(
+		request, requestBytes, ioContext, ioBytes, slot, output, outBytes uintptr,
+	) uintptr {
+		calls++
+		code, _, _ := syscall.SyscallN(address, request, requestBytes, ioContext, ioBytes, slot, output, outBytes)
+		status = uint32(code)
+		return code
+	})
+	argv0 := "v3-legacy-probe"
+	owner, out, err := f.library.startRetainedRustOwnerContext(rustStdioTestContext(t), missing, f.cwd, nil,
+		&rustOwnerLaunchIO{argv0: &argv0, foreground: true, environment: []rustOwnerEnvironmentEntry{},
+			streams: rustOwnerStdio{Stdin: source, Stdout: source, Stderr: source}},
+		func(original *rustNativeOwner) error { f.owner = original; return nil })
+	t.Logf("actual old DLL request-v3 refusal: status=%d outcome=%+v cause=%v", status, out, err)
+	if calls != 1 || status != 2 || err == nil || errors.Is(err, errRustOwnerOutcome) ||
+		out != (rustOwnerOutcome{Size: 48, Version: 1}) || owner == nil || owner != f.owner || f.owner == nil ||
+		f.owner.raw != 0 || !f.owner.createNoChild.Load() || f.library.activeOwners.Load() != 0 {
+		t.Fatalf("old DLL did not refuse v3 before creation: calls=%d status=%d owner=%p outcome=%+v err=%v", calls, status, owner, out, err)
+	}
+	rustIONativeAbsent(t, f.marker)
+}

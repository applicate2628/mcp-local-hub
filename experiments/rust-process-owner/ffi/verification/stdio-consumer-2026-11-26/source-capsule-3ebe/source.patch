+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+// Capture the first successful cancellation check before cancellation. This
+// makes the initial-library case observe the gap between that check and lock
+// admission, rather than accidentally cancelling before start runs at all.
+type rustStartAdmissionContext struct {
+	context.Context
+	checked chan struct{}
+	once    sync.Once
+}
+
+func (c *rustStartAdmissionContext) Err() error {
+	err := c.Context.Err()
+	c.once.Do(func() { close(c.checked) })
+	return err
+}
+
+// A cancelled start must not wait for a competing owner/module operation just
+// to abandon preparation and drop its module reservation. No native call is
+// possible in this fixture: the export map is deliberately empty.
+func TestRustRetainedCreatorCancelledAdmissionReturnsBeforeUnlock(t *testing.T) {
+	for _, stage := range []string{"initial-library", "retained-library", "retained-owner"} {
+		t.Run(stage, func(t *testing.T) {
+			library := &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{}}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			unlockReady := make(chan func(), 1)
+			checked := make(chan struct{})
+			if stage == "initial-library" {
+				ctx = &rustStartAdmissionContext{Context: ctx, checked: checked}
+				library.mu.Lock()
+				unlockReady <- library.mu.Unlock
+			}
+			type result struct {
+				owner, retained *rustNativeOwner
+				out             rustOwnerOutcome
+				err             error
+			}
+			done := make(chan result, 1)
+			go func() {
+				var retained *rustNativeOwner
+				owner, out, err := library.startRetainedRustOwner(ctx, "C:\\fixture\\child.exe", "C:\\fixture", nil,
+					func(original *rustNativeOwner) error {
+						retained = original
+						switch stage {
+						case "retained-library":
+							library.mu.Lock()
+							unlockReady <- library.mu.Unlock
+						case "retained-owner":
+							original.mu.Lock()
+							unlockReady <- original.mu.Unlock
+						}
+						return nil
+					})
+				done <- result{owner, retained, out, err}
+			}()
+			var unlock func()
+			select {
+			case unlock = <-unlockReady:
+			case <-time.After(2 * time.Second):
+				cancel()
+				joinTimer := time.NewTimer(2 * time.Second)
+				defer joinTimer.Stop()
+				for {
+					select {
+					case lateUnlock := <-unlockReady:
+						lateUnlock()
+					case <-done:
+						select {
+						case lateUnlock := <-unlockReady:
+							lateUnlock()
+						default:
+						}
+						t.Fatal("start did not reach the controlled admission boundary")
+					case <-joinTimer.C:
+						t.Fatal("start did not join after admission-boundary watchdog")
+					}
+				}
+			}
+			if stage == "initial-library" {
+				select {
+				case <-checked:
+				case <-time.After(2 * time.Second):
+					unlock()
+					cancel()
+					select {
+					case <-done:
+					case <-time.After(2 * time.Second):
+						t.Error("start did not join after early unlock")
+					}
+					t.Fatal("start never checked its initial context")
+				}
+			}
+			cancel()
+			var got result
+			returned := false
+			select {
+			case got = <-done:
+				returned = true
+			case <-time.After(2 * time.Second):
+				t.Error("cancelled start waited for the contested mutex")
+			}
+			// Always unblock and join even on the historical failing path.
+			unlock()
+			if !returned {
+				select {
+				case got = <-done:
+				case <-time.After(2 * time.Second):
+					t.Fatal("start did not terminate after controlled unlock")
+				}
+			}
+			if !errors.Is(got.err, context.Canceled) || got.out.PID != 0 {
+				t.Fatalf("cancelled start: outcome=%+v err=%v", got.out, got.err)
+			}
+			if stage == "initial-library" {
+				if returned && (got.owner != nil || got.retained != nil) {
+					t.Fatal("initial lock refusal published a retained owner")
+				}
+			} else if got.owner == nil || got.owner != got.retained {
+				t.Fatal("post-retention refusal replaced the original owner")
+			}
+			if got.owner != nil {
+				if got.owner.raw != 0 {
+					t.Fatal("cancelled admission created native ownership")
+				}
+				if err := got.owner.Release(); err != nil {
+					t.Fatalf("abandoned preparation still claims to be creating: %v", err)
+				}
+			}
+			if err := library.Close(); err != nil {
+				t.Fatalf("abandoned start leaked its library reservation: %v", err)
+			}
+		})
+	}
+}

+	}
+}
+
+func TestPrepareRustOwnerCommandUsesActualOrdinalEquality(t *testing.T) {
+	// General Unicode casing does not determine the Windows ordinal table.
+	// These explicit fixtures never include the real parent's environment.
+	for _, tc := range []struct {
+		name string
+		env  []string
+	}{
+		{"sigma-spellings", []string{"σ=first", "ς=second"}},
+		{"unicode-last-wins", []string{"ТЕСТ=first", "тест=second"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := rustOwnerCommandFixture()
+			cmd.Env = append([]string{"SystemRoot="}, tc.env...)
+			effective := cmd.Environ()
+			names := make([]string, 0, len(effective))
+			values := make(map[string]string, len(effective))
+			for _, entry := range effective {
+				name, value, ok := strings.Cut(entry, "=")
+				if !ok || name == "" {
+					t.Fatal("explicit test fixture has a malformed effective entry")
+				}
+				names = append(names, name)
+				values[name] = value
+			}
+			t.Logf("explicit fixture effective names: %q", names)
+			collision := false
+			for i := range names {
+				for j := i + 1; j < len(names); j++ {
+					order := rustCommandOrdinalOracle(t, names[i], names[j])
+					t.Logf("ordinal(%q, %q) = %d", names[i], names[j], order)
+					collision = collision || order == 2 // CSTR_EQUAL.
+				}
+			}
+
+			got, err := prepareRustOwnerCommand(cmd)
+			if collision {
+				if err == nil || got.program != "" || got.environment != nil {
+					t.Fatal("an actual remaining Windows ordinal collision was accepted")
+				}
+				return
+			}
+			if err != nil || len(got.environment) != len(effective) {
+				t.Fatalf("distinct effective names were rejected or lost: %v", err)
+			}
+			for i, entry := range got.environment {
+				value, present := values[entry.Name]
+				if !present || value != entry.Value {
+					t.Fatal("materialization changed the actual effective name or value")
+				}
+				delete(values, entry.Name)
+				if i > 0 && rustCommandOrdinalOracle(t, got.environment[i-1].Name, entry.Name) != 1 {
+					t.Fatal("materialized names are not strictly Windows ordinal sorted")
+				}
+			}
+			if len(values) != 0 {
+				t.Fatal("materialization silently dropped an effective name")
+			}
+		})
+	}
+}
+
+func rustCommandOrdinalOracle(t *testing.T, left, right string) int {
+	t.Helper()
+	l, err := syscall.UTF16FromString(left)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := syscall.UTF16FromString(right)
+	if err != nil {
+		t.Fatal(err)
+	}
+	compare := windows.NewLazySystemDLL("kernel32.dll").NewProc("CompareStringOrdinal")
+	if err := compare.Find(); err != nil {
+		t.Fatal(err)
+	}
+	order, _, callErr := compare.Call(
+		uintptr(unsafe.Pointer(&l[0])), uintptr(len(l)-1),
+		uintptr(unsafe.Pointer(&r[0])), uintptr(len(r)-1), 1)
+	runtime.KeepAlive(l)
+	runtime.KeepAlive(r)
+	if order < 1 || order > 3 {
+		t.Fatalf("Windows ordinal fixture oracle failed: %v", callErr)
+	}
+	return int(order)
+}
+
+func TestPrepareRustOwnerCommandRejectsUnsupportedEnvironmentWithoutDisclosure(t *testing.T) {
+	const privateName = "OWNED_PRIVATE_NAME"
+	const privateValue = "owned-private-value"
+	for _, env := range [][]string{
+		{privateName + "=" + privateValue + "\x00", privateName + "=later"},
+		{"=D=D:\\private"},
+		{"=DD:=D:\\private"},
+		{"=1:=D:\\private"},
+		{"=Ä:=D:\\private"},
+		{"==D:=D:\\private"},
+		{"=D:TAIL=D:\\private"},
+		{"=D:=D:\\private\x00", "=d:=D:\\later"},
+		{"malformed-without-equals"},
+		{"=" + privateValue},
+		{privateName + "=\xff"},
+	} {
+		cmd := rustOwnerCommandFixture()
+		cmd.Env = append([]string{"SystemRoot="}, env...)
+		before := slices.Clone(cmd.Env)
+		got, err := prepareRustOwnerCommand(cmd)
+		if err == nil || got.program != "" || got.environment != nil {
+			t.Fatal("unsupported environment was accepted or published partial inputs")
+		}
+		if strings.Contains(err.Error(), privateName) || strings.Contains(err.Error(), privateValue) {
+			t.Fatal("materialization disclosed an environment name or value")
+		}
+		if !slices.Equal(cmd.Env, before) {
+			t.Fatal("refused environment mutated the caller's input")
+		}
+	}
+}
diff --git a/internal/process/rust_owner_contained_native_windows_test.go b/internal/process/rust_owner_contained_native_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a67d5d1c6842fcb5cae1455f50590568e126bec6
--- /dev/null
+++ b/internal/process/rust_owner_contained_native_windows_test.go
@@ -0,0 +1,166 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// The named, marked test executable selects its real adjacent admitted DLL.
+// This is native receiver qualification, not a distributable Product receipt.
+func TestRustOwnerContainedNativeMarkedSelectionAndSettlement(t *testing.T) {
+	for _, observed := range []bool{false, true} {
+		route := "ordinary"
+		if observed {
+			route = "observed"
+		}
+		for _, mode := range []string{"stdio", "relative", "detach-ready", "consumer", "missing"} {
+			t.Run(route+"/"+mode, func(t *testing.T) {
+				selected, err := ProductRustOwnerEnabled()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !selected {
+					t.Skip("requires a marked Product test executable and qualified native tuple")
+				}
+				f := newRustFacadeNativeFixture(t)
+				// The integration helper verified the explicit input tuple.
+				// The public receiver must independently open its own bundle.
+				if err := f.library.Close(); err != nil {
+					t.Fatal(err)
+				}
+				f.library = nil
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancel()
+				deadline, _ := ctx.Deadline()
+				var stdout, stderr bytes.Buffer
+				options := ContainedStreamOptions{
+					CleanupTimeout: 5 * time.Second, AbsoluteCleanupDeadline: deadline.Add(5 * time.Second),
+					StdoutByteLimit: 4096, StderrByteLimit: 4096, Stderr: &stderr,
+				}
+				childMode := mode
+				if mode == "consumer" {
+					childMode = "block"
+				}
+				if mode == "missing" || mode == "relative" {
+					childMode = "stdio"
+				}
+				cmd := rustFacadeNativeCommand(f, childMode)
+				cmd.Args[0] = "contained-child.exe"
+				// Exercise the real caller shape: absolute lookup result,
+				// leaf argv[0], uncaptured current directory, explicit Env.
+				cmd.Dir = ""
+				if mode == "missing" {
+					cmd.Path = filepath.Join(f.cwd, "absent-owned-fixture.exe")
+				}
+				if mode == "relative" {
+					parentCwd, err := os.Getwd()
+					if err != nil {
+						t.Fatal(err)
+					}
+					cmd.Path, err = filepath.Rel(parentCwd, cmd.Path)
+					if err != nil {
+						t.Fatal(err)
+					}
+					cmd.Dir = f.cwd
+				}
+				originalPath, originalDir := cmd.Path, cmd.Dir
+				originalArgs := append([]string(nil), cmd.Args...)
+				consumerErr := errors.New("owned contained consumer stop")
+				consume := func(r io.Reader) error {
+					if mode == "consumer" {
+						return consumerErr
+					}
+					_, err := io.Copy(&stdout, r)
+					return err
+				}
+				var receipt ContainedStreamReceiptV1
+				var captured *productRustContainedChild
+				// Retain the exact selected adapter only for fixture recovery.
+				// The production dependency itself performs backend selection.
+				deps := defaultContainedStreamDependencies(ctx)
+				factory := deps.newChild
+				deps.newChild = func(command *exec.Cmd) (containedChild, error) {
+					child, err := factory(command)
+					var ok bool
+					captured, ok = child.(*productRustContainedChild)
+					if err == nil && !ok {
+						return child, errors.New("marked contained receiver selected another owner")
+					}
+					return child, err
+				}
+				var output *ContainedStreamReceiptV1
+				if observed {
+					output = &receipt
+				}
+				err = runContainedStreamCore(ctx, cmd, options, consume, deps, output)
+				if captured != nil {
+					f.owner, f.library = captured.owner, captured.library
+				}
+				if captured == nil || f.library == nil {
+					t.Fatalf("marked receiver did not retain its Product adapter: %v", err)
+				}
+				if cmd.Path != originalPath || cmd.Dir != originalDir || cmd.Args[0] != originalArgs[0] || cmd.Process != nil ||
+					cmd.ProcessState != nil || cmd.Stdin != nil || cmd.Stdout != nil || cmd.Stderr != nil {
+					t.Fatal("Rust contained receiver mutated caller command or fabricated Go process state")
+				}
+				var lifecycle *ContainedRunError
+				switch mode {
+				case "stdio", "relative":
+					if err != nil || stdout.Len() != 0 || !bytes.Equal(stderr.Bytes(), []byte("native-stderr\x00\xff")) {
+						t.Fatalf("NUL stdin / binary stderr: err=%v stdout=%x stderr=%x", err, stdout.Bytes(), stderr.Bytes())
+					}
+				case "detach-ready":
+					if !errors.As(err, &lifecycle) || lifecycle.Stage != ContainedStageExit ||
+						lifecycle.ExitCode == nil || *lifecycle.ExitCode != 7 || lifecycle.CleanupCause != nil {
+						t.Fatalf("root-before-descendant EOF outcome: %#v", err)
+					}
+				case "consumer":
+					if !errors.As(err, &lifecycle) || lifecycle.Stage != ContainedStageStdout ||
+						!errors.Is(lifecycle.Cause, consumerErr) || lifecycle.CleanupCause != nil {
+						t.Fatalf("consumer error priority/cleanup: %#v", err)
+					}
+				case "missing":
+					if !errors.As(err, &lifecycle) || lifecycle.Stage != ContainedStageStart ||
+						lifecycle.CleanupCause != nil || !captured.containedNoChildKnown() {
+						t.Fatalf("native create refusal lost positive no-child evidence: %#v", err)
+					}
+				}
+				if captured.owner != nil && captured.owner.raw != 0 {
+					t.Fatal("contained native allocation remains retained after completed cleanup")
+				}
+				if !captured.closeReturned || !captured.library.closeAttempted ||
+					captured.library.handle != 0 || captured.library.activeOwners.Load() != 0 {
+					t.Fatal("contained native release did not consume its owned DLL")
+				}
+				if mode != "missing" && (!captured.waitStarted.Load() || !captured.waitReturned.Load()) {
+					t.Fatal("contained receiver did not join its original root waiter")
+				}
+				if observed {
+					if receipt.NativeSettlement == nil || !receipt.NativeSettlement.Complete() ||
+						(mode != "missing" && (!receipt.IOSettlement.Stdout.WorkerComplete || !receipt.IOSettlement.Stderr.WorkerComplete)) {
+						t.Fatalf("native settlement or readers incomplete: %+v", receipt)
+					}
+					native := receipt.NativeSettlement.Snapshot()
+					if native.MembersExited || native.AccountingKnown || len(native.CapturedMemberPIDs) != 0 {
+						t.Fatalf("aggregate Rust Job proof fabricated individual census: %+v", native)
+					}
+					if mode != "consumer" && !receipt.IOSettlement.Complete() {
+						t.Fatalf("drained/closed stream receipt incomplete: %+v", receipt.IOSettlement)
+					}
+					if mode == "detach-ready" && (!receipt.RootWaitKnown || receipt.RootExitCode != 7) {
+						t.Fatalf("original root result changed during descendant cleanup: %+v", receipt)
+					}
+				}
+			})
+		}
+	}
+}

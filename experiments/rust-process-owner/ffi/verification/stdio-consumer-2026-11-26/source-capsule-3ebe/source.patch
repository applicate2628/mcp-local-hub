+	f.owner.library.procedures["mh_stop1"] = syscall.NewCallback(func(raw, code uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		f.stopCalls++
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		cancel() // The real terminal status succeeds before its observer cancels.
+		return 0
+	})
+	view, err := original.ObserveOriginal(ctx, false)
+	if !errors.Is(err, context.Canceled) || view.TerminalAction != string(creatorTerminalRequestSucceeded) ||
+		view.OriginalJobExited || f.stopCalls != 1 || f.waitCalls != 0 || f.closeCalls != 0 {
+		t.Fatalf("observer cancellation rewrote native Stop: view=%+v err=%v stop=%d wait=%d close=%d",
+			view, err, f.stopCalls, f.waitCalls, f.closeCalls)
+	}
+	replayed, replayErr := original.ObserveOriginal(ctx, false)
+	if replayed.TerminalAction != view.TerminalAction || !errors.Is(replayErr, context.Canceled) || f.stopCalls != 1 {
+		t.Fatalf("canceled terminal receipt was repeated or rewritten: view=%+v err=%v calls=%d", replayed, replayErr, f.stopCalls)

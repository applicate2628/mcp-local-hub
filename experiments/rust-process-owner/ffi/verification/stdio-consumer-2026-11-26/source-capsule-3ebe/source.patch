+func TestCanonicalNativeExternalChannelRejectsCrossSlotAndEndpointDrift(t *testing.T) {
+	base := canonicalnativefixture.Channel{
+		Version: canonicalnativefixture.Version, Root: `D:\dev\ChatGPT\canonical-channel-data`,
+		RunNonce: strings.Repeat("a", 64), CanonicalPlanSHA256: strings.Repeat("b", 64),
+		Profile: "full", SourceDir: `D:\dev\ChatGPT\source\internal\cli`,
+		Binary:       canonicalnativefixture.ImageInput{Path: `D:\dev\ChatGPT\binary\mcphub.exe`, SHA256: strings.Repeat("c", 64)},
+		Fixture:      canonicalnativefixture.ImageInput{Path: `D:\dev\ChatGPT\fixture.json`, SHA256: strings.Repeat("d", 64)},
+		WorkDeadline: "2026-11-20T12:00:30Z", CleanupDeadline: "2026-11-20T12:00:40Z",
+	}
+	base.Slots = []canonicalnativefixture.SlotBinding{
+		{Test: canonicalnativefixture.TestGUIReplay, Slot: "gui-replay", Nonce: strings.Repeat("1", 64)},
+		{Test: canonicalnativefixture.TestSuccessor, Slot: "successor", Nonce: strings.Repeat("2", 64)},
+	}
+	path := filepath.Join(base.Root, "channel", "channel.json")
+	slot, end, err := canonicalNativeExternalSlot(path, base, canonicalnativefixture.TestGUIReplay)
+	if err != nil || slot != base.Slots[0] || !end.Equal(time.Date(2026, 11, 20, 12, 0, 30, 0, time.UTC)) {
+		t.Fatalf("consistent full DATA control: slot=%+v end=%v err=%v", slot, end, err)
+	}
+	cases := []struct {
+		name   string
+		change func(*canonicalnativefixture.Channel)
+	}{
+		{"unsupported-profile", func(c *canonicalnativefixture.Channel) { c.Profile = "default" }},
+		{"missing-full-slot", func(c *canonicalnativefixture.Channel) { c.Slots = c.Slots[:1] }},
+		{"duplicate-full-slot", func(c *canonicalnativefixture.Channel) { c.Slots[1] = c.Slots[0] }},
+		{"crossed-test-slot", func(c *canonicalnativefixture.Channel) { c.Slots[0].Slot = "successor" }},
+		{"reused-case-nonce", func(c *canonicalnativefixture.Channel) { c.Slots[1].Nonce = c.Slots[0].Nonce }},
+		{"focused-other-case", func(c *canonicalnativefixture.Channel) { c.Profile = "focused"; c.Slots = c.Slots[1:] }},
+		{"cleanup-end-drift", func(c *canonicalnativefixture.Channel) { c.CleanupDeadline = "2026-11-20T12:00:41Z" }},

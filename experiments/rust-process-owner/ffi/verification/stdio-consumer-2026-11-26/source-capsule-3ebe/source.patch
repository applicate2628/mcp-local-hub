+func TestRustOwnerNativeStopFailureKeepsOriginalGateSealed(t *testing.T) {
+	calls := 0
+	failedStop := syscall.NewCallback(func(raw, code uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		calls++
+		if raw != 0x1357 || code != 19 || out == nil || size != 48 {
+			return 1
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42, NativeError: 5}
+		return 3
+	})
+	library := &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{"mh_stop1": failedStop}}
+	owner := &rustNativeOwner{
+		library: library, raw: 0x1357, memberGate: newOriginalMemberCustody(),

+	if !errors.As(err, &cleanup) || cleanup.Mask != 4 || cleanup.Codes[2] != 5 ||
+		result.PID != 42 || result.RootExit != 7 || result.State != 3 ||
+		owner.raw != 0x1234 || library.activeOwners.Load() != 1 || calls != 1 {
+		t.Fatalf("finish lost cleanup outcome: result=%+v err=%v raw=%#x live=%d calls=%d",
+			result, err, owner.raw, library.activeOwners.Load(), calls)
+	}
+}

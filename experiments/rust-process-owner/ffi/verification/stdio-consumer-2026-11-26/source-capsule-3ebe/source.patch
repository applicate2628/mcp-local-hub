+// receiveCodexManagedInstallTarget joins the existing protected projection,
+// journal and live client receiver. Snapshot fields supplied by a caller never
+// enter this receiving boundary as proof.
+func receiveCodexManagedInstallTarget(ctx context.Context, server string, update ClientUpdatePlan, client clients.Client) (clients.ManagedRegistrationEntrySnapshot, error) {
+	if ctx == nil {
+		return clients.ManagedRegistrationEntrySnapshot{}, fmt.Errorf("%w: receiving context is unavailable", clients.ErrCodexTargetNameConflict)
+	}
+	if err := ctx.Err(); err != nil {
+		return clients.ManagedRegistrationEntrySnapshot{}, err
+	}
+	managed, ok := clients.AsManagedRegistrationClient(client)
+	if !ok || client.Name() != "codex-cli" || update.Client != "codex-cli" || update.EntryName != server+"-mcphub" {
+		return clients.ManagedRegistrationEntrySnapshot{}, fmt.Errorf("%w: managed Codex receiver is unavailable", clients.ErrCodexTargetNameConflict)
+	}
+	stateRoot, err := DaemonStateDirReadOnly()
+	if err != nil {
+		return clients.ManagedRegistrationEntrySnapshot{}, err
+	}
+	target := managedRegistrationFrozenInstallTarget{
+		ClientID: update.Client, LogicalEntryName: server, PhysicalEntryName: update.EntryName,
+		Action: update.Action, DaemonName: update.DaemonName, TaskName: supervisorTaskNameForManifestDaemon(server, update.DaemonName),
+		Desired: installClientEntryV1(server, update, ""),
+	}
+	received, err := loadManagedRegistrationRelationships(stateRoot, server, []managedRegistrationFrozenInstallTarget{target},
+		map[string]clients.ManagedRegistrationClient{"codex-cli": managed},
+		map[string]struct{}{server: {}}, map[string]struct{}{"codex-cli": {}})
+	if err != nil {
+		return clients.ManagedRegistrationEntrySnapshot{}, err
+	}
+	expected, present := received.settledSnapshots["codex-cli"][update.EntryName]
+	if !present || received.current["codex-cli"][update.EntryName] != server {
+		return clients.ManagedRegistrationEntrySnapshot{}, fmt.Errorf("%w: Codex alias has no settled managed relationship", clients.ErrCodexTargetNameConflict)
+	}
+	if err := ctx.Err(); err != nil {
+		return clients.ManagedRegistrationEntrySnapshot{}, err
+	}
+	return expected, nil
+}
+
+// freezeReceivedCodexInstallRepeat receives ownership before freezing policy
+// from the same exact client observation. It never derives the desired policy
+// from a post-write value, and the adapter repeats every bounded layer check.
+func freezeReceivedCodexInstallRepeat(ctx context.Context, plan *Plan, opts BuildPlanOpts, client clients.Client, adapter clients.CodexTransportClient) error {
+	managed, ok := clients.AsManagedRegistrationClient(client)
+	if !ok || opts.codexManagedTargetReceiver == nil {
+		return fmt.Errorf("%w: managed Codex receiver is unavailable", clients.ErrCodexTargetNameConflict)
+	}
+	for i, update := range plan.ClientUpdates {
+		if update.Client != "codex-cli" {
+			continue
+		}
+		update.EntryName = plan.Server + "-mcphub"
+		expected, err := opts.codexManagedTargetReceiver(ctx, plan.Server, update, client)
+		if err != nil {
+			return errors.Join(fmt.Errorf("%w: Codex alias ownership was not received", clients.ErrCodexTargetNameConflict), err)
+		}
+		observed, err := clients.CaptureCodexInstallEntry(ctx, client, update.EntryName, installClientEntryV1(plan.Server, update, ""))
+		if err != nil {
+			return err
+		}
+		if observed.Snapshot != expected || !observed.HTTPMatchesDesired {
+			return fmt.Errorf("%w: received Codex alias differs from the intended transport", clients.ErrCodexTargetNameConflict)
+		}
+		update.ToolTimeoutSec = observed.ToolTimeoutSec
+		update.codexObservation = &codexInstallObservation{
+			context: ctx, entryName: update.EntryName, snapshot: expected, transport: observed.Transport, disabled: observed.Disabled,
+			projectRoot: opts.CodexProjectRoot, workingDir: opts.CodexWorkingDir,
+		}
+		desired := installClientEntryV1(plan.Server, update, "")
+		matched, err := managed.ManagedRegistrationDesiredMatchesSnapshot(ctx, update.EntryName, desired, expected)
+		if err != nil || !matched {
+			return errors.Join(fmt.Errorf("%w: received Codex alias differs from frozen policy", clients.ErrCodexTargetNameConflict), err)
+		}
+		logical, err := clients.CaptureCodexInstallEntry(ctx, client, plan.Server, desired)
+		if err != nil {
+			return err
+		}
+		if logical.Snapshot.Exists || logical.Snapshot.ConfigSHA256 != expected.ConfigSHA256 {
+			return fmt.Errorf("%w: logical Codex source changed before repeat", clients.ErrCodexTargetNameConflict)
+		}
+		target, err := adapter.ResolveTransportTarget(clients.CodexTransportTargetRequest{
+			LogicalEntryName: plan.Server, DesiredTransport: clients.CodexTransportHTTP, DesiredEntry: desired,
+			ProjectRoot: opts.CodexProjectRoot, WorkingDir: opts.CodexWorkingDir, ExpectedGlobalTarget: &expected,
+		})
+		if err != nil {
+			return err
+		}
+		if target.TargetEntryName != update.EntryName || !target.ExistingExactTarget {
+			return fmt.Errorf("%w: received Codex alias is outside the bounded selection", clients.ErrCodexTargetNameConflict)
+		}
+		update.codexAlreadyConfigured = true
+		plan.ClientUpdates[i] = update
+	}
+	return nil
+}

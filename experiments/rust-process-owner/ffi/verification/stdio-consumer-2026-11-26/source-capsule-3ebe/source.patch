+func TestInstall_CodexAliasRepeatUsesSettledManagedOwnership(t *testing.T) {
+	fixture := newCodexPublicInstallFixture(t, "tool_timeout_sec = 45\n")
+	afterFirst := fixture.installAndReceive(t, 45, false)
+	var output bytes.Buffer
+	opts := fixture.opts
+	opts.Writer = &output
+	err := NewAPI().Install(opts)
+	if err != nil {
+		t.Fatalf("second public Install refused its journal-backed alias: %v\n%s", err, output.String())
+	}
+	fixture.assertClientBytes(t, afterFirst, fixture.projectBytes)
+	if fixture.scheduler.createCount != 0 || fixture.scheduler.runCount != 0 {
+		t.Fatalf("public generic install started legacy scheduler work: create=%d run=%d", fixture.scheduler.createCount, fixture.scheduler.runCount)
+	}
+}

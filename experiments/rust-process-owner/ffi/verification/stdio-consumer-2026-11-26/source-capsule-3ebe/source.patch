+#[test]
+fn job_members_revalidation_rejects_naturally_exited_retained_descendant() {
+    // The existing block fixture exits naturally after ten seconds. Acquisition,
+    // revalidation and exit polling share one absolute deadline; the existing
+    // readiness helpers retain their separate finite waits.
+    let deadline = Instant::now() + Duration::from_secs(13);
+    let f = Fixture::new();
+    let mut owner = f.launch("detach", 0, "");
+    let root_pid = owner.root_pid();
+    owner.admit_and_resume(|_| Ok(())).unwrap();
+    wait_marker(&f.marker().with_extension("grandchild"));
+    assert_eq!(owner.wait_root(DEADLINE).unwrap(), Some(7));
+    wait_member_count(&owner, 1);
+
+    let generation = owner.observe_job_members(deadline).unwrap();
+    let baseline = owner.job_member_snapshot().unwrap().clone();
+    assert!(baseline.complete);
+    assert_eq!(baseline.generation, generation);
+    assert_eq!(baseline.rows.len(), 1);
+    assert_eq!(baseline.resources.len(), 1);
+    let descendant_pid = baseline.rows[0].pid;
+    assert_ne!(descendant_pid, root_pid);
+    assert_ne!(descendant_pid, 0);
+    let resource = &baseline.resources[0];
+    assert_eq!(resource.pid, descendant_pid);
+    assert!(!resource.borrowed_original);
+    assert!(!resource.close_attempted && !resource.closed && resource.close_error.is_none());
+    let census = baseline.pre.as_ref().unwrap();
+    assert_eq!(census.total_processes, 2);
+    assert_eq!(census.active_processes, 1);
+    assert_eq!(census.pids, vec![descendant_pid]);
+    owner
+        .revalidate_job_members(generation, deadline, Some(descendant_pid))
+        .unwrap();
+
+    // No stop request: the original owner retains the acquired descendant
+    // handle while the child reaches its own natural exit.
+    loop {
+        assert!(
+            Instant::now() < deadline,
+            "retained descendant did not exit within the shared budget"
+        );
+        if owner.active_processes().unwrap() == 0 {
+            break;
+        }
+        thread::sleep(
+            deadline
+                .saturating_duration_since(Instant::now())
+                .min(Duration::from_millis(5)),
+        );
+    }
+    for required in [None, Some(descendant_pid)] {
+        assert!(
+            matches!(
+                owner.revalidate_job_members(generation, deadline, required),
+                Err(JobMemberQueryError::Observation(error))
+                    if error.kind() != io::ErrorKind::TimedOut
+            ),
+            "exited member must be rejected by observation, not deadline expiry"
+        );
+    }
+    assert!(
+        owner.job_member_snapshot().unwrap() == &baseline,
+        "failed revalidation replaced or consumed the acquisition baseline"
+    );
+    assert_eq!(owner.wait_root(Duration::ZERO).unwrap(), Some(7));
+
+    let closed = owner.close_job_members(generation).unwrap().clone();
+    assert_eq!(closed.generation, generation);
+    assert!(closed.complete);
+    assert_eq!(closed.resources.len(), 1);
+    let resource = &closed.resources[0];
+    assert_eq!(resource.pid, descendant_pid);
+    assert!(!resource.borrowed_original);
+    assert!(resource.close_attempted && resource.closed && resource.close_error.is_none());
+    assert_eq!(owner.close_job_members(generation).unwrap(), &closed);
+    assert_eq!(
+        owner
+            .finish(deadline.saturating_duration_since(Instant::now()))
+            .unwrap(),
+        Settlement::Complete { root_exit: 7 }
+    );
+    // On any earlier panic the same owner remains in scope for its existing
+    // Job-close/owned-handle Drop fallback; no helper thread or second owner exists.
+}

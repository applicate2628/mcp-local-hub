+func TestRustOwnerMemberRevalidationUsesNativeGeneration(t *testing.T) {
+	f := newRustMemberScript(t)
+	o := f.acquire(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	before := o.Snapshot()
+	if err := o.MatchOwnerPID(ctx, 43); err != nil || f.requiredPID != 43 || f.revalidateCalls != 1 {
+		t.Fatalf("native PID revalidation was omitted: %v", err)
+	}
+	f.revalidateReject = true
+	var native *rustOwnerMemberQueryError
+	if err := o.Revalidate(ctx); !errors.As(err, &native) || f.revalidateCalls != 2 {
+		t.Fatalf("native retained-handle failure was ignored: %v", err)
+	}
+	if !reflect.DeepEqual(before, o.Snapshot()) {
+		t.Fatal("revalidation replaced historical acquisition")
+	}
+	if proof, err := o.CloseObserved(); err != nil || !proof.Finalized() {
+		t.Fatalf("close after native revalidation failure: %v", err)
+	}
+}

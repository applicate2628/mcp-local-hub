+func TestStdioRustOriginalLateActualFactoryErrorKeepsCustody(t *testing.T) {
+	h, _ := newStdioRustOriginalHost(t, "echo")
+	lateError := errors.New("reported error after actual native creation")
+	var retained, returned *process.AtCreateJobProcess
+	var creationIdentity process.ContainedRootIdentity
+	var actualError error
+	created := false
+	factoryCalls, retainCalls := 0, 0
+	h.originalLaunch = &stdioOriginalLaunchOps{
+		startRust: func(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+			retain func(*process.AtCreateJobProcess) error) (*process.AtCreateJobProcess, error) {
+			factoryCalls++
+			returned, actualError = process.StartProductRustOriginal(ctx, cmd, stdin, stdout, stderr,
+				func(p *process.AtCreateJobProcess) error {
+					retained = p
+					retainCalls++
+					return retain(p)
+				})
+			if actualError != nil || returned == nil {
+				return returned, actualError
+			}
+			created = returned.Created()
+			creationIdentity, actualError = returned.Identity()
+			return returned, errors.Join(actualError, lateError)
+		},
+	}
+	startErr := h.Start(context.Background())
+	if !errors.Is(startErr, lateError) || actualError != nil || !created || !creationIdentity.Known ||
+		retained == nil || returned != retained || factoryCalls != 1 || retainCalls != 1 {
+		t.Fatalf("late error fixture did not create a real retained owner: retained=%p returned=%p created=%t identity=%+v factory=%d retain=%d actual=%v start=%v",
+			retained, returned, created, creationIdentity, factoryCalls, retainCalls, actualError, startErr)
+	}
+	owner := stdioRustOriginalOwner(t, h)
+	if owner.original != retained || owner.identity != creationIdentity {
+		t.Fatal("failed Start replaced the actual original facade or identity")
+	}
+	first := stdioRustOriginalComplete(t, h, owner)
+	again := stdioRustOriginalComplete(t, h, owner)
+	if !errors.Is(first.PrimaryError, lateError) || !errors.Is(again.PrimaryError, lateError) ||
+		!again.Deadline.Equal(first.Deadline) || again.NativeSettlement != first.NativeSettlement ||
+		again.RootWait != first.RootWait || factoryCalls != 1 {
+		t.Fatalf("late error or original terminal receipt changed: first=%+v again=%+v", first, again)
+	}
+	stdioRustOriginalFilesClosed(t, h)
+}

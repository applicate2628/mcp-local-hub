+	if _, err := f.start(t, "stdio", []rustOwnerEnvironmentEntry{}, pipes.streams); err != nil {
+		t.Fatal(err)
+	}
+	if after := rustIONativeStreamFlags(t, pipes.streams); after != before {
+		t.Fatalf("IO create mutated original handle flags: before=%v after=%v", before, after)
+	}
+	rustIONativeAbsent(t, f.marker)
+	f.closeChildEnds(t, pipes)
+	runtime.GC()
+	if _, err := f.owner.Admit(true); err != nil {
+		t.Fatal(err)
+	}
+	ctx := rustIONativeContext(t)
+	// Deliberately leave both final tails unread until native settlement.
+	// This small payload qualifies real pipes, not arbitrary pump capacity.
+	f.finish(t, ctx, 0)
+	rustIONativeOutput(t, ctx, f.read(pipes.stdout), payload)
+	rustIONativeOutput(t, ctx, f.read(pipes.stderr), []byte("native-stderr\x00\xff"))
+	if data, err := os.ReadFile(f.marker); err != nil || string(data) != "complete" {
+		t.Fatalf("native stdio fixture did not complete: %q err=%v", data, err)

+
+// Synthetic callbacks isolate the retained-facade protocol: a terminal request
+// must not consume its one-shot action while startup still owns cleanup.
+func TestRustOwnerStartReturnBlocksTerminalAdmission(t *testing.T) {
+	for _, exited := range []bool{false, true} {
+		name := "shutdown"
+		if exited {
+			name = "after-root-exit"
+		}
+		t.Run(name, func(t *testing.T) {
+			f, child, _ := newRustFacadeABIFixture(t)
+			child.startAttempted.Store(true)
+			p := &ProvisionalProcess{owner: child, waitDone: make(chan struct{})}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			if exited {
+				root, err := p.WaitCreatorRoot()
+				if err != nil || !root.Known {
+					t.Fatalf("publish original root: %+v err=%v", root, err)
+				}
+			}
+			waitsBefore := f.waitCalls
+			finish := func() (*CreatorTerminalResult, error) {
+				if exited {
+					return p.CompleteCreatorAfterExit(ctx, true)
+				}
+				return p.TerminateCreatorAndWait(ctx)
+			}
+			result, err := finish()
+			if result != nil || !errors.Is(err, ErrOriginalMemberBorrowPending) ||
+				f.stopCalls != 0 || f.waitCalls != waitsBefore || f.closeCalls != 0 || f.releaseCalls != 0 ||
+				p.terminalStarted || p.creatorTerminal != nil || p.closeAttempted {
+				t.Fatalf("unfinished start consumed terminal policy: result=%v err=%v stop/wait/close/release=%d/%d/%d/%d started=%t cached=%t",
+					result, err, f.stopCalls, f.waitCalls, f.closeCalls, f.releaseCalls, p.terminalStarted, p.creatorTerminal != nil)
+			}
+			if f.owner.memberGate.sealed || f.owner.raw == 0 || f.owner.library.activeOwners.Load() != 1 {
+				t.Fatal("pre-entry refusal changed retained custody")
+			}
+			child.startReturned.Store(true)
+			result, err = finish() // Reuse the original deadline.
+			if err != nil || result == nil || result.Closure() == nil ||
+				f.closeCalls != 1 || f.releaseCalls != 1 || f.owner.raw != 0 || f.badPermit {
+				t.Fatalf("same request could not settle after start returned: result=%v err=%v close/release=%d/%d badPermit=%t",
+					result, err, f.closeCalls, f.releaseCalls, f.badPermit)
+			}
+			wantStops := 1
+			if exited {
+				wantStops = 0
+			}
+			if f.stopCalls != wantStops {
+				t.Fatalf("terminal stop count: got %d want %d", f.stopCalls, wantStops)
+			}
+			again, retryErr := finish()
+			if retryErr != nil || again != result || f.closeCalls != 1 || f.releaseCalls != 1 {
+				t.Fatalf("settled terminal result changed: result=%v err=%v", again, retryErr)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_stdio_windows.go b/internal/process/rust_owner_stdio_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..87316686cbfe50c7b3e758973f907fc4caaea973
--- /dev/null
+++ b/internal/process/rust_owner_stdio_windows.go
@@ -0,0 +1,146 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"syscall"
+)
+
+// rustOwnerStdio lends three caller-owned files to one synchronous create.
+// All fields are required; native IO accepts real disk, pipe or character
+// handles. The character category includes NUL; it does not identify NUL or
+// qualify console/serial I/O. Originals and their flags stay unchanged.
+// The caller may close its files after create returns. Copies share the same
+// kernel objects and file positions, so concurrent I/O/seek needs coordination.
+type rustOwnerStdio struct {
+	Stdin, Stdout, Stderr *os.File
+}
+
+// rustOwnerStdioError preserves a source acquisition or temporary-close cause.
+// Stream indexes are stdin=0, stdout=1, stderr=2. A close failure does not prove
+// release and never authorizes retry through a potentially reused handle value.
+type rustOwnerStdioError struct {
+	Operation string
+	Stream    int
+	Err       error
+}
+
+func (e *rustOwnerStdioError) Error() string {
+	return fmt.Sprintf("Rust stdio %s slot %d: %v", e.Operation, e.Stream, e.Err)
+}
+
+func (e *rustOwnerStdioError) Unwrap() error { return e.Err }
+
+var errRustOwnerStdioClose = errors.New("Rust stdio close did not establish release")
+
+func (e *rustOwnerStdioError) Is(target error) bool {
+	return e != nil && e.Operation == "close" && target == errRustOwnerStdioClose
+}
+
+// rustOwnerStdioCopies owns only temporary stdio handles, not a process or Job.
+// Do not copy this value after acquisition. Native borrows its handle values
+// until synchronous create returns; close then consumes every slot once.
+type rustOwnerStdioCopies struct {
+	handles  [3]syscall.Handle
+	closeErr error
+}
+
+// nativeHandles exposes owned copies for the ABI, never a borrowed File.Fd.
+// The returned values are no longer usable after close starts.
+func (copies *rustOwnerStdioCopies) nativeHandles() [3]uintptr {
+	return [3]uintptr{
+		uintptr(copies.handles[0]),
+		uintptr(copies.handles[1]),
+		uintptr(copies.handles[2]),
+	}
+}
+
+// duplicateRustOwnerStdio protects each source with RawConn.Control through
+// DuplicateHandle. Only the new copies become inheritable; aliased sources get
+// distinct owned handles to the same object. Context checks bound admission,
+// not an already-entered DuplicateHandle call. This is not a process-wide
+// inheritance lock: the native HANDLE_LIST restricts only this created child.
+func duplicateRustOwnerStdio(ctx context.Context, streams rustOwnerStdio) (copies rustOwnerStdioCopies, err error) {
+	if ctx == nil {
+		return copies, errors.New("Rust stdio acquisition requires a context")
+	}
+	if err := ctx.Err(); err != nil {
+		return copies, err
+	}
+	sources := [3]*os.File{streams.Stdin, streams.Stdout, streams.Stderr}
+	for i, file := range sources {
+		if file == nil {
+			return copies, &rustOwnerStdioError{Operation: "borrow", Stream: i, Err: os.ErrInvalid}
+		}
+	}
+	defer func() {
+		if err != nil {
+			err = errors.Join(err, copies.close())
+		}
+	}()
+	process, err := syscall.GetCurrentProcess()
+	if err != nil {
+		return copies, fmt.Errorf("Rust stdio current process: %w", err)
+	}
+	for i, file := range sources {
+		if err := ctx.Err(); err != nil {
+			return copies, err
+		}
+		raw, borrowErr := file.SyscallConn()
+		if borrowErr != nil {
+			return copies, &rustOwnerStdioError{
+				Operation: "borrow", Stream: i, Err: errors.Join(borrowErr, ctx.Err()),
+			}
+		}
+		var duplicateErr error
+		controlErr := raw.Control(func(source uintptr) {
+			if duplicateErr = ctx.Err(); duplicateErr != nil {
+				return
+			}
+			var duplicate syscall.Handle
+			duplicateErr = syscall.DuplicateHandle(
+				process, syscall.Handle(source), process, &duplicate,
+				0, true, syscall.DUPLICATE_SAME_ACCESS,
+			)
+			if duplicateErr == nil {
+				// A failed native call does not establish ownership of its
+				// output value. Only successful copies enter cleanup custody.
+				copies.handles[i] = duplicate
+			}
+		})
+		if acquireErr := errors.Join(controlErr, duplicateErr); acquireErr != nil {
+			return copies, &rustOwnerStdioError{
+				Operation: "duplicate", Stream: i, Err: errors.Join(acquireErr, ctx.Err()),
+			}
+		}
+		if err := ctx.Err(); err != nil {
+			return copies, err
+		}
+	}
+	return copies, nil
+}
+
+func (copies *rustOwnerStdioCopies) close() error {
+	if copies.closeErr != nil {
+		return copies.closeErr
+	}
+	var failures []error
+	for i, handle := range copies.handles {
+		copies.handles[i] = 0
+		if handle == 0 {
+			continue
+		}
+		// Consume before the sole native attempt, including on failure.
+		if err := syscall.CloseHandle(handle); err != nil {
+			failures = append(failures, &rustOwnerStdioError{
+				Operation: "close", Stream: i, Err: err,
+			})
+		}
+	}
+	copies.closeErr = errors.Join(failures...)
+	return copies.closeErr
+}
diff --git a/internal/process/rust_owner_stdio_windows_test.go b/internal/process/rust_owner_stdio_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f19953f34fe18696bb563a2da9d2d5125a41cb18
--- /dev/null
+++ b/internal/process/rust_owner_stdio_windows_test.go
@@ -0,0 +1,401 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+var rustStdioTestKernel = syscall.NewLazyDLL("kernel32.dll")
+var rustStdioTestGetFlags = rustStdioTestKernel.NewProc("GetHandleInformation")
+var rustStdioTestSetFlags = rustStdioTestKernel.NewProc("SetHandleInformation")
+var rustStdioTestPeekPipe = rustStdioTestKernel.NewProc("PeekNamedPipe")
+
+func rustStdioTestContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+func rustStdioTestFiles(t *testing.T) rustOwnerStdio {
+	t.Helper()
+	directory := t.TempDir()
+	files := [3]*os.File{}
+	for i, name := range []string{"stdin", "stdout", "stderr"} {
+		file, err := os.OpenFile(filepath.Join(directory, name), os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+		if err != nil {
+			t.Fatal(err)
+		}
+		files[i] = file
+		t.Cleanup(func() { _ = file.Close() })
+	}
+	return rustOwnerStdio{Stdin: files[0], Stdout: files[1], Stderr: files[2]}
+}
+
+func rustStdioTestHandleFlags(handle uintptr) (uint32, error) {
+	var flags uint32
+	result, _, err := rustStdioTestGetFlags.Call(handle, uintptr(unsafe.Pointer(&flags)))
+	if result == 0 {
+		return 0, err
+	}
+	return flags, nil
+}
+
+func rustStdioTestFileFlags(t *testing.T, file *os.File) uint32 {
+	t.Helper()
+	raw, err := file.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var flags uint32
+	var queryErr error
+	controlErr := raw.Control(func(handle uintptr) {
+		flags, queryErr = rustStdioTestHandleFlags(handle)
+	})
+	if err := errors.Join(controlErr, queryErr); err != nil {
+		t.Fatalf("source handle flags: %v", err)
+	}
+	return flags
+}
+
+func rustStdioTestPipe(t *testing.T) (*os.File, *os.File) {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = reader.Close(); _ = writer.Close() })
+	return reader, writer
+}
+
+// Closing caller ends must expose actual absence of every temporary reader and
+// writer. These private, empty pipes have no outstanding I/O. A one-byte write
+// cannot fill their fresh buffers; PeekNamedPipe checks writer absence before
+// Read, so a leaked writer fails the test without starting a blocking read.
+// These are real Go pipes; no child, native-owner DLL or I/O worker is involved.
+func rustStdioTestNoPipeCopies(t *testing.T, inputReader, inputWriter, outputReader, outputWriter *os.File) {
+	t.Helper()
+	_ = rustStdioTestFileFlags(t, inputReader)
+	_ = rustStdioTestFileFlags(t, outputWriter)
+	if err := inputReader.Close(); err != nil {
+		t.Fatalf("caller input reader was not retained: %v", err)
+	}
+	if err := outputWriter.Close(); err != nil {
+		t.Fatalf("caller output writer was not retained: %v", err)
+	}
+	n, err := inputWriter.Write([]byte{0x7f})
+	// Same Windows oracle as Go os.TestEPIPE: ERROR_NO_DATA (232).
+	if n != 0 || !errors.Is(err, syscall.Errno(232)) {
+		t.Fatalf("temporary input reader survived: bytes=%d err=%v", n, err)
+	}
+	_ = rustStdioTestFileFlags(t, inputWriter)
+	rustStdioTestOutputEOF(t, outputReader)
+}
+
+func rustStdioTestOutputEOF(t *testing.T, outputReader *os.File) {
+	t.Helper()
+	raw, err := outputReader.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var peekErr error
+	controlErr := raw.Control(func(handle uintptr) {
+		result, _, nativeErr := rustStdioTestPeekPipe.Call(handle, 0, 0, 0, 0, 0)
+		if result == 0 {
+			peekErr = nativeErr
+		}
+	})
+	if controlErr != nil || !errors.Is(peekErr, syscall.ERROR_BROKEN_PIPE) {
+		t.Fatalf("temporary output writer survived: control=%v peek=%v", controlErr, peekErr)
+	}
+	var buffer [1]byte
+	n, err := outputReader.Read(buffer[:])
+	if n != 0 || !errors.Is(err, io.EOF) {
+		t.Fatalf("closed output pipe did not reach natural EOF: bytes=%d err=%v", n, err)
+	}
+	_ = rustStdioTestFileFlags(t, outputReader)
+}
+
+func TestRustOwnerStdioCopiesPreserveCallerFilesAndFlags(t *testing.T) {
+	streams := rustStdioTestFiles(t)
+	sources := [3]*os.File{streams.Stdin, streams.Stdout, streams.Stderr}
+	var before [3]uint32
+	for i, source := range sources {
+		before[i] = rustStdioTestFileFlags(t, source)
+		if before[i]&syscall.HANDLE_FLAG_INHERIT != 0 {
+			t.Fatal("fixture source is already inheritable")
+		}
+	}
+	copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), streams)
+	t.Cleanup(func() { _ = copies.close() })
+	if err != nil {
+		t.Fatal(err)
+	}
+	handles := copies.nativeHandles()
+	for i, handle := range handles {
+		flags, err := rustStdioTestHandleFlags(handle)
+		if handle == 0 || err != nil || flags&syscall.HANDLE_FLAG_INHERIT == 0 {
+			t.Fatalf("temporary slot %d is not inheritable: handle=%#x flags=%#x err=%v", i, handle, flags, err)
+		}
+		for j := 0; j < i; j++ {
+			if handles[j] == handle {
+				t.Fatalf("temporary slots %d and %d alias one handle value", j, i)
+			}
+		}
+		if after := rustStdioTestFileFlags(t, sources[i]); after != before[i] {
+			t.Fatalf("source slot %d flags changed: before=%#x after=%#x", i, before[i], after)
+		}
+	}
+	if err := copies.close(); err != nil {
+		t.Fatal(err)
+	}
+	if copies.nativeHandles() != ([3]uintptr{}) {
+		t.Fatal("closed temporary handles remain available for native entry")
+	}
+	for i, source := range sources {
+		if after := rustStdioTestFileFlags(t, source); after != before[i] {
+			t.Fatalf("source slot %d flags changed during close", i)
+		}
+		if _, err := source.Write([]byte{byte(i)}); err != nil {
+			t.Fatalf("caller source slot %d was closed: %v", i, err)
+		}
+	}
+}
+
+func TestRustOwnerStdioAliasedSourcesKeepSharedFilePosition(t *testing.T) {
+	streams := rustStdioTestFiles(t)
+	streams.Stderr = streams.Stdout
+	copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), streams)
+	t.Cleanup(func() { _ = copies.close() })
+	if err != nil {
+		t.Fatal(err)
+	}
+	handles := copies.nativeHandles()
+	if handles[1] == 0 || handles[1] == handles[2] {
+		t.Fatal("aliased source must still produce two separately owned handles")
+	}
+	for i, payload := range [][]byte{[]byte("out"), []byte("err")} {
+		var written uint32
+		if err := syscall.WriteFile(syscall.Handle(handles[i+1]), payload, &written, nil); err != nil || written != uint32(len(payload)) {
+			t.Fatalf("temporary stream write: bytes=%d err=%v", written, err)
+		}
+	}
+	if err := copies.close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := streams.Stdout.Write([]byte("parent")); err != nil {
+		t.Fatalf("caller output was closed: %v", err)
+	}
+	got, err := os.ReadFile(streams.Stdout.Name())
+	if err != nil || !bytes.Equal(got, []byte("outerrparent")) {
+		t.Fatalf("shared file position: got=%q err=%v", got, err)
+	}
+}
+
+func TestRustOwnerStdioMissingOrClosedSourcesLeaveNoCopies(t *testing.T) {
+	for _, mode := range []string{"missing", "closed"} {
+		for slot := 0; slot < 3; slot++ {
+			t.Run(mode+"-"+[]string{"stdin", "stdout", "stderr"}[slot], func(t *testing.T) {
+				streams := rustStdioTestFiles(t)
+				sources := [3]*os.File{streams.Stdin, streams.Stdout, streams.Stderr}
+				fields := [3]**os.File{&streams.Stdin, &streams.Stdout, &streams.Stderr}
+				if mode == "missing" {
+					*fields[slot] = nil
+				} else if err := sources[slot].Close(); err != nil {
+					t.Fatal(err)
+				}
+				copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), streams)
+				t.Cleanup(func() { _ = copies.close() })
+				if err == nil || copies.nativeHandles() != ([3]uintptr{}) {
+					t.Fatalf("invalid source retained copies: handles=%v err=%v", copies.nativeHandles(), err)
+				}
+				if mode == "closed" {
+					var failure *rustOwnerStdioError
+					if !errors.As(err, &failure) || failure.Stream != slot || failure.Err == nil {
+						t.Fatalf("closed source identity was lost: slot=%d err=%v", slot, err)
+					}
+					if !errors.Is(err, failure.Err) {
+						t.Fatal("closed-source cause was not unwrap-able")
+					}
+				}
+				for i, source := range sources {
+					if mode != "closed" || i != slot {
+						_ = rustStdioTestFileFlags(t, source)
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestRustOwnerStdioPartialFailureClosesRealPipeCopies(t *testing.T) {
+	inputReader, inputWriter := rustStdioTestPipe(t)
+	outputReader, outputWriter := rustStdioTestPipe(t)
+	closed, err := os.CreateTemp(t.TempDir(), "closed-stderr-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := closed.Close(); err != nil {
+		t.Fatal(err)
+	}
+	before := [2]uint32{
+		rustStdioTestFileFlags(t, inputReader),
+		rustStdioTestFileFlags(t, outputWriter),
+	}
+	copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), rustOwnerStdio{
+		Stdin: inputReader, Stdout: outputWriter, Stderr: closed,
+	})
+	t.Cleanup(func() { _ = copies.close() })
+	var failure *rustOwnerStdioError
+	if !errors.As(err, &failure) || failure.Stream != 2 {
+		t.Fatalf("expected third-source acquisition failure: %v", err)
+	}
+	if copies.nativeHandles() != ([3]uintptr{}) {
+		t.Fatal("partial acquisition retained temporary handle values")
+	}
+	after := [2]uint32{
+		rustStdioTestFileFlags(t, inputReader),
+		rustStdioTestFileFlags(t, outputWriter),
+	}
+	if before != after {
+		t.Fatalf("partial acquisition changed source flags: before=%v after=%v", before, after)
+	}
+	rustStdioTestNoPipeCopies(t, inputReader, inputWriter, outputReader, outputWriter)
+}
+
+func TestRustOwnerStdioCloseReleasesEveryAliasedPipeCopy(t *testing.T) {
+	inputReader, inputWriter := rustStdioTestPipe(t)
+	outputReader, outputWriter := rustStdioTestPipe(t)
+	copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), rustOwnerStdio{
+		Stdin: inputReader, Stdout: outputWriter, Stderr: outputWriter,
+	})
+	t.Cleanup(func() { _ = copies.close() })
+	if err != nil {
+		t.Fatal(err)
+	}
+	handles := copies.nativeHandles()
+	if handles[1] == handles[2] {
+		t.Fatal("aliased output did not receive two independently closable handles")
+	}
+	if err := copies.close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := copies.close(); err != nil {
+		t.Fatalf("successful close was not idempotent: %v", err)
+	}
+	rustStdioTestNoPipeCopies(t, inputReader, inputWriter, outputReader, outputWriter)
+}
+
+func TestRustOwnerStdioCancelledAcquisitionPreservesSources(t *testing.T) {
+	streams := rustStdioTestFiles(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	cancel()
+	copies, err := duplicateRustOwnerStdio(ctx, streams)
+	t.Cleanup(func() { _ = copies.close() })
+	if !errors.Is(err, context.Canceled) || copies.nativeHandles() != ([3]uintptr{}) {
+		t.Fatalf("cancelled acquisition: handles=%v err=%v", copies.nativeHandles(), err)
+	}
+	for _, source := range []*os.File{streams.Stdin, streams.Stdout, streams.Stderr} {
+		_ = rustStdioTestFileFlags(t, source)
+	}
+}
+
+func TestRustOwnerStdioClosePreservesAllNativeFailuresWithoutRetry(t *testing.T) {
+	streams := rustStdioTestFiles(t)
+	outputReader, outputWriter := rustStdioTestPipe(t)
+	streams.Stdout = outputWriter
+	copies, err := duplicateRustOwnerStdio(rustStdioTestContext(t), streams)
+	t.Cleanup(func() { _ = copies.close() })
+	if err != nil {
+		t.Fatal(err)
+	}
+	handles := copies.nativeHandles()
+	const protectFromClose = 2 // Windows HANDLE_FLAG_PROTECT_FROM_CLOSE.
+	protected := [3]bool{}
+	t.Cleanup(func() {
+		// Also consume all slots after a fixture-setup failure, before manual
+		// recovery releases any protected handle still recorded by copies.
+		_ = copies.close()
+		// A successful protect flag and failed close leave these exact fixture
+		// handles live. Recover them explicitly; never retry a consumed slot.
+		for i, handle := range handles {
+			if !protected[i] {
+				continue
+			}
+			result, _, err := rustStdioTestSetFlags.Call(handle, protectFromClose, 0)
+			if result == 0 {
+				t.Errorf("fixture unprotect slot %d: %v", i, err)
+				continue
+			}
+			if err := syscall.CloseHandle(syscall.Handle(handle)); err != nil {
+				t.Errorf("fixture close slot %d: %v", i, err)
+			}
+		}
+	})
+	for _, slot := range []int{0, 2} {
+		result, _, err := rustStdioTestSetFlags.Call(handles[slot], protectFromClose, protectFromClose)
+		if result == 0 {
+			t.Fatalf("fixture protect slot %d: %v", slot, err)
+		}
+		protected[slot] = true
+	}
+	first := copies.close()
+	if first == nil {
+		t.Fatal("real protected-handle close failures were hidden")
+	}
+	if copies.nativeHandles() != ([3]uintptr{}) {
+		t.Fatal("failed close retained handle values for stale-handle retry")
+	}
+	var seen [3]bool
+	var visit func(error)
+	visit = func(err error) {
+		switch current := err.(type) {
+		case *rustOwnerStdioError:
+			if current.Operation != "close" || current.Stream < 0 || current.Stream >= 3 {
+				t.Errorf("unexpected close failure: %+v", current)
+				return
+			}
+			var native syscall.Errno
+			if !errors.As(current, &native) || native == 0 {
+				t.Errorf("slot %d lost native close error: %v", current.Stream, current)
+			}
+			seen[current.Stream] = true
+		case interface{ Unwrap() []error }:
+			for _, nested := range current.Unwrap() {
+				visit(nested)
+			}
+		case interface{ Unwrap() error }:
+			visit(current.Unwrap())
+		}
+	}
+	visit(first)
+	if seen != protected {
+		t.Fatalf("close failures lost: got=%v want=%v", seen, protected)
+	}
+	if second := copies.close(); second != first {
+		t.Fatalf("second close replaced its original failure: first=%v second=%v", first, second)
+	}
+	if err := outputWriter.Close(); err != nil {
+		t.Fatalf("caller output writer was not retained: %v", err)
+	}
+	rustStdioTestOutputEOF(t, outputReader)
+	for i, handle := range handles {
+		if !protected[i] {
+			continue // Successful close may already have recycled this numeric value.
+		}
+		flags, err := rustStdioTestHandleFlags(handle)
+		if err != nil || flags&protectFromClose == 0 {
+			t.Fatalf("protected slot %d lost its actual failed-close state: flags=%#x err=%v", i, flags, err)
+		}
+	}
+}

+		paused.Rows[0].PID != f.root.PID || paused.Rows[0].NativeBirthFILETIME != f.root.CreationTime100ns ||
+		paused.Rows[0].ImagePathSHA256 != sidFormatObservationDigest([]byte(f.facts.ExecutablePath)) ||
+		paused.Rows[0].PrincipalSIDSHA256 != sidFormatObservationDigest([]byte(f.facts.OwnerSID)) ||
+		paused.OriginalCreationSHA256 != expectedRustMemberCreation(f) ||
+		paused.OriginalJobSHA256 != sidFormatObservationDigest([]byte("original-job-custody-rust-v1|"+expectedRustMemberCreation(f))) {
+		t.Fatalf("suspended original binding incomplete: rows=%d active=%d", len(paused.Rows), paused.PreActive)
+	}
+	if err := first.MatchOwnerPID(ctx, f.root.PID); err != nil {
+		t.Fatal(err)

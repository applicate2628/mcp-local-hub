new file mode 100644
index 0000000000000000000000000000000000000000..fc1821024a9580f057803632ceafc224a605cb3a
--- /dev/null
+++ b/internal/process/testdata/foreground_console_child/main_windows.go
@@ -0,0 +1,211 @@
+//go:build windows && amd64
+
+// This CUI fixture is built normally by Go, without -H=windowsgui. It must
+// consume its inherited standard handles; it never allocates or attaches a console.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type callObservation struct {
+	Attempted bool   `json:"attempted"`
+	Completed bool   `json:"completed"`
+	OK        bool   `json:"ok"`
+	Code      uint32 `json:"native_error"`
+	Error     string `json:"error,omitempty"`
+	Count     uint32 `json:"count"`
+}
+
+type streamObservation struct {
+	Name   string          `json:"name"`
+	Handle callObservation `json:"handle"`
+	Mode   callObservation `json:"mode"`
+	Value  uint32          `json:"mode_value"`
+}
+
+type consoleReport struct {
+	Schema       string               `json:"schema"`
+	PID          uint32               `json:"pid"`
+	Mode         string               `json:"mode"`
+	Attachment   callObservation      `json:"attachment"`
+	ConsolePIDs  []uint32             `json:"console_pids"`
+	Window       callObservation      `json:"window"`
+	WindowHandle uint64               `json:"window_handle"`
+	Streams      [3]streamObservation `json:"streams"`
+	Read         callObservation      `json:"read"`
+	Character    uint16               `json:"character"`
+	Writes       [2]callObservation   `json:"writes"`
+	ExitKnown    bool                 `json:"exit_known"`
+	ExitCode     int                  `json:"exit_code"`
+}
+
+func observed(err error, count uint32) callObservation {
+	out := callObservation{Attempted: true, Completed: true, OK: err == nil, Count: count}
+	if err != nil {
+		out.Error = err.Error()
+		var errno syscall.Errno
+		if errors.As(err, &errno) {
+			out.Code = uint32(errno)
+		}
+	}
+	return out
+}
+
+func writeReport(path string, report consoleReport) error {
+	raw, err := json.Marshal(report)
+	if err != nil {
+		return err
+	}
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	_, writeErr := file.Write(append(raw, '\n'))
+	return errors.Join(writeErr, file.Close())
+}
+
+func observeAttachment() (callObservation, []uint32) {
+	proc := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetConsoleProcessList")
+	if err := proc.Find(); err != nil {
+		out := observed(err, 0)
+		out.Attempted = false
+		return out, nil
+	}
+	// One bounded snapshot. A larger returned count means no identifiers
+	// were copied; keep that count but never qualify a truncated list.
+	var processes [64]uint32
+	count, _, err := proc.Call(uintptr(unsafe.Pointer(&processes[0])), uintptr(len(processes)))
+	if count != 0 {
+		err = nil
+	} else if err == nil || err == syscall.Errno(0) {
+		err = errors.New("GetConsoleProcessList failed without an error code")
+	}
+	out := observed(err, uint32(count))
+	if count == 0 || count > uintptr(len(processes)) {
+		return out, nil
+	}
+	return out, processes[:count]
+}
+
+func observeWindow() (callObservation, uint64) {
+	proc := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetConsoleWindow")
+	if err := proc.Find(); err != nil {
+		out := observed(err, 0)
+		out.Attempted = false
+		return out, 0
+	}
+	window, _, _ := proc.Call()
+	// NULL is a documented result, not a GetLastError failure. In particular,
+	// CREATE_NO_WINDOW can have console membership without a console HWND.
+	return observed(nil, 0), uint64(window)
+}
+
+func main() {
+	if len(os.Args) != 3 || !filepath.IsAbs(os.Args[2]) {
+		os.Exit(90)
+	}
+	mode := os.Args[1]
+	if mode != "console-stdio" && mode != "console-write-only" && mode != "console-no-window" {
+		os.Exit(90)
+	}
+	reportPath := os.Args[2]
+	rel, err := filepath.Rel(`D:\dev\ChatGPT`, filepath.Dir(reportPath))
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) || filepath.IsAbs(rel) {
+		os.Exit(90)
+	}
+	report := consoleReport{Schema: "foreground-console-child-v2", PID: windows.GetCurrentProcessId(), Mode: mode}
+	report.Attachment, report.ConsolePIDs = observeAttachment()
+	report.Window, report.WindowHandle = observeWindow()
+	ids := [...]uint32{windows.STD_INPUT_HANDLE, windows.STD_OUTPUT_HANDLE, windows.STD_ERROR_HANDLE}
+	names := [...]string{"stdin", "stdout", "stderr"}
+	var handles [3]windows.Handle
+	for i, id := range ids {
+		handle, handleErr := windows.GetStdHandle(id)
+		if handleErr == nil && (handle == 0 || handle == windows.InvalidHandle) {
+			handleErr = errors.New("standard handle is null or invalid")
+		}
+		handles[i] = handle
+		report.Streams[i] = streamObservation{Name: names[i], Handle: observed(handleErr, 0)}
+		if handleErr == nil {
+			modeErr := windows.GetConsoleMode(handle, &report.Streams[i].Value)
+			report.Streams[i].Mode = observed(modeErr, 0)
+		}
+	}
+	// Keep the initial native facts even if ReadConsole blocks and the original
+	// foreground owner subsequently terminates this child. Do not overwrite it.
+	if err := writeReport(reportPath, report); err != nil {
+		os.Exit(95)
+	}
+	if mode == "console-stdio" && report.Streams[0].Mode.OK {
+		var count uint32
+		readErr := windows.ReadConsole(handles[0], &report.Character, 1, &count, nil)
+		report.Read = observed(readErr, count)
+	}
+	for i, text := range [...]string{"console-out", "console-err"} {
+		if mode == "console-no-window" || !report.Streams[i+1].Handle.OK {
+			continue
+		}
+		wide, conversionErr := windows.UTF16FromString(text)
+		if conversionErr != nil {
+			os.Exit(96)
+		}
+		var count uint32
+		writeErr := windows.WriteConsole(handles[i+1], &wide[0], uint32(len(wide)-1), &count, nil)
+		report.Writes[i] = observed(writeErr, count)
+	}
+	// Observe again after the actual IO. The two retained reports must describe
+	// their own native snapshots, rather than copying the initial association.
+	report.Attachment, report.ConsolePIDs = observeAttachment()
+	report.Window, report.WindowHandle = observeWindow()
+	selfPresent := false
+	for _, pid := range report.ConsolePIDs {
+		selfPresent = selfPresent || pid == report.PID
+	}
+	complete := report.Attachment.OK && report.Attachment.Count != 0 &&
+		report.Attachment.Count == uint32(len(report.ConsolePIDs)) && selfPresent &&
+		report.Window.Attempted && report.Window.Completed && report.Window.OK
+	switch mode {
+	case "console-stdio":
+		complete = complete && report.Read.OK && report.Read.Count == 1 && report.Character == 'Q'
+		for _, stream := range report.Streams {
+			complete = complete && stream.Mode.OK
+		}
+	case "console-write-only":
+		complete = complete && !report.Read.Attempted && !report.Streams[0].Mode.OK
+	case "console-no-window":
+		// No window does not mean DETACHED_PROCESS: Windows may attach the
+		// child to a separate headless console. Parent separation is checked
+		// against this complete PID snapshot by the original test actor.
+		complete = complete && report.WindowHandle == 0 &&
+			!report.Read.Attempted && !report.Writes[0].Attempted && !report.Writes[1].Attempted
+		for _, stream := range report.Streams {
+			complete = complete && stream.Mode.Attempted && stream.Mode.Completed &&
+				!stream.Mode.OK && stream.Mode.Code == uint32(windows.ERROR_INVALID_HANDLE)
+		}
+	}
+	for _, stream := range report.Streams {
+		complete = complete && stream.Handle.OK
+	}
+	if mode != "console-no-window" {
+		for _, write := range report.Writes {
+			complete = complete && write.OK && write.Count == 11
+		}
+	}
+	report.ExitKnown, report.ExitCode = true, 94
+	if complete {
+		report.ExitCode = 37
+	}
+	if err := writeReport(reportPath+".final.json", report); err != nil {
+		os.Exit(95)
+	}
+	os.Exit(report.ExitCode)
+}

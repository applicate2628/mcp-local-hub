+func rustContainedWireText(value rustOwnerUTF16) string {
+	if value.Data == nil || value.Len > 32766 {
+		return "<invalid UTF-16 view>"
+	}
+	return syscall.UTF16ToString(unsafe.Slice(value.Data, int(value.Len)))
+}

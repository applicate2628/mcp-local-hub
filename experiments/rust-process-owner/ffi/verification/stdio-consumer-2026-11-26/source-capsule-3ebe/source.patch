index 0000000000000000000000000000000000000000..b3c8e3f346214dcad27f5d52424e0642e32fb378
--- /dev/null
+++ b/internal/process/rust_owner_abi_windows.go
@@ -0,0 +1,240 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"sync"
+	"syscall"
+	"unsafe"
+)
+
+// The native layout is fixed by experiments/rust-process-owner/ffi/include/owner_v1.h.
+// Keeping these types private prevents ABI1 diagnostics from becoming Product authority.
+type rustOwnerUTF16 struct {
+	Data *uint16
+	Len  uintptr
+}
+type rustOwnerCreate struct {
+	Version  uint32
+	Reserved uint32
+	Program  rustOwnerUTF16
+	Cwd      rustOwnerUTF16
+	Args     *rustOwnerUTF16
+	Argc     uintptr
+}
+type rustOwnerEnvironmentEntryWire struct {
+	Name, Value rustOwnerUTF16
+}
+type rustOwnerEnvironment struct {
+	Entries *rustOwnerEnvironmentEntryWire
+	Count   uintptr
+}
+type rustOwnerIOContext struct {
+	Environment rustOwnerEnvironment
+	Streams     [3]uintptr
+}
+
+type rustOwnerOutcome struct {
+	Size, Version, State, Flags, PID, RootExit, Active uint32
+	NativeError                                        int32
+	CleanupMask                                        uint32
+	CleanupCodes                                       [3]int32
+}
+
+// Wait uses a separate ABI record: state 2 means exited with resources retained.
+type rustOwnerWaitOutcome struct {
+	Size, Version, State, Flags, PID, RootExit, Active uint32
+	NativeError                                        int32
+}
+
+// Compile-time checks on AMD64 complement the behavioral tests. A layout
+// mismatch must not reach the foreign function pointer.
+var (
+	_ [32 - unsafe.Sizeof(rustOwnerEnvironmentEntryWire{})]byte
+	_ [unsafe.Sizeof(rustOwnerEnvironmentEntryWire{}) - 32]byte
+	_ [16 - unsafe.Offsetof(rustOwnerEnvironmentEntryWire{}.Value)]byte
+	_ [unsafe.Offsetof(rustOwnerEnvironmentEntryWire{}.Value) - 16]byte
+	_ [16 - unsafe.Sizeof(rustOwnerEnvironment{})]byte
+	_ [unsafe.Sizeof(rustOwnerEnvironment{}) - 16]byte
+	_ [8 - unsafe.Offsetof(rustOwnerEnvironment{}.Count)]byte
+	_ [unsafe.Offsetof(rustOwnerEnvironment{}.Count) - 8]byte
+	_ [40 - unsafe.Sizeof(rustOwnerIOContext{})]byte
+	_ [unsafe.Sizeof(rustOwnerIOContext{}) - 40]byte
+	_ [16 - unsafe.Offsetof(rustOwnerIOContext{}.Streams)]byte
+	_ [unsafe.Offsetof(rustOwnerIOContext{}.Streams) - 16]byte
+	_ [56 - unsafe.Sizeof(rustOwnerCreate{})]byte
+	_ [unsafe.Sizeof(rustOwnerCreate{}) - 56]byte
+	_ [48 - unsafe.Sizeof(rustOwnerOutcome{})]byte
+	_ [unsafe.Sizeof(rustOwnerOutcome{}) - 48]byte
+	_ [32 - unsafe.Sizeof(rustOwnerWaitOutcome{})]byte
+	_ [unsafe.Sizeof(rustOwnerWaitOutcome{}) - 32]byte
+)
+
+var errRustOwnerOutcome = errors.New("invalid Rust owner ABI1 outcome")
+
+// decodeRustOwnerOutcome validates one complete value, not the process
+// lifecycle. A transferred native owner stays owned even if decoding fails.
+func decodeRustOwnerOutcome(status uint32, v rustOwnerOutcome) (rustOwnerOutcome, error) {
+	invalid := func(reason string) (rustOwnerOutcome, error) {
+		return rustOwnerOutcome{}, fmt.Errorf("%w: %s", errRustOwnerOutcome, reason)
+	}
+	switch {
+	case v.Size != 48 || v.Version != 1:
+		return invalid("layout")
+	case status > 6:
+		return invalid("unknown status")
+	case v.State > 3:
+		return invalid("unknown state")
+	case v.Flags & ^uint32(3) != 0:
+		return invalid("unknown flags")
+	case v.CleanupMask & ^uint32(7) != 0:
+		return invalid("unknown cleanup mask")
+	case status == 3 && v.NativeError == 0:
+		return invalid("native failure without code")
+	case status != 3 && v.NativeError != 0:
+		return invalid("native code outside native failure")
+	case v.Flags&1 == 0 && v.RootExit != 0:
+		return invalid("unknown root exit has code")
+	case v.Flags&2 == 0 && v.Active != 0:
+		return invalid("unknown active count is nonzero")
+	case v.State != 0 && v.PID == 0:
+		return invalid("settlement without PID")
+	case v.State == 1 && ((v.Flags&1 != 0) != (v.Flags&2 != 0) || (v.Flags&2 != 0 && v.Active == 0)):
+		// Native finish returns Pending either before root exit (no
+		// member count) or after root exit with strictly positive
+		// active members. These observations cannot disagree.
+		return invalid("pending original root and active member facts disagree")
+	case (v.State == 2 || v.State == 3) && v.Flags&1 == 0:
+		return invalid("terminal settlement without known root")
+	case (v.State == 2 || v.State == 3) && v.Active != 0:
+		return invalid("terminal settlement with live members")
+	case v.State == 3 && v.CleanupMask == 0:
+		return invalid("cleanup failure without slot")
+	case v.State != 3 && v.CleanupMask != 0:
+		return invalid("cleanup code outside cleanup-failed")
+	}
+	for i, code := range v.CleanupCodes {
+		if (v.CleanupMask&(1<<i) != 0) != (code != 0) {
+			return invalid("cleanup mask and error disagree")
+		}
+	}
+	if status != 0 {
+		return v, fmt.Errorf("Rust owner ABI1 status %d, native code %d", status, v.NativeError)
+	}
+	return v, nil
+}
+
+func decodeRustOwnerWaitOutcome(status uint32, v rustOwnerWaitOutcome) (rustOwnerWaitOutcome, error) {
+	invalid := func(reason string) (rustOwnerWaitOutcome, error) {
+		return rustOwnerWaitOutcome{}, fmt.Errorf("%w: wait %s", errRustOwnerOutcome, reason)
+	}
+	switch {
+	case v.Size != 32 || v.Version != 1:
+		return invalid("layout")
+	case status > 6 || v.State > 2 || v.Flags & ^uint32(3) != 0:
+		return invalid("unknown status, state or flags")
+	case (status == 0 && v.State == 0) || (status != 0 && v.State != 0):
+		return invalid("status and observation disagree")
+	case (status == 3) != (v.NativeError != 0):
+		return invalid("native error code disagrees with status")
+	case (v.Flags&1 == 0 && v.RootExit != 0) || (v.Flags&2 == 0 && v.Active != 0):
+		return invalid("unflagged facts")
+	case (v.State != 0 || v.Flags != 0) && v.PID == 0:
+		return invalid("facts without original PID")
+	case status != 0 && v.Flags&2 != 0:
+		return invalid("failure published active members")
+	case v.State == 1 && v.Flags != 0 && (v.Flags != 3 || v.Active == 0):
+		return invalid("pending root and active members disagree")
+	case v.State == 2 && (v.Flags != 3 || v.Active != 0):
+		return invalid("exited root and active members disagree")
+	}
+	if status != 0 {
+		return v, fmt.Errorf("Rust owner ABI1 wait status %d, native code %d", status, v.NativeError)
+	}
+	return v, nil
+}
+
+// callRustOwnerCreate invokes the actual ABI1 export under the library lock:
+// Close cannot unload the DLL while its function pointer is executing.
+// Ownership of a nonzero returned slot must be retained independently of
+// status/outcome decoding. The caller must not repeat this operation blindly.
+func (library *rustOwnerLibrary) callRustOwnerCreate(request *rustOwnerCreate, slot *uintptr, result *rustOwnerOutcome) (uint32, error) {
+	return library.callRustOwnerCreateContext(nil, request, nil, slot, result)
+}
+
+// A nil context preserves the legacy unbounded private entry. The IO entry
+// requires a finite context and uses the existing original-owner admission.
+func lockRustOwnerCreateContext(ctx context.Context, mu *sync.Mutex) error {
+	if ctx == nil {
+		mu.Lock()
+		return nil
+	}
+	return lockRustCreatorContext(ctx, mu)
+}
+
+func (library *rustOwnerLibrary) callRustOwnerCreateContext(
+	ctx context.Context, request *rustOwnerCreate, ioContext *rustOwnerIOContext,
+	slot *uintptr, result *rustOwnerOutcome,
+) (uint32, error) {
+	if library == nil || request == nil || slot == nil || result == nil {
+		return 0, errors.New("missing Rust owner create buffer")
+	}
+	if err := lockRustOwnerCreateContext(ctx, &library.mu); err != nil {
+		return 0, err
+	}
+	defer library.mu.Unlock()
+	if !library.ready || library.closeAttempted {
+		return 0, errors.New("Rust owner library is closed")
+	}
+	if *slot != 0 {
+		return 0, errors.New("Rust owner create requires an empty ownership slot")
+	}
+	name := "mh_create1"
+	if ioContext != nil {
+		name = "mh_create_io1"
+	}
+	address := library.procedures[name]
+	if address == 0 {
+		return 0, errors.New("Rust owner create export is unavailable")
+	}
+	// Nested string buffers are owned, validated and pinned by the constructor.
+	// Pin these records too: a qualification callback can grow the Go stack.
+	var pinned runtime.Pinner
+	defer pinned.Unpin()
+	pinned.Pin(request)
+	pinned.Pin(slot)
+	pinned.Pin(result)
+	if ioContext != nil {
+		pinned.Pin(ioContext)
+	}
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return 0, err
+		}
+	}
+	var code uintptr
+	if ioContext == nil {
+		code, _, _ = syscall.SyscallN(address,
+			uintptr(unsafe.Pointer(request)), uintptr(unsafe.Sizeof(*request)),
+			uintptr(unsafe.Pointer(slot)), uintptr(unsafe.Pointer(result)), uintptr(unsafe.Sizeof(*result)))
+	} else {
+		code, _, _ = syscall.SyscallN(address,
+			uintptr(unsafe.Pointer(request)), uintptr(unsafe.Sizeof(*request)),
+			uintptr(unsafe.Pointer(ioContext)), uintptr(unsafe.Sizeof(*ioContext)),
+			uintptr(unsafe.Pointer(slot)), uintptr(unsafe.Pointer(result)), uintptr(unsafe.Sizeof(*result)))
+	}
+	runtime.KeepAlive(request)
+	runtime.KeepAlive(ioContext)
+	runtime.KeepAlive(slot)
+	runtime.KeepAlive(result)
+	if *slot != 0 {
+		// The transferred native use is acquired under mu before the pending
+		// retention use can be dropped. There is no unloadable zero-count gap.
+		library.activeOwners.Add(1)
+	}
+	return uint32(code), nil
+}

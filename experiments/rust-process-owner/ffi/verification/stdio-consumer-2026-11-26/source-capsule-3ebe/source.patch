+func TestAsyncRun_CancelAndCloseDoNotSettleFailedCleanup(t *testing.T) {
+	for _, action := range []string{"cancel", "close"} {
+		t.Run(action, func(t *testing.T) {
+			started := make(chan struct{})
+			cleanupFailure := errors.New("cleanup after cancellation")
+			contained := &process.ContainedRunError{
+				Stage: process.ContainedStageContext, Cause: context.Canceled,
+				CleanupStage: process.ContainedStageCleanup, CleanupCause: cleanupFailure,
+			}
+			store := &asyncTestStore{}
+			owner := newAsyncTestOwner(t, store, func(ctx context.Context, _ oneAPIRunRequest) asyncExecution {
+				close(started)
+				<-ctx.Done()
+				return projectAsyncCommandResult(ctx.Err(), runResult{}, contained)
+			})
+			start, err := owner.Start(asyncRequest("cancel-cleanup", time.Minute))
+			if err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case <-started:
+			case <-time.After(3 * time.Second):
+				t.Fatal("worker did not start")
+			}
+			wantState := asyncStateRunning
+			if action == "cancel" {
+				wantState = asyncStateCancelRequested
+				receipt, cancelErr := owner.Cancel(start.RunID, true)
+				err = cancelErr
+				if receipt.Terminal {
+					t.Fatalf("cancel returned terminal receipt: %#v", receipt)
+				}
+			} else {
+				err = owner.Close()
+			}
+			var got *process.ContainedRunError
+			if !errors.Is(err, errAsyncCleanupUnsettled) || !errors.Is(err, context.Canceled) ||
+				!errors.Is(err, cleanupFailure) || !errors.As(err, &got) || got != contained {
+				t.Fatalf("%s lost original failed cleanup: %v", action, err)
+			}
+			record := waitForAsyncWorkerRecord(t, owner, start.RunID)
+			if !record.unsettled || record.cleanupErr != contained || record.State != wantState || record.terminal() ||
+				record.Result != nil || record.FinishedAt != nil || record.FinishSeq != 0 {
+				t.Fatalf("%s falsely settled cleanup: %#v", action, record)
+			}
+			raw, err := store.Read("")
+			if err != nil {
+				t.Fatal(err)
+			}
+			var snapshot asyncPersistedRunSnapshot
+			if err := json.Unmarshal(raw, &snapshot); err != nil {
+				t.Fatal(err)
+			}
+			if len(snapshot.Runs) != 1 || snapshot.Runs[0].State != wantState || snapshot.Runs[0].FinishSeq != 0 ||
+				snapshot.Runs[0].Result != nil || snapshot.TerminalSequence != 0 {
+				t.Fatalf("%s persisted terminal completion: %#v", action, snapshot)
+			}
+		})
+	}
+}

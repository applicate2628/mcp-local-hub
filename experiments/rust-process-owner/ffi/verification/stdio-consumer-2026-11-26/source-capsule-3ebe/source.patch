+func TestRustOwnerMemberLayoutsAndPartialProjection(t *testing.T) {
+	if unsafe.Sizeof(rustOwnerMemberOriginal{}) != 16 || unsafe.Sizeof(rustOwnerMemberCensusABI{}) != 24 ||
+		unsafe.Sizeof(rustOwnerMemberIdentityABI{}) != 112 || unsafe.Sizeof(rustOwnerMemberResourceABI{}) != 16 ||
+		unsafe.Sizeof(rustOwnerMemberSnapshotABI{}) != 120 || unsafe.Sizeof(rustOwnerMemberCloseABI{}) != 40 ||
+		unsafe.Sizeof(rustOwnerMemberReport{}) != 24 ||
+		unsafe.Offsetof(rustOwnerMemberSnapshotABI{}.Original) != 24 ||
+		unsafe.Offsetof(rustOwnerMemberSnapshotABI{}.Pre) != 40 ||
+		unsafe.Offsetof(rustOwnerMemberSnapshotABI{}.Post) != 64 ||
+		unsafe.Offsetof(rustOwnerMemberSnapshotABI{}.Rows) != 88 ||
+		unsafe.Offsetof(rustOwnerMemberSnapshotABI{}.Resources) != 104 ||
+		unsafe.Offsetof(rustOwnerMemberIdentityABI{}.SID) != 40 {
+		t.Fatal("member ABI layout changed")
+	}
+	f := newRustMemberScript(t)
+	v, err := copyRustOwnerMemberSnapshot(&f.snapshot, 120, 1)
+	if err != nil || !v.Complete || v.Rows[1].CreationTime100ns != 1001 {
+		t.Fatalf("valid copy: %v", err)
+	}
+	f.image[3] = 'x'
+	if v.Rows[0].ImageUTF16[3] == 'x' {
+		t.Fatal("identity image was not copied")
+	}
+	f.image[3] = 'f'
+	for _, tc := range []struct {
+		name   string
+		change func(*rustOwnerMemberSnapshotABI)
+	}{
+		{"reserved", func(v *rustOwnerMemberSnapshotABI) { v.Reserved = 1 }},
+		{"generation", func(v *rustOwnerMemberSnapshotABI) { v.Generation = 2 }},
+		{"absent-pre", func(v *rustOwnerMemberSnapshotABI) { v.Flags = 6 }},
+		{"post-with-prefix", func(v *rustOwnerMemberSnapshotABI) { v.Flags = 3; v.RowCount = 1 }},
+		{"omitted-resource", func(v *rustOwnerMemberSnapshotABI) { v.ResourceCount = 1 }},
+		{"oversized", func(v *rustOwnerMemberSnapshotABI) { v.RowCount = 4097 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			raw := f.snapshot
+			tc.change(&raw)
+			if _, err := copyRustOwnerMemberSnapshot(&raw, 120, 1); !errors.Is(err, errRustOwnerMembers) {
+				t.Fatalf("malformed snapshot accepted: %v", err)
+			}
+		})
+	}
+	changed := []uint32{44}
+	f.pin.Pin(&changed[0])
+	raw := f.snapshot
+	raw.Flags = 3
+	raw.Post = rustOwnerMemberCensusABI{Total: 3, Active: 1, PIDs: &changed[0], Count: 1}
+	partial, err := copyRustOwnerMemberSnapshot(&raw, 120, 1)
+	if err != nil || partial.Complete || partial.Post.PIDs[0] != 44 || partial.Resources[0].PID != 42 {
+		t.Fatalf("valid changed post census rejected: %v", err)
+	}
+	f.resources[0].Flags = 3
+	if _, err := copyRustOwnerMemberResources(&f.resources[0], 2); err == nil {
+		t.Fatal("borrowed root close was accepted")
+	}
+}

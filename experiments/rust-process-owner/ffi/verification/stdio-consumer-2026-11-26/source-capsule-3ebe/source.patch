+// Synthetic receiving facts only: this test cannot construct a process
+// settlement receipt and does not claim native execution or a member census.
+func TestForegroundReceivingPreservesRustJobExitAndLibraryCloseFacts(t *testing.T) {
+	closeFailure := errors.New("original FreeLibrary failure")
+	for _, tc := range []struct {
+		name      string
+		closed    bool
+		closeErr  error
+		wantClose string
+	}{
+		{"closed", true, nil, "closed-known=true closed=true error=\"\""},
+		{"close-failed", false, closeFailure, "closed-known=false closed=false error=\"original FreeLibrary failure\""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			result := process.ForegroundResult{
+				Root: process.OriginalRootWait{Known: true, ExitCode: 37},
+				Native: process.ContainedNativeSnapshot{
+					RootWaitKnown: true, RootExitCode: 37, OriginalJobExited: true,
+					HandlesClosed: tc.closed,
+				},
+				Outcome: process.ForegroundOutcome{
+					OriginalAcquired: true, ChildObservationKnown: true,
+					LibraryClose: process.ForegroundCloseObservation{
+						AcquiredKnown: true, Acquired: true, CloseAttempted: true,
+						ClosedKnown: tc.closed, Closed: tc.closed, Error: tc.closeErr,
+					},
+				},
+			}
+			if !tc.closed {
+				result.Outcome.Pending = []string{"rust-owner-library"}
+			}
+			var text bytes.Buffer
+			received := receiveForeground(result, tc.closeErr, &text)
+			for _, want := range []string{
+				"original-job-exited=true members-exited=false accounting-known=false",
+				"resource=rust-owner-library acquired-known=true acquired=true attempted=true " + tc.wantClose,
+				"member-policy: present=false",
+			} {
+				if !strings.Contains(text.String(), want) {
+					t.Fatalf("missing %q in %s", want, text.String())
+				}
+			}
+			if strings.Contains(text.String(), "mcphub launcher member:") ||
+				received.Result.Native.MembersExited || received.Result.Native.AccountingKnown ||
+				received.Result.Outcome.MemberObservationPresent || len(received.Result.Native.CapturedMemberPIDs) != 0 {
+				t.Fatal("aggregate Rust Job exit was converted to a legacy member census")
+			}
+			if received.ExitCode != 37 || received.DiagnosticError != nil ||
+				!received.Result.Native.OriginalJobExited ||
+				received.Result.Outcome.LibraryClose.ClosedKnown != tc.closed ||
+				received.Result.Outcome.LibraryClose.Closed != tc.closed ||
+				!errors.Is(received.Result.Outcome.LibraryClose.Error, tc.closeErr) ||
+				!errors.Is(received.ExecutionError, tc.closeErr) || received.Result.Settlement.Complete() {
+				t.Fatal("receiving changed original exit/close facts or fabricated settlement")
+			}
+		})
+	}
+}

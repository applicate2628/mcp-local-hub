+		t.Fatal(err)
+	}
+	const prefix, suffix = "{\"fixture\":\"", "\"}"
+	raw := []byte(prefix + strings.Repeat("x", size-len(prefix)-len(suffix)) + suffix)
+	request := clients.ConfigWriteRequest{Context: ctx, Path: path, Contents: raw, FreshCreationEvidence: fresh}

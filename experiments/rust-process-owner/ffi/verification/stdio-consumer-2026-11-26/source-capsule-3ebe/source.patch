+	library.activeOwners.Store(1) // represent an owner returned from Rust
+	if err := library.Close(); err == nil || api.freeCalls != 0 || library.closeAttempted {
+		t.Fatalf("live owner unloaded DLL: close=%v free=%d attempted=%v", err, api.freeCalls, library.closeAttempted)
+	}
+	library.activeOwners.Store(0)
+	if err := library.Close(); err != nil || api.freeCalls != 1 {
+		t.Fatalf("close after settlement=%v free=%d", err, api.freeCalls)
+	}
+}

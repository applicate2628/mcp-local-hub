index 0000000000000000000000000000000000000000..45e872d21b48dd4e389c5d7101530c78c7391a1f
--- /dev/null
+++ b/internal/daemon/http_host_endpoint_release_windows_test.go
@@ -0,0 +1,512 @@
+//go:build windows
+
+package daemon
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"mcp-local-hub/internal/process"
+)
+
+// Only delivery order and explicitly reported errors are scripted. StartObserved
+// creates the real Job/root, pipes, waiter and member source. This ticket does
+// not qualify an HTTP listener or authorize any HTTP exchange.
+type endpointReleaseFixture struct {
+	t               *testing.T
+	root            string
+	host            *HTTPHost
+	start           *HTTPHostStartReceipt
+	startedReceipt  HTTPHostStartReceipt
+	startedError    error
+	source          process.OriginalJobMemberSource
+	members         *process.OriginalJobMemberObservation
+	closeScript     func(context.Context, int32) (*process.OriginalJobMemberCloseObservation, error)
+	reportedError   error
+	acceptInvalid   bool
+	closeCalls      atomic.Int32
+	terminalCalls   atomic.Int32
+	terminalReceipt HTTPHostTerminalReceipt
+	callMu          sync.Mutex
+	deadlines       []time.Time
+}
+
+func newEndpointReleaseFixture(t *testing.T) (*endpointReleaseFixture, HTTPHostStartReceipt) {
+	t.Helper()
+	root := t.TempDir()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	f := prepareEndpointReleaseFixture(t, ctx, root)
+	start, err := f.host.StartObserved(ctx)
+	if err != nil || !start.OriginalCreated() || f.members == nil || f.start == nil ||
+		f.start.OriginalStart != start.OriginalStart {
+		t.Fatalf("actual original fixture start unavailable: created=%t members=%t error=%v",
+			start.OriginalCreated(), f.members != nil, err)
+	}
+	return f, start
+}
+
+func prepareEndpointReleaseFixture(t *testing.T, ctx context.Context, root string) *endpointReleaseFixture {
+	t.Helper()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := &endpointReleaseFixture{t: t, root: root}
+	cleanupDeadline, err := PreparedHTTPHostStartupCleanupDeadline(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.host, err = NewHTTPHost(HTTPHostConfig{
+		Command: exe, Args: []string{"-test.run=^TestStdioOriginalHelper$"},
+		Env: map[string]string{stdioOriginalHelperMode: "sentinel", stdioOriginalHelperRoot: f.root},
+		// Intent only: the scripted ticket performs no network operation.
+		UpstreamPort: 32123, HealthTimeout: 5 * time.Second,
+		PreparedAdmission: f, PreparedStartupCleanupDeadline: cleanupDeadline,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		// Each test must release and join its delivery barriers before this
+		// cleanup. Actual member resources close before the original host.
+		f.closeScript = nil
+		if f.members != nil {
+			proof, closeErr := f.members.CloseObserved()
+			if err := errors.Join(closeErr, proof.Validate(f.source)); err != nil {
+				t.Errorf("actual member cleanup: %v", err)
+			}
+		}
+		cleanup, stop := context.WithTimeout(context.Background(), 5*time.Second)
+		defer stop()
+		receipt, stopErr := f.host.StopObserved(cleanup)
+		// Baseline RED can retain a receiver Pending or caller error even
+		// after actual cleanup. Inspect these original resource facts rather
+		// than treating the receiver cache defect as an ownership leak.
+		if (!receipt.NoNativeAcquisition && (!receipt.NativeSettlement.Complete() || !receipt.RootWait.Known)) ||
+			!receipt.IOSettlement.Complete() || !receipt.LogClosed || receipt.LogCloseError != nil || !receipt.RequestsJoined {
+			t.Errorf("actual host cleanup incomplete: native=%t root=%t io=%t log=%t joined=%t error=%v",
+				receipt.NativeSettlement.Complete(), receipt.RootWait.Known, receipt.IOSettlement.Complete(),
+				receipt.LogClosed, receipt.RequestsJoined, stopErr)
+		}
+	})
+	return f
+}
+
+func (f *endpointReleaseFixture) BeforeCreate(ctx context.Context, _ HTTPHostPreparedInput) (HTTPHostPreparedTicket, error) {
+	return f, ctx.Err()
+}
+func (f *endpointReleaseFixture) Started(ctx context.Context, start HTTPHostStartReceipt) error {
+	// Keep the delivered value, not the caller's subsequently mutable pointer.
+	f.startedReceipt = start
+	if f.start == nil || start.OriginalStart != f.start.OriginalStart || !start.OriginalCreated() {
+		return errors.New("fixture original start binding changed")
+	}
+	if err := start.ValidateOriginalHost(ctx, f.host); err != nil {
+		return err
+	}
+	return f.startedError
+}
+func (f *endpointReleaseFixture) Terminal(_ context.Context, receipt HTTPHostTerminalReceipt) error {
+	f.callMu.Lock()
+	f.terminalReceipt = receipt
+	f.callMu.Unlock()
+	f.terminalCalls.Add(1)
+	return nil
+}
+func (f *endpointReleaseFixture) ObserveOriginalListener(ctx context.Context, host *HTTPHost, start *HTTPHostStartReceipt) (MCPOriginalHostEndpointEvidence, error) {
+	if host != f.host || start == nil || !start.OriginalCreated() {
+		return nil, errors.New("fixture original host unavailable")
+	}
+	originalTestBarrier(f.t, filepath.Join(f.root, "root-ready"))
+	f.start = start
+	var err error
+	f.source, err = host.OriginalMemberSource(ctx)
+	if err != nil {
+		return f, err
+	}
+	f.members, err = host.ObserveOriginalMembers(ctx)
+	return f, err
+}
+func (*endpointReleaseFixture) ValidateOriginalEndpoint(context.Context, string, string) error {
+	return errors.New("scripted receiver fixture does not qualify an HTTP listener")
+}
+func (*endpointReleaseFixture) ValidateOriginalConnection(context.Context, *MCPHTTPOriginalConnection) error {
+	return errors.New("scripted receiver fixture does not qualify HTTP transport")
+}
+func (f *endpointReleaseFixture) CloseObserved(ctx context.Context) (*process.OriginalJobMemberCloseObservation, error) {
+	call := f.closeCalls.Add(1)
+	var deadline time.Time
+	if ctx != nil {
+		deadline, _ = ctx.Deadline()
+	}
+	f.callMu.Lock()
+	f.deadlines = append(f.deadlines, deadline)
+	f.callMu.Unlock()
+	if f.closeScript != nil {
+		return f.closeScript(ctx, call)
+	}
+	return f.closeMembers(ctx)
+}
+func (f *endpointReleaseFixture) closeMembers(ctx context.Context) (*process.OriginalJobMemberCloseObservation, error) {
+	proof, err := f.members.CloseObserved()
+	if ctx == nil {
+		return proof, errors.Join(err, f.reportedError, errors.New("fixture close context missing"))
+	}
+	return proof, errors.Join(err, f.reportedError, ctx.Err())
+}
+func (f *endpointReleaseFixture) ValidateOriginalClose(ctx context.Context, proof *process.OriginalJobMemberCloseObservation, startSHA string) error {
+	if ctx == nil {
+		return errors.New("fixture validation context missing")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	expectedSHA, err := originalHostStartSHA(f.start)
+	if err != nil || expectedSHA != startSHA {
+		return errors.Join(err, errors.New("fixture original start digest changed"))
+	}
+	if f.acceptInvalid {
+		// Explicitly malformed producer for the nil/zero-proof control.
+		return nil
+	}
+	if err := proof.Validate(f.source); err != nil {
+		return err
+	}
+	return f.reportedError
+}

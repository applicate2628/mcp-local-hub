+// Only the path/admission contract is exercised. The command is inert and the
+// fixture does not claim an installed or protocol-qualified Serena runtime.
+func TestSerenaQualificationAcceptsCompactAttempt(t *testing.T) {
+	r := serenaAcquisitionRequest(t)
+	work, cancelWork := context.WithDeadline(context.Background(), r.WorkDeadline)
+	defer cancelWork()
+	cleanup, cancelCleanup := context.WithDeadline(context.WithoutCancel(work), r.AbsoluteCleanupDeadline)
+	defer cancelCleanup()
+	key, err := r.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := &preparedSerenaAcquisition{inputs: SerenaPreparationInputs{Request: r}}
+	defer func() {
+		if err := a.closeOriginalRoots(); err != nil {
+			t.Error(err)
+		}
+	}()
+	roots, err := a.acquireRoots(work, r, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	executable, closure := serenaAcquisitionInertCommand(t, work, r)
+	inventory, err := a.generation.Inventory(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := PreparedSerenaQualificationRequest{
+		QualificationID: "qualification-layout", Request: r, Roots: roots,
+		Inputs:       SerenaPreparationInputs{Request: r, EnvironmentProjectionSHA256: r.BuildEnvironmentSHA256},
+		Installation: PreparedSerenaInstallation{Closure: closure, Entrypoint: executable, InventorySHA256: inventory.SHA256},
+		WorkDeadline: r.WorkDeadline, CleanupDeadline: r.AbsoluteCleanupDeadline,
+	}
+	if err := request.validate(work, false); err != nil {
+		t.Fatal("compact attempt refused before qualification", err)
+	}
+	if err := request.validate(cleanup, true); err != nil {
+		t.Fatal("compact attempt refused during final receiving", err)
+	}
+	for _, tc := range []struct {
+		name   string
+		change func(*PreparedSerenaQualificationRequest)
+	}{
+		{"legacy_attempt", func(q *PreparedSerenaQualificationRequest) {
+			q.Roots.Attempt.Path = filepath.Join(r.Namespace, key, "attempts", r.OperationID)
+		}},
+		{"foreign_package_attempt", func(q *PreparedSerenaQualificationRequest) {
+			parent, leaf := serenaOwnedTreeLocation(SerenaOwnedTreeRequest{Namespace: r.Namespace, PackageIdentitySHA256: strings.Repeat("0", 64), OperationID: r.OperationID, Kind: "attempt"})
+			q.Roots.Attempt.Path = filepath.Join(parent, leaf)
+		}},
+		{"foreign_operation_attempt", func(q *PreparedSerenaQualificationRequest) {
+			parent, leaf := serenaOwnedTreeLocation(SerenaOwnedTreeRequest{Namespace: r.Namespace, PackageIdentitySHA256: key, OperationID: r.OperationID + "-other", Kind: "attempt"})
+			q.Roots.Attempt.Path = filepath.Join(parent, leaf)
+		}},
+		{"unsettled_installation", func(q *PreparedSerenaQualificationRequest) {
+			q.Installation.Closure.HandlesClosed = false
+		}},
+		{"request_mismatch", func(q *PreparedSerenaQualificationRequest) {
+			q.Inputs.Request.OperationID += "-other"
+		}},
+	} {
+		changed := request
+		tc.change(&changed)
+		if err := changed.validate(work, false); err == nil {
+			t.Errorf("%s admitted before qualification", tc.name)
+		}
+		if err := changed.validate(cleanup, true); err == nil {
+			t.Errorf("%s admitted during final receiving", tc.name)
+		}
+	}
+	cancelWork()
+	removed, err := a.cleanupAttempt(cleanup, roots, closure)
+	if err != nil || !removed.AttemptAbsent || !removed.LinksDischarged || !removed.NoPendingResources {
+		t.Fatal("qualification fixture attempt cleanup did not complete", err)
+	}
+}

+	if err != nil {
+		t.Fatal(err)
+	}
+	program, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return library, program
+}
+
+func TestRustRetainedCreatorRetainsBeforeNativeCreation(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	var custody *rustNativeOwner
+	t.Cleanup(func() {
+		if custody != nil && custody.raw != 0 {
+			_, _ = custody.Stop(17)
+			_, _ = custody.Finish(10000)
+			if err := custody.Release(); err != nil {
+				t.Errorf("custody release: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("library release: %v", err)
+		}
+	})
+	cwd := t.TempDir()
+	markerDir := filepath.Join(cwd, "rust-owner-owned-child")
+	if err := os.Mkdir(markerDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	retained, created, err := library.startRetainedRustOwner(ctx, program, cwd, []string{
+		"-test.run=^TestRustOwnerOwnedChild$", "-test.outputdir=" + markerDir,
+	}, func(owner *rustNativeOwner) error {
+		custody = owner
+		if owner == nil || owner.raw != 0 {
+			return errors.New("retention received a post-create owner")
+		}
+		if err := library.Close(); err == nil {
+			return errors.New("library was unloadable while original custody was reserved")
+		}
+		return nil
+	})
+	if err != nil || retained == nil || retained != custody || retained.raw == 0 || created.PID == 0 {
+		t.Fatalf("custody=%t native=%t pid=%d err=%v", retained == custody, retained != nil && retained.raw != 0, created.PID, err)
+	}
+	if _, err := os.Stat(filepath.Join(markerDir, "started")); !os.IsNotExist(err) {
+		t.Fatalf("suspended owner ran before admission: %v", err)
+	}
+	identity, err := retained.QueryIdentity()
+	if err != nil || identity.PID != created.PID || identity.WaitState != 1 {
+		t.Fatalf("retained original identity PID=%d wait=%d err=%v", identity.PID, identity.WaitState, err)
+	}
+	if _, err := retained.Stop(17); err != nil {
+		t.Fatalf("original Job stop: %v", err)
+	}
+	settled, err := retained.Finish(10000)
+	if err != nil || settled.State != 2 || settled.PID != created.PID || settled.Flags&1 == 0 {
+		t.Fatalf("stop settlement=%+v err=%v", settled, err)
+	}
+	if err := retained.Release(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRustRetainedCreatorSealsBeforeCreate(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	defer func() {
+		if err := library.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var original *rustNativeOwner
+	retained, observed, err := library.startRetainedRustOwner(ctx, program, t.TempDir(), nil, func(owner *rustNativeOwner) error {
+		original = owner
+		if _, stopErr := owner.Stop(1); stopErr == nil {
+			return errors.New("pre-create Stop was not noticed")
+		}
+		return nil
+	})
+	if err == nil || retained != original || retained.raw != 0 || observed.PID != 0 || library.activeOwners.Load() != 0 {
+		t.Fatalf("sealed custody=%t raw=%#x pid=%d owners=%d err=%v", retained == original, retained.raw, observed.PID, library.activeOwners.Load(), err)
+	}
+}
+
+func TestRustRetainedCreatorCancellationDuringRetention(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	defer func() {
+		if err := library.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	var original *rustNativeOwner
+	retained, observed, err := library.startRetainedRustOwner(ctx, program, t.TempDir(), nil, func(owner *rustNativeOwner) error {
+		original = owner
+		cancel()
+		return nil
+	})
+	if retained != original || retained.raw != 0 || observed.PID != 0 || library.activeOwners.Load() != 0 || !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled custody=%t raw=%#x pid=%d owners=%d err=%v", retained == original, retained.raw, observed.PID, library.activeOwners.Load(), err)
+	}
+}
+
+func TestRustRetainedCreatorCallbackFailureHasNoNativeEffect(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		callback func(*rustNativeOwner) error
+	}{
+		{"error", func(*rustNativeOwner) error { return errors.New("controlled retention refusal") }},
+		{"panic", func(*rustNativeOwner) error { panic("controlled retention panic") }},
+		{"release", func(o *rustNativeOwner) error {
+			if err := o.Release(); err == nil {
+				return errors.New("pre-create Release silently succeeded")
+			}
+			return nil
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			library, program := rustOwnerRetentionFixture(t)
+			defer func() {
+				if err := library.Close(); err != nil {
+					t.Error(err)
+				}
+			}()
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			var original *rustNativeOwner
+			retained, result, err := library.startRetainedRustOwner(ctx, program, t.TempDir(), nil,
+				func(o *rustNativeOwner) error {
+					original = o
+					return test.callback(o)
+				})
+			if err == nil || retained != original || retained == nil || retained.raw != 0 ||
+				result.PID != 0 || library.activeOwners.Load() != 0 {
+				t.Fatalf("callback %s retained=%t native=%t pid=%d uses=%d err=%v",
+					test.name, retained == original, retained != nil && retained.raw != 0, result.PID, library.activeOwners.Load(), err)
+			}
+		})
+	}
+}
+
+func TestRustRetainedCreatorNativeCreateFailurePreservesRetainedObject(t *testing.T) {
+	library, _ := rustOwnerRetentionFixture(t)
+	defer func() {
+		if err := library.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	cwd := t.TempDir()
+	missing := filepath.Join(cwd, "missing-rust-child.exe")
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var original *rustNativeOwner
+	retained, outcome, err := library.startRetainedRustOwner(ctx, missing, cwd, nil, func(o *rustNativeOwner) error {
+		original = o
+		return nil
+	})
+	if err == nil || retained == nil || retained != original || retained.raw != 0 || library.activeOwners.Load() != 0 ||
+		outcome.PID != 0 {
+		t.Fatalf("native failure retained=%t raw=%#x uses=%d pid=%d err=%v",
+			retained == original, retained.raw, library.activeOwners.Load(), outcome.PID, err)
+	}
+}
diff --git a/internal/process/rust_owner_root_wait_windows.go b/internal/process/rust_owner_root_wait_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..e22296cb2dc8b32d8262f6304653ae028b5f2142
--- /dev/null
+++ b/internal/process/rust_owner_root_wait_windows.go
@@ -0,0 +1,138 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+)
+
+// rustRootWaitResult is a historical observation of the original native root.
+// It is not Job completion, resource settlement or an os/exec wait result.
+type rustRootWaitResult struct {
+	Known    bool
+	PID      uint32
+	ExitCode uint32
+}
+
+// WaitRootWithin observes the original root without waiting for its descendants
+// to exit or closing any resources. It uses the caller's finite deadline and
+// leaves Stop available between native wait slices. Only actual root exit is
+// cached; cancellation and Job-query errors belong to the current operation.
+func (owner *rustNativeOwner) WaitRootWithin(ctx context.Context) (rustRootWaitResult, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return rustRootWaitResult{}, err
+	}
+	return owner.waitRoot(ctx)
+}
+
+// waitRoot(nil) belongs to the facade's existing lifetime waiter. It creates
+// no observer worker and never inherits the finite creation admission context.
+// A non-nil context may also carry cancellation without a deadline for the
+// foreground lifetime. Public finite observers validate their deadline first.
+// Short native slices keep Stop available while the service root is alive.
+func (owner *rustNativeOwner) waitRoot(ctx context.Context) (rustRootWaitResult, error) {
+	if owner == nil {
+		return rustRootWaitResult{}, errors.New("missing original Rust owner")
+	}
+	for {
+		// A published historical fact remains readable after cancellation or
+		// resource release, even while another operation holds native locks.
+		if result := owner.cachedRootWait(); result.Known {
+			if ctx != nil {
+				return result, ctx.Err()
+			}
+			return result, nil
+		}
+		if err := lockRustRootObservationContext(ctx, &owner.mu); err != nil {
+			return owner.cachedRootWait(), err
+		}
+		if result := owner.cachedRootWait(); result.Known {
+			owner.mu.Unlock()
+			if ctx != nil {
+				return result, ctx.Err()
+			}
+			return result, nil
+		}
+		_, closeStarted, err := owner.waitForExitObservationLocked(ctx, 50, nil)
+		result := owner.cachedRootWait()
+		owner.mu.Unlock()
+		if result.Known || err != nil {
+			return result, err
+		}
+		if closeStarted {
+			return result, errors.New("original Rust close started without published root exit")
+		}
+		// Both native locks are free here. Leave an admission window for a
+		// finite TryLock operation before the lifetime waiter requests another slice.
+		if ctx == nil {
+			time.Sleep(creatorClosureAdmissionInterval)
+		} else {
+			select {
+			case <-ctx.Done():
+				return owner.cachedRootWait(), ctx.Err()
+			case <-time.After(creatorClosureAdmissionInterval):
+			}
+		}
+	}
+}
+
+// lockRustRootObservationContext is cancellation-only. Terminal/create paths
+// keep their existing finite-deadline admission; observation creates no owner,
+// seals no custody, and cannot extend a terminal deadline.
+func lockRustRootObservationContext(ctx context.Context, mu *sync.Mutex) error {
+	if ctx == nil {
+		mu.Lock()
+		return nil
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if mu.TryLock() {
+			if err := ctx.Err(); err != nil {
+				mu.Unlock()
+				return err
+			}
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(creatorClosureAdmissionInterval):
+		}
+	}
+}
+
+// cachedRootWait copies the single immutable publication. Nil is the only
+// unknown state; the pointed-to value is never changed after Store.
+func (owner *rustNativeOwner) cachedRootWait() rustRootWaitResult {
+	if root := owner.rootWait.Load(); root != nil {
+		return *root
+	}
+	return rustRootWaitResult{}
+}
+
+// publishRootWait is called with owner.mu held, after ABI validation and before
+// releasing that mutex. Native close uses the same lock and cannot overtake
+// publication. Previously observed exit facts never change, even on an error.
+func (owner *rustNativeOwner) publishRootWait(pid, flags, exitCode uint32) error {
+	if pid != 0 && owner.originalPID != 0 && pid != owner.originalPID {
+		return fmt.Errorf("%w: original root PID changed", errRustOwnerOutcome)
+	}
+	if flags&1 == 0 {
+		return nil
+	}
+	result := rustRootWaitResult{Known: true, PID: pid, ExitCode: exitCode}
+	if prior := owner.cachedRootWait(); prior.Known {
+		if prior != result {
+			return fmt.Errorf("%w: published original root exit changed", errRustOwnerOutcome)
+		}
+		return nil
+	}
+	owner.rootWait.Store(&result)
+	return nil
+}
diff --git a/internal/process/rust_owner_root_wait_windows_test.go b/internal/process/rust_owner_root_wait_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..04c5d1f6f63df41330981daad9e95422eba80f7e
--- /dev/null
+++ b/internal/process/rust_owner_root_wait_windows_test.go
@@ -0,0 +1,524 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+func rustRootWaitTestOwner(t *testing.T, wait uintptr) *rustNativeOwner {
+	t.Helper()
+	owner := &rustNativeOwner{
+		raw: 0x4242, originalPID: 42, memberGate: newOriginalMemberCustody(),
+		library: &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{
+			"mh_wait1": wait,
+			"mh_close1": syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				t.Error("root observation entered unexpected native close")
+				return 1
+			}),
+		}},
+	}
+	owner.library.activeOwners.Store(1)
+	return owner
+}
+
+func TestRustOwnerRootWaitKnownPendingPreservesDWORD(t *testing.T) {
+	for _, code := range []uint32{0, 7, 259, 0x80000000} {
+		t.Run(fmt.Sprintf("%08x", code), func(t *testing.T) {
+			calls, badCall := 0, false
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				calls++
+				badCall = badCall || raw != 0x4242 || size != 32 || ms > 50
+				growRustOwnerCallbackStack(32)
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, Flags: 3, PID: 42, RootExit: code, Active: 1}
+				return 0
+			})
+			owner := rustRootWaitTestOwner(t, wait)
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			want := rustRootWaitResult{Known: true, PID: 42, ExitCode: code}
+			got, err := owner.WaitRootWithin(ctx)
+			if err != nil || got != want || calls != 1 || badCall || owner.closeStarted {
+				t.Fatalf("root wait lost independent DWORD result: got=%+v err=%v calls=%d badCall=%t", got, err, calls, badCall)
+			}
+			leave, err := owner.memberGate.enterQuery(nil)
+			if err != nil {
+				t.Fatalf("root observation sealed original member custody: %v", err)
+			}
+			leave()
+			pending, err := owner.Finish(0)
+			if err != nil || pending.State != 1 || pending.Active != 1 || pending.RootExit != code || owner.closeStarted {
+				t.Fatalf("known root became whole-Job completion: got=%+v err=%v", pending, err)
+			}
+			// Simulate the already-released allocation and unloaded DLL. Cached
+			// root facts must no longer need either native resource.
+			owner.raw = 0
+			owner.library.activeOwners.Store(0)
+			owner.library.ready = false
+			owner.library.closeAttempted = true
+			got, err = owner.WaitRootWithin(ctx)
+			if err != nil || got != want || calls != 2 || owner.library.activeOwners.Load() != 0 {
+				t.Fatalf("released cache touched native state: got=%+v err=%v calls=%d", got, err, calls)
+			}
+		})
+	}
+}
+
+func TestRustOwnerRootWaitRejectsUnusableContext(t *testing.T) {
+	cancelled, cancel := context.WithTimeout(context.Background(), time.Second)
+	cancel()
+	for _, cached := range []bool{false, true} {
+		owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+			t.Error("invalid context entered native wait")
+			return 1
+		}))
+		if cached {
+			owner.rootWait.Store(&rustRootWaitResult{Known: true, PID: 42, ExitCode: 7})
+		}
+		for _, ctx := range []context.Context{nil, context.Background(), cancelled} {
+			if got, err := owner.WaitRootWithin(ctx); err == nil || got != (rustRootWaitResult{}) {
+				t.Fatalf("unusable context returned a root fact: cached=%t got=%+v err=%v", cached, got, err)
+			}
+		}
+	}
+}
+
+func TestRustOwnerRootWaitPendingKeepsCallerDeadline(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	calls, pending, badInterval := 0, true, false
+	owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		calls++
+		badInterval = badInterval || ms == 0 || ms > 50
+		*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, PID: 42}
+		if pending {
+			if calls == 3 {
+				// Three unknown observations reach the original caller's
+				// deadline. This callback controls cancellation, not native timing.
+				<-ctx.Done()
+			}
+		} else {
+			*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+		}
+		return 0
+	}))
+	got, err := owner.WaitRootWithin(ctx)
+	if !errors.Is(err, context.DeadlineExceeded) || got.Known || owner.cachedRootWait().Known ||
+		calls != 3 || badInterval || owner.closeStarted {
+		t.Fatalf("pending wait lost caller deadline: got=%+v err=%v calls=%d badInterval=%t", got, err, calls, badInterval)
+	}
+	pending = false
+	fresh, cancelFresh := context.WithTimeout(context.Background(), time.Second)
+	defer cancelFresh()
+	got, err = owner.WaitRootWithin(fresh)
+	if err != nil || got != (rustRootWaitResult{Known: true, PID: 42, ExitCode: 7}) || calls != 4 {
+		t.Fatalf("expired observer poisoned later root observation: got=%+v err=%v calls=%d", got, err, calls)
+	}
+}
+
+func TestRustOwnerRootWaitRetainsFactOnObservationError(t *testing.T) {
+	for _, nativeFailure := range []bool{false, true} {
+		t.Run(fmt.Sprintf("native-failure=%t", nativeFailure), func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			calls := 0
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				calls++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, Flags: 3, PID: 42, RootExit: 259, Active: 1}
+				if nativeFailure {
+					*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, Flags: 1, PID: 42, RootExit: 259, NativeError: 5}
+					return 3
+				}
+				cancel() // Cancellation after native observation must retain its fact.
+				return 0
+			})
+			owner := rustRootWaitTestOwner(t, wait)

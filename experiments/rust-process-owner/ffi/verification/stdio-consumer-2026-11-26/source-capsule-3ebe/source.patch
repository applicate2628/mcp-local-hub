+func TestRustOwnerLibraryNativeIntegration(t *testing.T) {
+	product := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT")
+	commit := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_COMMIT")
+	hash := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_SHA256")
+	if product == "" || commit == "" || hash == "" {
+		t.Skip("set MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT, MCPHUB_RUST_OWNER_INTEGRATION_COMMIT, and MCPHUB_RUST_OWNER_INTEGRATION_SHA256")
+	}
+	library, err := openBundledRustOwnerLibrary(product, commit, hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"mh_version1", "mh_query_identity1", "mh_create1", "mh_release1"} {
+		if address, ok := library.procedure(name); !ok || address == 0 {
+			t.Fatalf("procedure %s=%#x ok=%v", name, address, ok)
+		}
+	}
+	if err := library.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := library.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/process/rust_owner_library_members_windows_test.go b/internal/process/rust_owner_library_members_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d2e3558a87b121bace72e1b9004c68a01c90399a
--- /dev/null
+++ b/internal/process/rust_owner_library_members_windows_test.go
@@ -0,0 +1,169 @@
+//go:build windows
+
+package process
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+func newRustOwnerMemberTestLayout(t *testing.T) rustOwnerTestLayout {
+	t.Helper()
+	layout := newRustOwnerTestLayout(t)
+	layout.expected.Exports = runtimeidentity.WindowsProcessOwnerMemberExportsV1()
+	writeRustOwnerTestIdentity(t, layout.identity, layout.expected)
+	return layout
+}
+
+func TestOpenRustOwnerLibraryMemberProfile(t *testing.T) {
+	layout := newRustOwnerMemberTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	library, err, calls := openFakeRustOwner(t, layout, api)
+	if library != nil {
+		t.Cleanup(func() {
+			if err := library.Close(); err != nil {
+				t.Error(err)
+			}
+		})
+	}
+	if err != nil || library == nil || !library.ready || calls != 2 ||
+		api.versionCalls != 1 || api.loadCalls != 1 || api.lockGuard.closeCalls != 1 ||
+		!reflect.DeepEqual(api.procNames, layout.expected.Exports) {
+		t.Fatalf("member profile: ready=%t admission=%d load=%d version=%d resolved=%v error=%v",
+			library != nil && library.ready, calls, api.loadCalls, api.versionCalls, api.procNames, err)
+	}
+	for _, name := range layout.expected.Exports {
+		if addr, ok := library.procedure(name); !ok || addr != api.procAddrs[name] {
+			t.Fatalf("member profile omitted %s: address=%#x present=%t", name, addr, ok)
+		}
+	}
+}
+
+func TestOpenRustOwnerLibraryLegacyProfileDoesNotResolveMembers(t *testing.T) {
+	layout := newRustOwnerTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	for _, name := range []string{"mh_members_close1", "mh_members_observe1", "mh_members_revalidate1", "mh_members_snapshot1"} {
+		api.procAddrs[name] = 0x4000
+	}
+	library, err, calls := openFakeRustOwner(t, layout, api)
+	if library != nil {
+		t.Cleanup(func() { _ = library.Close() })
+	}
+	if err != nil || library == nil || calls != 2 || !reflect.DeepEqual(api.procNames, layout.expected.Exports) {
+		t.Fatalf("legacy profile: admission=%d resolved=%v error=%v", calls, api.procNames, err)
+	}
+	for _, name := range []string{"mh_members_close1", "mh_members_observe1", "mh_members_revalidate1", "mh_members_snapshot1"} {
+		if addr, ok := library.procedure(name); ok || addr != 0 {
+			t.Fatalf("legacy identity exposed unadmitted member export %s", name)
+		}
+	}
+}
+
+func TestOpenRustOwnerLibraryRejectsUnrecognizedMemberReceipt(t *testing.T) {
+	for _, missing := range []string{"mh_members_close1", "mh_members_observe1", "mh_members_revalidate1", "mh_members_snapshot1", "unknown"} {
+		t.Run(missing, func(t *testing.T) {
+			layout := newRustOwnerMemberTestLayout(t)
+			receipt := layout.expected
+			receipt.Exports = append([]string(nil), receipt.Exports...)
+			if missing == "unknown" {
+				receipt.Exports[len(receipt.Exports)-1] = "mh_zz_unknown1"
+			} else {
+				for i, name := range receipt.Exports {
+					if name == missing {
+						receipt.Exports = append(receipt.Exports[:i], receipt.Exports[i+1:]...)
+						break
+					}
+				}
+			}
+			writeRustOwnerTestIdentity(t, layout.identity, receipt)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			library, err, calls := openFakeRustOwner(t, layout, api)
+			if library != nil {
+				t.Cleanup(func() { _ = library.Close() })
+			}
+			if err == nil || library != nil || calls != 0 || api.loadCalls != 0 || api.lockGuard.closeCalls != 1 {
+				t.Fatalf("unrecognized receipt reached admission: error=%v admission=%d load=%d guard=%d",
+					err, calls, api.loadCalls, api.lockGuard.closeCalls)
+			}
+		})
+	}
+}
+
+func TestOpenRustOwnerLibraryRequiresResolvedMemberGroup(t *testing.T) {
+	for _, name := range []string{"mh_members_close1", "mh_members_observe1", "mh_members_revalidate1", "mh_members_snapshot1"} {
+		t.Run(name, func(t *testing.T) {
+			layout := newRustOwnerMemberTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			delete(api.procAddrs, name)
+			library, err, calls := openFakeRustOwner(t, layout, api)
+			if library != nil {
+				t.Cleanup(func() { _ = library.Close() })
+			}
+			if err == nil || !strings.Contains(err.Error(), name) || library != nil || calls != 1 ||
+				api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+				t.Fatalf("unresolved member export accepted: name=%s error=%v admission=%d free=%d guard=%d",
+					name, err, calls, api.freeCalls, api.lockGuard.closeCalls)
+			}
+		})
+	}
+}
+
+func TestOpenRustOwnerLibraryRejectsMismatchedExportProfile(t *testing.T) {
+	for _, receiptMembers := range []bool{false, true} {
+		profile := "legacy"
+		if receiptMembers {
+			profile = "members"
+		}
+		for _, postLoad := range []bool{false, true} {
+			stage := "before-load"
+			if postLoad {
+				stage = "after-load"
+			}
+			t.Run(profile+"/"+stage, func(t *testing.T) {
+				var layout rustOwnerTestLayout
+				other := runtimeidentity.WindowsProcessOwnerMemberExportsV1()
+				if receiptMembers {
+					layout = newRustOwnerMemberTestLayout(t)
+					other = runtimeidentity.WindowsProcessOwnerExportsV1()
+				} else {
+					layout = newRustOwnerTestLayout(t)
+				}
+				api := newFakeRustOwnerLibraryAPI(layout)
+				calls := 0
+				base := matchingRustOwnerAdmission(layout, &calls)
+				admit := func(path string, machine uint16, exports []string, commit string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error) {
+					value, err := base(path, machine, exports, commit)
+					if err != nil {
+						return value, err
+					}
+					if !postLoad || calls == 2 {
+						// Keep the trusted hash/commit; only the independently observed
+						// export profile contradicts the receipt.
+						value.Exports = other
+					}
+					return value, nil
+				}
+				library, err := openRustOwnerLibrary(layout.product, rustOwnerTestCommit, layout.expected.SHA256,
+					rustOwnerLibraryDependencies{api: api, admit: admit})
+				if library != nil {
+					t.Cleanup(func() { _ = library.Close() })
+				}
+				wantCalls, wantLoad := 1, 0
+				wantMessage := "identity"
+				if postLoad {
+					wantCalls, wantLoad = 2, 1
+					wantMessage = "changed after load"
+				}
+				if err == nil || !strings.Contains(err.Error(), wantMessage) ||
+					library != nil || calls != wantCalls || api.loadCalls != wantLoad ||
+					api.freeCalls != wantLoad || api.lockGuard.closeCalls != 1 {
+					t.Fatalf("mismatched profile accepted: error=%v admission=%d load=%d free=%d guard=%d",
+						err, calls, api.loadCalls, api.freeCalls, api.lockGuard.closeCalls)
+				}
+			})
+		}
+	}
+}

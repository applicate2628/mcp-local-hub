+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	"mcp-local-hub/internal/runtimeidentity"

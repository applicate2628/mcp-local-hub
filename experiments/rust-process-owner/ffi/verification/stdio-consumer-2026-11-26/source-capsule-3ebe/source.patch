+			case <-time.After(5 * time.Second):
+				t.Error("terminal test caller did not return after cancellation")
+			}
+		}
+	})
+	go func() {
+		permit, err := source.gate.beginTerminal(ctx)
+		done <- originalMemberTerminalTestResult{permit: permit, err: err}

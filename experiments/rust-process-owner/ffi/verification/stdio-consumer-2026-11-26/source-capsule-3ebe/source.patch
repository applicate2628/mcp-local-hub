+// These tests use synthetic contained errors and the real async worker. Keeping
+// the exact error pointer proves the retention path without claiming a native
+// process was created or cleaned up by this fixture.
+func TestAsyncRun_CleanupFailureRetainsOriginalError(t *testing.T) {
+	cleanupFailure := errors.New("private cleanup payload")
+	exitFailure := errors.New("ordinary nonzero exit")
+	exitCode := 7
+	for _, tc := range []struct {
+		name       string
+		contextErr error
+		contained  *process.ContainedRunError
+	}{
+		{
+			name:       "deadline_with_cleanup",
+			contextErr: context.DeadlineExceeded,
+			contained: &process.ContainedRunError{
+				Stage: process.ContainedStageContext, Cause: context.DeadlineExceeded,
+				CleanupStage: process.ContainedStageCleanup, CleanupCause: cleanupFailure,
+			},
+		},
+		{
+			name: "exit_with_cleanup",
+			contained: &process.ContainedRunError{
+				Stage: process.ContainedStageExit, Cause: exitFailure, ExitCode: &exitCode,
+				CleanupStage: process.ContainedStageCleanup, CleanupCause: cleanupFailure,
+			},
+		},
+		{
+			name: "cleanup_primary",
+			contained: &process.ContainedRunError{
+				Stage: process.ContainedStageCleanup, Cause: cleanupFailure,
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			execution := projectAsyncCommandResult(tc.contextErr, runResult{Stdout: "captured", EnvSource: "fixture"}, tc.contained)
+			var projected *process.ContainedRunError
+			if !errors.As(execution.Err, &projected) || projected != tc.contained || !errors.Is(execution.Err, cleanupFailure) {
+				t.Fatalf("projection lost original contained error: execution=%#v", execution)
+			}
+			if tc.contextErr != nil {
+				joined, ok := execution.Err.(interface{ Unwrap() []error })
+				if !ok {
+					t.Fatalf("deadline projection has no ordered causes: %T", execution.Err)
+				}
+				causes := joined.Unwrap()
+				if len(causes) != 2 || causes[0] != context.DeadlineExceeded || causes[1] != tc.contained || !execution.Result.TimedOut {
+					t.Fatalf("deadline projection lost primary/secondary order: causes=%#v result=%#v", causes, execution.Result)
+				}
+			} else if execution.Err != tc.contained || execution.FailureID != "oneapi_run_containment_failed" {
+				t.Fatalf("cleanup projected as ordinary exit: %#v", execution)
+			}
+
+			store := &asyncTestStore{}
+			var launches atomic.Int32
+			var runningRaw []byte
+			var readErr error
+			owner := newAsyncTestOwner(t, store, func(context.Context, oneAPIRunRequest) asyncExecution {
+				launches.Add(1)
+				runningRaw, readErr = store.Read("")
+				return execution
+			})
+			request := asyncRequest("retained", time.Minute)
+			start, err := owner.Start(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			record := waitForAsyncWorkerRecord(t, owner, start.RunID)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			if !record.unsettled || record.cleanupErr != execution.Err || record.State != asyncStateRunning || record.terminal() ||
+				record.Result != nil || record.FinishedAt != nil || record.FinishSeq != 0 {
+				t.Fatalf("cleanup failure became settled or lost custody: %#v", record)
+			}
+			select {
+			case <-record.done:
+				t.Fatal("terminal done closed after incomplete cleanup")
+			default:
+			}
+			if owner.seq != 0 {
+				t.Fatalf("cleanup failure advanced terminal sequence: %d", owner.seq)
+			}
+
+			assertRetained := func(label string, err error) {
+				t.Helper()
+				var got *process.ContainedRunError
+				if !errors.Is(err, errAsyncCleanupUnsettled) || !errors.Is(err, cleanupFailure) ||
+					!errors.As(err, &got) || got != tc.contained {
+					t.Fatalf("%s lost fixed failure code or original error: %v", label, err)
+				}
+				if tc.contextErr != nil && !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("%s lost deadline: %v", label, err)
+				}
+			}
+			status, err := owner.Status(start.RunID)
+			assertRetained("Status", err)
+			if status.Terminal {
+				t.Fatalf("Status reported terminal: %#v", status)
+			}
+			result, err := owner.Result(start.RunID)
+			assertRetained("Result", err)
+			if result.Terminal || result.Available || result.Result != nil {
+				t.Fatalf("Result exposed completion: %#v", result)
+			}
+			cancelled, err := owner.Cancel(start.RunID, true)
+			assertRetained("Cancel", err)
+			if cancelled.Terminal {
+				t.Fatalf("Cancel reported terminal: %#v", cancelled)
+			}
+			if _, err := owner.Start(asyncRequest("another-run", time.Minute)); !errors.Is(err, errAsyncBusy) {
+				t.Fatalf("new Start after incomplete cleanup = %v, want busy", err)
+			}
+			replay, err := owner.Start(request)
+			if err != nil || !replay.Replayed || replay.Terminal || replay.RunID != start.RunID || launches.Load() != 1 {
+				t.Fatalf("idempotent replay=%#v err=%v launches=%d", replay, err, launches.Load())
+			}
+
+			rs := newTestServer(nil, false, nil)
+			rs.asyncOwner = owner
+			for _, action := range []string{"status", "result", "cancel"} {
+				args := map[string]any{"action": action, "run_id": start.RunID}
+				if action == "cancel" {
+					args["confirm"] = true
+				}
+				raw, err := json.Marshal(args)
+				if err != nil {
+					t.Fatal(err)
+				}
+				response, err := rs.runInOneAPIEnvTool(t.Context(), (&mockCallToolRequest{Arguments: raw}).toReal())
+				if err != nil || response == nil || !response.IsError || len(response.Content) != 1 {
+					t.Fatalf("%s response=%#v err=%v", action, response, err)
+				}
+				text, ok := response.Content[0].(*mcp.TextContent)
+				if !ok || text.Text != errAsyncCleanupUnsettled.Error() {
+					t.Fatalf("%s must expose only the fixed cleanup code: %#v", action, response.Content)
+				}
+			}
+
+			persisted, err := store.Read("")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(persisted, runningRaw) {
+				t.Fatal("incomplete cleanup changed the durable nonterminal receipt")
+			}
+			var snapshot asyncPersistedRunSnapshot
+			if err := json.Unmarshal(persisted, &snapshot); err != nil {
+				t.Fatal(err)
+			}
+			if snapshot.TerminalSequence != 0 || len(snapshot.Runs) != 1 || snapshot.Runs[0].State != asyncStateRunning ||
+				snapshot.Runs[0].Result != nil || snapshot.Runs[0].FinishedAt != nil || snapshot.Runs[0].FinishSeq != 0 {
+				t.Fatalf("persisted cleanup failure as terminal: %#v", snapshot)
+			}
+
+			records := map[string]*asyncRunRecord{record.RunID: cloneAsyncRecord(record)}
+			for i := 1; i <= maxAsyncTerminalRuns+1; i++ {
+				id := fmt.Sprintf("terminal-%d", i)
+				records[id] = &asyncRunRecord{RunID: id, State: asyncStateCompleted, FinishSeq: uint64(i)}
+			}
+			evictAsyncTerminals(records)
+			retained := records[record.RunID]
+			if len(records) != maxAsyncTerminalRuns+1 || retained == nil || retained.cleanupErr != execution.Err {
+				t.Fatal("terminal eviction or cloning discarded the unsettled record's original error")
+			}
+
+			closeErr := owner.Close()
+			assertRetained("Close", closeErr)
+			assertRetained("repeated Close", owner.Close())
+			owner.mu.Lock()
+			retainedAfterClose := owner.runs[start.RunID].cleanupErr
+			leaseAfterClose := owner.lease
+			owner.mu.Unlock()
+			if retainedAfterClose != execution.Err || leaseAfterClose != nil {
+				t.Fatalf("Close lost custody or changed lease release policy: error=%v lease=%v", retainedAfterClose, leaseAfterClose)
+			}
+
+			var recoveredLaunches atomic.Int32
+			recovered, err := newAsyncRunOwner(t.Context(), asyncOwnerOptions{
+				StatePath: owner.statePath,
+				Read:      store.Read, Write: store.Write,
+				Execute: func(context.Context, oneAPIRunRequest) asyncExecution {
+					recoveredLaunches.Add(1)
+					return asyncExecution{}
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = recovered.Close() })
+			recoveredStatus, err := recovered.Status(start.RunID)
+			if err != nil || recoveredStatus.Terminal || recoveredStatus.State != asyncStateRunning ||
+				recoveredStatus.FailureID != errAsyncRecoveryUnsettled.Error() {
+				t.Fatalf("restart status=%#v err=%v", recoveredStatus, err)
+			}
+			recoveredResult, err := recovered.Result(start.RunID)
+			if err != nil || recoveredResult.Terminal || recoveredResult.Available || recoveredResult.Result != nil {
+				t.Fatalf("restart result=%#v err=%v", recoveredResult, err)
+			}
+			if _, err := recovered.Cancel(start.RunID, true); !errors.Is(err, errAsyncRecoveryUnsettled) {
+				t.Fatalf("restart Cancel=%v, want recovery unsettled", err)
+			}
+			if _, err := recovered.Start(asyncRequest("after-restart", time.Minute)); !errors.Is(err, errAsyncBusy) {
+				t.Fatalf("restart Start=%v, want busy", err)
+			}
+			if recovered.runs[start.RunID].cleanupErr != nil || recoveredLaunches.Load() != 0 {
+				t.Fatal("restart reconstructed runtime custody or executed the old request")
+			}
+			if err := recovered.Close(); !errors.Is(err, errAsyncRecoveryUnsettled) {
+				t.Fatalf("restart Close=%v, want recovery unsettled", err)
+			}
+		})
+	}
+}

+// This command performs no installation. Its original native and IO completion
+// lets the tree tests exercise cleanup without fabricating process settlement.
+func serenaAcquisitionInertCommand(t *testing.T, ctx context.Context, r PreparedSerenaRequest) (PreparedSerenaFile, PreparedSerenaExecutionClosure) {
+	t.Helper()
+	executable, _, err := qualifyPreparedSerenaFile(ctx, os.Getenv("COMSPEC"), 64<<20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := runPreparedSerenaInvocation(ctx, preparedSerenaInvocation{
+		OperationID: r.OperationID, Executable: executable,
+		Args: []string{"/d", "/c", "exit", "/b", "0"}, Environment: os.Environ(),
+		WorkingDir: r.Namespace, PolicySHA256: r.PolicySHA256,
+		CleanupLimit: r.CleanupLimit, AbsoluteCleanupDeadline: r.AbsoluteCleanupDeadline,
+		StdoutLimit: 4096, StderrLimit: 4096,
+	})
+	if err != nil || !result.Closure.complete(r.OperationID) || !result.Closure.RootExitKnown || result.Closure.RootExitCode != 0 {
+		t.Fatalf("inert command did not settle: %v", err)
+	}
+	return executable, result.Closure
+}
+
+func serenaAcquisitionRequest(t *testing.T) PreparedSerenaRequest {
+	t.Helper()

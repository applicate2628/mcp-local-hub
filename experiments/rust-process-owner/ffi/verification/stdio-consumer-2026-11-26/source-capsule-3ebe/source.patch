+// Refusing callbacks inspect transport only. No callback creates a process or
+// issues an original/native owner, and all accepted version assertions are exact.
+func TestRustOwnerForegroundIOVersionAndExplicitNoConsole(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		foreground  bool
+		noConsole   bool
+		zeroOptions bool
+		argv0       string
+		version     uint32
+	}{
+		{name: "foreground", foreground: true, argv0: "alias", version: 3},
+		{name: "foreground-empty-argv0", foreground: true, version: 3},
+		{name: "foreground-zero-options", foreground: true, zeroOptions: true, argv0: "alias", version: 3},
+		{name: "foreground-explicit-no-console", foreground: true, noConsole: true, argv0: "alias", version: 2},
+		{name: "original-background", argv0: "alias", version: 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			layout := newRustOwnerBorrowTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			library, err, _ := openFakeRustOwner(t, layout, api)
+			if err != nil || library == nil {
+				t.Fatalf("fixture module: %v", err)
+			}
+			t.Cleanup(func() {
+				if err := library.Close(); err != nil {
+					t.Error(err)
+				}
+			})
+			streams := rustStdioTestFiles(t)
+			dir := t.TempDir()
+			cmd := &exec.Cmd{
+				Path: filepath.Join(dir, "not-executed.exe"), Dir: dir,
+				Args: []string{tc.argv0, "payload"}, Env: []string{"MCPHUB_V3_FIXTURE=exact"},
+			}
+			if tc.noConsole {
+				NoConsole(cmd)
+			} else if tc.zeroOptions {
+				cmd.SysProcAttr = &syscall.SysProcAttr{}
+			}
+			calls, legacyCalls := 0, 0
+			failure := ""
+			library.procedures["mh_create_io1"] = syscall.NewCallback(func(
+				req *rustOwnerCreate, reqBytes uintptr, ioContext *rustOwnerIOContext, ioBytes uintptr,
+				slot *uintptr, output *rustOwnerOutcome, outBytes uintptr,
+			) uintptr {
+				calls++
+				if output == nil || outBytes != 48 {
+					failure = "invalid output"
+					return 2
+				}
+				*output = rustOwnerOutcome{Size: 48, Version: 1}
+				if req == nil || reqBytes != 56 || req.Version != tc.version || req.Reserved != 0 ||
+					req.Argc != 2 || req.Args == nil || ioContext == nil || ioBytes != 40 || slot == nil || *slot != 0 {
+					failure = "request did not preserve its exact version/layout"
+					return 2
+				}
+				views := unsafe.Slice(req.Args, int(req.Argc))
+				for i, text := range []string{tc.argv0, "payload"} {
+					units, _ := syscall.UTF16FromString(text)
+					if !rustIOABIViewMatches(views[i], units) {
+						failure = "explicit argv0 or remaining argument changed"
+					}
+				}
+				image, _ := syscall.UTF16FromString(cmd.Path)
+				directory, _ := syscall.UTF16FromString(cmd.Dir)
+				if !rustIOABIViewMatches(req.Program, image) || !rustIOABIViewMatches(req.Cwd, directory) {
+					failure = "image or working directory changed"
+				}
+				for _, handle := range ioContext.Streams {
+					flags, flagErr := rustStdioTestHandleFlags(handle)
+					if handle == 0 || flagErr != nil || flags&windows.HANDLE_FLAG_INHERIT == 0 {
+						failure = "standard handle copy is not live and inheritable"
+					}
+				}
+				found := false
+				if ioContext.Environment.Count != 0 && ioContext.Environment.Entries != nil {
+					for _, entry := range unsafe.Slice(ioContext.Environment.Entries, int(ioContext.Environment.Count)) {
+						name, _ := syscall.UTF16FromString("MCPHUB_V3_FIXTURE")
+						value, _ := syscall.UTF16FromString("exact")
+						if rustIOABIViewMatches(entry.Name, name) && rustIOABIViewMatches(entry.Value, value) {
+							found = true
+						}
+					}
+				}
+				if !found {
+					failure = "explicit environment disappeared"
+				}
+				return 2 // MH_ABI refusal, with no native owner.
+			})
+			library.procedures["mh_create1"] = syscall.NewCallback(func(_, _, _, _, _ uintptr) uintptr {
+				legacyCalls++
+				return 2
+			})
+			library.procedures["mh_create_env1"] = syscall.NewCallback(func(_, _, _, _, _, _, _ uintptr) uintptr {
+				legacyCalls++
+				return 2
+			})
+			retains := 0
+			var retained *AtCreateJobProcess
+			retain := func(original *AtCreateJobProcess) error {
+				retains++
+				retained = original
+				return nil
+			}
+			open := func() (*rustOwnerLibrary, error) { return library, nil }
+			var original *AtCreateJobProcess
+			if tc.foreground {
+				original, err = startProductRustForegroundWithLibrary(rustStdioTestContext(t), cmd,
+					streams.Stdin, streams.Stdout, streams.Stderr, nil, retain, open)
+			} else {
+				original, err = startProductRustOriginal(rustStdioTestContext(t), cmd,
+					streams.Stdin, streams.Stdout, streams.Stderr, retain, open)
+			}
+			if err == nil || errors.Is(err, errRustOwnerOutcome) || calls != 1 || legacyCalls != 0 ||
+				failure != "" || original == nil || original != retained || retains != 1 || original.Created() {
+				t.Fatalf("exact create route: calls=%d legacy=%d failure=%q retains=%d err=%v", calls, legacyCalls, failure, retains, err)
+			}
+			rustProductReleaseNoChild(t, original, nil)
+			if library.handle != 0 || library.activeOwners.Load() != 0 {
+				t.Fatal("ABI refusal left module custody live")
+			}
+		})
+	}
+}

+func TestMemberExitedRootKeepsBirthAndRejectsExitedRetainedLeaf(t *testing.T) {
+	_, o, initial, marker, keep := memberFixture(t, "detach")
+	root, err := o.QueryIdentity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The existing finite fixture leaf exits naturally after ten seconds.
+	// This absolute readiness budget is not extended by pending native waits.
+	deadline := time.Now().Add(13 * time.Second)
+	if _, err := o.Admit(true); err != nil {
+		t.Fatal(err)
+	}
+	waitMemberMarker(t, marker+".grandchild")
+	var wait ExitObservation
+	for {
+		wait, err = o.WaitForExit(25)
+		if err != nil || wait.Flags&1 != 0 || !time.Now().Before(deadline) {
+			break
+		}
+	}
+	if err != nil || wait.State != waitPending || wait.RootExit != 7 || wait.Flags != 3 || wait.Active != 1 {
+		t.Fatalf("root/leaf readiness: %+v %v", wait, err)
+	}
+	generation, got, err := o.ObserveJobMembers(3000)
+	keep(generation)
+	if err != nil || !got.AcquisitionComplete || got.Original.PID != initial.PID ||
+		got.Original.CreationTime100ns != root.CreationTime100ns || got.Pre == nil ||
+		got.Pre.TotalProcesses != 2 || got.Pre.ActiveProcesses != 1 || len(got.Rows) != 1 ||
+		len(got.Resources) != 1 || got.Rows[0].PID == initial.PID || got.Resources[0].BorrowedOriginal {
+		t.Fatalf("exited root was reopened, lost, or inserted into live census: %s %v", memberSummary(got), err)
+	}
+	descendant := got.Rows[0].PID
+	if err := o.RevalidateJobMembers(generation, 3000, descendant); err != nil {
+		t.Fatal(err)
+	}
+	for {
+		wait, err = o.WaitForExit(25)
+		if err != nil || wait.State == waitExited || !time.Now().Before(deadline) {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if err != nil || wait.State != waitExited || wait.RootExit != 7 || wait.Active != 0 {
+		t.Fatalf("retained descendant did not exit naturally in budget: %+v %v", wait, err)
+	}
+	var native *MemberError
+	err = o.RevalidateJobMembers(generation, 3000, descendant)
+	if !errors.As(err, &native) || native.Kind == MemberDeadline || errors.Is(err, ErrMemberObservation) {
+		t.Fatalf("exited retained descendant was accepted, timed out, or failed only transport validation: %v", err)
+	}
+	historical, err := o.JobMemberSnapshot(generation)
+	if err != nil || !reflect.DeepEqual(historical, got) {
+		t.Fatalf("failed revalidation rewrote original acquisition: %s %v", memberSummary(historical), err)
+	}
+	requireMemberClose(t, o, generation)
+	out, err := o.Finish(3000)
+	if err != nil || out.State != complete || out.RootExit != 7 {
+		t.Fatalf("member lifecycle overwrote original root exit: %+v %v", out, err)
+	}
+}

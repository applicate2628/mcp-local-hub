+// This is a bounded read-factory integration test, not an issued publication.
+// The structural record only supplies the factory's input shape. The original
+// Windows tree, read acquisition, inventory and close are real; no package is
+// installed, process closure invented, or ValidatePublished success asserted.
+func TestSerenaPublishedReadAcquisitionCleanupLifetime(t *testing.T) {
+	root := hardenedTempDir(t)
+	previousRoot := daemonStateRootOverride
+	daemonStateRootOverride = root
+	t.Cleanup(func() { daemonStateRootOverride = previousRoot })
+
+	workEnd := time.Now().Add(time.Minute)
+	cleanupEnd := workEnd.Add(time.Minute)
+	work, cancelWork := context.WithDeadline(context.Background(), workEnd)
+	defer cancelWork()
+	cleanup, cancelCleanup := context.WithDeadline(context.Background(), cleanupEnd)
+	defer cancelCleanup()
+	acquisition, release, err := serenaPreparationAcquisitionContext(work, workEnd, cleanupEnd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+
+	request := preparedRequest()
+	request.Namespace = root
+	request.WorkLimit, request.CleanupLimit = time.Minute, time.Minute
+	request.WorkDeadline, request.AbsoluteCleanupDeadline = workEnd, cleanupEnd
+	key, err := request.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var generation *SerenaOwnedTree
+	var published *SerenaPublishedGenerationObservation
+	generationClosed, publishedClosed := false, false
+	t.Cleanup(func() {
+		if published != nil && !publishedClosed {
+			proof, closeErr := published.CloseObserved()
+			if err := errors.Join(closeErr, proof.Validate(published)); err != nil {
+				t.Errorf("original published read close: %v", err)
+			}
+		}
+		if generation != nil && !generationClosed {
+			proof, closeErr := generation.Close()
+			if closeErr != nil || !proof.Attempted || !proof.Closed || proof.Error != nil {
+				t.Errorf("original generation close: %+v, %v", proof, closeErr)
+			}
+		}
+	})
+	generation, err = AcquireSerenaOwnedTree(acquisition, SerenaOwnedTreeRequest{
+		Namespace: root, PackageIdentitySHA256: key, OperationID: request.OperationID,
+		GenerationID: request.GenerationID, Kind: "generation", Limits: request.OwnedTreeLimits,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, err := generation.Inventory(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	closed, err := generation.Close()
+	generationClosed = true
+	if err != nil || !closed.Attempted || !closed.Closed || closed.Error != nil {
+		t.Fatalf("generation fixture close: %+v, %v", closed, err)
+	}
+
+	record := syntheticPreparedRecord(request)
+	record.EnvironmentInventorySHA256 = before.SHA256
+	published, err = AcquireSerenaPublishedGenerationObserved(acquisition, record, request.OwnedTreeLimits)
+	if err != nil {
+		t.Fatal(err)
+	}
+	release()
+	cancelWork()
+	if !errors.Is(work.Err(), context.Canceled) || cleanup.Err() != nil {
+		t.Fatal("test did not retain the separate cleanup window")
+	}
+	after, err := published.Inventory(cleanup)
+	if err != nil {
+		t.Fatalf("original published read could not receive cleanup: %v", err)
+	}
+	if after.SHA256 != before.SHA256 || !sameSerenaTreeObject(after.RootIdentity, before.RootIdentity) {
+		t.Fatal("published read observed another generation after work cancellation")
+	}
+	proof, closeErr := published.CloseObserved()
+	publishedClosed = true
+	if err := errors.Join(closeErr, proof.Validate(published)); err != nil {
+		t.Fatalf("published read did not finish within its original cleanup bound: %v", err)
+	}
+}

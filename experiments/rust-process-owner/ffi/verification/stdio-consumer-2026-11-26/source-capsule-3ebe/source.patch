+		t.Errorf("child console writes did not reach the original screen buffer")
+	}
+	if runErr != nil || result.Job != nil || result.Original != original || captured == nil || captured.library == initialLibrary {
+		t.Errorf("public console receiver changed original custody or failed: %v", runErr)
+	}
+	if admission.hooks != 1 || admission.closes != 1 || borrows != 1 || result.Admission != admission ||
+		!result.AdmissionCloseAttempted || result.AdmissionCloseError != nil ||
+		!result.Outcome.AdmissionPresent || !result.Outcome.AdmissionCloseAttempted || result.Outcome.AdmissionCloseError != nil {
+		t.Errorf("console admission lifecycle: hooks=%d closes=%d borrows=%d close=%v outcome=%+v", admission.hooks, admission.closes, borrows, result.AdmissionCloseError, result.Outcome)
+	}
+	if captured == nil || !result.Root.Known {
+		t.Fatal("console probe lacks an original root result; reports above retain the actual failure")
+	}
+	// Settlement is checked against the ACTUAL root exit, even when console IO
+	// failed. Only the assertions below grant the separate console qualification.
+	rustForegroundNativeAssertSettlement(t, captured, result, result.Root.ExitCode)
+	if initialErr != nil || initial.Schema != "foreground-console-child-v2" || initial.PID != uint32(result.Native.RootIdentity.PID) {
+		t.Errorf("initial child console observation missing or foreign: cause=%v report=%+v", initialErr, initial)
+	}
+	if finalErr != nil || final.Schema != "foreground-console-child-v2" || final.PID != initial.PID || !final.ExitKnown || final.ExitCode != 37 || result.Root.ExitCode != 37 {
+		t.Errorf("actual CUI child console qualification failed: cause=%v report=%+v root=%+v", finalErr, final, result.Root)
+	}
+	foregroundConsoleAssertAssociation(t, initial, true)
+	foregroundConsoleAssertAssociation(t, final, true)
+	okCall := func(call foregroundConsoleCall) bool {
+		return call.Attempted && call.Completed && call.OK && call.Code == 0 && call.Error == ""
+	}
+	for i, name := range [...]string{"stdin", "stdout", "stderr"} {
+		stream := final.Streams[i]
+		if stream.Name != name || !okCall(stream.Handle) || !okCall(stream.Mode) {
+			t.Errorf("child %s has no actual console mode result: %+v", name, stream)
+		}
+	}
+	if !okCall(final.Read) || final.Read.Count != 1 || final.Character != 'Q' {
+		t.Errorf("actual child console read failed: result=%+v character=%#x", final.Read, final.Character)
+	}
+	for i, write := range final.Writes {
+		if !okCall(write) || write.Count != 11 {
+			t.Errorf("actual child console write %d failed: %+v", i, write)
+		}
+	}
+}

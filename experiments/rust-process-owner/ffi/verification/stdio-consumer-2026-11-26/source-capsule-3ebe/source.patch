+				t.Fatalf("recovery release lost its result: err=%v body=%d unlock=%d retained=%t", err, bodyCalls, unlockCalls, retained != nil)
+			}
+			// Settle the actual fixture handle before the retry probe. The
+			// production poison remains: even a broken receiver cannot strand
+			// this test in the OS lock, and must not enter another operation.
+			if err := retained.Unlock(); err != nil {

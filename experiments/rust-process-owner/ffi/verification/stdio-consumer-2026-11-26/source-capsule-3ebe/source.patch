+	if err := o.RevalidateJobMembers(first+1, 3000, 0); err == nil {
+		t.Fatal("stale revalidation fell back to latest")
+	}
+	if got, err := o.CloseJobMembers(first + 1); err == nil || got.CloseFinalized {
+		t.Fatalf("unknown generation finalized the current one: %+v %v", got, err)
+	}
+	again, err := o.JobMemberSnapshot(first)
+	if err != nil || !reflect.DeepEqual(again, baseline) {
+		t.Fatalf("refused operation replaced baseline: %s %v", memberSummary(again), err)
+	}
+	requireMemberClose(t, o, first)
+	second, _, err := o.ObserveJobMembers(3000)

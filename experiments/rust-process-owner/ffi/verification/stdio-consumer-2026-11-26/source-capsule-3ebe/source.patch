+			return
+		}
+		f.owner.mu.Lock()
+		retained := f.owner.raw != 0
+		f.owner.mu.Unlock()
+		if !retained {
+			return
+		}
+		// Failure recovery uses the same original native owner and the bounded
+		// legacy operation, not a renewed facade terminal context. It cannot
+		// turn a failed facade assertion into successful facade evidence.
+		if _, err := f.owner.Stop(rustContainedStopCode); err != nil {
+			t.Errorf("facade fixture original recovery Stop: %v", err)
+		}
+		if out, err := f.owner.Finish(10000); err != nil || out.State != 2 {
+			t.Errorf("facade fixture original recovery Finish: %+v %v", out, err)
+		}
+		if err := f.owner.Release(); err != nil {
+			t.Errorf("facade fixture original recovery Release: %v", err)
+		}
+	})
+	return f

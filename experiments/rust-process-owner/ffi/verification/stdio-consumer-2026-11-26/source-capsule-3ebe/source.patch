+// Scripted callback memory tests transport/custody bookkeeping only. It never
+// claims that these synthetic PIDs are real acquired Windows resources.
+type rustMemberScript struct {
+	owner                                                    *rustNativeOwner
+	pin                                                      runtime.Pinner
+	image                                                    []uint16
+	pids                                                     []uint32
+	rows                                                     []rustOwnerMemberIdentityABI
+	resources                                                []rustOwnerMemberResourceABI
+	snapshot                                                 rustOwnerMemberSnapshotABI
+	close                                                    rustOwnerMemberCloseABI
+	observeMode, snapshotMode, closeMode                     string
+	observeCalls, snapshotCalls, closeCalls, revalidateCalls int
+	requiredPID                                              uint32
+	revalidateReject                                         bool
+	onClose                                                  func()
+}
+
+func newRustMemberScript(t *testing.T) *rustMemberScript {
+	t.Helper()
+	f := &rustMemberScript{image: []uint16{'C', ':', '\\', 'f', 'i', 'x', '.', 'e', 'x', 'e'}, pids: []uint32{42, 43}}
+	f.rows = make([]rustOwnerMemberIdentityABI, 2)
+	for i, pid := range f.pids {
+		f.rows[i] = rustOwnerMemberIdentityABI{Size: 112, Version: 1, PID: pid, SIDLen: 12,
+			CreationTime100ns: uint64(1000 + i), Image: rustOwnerUTF16{Data: &f.image[0], Len: uintptr(len(f.image))}}
+		f.rows[i].SID[0], f.rows[i].SID[1], f.rows[i].SID[7], f.rows[i].SID[8] = 1, 1, 5, 18
+	}
+	f.resources = []rustOwnerMemberResourceABI{{PID: 42, Flags: 1}, {PID: 43}}
+	census := rustOwnerMemberCensusABI{Total: 2, Active: 2, PIDs: &f.pids[0], Count: 2}
+	f.snapshot = rustOwnerMemberSnapshotABI{Size: 120, Version: 1, Generation: 1, Flags: 7,
+		Original: rustOwnerMemberOriginal{PID: 42, CreationTime100ns: 1000}, Pre: census, Post: census,
+		Rows: &f.rows[0], RowCount: 2, Resources: &f.resources[0], ResourceCount: 2}
+	f.close = rustOwnerMemberCloseABI{Size: 40, Version: 1, Generation: 1, Flags: 1,
+		Resources: &f.resources[0], ResourceCount: 2}
+	f.pin.Pin(&f.image[0])
+	f.pin.Pin(&f.pids[0])
+	f.pin.Pin(&f.rows[0])
+	f.pin.Pin(&f.resources[0])
+	f.pin.Pin(&f.snapshot)
+	f.pin.Pin(&f.close)
+	t.Cleanup(f.pin.Unpin)
+	procedures := map[string]uintptr{}
+	procedures["mh_members_observe1"] = syscall.NewCallback(func(raw, version, budget uintptr, fresh *uint64,
+		report *rustOwnerMemberReport, reportBytes uintptr, out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		f.observeCalls++
+		*report = rustOwnerMemberReport{Size: 24, Version: 1}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		if raw != 0x4264 || version != 1 || budget > 60000 || *fresh != 0 || reportBytes != 24 || outBytes != 48 {
+			return 1
+		}
+		switch f.observeMode {
+		case "no-reservation":
+			report.Source, report.Kind = 1, 5
+			return 5
+		case "indeterminate":
+			out.Size = 0
+			return 0
+		case "partial", "empty-partial":
+			*fresh = 1
+			f.snapshot.Flags, f.snapshot.Post = 1, rustOwnerMemberCensusABI{}
+			f.snapshot.Rows, f.snapshot.RowCount = nil, 0
+			if f.observeMode == "empty-partial" {
+				f.snapshot.Pre = rustOwnerMemberCensusABI{}
+				f.snapshot.Resources, f.snapshot.ResourceCount = nil, 0
+				f.close.Resources, f.close.ResourceCount = nil, 0
+			}
+			report.Source, report.Kind = 2, 1 // present native error, code zero
+			return 5
+		}
+		*fresh = 1
+		if f.observeMode == "malformed" {
+			out.Size = 0
+		}
+		return 0
+	})
+	procedures["mh_members_snapshot1"] = syscall.NewCallback(func(raw, version, generation, receiver, token uintptr,
+		report *rustOwnerMemberReport, reportBytes uintptr, out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		f.snapshotCalls++
+		*report = rustOwnerMemberReport{Size: 24, Version: 1}
+		if f.snapshotMode != "missing" {
+			syscall.SyscallN(receiver, uintptr(unsafe.Pointer(&f.snapshot)), 120, token)
+			if f.snapshotMode == "repeat" {
+				syscall.SyscallN(receiver, uintptr(unsafe.Pointer(&f.snapshot)), 120, token)
+			}
+		}
+		growRustOwnerCallbackStack(64)
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		return 0
+	})
+	procedures["mh_members_revalidate1"] = syscall.NewCallback(func(raw, version, generation, budget, pid uintptr,
+		report *rustOwnerMemberReport, reportBytes uintptr, out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		f.revalidateCalls++
+		f.requiredPID = uint32(pid)
+		*report = rustOwnerMemberReport{Size: 24, Version: 1}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		if generation != 1 || f.revalidateReject {
+			report.Source, report.Kind = 1, 2
+			return 5
+		}
+		return 0
+	})
+	procedures["mh_members_close1"] = syscall.NewCallback(func(raw, version, generation uintptr, finalized *uint32,
+		receiver, token uintptr, report *rustOwnerMemberReport, reportBytes uintptr, out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		f.closeCalls++
+		*report = rustOwnerMemberReport{Size: 24, Version: 1}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		if generation != 1 || *finalized != 0 {
+			return 1
+		}
+		if f.closeMode == "no-finality" {
+			report.Source, report.Kind = 1, 6
+			return 5
+		}
+		*finalized = 1
+		f.resources[1].Flags = 2 | 4
+		if f.closeMode == "cleanup-zero" {
+			f.resources[1].Flags, f.close.Flags = 2|8, 0
+		}
+		if f.closeMode == "omit" {
+			f.close.Resources, f.close.ResourceCount = nil, 0
+		}
+		if f.closeMode == "wrong-generation" {
+			f.close.Generation = 2
+		}
+		if f.closeMode == "invalid-finality" {
+			*finalized = 2
+		}
+		if f.closeMode != "missing" {
+			syscall.SyscallN(receiver, uintptr(unsafe.Pointer(&f.close)), 40, token)
+			if f.closeMode == "repeat" {
+				syscall.SyscallN(receiver, uintptr(unsafe.Pointer(&f.close)), 40, token)
+			}
+		}
+		growRustOwnerCallbackStack(64)
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		if f.closeMode == "bad-report" {
+			out.Size = 0
+		}
+		if f.onClose != nil {
+			f.onClose()
+		}
+		return 0
+	})
+	f.owner = &rustNativeOwner{raw: 0x4264, originalPID: 42, memberGate: newOriginalMemberCustody(),
+		library: &rustOwnerLibrary{ready: true, procedures: procedures}}
+	installRustOwnerMemberSource(f.owner)
+	return f
+}
+func (f *rustMemberScript) acquire(t *testing.T) *OriginalJobMemberObservation {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	source, err := f.owner.originalMemberSourceCapability(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	observation, err := observeOriginalJobMembers(ctx, source.originalMemberSourceBinding())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return observation
+}

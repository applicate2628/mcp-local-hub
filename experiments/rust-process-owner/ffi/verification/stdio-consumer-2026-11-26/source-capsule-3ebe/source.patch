+// Done reports that the caller reached a cancellable lock wait. It does not
+// alter the caller's finite deadline or introduce a worker inside production.
+type rustRootWaitBlockedContext struct {
+	context.Context
+	blocked chan struct{}
+}
+
+func (ctx rustRootWaitBlockedContext) Done() <-chan struct{} {
+	select {
+	case ctx.blocked <- struct{}{}:
+	default:
+	}
+	return ctx.Context.Done()
+}
+
+type rustRootWaitCompletion struct {
+	result rustRootWaitResult
+	err    error
+}
+
+func TestRustOwnerRootWaitCancellationWhileLockContended(t *testing.T) {
+	for _, libraryLock := range []bool{false, true} {
+		t.Run(fmt.Sprintf("library-lock=%t", libraryLock), func(t *testing.T) {
+			calls := 0
+			owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				calls++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+				return 0
+			}))
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			blocked := make(chan struct{}, 1)
+			lock := &owner.mu
+			if libraryLock {
+				lock = &owner.library.mu
+			}
+			lock.Lock()
+			held, joined := true, false
+			done := make(chan rustRootWaitCompletion, 1)
+			t.Cleanup(func() {
+				cancel()
+				if held {
+					lock.Unlock()
+				}
+				if !joined {
+					select {
+					case <-done:
+					case <-time.After(2 * time.Second):
+						t.Error("root lock waiter did not join")
+					}
+				}
+			})
+			go func() {
+				result, err := owner.WaitRootWithin(rustRootWaitBlockedContext{ctx, blocked})
+				done <- rustRootWaitCompletion{result, err}
+			}()
+			select {
+			case <-blocked:
+			case <-ctx.Done():
+				t.Fatal("root waiter did not reach held lock")
+			}
+			cancel()
+			select {
+			case got := <-done:
+				joined = true
+				if !errors.Is(got.err, context.Canceled) || got.result.Known || calls != 0 || owner.closeStarted {
+					t.Fatalf("lock cancellation entered native work: got=%+v err=%v calls=%d", got.result, got.err, calls)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("root cancellation waited for unrelated lock release")
+			}
+			lock.Unlock()
+			held = false
+			fresh, cancelFresh := context.WithTimeout(context.Background(), time.Second)
+			defer cancelFresh()
+			if got, err := owner.WaitRootWithin(fresh); err != nil || !got.Known || calls != 1 {
+				t.Fatalf("canceled observer blocked later observation: got=%+v err=%v calls=%d", got, err, calls)
+			}
+		})
+	}
+}

+typedef uint32_t (*mh_members_revalidate_fn)(mh_owner*, uint32_t version,
+    uint64_t generation, uint32_t budget_ms, uint32_t required_pid,
+    mh_members_report*, uint32_t, mh_out*, uint32_t);
+
+/* Close is not deadline-bound. Reserve foreign receipt-array capacity before
+ * native close. finalized becomes 1 immediately after native returns a cached
+ * or new close receipt, BEFORE projection or callback, even for failed handle
+ * close and later copy failure. It means all member close attempts finalized
+ * and the active-observation guard drained; it does NOT mean successful cleanup.
+ * The receipt's COMPLETE flag means no owned close failure. Wrong/stale epoch
+ * cannot affect another observation; failure before native completion leaves
+ * finalized=0. Repeating with a fresh zero scalar reads the SAME cached receipt,
+ * never retries a numeric HANDLE. Root-only/zero-resource close also finalizes.
+ * Even if foreign receipt validation fails, retain finalized and allow explicit
+ * receipt reread; do not invent successful cleanup or replay native attempts. */
+typedef void (*mh_members_close_receive_fn)(
+    const mh_members_close*, uint32_t, uintptr_t);
+typedef uint32_t (*mh_members_close_fn)(mh_owner*, uint32_t version,
+    uint64_t generation, uint32_t *finalized,
+    mh_members_close_receive_fn, uintptr_t,
+    mh_members_report*, uint32_t, mh_out*, uint32_t);
+
+/* Export names: mh_members_observe1, mh_members_snapshot1,
+ * mh_members_revalidate1, mh_members_close1. */
+#if UINTPTR_MAX == UINT64_MAX
+_Static_assert(sizeof(mh_original_creation)==16 &&

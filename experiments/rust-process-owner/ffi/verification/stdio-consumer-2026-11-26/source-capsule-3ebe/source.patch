+					if panics {
+						panic("receiver panic")
+					}
+					return refusal
+				}, func() (*rustOwnerLibrary, error) { return library, nil })
+			if err == nil || p == nil || p != retained || retains != 1 || probe.calls.Load() != 0 || api.freeCalls != 0 {
+				t.Fatalf("retention refusal lost custody: p=%p retained=%p err=%v retains=%d creates=%d frees=%d",
+					p, retained, err, retains, probe.calls.Load(), api.freeCalls)

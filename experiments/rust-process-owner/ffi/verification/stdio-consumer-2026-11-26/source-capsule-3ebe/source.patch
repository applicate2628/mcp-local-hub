+func TestOriginalJobMemberBatchCloseConcurrentCallers(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	defer unblock()
+	var calls atomic.Int32
+	owner, source := originalMemberBatchTestOwner(t, func(context.Context, *OriginalJobMemberObservation) (OriginalJobMemberCloseSnapshotV1, bool, error) {
+		if calls.Add(1) != 1 {
+			t.Error("another caller entered the same native batch close")
+			return originalMemberBatchTestView(), true, errors.New("duplicate native entry")
+		}
+		close(entered)
+		// This barrier models an already-entered synchronous native operation,
+		// not a blocking admission path or a background cleanup worker.
+		<-release
+		return originalMemberBatchTestView(), true, nil
+	})
+	type closeResult struct {
+		proof *OriginalJobMemberCloseObservation
+		err   error
+	}
+	done := make(chan closeResult, 1)
+	joined := false
+	t.Cleanup(func() {
+		unblock()
+		if !joined {
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Error("entered close did not return after release")
+			}
+		}
+	})
+	go func() {
+		proof, err := owner.CloseObserved()
+		done <- closeResult{proof: proof, err: err}
+	}()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("first batch caller did not enter")
+	}
+	pending, err := owner.CloseObserved()
+	if pending == nil || pending.Finalized() || !errors.Is(err, ErrOriginalMemberBorrowPending) || calls.Load() != 1 {
+		t.Fatalf("concurrent observer consumed native close: calls=%d err=%v", calls.Load(), err)
+	}
+	unblock()
+	var first closeResult
+	select {
+	case first = <-done:
+		joined = true
+	case <-time.After(5 * time.Second):
+		t.Fatal("first batch caller did not publish its final receipt")
+	}
+	if first.err != nil || first.proof == nil || !first.proof.Finalized() || first.proof.Validate(source) != nil ||
+		pending.Finalized() || pending.Validate(source) == nil || calls.Load() != 1 {
+		t.Fatalf("concurrent publication changed cleanup authority: %v", first.err)
+	}
+	replay, err := owner.CloseObserved()
+	if replay != first.proof || err != nil || calls.Load() != 1 {
+		t.Fatal("cached close replay repeated the batch operation")
+	}
+}

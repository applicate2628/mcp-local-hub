+	if enter, err := owner.memberGate.enterQuery(nil); err == nil {
+		enter()
+		t.Fatal("original query gate reopened after terminal")
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+}

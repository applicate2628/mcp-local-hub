+func newRustOwnerBorrowTestLayout(t *testing.T) rustOwnerTestLayout {
+	t.Helper()
+	layout := newRustOwnerTestLayout(t)
+	layout.expected.Exports = runtimeidentity.WindowsProcessOwnerBorrowExportsV1()
+	writeRustOwnerTestIdentity(t, layout.identity, layout.expected)
+	return layout
+}
+
+func TestOpenRustOwnerLibraryBorrowProfileResolvesExactAdmittedSurface(t *testing.T) {
+	layout := newRustOwnerBorrowTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	library, err, calls := openFakeRustOwner(t, layout, api)
+	if library != nil {
+		t.Cleanup(func() {
+			if err := library.Close(); err != nil {
+				t.Error(err)
+			}
+		})
+	}
+	if err != nil || library == nil || !library.ready || calls != 2 ||
+		api.loadCalls != 1 || api.versionCalls != 1 ||
+		!reflect.DeepEqual(api.procNames, layout.expected.Exports) {
+		t.Fatalf("borrow loader: error=%v calls=%d resolved=%v", err, calls, api.procNames)
+	}
+	if address, ok := library.procedure("mh_borrow_process1"); !ok || address != api.procAddrs["mh_borrow_process1"] {
+		t.Fatalf("original borrow was not resolved: address=%#x ok=%v", address, ok)
+	}
+}

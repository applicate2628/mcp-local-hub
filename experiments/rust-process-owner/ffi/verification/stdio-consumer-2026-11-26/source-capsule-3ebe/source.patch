+#[test]
+fn occupied_generation_is_not_acquired_and_stale_requests_cannot_touch_a_new_epoch() {
+    let mut owner = suspended_owner();
+    let (status, first, _, _) = observe(&mut owner, 1000);
+    assert_eq!(status, OK);
+    let (status, acquired, report, out) = observe(&mut owner, 1000);
+    assert_eq!(
+        (status, acquired, report.error_source, report.error_kind),
+        (STATE, 0, SOURCE_OBSERVATION, ERROR_BUSY)
+    );
+    assert_eq!((out.state, out.native_error, out.cleanup_mask), (0, 0, 0));
+    let (status, before, _, _) = snapshot(&mut owner, first);
+    assert_eq!(status, OK);
+    assert_eq!(before.calls, 1);
+    assert_eq!(before.bytes as usize, size_of::<MembersSnapshot>());
+    let before = before.value.unwrap();
+    assert_eq!(before.original.pid, owner.inner.root_pid());
+    assert_eq!(
+        before.original.creation_time_100ns,
+        owner.inner.original_creation_time_100ns().unwrap()
+    );
+    assert_eq!(before.flags, PRE_KNOWN | POST_KNOWN | ACQUISITION_COMPLETE);
+    let (status, finalized, receipt, _, out) = close(&mut owner, first);
+    assert_eq!((status, finalized, receipt.calls), (OK, 1, 1));
+    assert_eq!(receipt.bytes as usize, size_of::<MembersClose>());
+    assert_eq!(out.state, 0);
+    assert!(
+        !owner.terminal,
+        "member close cannot release the original owner"
+    );
+    let (status, repeated, replay, _, _) = close(&mut owner, first);
+    assert_eq!((status, repeated, replay.calls), (OK, 1, 1));
+    assert_eq!(receipt.value, replay.value);
+    let (status, after, _, _) = snapshot(&mut owner, first);
+    assert_eq!(status, OK);
+    assert_eq!(after.calls, 1);
+    assert!(
+        before == after.value.unwrap(),
+        "borrowed root close changes no acquisition facts"
+    );
+
+    let (status, second, _, _) = observe(&mut owner, 1000);
+    assert_eq!((status, second), (OK, first + 1));
+    let (status, finalized, receiver, report, _) = close(&mut owner, first);
+    assert_eq!(
+        (status, finalized, receiver.calls, report.error_kind),
+        (STATE, 0, 0, ERROR_INVALID_STATE)
+    );
+    let (status, receiver, report, _) = snapshot(&mut owner, first);
+    assert_eq!(
+        (status, receiver.calls, report.error_kind),
+        (STATE, 0, ERROR_INVALID_STATE)
+    );
+    assert_eq!(
+        owner.inner.job_member_snapshot().unwrap().generation,
+        second
+    );
+    assert_eq!(
+        owner.inner.finish(Duration::ZERO).unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+    let mut report = MembersReport::default();
+    let mut out = Outcome::default();
+    // SAFETY: real current generation; zero budget must not be renewed.
+    assert_eq!(
+        unsafe {
+            mh_members_revalidate1(
+                &mut *owner,
+                VERSION,
+                second,
+                0,
+                0,
+                &mut report,
+                REPORT_BYTES,
+                &mut out,
+                OUT_BYTES,
+            )
+        },
+        STATE
+    );
+    assert_eq!(report.error_kind, ERROR_DEADLINE);
+    let root_pid = owner.inner.root_pid();
+    // SAFETY: the same retained handles remain usable under a later caller deadline.
+    assert_eq!(

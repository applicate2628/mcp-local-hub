+func rustIOABIAssertAbandoned(t *testing.T, library *rustOwnerLibrary, owner, retained *rustNativeOwner) {
+	t.Helper()
+	if owner != retained {
+		t.Fatalf("returned custody differs from retained custody: got=%p retained=%p", owner, retained)
+	}
+	if owner != nil {
+		if owner.raw != 0 || owner.originalPID != 0 || owner.preparing.Load() {
+			t.Fatalf("refused entry retained native facts or preparation: raw=%#x pid=%d preparing=%t",
+				owner.raw, owner.originalPID, owner.preparing.Load())
+		}
+		if err := owner.Release(); err != nil {
+			t.Fatalf("abandoned preparation cannot be released: %v", err)
+		}
+	}
+	if active := library.activeOwners.Load(); active != 0 {
+		t.Fatalf("refused entry retained %d library uses", active)
+	}
+	// This library has no DLL handle. Close proves reservation accounting, not
+	// an actual FreeLibrary call; the real-DLL qualification covers that action.
+	if err := library.Close(); err != nil {
+		t.Fatalf("abandoned preparation retained its library reservation: %v", err)
+	}
+}

+			t.Fatalf("required bootstrap input unavailable: %s", key)
+		}
+	}
+	bootstrap["PATH"] = filepath.Dir(bootstrap["COMSPEC"])
+	raw, err := NewAPI().CatalogManifestGet("serena")
+	if err != nil {
+		t.Fatal(err)
+	}
+	manifest, err := config.ParseManifest(strings.NewReader(raw))

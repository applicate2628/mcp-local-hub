+// This is DATA validation only. The controller creates and owns the private
+// directories and native actors; these fields cannot reconstruct that authority.
+func canonicalNativeExternalSlot(path string, channel canonicalnativefixture.Channel, test string) (canonicalnativefixture.SlotBinding, time.Time, error) {
+	var selected canonicalnativefixture.SlotBinding
+	if channel.Version != canonicalnativefixture.Version || !cleanAbsolutePath(channel.Root) ||
+		path != filepath.Join(channel.Root, "channel", "channel.json") || !validLowerHexSHA256(channel.RunNonce) ||
+		!validLowerHexSHA256(channel.CanonicalPlanSHA256) || !cleanAbsolutePath(channel.SourceDir) ||
+		!cleanAbsolutePath(channel.Binary.Path) || !validLowerHexSHA256(channel.Binary.SHA256) ||
+		!cleanAbsolutePath(channel.Fixture.Path) || !validLowerHexSHA256(channel.Fixture.SHA256) {
+		return selected, time.Time{}, errors.New("external canonical channel has invalid fixed binding")
+	}
+	work, workErr := time.Parse(time.RFC3339Nano, channel.WorkDeadline)
+	cleanup, cleanupErr := time.Parse(time.RFC3339Nano, channel.CleanupDeadline)
+	if workErr != nil || cleanupErr != nil || !cleanup.Equal(work.Add(10*time.Second)) ||
+		work.UTC().Format(time.RFC3339Nano) != channel.WorkDeadline || cleanup.UTC().Format(time.RFC3339Nano) != channel.CleanupDeadline {
+		return selected, time.Time{}, errors.Join(workErr, cleanupErr, errors.New("external channel absolute endpoints differ"))
+	}
+	expected := 2
+	if channel.Profile == "focused" {
+		expected = 1
+	} else if channel.Profile != "full" {
+		return selected, work, errors.New("external channel profile is not full or focused")
+	}
+	if len(channel.Slots) != expected {
+		return selected, work, errors.New("external channel fixed slot inventory differs")
+	}
+	seen := map[string]bool{}
+	nonces := map[string]bool{}
+	for _, slot := range channel.Slots {
+		want, err := canonicalnativefixture.Slot(slot.Test)
+		if err != nil || slot.Slot != want || seen[slot.Test] || !validLowerHexSHA256(slot.Nonce) || nonces[slot.Nonce] {
+			return selected, work, errors.Join(err, errors.New("external channel has an invalid, repeated or foreign slot"))
+		}
+		seen[slot.Test], nonces[slot.Nonce] = true, true
+		if slot.Test == test {
+			selected = slot
+		}
+	}
+	if selected.Test == "" {
+		return selected, work, errors.New("current canonical test is absent from the exact channel inventory")
+	}
+	return selected, work, nil
+}
+
+func validateCanonicalNativeExternalReply(request canonicalnativefixture.Request, reply canonicalnativefixture.Reply, slotRoot string) error {
+	if reply.Version != canonicalnativefixture.Version || reply.RunNonce != request.RunNonce || reply.Slot != request.Slot || reply.Bind != request.Bind ||
+		reply.Kind != "settled" || !reply.PhysicalComplete || reply.CustodyRetained {
+		return errors.New("external canonical reply is not the exact settled original case")
+	}
+	birth, err := strconv.ParseUint(reply.RootBirth, 10, 64)
+	if err != nil || birth == 0 || strconv.FormatUint(birth, 10) != reply.RootBirth || reply.RootPID == 0 || reply.RootExitCode < 0 {
+		return errors.New("external canonical reply has no canonical original root identity")
+	}
+	for i, artifact := range []canonicalnativefixture.Artifact{reply.Stdout, reply.Stderr} {
+		name := "stdout.raw"
+		if i == 1 {
+			name = "stderr.txt"
+		}
+		if artifact.Path != filepath.Join(slotRoot, name) || !artifact.Closed || artifact.Bytes < 0 || artifact.Bytes > 4<<20 ||
+			!validLowerHexSHA256(artifact.SHA256) {
+			return errors.New("external canonical reply capture is not the fixed closed artifact")
+		}
+	}
+	if !reply.Passed {
+		return nil // Known settled failures remain failures, without invented frames.
+	}
+	if reply.RootExitCode != 0 || reply.Error != "" || reply.Ready == nil || reply.Final == nil {
+		return errors.New("external canonical success lacks its original successful root and frames")
+	}
+	ready := *reply.Ready
+	if ready.Bind != request.Bind || ready.Kind != "ready" || ready.PID != reply.RootPID || ready.Birth != reply.RootBirth ||
+		ready.BeforeFlags != 0 || !ready.NoJobChecked || !ready.InitialNoJob || ready.InnerFlags != windows.JOB_OBJECT_LIMIT_BREAKAWAY_OK ||
+		!ready.Assigned || !ready.InnerMember || ready.StrictMember || ready.InnerHandleClosed || ready.Failed || ready.Error != "" {
+		return errors.New("external canonical READY does not confirm the initial no-Job and explicit inner Job")
+	}
+	want := ready
+	want.Kind, want.InnerHandleClosed = "final", true
+	if *reply.Final != want {
+		return errors.New("external canonical final differs from the received original generation or cleanup")
+	}
+	return nil
+}
+
+func readCanonicalNativeExternalArtifact(ctx context.Context, artifact canonicalnativefixture.Artifact, custody *canonicalNativeCaseCustody) ([]byte, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := canonicalnativefixture.CheckedPath(artifact.Path, false); err != nil {
+		return nil, err
+	}
+	before, err := os.Lstat(artifact.Path)
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.Open(artifact.Path)
+	if err != nil {
+		return nil, err
+	}
+	custody.Files = append(custody.Files, file)
+	after, statErr := file.Stat()
+	var body []byte
+	var readErr error
+	if statErr != nil || !after.Mode().IsRegular() || !os.SameFile(before, after) {
+		readErr = errors.Join(statErr, errors.New("external canonical capture identity differs"))
+	} else {
+		body, readErr = io.ReadAll(io.LimitReader(file, (4<<20)+1))
+	}
+	closeErr := file.Close()
+	if err := errors.Join(readErr, closeErr); err != nil {
+		return nil, err
+	}
+	if int64(len(body)) != artifact.Bytes || len(body) > 4<<20 || fmt.Sprintf("%x", sha256.Sum256(body)) != artifact.SHA256 {
+		return nil, errors.New("external canonical closed capture bytes differ")
+	}
+	return body, ctx.Err()
+}
+
+func canonicalNativeCurrentBirth() (string, error) {
+	var created, exited, kernel, user windows.Filetime
+	if err := windows.GetProcessTimes(windows.CurrentProcess(), &created, &exited, &kernel, &user); err != nil {
+		return "", err
+	}
+	birth := uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+	if birth == 0 {
+		return "", errors.New("native case creation time is unavailable")
+	}
+	return strconv.FormatUint(birth, 10), nil
+}
+
+// Do not use panic, Goexit or t.Fatal here: those execute test cleanups and may
+// enter a later subtest while the original owner or file remains unreceived.
+func stopCanonicalNativeCase(custody *canonicalNativeCaseCustody, cause error) error {
+	retained := retainCanonicalNativeCase(custody, cause)
+	message := ""
+	if retained.Cause != nil {
+		message = retained.Cause.Error()
+	}
+	if len(message) > 2048 {
+		message = message[:2048]
+	}
+	_, _ = fmt.Fprintf(os.Stderr, "canonical native case retained unknown custody: %s\n", message)
+	os.Exit(86)
+	return cause
+}
+
+func canonicalNativeCaseArgs(cfg canonicalNativeCaseConfig) []string {
+	return []string{"-test.paniconexit0", "-test.v", "-test.count=1", "-test.timeout=" + cfg.Timeout, "-test.run=^" + cfg.Test + "$"}
+}
+
+func runCanonicalNativeCase(t *testing.T, root, path string, cfg canonicalNativeCaseConfig, workDeadline, cleanupDeadline time.Time) (retErr error) {
+	record := canonicalNativeCaseReceipt{Bind: cfg, Args: canonicalNativeCaseArgs(cfg), Started: time.Now().UTC().Format(time.RFC3339Nano)}
+	var job *process.Job
+	var owner *process.AtCreateJobProcess
+	var files []*os.File
+	var natural, startEntered bool
+	defer func() {
+		if canonicalnativefixture.HasRetainedFile(retErr) {
+			retErr = stopCanonicalNativeCase(&canonicalNativeCaseCustody{Owner: owner, Job: job, Files: files}, retErr)
+			return
+		}
+		ctx, cancel := context.WithDeadline(context.Background(), cleanupDeadline)
+		defer cancel()
+		settled := true
+		if owner != nil {
+			if identity, identityErr := owner.Identity(); identity.Known {
+				record.Root = identity
+			} else if owner.Created() {
+				retErr = errors.Join(retErr, identityErr, errors.New("original case identity unavailable"))
+			}
+			view, observeErr := owner.ObserveOriginal(ctx, natural)
+			record.Native = view
+			retErr = errors.Join(retErr, observeErr)
+			if !view.NoChildKnown && !record.Wait.Known {
+				record.Wait = owner.WaitOriginalContext(ctx)
+			}
+			if !view.NoChildKnown && (!record.Wait.Known || record.Wait.Error != nil) {
+				settled = false
+				retErr = errors.Join(retErr, record.Wait.Error, errors.New("original case wait remains unconfirmed"))
+			} else {
+				closed, closeErr := owner.ReleaseOriginal()
+				retErr = errors.Join(retErr, closeErr)
+				if closed != nil {
+					record.Native = closed.Snapshot()
+				}
+				settled = closed != nil && closed.Complete()
+			}
+		} else if startEntered {
+			settled = false
+			retErr = errors.Join(retErr, errors.New("case create entered without a returned original owner"))
+		} else if job != nil {
+			closeErr := job.Close()
+			retErr = errors.Join(retErr, closeErr)
+			settled = closeErr == nil
+		}
+		if !settled {
+			record.CustodyRetained = true
+			retErr = errors.Join(retErr, errors.New("case native settlement incomplete; original owner, Job and files retained"))
+			retainCanonicalNativeCase(&canonicalNativeCaseCustody{Owner: owner, Job: job, Files: files}, retErr)
+		} else {
+			// These are regular capture files. No pipe EOF or reader-join claim
+			// is made; no file seek/read/close precedes full strict Job settlement.
+			var stdout []byte
+			var captureErrors, closeErrors []error
+			for i, file := range files {
+				if i > 0 {
+					syncErr := file.Sync()
+					_, seekErr := file.Seek(0, io.SeekStart)
+					body, readErr := io.ReadAll(io.LimitReader(file, (4<<20)+1))
+					if len(body) > 4<<20 {
+						readErr = errors.Join(readErr, errors.New("case capture exceeds read limit"))
+					}
+					captureErrors = append(captureErrors, syncErr, seekErr, readErr)
+					if syncErr == nil && seekErr == nil && readErr == nil {
+						hash := fmt.Sprintf("%x", sha256.Sum256(body))
+						if i == 1 {
+							record.StdoutBytes, record.StdoutSHA256, stdout = len(body), hash, body
+						} else {
+							record.StderrBytes, record.StderrSHA256 = len(body), hash
+						}
+					}
+				}
+				closeErr := file.Close()
+				closeErrors = append(closeErrors, closeErr)
+				if closeErr != nil {
+					break // Do not read another capture after an unreceived Close.
+				}
+			}
+			closeErr := errors.Join(closeErrors...)
+			record.SourcesClosed = closeErr == nil
+			retErr = errors.Join(retErr, errors.Join(captureErrors...), closeErr)
+			if closeErr != nil {
+				record.CustodyRetained = true
+				retainCanonicalNativeCase(&canonicalNativeCaseCustody{Owner: owner, Job: job, Files: files}, retErr)
+			}
+			if retErr == nil {
+				retErr = validateCanonicalNativeCaseOutput(cfg.Test, stdout)
+			}
+			if closeErr == nil {
+				for _, input := range [][2]string{{cfg.Image, cfg.ImageSHA256}, {cfg.Fixture, cfg.FixtureSHA256}} {
+					if current, err := hashFile(input[0]); err != nil || fmt.Sprintf("%x", current) != input[1] {
+						retErr = errors.Join(retErr, err, fmt.Errorf("original case input changed: %s", input[0]))
+					}
+				}
+			}
+		}
+		record.Finished = time.Now().UTC().Format(time.RFC3339Nano)
+		if retErr != nil {
+			record.Error = retErr.Error()
+		}
+		retErr = errors.Join(retErr, publishCanonicalNativeCase(filepath.Join(root, "parent-final.json"), record))
+	}()
+	ctx, cancel := context.WithDeadline(t.Context(), workDeadline)
+	defer cancel()
+	var err error
+	job, err = process.NewJobObserved(process.JobOptions{KillOnClose: true})
+	if err != nil {
+		return err
+	}
+	record.StrictFlagsBefore, err = canonicalNativeCaseFlags(job.Handle())
+	if err != nil || record.StrictFlagsBefore != windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE {
+		return errors.Join(err, errors.New("case Job is not exact strict KillOnClose"))
+	}
+	input, err := os.Open(os.DevNull)
+	if err != nil {
+		return err
+	}
+	files = append(files, input)
+	for _, name := range []string{"stdout.raw", "stderr.txt"} {
+		file, err := os.OpenFile(filepath.Join(root, name), os.O_RDWR|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			return err
+		}
+		files = append(files, file)
+	}
+	cmd := exec.Command(cfg.Image, record.Args...)
+	cmd.Env = append(os.Environ(), canonicalNativeCaseEnv+"="+path)
+	process.NoConsole(cmd)
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	startEntered = true
+	owner, err = process.StartWithJobFilesOriginal(job, cmd, files[0], files[1], files[2])
+	if err != nil {
+		return err
+	}
+	if owner == nil {
+		return errors.New("case starter returned no original owner")
+	}
+	var ready canonicalNativeCaseFrame
+	if err := awaitCanonicalNativeCase(ctx, filepath.Join(root, "ready.json"), &ready, owner); err != nil {
+		return err
+	}
+	record.Ready = &ready
+	if ready.Kind != "ready" || ready.Bind != cfg || ready.BeforeFlags != windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE ||
+		ready.InnerFlags != windows.JOB_OBJECT_LIMIT_BREAKAWAY_OK || !ready.Assigned || !ready.InnerMember || ready.StrictMember || ready.InnerHandleClosed || ready.Failed ||
+		ready.NoJobChecked || ready.InitialNoJob || ready.Error != "" {
+		return errors.New("case actor did not receive the exact nested native Job conditions")
+	}
+	birth, err := strconv.ParseUint(ready.Birth, 10, 64)
+	if err != nil || birth == 0 || strconv.FormatUint(birth, 10) != ready.Birth {
+		return errors.New("case READY birth is not canonical")
+	}
+	start, err := owner.ObserveOriginalStart(ctx)
+	if err != nil {
+		return err
+	}
+	if err := start.Validate(ctx, ready.PID, birth); err != nil {
+		return err
+	}
+	record.Root = start.Identity()
+	err = owner.BorrowOriginalProcessHandle(func(handle uintptr) error {
+		var err error
+		record.StrictMember, err = canonicalNativeCaseMember(windows.Handle(handle), job.Handle())
+		return err
+	})
+	if err != nil || !record.StrictMember {
+		return errors.Join(err, errors.New("original actor lost strict case Job membership"))
+	}
+	record.StrictFlagsAfter, err = canonicalNativeCaseFlags(job.Handle())
+	if err != nil || record.StrictFlagsAfter != record.StrictFlagsBefore {
+		return errors.Join(err, errors.New("original strict case Job limits changed"))
+	}
+	grant := ready
+	grant.Kind, grant.StrictMember = "grant", true
+	if err := publishCanonicalNativeCase(filepath.Join(root, "grant.json"), grant); err != nil {
+		return err
+	}
+	record.Wait = owner.WaitOriginalContext(ctx)
+	if !record.Wait.Known || record.Wait.Error != nil || record.Wait.ExitCode != 0 {
+		return errors.Join(record.Wait.Error, fmt.Errorf("original case exit: known=%v code=%d", record.Wait.Known, record.Wait.ExitCode))
+	}
+	var final canonicalNativeCaseFrame
+	if err := awaitCanonicalNativeCase(ctx, filepath.Join(root, "actor-final.json"), &final, owner); err != nil {
+		return err
+	}
+	record.Final = &final
+	want := grant
+	want.Kind, want.InnerHandleClosed = "final", true
+	if final != want {
+		return errors.New("case actor final does not confirm original cleanup and successful test body")
+	}
+	natural = true
+	return nil
+}
+
+func receiveCanonicalNativeCase(t *testing.T, path string) {
+	t.Helper()
+	if !cleanAbsolutePath(path) || filepath.Base(path) != "config.json" {
+		t.Fatal("canonical native case config path is invalid")
+	}
+	var cfg canonicalNativeCaseConfig
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	err := awaitCanonicalNativeCase(ctx, path, &cfg, nil)
+	cancel()
+	if err != nil {
+		if canonicalnativefixture.HasRetainedFile(err) {
+			stopCanonicalNativeCase(nil, err)
+		}
+		t.Fatal(err)
+	}
+	work, workErr := time.Parse(time.RFC3339Nano, cfg.WorkDeadline)
+	cleanup, cleanupErr := time.Parse(time.RFC3339Nano, cfg.CleanupDeadline)
+	timeout, timeoutErr := time.ParseDuration(cfg.Timeout)
+	image, imageErr := os.Executable()
+	imageHash, hashErr := hashFile(image)
+	fixtureHash, fixtureErr := hashFile(cfg.Fixture)
+	if (cfg.Version != 1 && cfg.Version != canonicalnativefixture.Version) || cfg.Test != t.Name() || !validLowerHexSHA256(cfg.Nonce) || !cleanAbsolutePath(cfg.Image) || !samePath(image, cfg.Image) ||
+		!validLowerHexSHA256(cfg.ImageSHA256) || fmt.Sprintf("%x", imageHash) != cfg.ImageSHA256 || !cleanAbsolutePath(cfg.Fixture) || cfg.Fixture != os.Getenv("MCPHUB_CANONICAL_NATIVE_ACTOR_FIXTURE") ||
+		!validLowerHexSHA256(cfg.FixtureSHA256) || fmt.Sprintf("%x", fixtureHash) != cfg.FixtureSHA256 || !reflect.DeepEqual(os.Args[1:], canonicalNativeCaseArgs(cfg)) ||
+		errors.Join(workErr, cleanupErr, timeoutErr, imageErr, hashErr, fixtureErr) != nil || timeout <= 0 || timeout > 4*time.Minute || !time.Now().Before(work) ||
+		!cleanup.Equal(work.Add(10*time.Second)) {
+		t.Fatal("canonical native actor config/argv/image/deadline differs from its original operands")
+	}
+	channelPath, channelPresent := os.LookupEnv(canonicalnativefixture.ChannelEnv)
+	if cfg.Version == canonicalnativefixture.Version {
+		channel, slot, outerWork, err := loadCanonicalNativeExternalChannel(channelPath, t.Name())
+		if canonicalnativefixture.HasRetainedFile(err) {
+			stopCanonicalNativeCase(nil, err)
+		}
+		if err != nil || !channelPresent || path != filepath.Join(channel.Root, "channel", slot.Slot, "config.json") ||
+			cfg.Nonce != slot.Nonce || cfg.Image != channel.Binary.Path || cfg.ImageSHA256 != channel.Binary.SHA256 ||
+			cfg.Fixture != channel.Fixture.Path || cfg.FixtureSHA256 != channel.Fixture.SHA256 || cleanup.After(outerWork) {
+			t.Fatal(errors.Join(err, errors.New("external actor config differs from its original channel slot")))
+		}
+	} else if channelPresent {
+		t.Fatal("V1 canonical actor cannot receive an external V2 channel")
+	}
+	// Neither private marker reaches the unchanged body or production Product.
+	if err := errors.Join(os.Unsetenv(canonicalNativeCaseEnv), os.Unsetenv(canonicalnativefixture.ChannelEnv)); err != nil {
+		t.Fatal(err)
+	}
+	frame := canonicalNativeCaseFrame{Bind: cfg, Kind: "ready", PID: uint32(os.Getpid())}
+	if cfg.Version == canonicalnativefixture.Version {
+		inJob, err := canonicalNativeCaseMember(windows.CurrentProcess(), 0)
+		if err != nil || inJob {
+			t.Fatalf("external actor is not initially outside every Job: inJob=%v err=%v", inJob, err)
+		}
+		frame.NoJobChecked, frame.InitialNoJob = true, true
+	} else {
+		before, err := canonicalNativeCaseFlags(0)
+		if err != nil || before != windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE {
+			t.Fatalf("actor did not inherit strict case Job: flags=%#x err=%v", before, err)
+		}
+		frame.BeforeFlags = before
+	}
+	frame.Birth, err = canonicalNativeCurrentBirth()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inner, err := process.NewJobObserved(process.JobOptions{BreakawayOK: true})
+	t.Cleanup(func() {
+		// Registered before all body cleanups: original supervisor/file owners
+		// settle first. No KillOnClose on this self-containing inner Job.
+		var closeErr error
+		if inner != nil {
+			closeErr = inner.Close()
+		}
+		frame.Kind, frame.InnerHandleClosed = "final", inner != nil && closeErr == nil
+		if closeErr != nil {
+			t.Errorf("inner Job close: %v", closeErr)
+			frame.Error = closeErr.Error()
+		}
+		frame.Failed = t.Failed()
+		if err := publishCanonicalNativeCase(filepath.Join(filepath.Dir(path), "actor-final.json"), frame); err != nil {
+			if canonicalnativefixture.HasRetainedFile(err) {
+				stopCanonicalNativeCase(&canonicalNativeCaseCustody{Job: inner}, err)
+			}
+			t.Error(err)
+		}
+	})
+	if err != nil || inner == nil {
+		t.Fatalf("create explicit inner Job: %v", err)
+	}
+	frame.InnerFlags, err = canonicalNativeCaseFlags(inner.Handle())
+	if err != nil || frame.InnerFlags != windows.JOB_OBJECT_LIMIT_BREAKAWAY_OK {
+		t.Fatalf("inner Job flags: %#x: %v", frame.InnerFlags, err)
+	}
+	if err := windows.AssignProcessToJobObject(inner.Handle(), windows.CurrentProcess()); err != nil {
+		t.Fatal(err)
+	}
+	frame.Assigned = true
+	frame.InnerMember, err = canonicalNativeCaseMember(windows.CurrentProcess(), inner.Handle())
+	currentFlags, queryErr := canonicalNativeCaseFlags(0)
+	if err != nil || queryErr != nil || !frame.InnerMember || currentFlags != frame.InnerFlags {
+		t.Fatal(errors.Join(err, queryErr, errors.New("inner self-assignment not confirmed")))
+	}
+	if err := publishCanonicalNativeCase(filepath.Join(filepath.Dir(path), "ready.json"), frame); err != nil {
+		if canonicalnativefixture.HasRetainedFile(err) {
+			stopCanonicalNativeCase(&canonicalNativeCaseCustody{Job: inner}, err)
+		}
+		t.Fatal(err)
+	}
+	ctx, cancel = context.WithDeadline(t.Context(), work)
+	defer cancel()
+	var grant canonicalNativeCaseFrame
+	if err := awaitCanonicalNativeCase(ctx, filepath.Join(filepath.Dir(path), "grant.json"), &grant, nil); err != nil {
+		if canonicalnativefixture.HasRetainedFile(err) {
+			stopCanonicalNativeCase(&canonicalNativeCaseCustody{Job: inner}, err)
+		}
+		t.Fatal(err)
+	}
+	want := frame
+	want.Kind, want.StrictMember = "grant", cfg.Version == 1
+	if grant != want {
+		t.Fatal("canonical native case GO differs from the received original generation")
+	}
+	frame.StrictMember = want.StrictMember
+}
+
+func validateCanonicalNativeCaseOutput(name string, output []byte) error {
+	names, err := canonicalnativefixture.TerminalNames(name)
+	if err != nil {
+		return err
+	}
+	wanted := make(map[string]int, len(names))
+	for _, test := range names {
+		wanted[test] = 0
+	}
+	for _, line := range strings.Split(string(output), "\n") {
+		line = strings.TrimSpace(strings.TrimPrefix(line, "\x16"))
+		if strings.HasPrefix(line, "--- FAIL: ") || strings.HasPrefix(line, "--- SKIP: ") {
+			return errors.New("selected native case failed or skipped")
+		}
+		if !strings.HasPrefix(line, "--- PASS: ") {
+			continue
+		}
+		fields := strings.Fields(strings.TrimPrefix(line, "--- PASS: "))
+		if len(fields) == 0 {
+			return errors.New("empty native case terminal")
+		}
+		if _, exists := wanted[fields[0]]; !exists {
+			return fmt.Errorf("unselected native case terminal: %s", fields[0])
+		}
+		wanted[fields[0]]++
+	}
+	for test, count := range wanted {
+		if count != 1 {
+			return fmt.Errorf("native case terminal %s: count=%d, want exactly one", test, count)
+		}
+	}
+	return nil
+}
+
+func canonicalNativeCaseFlags(job windows.Handle) (uint32, error) {
+	var info windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION
+	var returned uint32
+	r, _, err := canonicalCaseQueryJob.Call(uintptr(job), uintptr(windows.JobObjectExtendedLimitInformation),
+		uintptr(unsafe.Pointer(&info)), uintptr(uint32(unsafe.Sizeof(info))), uintptr(unsafe.Pointer(&returned)))
+	if r == 0 {
+		if err == nil || err == syscall.Errno(0) {
+			err = syscall.EINVAL
+		}
+		return 0, err
+	}
+	if returned != uint32(unsafe.Sizeof(info)) {
+		return 0, errors.New("Job information native length differs")
+	}
+	return uint32(info.BasicLimitInformation.LimitFlags), nil
+}
+
+func canonicalNativeCaseMember(handle, job windows.Handle) (bool, error) {
+	var member uint32
+	r, _, err := canonicalCaseIsMember.Call(uintptr(handle), uintptr(job), uintptr(unsafe.Pointer(&member)))
+	if r == 0 {
+		if err == nil || err == syscall.Errno(0) {
+			err = syscall.EINVAL
+		}
+		return false, err
+	}
+	return member != 0, nil
+}
+
+func publishCanonicalNativeCase(path string, value any) error {
+	return canonicalnativefixture.Publish(path, value)
+}
+
+func awaitCanonicalNativeCase(ctx context.Context, path string, value any, owner *process.AtCreateJobProcess) error {
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		err := canonicalnativefixture.Read(path, value)
+		if err == nil {
+			return ctx.Err()
+		}
+		if canonicalnativefixture.HasRetainedFile(err) || !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		if owner != nil {
+			live, err := owner.OriginalLive(ctx)
+			if err != nil || !live {
+				return errors.Join(err, fmt.Errorf("original actor exited before publishing %s", filepath.Base(path)))
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+}

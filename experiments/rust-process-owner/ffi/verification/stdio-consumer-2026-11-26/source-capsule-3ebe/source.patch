+func TestHTTPHostEndpointReleaseStopRefreshesOriginalTerminal(t *testing.T) {
+	for _, outcome := range []string{"success", "final-error", "still-pending"} {
+		t.Run(outcome, func(t *testing.T) {
+			f, start := newEndpointReleaseFixture(t)
+			earlyError := errors.New("synthetic early endpoint report")
+			lateError := errors.New("synthetic late endpoint report")
+			if outcome == "final-error" {
+				f.reportedError = lateError
+			}
+			var early *HTTPHostEndpointReleaseObservation
+			lateAfterRootExit := false
+			f.closeScript = func(ctx context.Context, call int32) (*process.OriginalJobMemberCloseObservation, error) {
+				if call == 1 {
+					return &process.OriginalJobMemberCloseObservation{}, errors.Join(earlyError,
+						&process.OriginalMemberBorrowPendingError{Stage: "scripted-before-terminal-drain"})
+				}
+				f.host.mu.Lock()
+				early = f.host.prepared.endpointRelease
+				f.host.mu.Unlock()
+				select {
+				case <-f.host.childExited:
+					lateAfterRootExit = true
+				default:
+				}
+				if outcome == "still-pending" {
+					return &process.OriginalJobMemberCloseObservation{}, errors.Join(lateError,
+						&process.OriginalMemberBorrowPendingError{Stage: "scripted-after-terminal-drain"})
+				}
+				return f.closeMembers(ctx)
+			}
+			// Longer than the internal stop bound: comparing the two endpoint
+			// deadlines would otherwise miss a newly created cleanup budget.
+			ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+			defer cancel()
+			terminal, err := f.host.StopObserved(ctx)
+			f.callMu.Lock()
+			delivered := f.terminalReceipt
+			f.callMu.Unlock()
+			if delivered.EndpointRelease != terminal.EndpointRelease ||
+				delivered.NativeSettlement != terminal.NativeSettlement ||
+				delivered.OriginalIOObservation() != terminal.OriginalIOObservation() {
+				t.Fatal("ticket.Terminal did not receive the refreshed original terminal facts")
+			}
+			if !terminal.NativeSettlement.Complete() || !terminal.RootWait.Known ||
+				!terminal.IOSettlement.Complete() || terminal.OriginalIOObservation() == nil || !lateAfterRootExit {
+				t.Fatalf("late endpoint delivery did not follow original settlement: native=%t root=%t io=%t late=%t error=%v",
+					terminal.NativeSettlement.Complete(), terminal.RootWait.Known, terminal.IOSettlement.Complete(), lateAfterRootExit, err)
+			}
+			if early == nil || early == terminal.EndpointRelease || early.Snapshot().Complete ||
+				early.Validate(ctx, f.host, &start) == nil {
+				t.Fatal("early pending receiver acquired authority or was reused as final")
+			}
+			switch outcome {
+			case "success":
+				if err != nil || !terminal.Complete() || terminal.EndpointRelease.Validate(ctx, f.host, &start) != nil {
+					t.Fatalf("late genuine close did not complete the terminal receipt: complete=%t error=%v", terminal.Complete(), err)
+				}
+			case "final-error":
+				if terminal.Complete() || !errors.Is(err, lateError) || errors.Is(err, earlyError) ||
+					errors.Is(err, process.ErrOriginalMemberBorrowPending) || terminal.EndpointRelease == nil ||
+					!terminal.EndpointRelease.proof.Finalized() {
+					t.Fatalf("late final reported failure did not replace only the early transient error: complete=%t error=%v", terminal.Complete(), err)
+				}
+			case "still-pending":
+				if terminal.Complete() || !errors.Is(err, earlyError) || !errors.Is(err, lateError) ||
+					!errors.Is(err, process.ErrOriginalMemberBorrowPending) {
+					t.Fatalf("late nonfinal result lost an endpoint attempt: complete=%t error=%v", terminal.Complete(), err)
+				}
+			}
+			f.callMu.Lock()
+			deadlines := append([]time.Time(nil), f.deadlines...)
+			f.callMu.Unlock()
+			callerDeadline, _ := ctx.Deadline()
+			if len(deadlines) != 2 || deadlines[0].IsZero() || !deadlines[0].Equal(deadlines[1]) ||
+				!deadlines[0].Before(callerDeadline) {
+				t.Fatalf("endpoint retry did not retain the original stop bound: calls=%d", len(deadlines))
+			}
+			native := terminal.NativeSettlement.Snapshot()
+			ioObservation := terminal.OriginalIOObservation()
+			replayed, replayErr := f.host.StopObserved(ctx)
+			if replayed.NativeSettlement != terminal.NativeSettlement ||
+				!reflect.DeepEqual(replayed.NativeSettlement.Snapshot(), native) ||
+				replayed.OriginalIOObservation() != ioObservation || !reflect.DeepEqual(replayed.RootWait, terminal.RootWait) ||
+				!reflect.DeepEqual(replayed.IOSettlement, terminal.IOSettlement) ||
+				replayed.EndpointRelease != terminal.EndpointRelease || replayed.Complete() != terminal.Complete() ||
+				!reflect.DeepEqual(replayErr, err) || f.terminalCalls.Load() != 1 || f.closeCalls.Load() != 2 {
+				t.Fatalf("repeated stop changed original terminal facts: terminal-calls=%d endpoint-calls=%d error=%v",
+					f.terminalCalls.Load(), f.closeCalls.Load(), replayErr)
+			}
+		})
+	}
+}

+func TestStdioRustOriginalCanceledStopReceiverKeepsOneDeadline(t *testing.T) {
+	h, root := newStdioRustOriginalHost(t, "echo")
+	observer, cancelObserver := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancelObserver()
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	releaseObservation := func() { releaseOnce.Do(func() { close(release) }) }
+	t.Cleanup(releaseObservation)
+	var calls atomic.Int32
+	var observationArmed atomic.Bool
+	var cleanupDeadline time.Time
+	var cleanupErrorAfterObserverCancel error
+	h.originalLaunch = &stdioOriginalLaunchOps{
+		observeOriginal: func(owner *process.AtCreateJobProcess, ctx context.Context, natural bool) (process.ContainedNativeSnapshot, error) {
+			// Failed Start receives its real cleanup before returning to the test.
+			if !observationArmed.Load() {
+				return owner.ObserveOriginal(ctx, natural)
+			}
+			if calls.Add(1) == 1 {
+				cleanupDeadline, _ = ctx.Deadline()
+				cancelObserver()
+				cleanupErrorAfterObserverCancel = ctx.Err()
+				close(entered)
+			}
+			select {
+			case <-release:
+			case <-ctx.Done():
+				return process.ContainedNativeSnapshot{}, ctx.Err()
+			}
+			return owner.ObserveOriginal(ctx, natural)
+		},
+	}
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	observationArmed.Store(true)
+	originalTestBarrier(t, filepath.Join(root, "root-ready"))
+	owner := stdioRustOriginalOwner(t, h)
+	first, err := h.StopObserved(observer)
+	if err == nil || !errors.Is(err, context.Canceled) || !first.Pending || first.Deadline.IsZero() {
+		t.Fatalf("canceled stop receiver lost its retained attempt: %+v err=%v", first, err)
+	}
+	stdioRustOriginalWait(t, "stop observation cancellation boundary", entered)
+	if cleanupErrorAfterObserverCancel != nil || !cleanupDeadline.Equal(first.Deadline) {
+		t.Fatalf("receiver cancellation changed owner cleanup: deadline=%v first=%v err=%v",
+			cleanupDeadline, first.Deadline, cleanupErrorAfterObserverCancel)
+	}
+	releaseObservation()
+	complete := stdioRustOriginalComplete(t, h, owner)
+	again := stdioRustOriginalComplete(t, h, owner)
+	if !complete.Deadline.Equal(first.Deadline) || !again.Deadline.Equal(first.Deadline) ||
+		again.NativeSettlement != complete.NativeSettlement || again.RootWait != complete.RootWait ||
+		again.OriginalIdentity != complete.OriginalIdentity || calls.Load() != 1 {
+		t.Fatalf("repeated receiving renewed or replaced original settlement: first=%+v complete=%+v again=%+v calls=%d",
+			first, complete, again, calls.Load())
+	}
+}

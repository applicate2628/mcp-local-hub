+func TestProductRustOwnerFactoryPostCreateErrorKeepsModule(t *testing.T) {
+	library, api, _ := rustProductFakeLibrary(t)
+	creates := 0
+	library.procedures["mh_create_io1"] = syscall.NewCallback(func(
+		request *rustOwnerCreate, requestBytes uintptr, io *rustOwnerIOContext, ioBytes uintptr,
+		slot *uintptr, out *rustOwnerOutcome, outBytes uintptr,
+	) uintptr {
+		creates++
+		*slot = 0x4141 // Synthetic ownership slot; no process or OS handle is created.
+		*out = rustOwnerOutcome{Size: 47, Version: 1}
+		return 0
+	})
+	streams := rustStdioTestFiles(t)

+func TestRustOwnerSplitCloseRetryDoesNotRepeatWait(t *testing.T) {
+	terminal := rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+	for _, tc := range []struct {
+		name    string
+		status  uintptr
+		first   rustOwnerOutcome
+		invalid bool
+	}{
+		{"malformed-layout", 0, rustOwnerOutcome{Size: 47, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}, true},
+		{"not-settled", 6, rustOwnerOutcome{Size: 48, Version: 1, Flags: 1, PID: 42, RootExit: 7}, false},
+		{"native-failure", 3, rustOwnerOutcome{Size: 48, Version: 1, Flags: 1, PID: 42, RootExit: 7, NativeError: 5}, false},
+		{"success-without-settlement", 0, rustOwnerOutcome{Size: 48, Version: 1, PID: 42}, true},
+		{"success-still-pending", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 42}, true},
+		{"failure-claims-complete", 5, terminal, true},
+		{"failure-observes-active", 5, rustOwnerOutcome{Size: 48, Version: 1, Flags: 3, PID: 42, RootExit: 7}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			waits, closes := 0, 0
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				waits++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+				return 0
+			})
+			closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				closes++
+				if closes == 1 {
+					*out = tc.first
+					return tc.status
+				}
+				*out = terminal
+				return 0
+			})
+			owner := &rustNativeOwner{raw: 0x4242, memberGate: newOriginalMemberCustody(),
+				library: &rustOwnerLibrary{ready: true,
+					procedures: map[string]uintptr{"mh_wait1": wait, "mh_close1": closeExited}}}
+			owner.library.activeOwners.Store(1)
+			first, err := owner.Finish(0)
+			if err == nil || errors.Is(err, errRustOwnerOutcome) != tc.invalid || first.State != 0 ||
+				first.RootExit != 7 || !owner.closeStarted || owner.raw != 0x4242 || owner.library.activeOwners.Load() != 1 {
+				t.Fatalf("uncertain close lost custody or became completion: result=%+v err=%v", first, err)
+			}
+			repeated, err := owner.Finish(60000)
+			if err != nil || repeated != terminal || waits != 1 || closes != 2 || owner.raw != 0x4242 {
+				t.Fatalf("close retry restarted wait or lost cached result: result=%+v err=%v waits=%d closes=%d",
+					repeated, err, waits, closes)
+			}
+		})
+	}
+}

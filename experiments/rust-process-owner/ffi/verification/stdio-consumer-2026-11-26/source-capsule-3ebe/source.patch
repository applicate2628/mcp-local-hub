+//go:build windows && amd64
+
+package process
+
+import (
+	"errors"
+	"syscall"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// A fake module handle records unload ordering; no test here calls FreeLibrary
+// or creates a process. Native owner results come from the existing ABI fixture.
+type rustProductModuleAPI struct {
+	*fakeRustOwnerLibraryAPI
+	beforeFree func()
+}
+
+func (api *rustProductModuleAPI) free(handle windows.Handle) error {
+	if api.beforeFree != nil {
+		api.beforeFree()
+	}
+	return api.fakeRustOwnerLibraryAPI.free(handle)
+}
+
+func TestRustOwnerProductOwnedModuleClosesAfterNativeRelease(t *testing.T) {
+	for _, result := range []string{"success", "cleanup-error", "malformed-release"} {
+		t.Run(result, func(t *testing.T) {
+			f, child, p := newRustFacadeABIFixture(t)
+			library := f.owner.library
+			api := &rustProductModuleAPI{fakeRustOwnerLibraryAPI: &fakeRustOwnerLibraryAPI{}}
+			library.api, library.handle = api, windows.Handle(0x44)
+			child.ownsLibrary = true
+			api.beforeFree = func() {
+				if f.owner.raw != 0 || library.activeOwners.Load() != 0 || f.releaseCalls != 1 {
+					t.Errorf("module unload preceded actual release: raw=%x owners=%d releases=%d",
+						f.owner.raw, library.activeOwners.Load(), f.releaseCalls)
+				}
+			}
+			if result == "cleanup-error" {
+				library.procedures["mh_close1"] = syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+					f.closeCalls++
+					*out = rustOwnerOutcome{Size: 48, Version: 1, State: 3, Flags: 3, PID: 42,
+						RootExit: 259, CleanupMask: 4, CleanupCodes: [3]int32{0, 0, 6}}
+					return 0
+				})
+			}
+			if result != "success" {
+				library.procedures["mh_release1"] = syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+					f.releaseCalls++
+					*slot = 0
+					*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+					if result == "malformed-release" {
+						out.Size = 47
+					} else {
+						out.State, out.CleanupMask, out.CleanupCodes[2] = 3, 4, 6
+					}
+					return 0
+				})
+			}
+			if view, err := p.ObserveOriginal(rustStdioTestContext(t), false); err != nil || !view.OriginalJobExited {
+				t.Fatalf("terminal fixture: view=%+v err=%v", view, err)
+			}
+			if root := p.WaitOriginal(); !root.Known || root.Error != nil {
+				t.Fatalf("root fixture: %+v", root)
+			}
+			if api.freeCalls != 0 || f.closeCalls != 0 || f.releaseCalls != 0 {
+				t.Fatal("wait or observation closed the native owner/module")
+			}
+			var firstError string
+			for i := 0; i < 2; i++ {
+				settlement, err := p.ReleaseOriginal()
+				if (err == nil) != (result == "success") || settlement == nil ||
+					settlement.Complete() != (result == "success") {
+					t.Fatalf("release %d result=%s settlement=%v err=%v", i, result, settlement, err)
+				}
+				if result == "malformed-release" && !errors.Is(err, errRustOwnerOutcome) {
+					t.Fatalf("malformed native error lost: %v", err)
+				}
+				if result == "cleanup-error" {
+					var cleanup *rustOwnerCleanupFailure
+					if !errors.As(err, &cleanup) || cleanup.Mask != 4 || cleanup.Codes[2] != 6 {
+						t.Fatalf("native cleanup error lost: %v", err)
+					}
+				}
+				if err != nil {
+					if i == 0 {
+						firstError = err.Error()
+					} else if err.Error() != firstError {
+						t.Fatalf("terminal error changed: first=%q current=%q", firstError, err.Error())
+					}
+				}
+			}
+			if f.owner.raw != 0 || library.activeOwners.Load() != 0 || library.ready ||
+				library.handle != 0 || api.freeCalls != 1 || f.closeCalls != 1 || f.releaseCalls != 1 {
+				t.Fatalf("owned module release counts/state: raw=%x owners=%d ready=%t handle=%x frees=%d closes=%d releases=%d",
+					f.owner.raw, library.activeOwners.Load(), library.ready, library.handle,
+					api.freeCalls, f.closeCalls, f.releaseCalls)
+			}
+		})
+	}
+}
+
+func TestRustOwnerProductUnreleasedNativeOwnerRetainsModule(t *testing.T) {
+	for _, stage := range []string{"malformed-close", "release-keeps-slot"} {
+		t.Run(stage, func(t *testing.T) {
+			f, child, p := newRustFacadeABIFixture(t)
+			library := f.owner.library
+			api := &fakeRustOwnerLibraryAPI{}
+			library.api, library.handle = api, windows.Handle(0x44)
+			child.ownsLibrary = true
+			if stage == "malformed-close" {
+				library.procedures["mh_close1"] = syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+					f.closeCalls++
+					*out = rustOwnerOutcome{Size: 47, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+					return 0
+				})
+			} else {
+				library.procedures["mh_release1"] = syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+					f.releaseCalls++
+					*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+					return 0 // A success-shaped reply without surrendering the slot.
+				})
+			}
+			if _, err := p.ObserveOriginal(rustStdioTestContext(t), false); err != nil {
+				t.Fatal(err)
+			}
+			if root := p.WaitOriginal(); !root.Known || root.Error != nil {
+				t.Fatalf("root fixture: %+v", root)
+			}
+			for i := 0; i < 2; i++ {
+				settlement, err := p.ReleaseOriginal()
+				if err == nil || settlement == nil || settlement.Complete() {
+					t.Fatalf("unreleased original reported clean: settlement=%v err=%v", settlement, err)
+				}
+			}
+			wantRelease := 0
+			if stage == "release-keeps-slot" {
+				wantRelease = 1
+			}
+			if f.owner.raw == 0 || library.activeOwners.Load() != 1 || !library.ready ||
+				library.closeAttempted || api.freeCalls != 0 || f.closeCalls != 1 || f.releaseCalls != wantRelease {
+				t.Fatalf("failed native phase lost module or retried: raw=%x owners=%d ready=%t moduleClose=%t frees=%d closes=%d releases=%d",
+					f.owner.raw, library.activeOwners.Load(), library.ready, library.closeAttempted,
+					api.freeCalls, f.closeCalls, f.releaseCalls)
+			}
+		})
+	}
+}
+
+func TestRustOwnerProductNoChildModuleCloseIsCached(t *testing.T) {
+	for _, fails := range []bool{false, true} {
+		name := "success"
+		if fails {
+			name = "close-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			var closeErr error
+			if fails {
+				closeErr = errors.New("owned module close failed")
+			}
+			api := &fakeRustOwnerLibraryAPI{freeErr: closeErr}
+			library := &rustOwnerLibrary{api: api, handle: windows.Handle(0x44), ready: true}
+			child := &rustContainedChild{library: library, ownsLibrary: true, noChildKnown: true}
+			p := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+			if err := child.closeContainedJobBackstop(); err == nil {
+				t.Fatal("backstop reported clean while the owned no-child module was still open")
+			}
+			rustProductReleaseNoChild(t, p, closeErr)
+			if api.freeCalls != 1 || library.ready || !errors.Is(child.closeError, closeErr) {
+				t.Fatalf("no-child close not retained: frees=%d ready=%t childError=%v want=%v",
+					api.freeCalls, library.ready, child.closeError, closeErr)
+			}
+			if err := child.closeContainedJobBackstop(); !errors.Is(err, closeErr) {
+				t.Fatalf("backstop hid cached module close outcome: err=%v want=%v", err, closeErr)
+			}
+			if fails && library.handle == 0 {
+				t.Fatal("failed FreeLibrary erased the retained module handle")
+			}
+		})
+	}
+}

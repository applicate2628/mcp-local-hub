+func TestRustOwnerNativeRootKnownWhileJobMemberActive(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	var owner *rustNativeOwner
+	// Job shutdown must precede t.TempDir cleanup on all failure paths.
+	cwd := t.TempDir()
+	t.Cleanup(func() {
+		if owner != nil && owner.raw != 0 {
+			_, _ = owner.Stop(71)
+			_, _ = owner.Finish(10000)
+			if err := owner.Release(); err != nil {
+				t.Errorf("native owner cleanup: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("library cleanup: %v", err)
+		}
+	})
+	memberDir := filepath.Join(cwd, "rust-owner-job-member")
+	if err := os.Mkdir(memberDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	var created rustOwnerOutcome
+	var err error
+	owner, created, err = library.newRustOwner(program, cwd, []string{
+		"-test.run=^TestRustOwnerJobSpawnerFixture$",
+		"-test.outputdir=" + memberDir,
+	})
+	if err != nil || owner == nil || created.PID == 0 {
+		t.Fatalf("original root creation PID=%d err=%v owner=%t", created.PID, err, owner != nil)
+	}
+	beforeCtx, cancelBefore := context.WithTimeout(context.Background(), 2*time.Second)
+	before, err := owner.FormatOriginalUserSID(beforeCtx)
+	cancelBefore()
+	if err != nil {
+		t.Fatalf("cannot capture original identity before admission: %v", err)
+	}
+	beforeFacts, err := before.creatorFacts()
+	if err != nil || beforeFacts.OriginalPID != int(created.PID) || !beforeFacts.RootAlive {
+		t.Fatalf("original identity not observed while process was suspended: PID=%d alive=%t err=%v",
+			beforeFacts.OriginalPID, beforeFacts.RootAlive, err)
+	}
+	if admitted, err := owner.Admit(true); err != nil {
+		t.Fatalf("original root admit=%+v err=%v", admitted, err)
+	}
+	expectedMarker := filepath.Join(memberDir, "member-ready")
+	markerDeadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(markerDeadline) {
+		if _, err := os.Stat(expectedMarker); err == nil {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if _, err := os.Stat(expectedMarker); err != nil {
+		t.Fatalf("member was not started: %v", err)
+	}
+	var pending rustOwnerOutcome
+	var observed bool
+	for deadline := time.Now().Add(4 * time.Second); time.Now().Before(deadline); {
+		ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+		value, err := owner.FinishWithin(ctx)
+		cancel()
+		if err != nil && !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("root/member wait failure %+v: %v", value, err)
+		}
+		if value.State == 2 || value.State == 3 {
+			t.Fatalf("Job settled before its live descendant: %+v err=%v", value, err)
+		}
+		if value.State == 1 && value.Flags&1 != 0 && value.Flags&2 != 0 && value.Active > 0 {
+			pending = value
+			observed = true
+			break
+		}
+	}
+	if !observed || pending.PID != created.PID || pending.RootExit != 0 {
+		t.Fatalf("root exit was not independently known while member remained: %+v", pending)
+	}
+	// The pre-exit capture remains a historical observation of the original
+	// owner; it must not be relabeled as a current post-exit identity.
+	if beforeFacts.OriginalPID != int(pending.PID) || !beforeFacts.RootAlive ||
+		beforeFacts.OriginalStartedAt == "" {
+		t.Fatal("retained original creation-time evidence lost before root settlement")
+	}
+	identityCtx, cancelIdentity := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancelIdentity()
+	proof, queryErr := owner.FormatOriginalUserSID(identityCtx)
+	if queryErr != nil {
+		if proof != nil {
+			if incomplete, err := proof.creatorFacts(); err == nil || incomplete.Version != 0 {
+				t.Fatalf("post-exit failing query produced creator facts: %v", queryErr)
+			}
+		}
+		// QueryFullProcessImageNameW may refuse an exited process even though
+		// the same original handle still supplies known root-exit evidence.
+		t.Logf("post-exit identity query unavailable, preserving pre-exit facts: %v", queryErr)
+	} else {
+		facts, err := proof.creatorFacts()
+		if err != nil || facts.OriginalPID != int(created.PID) || facts.RootAlive ||
+			facts.OriginalStartedAt != beforeFacts.OriginalStartedAt ||
+			!facts.RootWaitKnown || facts.RootWaitResult != uint32(windows.WAIT_OBJECT_0) {
+			t.Fatalf("post-exit identity contradicts original: PID=%d alive=%t err=%v",
+				facts.OriginalPID, facts.RootAlive, err)
+		}
+	}
+	if stopped, err := owner.Stop(71); err != nil {
+		t.Fatalf("stop original Job %+v: %v", stopped, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	settled, err := owner.FinishWithin(ctx)
+	if err != nil || settled.State != 2 || settled.RootExit != 0 || settled.PID != created.PID ||
+		settled.Active != 0 || settled.Flags&1 == 0 {
+		t.Fatalf("member settlement discarded original root exit: %+v err=%v", settled, err)
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+}

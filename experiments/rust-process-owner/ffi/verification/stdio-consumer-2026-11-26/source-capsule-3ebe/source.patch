+                    &mut *owner,
+                    version,
+                    epoch,
+                    &mut finalized,
+                    receive,
+                    token,
+                    &mut report,
+                    report_bytes,
+                    &mut out,
+                    out_bytes,
+                )
+            },
+            expected
+        );
+        assert_eq!((finalized, receiver.calls), (0, 0));
+        assert!(
+            owner.inner.job_member_snapshot().unwrap() == &baseline,
+            "acquisition facts changed after preflight refusal"
+        );
+        assert_eq!(
+            owner.inner.terminate(1).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+    }
+    let mut occupied = 7;
+    // SAFETY: a nonzero input is valid storage but invalid preflight.
+    assert_eq!(
+        unsafe {
+            mh_members_close1(
+                &mut *owner,
+                VERSION,
+                generation,
+                &mut occupied,
+                callback,
+                token,
+                &mut report,
+                REPORT_BYTES,
+                &mut out,
+                OUT_BYTES,
+            )
+        },
+        ARGUMENT
+    );
+    assert_eq!(occupied, 7);
+    // SAFETY: null scalar is rejected without dereference/native close.
+    assert_eq!(
+        unsafe {
+            mh_members_close1(
+                &mut *owner,
+                VERSION,
+                generation,
+                ptr::null_mut(),
+                callback,
+                token,
+                &mut report,
+                REPORT_BYTES,
+                &mut out,
+                OUT_BYTES,
+            )
+        },
+        ARGUMENT
+    );
+
+    let mut receiver = SnapshotReceiverState::default();
+    let token = &mut receiver as *mut SnapshotReceiverState as usize;
+    let callback: Option<SnapshotReceiver> = Some(receive_snapshot);
+    for (version, epoch, receive, expected) in [
+        (2, generation, callback, ABI),
+        (1, 0, callback, ARGUMENT),
+        (1, generation, None, ARGUMENT),
+    ] {
+        // SAFETY: complete owner/output/state, deliberately invalid request metadata.
+        assert_eq!(
+            unsafe {
+                mh_members_snapshot1(
+                    &mut *owner,
+                    version,
+                    epoch,
+                    receive,
+                    token,
+                    &mut report,
+                    REPORT_BYTES,
+                    &mut out,
+                    OUT_BYTES,
+                )
+            },
+            expected
+        );
+        assert_eq!(receiver.calls, 0);
+        assert!(
+            owner.inner.job_member_snapshot().unwrap() == &baseline,
+            "acquisition facts changed after preflight refusal"
+        );
+    }
+    for (version, epoch, budget, expected) in [
+        (2, generation, 1000, ABI),
+        (1, 0, 1000, ARGUMENT),
+        (1, generation, 60001, ARGUMENT),
+    ] {
+        // SAFETY: complete live owner/output; malformed version/epoch/budget.
+        assert_eq!(
+            unsafe {
+                mh_members_revalidate1(
+                    &mut *owner,
+                    version,
+                    epoch,
+                    budget,
+                    0,
+                    &mut report,
+                    REPORT_BYTES,
+                    &mut out,
+                    OUT_BYTES,
+                )
+            },
+            expected
+        );
+        assert_eq!(report.error_source, SOURCE_NONE);
+    }
+    assert!(
+        owner.inner.job_member_snapshot().unwrap() == &baseline,
+        "acquisition facts changed after preflight refusal"
+    );
+    // Valid close proves none of the refused terminal attempts consumed state.
+    let (status, finalized, receiver, _, _) = close(&mut owner, generation);
+    assert_eq!((status, finalized, receiver.calls), (OK, 1, 1));
+    settle(&mut owner, 86);
+}

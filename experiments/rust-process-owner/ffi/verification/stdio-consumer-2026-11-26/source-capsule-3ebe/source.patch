+}
+
+// These controls supplement the unchanged full Rust console read/write oracle.
+// The Go cases select the real legacy dependency branch explicitly, never as a
+// fallback from a Rust error. Both routes use the actual original creator and
+// pre-resume original-handle borrow; no child or native owner is synthesized.
+func TestForegroundNativeConsolePolicyMarkedReceiver(t *testing.T) {
+	foregroundConsoleRequireAvailable(t)
+	selected, err := ProductRustOwnerEnabled()
+	if err != nil {
+		t.Fatal(err)
+	}
+	inputs := 0
+	for _, name := range [...]string{"MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT", "MCPHUB_RUST_OWNER_INTEGRATION_COMMIT", "MCPHUB_RUST_OWNER_INTEGRATION_SHA256", "MCPHUB_RUST_OWNER_MEMBER_CHILD"} {
+		if os.Getenv(name) != "" {
+			inputs++
+		}
+	}
+	if !selected {
+		if inputs != 0 {
+			t.Fatal("explicit console controls require the marked GUI receiver")
+		}
+		t.Skip("requires marked GUI receiver and qualified native/CUI-child tuple")
+	}
+	if inputs != 4 {
+		t.Fatal("console controls require the complete native/CUI-child tuple")
+	}
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	foregroundConsoleRequirePE(t, self, 2)
+	retainedSources := false
+	for _, tc := range []struct {
+		name      string
+		legacy    bool
+		attached  bool
+		noConsole bool
+		mode      string
+	}{
+		{name: "rust-explicit-no-console", attached: true, noConsole: true, mode: "console-no-window"},
+		{name: "rust-parent-absent", mode: "console-no-window"},
+		{name: "rust-write-only", attached: true, mode: "console-write-only"},
+		{name: "go-console-stdio", legacy: true, attached: true, mode: "console-stdio"},
+		{name: "go-explicit-no-console", legacy: true, attached: true, noConsole: true, mode: "console-no-window"},
+		{name: "go-parent-absent", legacy: true, mode: "console-no-window"},
+		{name: "go-write-only", legacy: true, attached: true, mode: "console-write-only"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			console := &foregroundOwnedConsole{}
+			var f *rustIONativeFixture
+			var original *AtCreateJobProcess
+			var result ForegroundResult
+			mayCloseSources := true
+			t.Cleanup(func() {
+				if mayCloseSources {
+					console.close(t)
+				}
+			})
+			var extra []*os.File
+			t.Cleanup(func() {
+				if !mayCloseSources {
+					return
+				}
+				for _, file := range extra {
+					if err := file.Close(); err != nil {
+						t.Error(err)
+					}
+				}
+			})
+			// Registered before both native-fixture cleanups: this guard runs
+			// after them and before the first external source Close/FreeConsole.
+			t.Cleanup(func() {
+				if !foregroundConsoleRustResourcesReleased(t, f) {
+					mayCloseSources = false
+				}
+				if !mayCloseSources {
+					retainedSources = true
+					foregroundConsoleRetainFixture(t, original, f, console, extra)
+				}
+			})
+			f = newRustFacadeNativeFixture(t)
+			foregroundConsoleRequirePE(t, f.child, 3)
+			if !runtimeidentity.IsWindowsProcessOwnerBorrowExportProfileV1(f.library.identity.Exports) {
+				t.Fatal("console controls require the exact original-process borrow profile")
+			}
+			if err := f.library.Close(); err != nil {
+				t.Fatal(err)
+			}
+			f.library = nil
+
+			t.Cleanup(func() {
+				if !tc.legacy || original == nil || result.Settlement.Complete() {
+					return
+				}
+				mayCloseSources = false
+				foregroundConsoleReleaseGoOriginal(t, original)
+				// Root/handle recovery cannot prove every Job member has exited.
+				// Keep mayCloseSources false even if that backstop succeeds. The
+				// post-native guard retains all sources and the console, and
+				// stops subsequent cases until this receiver exits.
+			})
+			temp := os.TempDir()
+			rel, relErr := filepath.Rel("D:\\dev\\ChatGPT", temp)
+			if relErr != nil || !filepath.IsAbs(temp) || rel == ".." || strings.HasPrefix(rel, ".."+string(os.PathSeparator)) || filepath.IsAbs(rel) {
+				t.Fatal("console control reports require private D-only runner TEMP")
+			}
+			artifacts, err := os.MkdirTemp(temp, "foreground-console-control-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			f.marker = filepath.Join(artifacts, "console-initial.json")
+			t.Logf("retained actual console control evidence: %s", artifacts)
+
+			var streams rustOwnerStdio
+			var beforeModes [3]uint32
+			var writeModeErrors [2]uint32
+			if tc.attached {
+				if err := console.acquire(); err != nil {
+					t.Fatalf("owned console prerequisite: %v", err)
+				}
+				if err := console.prepareInput(); err != nil {
+					t.Fatal(err)
+				}
+				beforeModes, err = console.modes()
+				if err != nil {
+					t.Fatal(err)
+				}
+				streams = rustOwnerStdio{Stdin: console.files[0], Stdout: console.files[1], Stderr: console.files[2]}
+			} else {
+				count, err := foregroundConsoleProcessCount()
+				if err != nil || count != 0 {
+					t.Fatalf("unattached actor prerequisite: count=%d err=%v", count, err)
+				}
+			}
+			if !tc.attached || tc.mode == "console-write-only" {
+				file, err := os.OpenFile(os.DevNull, os.O_RDWR, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				extra = append(extra, file)
+				streams = rustOwnerStdio{Stdin: file, Stdout: file, Stderr: file}
+			}
+			if tc.mode == "console-write-only" {
+				outputs := [2]**os.File{&streams.Stdout, &streams.Stderr}
+				for i, target := range outputs {
+					file, err := os.OpenFile("CONOUT$", os.O_WRONLY, 0)
+					if err != nil {
+						t.Fatal(err)
+					}
+					extra = append(extra, file)
+					*target = file
+					var mode uint32
+					err = windows.GetConsoleMode(windows.Handle(file.Fd()), &mode)
+					var native syscall.Errno
+					if err == nil || !errors.As(err, &native) || native == 0 {
+						t.Fatalf("write-only fixture must have a real negative mode query: %v", err)
+					}
+					writeModeErrors[i] = uint32(native)
+				}
+			}
+			beforeFlags := rustIONativeStreamFlags(t, streams)
+			var rustChild *rustContainedChild
+			var goChild *windowsContainedChild
+			borrows := 0
+			admission := &foregroundTestAdmission{hook: func(owner *AtCreateJobProcess) error {
+				original = owner
+				if tc.legacy {
+					goChild, _ = owner.child.(*windowsContainedChild)
+					if goChild == nil {
+						return errors.New("legacy control did not retain the Go original creator")
+					}
+					if err := foregroundOriginalPrimarySuspended(owner); err != nil {
+						return err
+					}
+				} else {
+					rustChild, _ = owner.child.(*rustContainedChild)
+					if rustChild == nil || rustChild.owner == nil || !rustChild.ownsLibrary {
+						return errors.New("Rust control did not retain its original native owner")
+					}
+					f.owner, f.library = rustChild.owner, rustChild.library
+				}
+				if err := rustForegroundNativeBorrowBeforeResume(owner, f.marker); err != nil {
+					return err
+				}
+				borrows++
+				return nil
+			}}
+			deadline, finite := t.Deadline()
+			if !finite || time.Until(deadline) <= 5*time.Second+RetainedTerminationAllowance()+20*time.Second {
+				t.Fatal("console controls need work, terminal and fixture recovery budgets")
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			cmd := rustFacadeNativeCommand(f, tc.mode)
+			if tc.noConsole {
+				NoConsole(cmd)
+			}
+			var runErr error
+			if tc.legacy {
+				deps := defaultForegroundDependencies(ctx, admission, "")
+				deps.selectRust = func() (bool, error) { return false, nil }
+				result, runErr = runForeground(ctx, cmd, streams.Stdin, streams.Stdout, streams.Stderr, deps)
+			} else {
+				result, runErr = RunForegroundAdmitted(ctx, cmd, streams.Stdin, streams.Stdout, streams.Stderr, admission)
+			}
+			if original == nil {
+				original = result.Original
+			}
+			if rustChild == nil && !tc.legacy && result.Original != nil {
+				rustChild, _ = result.Original.child.(*rustContainedChild)
+				if rustChild != nil {
+					f.owner, f.library = rustChild.owner, rustChild.library
+				}
+			}
+			initial, initialErr := foregroundConsoleReadReport(t, f.marker)
+			final, finalErr := foregroundConsoleReadReport(t, f.marker+".final.json")
+			t.Logf("actual control root=%+v native=%+v execution cause=%v", result.Root, result.Native, runErr)
+			if got := rustIONativeStreamFlags(t, streams); got != beforeFlags {
+				t.Errorf("caller handle flags changed: before=%v after=%v", beforeFlags, got)
+			}
+			if tc.attached {
+				if got, modeErr := console.modes(); modeErr != nil || got != beforeModes {
+					t.Errorf("caller console modes changed: before=%v after=%v err=%v", beforeModes, got, modeErr)
+				}
+				var screen [22]uint16
+				var count uint32
+				err := foregroundConsoleBoolean("ReadConsoleOutputCharacterW", console.files[1].Fd(),
+					uintptr(unsafe.Pointer(&screen[0])), uintptr(len(screen)), 0, uintptr(unsafe.Pointer(&count)))
+				want := "console-outconsole-err"
+				if tc.mode == "console-no-window" {
+					want = strings.Repeat(" ", 22)
+				}
+				t.Logf("actual control screen: units=%v count=%d cause=%v", screen, count, err)
+				if err != nil || count != 22 || windows.UTF16ToString(screen[:]) != want {
+					t.Error("child console writes did not match the original parent buffer")
+				}
+			} else if count, err := foregroundConsoleProcessCount(); err != nil || count != 0 {
+				t.Errorf("unattached actor changed console association: count=%d err=%v", count, err)
+			}
+			if runErr != nil || result.Original != original || !result.Root.Known || result.Root.Error != nil ||
+				result.Settlement == nil || !result.Settlement.Complete() || !result.Native.HandlesClosed || len(result.Outcome.Pending) != 0 {
+				t.Errorf("original console control settlement: root=%+v native=%+v outcome=%+v err=%v", result.Root, result.Native, result.Outcome, runErr)
+			}
+			if admission.hooks != 1 || admission.closes != 1 || borrows != 1 || result.Admission != admission ||
+				!result.AdmissionCloseAttempted || result.AdmissionCloseError != nil {
+				t.Errorf("original console control admission: hooks=%d closes=%d borrows=%d close=%v", admission.hooks, admission.closes, borrows, result.AdmissionCloseError)
+			}
+			if tc.legacy {
+				if goChild == nil || result.Job == nil || result.Job != goChild.job || result.Outcome.LibraryClose.Acquired {
+					t.Error("legacy console control changed creator or acquired a Rust module")
+				}
+			} else if rustChild != nil && result.Root.Known {
+				rustForegroundNativeAssertSettlement(t, rustChild, result, result.Root.ExitCode)
+			}
+			if initialErr != nil || finalErr != nil || initial.Schema != "foreground-console-child-v2" || final.Schema != initial.Schema ||
+				final.Mode != tc.mode || initial.Mode != tc.mode || initial.PID != uint32(result.Native.RootIdentity.PID) || final.PID != initial.PID ||
+				!final.ExitKnown || final.ExitCode != 37 || !result.Root.Known || result.Root.ExitCode != 37 {
+				t.Fatalf("actual CUI control report failed: initialErr=%v finalErr=%v initial=%+v final=%+v root=%+v", initialErr, finalErr, initial, final, result.Root)
+			}
+			sharesParent := tc.mode != "console-no-window"
+			foregroundConsoleAssertAssociation(t, initial, sharesParent)
+			foregroundConsoleAssertAssociation(t, final, sharesParent)
+			if tc.mode == "console-no-window" {
+				for _, report := range [...]foregroundConsoleReport{initial, final} {
+					if report.Read.Attempted || report.Writes[0].Attempted || report.Writes[1].Attempted {
+						t.Errorf("no-window control unexpectedly attempted console IO: %+v", report)
+					}
+					for _, stream := range report.Streams {
+						if !stream.Handle.OK || !stream.Mode.Attempted || !stream.Mode.Completed ||
+							stream.Mode.OK || stream.Mode.Code != uint32(windows.ERROR_INVALID_HANDLE) {
+							t.Errorf("no-window child did not preserve the invalid console-stdio observation: %+v", stream)
+						}
+					}
+				}
+				return
+			}
+			for i, write := range final.Writes {
+				if !write.Attempted || !write.Completed || !write.OK || write.Code != 0 || write.Count != 11 {
+					t.Errorf("actual console write %d failed: %+v", i, write)
+				}
+			}
+			if tc.mode == "console-stdio" {
+				if !final.Read.Attempted || !final.Read.Completed || !final.Read.OK || final.Read.Code != 0 ||
+					final.Read.Count != 1 || final.Character != 'Q' {
+					t.Errorf("legacy original console read failed: %+v character=%#x", final.Read, final.Character)
+				}
+				for _, stream := range final.Streams {
+					if !stream.Handle.OK || !stream.Mode.OK {
+						t.Errorf("legacy original standard console observation failed: %+v", stream)
+					}
+				}
+			} else {
+				if final.Read.Attempted || final.Streams[0].Mode.OK {

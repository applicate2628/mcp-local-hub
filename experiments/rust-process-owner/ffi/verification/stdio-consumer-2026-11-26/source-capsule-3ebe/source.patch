+func TestOriginalMemberBatchFinalizerRetriesAfterQueryExit(t *testing.T) {
+	calls := 0
+	var terminalContext context.Context
+	owner, source := originalMemberBatchTestOwner(t, func(ctx context.Context, _ *OriginalJobMemberObservation) (OriginalJobMemberCloseSnapshotV1, bool, error) {
+		calls++
+		if calls == 1 {
+			if ctx != nil {
+				t.Error("last-query cleanup borrowed a terminal caller context")
+			}
+			return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("library-lock", nil)
+		}
+		if ctx != terminalContext {
+			t.Error("terminal retry lost its original context")
+		}
+		return originalMemberBatchTestView(), true, nil
+	})
+	leave, err := source.gate.enterQuery(owner)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(leave)
+	pending, err := owner.CloseObserved()
+	if pending == nil || !errors.Is(err, ErrOriginalMemberBorrowPending) || calls != 0 {
+		t.Fatalf("close overtook an entered query: calls=%d err=%v", calls, err)
+	}
+	if permit, err := source.gate.beginTerminal(nil); permit != nil || !errors.Is(err, ErrOriginalMemberBorrowPending) || calls != 0 {
+		t.Fatalf("unbounded terminal caller waited for the query: %v", err)
+	}
+	leave()
+	if calls != 1 || owner.finalizerStarted || source.gate.active != owner {
+		t.Fatal("last-query pre-entry refusal did not preserve retryable custody")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	terminalContext = ctx
+	permit, err := source.gate.beginTerminal(ctx)
+	if err != nil || permit == nil || calls != 2 {
+		t.Fatalf("terminal caller did not retry the same observation: calls=%d err=%v", calls, err)
+	}
+	defer permit.finish()
+	proof, err := owner.CloseObserved()
+	if err != nil || !proof.Finalized() || pending.Finalized() || pending.Validate(source) == nil {
+		t.Fatalf("retry changed receipt authority: %v", err)
+	}
+}

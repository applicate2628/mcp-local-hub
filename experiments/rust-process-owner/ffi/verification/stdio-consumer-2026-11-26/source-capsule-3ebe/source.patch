+	created, _, err := f.owner.library.startRetainedRustOwner(ctx, "C:\\fixture\\child.exe", "C:\\fixture", nil, func(owner *rustNativeOwner) error {
+		retained = owner
+		if owner.memberGate.source == nil || owner.raw != 0 {
+			return errors.New("source was not installed before retention")
+		}
+		return nil
+	})
+	if err != nil || retained != created || created.memberGate.source == nil {
+		t.Fatalf("retention source changed: %v", err)
+	}
+}

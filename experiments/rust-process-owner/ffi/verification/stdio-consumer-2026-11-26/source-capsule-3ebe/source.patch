+func TestSerenaInterpreterOriginalHandleSurvivesAliasRetarget(t *testing.T) {
+	root := t.TempDir()
+	first, second := filepath.Join(root, "first"), filepath.Join(root, "second")
+	for _, dir := range []string{first, second} {
+		if err := os.Mkdir(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		// Equal bytes deliberately require the file-identity binding.
+		if err := os.WriteFile(filepath.Join(dir, "python.exe"), []byte("same bytes"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	link := filepath.Join(root, "selected")
+	serenaInterpreterJunctionForTest(t, root, link, first)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	expected, err := qualifyPreparedSerenaInterpreter(ctx, filepath.Join(first, "python.exe"), 1<<20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	native, err := serenaInterpreterNativePath(filepath.Join(link, "python.exe"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	name, err := windows.UTF16PtrFromString(native)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original, err := windows.CreateFile(name, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES,
+		windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	closeAttempted := false
+	defer func() {
+		if !closeAttempted {
+			if err := windows.CloseHandle(original); err != nil {
+				t.Errorf("close original selected handle: %v", err)
+			}
+		}
+	}()
+	if err := os.Remove(link); err != nil {
+		t.Fatal(err)
+	}
+	serenaInterpreterJunctionForTest(t, root, link, second)
+	actual, err := qualifyPreparedSerenaInterpreterHandle(ctx, original, 1<<20)
+	if err != nil || actual != expected {
+		t.Fatalf("retargeted alias replaced the retained original: got=%+v want=%+v err=%v", actual, expected, err)
+	}
+	reselected, err := qualifyPreparedSerenaInterpreter(ctx, filepath.Join(link, "python.exe"), 1<<20)
+	if err != nil || reselected.FileID == actual.FileID || reselected.SHA256 != actual.SHA256 {
+		t.Fatalf("fixture did not select a distinct equal-content file: %+v err=%v", reselected, err)
+	}
+	if _, err := windows.GetFileType(original); err != nil {
+		t.Fatalf("borrowed original handle was closed by qualification: %v", err)
+	}
+	closeAttempted = true
+	if err := windows.CloseHandle(original); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(filepath.Join(first, "python.exe"), filepath.Join(first, "closed.exe")); err != nil {
+		t.Fatalf("retained original file still open after explicit close: %v", err)
+	}

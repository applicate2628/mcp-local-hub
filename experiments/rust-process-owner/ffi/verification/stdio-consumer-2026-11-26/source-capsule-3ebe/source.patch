+func TestRustOwnerMemberEffectSlotsSurviveAcquisitionErrors(t *testing.T) {
+	for _, tc := range []struct {
+		mode              string
+		generation        uint64
+		resources, closes int
+		final             bool
+	}{
+		{"malformed", 1, 2, 1, true}, {"partial", 1, 2, 1, true}, {"empty-partial", 1, 0, 1, true},
+		{"no-reservation", 0, 0, 0, true}, {"indeterminate", 0, 0, 0, false},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			f := newRustMemberScript(t)
+			f.observeMode = tc.mode
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			o, err := observeOriginalJobMembers(ctx, f.owner.memberGate.source)
+			if err == nil || o == nil {
+				t.Fatal("failed acquisition lost observation")
+			}
+			state := o.native.(*rustOwnerMemberObservation)
+			closeProof, _ := o.CloseObserved()
+			if state.generation != tc.generation || len(o.Snapshot().Resources) != tc.resources ||
+				f.closeCalls != tc.closes || closeProof.Finalized() != tc.final || o.Snapshot().Complete {
+				t.Fatalf("effect lost: generation=%d resources=%d closes=%d final=%t", state.generation, len(o.Snapshot().Resources), f.closeCalls, closeProof.Finalized())
+			}
+		})
+	}
+	for _, mode := range []string{"missing", "repeat"} {
+		t.Run("snapshot-"+mode, func(t *testing.T) {
+			f := newRustMemberScript(t)
+			f.snapshotMode = mode
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			o, err := observeOriginalJobMembers(ctx, f.owner.memberGate.source)
+			if err == nil || o == nil || o.native.(*rustOwnerMemberObservation).generation != 1 || f.closeCalls != 1 {
+				t.Fatal("snapshot failure lost native close")
+			}
+			proof, closeErr := o.CloseObserved()
+			if closeErr != nil || !proof.Finalized() {
+				t.Fatalf("unknown acquisition resources could not use valid native close: %v", closeErr)
+			}
+		})
+	}
+}

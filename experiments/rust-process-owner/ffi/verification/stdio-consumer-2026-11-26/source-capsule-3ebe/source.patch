+		}
+		defer ownerMutex.Unlock()
+		if err := got.Err(); err != nil {
+			return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("before-native-entry", err)
+		}
+		nativeEntries.Add(1)
+		return originalMemberBatchTestView(), true, nil
+	})
+	done := make(chan originalMemberTerminalTestResult, 1)
+	joined := false
+	t.Cleanup(func() {
+		release()
+		cancel()
+		if !joined {

+// These fixtures exercise facade admission, evidence projection and receiving.
+// They do not establish real native process creation or physical handle closure.
+type facadeCustodyChild struct {
+	present, created, jobExited bool
+	gate                        *originalMemberCustody
+	waits, closes, actions      atomic.Int32
+	observations                atomic.Int32
+	closeFn                     func() error
+	identityFn                  func(context.Context) (*CreatorIdentity, error)
+	native                      ContainedNativeSnapshot
+	nativeErr                   error
+}
+
+func newFacadeCustodyFixture() (*ProvisionalProcess, *facadeCustodyChild) {
+	child := &facadeCustodyChild{present: true, created: true, jobExited: true, gate: newOriginalMemberCustody()}
+	return &ProvisionalProcess{owner: child, waitDone: make(chan struct{})}, child
+}
+
+func (c *facadeCustodyChild) provisionalCustodyPresent() bool { return c != nil && c.present }
+func (c *facadeCustodyChild) containedCreated() bool          { return c != nil && c.created }
+func (c *facadeCustodyChild) start(*exec.Cmd, containedInputFile, containedWriteFile, containedWriteFile) error {
+	return errors.New("synthetic facade child does not create processes")
+}
+func (c *facadeCustodyChild) wait() containedWaitResult {
+	c.waits.Add(1)
+	return containedWaitResult{exited: true, exitCode: 73}
+}
+func (c *facadeCustodyChild) terminate(uint32) error { c.actions.Add(1); return nil }
+func (c *facadeCustodyChild) close() error           { return errors.New("original close permit required") }
+func (c *facadeCustodyChild) creatorBinding() (creatorClosureBinding, error) {
+	return creatorClosureBinding{pid: 4242, startedAt: "2026-11-19T00:00:00Z"}, nil
+}
+func (c *facadeCustodyChild) creatorExitObservation() creatorExitObservation {
+	return creatorExitObservation{known: true, code: 73}
+}
+func (c *facadeCustodyChild) observeCreatorMembers(context.Context) error { return nil }
+func (c *facadeCustodyChild) creatorJobExitKnown() bool                   { return c.jobExited }
+func (c *facadeCustodyChild) terminal(ctx context.Context, action creatorTerminalAction) (creatorTerminalObservation, error) {
+	permit, err := originalMemberPermitFromContext(ctx, c.gate)
+	if err != nil {
+		return creatorTerminalObservation{}, err
+	}
+	if err := permit.markNativeEntry(ctx); err != nil {
+		return creatorTerminalObservation{}, err
+	}
+	c.actions.Add(1)
+	return creatorTerminalObservation{action: action, originalJobExited: c.jobExited}, nil
+}
+func (c *facadeCustodyChild) completeCreatorMembers(ctx context.Context) (creatorTerminalObservation, error) {
+	return c.terminal(ctx, creatorTerminalNotRequested)
+}
+func (c *facadeCustodyChild) terminateCreatorMembers(ctx context.Context) (creatorTerminalObservation, error) {
+	return c.terminal(ctx, creatorTerminalRequestSucceeded)
+}
+func (c *facadeCustodyChild) originalMemberTerminal(ctx context.Context) (*originalMemberTerminalPermit, error) {
+	return c.gate.beginTerminal(ctx)
+}
+func (c *facadeCustodyChild) originalMemberCloseReady(permit *originalMemberTerminalPermit) error {
+	return permit.validate(c.gate)
+}
+func (c *facadeCustodyChild) closeOriginalWithPermit(permit *originalMemberTerminalPermit) error {
+	if err := permit.validate(c.gate); err != nil {
+		return err
+	}
+	c.closes.Add(1)
+	if c.closeFn != nil {
+		return c.closeFn()
+	}
+	return permit.markNativeEntry(nil)
+}
+func (c *facadeCustodyChild) ObserveCreatorIdentity(ctx context.Context) (*CreatorIdentity, error) {
+	if c.identityFn == nil {
+		return nil, errors.New("synthetic identity issuer unavailable")
+	}
+	return c.identityFn(ctx)
+}
+func (c *facadeCustodyChild) prepareContainedObservation()                     {}
+func (c *facadeCustodyChild) containedStartLive(context.Context) (bool, error) { return true, nil }
+func (c *facadeCustodyChild) closeContainedJobBackstop() error                 { return nil }
+func (c *facadeCustodyChild) containedRootIdentity() (ContainedRootIdentity, error) {
+	return ContainedRootIdentity{Known: true, PID: 4242, StartedAt: "2026-11-19T00:00:00Z"}, nil
+}
+func (c *facadeCustodyChild) settleContained(context.Context, bool) (ContainedNativeSnapshot, error) {
+	c.observations.Add(1)

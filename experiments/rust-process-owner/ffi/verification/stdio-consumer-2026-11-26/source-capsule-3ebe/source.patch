+func TestRustOwnerArgv0NativeCommandLineCompatibility(t *testing.T) {
+	for _, tc := range []struct {
+		name, argv0, parsed string
+		legacy              bool
+	}{
+		{name: "v1-original-bytes", legacy: true},
+		{name: "leaf", argv0: "git", parsed: "git"},
+		{name: "empty"},
+		{name: "space-trailing-slash", argv0: "space name\\", parsed: "space name\\"},
+		{name: "quotes-with-space", argv0: "a \"b\\", parsed: "a b\\"},
+		{name: "leading-quote", argv0: "\"quoted", parsed: "quoted"},
+		{name: "interior-quotes", argv0: "a\"b\"", parsed: "ab"},
+		{name: "slash-before-quotes", argv0: "a\\\"b\"", parsed: "a\\b"},
+		{name: "quote-only", argv0: "\""},
+		{name: "control", argv0: "a\x01b", parsed: "a\x01b"},
+		{name: "unicode", argv0: "λ 🦀\\", parsed: "λ 🦀\\"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newRustIONativeFixture(t)
+			pipes := f.pipes(t)
+			f.closeFile(t, pipes.input)
+			args := []string{"command-line", f.marker}
+			if tc.legacy {
+				tc.argv0, tc.parsed = f.child, f.child
+			} else {
+				args = append(args, "", "two words", "trailing\\", "space trail\\", "a\"b", "λ🦀", "*?")
+			}
+			cmd := &exec.Cmd{
+				Path: f.child, Dir: f.cwd, Args: append([]string{tc.argv0}, args...),
+				Env: []string{"SystemRoot="},
+			}
+			prepared, err := prepareRustOwnerCommand(cmd)
+			if err != nil {
+				t.Fatal(err)
+			}
+			launch := &rustOwnerLaunchIO{environment: prepared.environment, streams: pipes.streams}
+			if !tc.legacy {
+				launch.argv0 = &prepared.argv0
+			}
+			ctx := rustIONativeContext(t)
+			retained, _, err := f.library.startRetainedRustOwnerContext(
+				ctx, prepared.program, prepared.cwd, prepared.args, launch,
+				func(owner *rustNativeOwner) error {
+					f.owner = owner
+					if owner == nil || owner.raw != 0 {
+						return errors.New("argv zero fixture did not retain before create")
+					}
+					return nil
+				},
+			)
+			if err != nil || retained != f.owner || f.owner == nil || f.owner.raw == 0 {
+				t.Fatalf("argv zero create lost original custody: err=%v", err)
+			}
+			identity, err := f.owner.QueryIdentity()
+			if err != nil || !sameWindowsPath(windows.UTF16ToString(identity.ImageUTF16), f.child) {
+				t.Fatalf("argv zero selected a different executable image: err=%v", err)
+			}
+			rustIONativeAbsent(t, f.marker)
+			f.closeChildEnds(t, pipes)
+			if _, err := f.owner.Admit(true); err != nil {
+				t.Fatal(err)
+			}
+			f.finish(t, ctx, 0)
+			fields := readRustIONativeContext(t, f.marker, len(args)+2)
+			wantLine := windows.ComposeCommandLine(cmd.Args)
+			if tc.legacy {
+				// The original encoder quoted every argument, including the
+				// fixed mode token. Preserve those bytes, not just parsed argv.
+				wantLine = "\"" + f.child + "\" \"command-line\" \"" + f.marker + "\""
+			}
+			if fields[0] == nil || *fields[0] != wantLine {
+				t.Fatalf("actual GetCommandLineW differs: got=%v want=%q", fields[0], wantLine)
+			}
+			if fields[1] == nil || *fields[1] != tc.parsed {
+				t.Fatalf("actual child argv zero differs: got=%v want=%q", fields[1], tc.parsed)
+			}
+			for i, want := range args {
+				if fields[i+2] == nil || *fields[i+2] != want {
+					t.Fatalf("actual child argument %d differs: got=%v want=%q", i+1, fields[i+2], want)
+				}
+			}
+			f.release(t)
+		})
+	}
+}

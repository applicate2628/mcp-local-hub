+//go:build windows && !amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+)
+
+// The Product sidecar is qualified only for Windows AMD64. The ordinary host
+// queries ProductRustOwnerEnabled before selecting this construction path.
+func StartProductRustOriginal(
+	ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+	retain func(*AtCreateJobProcess) error,
+) (*AtCreateJobProcess, error) {
+	if retain == nil {
+		return nil, errors.New("Rust product original-process retention callback required")
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	return nil, errProductRustOwnerUnsupported
+}
+
+func StartProductRustProvisional(
+	ctx context.Context, cmd *exec.Cmd, retain func(*ProvisionalProcess) error,
+) (*ProvisionalProcess, error) {
+	if retain == nil {
+		return nil, errors.New("Rust product provisional retention callback required")
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	return nil, errProductRustOwnerUnsupported
+}
diff --git a/internal/process/rust_owner_product_windows.go b/internal/process/rust_owner_product_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..9bb34d9d3926dc7227b90a2ecb751740256edd09
--- /dev/null
+++ b/internal/process/rust_owner_product_windows.go
@@ -0,0 +1,159 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+// StartProductRustOriginal admits the bundled Product DLL and transfers its
+// lifetime to the same retained original facade. The caller still owns all
+// three files. A finite ctx bounds admission, never the healthy child lifetime.
+// Every failure after acquisition returns that facade; no error selects Go.
+func StartProductRustOriginal(
+	ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+	retain func(*AtCreateJobProcess) error,
+) (*AtCreateJobProcess, error) {
+	return startProductRustOriginal(ctx, cmd, stdin, stdout, stderr, retain, openProductRustOwnerLibrary)
+}
+
+func startProductRustOriginal(
+	ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+	retain func(*AtCreateJobProcess) error,
+	open func() (*rustOwnerLibrary, error),
+) (*AtCreateJobProcess, error) {
+	if retain == nil || open == nil {
+		return nil, errors.New("Rust product original-process retention and library opener required")
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	child := &rustContainedChild{startContext: ctx, ownsLibrary: true}
+	p := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	child.retain = func() error { return retain(p) }
+	err := startProductRustChild(child, open, func() error {
+		return child.start(cmd, stdin, stdout, stderr)
+	})
+	return p, err
+}
+
+// StartProductRustProvisional retains the supervisor's sole creator before
+// native creation. Nil command streams have explicit NUL semantics; no pipe
+// worker or Go process owner is manufactured. The same creator owns the DLL
+// until its native allocation is released. Admission never bounds its lifetime.
+func StartProductRustProvisional(
+	ctx context.Context, cmd *exec.Cmd, retain func(*ProvisionalProcess) error,
+) (*ProvisionalProcess, error) {
+	return startProductRustProvisional(ctx, cmd, retain, openProductRustOwnerLibrary)
+}
+
+func startProductRustProvisional(
+	ctx context.Context, cmd *exec.Cmd, retain func(*ProvisionalProcess) error,
+	open func() (*rustOwnerLibrary, error),
+) (*ProvisionalProcess, error) {
+	if retain == nil || open == nil {
+		return nil, errors.New("Rust product provisional retention and library opener required")
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	child := &rustContainedChild{startContext: ctx, ownsLibrary: true}
+	p := &ProvisionalProcess{cmd: cmd, owner: child, waitDone: make(chan struct{})}
+	child.retain = func() error { return retain(p) }
+	startErr := startProductRustChild(child, open, func() error {
+		source, err := os.OpenFile(os.DevNull, os.O_RDWR, 0)
+		if err != nil {
+			return fmt.Errorf("Rust product NUL source: %w", err)
+		}
+		child.mu.Lock()
+		child.startupStdio = source
+		child.mu.Unlock()
+		// The existing IO boundary duplicates each alias independently. Only
+		// those copies are inherited, and native creation borrows them.
+		return child.start(cmd, source, source, source)
+	})
+	// Consume the factory's source before constructing the outer receipt.
+	// Terminal cleanup can also consume it; the same child caches either
+	// close result so a concurrent receiver cannot publish an early success.
+	startErr = errors.Join(startErr, child.closeStartupStdio())
+	if startErr == nil {
+		return p, nil
+	}
+	child.mu.Lock()
+	noChild := child.noChildKnown
+	child.mu.Unlock()
+	if noChild {
+		return p, p.closeStartupFailure("rust-pre-create", startErr)
+	}
+
+	view, identityErr := p.captureStartupIdentity()
+	var cleanupErr error
+	if child.containedCreated() && ctx.Err() == nil {
+		// Partial creation can precede identity admission. The original
+		// authority can still stop/wait/close without inventing that identity.
+		// Reuse the remaining admission deadline, never a second interval.
+		observed, err := p.terminateAndWaitObservedContext(ctx)
+		cleanupErr = err
+		view.StartupReleaseKnown = observed
+		view.StartupResourcesReleased = observed && err == nil
+		view.StartupReleaseError = err
+	}
+	view.Error = errors.Join(startErr, identityErr, cleanupErr)
+	return p, &creatorStartupError{owner: p, stage: "rust-post-create", cause: view.Error, observation: view}
+}
+
+// startProductRustChild admits the module for an already constructed facade.
+// The same child retains any partial module before returning a loader,
+// profile or command failure; native creation retains its preparing owner first.
+func startProductRustChild(
+	child *rustContainedChild, open func() (*rustOwnerLibrary, error), start func() error,
+) (retErr error) {
+	retain := child.retain
+	retained := false
+	child.retain = func() (err error) {
+		retained = true
+		defer func() {
+			if value := recover(); value != nil {
+				err = fmt.Errorf("Rust owner retention callback panicked: %v", value)
+			}
+		}()
+		return retain()
+	}
+	defer func() {
+		if !retained {
+			// Native entry follows child.retain. Publish only after the
+			// positive no-child fact and any partial module are installed.
+			child.mu.Lock()
+			child.noChildKnown = true
+			child.mu.Unlock()
+			retErr = errors.Join(retErr, child.retain())
+		}
+	}()
+
+	child.library, retErr = open()
+	child.libraryAcquired = child.library != nil && child.library.handle != 0
+	if retErr != nil {
+		return retErr
+	}
+	library := child.library
+	if library == nil {
+		return errors.New("Rust product loader returned no library")
+	}
+	if err := lockRustOwnerCreateContext(child.startContext, &library.mu); err != nil {
+		return err
+	}
+	complete := library.ready && !library.closeAttempted &&
+		runtimeidentity.IsWindowsProcessOwnerMemberExportProfileV1(library.identity.Exports) &&
+		rustOwnerMemberExportsPresent(library)
+	library.mu.Unlock()
+	if !complete {
+		return errors.New("Rust product process requires the complete admitted member export profile")
+	}
+	return start()
+}

+
+func TestForegroundConsoleAttachmentRefusesUnknownAbsence(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		count    uintptr
+		cause    error
+		attached bool
+		wantErr  bool
+	}{
+		{name: "one", count: 1, attached: true},
+		{name: "larger-than-buffer", count: 17, cause: windows.ERROR_ACCESS_DENIED, attached: true},
+		{name: "known-no-console", cause: windows.ERROR_INVALID_HANDLE},
+		{name: "access-error", cause: windows.ERROR_ACCESS_DENIED, wantErr: true},
+		{name: "zero-errno", cause: syscall.Errno(0), wantErr: true},
+		{name: "nil-error", wantErr: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := decodeForegroundConsoleAttachment(tc.count, tc.cause)
+			if got != tc.attached || (err != nil) != tc.wantErr {
+				t.Fatalf("console observation: attached=%t err=%v", got, err)
+			}
+			if tc.name == "access-error" && !errors.Is(err, tc.cause) {
+				t.Fatalf("native query error was replaced: %v", err)
+			}
+		})
+	}
+}
+
+func TestForegroundConsolePolicyKeepsNoConsoleAndOtherCreationFlags(t *testing.T) {
+	const invariant = windows.EXTENDED_STARTUPINFO_PRESENT | windows.CREATE_UNICODE_ENVIRONMENT
+	if got := startWithJobCreationFlags(); got != invariant|windows.CREATE_NO_WINDOW {
+		t.Fatalf("background/default original policy changed: %#x", got)
+	}
+	queryErr := errors.New("parent console query failed")
+	for _, tc := range []struct {
+		name       string
+		noConsole  bool
+		attached   bool
+		cause      error
+		wantQuery  bool
+		wantHidden bool
+	}{
+		{name: "attached", attached: true, wantQuery: true},
+		{name: "absent", wantQuery: true, wantHidden: true},
+		{name: "query-error", cause: queryErr, wantQuery: true},
+		{name: "explicit-no-console", noConsole: true, attached: true, cause: queryErr, wantHidden: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := &exec.Cmd{}
+			if tc.noConsole {
+				NoConsole(cmd)
+			}
+			calls := 0
+			flags, err := startWithJobForegroundCreationFlags(cmd, func() (bool, error) {
+				calls++
+				return tc.attached, tc.cause
+			})
+			wantCalls := 0
+			if tc.wantQuery {
+				wantCalls = 1
+			}
+			if calls != wantCalls {
+				t.Fatalf("console query calls=%d want=%d", calls, wantCalls)
+			}
+			if tc.wantQuery && tc.cause != nil {
+				if !errors.Is(err, queryErr) || flags != 0 {
+					t.Fatalf("query failure selected a creation policy: flags=%#x err=%v", flags, err)
+				}
+				return
+			}
+			want := uint32(invariant)
+			if tc.wantHidden {
+				want |= windows.CREATE_NO_WINDOW
+			}
+			if err != nil || flags != want {
+				t.Fatalf("foreground flags=%#x want=%#x err=%v", flags, want, err)
+			}
+		})
+	}
+}

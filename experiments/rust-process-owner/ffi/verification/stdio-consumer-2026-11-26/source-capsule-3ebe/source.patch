@@ -0,0 +1,239 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"syscall"
+	"testing"
+	"unsafe"
+)
+
+// The callback rejects every request without creating a native process.
+// These tests observe copied launch data, not executable-image qualification.
+func rustContainedAssertPathRequest(t *testing.T, cmd *exec.Cmd, wantProgram, wantDirectory string, beforeLoad func()) {
+	t.Helper()
+	beforePath, beforeDirectory := cmd.Path, cmd.Dir
+	beforeArgs, beforeEnv := slices.Clone(cmd.Args), slices.Clone(cmd.Env)
+	argsNil, envNil := cmd.Args == nil, cmd.Env == nil
+	wantArgs := slices.Clone(cmd.Args)
+	if len(wantArgs) == 0 {
+		wantArgs = []string{cmd.Path}
+	}
+	library, api, _ := rustProductFakeLibrary(t)
+	rejecting, probe := rustArgv0ABIRejectingLibrary(func(request *rustOwnerCreate, _ *rustOwnerIOContext, _ *uintptr, _ *rustOwnerOutcome) string {
+		if rustContainedWireText(request.Program) != wantProgram {
+			return "image did not use the original parent path semantics"
+		}
+		if rustContainedWireText(request.Cwd) != wantDirectory {
+			return "image resolution changed the child working directory"
+		}
+		if request.Argc != uintptr(len(wantArgs)) {
+			return "image materialization changed argument count"
+		}
+		for i, argument := range unsafe.Slice(request.Args, int(request.Argc)) {
+			if rustContainedWireText(argument) != wantArgs[i] {
+				return "image materialization rewrote argv"
+			}
+		}
+		return ""
+	})
+	library.procedures["mh_create_io1"] = rejecting.procedures["mh_create_io1"]
+	child := rustContainedWrapperFixture(t, context.Background(), cmd)
+	child.open = func() (*rustOwnerLibrary, error) {
+		if beforeLoad != nil {
+			beforeLoad()
+		}
+		return library, nil
+	}
+	files := rustStdioTestFiles(t)
+	err := child.start(cmd, files.Stdin, files.Stdout, files.Stderr)
+	if err == nil || probe.calls.Load() != 1 || probe.failure != "" || !child.containedNoChildKnown() {
+		t.Fatalf("path request: err=%v calls=%d failure=%q no-child=%t", err, probe.calls.Load(), probe.failure, child.containedNoChildKnown())
+	}
+	if cmd.Path != beforePath || cmd.Dir != beforeDirectory ||
+		!slices.Equal(cmd.Args, beforeArgs) || (cmd.Args == nil) != argsNil ||
+		!slices.Equal(cmd.Env, beforeEnv) || (cmd.Env == nil) != envNil ||
+		cmd.Process != nil || cmd.ProcessState != nil || cmd.Stdin != nil || cmd.Stdout != nil || cmd.Stderr != nil {
+		t.Fatal("path materialization mutated the caller command")
+	}
+	rustContainedAssertNoChildClose(t, child, nil)
+	if api.freeCalls != 1 {
+		t.Fatalf("refused path request module close calls=%d, want 1", api.freeCalls)
+	}
+}
+
+func TestProductRustContainedRelativeImageUsesParentCwd(t *testing.T) {
+	t.Chdir(t.TempDir())
+	parent, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	childDirectory, loaderDirectory := t.TempDir(), t.TempDir()
+	if err := os.Mkdir(filepath.Join(parent, "child-work"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, dir, wantDir string
+	}{
+		{name: "absolute-child-directory", dir: childDirectory, wantDir: childDirectory},
+		{name: "relative-child-directory", dir: "child-work", wantDir: filepath.Join(parent, "child-work")},
+		{name: "inherited-child-directory", wantDir: parent},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := rustOwnerCommandFixture()
+			cmd.Path, cmd.Dir = filepath.Join("image-parent", "tool.exe"), tc.dir
+			cmd.Args = []string{"caller-alias", "", "space value"}
+			wantProgram := filepath.Join(parent, "image-parent", "tool.exe")
+			if tc.dir != "" && wantProgram == filepath.Join(tc.wantDir, cmd.Path) {
+				t.Fatal("fixture did not distinguish parent cwd from child cwd")
+			}
+			rustContainedAssertPathRequest(t, cmd, wantProgram, tc.wantDir, func() {
+				// A resolver deferred until after admission would sample this
+				// different cwd and therefore select a different image.
+				t.Chdir(loaderDirectory)
+			})
+		})
+	}
+}
+
+func TestProductRustContainedImagePathForms(t *testing.T) {
+	t.Chdir(t.TempDir())
+	parent, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	childDirectory := t.TempDir()
+	drive := filepath.VolumeName(parent)
+	if len(drive) != 2 || drive[1] != ':' {
+		t.Fatal("path semantics fixture requires the runner's local drive")
+	}
+	otherDrive := "C:"
+	if strings.EqualFold(drive, otherDrive) {
+		otherDrive = "D:"
+	}
+	nativeAbsolute := func(path string) string {
+		t.Helper()
+		full, err := syscall.FullPath(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return filepath.Clean(full)
+	}
+	rootRelative := "\\synthetic\\tool.exe"
+	driveRelative := drive + "synthetic\\tool.exe"
+	otherDriveRelative := otherDrive + "synthetic\\tool.exe"
+	unc := "\\\\contained.invalid\\share\\tool.exe"
+	for _, tc := range []struct {
+		name, path, want string
+	}{
+		{name: "absolute-unchanged", path: filepath.Join(parent, "absolute.exe"), want: filepath.Join(parent, "absolute.exe")},
+		{name: "forward-slashes", path: "nested/dir/tool.exe", want: filepath.Join(parent, "nested", "dir", "tool.exe")},
+		{name: "no-extension-invented", path: "nested/tool", want: filepath.Join(parent, "nested", "tool")},
+		{name: "parent-segment", path: "..\\tool.exe", want: filepath.Join(filepath.Dir(parent), "tool.exe")},
+		{name: "root-relative-native", path: rootRelative, want: nativeAbsolute(rootRelative)},
+		{name: "same-drive-relative-native", path: driveRelative, want: nativeAbsolute(driveRelative)},
+		{name: "other-drive-relative-native", path: otherDriveRelative, want: nativeAbsolute(otherDriveRelative)},
+		{name: "unc-absolute-unchanged", path: unc, want: unc},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := rustOwnerCommandFixture()
+			cmd.Path, cmd.Dir = tc.path, childDirectory
+			cmd.Args = []string{"untouched-argv0", "--probe"}
+			rustContainedAssertPathRequest(t, cmd, tc.want, childDirectory, nil)
+		})
+	}
+}
+
+func TestProductRustContainedRelativeImagePreservesDefaultArgv(t *testing.T) {
+	t.Chdir(t.TempDir())
+	parent, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	childDirectory := t.TempDir()
+	for _, tc := range []struct {
+		name string
+		args []string
+	}{
+		{name: "nil-args"},
+		{name: "empty-args", args: []string{}},
+		{name: "explicit-empty-argv0", args: []string{""}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := rustOwnerCommandFixture()
+			cmd.Path, cmd.Dir, cmd.Args = ".\\nested\\tool.exe", childDirectory, tc.args
+			rustContainedAssertPathRequest(t, cmd, filepath.Join(parent, "nested", "tool.exe"), childDirectory, nil)
+		})
+	}
+}
+
+func TestProductRustContainedImageRefusalNeverLooksUp(t *testing.T) {
+	searchDirectory := t.TempDir()
+	if err := os.WriteFile(filepath.Join(searchDirectory, "search-target.exe"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	// An accidental PATH/PATHEXT search would find this ordinary file and
+	// reach the rejecting callback; its executable contents are never used.
+	t.Setenv("PATH", searchDirectory)
+	t.Setenv("PATHEXT", ".EXE")
+	for _, tc := range []struct {
+		name, path, dir string
+		lookupErr       error
+		wantOpens       int
+	}{
+		{name: "bare-leaf", path: "search-target"},
+		{name: "bare-leaf-with-extension", path: "search-target.exe"},
+		{name: "empty-image"},
+		{name: "invalid-utf8-relative-image", path: "nested\\\xfftool.exe"},
+		{name: "invalid-utf8-relative-directory", path: "D:\\owned\\child.exe", dir: "nested\\\xffwork"},
+		{name: "lookup-refusal-invalid-directory", path: "D:\\owned\\child.exe", dir: "nested\\work\x00", lookupErr: exec.ErrDot, wantOpens: 1},
+		{name: "lookup-refusal-relative", path: "nested\\tool.exe", lookupErr: exec.ErrDot, wantOpens: 1},
+		{name: "lookup-refusal-invalid-path", path: "nested\\tool\x00.exe", lookupErr: exec.ErrDot, wantOpens: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := rustOwnerCommandFixture()
+			cmd.Path, cmd.Err = tc.path, tc.lookupErr
+			if tc.dir != "" {
+				cmd.Dir = tc.dir
+			}
+			beforeDirectory := cmd.Dir
+			library, api, _ := rustProductFakeLibrary(t)
+			rejecting, probe := rustArgv0ABIRejectingLibrary(nil)
+			library.procedures["mh_create_io1"] = rejecting.procedures["mh_create_io1"]
+			child := rustContainedWrapperFixture(t, context.Background(), cmd)
+			opens := 0
+			child.open = func() (*rustOwnerLibrary, error) {
+				opens++
+				return library, nil
+			}
+			files := rustStdioTestFiles(t)
+			err := child.start(cmd, files.Stdin, files.Stdout, files.Stderr)
+			if err == nil || probe.calls.Load() != 0 || opens != tc.wantOpens || !child.containedNoChildKnown() {
+				t.Fatalf("invalid image/context admission: err=%v create-calls=%d loader-opens=%d, want error/0/%d; no-child=%t", err, probe.calls.Load(), opens, tc.wantOpens, child.containedNoChildKnown())
+			}
+			if tc.lookupErr != nil && !errors.Is(err, tc.lookupErr) {
+				t.Fatal("materialization replaced the original lookup refusal")
+			}
+			if cmd.Path != tc.path || cmd.Dir != beforeDirectory || cmd.Err != tc.lookupErr {
+				t.Fatal("path refusal mutated caller path or lookup error")
+			}
+			rustContainedAssertNoChildClose(t, child, nil)
+			if tc.wantOpens != 0 && api.freeCalls != 1 {
+				t.Fatalf("lookup refusal module close calls=%d, want 1", api.freeCalls)
+			}
+			if tc.wantOpens == 0 {
+				// The fake library was never handed to the adapter.
+				if err := library.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_contained_windows.go b/internal/process/rust_owner_contained_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..71b0716dc0a5c38552291c4fb20a771debb87ea7
--- /dev/null
+++ b/internal/process/rust_owner_contained_windows.go
@@ -0,0 +1,104 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+)
+
+// This bounds admission only. The contained runner owns the independent
+// operation context and the one absolute terminal cleanup deadline.
+const productRustContainedStartTimeout = 5 * time.Second
+
+type productRustContainedChild struct {
+	*rustContainedChild
+	context          context.Context
+	open             func() (*rustOwnerLibrary, error)
+	admissionStarted atomic.Bool
+}
+
+func newProductRustContainedChild(ctx context.Context, _ *exec.Cmd) (containedChild, error) {
+	if ctx == nil {
+		return nil, errors.New("Rust contained start context required")
+	}
+	return &productRustContainedChild{
+		rustContainedChild: &rustContainedChild{ownsLibrary: true, noChildKnown: true},
+		context:            ctx, open: openProductRustOwnerLibrary,
+	}, nil
+}
+
+func (c *productRustContainedChild) start(cmd *exec.Cmd, stdin containedInputFile, stdout, stderr containedWriteFile) error {
+	if c == nil || c.rustContainedChild == nil || c.context == nil || c.open == nil || cmd == nil {
+		return errors.New("Rust contained startup inputs required")
+	}
+	if !c.admissionStarted.CompareAndSwap(false, true) {
+		return errors.New("Rust contained admission already attempted")
+	}
+	admission, cancel := context.WithTimeout(c.context, productRustContainedStartTimeout)
+	defer cancel()
+	if err := creatorClosureContext(admission); err != nil {
+		return err
+	}
+	// Preserve exec.Cmd's lookup result and caller state. In particular an
+	// explicit empty environment must not turn into inherited environment.
+	prepared := *cmd
+	prepared.Args, prepared.Env = slices.Clone(cmd.Args), slices.Clone(cmd.Env)
+	var err error
+	if prepared.Err == nil {
+		// FullPath converts through Windows UTF-16. Reject malformed source
+		// bytes before normalization can replace an image or directory name.
+		if !utf8.ValidString(prepared.Path) || !utf8.ValidString(prepared.Dir) {
+			return errors.New("Rust contained command paths require valid UTF-8")
+		}
+		if !filepath.IsAbs(prepared.Path) {
+			// The legacy contained CreateProcess route resolves an explicit
+			// relative image from the parent cwd, independently of cmd.Dir.
+			// FullPath under filepath.Abs keeps native root/drive-relative
+			// semantics without PATH or executable-extension lookup.
+			if filepath.VolumeName(prepared.Path) == "" && !strings.ContainsAny(prepared.Path, "\\/") {
+				return errors.New("Rust contained image requires an absolute or explicit relative path")
+			}
+			if len(prepared.Args) == 0 {
+				// Keep the original default argv[0] while materializing only
+				// the copied executable image.
+				prepared.Args = []string{prepared.Path}
+			}
+			prepared.Path, err = filepath.Abs(prepared.Path)
+			if err != nil {
+				return err
+			}
+		}
+		if prepared.Dir == "" {
+			prepared.Dir, err = os.Getwd()
+		} else {
+			prepared.Dir, err = filepath.Abs(prepared.Dir)
+		}
+		if err != nil {
+			return err
+		}
+	}
+	child := c.rustContainedChild
+	child.startContext = admission
+	child.retain = func() error {
+		// The runner held this adapter before any resource acquisition. This
+		// validates that native publication stays in that same retained slot.
+		if c.rustContainedChild != child || !child.ownsLibrary ||
+			child.owner != nil && child.owner.library != child.library {
+			return errors.New("Rust contained original custody changed")
+		}
+		return nil
+	}
+	err = startProductRustChild(child, c.open, func() error {
+		return child.start(&prepared, stdin, stdout, stderr)
+	})
+	return errors.Join(err, admission.Err())
+}

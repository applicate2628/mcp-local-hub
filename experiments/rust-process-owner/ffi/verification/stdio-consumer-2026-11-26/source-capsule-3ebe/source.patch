+func TestRustOwnerCleanupFailureAppearsOnlyAfterBorrowDrain(t *testing.T) {
+	calls := 0
+	nativeClose := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		calls++
+		if raw != 0x7532 || out == nil || size != 48 {
+			return 1
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 3, PID: 74, Flags: 1,
+			RootExit: 9, CleanupMask: 1, CleanupCodes: [3]int32{5, 0, 0}}
+		return 0
+	})
+	owner := &rustNativeOwner{library: &rustOwnerLibrary{ready: true,
+		procedures: map[string]uintptr{"mh_wait1": rustOwnerExitedCallback(0x7532, 74, 9), "mh_close1": nativeClose}},
+		raw: 0x7532, memberGate: newOriginalMemberCustody()}
+	leave, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, err := owner.Finish(0)
+	var failed *rustOwnerCleanupFailure
+	if output.State != 0 || output.RootExit != 9 || errors.As(err, &failed) ||
+		!errors.Is(err, ErrOriginalMemberBorrowPending) || calls != 0 {
+		leave()
+		t.Fatalf("cleanup was attempted before query drain: result=%+v err=%v calls=%d", output, err, calls)
+	}
+	leave()
+	output, err = owner.Finish(0)
+	if output.State != 3 || output.RootExit != 9 || !errors.As(err, &failed) ||
+		failed.Mask != 1 || failed.Codes[0] != 5 || calls != 1 {
+		t.Fatalf("permitted native cleanup failure lost: result=%+v err=%v calls=%d", output, err, calls)
+	}
+}
+
+func rustOwnerExitedCallback(expectedRaw uintptr, pid, exit uint32) uintptr {
+	return syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerWaitOutcome, bytes uintptr) uintptr {
+		if raw != expectedRaw || out == nil || bytes != 32 || ms > 60000 {
+			return 1
+		}
+		*out = rustOwnerWaitOutcome{Size: 32, Version: 1, State: 2, Flags: 3, PID: pid, RootExit: exit}
+		return 0
+	})
+}

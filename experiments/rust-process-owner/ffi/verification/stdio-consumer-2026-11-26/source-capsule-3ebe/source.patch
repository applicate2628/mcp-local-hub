+	originalTestBarrier(t, filepath.Join(root, "root-ready"))
+	owner := stdioRustOriginalOwner(t, h)
+	stdioRustOriginalRPC(t, h, "last-native-reply")
+	stdioRustOriginalWait(t, "final reply child exit", h.ChildExited())
+	result := stdioRustOriginalComplete(t, h, owner)
+	if result.RootWait.ExitCode != 0 || result.RootWait.Error != nil {
+		t.Fatalf("final reply root result: %+v", result.RootWait)

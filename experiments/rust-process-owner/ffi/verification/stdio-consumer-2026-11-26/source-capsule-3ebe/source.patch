+func TestSerenaInterpreterLocatorRefusals(t *testing.T) {
+	root := t.TempDir()
+	file := filepath.Join(root, "python.exe")
+	if err := os.WriteFile(file, []byte("bounded"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	left, right := filepath.Join(root, "left"), filepath.Join(root, "right")
+	serenaInterpreterJunctionForTest(t, root, left, right)
+	serenaInterpreterJunctionForTest(t, root, right, left)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	canceled, stop := context.WithCancel(ctx)
+	stop()
+	for _, tc := range []struct {
+		name, path string
+		ctx        context.Context
+		limit      int64
+		cause      error
+		code       string
+		native     bool
+	}{
+		{name: "nil-context", path: file, limit: 1024, code: "SERENA_PREPARATION_INTERPRETER_LOCATOR_INVALID"},
+		{name: "canceled", path: file, ctx: canceled, limit: 1024, cause: context.Canceled},
+		{name: "missing", path: filepath.Join(root, "missing.exe"), ctx: ctx, limit: 1024, cause: os.ErrNotExist},
+		{name: "directory", path: root, ctx: ctx, limit: 1024, native: true},
+		{name: "oversized", path: file, ctx: ctx, limit: 1, code: "SERENA_PREPARED_FILE_SIZE_INVALID"},
+		{name: "zero-limit", path: file, ctx: ctx, code: "SERENA_PREPARATION_INTERPRETER_LOCATOR_INVALID"},
+		{name: "reparse-loop", path: filepath.Join(left, "python.exe"), ctx: ctx, limit: 1024, native: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			actual, err := qualifyPreparedSerenaInterpreter(tc.ctx, tc.path, tc.limit)
+			if err == nil || actual != (PreparedSerenaFile{}) {
+				t.Fatalf("refusal returned a qualified interpreter: %+v err=%v", actual, err)
+			}
+			if tc.cause != nil && !errors.Is(err, tc.cause) {
+				t.Fatalf("original cause lost: got=%v want=%v", err, tc.cause)
+			}
+			if tc.code != "" && !strings.Contains(err.Error(), tc.code) {
+				t.Fatalf("wrong refusal stage: %v", err)
+			}
+			var native syscall.Errno
+			if tc.native && !errors.As(err, &native) {
+				t.Fatalf("native open failure was replaced: %T %v", err, err)
+			}
+		})
+	}
+	if err := os.Rename(file, file+".closed"); err != nil {
+		t.Fatalf("failed qualification retained its original file handle: %v", err)
+	}
+}

+func foregroundConsoleRequirePE(t *testing.T, path string, subsystem uint16) {
+	t.Helper()
+	image, err := pe.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := image.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	header, ok := image.OptionalHeader.(*pe.OptionalHeader64)
+	if !ok || image.Machine != pe.IMAGE_FILE_MACHINE_AMD64 || header.Subsystem != subsystem {
+		t.Fatalf("fixture PE must be AMD64 subsystem %d, machine=%#x header=%+v", subsystem, image.Machine, image.OptionalHeader)
+	}
+}
+
+func foregroundConsoleReadReport(t *testing.T, path string) (foregroundConsoleReport, error) {
+	t.Helper()
+	var report foregroundConsoleReport
+	file, err := os.Open(path)
+	if err != nil {
+		t.Logf("child report %s unavailable: %v", path, err)
+		return report, err
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(file, 8193))
+	err = errors.Join(readErr, file.Close())
+	// Reports are also kept in a unique non-TempDir artifact directory below
+	// the private runner TEMP. Log the exact bounded bytes even on native FAIL.
+	t.Logf("child report %s: %s; read cause=%v", path, raw, err)
+	if err != nil || len(raw) > 8192 {
+		return report, errors.Join(err, errors.New("child report exceeds its bounded readable contract"))
+	}
+	err = json.Unmarshal(raw, &report)
+	return report, err
+}
+
+func foregroundConsoleAssertAssociation(t *testing.T, report foregroundConsoleReport, sharesParent bool) {
+	t.Helper()
+	call := report.Attachment
+	if !call.Attempted || !call.Completed || !call.OK || call.Code != 0 || call.Error != "" ||
+		call.Count == 0 || call.Count > 64 || call.Count != uint32(len(report.ConsolePIDs)) {
+		t.Errorf("child console process list is not a complete bounded native snapshot: %+v", report)
+		return
+	}
+	seen := make(map[uint32]bool, len(report.ConsolePIDs))
+	for _, pid := range report.ConsolePIDs {
+		if pid == 0 || seen[pid] {
+			t.Errorf("child console process list has a zero or duplicate PID: %v", report.ConsolePIDs)
+			return
+		}
+		seen[pid] = true
+	}
+	parent := windows.GetCurrentProcessId()
+	if !seen[report.PID] || report.PID == parent || seen[parent] != sharesParent {
+		t.Errorf("child console association does not match the original actor: child=%d parent=%d sharesParent=%t pids=%v",
+			report.PID, parent, sharesParent, report.ConsolePIDs)
+	}
+	window := report.Window
+	if !window.Attempted || !window.Completed || !window.OK || window.Code != 0 || window.Error != "" {
+		t.Errorf("child has no actual GetConsoleWindow result: %+v", report)
+	} else if !sharesParent && report.WindowHandle != 0 {
+		t.Errorf("CREATE_NO_WINDOW child acquired a console window: hwnd=%#x pids=%v", report.WindowHandle, report.ConsolePIDs)
+	}
+}

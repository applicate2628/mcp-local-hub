+func stdioRustOriginalFilesClosed(t *testing.T, h *StdioHost) {
+	t.Helper()
+	if h.original == nil {
+		t.Fatal("host file custody was not retained")
+	}
+	for i, owned := range h.original.files {
+		if owned == nil || owned.file == nil {
+			t.Fatalf("original host file slot %d is missing", i)
+		}
+		if fd := owned.file.Fd(); fd != ^uintptr(0) {
+			t.Fatalf("original host file slot %d still exposes a live descriptor: %#x", i, fd)
+		}
+		if _, err := owned.file.Stat(); !errors.Is(err, os.ErrClosed) && !errors.Is(err, windows.ERROR_INVALID_HANDLE) {
+			t.Fatalf("original host file slot %d is not actually closed: %v", i, err)
+		}
+	}
+}

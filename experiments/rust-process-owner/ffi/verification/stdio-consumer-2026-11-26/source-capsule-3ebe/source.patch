+//go:build windows && amd64
+
+package cli
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"mcp-local-hub/internal/api"
+	"mcp-local-hub/internal/api/apitest"
+	"mcp-local-hub/internal/buildinfo"
+	"mcp-local-hub/internal/process"
+)
+
+// This tuple gates qualification; it never selects the production loader.
+// The runner supplies the marked CLI test executable as mcphub.exe together
+// with its admitted adjacent DLL and receipt. The child keeps its original
+// qualified layout; copying only an executable is not a valid fixture.
+func productionRustOwnerChild(t *testing.T) string {
+	t.Helper()
+	names := [...]string{
+		"MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_COMMIT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_SHA256",
+		"MCPHUB_RUST_OWNER_MEMBER_CHILD",
+	}
+	var values [4]string
+	present := 0
+	for i, name := range names {
+		values[i] = os.Getenv(name)
+		if values[i] != "" {
+			present++
+		}
+	}
+	if present == 0 {
+		t.Skip("requires the qualified native tuple and marked mcphub.exe CLI test layout")
+	}
+	if present != len(values) {
+		t.Fatal("incomplete native supervisor qualification tuple")
+	}
+	for _, i := range []int{0, 3} {
+		if !filepath.IsAbs(values[i]) {
+			t.Fatalf("%s must name an absolute qualified file", names[i])
+		}
+		info, err := os.Lstat(values[i])
+		if err != nil || !info.Mode().IsRegular() {
+			t.Fatalf("%s is not an ordinary qualified file: %v", names[i], err)
+		}
+	}
+	hash, err := buildinfo.CurrentRustOwnerSHA256()
+	if err != nil || hash != values[2] {
+		t.Fatalf("CLI test executable lacks the expected embedded Rust hash: %v", err)
+	}
+	_, commit, _ := buildinfo.Get()
+	if commit != values[1] {
+		t.Fatal("CLI test executable commit differs from the qualification tuple")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !filepath.IsAbs(exe) || filepath.Base(exe) != "mcphub.exe" {
+		t.Fatal("native supervisor qualification requires the marked mcphub.exe CLI test executable")
+	}
+	library, err := os.ReadFile(filepath.Join(filepath.Dir(exe), "mcphub-owner.dll"))
+	if err != nil {
+		t.Fatalf("read adjacent native library: %v", err)
+	}
+	if actual := fmt.Sprintf("%x", sha256.Sum256(library)); actual != hash {
+		t.Fatal("adjacent native library differs from the CLI executable's embedded hash")
+	}
+	data, err := os.ReadFile(filepath.Join(filepath.Dir(exe), "mcphub-owner-identity.json"))
+	if err != nil {
+		t.Fatalf("read adjacent native identity: %v", err)
+	}
+	var receipt struct {
+		SourceCommit string `json:"sourceCommit"`
+		SHA256       string `json:"sha256"`
+	}
+	if err := json.Unmarshal(data, &receipt); err != nil {
+		t.Fatalf("decode adjacent native identity: %v", err)
+	}
+	if receipt.SourceCommit != commit || receipt.SHA256 != hash {
+		t.Fatal("adjacent native identity differs from the CLI executable's embedded operands")
+	}
+	return values[3]
+}
+
+type productionRustOwnerWorkers struct {
+	fixtureSpawnWorkers
+	startCalls int
+	process    *os.Process
+	creator    *process.ProvisionalProcess
+}
+
+func (f *productionRustOwnerWorkers) childStarted(p *os.Process, creator *process.ProvisionalProcess) {
+	// The factory calls this synchronously before either worker starts.
+	f.startCalls++
+	f.process, f.creator = p, creator
+	f.fixtureSpawnWorkers.childStarted(p, creator)
+}
+
+type productionRustOwnerFixture struct {
+	child   string
+	dir     string
+	events  *api.SupervisorEventLog
+	tracker *DaemonRuntimeTracker
+	records *daemonCreatorRecords
+	workers *productionRustOwnerWorkers
+	crashCh chan crashEvent
+	ctx     context.Context
+	cancel  context.CancelFunc
+	held    chan struct{}
+	release func()
+	spawn   SpawnFunc
+}
+
+func newProductionRustOwnerFixture(t *testing.T) *productionRustOwnerFixture {
+	t.Helper()
+	child := productionRustOwnerChild(t)
+	dir := apitest.HardenedTempDir(t)
+	events, err := api.OpenSupervisorEventLog(filepath.Join(dir, "events.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	f := &productionRustOwnerFixture{
+		child: child, dir: dir, events: events, tracker: NewDaemonRuntimeTracker(),
+		records: &daemonCreatorRecords{}, workers: &productionRustOwnerWorkers{},
+		crashCh: make(chan crashEvent), ctx: ctx, cancel: cancel, held: make(chan struct{}),
+	}
+	release := make(chan struct{})
+	var once sync.Once
+	f.release = func() { once.Do(func() { close(release) }) }
+	f.workers.beforeEmit = func() { close(f.held); <-release }
+	f.spawn = makeProductionSpawnFnWithCreatorRecords(events, f.tracker, "", nil, "", f.crashCh, ctx, nil, false, f.workers, f.records)
+	t.Cleanup(func() {
+		f.release()
+		settleFixtureSpawnWorkers(t, &f.workers.fixtureSpawnWorkers, cancel)
+		// A failed start may retain its owner before childStarted registers
+		// fixture workers. Settle that exact operation, never reopen its PID.
+		f.records.mu.Lock()
+		var pending []*process.ProvisionalProcess
+		for _, operation := range f.records.operations {
+			released := operation.startupReceipt && operation.startupDisposition.StartupReleaseKnown &&
+				operation.startupDisposition.StartupResourcesReleased
+			closed := operation.terminal != nil && operation.terminal.Closure() != nil
+			if operation.owner != nil && !released && !closed {
+				pending = append(pending, operation.owner)
+			}
+		}
+		f.records.mu.Unlock()
+		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cleanupCancel()
+		for _, owner := range pending {
+			result, err := owner.TerminateCreatorAndWait(cleanupCtx)
+			if err != nil || result == nil || result.Closure() == nil {
+				t.Errorf("retained supervisor fixture cleanup: result=%v err=%v", result, err)
+			}
+		}
+		if err := events.Close(); err != nil {
+			t.Errorf("close supervisor fixture log: %v", err)
+		}
+	})
+	return f
+}
+
+func (f *productionRustOwnerFixture) operation(t *testing.T) daemonCreatorOperation {
+	t.Helper()
+	f.records.mu.Lock()
+	defer f.records.mu.Unlock()
+	if len(f.records.operations) != 1 {
+		t.Fatalf("want one original operation, got %d", len(f.records.operations))
+	}
+	return *f.records.operations[0]
+}
+
+func TestProductionSpawnRustOwnerExitIdentityAndPublication(t *testing.T) {
+	for _, tc := range []struct {
+		mode   string
+		code   int
+		action string
+	}{
+		{mode: "identity", code: 0, action: "not-requested"},
+		{mode: "nul-stdio", code: 0, action: "not-requested"},
+		{mode: "detach-ready", code: 7, action: "request-succeeded"},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			f := newProductionRustOwnerFixture(t)
+			marker := filepath.Join(f.dir, "root")
+			descriptor := api.SupervisorDaemon{
+				TaskName: reconcileWiringTestTaskName, Server: "memory", Daemon: "default",
+				Command: f.child, Args: []string{tc.mode, marker}, WorkingDir: f.dir,
+			}
+			if err := f.spawn(descriptor); err != nil {
+				t.Fatalf("ordinary marked supervisor spawn: %v", err)
+			}
+			if f.workers.startCalls != 1 || f.workers.process != nil || f.workers.creator == nil {
+				t.Fatal("marked supervisor did not publish one native creator without a Go process")
+			}
+			select {
+			case <-f.held:
+			case event := <-f.crashCh:
+				t.Fatalf("exit escaped before the publication boundary: %+v", event)
+			case <-time.After(10 * time.Second):
+				t.Fatal("native waiter did not reach the post-closure publication boundary")
+			}
+			operation := f.operation(t)
+			if operation.owner != f.workers.creator || operation.starting || operation.startupErr != nil ||
+				operation.unsupported || operation.complete || operation.waiterDone ||
+				operation.rootErr != nil || operation.terminalErr != nil || operation.terminal == nil {
+				t.Fatalf("original operation changed or completed before publication: %+v", operation)
+			}
+			identity, err := operation.owner.Identity()
+			if err != nil || !identity.Known || identity.PID <= 0 || identity.NativeBirthFILETIME == 0 {
+				t.Fatalf("original cached native identity: %+v err=%v", identity, err)
+			}
+			startedAt, err := time.Parse(time.RFC3339Nano, identity.StartedAt)
+			if err != nil {
+				t.Fatal(err)
+			}
+			entry, ok := f.tracker.Get(descriptor.TaskName)
+			if !ok || entry.State != daemonRuntimeStateRunning || entry.CurrentPID != identity.PID ||
+				!entry.StartedAt.Equal(startedAt) || entry.PIDGeneration != operation.generation {
+				t.Fatalf("tracker retired early or lost the original identity: %+v", entry)
+			}
+			root := operation.root
+			if !root.Known || root.ExitCode != tc.code || root.RawExitError != nil ||
+				root.OriginalPID != identity.PID || root.OriginalStartedAt != identity.StartedAt {
+				t.Fatalf("native root wait fabricated or lost process state: %+v", root)
+			}
+			terminal := operation.terminal.Snapshot()
+			closure := operation.terminal.Closure()
+			if closure == nil || !terminal.HandlesClosed || !terminal.OriginalJobExited ||
+				terminal.CurrentMembersExited || terminal.Action != tc.action || terminal.Error != nil ||
+				terminal.Root != root || terminal.Native.InitialAccountingKnown || terminal.Native.FinalAccountingKnown {
+				t.Fatalf("publication preceded native closure or invented a legacy census: %+v", terminal)
+			}
+			proof := closure.Snapshot()
+			if !proof.DirectWaitComplete || !proof.HandlesClosed || !proof.OriginalJobExited ||
+				!proof.OriginalExitCodeKnown || proof.OriginalExitCode != tc.code ||
+				proof.OriginalPID != identity.PID || proof.OriginalStartedAt != identity.StartedAt {
+				t.Fatalf("closure differs from the same original root: %+v", proof)
+			}
+			// The native owner's cached receipt must survive observer retries.
+			retryCtx, retryCancel := context.WithTimeout(context.Background(), time.Second)
+			again, retryErr := operation.owner.CompleteCreatorAfterExit(retryCtx, true)
+			retryCancel()
+			if retryErr != nil || again != operation.terminal {
+				t.Fatalf("terminal retry replaced original evidence: result=%v err=%v", again, retryErr)
+			}
+			data, err := os.ReadFile(marker)
+			if err != nil {
+				t.Fatalf("read independently written child report: %v", err)
+			}
+			switch tc.mode {
+			case "identity":
+				if len(data) != 12 || int(binary.LittleEndian.Uint32(data[:4])) != identity.PID ||
+					binary.LittleEndian.Uint64(data[4:]) != identity.NativeBirthFILETIME {
+					t.Fatalf("native creation identity differs from the child's own process: %x", data)
+				}
+				birth := syscall.Filetime{LowDateTime: binary.LittleEndian.Uint32(data[4:8]), HighDateTime: binary.LittleEndian.Uint32(data[8:12])}
+				if !startedAt.Equal(time.Unix(0, birth.Nanoseconds()).UTC()) {
+					t.Fatal("tracker timestamp differs from the child's own Windows creation time")
+				}
+			case "nul-stdio":
+				const expected = "stdin_ok=1\nstdin_bytes=0\nstdin_error=0\nstdout_ok=1\nstdout_bytes=9\nstdout_error=0\nstderr_ok=1\nstderr_bytes=9\nstderr_error=0\n"
+				if string(data) != expected {
+					t.Fatalf("ordinary nil-stream semantics changed: %q", data)
+				}
+			case "detach-ready":
+				if string(data) != "root-ready" {
+					t.Fatalf("detached root did not report its child: %q", data)
+				}
+				grandchild, err := os.ReadFile(marker + ".grandchild")
+				if err != nil || string(grandchild) != "ready" {
+					t.Fatalf("descendant did not execute before root exit: %q err=%v", grandchild, err)
+				}
+			}
+			f.workers.mu.Lock()
+			pending := len(f.workers.children)
+			f.workers.mu.Unlock()
+			if pending != 0 {
+				t.Fatal("childWaited did not retire the same native creator from fixture accounting")
+			}
+			log, err := os.ReadFile(filepath.Join(f.dir, "events.log"))
+			if err != nil || strings.Contains(string(log), "\"event\":\"daemon-exited\"") ||
+				!strings.Contains(string(log), "\"event\":\"daemon-spawned\"") {
+				t.Fatalf("exit audit crossed the blocked publication boundary: %s err=%v", log, err)
+			}
+			f.release()
+			select {
+			case event := <-f.crashCh:
+				if event.Daemon.TaskName != descriptor.TaskName || event.PID != identity.PID ||
+					event.PIDGeneration != operation.generation || !event.StartedAt.Equal(startedAt) ||
+					event.ExitCode != tc.code || event.WaitErr != nil {
+					t.Fatalf("exit receiver lost the native identity or code: %+v", event)
+				}
+			case <-time.After(10 * time.Second):
+				t.Fatal("original exit was lost after publication release")
+			}
+			settleFixtureSpawnWorkers(t, &f.workers.fixtureSpawnWorkers, f.cancel)
+			finished := f.operation(t)
+			if !finished.complete || !finished.readinessDone || !finished.waiterDone ||
+				finished.owner != operation.owner || finished.terminal != operation.terminal {
+				t.Fatalf("original workers did not join after publication: %+v", finished)
+			}
+			entry, ok = f.tracker.Get(descriptor.TaskName)
+			if !ok || entry.CurrentPID != 0 || entry.State != daemonRuntimeStateIdle {
+				t.Fatalf("receiver did not retire the completed native generation: %+v", entry)
+			}
+		})
+	}
+}
+
+func TestProductionSpawnRustOwnerPreChildRefusalKeepsOperation(t *testing.T) {
+	f := newProductionRustOwnerFixture(t)
+	marker := filepath.Join(f.dir, "must-not-run")
+	descriptor := api.SupervisorDaemon{
+		TaskName: reconcileWiringTestTaskName, Server: "memory", Daemon: "default",
+		Command: f.child, Args: []string{"identity", marker, "invalid\x00argument"}, WorkingDir: f.dir,
+	}
+	spawnErr := f.spawn(descriptor)
+	if spawnErr == nil || !errors.Is(spawnErr, errSpawnPreChild) ||
+		!strings.Contains(spawnErr.Error(), "invalid Rust owner UTF-16 input") {
+		t.Fatalf("malformed marked command did not fail through the native pre-child path: %v", spawnErr)
+	}
+	operation := f.operation(t)
+	if operation.owner == nil || operation.starting || !errors.Is(operation.startupErr, spawnErr) ||
+		!operation.startupReceipt || !operation.startupDisposition.StartupReleaseKnown ||
+		!operation.startupDisposition.StartupResourcesReleased || operation.startupDisposition.Root.OriginalPID != 0 ||
+		operation.generation != 0 || operation.complete || operation.terminal != nil || f.workers.startCalls != 0 {
+		t.Fatalf("pre-child refusal lost its original retained operation: %+v", operation)
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("malformed command executed its child: %v", err)
+	}
+	select {
+	case event := <-f.crashCh:
+		t.Fatalf("pre-child refusal invented an exit: %+v", event)
+	case <-f.held:
+		t.Fatal("pre-child refusal entered normal exit publication")

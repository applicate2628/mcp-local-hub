@@ -0,0 +1,363 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+// These tests use synthetic loader/ABI callbacks and a real local NUL source.
+// They qualify the factory's Go custody and cleanup protocol, not a Rust DLL,
+// native process creation, or installed Product behavior.
+// The source really closes; an injected error then exercises failure caching.
+type rustProductProvisionalSource struct {
+	io.Closer
+	err   error
+	calls int
+}
+
+func (source *rustProductProvisionalSource) Close() error {
+	source.calls++
+	return errors.Join(source.Closer.Close(), source.err)
+}
+
+func TestProductRustProvisionalRetainsBeforeCreateAndClosesNoChildResources(t *testing.T) {
+	for _, scenario := range []string{"native-refusal", "retain-refusal", "source-close-failure"} {
+		t.Run(scenario, func(t *testing.T) {
+			library, api, _ := rustProductFakeLibrary(t)
+			cmd := rustOwnerCommandFixture()
+			cmd.Args = []string{"provisional-command", "--retained", ""}
+			rejecting, probe := rustArgv0ABIRejectingLibrary(func(request *rustOwnerCreate, _ *rustOwnerIOContext, _ *uintptr, _ *rustOwnerOutcome) string {
+				if request.Argc != uintptr(len(cmd.Args)) || request.Args == nil {
+					return "provisional v2 argument count changed"
+				}
+				views := unsafe.Slice(request.Args, int(request.Argc))
+				for i, arg := range cmd.Args {
+					units, _ := syscall.UTF16FromString(arg)
+					if !rustIOABIViewMatches(views[i], units) {
+						return "provisional v2 argv changed or lost its explicit empty argument"
+					}
+				}
+				program, _ := syscall.UTF16FromString(cmd.Path)
+				if !rustIOABIViewMatches(request.Program, program) {
+					return "provisional argv zero replaced the executable image"
+				}
+				return ""
+			})
+			library.procedures["mh_create_io1"] = rejecting.procedures["mh_create_io1"]
+			refusal := errors.New("provisional receiver refused")
+			var closeErr error
+			if scenario == "source-close-failure" {
+				closeErr = errors.New("injected NUL source close failure")
+			}
+			var retained *ProvisionalProcess
+			var owner *rustNativeOwner
+			var source *os.File
+			var sourceClose *rustProductProvisionalSource
+			retains := 0
+			p, err := startProductRustProvisional(rustStdioTestContext(t), cmd,
+				func(p *ProvisionalProcess) error {
+					retained, retains = p, retains+1
+					child, ok := p.owner.(*rustContainedChild)
+					if !ok || child.library != library || !child.ownsLibrary || child.owner == nil ||
+						child.owner.raw != 0 || !child.owner.preparing.Load() || probe.calls.Load() != 0 {
+						return errors.New("retained provisional lacks its preparing original owner")
+					}
+					owner = child.owner
+					child.mu.Lock()
+					source, ok = child.startupStdio.(*os.File)
+					if ok {
+						sourceClose = &rustProductProvisionalSource{Closer: source, err: closeErr}
+						child.startupStdio = sourceClose
+					}
+					child.mu.Unlock()
+					if !ok || source == nil {
+						return errors.New("retained provisional lacks its owned NUL source")
+					}
+					if err := library.Close(); err == nil {
+						return errors.New("retention allowed module unload before native entry")
+					}
+					if scenario == "retain-refusal" {
+						return refusal
+					}
+					return nil
+				}, func() (*rustOwnerLibrary, error) { return library, nil })
+			var startup *creatorStartupError
+			if p == nil || p != retained || retains != 1 || !errors.As(err, &startup) ||
+				startup.owner != p || startup.stage != "rust-pre-create" || owner == nil || sourceClose == nil {
+				t.Fatalf("no-child factory lost retained receipt: p=%p retained=%p retains=%d err=%v",
+					p, retained, retains, err)
+			}
+			wantCreates := int32(1)
+			if scenario == "retain-refusal" {
+				wantCreates = 0
+				if !errors.Is(err, refusal) {
+					t.Fatalf("retention cause lost: %v", err)
+				}
+			}
+			child := p.owner.(*rustContainedChild)
+			view := startup.Snapshot()
+			if child.owner != owner || !child.noChildKnown || p.originalProcessCreated() ||
+				p.job != nil || p.cmd.Process != nil || probe.calls.Load() != wantCreates || probe.failure != "" ||
+				!view.StartupReleaseKnown || view.StartupResourcesReleased != (closeErr == nil) ||
+				!errors.Is(view.StartupReleaseError, closeErr) || (closeErr != nil && !errors.Is(err, closeErr)) {
+				t.Fatalf("no-child cleanup receipt: view=%+v err=%v creates=%d probe=%q",
+					view, err, probe.calls.Load(), probe.failure)
+			}
+			for i := 0; i < 2; i++ {
+				if err := p.close(); !errors.Is(err, closeErr) {
+					t.Fatalf("cached provisional close %d: got=%v want=%v", i, err, closeErr)
+				}
+				if err := child.closeStartupStdio(); !errors.Is(err, closeErr) {
+					t.Fatalf("cached source close %d: got=%v want=%v", i, err, closeErr)
+				}
+			}
+			var probeByte [1]byte
+			if _, err := source.Read(probeByte[:]); !errors.Is(err, os.ErrClosed) {
+				t.Fatalf("closed factory source did not refuse read with os.ErrClosed: %v", err)
+			}
+			if sourceClose.calls != 1 || child.startupStdio != nil || owner.raw != 0 ||
+				library.activeOwners.Load() != 0 || library.ready || library.handle != 0 ||
+				api.freeCalls != 1 || api.freedHandle != api.loadHandle {
+				t.Fatalf("no-child resources not consumed exactly once: source=%d raw=%x owners=%d ready=%t frees=%d",
+					sourceClose.calls, owner.raw, library.activeOwners.Load(), library.ready, api.freeCalls)
+			}
+		})
+	}
+}
+
+func TestProductRustProvisionalLoaderFailureKeepsOriginalReceipt(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		name := "missing"
+		if partial {
+			name = "partial-module-close-failure"
+		}
+		t.Run(name, func(t *testing.T) {
+			layout := newRustOwnerMemberTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			loadErr := errors.New("module lock refused")
+			var closeErr error
+			api.lockErr = loadErr
+			if partial {
+				closeErr = errors.New("partial module unload failed")
+				api.lockErr, api.freeErr = nil, closeErr
+				api.modulePath = layout.library + ".different"
+			}
+			var library *rustOwnerLibrary
+			var retained *ProvisionalProcess
+			retains, opens := 0, 0
+			p, err := startProductRustProvisional(rustStdioTestContext(t), rustOwnerCommandFixture(),
+				func(p *ProvisionalProcess) error { retained = p; retains++; return nil },
+				func() (*rustOwnerLibrary, error) {
+					opens++
+					var err error
+					library, err, _ = openFakeRustOwner(t, layout, api)
+					return library, err
+				})
+			var startup *creatorStartupError
+			if p == nil || p != retained || retains != 1 || opens != 1 ||
+				!errors.As(err, &startup) || startup.owner != p || startup.stage != "rust-pre-create" {
+				t.Fatalf("loader refusal lost original receipt: p=%p retained=%p retains=%d opens=%d err=%v",
+					p, retained, retains, opens, err)
+			}
+			child := p.owner.(*rustContainedChild)
+			view := startup.Snapshot()
+			if child.library != library || child.owner != nil || child.startupStdio != nil ||
+				!child.noChildKnown || p.originalProcessCreated() || !view.StartupReleaseKnown ||
+				view.StartupResourcesReleased != !partial || !errors.Is(view.StartupReleaseError, closeErr) {
+				t.Fatalf("loader refusal invented creation or successful cleanup: view=%+v child=%+v", view, child)
+			}
+			if (!partial && !errors.Is(err, loadErr)) || (partial && !errors.Is(err, closeErr)) {
+				t.Fatalf("loader cause lost: %v", err)
+			}
+			for i := 0; i < 2; i++ {
+				if err := p.close(); !errors.Is(err, closeErr) {
+					t.Fatalf("cached loader close %d: got=%v want=%v", i, err, closeErr)
+				}
+			}
+			wantFrees := 0
+			if partial {
+				wantFrees = 1
+				if library == nil || library.handle != api.loadHandle || !child.ownsLibrary {
+					t.Fatal("failed module unload erased partial module custody")
+				}
+			}
+			if api.freeCalls != wantFrees {
+				t.Fatalf("loader close replayed: frees=%d want=%d", api.freeCalls, wantFrees)
+			}
+		})
+	}
+}
+
+type rustProductProvisionalABI struct {
+	owner                                   *rustNativeOwner
+	deadline                                time.Time
+	afterCreate                             func()
+	creates, stops, waits, closes, releases atomic.Int32
+}
+
+func newRustProductProvisionalABI(t *testing.T) (*rustProductProvisionalABI, *rustOwnerLibrary, *fakeRustOwnerLibraryAPI) {
+	t.Helper()
+	library, api, _ := rustProductFakeLibrary(t)
+	f := &rustProductProvisionalABI{}
+	const slotValue = uintptr(0x4141) // Synthetic allocation, never an OS handle.
+	checkTerminal := func(raw uintptr) {
+		if f.owner == nil || raw != slotValue || f.owner.raw != slotValue {
+			t.Errorf("terminal call replaced original allocation: owner=%p raw=%x", f.owner, raw)
+			return
+		}
+		gate := f.owner.memberGate
+		gate.mu.Lock()
+		defer gate.mu.Unlock()
+		if !gate.sealed || !gate.terminalActive || !gate.terminalBound ||
+			!gate.terminalDeadline.Equal(f.deadline) || gate.entered != 0 || gate.active != nil {
+			t.Errorf("terminal call lost original permit/deadline: bound=%t got=%v want=%v",
+				gate.terminalBound, gate.terminalDeadline, f.deadline)
+		}
+	}
+	library.procedures["mh_create_io1"] = syscall.NewCallback(func(
+		request *rustOwnerCreate, requestBytes uintptr, streams *rustOwnerIOContext, streamsBytes uintptr,
+		slot *uintptr, out *rustOwnerOutcome, outBytes uintptr,
+	) uintptr {
+		f.creates.Add(1)
+		if f.owner == nil || f.owner.raw != 0 || !f.owner.preparing.Load() {
+			t.Error("creation entered without the retained preparing owner")
+		}
+		*slot = slotValue
+		*out = rustOwnerOutcome{Size: 47, Version: 1} // Custody exists; diagnostic is malformed.
+		if f.afterCreate != nil {
+			f.afterCreate()
+		}
+		return 0
+	})
+	library.procedures["mh_stop1"] = syscall.NewCallback(func(raw, code uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		f.stops.Add(1)
+		checkTerminal(raw)
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		return 0
+	})
+	library.procedures["mh_wait1"] = syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerWaitOutcome, size uintptr) uintptr {
+		f.waits.Add(1)
+		if raw != slotValue {
+			t.Errorf("wait replaced original allocation: raw=%x", raw)
+		}
+		*out = rustOwnerWaitOutcome{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+		return 0
+	})
+	library.procedures["mh_close1"] = syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		f.closes.Add(1)
+		checkTerminal(raw)
+		if !f.owner.cachedRootWait().Known {
+			t.Error("native close preceded original root wait")
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+		return 0
+	})
+	library.procedures["mh_release1"] = syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		f.releases.Add(1)
+		checkTerminal(*slot)
+		*slot = 0
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+		return 0
+	})
+	library.api = &rustProductModuleAPI{fakeRustOwnerLibraryAPI: api, beforeFree: func() {
+		if f.owner == nil || f.owner.raw != 0 || library.activeOwners.Load() != 0 ||
+			f.closes.Load() != 1 || f.releases.Load() != 1 {
+			t.Error("Product module unload preceded original allocation release")
+		}
+	}}
+	return f, library, api
+}
+
+func TestProductRustProvisionalPartialCreateCleanupUsesAdmissionDeadline(t *testing.T) {
+	f, library, api := newRustProductProvisionalABI(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	f.deadline, _ = ctx.Deadline()
+	var retained *ProvisionalProcess
+	retains := 0
+	p, err := startProductRustProvisional(ctx, rustOwnerCommandFixture(),
+		func(p *ProvisionalProcess) error {
+			retained, retains = p, retains+1
+			f.owner = p.owner.(*rustContainedChild).owner
+			return nil
+		}, func() (*rustOwnerLibrary, error) { return library, nil })
+	var startup *creatorStartupError
+	if p == nil || p != retained || retains != 1 || !errors.Is(err, errRustOwnerOutcome) ||
+		!errors.As(err, &startup) || startup.owner != p || startup.stage != "rust-post-create" {
+		t.Fatalf("partial creation lost original receipt: p=%p retained=%p retains=%d err=%v", p, retained, retains, err)
+	}
+	child := p.owner.(*rustContainedChild)
+	view := startup.Snapshot()
+	if child.owner != f.owner || !p.originalProcessCreated() || child.noChildKnown || p.job != nil ||
+		p.cmd.Process != nil || view.Root.Known || view.Root.OriginalPID != 0 ||
+		!view.StartupReleaseKnown || !view.StartupResourcesReleased || view.StartupReleaseError != nil {
+		t.Fatalf("partial creation invented identity or lost cleanup: view=%+v child=%+v", view, child)
+	}
+	for i := 0; i < 2; i++ {
+		if err := p.close(); err != nil {
+			t.Fatalf("cached partial creation close %d: %v", i, err)
+		}
+	}
+	if f.owner.raw != 0 || library.activeOwners.Load() != 0 || library.ready || api.freeCalls != 1 ||
+		f.creates.Load() != 1 || f.stops.Load() != 1 || f.waits.Load() == 0 ||
+		f.closes.Load() != 1 || f.releases.Load() != 1 {
+		t.Fatalf("partial creation cleanup repeated or lost ownership: raw=%x owners=%d frees=%d calls=%d/%d/%d/%d/%d",
+			f.owner.raw, library.activeOwners.Load(), api.freeCalls, f.creates.Load(), f.stops.Load(),
+			f.waits.Load(), f.closes.Load(), f.releases.Load())
+	}
+}
+
+func TestProductRustProvisionalCancelledCreatePreservesOriginalCustody(t *testing.T) {
+	f, library, api := newRustProductProvisionalABI(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	f.deadline, _ = ctx.Deadline()
+	f.afterCreate = cancel
+	var retained *ProvisionalProcess
+	p, err := startProductRustProvisional(ctx, rustOwnerCommandFixture(),
+		func(p *ProvisionalProcess) error {
+			retained = p
+			f.owner = p.owner.(*rustContainedChild).owner
+			return nil
+		}, func() (*rustOwnerLibrary, error) { return library, nil })
+	var startup *creatorStartupError
+	if p == nil || p != retained || !errors.Is(err, context.Canceled) || !errors.Is(err, errRustOwnerOutcome) ||
+		!errors.As(err, &startup) || startup.owner != p || startup.stage != "rust-post-create" {
+		t.Fatalf("late cancellation replaced original receipt: p=%p retained=%p err=%v", p, retained, err)
+	}
+	child := p.owner.(*rustContainedChild)
+	view := startup.Snapshot()
+	if child.owner != f.owner || f.owner.raw != 0x4141 || !p.originalProcessCreated() || child.noChildKnown ||
+		child.startupStdio != nil || child.closeReturned || p.closeAttempted || library.activeOwners.Load() != 1 ||
+		!library.ready || view.StartupReleaseKnown || view.StartupResourcesReleased || view.StartupReleaseError != nil ||
+		f.creates.Load() != 1 || f.stops.Load() != 0 || f.waits.Load() != 0 ||
+		f.closes.Load() != 0 || f.releases.Load() != 0 || api.freeCalls != 0 {
+		t.Fatalf("cancelled creation opened a fresh cleanup interval: view=%+v raw=%x calls=%d/%d/%d/%d/%d frees=%d",
+			view, f.owner.raw, f.creates.Load(), f.stops.Load(), f.waits.Load(), f.closes.Load(), f.releases.Load(), api.freeCalls)
+	}
+	if err := library.Close(); err == nil || api.freeCalls != 0 {
+		t.Fatal("cancelled creation allowed its retained module to unload")
+	}
+	// A later receiver explicitly supplies another context. The factory itself
+	// must have made no terminal attempt on behalf of the cancelled admission.
+	cleanupCtx := rustStdioTestContext(t)
+	f.deadline, _ = cleanupCtx.Deadline()
+	observed, cleanupErr := p.terminateAndWaitObservedContext(cleanupCtx)
+	if cleanupErr != nil || !observed || f.owner.raw != 0 || api.freeCalls != 1 ||
+		f.stops.Load() != 1 || f.closes.Load() != 1 || f.releases.Load() != 1 {
+		t.Fatalf("receiver could not settle the same partial owner: observed=%t err=%v raw=%x frees=%d",
+			observed, cleanupErr, f.owner.raw, api.freeCalls)
+	}
+	if startup.Snapshot().StartupReleaseKnown || startup.Snapshot().StartupResourcesReleased {
+		t.Fatal("later receiver cleanup rewrote the original startup receipt")
+	}
+}

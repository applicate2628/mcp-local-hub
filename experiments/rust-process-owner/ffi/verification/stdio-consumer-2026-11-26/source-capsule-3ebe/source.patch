+use super::super::native_failure_tests::{
+    denied, duplicate_with_access, handle_count, restrict, stop_and_finish, suspended,
+};
+use super::*;
+use crate::Settlement;
+use std::{
+    fs,
+    path::Path,
+    sync::atomic::{AtomicU64, Ordering},
+    thread,
+    time::Duration,
+};
+use windows_sys::Win32::{
+    Foundation::{
+        GetHandleInformation, SetHandleInformation, FILETIME, HANDLE, HANDLE_FLAG_INHERIT,
+        HANDLE_FLAG_PROTECT_FROM_CLOSE,
+    },
+    System::Threading::{GetProcessId, GetProcessTimes},
+};
+
+const WAIT: Duration = Duration::from_secs(3);
+static NEXT_FIXTURE: AtomicU64 = AtomicU64::new(1);
+
+fn observation_error(error: JobMemberQueryError) -> io::Error {
+    match error {
+        JobMemberQueryError::Observation(error) => error,
+        JobMemberQueryError::TokenUser(error) => panic!("unexpected token-user failure: {error}"),
+    }
+}
+
+// These bytes exercise parser bounds only. They are never published as a
+// successful native observation or used to construct an owned process handle.
+fn pid_bytes(assigned: u32, listed: u32, pids: &[usize]) -> Vec<u8> {
+    let mut bytes = vec![0; PID_LIST_HEADER_BYTES];
+    bytes[..4].copy_from_slice(&assigned.to_ne_bytes());
+    bytes[4..8].copy_from_slice(&listed.to_ne_bytes());
+    for pid in pids {
+        bytes.extend_from_slice(&pid.to_ne_bytes());
+    }
+    bytes
+}
+
+#[test]
+fn job_member_pid_parser_accepts_only_complete_bounded_sets() {
+    let bytes = pid_bytes(3, 3, &[41, 7, 23]);
+    assert_eq!(
+        parse_job_process_ids(&bytes, bytes.len()).unwrap(),
+        Some(vec![7, 23, 41])
+    );
+    let partial = pid_bytes(3, 1, &[41]);
+    assert_eq!(
+        parse_job_process_ids(&partial, partial.len()).unwrap(),
+        None
+    );
+    let empty = pid_bytes(0, 0, &[]);
+    assert_eq!(
+        parse_job_process_ids(&empty, empty.len()).unwrap(),
+        Some(Vec::new())
+    );
+}
+
+#[test]
+fn job_member_pid_parser_rejects_truncated_inconsistent_and_invalid_entries() {
+    let valid = pid_bytes(1, 1, &[7]);
+    assert!(parse_job_process_ids(&valid, PID_LIST_HEADER_BYTES - 1).is_err());
+    assert!(parse_job_process_ids(&valid, valid.len() + 1).is_err());
+    let malformed = vec![
+        pid_bytes(1, 2, &[7, 11]),
+        pid_bytes(2, 2, &[7]),
+        pid_bytes(3, 2, &[7]),
+        pid_bytes(u32::MAX, u32::MAX, &[]),
+        pid_bytes(1, 1, &[0]),
+        pid_bytes(2, 2, &[7, 7]),
+    ];
+    for bytes in malformed {
+        assert!(parse_job_process_ids(&bytes, bytes.len()).is_err());
+    }
+    #[cfg(target_pointer_width = "64")]
+    {
+        let wide = pid_bytes(1, 1, &[(u32::MAX as usize) + 1]);
+        assert!(parse_job_process_ids(&wide, wide.len()).is_err());
+    }
+}
+
+#[test]
+fn job_member_native_acquisition_errors_keep_partial_state_until_explicit_close() {
+    for deny_job_query in [true, false] {
+        let mut owner = suspended();
+        let original = if deny_job_query {
+            restrict(&mut owner.job, 0x0008) // JOB_OBJECT_TERMINATE, without QUERY.
+        } else {
+            restrict(&mut owner.process, PROCESS_QUERY_LIMITED_INFORMATION)
+        };
+        let failure = owner
+            .observe_job_members(Instant::now() + WAIT)
+            .unwrap_err();
+        denied(&observation_error(failure));
+        let partial = owner.job_member_snapshot().unwrap().clone();
+        assert!(!partial.complete);
+        assert_ne!(partial.generation, 0);
+        assert!(partial.rows.is_empty() && partial.post.is_none());
+        if deny_job_query {
+            assert!(partial.pre.is_none() && partial.resources.is_empty());
+        } else {
+            assert_eq!(partial.pre.as_ref().unwrap().pids, vec![owner.root_pid()]);
+            assert_eq!(partial.resources.len(), 1);
+            assert!(partial.resources[0].borrowed_original);
+        }
+        assert_eq!(
+            owner.terminate(91).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert!(owner.termination.is_none() && !owner.admission_attempted);
+        if deny_job_query {
+            drop(owner.job.replace(original));
+        } else {
+            drop(owner.process.replace(original));
+        }
+        let closed = owner.close_job_members(partial.generation).unwrap().clone();
+        assert!(closed.complete);
+        assert!(closed
+            .resources
+            .iter()
+            .all(|resource| !resource.close_attempted
+                && !resource.closed
+                && resource.close_error.is_none()));
+        assert!(!owner.job_member_snapshot().unwrap().complete);
+        assert_eq!(
+            owner.close_job_members(partial.generation).unwrap(),
+            &closed
+        );
+        assert_eq!(owner.wait_root(Duration::ZERO).unwrap(), None);
+        stop_and_finish(&mut owner);
+    }
+}
+
+#[test]
+fn job_member_generation_overflow_preserves_prior_closed_observation() {
+    let mut owner = suspended();
+    let generation = owner.observe_job_members(Instant::now() + WAIT).unwrap();
+    let closed = owner.close_job_members(generation).unwrap().clone();
+    let baseline = owner.job_member_snapshot().unwrap().clone();
+    owner.member_generation = u64::MAX;
+    assert!(matches!(
+        owner.observe_job_members(Instant::now() + WAIT),
+        Err(JobMemberQueryError::Observation(_))
+    ));
+    assert_eq!(owner.member_generation, u64::MAX);
+    assert!(
+        owner.job_member_snapshot().unwrap() == &baseline,
+        "generation exhaustion replaced the acquired facts"
+    );
+    assert_eq!(owner.close_job_members(generation).unwrap(), &closed);
+    assert!(!owner.admission_attempted && owner.termination.is_none());
+    stop_and_finish(&mut owner);
+}
+
+// Existing compiled fixture only: the runner must provide the matching-profile
+// owner_child.exe path explicitly. Absence is a failure, never a skipped test.
+fn member_tree(two_descendants: bool) -> NativeOwner {
+    let executable = PathBuf::from(
+        std::env::var_os("MCPHUB_RX02_OWNER_CHILD").expect("compiled owner_child fixture path"),
+    );
+    assert!(
+        executable.is_absolute() && executable.is_file(),
+        "owner_child fixture is missing"
+    );
+    let root = PathBuf::from(std::env::var_os("MCPHUB_RX02_FIXTURES").expect("owned fixture root"))
+        .join(format!(
+            "native-member-faults-{}-{}",
+            std::process::id(),
+            NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed),
+        ));
+    fs::create_dir(&root).unwrap();
+    let marker = root.join("member marker.txt");
+    let mode = if two_descendants { "tree-two" } else { "tree" };
+    let mut owner =
+        NativeOwner::create_suspended(&executable, &[mode.into(), marker.clone().into_os_string()])
+            .unwrap();
+    owner.admit_and_resume(|_| Ok(())).unwrap();
+    let deadline = Instant::now() + WAIT;
+    wait_marker(&marker, deadline);
+    if two_descendants {
+        wait_marker(&marker.with_extension("grandchild-0"), deadline);
+        wait_marker(&marker.with_extension("grandchild-1"), deadline);
+    } else {
+        wait_marker(&marker.with_extension("grandchild"), deadline);
+    }
+    let expected = if two_descendants { 3 } else { 2 };
+    while owner.active_processes().unwrap() != expected {
+        assert!(
+            Instant::now() < deadline,
+            "owned fixture Job did not reach its member count: expected {expected}, actual {}",
+            owner.active_processes().unwrap()
+        );
+        thread::sleep(Duration::from_millis(2));
+    }
+    owner
+}
+
+// A separate legacy-only control on the qualified Windows host observed a
+// first-setup handle-count increase of three, then an exact plateau over two
+// further rounds. The precise cause is not established. Warm only that
+// old create/wait/close path here, never the member API under test, so each test
+// also works in isolation. Its measured round must still return exactly to this
+// baseline; per-close deltas and repeated-close checks remain strict.
+fn member_handle_baseline() -> u32 {
+    let mut owner = member_tree(true);
+    stop_and_finish(&mut owner);
+    drop(owner);
+    handle_count()
+}
+
+// Fixture directories are retained for evidence and later trash-first handling.
+fn wait_marker(path: &Path, deadline: Instant) {
+    while !path.exists() {
+        assert!(
+            Instant::now() < deadline,
+            "owned member fixture did not publish readiness"
+        );
+        thread::sleep(Duration::from_millis(2));
+    }
+}
+
+// Advance only the real production acquisition stages and stop immediately
+// after an actual descendant OpenProcess has entered the retained owner.
+// No synthetic census, row or complete flag is installed by this fixture.
+fn retain_first_descendant(owner: &mut NativeOwner, deadline: Instant) -> usize {
+    loop {
+        let index = owner.retain_next_job_member(deadline).unwrap();
+        if matches!(
+            &owner.member_observation.as_ref().unwrap().held[index],
+            HeldMember::Owned(_)
+        ) {
+            return index;
+        }
+        owner.capture_retained_job_member(index, deadline).unwrap();
+    }
+}
+
+fn descendant_handle(owner: &NativeOwner, index: usize) -> &OwnedHandle {
+    match &owner.member_observation.as_ref().unwrap().held[index] {
+        HeldMember::Owned(handle) => handle,
+        HeldMember::Original => panic!("expected a real descendant handle"),
+    }
+}
+
+fn replace_descendant_handle(
+    owner: &mut NativeOwner,
+    index: usize,
+    handle: OwnedHandle,
+) -> OwnedHandle {
+    match &mut owner.member_observation.as_mut().unwrap().held[index] {
+        HeldMember::Owned(slot) => std::mem::replace(slot, handle),
+        HeldMember::Original => panic!("cannot replace the borrowed original root"),
+    }
+}
+
+#[test]
+fn job_member_partial_owned_capture_failure_keeps_the_real_descendant_until_close() {
+    let before = member_handle_baseline();
+    let mut owner = member_tree(false);
+    let deadline = Instant::now() + WAIT;
+    let generation = owner.begin_job_members(deadline).unwrap();
+    let index = retain_first_descendant(&mut owner, deadline);
+    let pid = owner.job_member_snapshot().unwrap().resources[index].pid;
+    let acquired = descendant_handle(&owner, index).as_raw_handle();
+    // SAFETY: this is the actual OpenProcess result retained by production.
+    assert_eq!(unsafe { GetProcessId(acquired) }, pid);
+    let restricted = duplicate_with_access(descendant_handle(&owner, index), PROCESS_SYNCHRONIZE);
+    let original = replace_descendant_handle(&mut owner, index, restricted);
+    let failure = owner
+        .capture_retained_job_member(index, deadline)
+        .unwrap_err();
+    denied(&observation_error(failure));
+    let partial = owner.job_member_snapshot().unwrap().clone();
+    assert!(!partial.complete && partial.post.is_none());
+    assert_eq!(partial.rows.len(), index);
+    assert_eq!(partial.resources.len(), index + 1);
+    assert_eq!(
+        owner.member_observation.as_ref().unwrap().held.len(),
+        index + 1
+    );
+    let resource = &partial.resources[index];
+    assert_eq!(resource.pid, pid);
+    assert!(!resource.borrowed_original);
+    assert!(!resource.close_attempted && !resource.closed && resource.close_error.is_none());
+    let mut flags = 0;
+    // SAFETY: failed identity capture must have retained this actual owned slot.
+    assert_ne!(
+        unsafe {
+            GetHandleInformation(descendant_handle(&owner, index).as_raw_handle(), &mut flags)
+        },
+        0
+    );
+    assert_eq!(
+        owner.terminate(91).unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+
+    // Only the fixture restores its own original handle; production never
+    // retries acquisition, reopens the PID or repairs the incomplete baseline.
+    drop(replace_descendant_handle(&mut owner, index, original));
+    let closed = owner.close_job_members(generation).unwrap().clone();
+    assert!(closed.complete);
+    let resource = closed
+        .resources
+        .iter()
+        .find(|resource| resource.pid == pid)
+        .unwrap();
+    assert!(!resource.borrowed_original);
+    assert!(resource.close_attempted && resource.closed && resource.close_error.is_none());
+    assert!(!owner.job_member_snapshot().unwrap().complete);
+    assert_eq!(owner.close_job_members(generation).unwrap(), &closed);
+    stop_and_finish(&mut owner);
+    drop(owner);
+    assert_eq!(
+        handle_count(),
+        before,
+        "partial descendant fixture leaked a native handle"
+    );
+}
+
+#[test]
+fn job_member_expired_capture_retains_owned_partial_and_allows_deadline_free_close() {
+    let before = member_handle_baseline();

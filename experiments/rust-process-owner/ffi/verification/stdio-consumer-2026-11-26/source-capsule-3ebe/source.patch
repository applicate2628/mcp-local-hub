index 0000000000000000000000000000000000000000..7fa930da709db7eb780dfefeb4103d6e3bc6e5a1
--- /dev/null
+++ b/internal/canonicalnativefixture/protocol_windows.go
@@ -0,0 +1,331 @@
+//go:build windows
+
+// Package canonicalnativefixture contains the fixed test-only canonical case
+// wire format. It creates no process, native owner, permission, or runtime proof.
+package canonicalnativefixture
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+)
+
+const (
+	Version         uint32 = 2
+	MaxControlBytes        = 16 << 10
+	ChannelEnv             = "MCPHUB_CANONICAL_NATIVE_CASE_CHANNEL"
+	ActorEnv               = "MCPHUB_CANONICAL_NATIVE_CASE_CONFIG"
+	PlanSchema             = "canonical-external-plan-v1"
+	TestGUIReplay          = "TestCanonicalGUIRuntimeRecoveryNativeIndependentReplay"
+	TestSuccessor          = "TestCanonicalSuccessorNativeControlRetainsOriginalFiles"
+)
+
+type Config struct {
+	Version                                                 uint32
+	Test, Nonce, Image, ImageSHA256, Fixture, FixtureSHA256 string
+	WorkDeadline, CleanupDeadline, Timeout                  string
+}
+
+type Frame struct {
+	Bind                                                           Config
+	Kind, Birth                                                    string
+	PID                                                            uint32
+	BeforeFlags, InnerFlags                                        uint32
+	Assigned, InnerMember, StrictMember, InnerHandleClosed, Failed bool
+	NoJobChecked, InitialNoJob                                     bool
+	Error                                                          string
+}
+
+type ImageInput struct {
+	Path   string `json:"path"`
+	SHA256 string `json:"sha256"`
+}
+
+type Tools struct {
+	PowerShell ImageInput  `json:"powershell"`
+	Netstat    ImageInput  `json:"netstat"`
+	Netsh      ImageInput  `json:"netsh"`
+	Conhost    ImageInput  `json:"conhost"`
+	WMIC       *ImageInput `json:"wmic,omitempty"`
+}
+
+type Plan struct {
+	Schema            string     `json:"schema"`
+	SourceCommit      string     `json:"source_commit"`
+	Profile           string     `json:"profile"`
+	FocusedCase       string     `json:"focused_case"`
+	Binary            ImageInput `json:"binary"`
+	SourceDir         string     `json:"source_dir"`
+	Fixture           ImageInput `json:"fixture"`
+	Product           ImageInput `json:"product"`
+	Tools             Tools      `json:"tools"`
+	OriginalArgs      []string   `json:"original_args"`
+	ExpectedRootNames []string   `json:"expected_root_names"`
+}
+
+type SlotBinding struct {
+	Test  string `json:"test"`
+	Slot  string `json:"slot"`
+	Nonce string `json:"nonce"`
+}
+
+type Channel struct {
+	Version uint32 `json:"version"`
+	// Root is the outer controller run-root, not the channel subdirectory.
+	Root                string        `json:"root"`
+	RunNonce            string        `json:"run_nonce"`
+	CanonicalPlanSHA256 string        `json:"canonical_plan_sha256"`
+	Profile             string        `json:"profile"`
+	SourceDir           string        `json:"source_dir"`
+	Binary              ImageInput    `json:"binary"`
+	Fixture             ImageInput    `json:"fixture"`
+	WorkDeadline        string        `json:"work_deadline"`
+	CleanupDeadline     string        `json:"cleanup_deadline"`
+	Slots               []SlotBinding `json:"slots"`
+}
+
+type Request struct {
+	Version        uint32 `json:"version"`
+	RunNonce       string `json:"run_nonce"`
+	Slot           string `json:"slot"`
+	ParentPID      uint32 `json:"parent_pid"`
+	ParentBirth    string `json:"parent_birth"`
+	ParentDeadline string `json:"parent_deadline"`
+	Bind           Config `json:"config"`
+}
+
+type Artifact struct {
+	Path   string `json:"path"`
+	Bytes  int64  `json:"bytes"`
+	SHA256 string `json:"sha256"`
+	Closed bool   `json:"closed"`
+}
+
+type Reply struct {
+	Version          uint32   `json:"version"`
+	RunNonce         string   `json:"run_nonce"`
+	Slot             string   `json:"slot"`
+	Bind             Config   `json:"config"`
+	Kind             string   `json:"kind"`
+	RootPID          uint32   `json:"root_pid"`
+	RootBirth        string   `json:"root_birth"`
+	RootExitCode     int      `json:"root_exit_code"`
+	PhysicalComplete bool     `json:"physical_complete"`
+	CustodyRetained  bool     `json:"custody_retained"`
+	Passed           bool     `json:"passed"`
+	Ready            *Frame   `json:"ready"`
+	Final            *Frame   `json:"final"`
+	Stdout           Artifact `json:"stdout"`
+	Stderr           Artifact `json:"stderr"`
+	Error            string   `json:"error"`
+}
+
+func Slot(test string) (string, error) {
+	switch test {
+	case TestGUIReplay:
+		return "gui-replay", nil
+	case TestSuccessor:
+		return "successor", nil
+	default:
+		return "", errors.New("unsupported fixed canonical case")
+	}
+}
+
+func TerminalNames(test string) ([]string, error) {
+	var suffixes []string
+	switch test {
+	case TestGUIReplay:
+		suffixes = []string{
+			"original-control-rejects-different-hash",
+			"original-control-rejects-foreign-path-and-generation",
+			"failed-headless-start-preserves-generation",
+			"continues-to-headless-start",
+			"cleanup-uses-current-operation-context",
+			"closed-original-refuses-runtime-proof",
+		}
+	case TestSuccessor:
+		suffixes = []string{"absent", "identical", "different-identity"}
+	default:
+		return nil, errors.New("unsupported fixed canonical case")
+	}
+	names := []string{test}
+	for _, suffix := range suffixes {
+		names = append(names, test+"/"+suffix)
+	}
+	return names, nil
+}
+
+// FileCustodyError keeps the actual file reachable after one unreceived Close.
+// Callers retain the complete error and stop; they must never retry Close.
+type FileCustodyError struct {
+	File  *os.File
+	Cause error
+}
+
+func (err *FileCustodyError) Error() string {
+	return "original control-file close unreceived: " + err.Cause.Error()
+}
+
+func (err *FileCustodyError) Unwrap() error { return err.Cause }
+
+func HasRetainedFile(err error) bool {
+	var held *FileCustodyError
+	return errors.As(err, &held)
+}
+
+func closeResult(file *os.File, primary error) error {
+	closeErr := file.Close()
+	cause := errors.Join(primary, closeErr)
+	if closeErr != nil {
+		return &FileCustodyError{File: file, Cause: cause}
+	}
+	return cause
+}
+
+// CheckedPath rejects nonordinary existing components. Freshness, protected
+// DACL and exclusivity of the containing scope remain the caller's obligation.
+func CheckedPath(path string, directory bool) error {
+	const root = "D:\\dev\\ChatGPT"
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return errors.New("absolute clean D-only control path required")
+	}
+	rel, err := filepath.Rel(root, path)
+	if err != nil || rel == ".." || strings.Contains(rel, ":") || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return errors.New("control path escapes the original D work area")
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return err
+	}
+	if err := ordinaryAttributes(info); err != nil {
+		return err
+	}
+	if info.IsDir() != directory || (!directory && !info.Mode().IsRegular()) {
+		return errors.New("ordinary control file or directory required")
+	}
+	if strings.EqualFold(path, root) {
+		return nil
+	}
+	for parent := filepath.Dir(path); ; parent = filepath.Dir(parent) {
+		parentInfo, err := os.Lstat(parent)
+		if err != nil {
+			return err
+		}
+		if err := ordinaryAttributes(parentInfo); err != nil {
+			return err
+		}
+		if !parentInfo.IsDir() {
+			return errors.New("ordinary control path ancestors required")
+		}
+		if strings.EqualFold(parent, root) {
+			break
+		}
+		if parent == filepath.Dir(parent) {
+			return errors.New("control path did not reach its D work root")
+		}
+	}
+	return nil
+}
+
+func ordinaryAttributes(info os.FileInfo) error {
+	attributes, ok := info.Sys().(*syscall.Win32FileAttributeData)
+	if !ok || attributes == nil {
+		return errors.New("original Windows file attributes unavailable")
+	}
+	if info.Mode()&os.ModeSymlink != 0 || attributes.FileAttributes&syscall.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+		return errors.New("reparse control path component refused")
+	}
+	return nil
+}
+
+// Publish preserves the existing one-shot, bounded, no-replace protocol.
+// Partial .pending files are evidence and are never removed here.
+func Publish(path string, value any) error {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return errors.New("absolute clean publication path required")
+	}
+	if err := CheckedPath(filepath.Dir(path), true); err != nil {
+		return err
+	}
+	body, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	if len(body) == 0 || len(body) > MaxControlBytes || body[0] != '{' || body[len(body)-1] != '}' {
+		return errors.New("case data must be one bounded JSON object")
+	}
+	staged := path + ".pending"
+	file, err := os.OpenFile(staged, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return err
+	}
+	n, writeErr := file.Write(body)
+	if n != len(body) {
+		writeErr = errors.Join(writeErr, io.ErrShortWrite)
+	}
+	syncErr := file.Sync()
+	if err := closeResult(file, errors.Join(writeErr, syncErr)); err != nil {
+		return err
+	}
+	from, fromErr := windows.UTF16PtrFromString(staged)
+	to, toErr := windows.UTF16PtrFromString(path)
+	if err := errors.Join(fromErr, toErr); err != nil {
+		return err
+	}
+	// No REPLACE_EXISTING: each control frame is published at most once.
+	return windows.MoveFileEx(from, to, 0)
+}
+
+// ReadDocument returns the exact bytes from one checked read so the controller
+// can bind the original plan digest without a second mutable file observation.
+// os.ErrNotExist remains distinguishable. No wait, retry, or cleanup occurs.
+func ReadDocument(path string, value any) ([]byte, error) {
+	if err := CheckedPath(path, false); err != nil {
+		return nil, err
+	}
+	before, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	after, statErr := file.Stat()
+	if statErr != nil || !after.Mode().IsRegular() || !os.SameFile(before, after) {
+		return nil, closeResult(file, errors.Join(statErr, errors.New("opened control file identity differs")))
+	}
+	body, readErr := io.ReadAll(io.LimitReader(file, MaxControlBytes+1))
+	if err := closeResult(file, readErr); err != nil {
+		return nil, err
+	}
+	if len(body) == 0 || len(body) > MaxControlBytes {
+		return nil, errors.New("case data exceeds read limit")
+	}
+	trimmed := bytes.TrimSpace(body)
+	if len(trimmed) == 0 || trimmed[0] != '{' || trimmed[len(trimmed)-1] != '}' {
+		return nil, errors.New("case data must be exactly one JSON object")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(value); err != nil {
+		return nil, err
+	}
+	if err := decoder.Decode(new(any)); !errors.Is(err, io.EOF) {
+		return nil, fmt.Errorf("case data is not exactly one JSON object: %v", err)
+	}
+	return body, nil
+}
+
+func Read(path string, value any) error {
+	_, err := ReadDocument(path, value)
+	return err
+}

+// These callbacks exercise the fully pinned Product create boundary, including
+// under -race. They return MH_ARGUMENT with a valid unknown outcome and slot 0.
+// No callback creates a process, supplies a fictitious native owner, or claims
+// that a Rust DLL accepted the request.
+type rustIOABIProbe struct {
+	calls   atomic.Int32
+	failure string
+}
+
+func rustIOABIRejectingLibrary(check func(*rustOwnerCreate, *rustOwnerIOContext, *uintptr, *rustOwnerOutcome) string) (*rustOwnerLibrary, *rustIOABIProbe) {
+	probe := &rustIOABIProbe{}
+	address := syscall.NewCallback(func(
+		request *rustOwnerCreate, requestBytes uintptr,
+		context *rustOwnerIOContext, contextBytes uintptr,
+		slot *uintptr, output *rustOwnerOutcome, outputBytes uintptr,
+	) uintptr {
+		probe.calls.Add(1)
+		if output == nil || outputBytes != 48 || slot == nil {
+			probe.failure = "invalid output bounds"
+			return 1
+		}
+		*output = rustOwnerOutcome{Size: 48, Version: 1}
+		if *slot != 0 {
+			probe.failure = "nonempty ownership slot"
+			return 1
+		}
+		if request == nil || requestBytes != 56 || request.Version != 1 ||
+			request.Reserved != 0 || context == nil || contextBytes != 40 {
+			probe.failure = "invalid create or IO layout"
+			return 1
+		}
+		if check != nil {
+			probe.failure = check(request, context, slot, output)
+		}
+		return 1 // MH_ARGUMENT: no creation effect and no transferred owner.
+	})
+	return &rustOwnerLibrary{
+		ready: true, procedures: map[string]uintptr{"mh_create_io1": address},
+	}, probe
+}

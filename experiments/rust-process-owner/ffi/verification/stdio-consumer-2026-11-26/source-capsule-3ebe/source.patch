+)
+
+func TestNamespaceSuitePreservesOriginalGoArguments(t *testing.T) {
+	args := []string{"-test.paniconexit0", "-test.v=test2json", "-test.count=1", "-test.timeout=300s"}
+	before := append([]string(nil), args...)
+	if err := validateNamespaceSuiteArgs(args, 5*time.Minute); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(args, before) {
+		t.Fatal("validation rewrote the original Go arguments")
+	}
+}
+
+func TestNamespaceSuiteRefusesFilteredOrRepeatedExecution(t *testing.T) {
+	valid := []string{"-test.paniconexit0", "-test.v=test2json", "-test.count=1", "-test.timeout=5m0s"}
+	tests := map[string][]string{
+		"missing":        valid[:3],
+		"selector":       append(append([]string(nil), valid...), "-test.run=TestSecretsInit"),
+		"empty-filter":   {"-test.paniconexit0", "-test.v=test2json", "-test.run=", "-test.timeout=5m0s"},
+		"skip":           {"-test.paniconexit0", "-test.v=test2json", "-test.skip=Test", "-test.timeout=5m0s"},
+		"repeat":         {"-test.paniconexit0", "-test.v=test2json", "-test.count=2", "-test.timeout=5m0s"},
+		"duplicate":      {"-test.v=test2json", "-test.v=test2json", "-test.count=1", "-test.timeout=5m0s"},
+		"unframed":       {"-test.paniconexit0", "-test.v=true", "-test.count=1", "-test.timeout=5m0s"},
+		"short-deadline": {"-test.paniconexit0", "-test.v=test2json", "-test.count=1", "-test.timeout=1s"},
+		"bench":          {"-test.paniconexit0", "-test.bench=.", "-test.count=1", "-test.timeout=5m0s"},
+		"fuzz":           {"-test.paniconexit0", "-test.fuzz=.", "-test.count=1", "-test.timeout=5m0s"},
+	}
+	for name, args := range tests {
+		t.Run(name, func(t *testing.T) {
+			if err := validateNamespaceSuiteArgs(args, 5*time.Minute); err == nil {
+				t.Fatal("changed whole-suite contract was accepted")
+			}
+		})
+	}
+	if err := validateNamespaceSuiteArgs(valid, time.Minute); err == nil {
+		t.Fatal("owner deadline differed from the literal Go timeout")
+	}
+}
+
+func TestNamespaceSuiteReceivesOnlyActualFramedMandatoryPasses(t *testing.T) {
+	var out bytes.Buffer
+	out.WriteString("ordinary log without newline")
+	for _, name := range namespaceSuiteRequiredTests {
+		out.WriteString("\x16=== RUN   " + name + "\n")
+		out.WriteString("\x16--- PASS: " + name + " (0.01s)\n")
+	}
+	valid := append([]byte(nil), out.Bytes()...)
+	if _, err := namespaceMandatoryPasses(valid); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(out.Bytes(), valid) {
+		t.Fatal("mandatory receiving rewrote raw output")
+	}
+	first := namespaceSuiteRequiredTests[0]
+	tests := map[string][]byte{
+		"plain-PASS-is-not-evidence": bytes.ReplaceAll(valid, []byte{0x16}, nil),
+		"duplicate-run":              append(append([]byte(nil), valid...), []byte("\x16=== RUN   "+first+"\n")...),
+		"duplicate-pass":             append(append([]byte(nil), valid...), []byte("\x16--- PASS: "+first+" (0.01s)\n")...),
+		"skipped":                    bytes.Replace(valid, []byte("--- PASS: "+first), []byte("--- SKIP: "+first), 1),
+		"failed":                     bytes.Replace(valid, []byte("--- PASS: "+first), []byte("--- FAIL: "+first), 1),
+		"missing":                    bytes.Replace(valid, []byte("\x16--- PASS: "+first+" (0.01s)\n"), nil, 1),
+	}
+	for name, raw := range tests {
+		t.Run(name, func(t *testing.T) {
+			if _, err := namespaceMandatoryPasses(raw); err == nil {
+				t.Fatal("missing, skipped or duplicate mandatory evidence was accepted")
+			}
+		})
+	}
+}
+
+func TestNamespaceSuiteUsesActualCompiledTags(t *testing.T) {
+	const path = "mcp-local-hub/internal/api.test"
+	defaultInfo := &debug.BuildInfo{Path: path}
+	if tags, err := namespaceCompiledTags(defaultInfo, path, false); err != nil || len(tags) != 0 {
+		t.Fatalf("default compiled metadata: tags=%v err=%v", tags, err)
+	}
+	stateInfo := &debug.BuildInfo{Path: path, Settings: []debug.BuildSetting{{Key: "-tags", Value: "test_state_path_env"}}}
+	if _, err := namespaceCompiledTags(stateInfo, path, true); err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range []struct {
+		name  string
+		info  *debug.BuildInfo
+		state bool
+	}{
+		{"tag-declaration-without-compiled-tag", defaultInfo, true},
+		{"wrong-lane", stateInfo, false},
+		{"wrong-entry-point", &debug.BuildInfo{Path: "mcp-local-hub/cmd/mcphub"}, false},
+		{"extra-tag", &debug.BuildInfo{Path: path, Settings: []debug.BuildSetting{{Key: "-tags", Value: "test_state_path_env,extra"}}}, true},
+		{"duplicate-setting", &debug.BuildInfo{Path: path, Settings: []debug.BuildSetting{{Key: "-tags", Value: "test_state_path_env"}, {Key: "-tags", Value: "test_state_path_env"}}}, true},
+		{"rust-mark", &debug.BuildInfo{Path: path, Settings: []debug.BuildSetting{{Key: "-ldflags", Value: "-X=mcp-local-hub/internal/buildinfo.rustOwnerSHA256=value"}}}, false},
+		{"publisher-mark", &debug.BuildInfo{Path: path, Settings: []debug.BuildSetting{{Key: "-ldflags", Value: "-X=mcp-local-hub/internal/buildinfo.publisherSourceEpoch=value"}}}, false},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			if _, err := namespaceCompiledTags(item.info, path, item.state); err == nil {
+				t.Fatal("declared mode overrode actual compiled metadata")
+			}
+		})
+	}
+}
+
+func TestNamespaceSuiteRetainsOriginalFailedRootExit(t *testing.T) {
+	infrastructure := errors.New("owner cleanup incomplete")
+	if got := namespaceSuiteExitCode(true, 97, infrastructure); got != 97 {
+		t.Fatalf("original failing root exit became %d", got)
+	}
+	if got := namespaceSuiteExitCode(true, 0, infrastructure); got != 1 {
+		t.Fatalf("root success hid owner failure: %d", got)
+	}
+	if got := namespaceSuiteExitCode(false, 0, nil); got != 1 {
+		t.Fatalf("unknown wait became success: %d", got)
+	}
+	if got := namespaceSuiteExitCode(true, 0, nil); got != 0 {
+		t.Fatalf("known success became %d", got)
+	}
+}
+
+func TestNamespaceSuiteEnvironmentDoesNotRestoreChildSentinels(t *testing.T) {
+	t.Setenv("MCPHUB_TEST_PEER_TRANSPORT_CHILD", "1")
+	t.Setenv("MCPHUB_STATE_DIR_OVERRIDE", "foreign-state")
+	t.Setenv("MCPHUB_UNDECLARED_FIXTURE_SENTINEL", "1")
+	t.Setenv("NAMESPACE_UNRELATED_ENV_TEST", "preserved")
+	env := fixtureEnvironment(map[string]string{"MCPHUB_E2E_SCHEDULER": "none", "MCPHUB_CANONICAL_FIXTURE_TEST_PRODUCT": "1"})
+	values := map[string]string{}
+	for _, entry := range env {
+		key, value, _ := strings.Cut(entry, "=")
+		values[strings.ToUpper(key)] = value
+	}
+	for _, absent := range []string{"MCPHUB_TEST_PEER_TRANSPORT_CHILD", "MCPHUB_STATE_DIR_OVERRIDE", "MCPHUB_UNDECLARED_FIXTURE_SENTINEL"} {
+		if _, present := values[absent]; present {
+			t.Fatalf("ambient child sentinel survived: %s", absent)
+		}
+	}
+	if values["MCPHUB_E2E_SCHEDULER"] != "none" || values["MCPHUB_CANONICAL_FIXTURE_TEST_PRODUCT"] != "1" || values["NAMESPACE_UNRELATED_ENV_TEST"] != "preserved" {
+		t.Fatal("explicit fixture values or ordinary environment were lost")
+	}
+}

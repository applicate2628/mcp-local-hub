+func TestAutoRegisterSerena_ConsumerCleanupOutcomePreservesCommitBoundary(t *testing.T) {
+	for _, tc := range []struct {
+		name                    string
+		committed, installFails bool
+	}{
+		{name: "committed-cleanup", committed: true},
+		{name: "committed-install-and-cleanup", committed: true, installFails: true},
+		{name: "precommit-and-cleanup", installFails: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			regPath := autoRegisterTestEnv(t)
+			intentPath := filepath.Join(filepath.Dir(regPath), "state", supervisorIntentFileLeaf)
+			intentBytes := []byte("committed consumer outcome fixture")
+			installCause := errors.New("modeled install operation failed")
+			cleanupCause := errors.New("modeled consumer cleanup failed")
+			requestCtx, cancelRequest := context.WithCancel(context.Background())
+			defer cancelRequest()
+			installCalls := 0
+			stubAutoRegisterInstall(t, func(context.Context, *API, *config.ServerManifest, InstallParsedManifestOpts) (string, error) {
+				installCalls++
+				var installErr error
+				if tc.installFails {
+					installErr = installCause
+				}
+				if !tc.committed {
+					return "", installErr
+				}
+				if err := os.WriteFile(intentPath, intentBytes, 0o600); err != nil {
+					t.Fatal(err)
+				}
+				cancelRequest()
+				return intentPath, installErr
+			})
+			previousFactory := autoRegisterNewInstallOperationFn
+			autoRegisterNewInstallOperationFn = func(a *API) (autoRegisterSerenaInstallOperation, error) {
+				operation, err := previousFactory(a)
+				install := operation.install
+				// DATA-only caller outcome: no original consumer or close proof
+				// is created. Keep cleanup separate from the install result.
+				operation.install = func(ctx context.Context, manifest *config.ServerManifest, opts InstallParsedManifestOpts) (string, error, error) {
+					path, installErr, _ := install(ctx, manifest, opts)
+					return path, installErr, cleanupCause
+				}
+				return operation, err
+			}
+			t.Cleanup(func() { autoRegisterNewInstallOperationFn = previousFactory })
+			reconcileCalls, readinessCalls := 0, 0
+			stubAutoRegisterReconcile(t, func(ctx context.Context, apply bool) (ReconcileResponse, error) {
+				reconcileCalls++
+				if !apply || ctx.Err() != nil {
+					t.Errorf("committed continuation: apply=%t cause=%v", apply, ctx.Err())
+				}
+				return ReconcileResponse{}, nil
+			})
+			stubAutoRegisterReadiness(t, func(int, time.Duration) error { readinessCalls++; return nil })
+			workspace := writeSerenaMarker(t, t.TempDir(), validSerenaMarkerYAML)
+			entry, err := NewAPI().AutoRegisterSerenaWorkspace(requestCtx, workspace)
+			if !errors.Is(err, cleanupCause) || errors.Is(err, installCause) != tc.installFails || installCalls != 1 {
+				t.Errorf("separate outcomes lost: entry=%+v cause=%v install=%d", entry, err, installCalls)
+			}
+			rows := loadRegSerenaRows(t, regPath)
+			if tc.committed {
+				if entry == nil || len(rows) != 1 || reconcileCalls != 1 {
+					t.Errorf("cleanup failure rolled back commit: entry=%+v rows=%+v reconcile=%d", entry, rows, reconcileCalls)
+				} else if rows[0].WorkspaceKey != entry.WorkspaceKey {
+					t.Errorf("committed row key=%q entry key=%q", rows[0].WorkspaceKey, entry.WorkspaceKey)
+				}
+				if got, readErr := os.ReadFile(intentPath); readErr != nil || !bytes.Equal(got, intentBytes) {
+					t.Errorf("committed intent changed: bytes=%q cause=%v", got, readErr)
+				}
+			} else {
+				if entry != nil || len(rows) != 0 || reconcileCalls != 0 {
+					t.Errorf("cleanup failure masked precommit rollback: entry=%+v rows=%+v reconcile=%d", entry, rows, reconcileCalls)
+				}
+				if _, statErr := os.Stat(intentPath); !errors.Is(statErr, os.ErrNotExist) {
+					t.Errorf("precommit failure left intent: %v", statErr)
+				}
+			}
+			if readinessCalls != 0 {
+				t.Errorf("readiness=%d after lifecycle failure, want zero", readinessCalls)
+			}
+		})
+	}
+}

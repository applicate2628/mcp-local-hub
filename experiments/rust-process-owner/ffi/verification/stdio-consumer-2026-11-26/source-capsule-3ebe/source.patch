+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"slices"
+	"testing"
+
+	"mcp-local-hub/internal/binaryadmission"
+)
+
+func TestRuntimeLibraryValidationSelectsExactBorrowProfile(t *testing.T) {
+	profiles := []struct {
+		name    string
+		exports []string
+	}{
+		{"owner-v1", binaryadmission.WindowsProcessOwnerExportsV1()},
+		{"owner-v1-members-v1", binaryadmission.WindowsProcessOwnerMemberExportsV1()},
+		{"owner-v1-members-v1-borrow-v1", binaryadmission.WindowsProcessOwnerBorrowExportsV1()},
+	}
+	for _, actual := range profiles {
+		for _, selected := range profiles {
+			// Existing tests cover 13/17; these rows exercise every boundary
+			// where either the receipt or selected profile includes borrow.
+			if len(actual.exports) != 18 && len(selected.exports) != 18 {
+				continue
+			}
+			t.Run(actual.name+"/"+selected.name, func(t *testing.T) {
+				candidate := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", actual.exports)
+				var stdout, stderr bytes.Buffer
+				code := run([]string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit,
+					"--runtime-library-profile", selected.name}, &stdout, &stderr)
+				if actual.name != selected.name {
+					if code != 1 || stdout.Len() != 0 || stderr.Len() == 0 {
+						t.Fatalf("mismatch admitted: code=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+					}
+					return
+				}
+				if code != 0 || stderr.Len() != 0 {
+					t.Fatalf("borrow profile refused: code=%d stderr=%q", code, stderr.String())
+				}
+				var receipt binaryadmission.WindowsRuntimeLibraryIdentity
+				if err := json.Unmarshal(stdout.Bytes(), &receipt); err != nil {
+					t.Fatal(err)
+				}
+				if !slices.Equal(receipt.Exports, actual.exports) || receipt.SourceCommit != runtimeTestCommit {
+					t.Fatalf("receipt changed admitted tuple: %+v", receipt)
+				}
+			})
+		}
+	}
+}
diff --git a/tools/windows-product-validate/runtime_library_test.go b/tools/windows-product-validate/runtime_library_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2d23b55c374d55e99b9302dc3fcb72129f322405
--- /dev/null
+++ b/tools/windows-product-validate/runtime_library_test.go
@@ -0,0 +1,187 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"mcp-local-hub/internal/binaryadmission"
+)
+
+const runtimeTestCommit = "0123456789abcdef0123456789abcdef01234567"
+
+func writeRuntimeLibraryFixture(t *testing.T, filename string, exports []string) string {
+	t.Helper()
+	const (
+		peOffset      = 0x80
+		optionalSize  = 0xf0
+		sectionOffset = peOffset + 4 + 20 + optionalSize
+		rawOffset     = 0x200
+		rawSize       = 0x800
+		sectionRVA    = 0x1000
+	)
+	data := make([]byte, rawOffset+rawSize)
+	copy(data[:2], "MZ")
+	binary.LittleEndian.PutUint32(data[0x3c:0x40], peOffset)
+	copy(data[peOffset:peOffset+4], "PE\x00\x00")
+	coff := data[peOffset+4 : peOffset+24]
+	binary.LittleEndian.PutUint16(coff[0:2], 0x8664)
+	binary.LittleEndian.PutUint16(coff[2:4], 1)
+	binary.LittleEndian.PutUint16(coff[16:18], optionalSize)
+	binary.LittleEndian.PutUint16(coff[18:20], 0x2002)
+	optional := data[peOffset+24 : peOffset+24+optionalSize]
+	binary.LittleEndian.PutUint16(optional[0:2], 0x20b)
+	binary.LittleEndian.PutUint64(optional[24:32], 0x180000000)
+	binary.LittleEndian.PutUint32(optional[32:36], 0x1000)
+	binary.LittleEndian.PutUint32(optional[36:40], 0x200)
+	binary.LittleEndian.PutUint32(optional[56:60], 0x2000)
+	binary.LittleEndian.PutUint32(optional[60:64], rawOffset)
+	binary.LittleEndian.PutUint16(optional[68:70], 2)
+	binary.LittleEndian.PutUint32(optional[108:112], 16)
+	binary.LittleEndian.PutUint32(optional[112:116], sectionRVA)
+	binary.LittleEndian.PutUint32(optional[116:120], 0x500)
+	section := data[sectionOffset : sectionOffset+40]
+	copy(section[:8], ".rdata\x00\x00")
+	binary.LittleEndian.PutUint32(section[8:12], rawSize)
+	binary.LittleEndian.PutUint32(section[12:16], sectionRVA)
+	binary.LittleEndian.PutUint32(section[16:20], rawSize)
+	binary.LittleEndian.PutUint32(section[20:24], rawOffset)
+	binary.LittleEndian.PutUint32(section[36:40], 0x40000040)
+	directory := data[rawOffset : rawOffset+40]
+	binary.LittleEndian.PutUint32(directory[20:24], uint32(len(exports)))
+	binary.LittleEndian.PutUint32(directory[24:28], uint32(len(exports)))
+	binary.LittleEndian.PutUint32(directory[28:32], sectionRVA+0x40)
+	binary.LittleEndian.PutUint32(directory[32:36], sectionRVA+0x80)
+	binary.LittleEndian.PutUint32(directory[36:40], sectionRVA+0xc0)
+	cursor := rawOffset + 0x300
+	for i, name := range exports {
+		binary.LittleEndian.PutUint32(data[rawOffset+0x80+i*4:rawOffset+0x84+i*4], sectionRVA+uint32(cursor-rawOffset))
+		copy(data[cursor:], name)
+		cursor += len(name) + 1
+	}
+	path := filepath.Join(t.TempDir(), filename)
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestRuntimeLibraryValidationMode(t *testing.T) {
+	candidate := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", binaryadmission.WindowsProcessOwnerExportsV1())
+	var stdout, stderr bytes.Buffer
+	if code := run([]string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit}, &stdout, &stderr); code != 0 {
+		t.Fatalf("code=%d stderr=%s", code, stderr.String())
+	}
+	var identity binaryadmission.WindowsRuntimeLibraryIdentity
+	if err := json.Unmarshal(stdout.Bytes(), &identity); err != nil {
+		t.Fatal(err)
+	}
+	if identity.Schema != binaryadmission.WindowsRuntimeLibraryIdentitySchemaV1 || identity.Filename != "mcphub-owner.dll" ||
+		identity.SourceCommit != runtimeTestCommit || identity.Machine != 0x8664 ||
+		!reflect.DeepEqual(identity.Exports, binaryadmission.WindowsProcessOwnerExportsV1()) || !strings.HasSuffix(stdout.String(), "\n") || stderr.Len() != 0 {
+		t.Fatalf("identity=%+v stdout=%q stderr=%q", identity, stdout.String(), stderr.String())
+	}
+}
+
+func TestRuntimeLibraryValidationModeRejectsWrongNameAndMixedModes(t *testing.T) {
+	candidate := writeRuntimeLibraryFixture(t, "other.dll", binaryadmission.WindowsProcessOwnerExportsV1())
+	var stdout, stderr bytes.Buffer
+	if code := run([]string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit}, &stdout, &stderr); code != 1 || stdout.Len() != 0 || !strings.Contains(stderr.String(), "filename") {
+		t.Fatalf("wrong-name code=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+	}
+	stdout.Reset()
+	stderr.Reset()
+	if code := run([]string{"--runtime-library", candidate}, &stdout, &stderr); code != 2 || stdout.Len() != 0 || !strings.Contains(stderr.String(), "requires --expected-commit") {
+		t.Fatalf("missing-commit code=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+	}
+	stdout.Reset()
+	stderr.Reset()
+	if code := run([]string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit, "--candidate", candidate}, &stdout, &stderr); code != 2 || stdout.Len() != 0 || !strings.Contains(stderr.String(), "cannot mix modes") {
+		t.Fatalf("mixed code=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+	}
+}
+
+func TestRuntimeLibraryValidationSelectsExactMemberProfile(t *testing.T) {
+	members := binaryadmission.WindowsProcessOwnerMemberExportsV1()
+	candidate := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", members)
+	var stdout, stderr bytes.Buffer
+	args := []string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit,
+		"--runtime-library-profile", "owner-v1-members-v1"}
+	if code := run(args, &stdout, &stderr); code != 0 {
+		t.Fatalf("member profile code=%d stderr=%s", code, stderr.String())
+	}
+	var identity binaryadmission.WindowsRuntimeLibraryIdentity
+	if err := json.Unmarshal(stdout.Bytes(), &identity); err != nil {
+		t.Fatal(err)
+	}
+	if identity.Schema != binaryadmission.WindowsRuntimeLibraryIdentitySchemaV1 ||
+		identity.SourceCommit != runtimeTestCommit || !reflect.DeepEqual(identity.Exports, members) ||
+		identity.SHA256 == "" || stderr.Len() != 0 {
+		t.Fatalf("member identity exports=%v hash=%q stderr=%q", identity.Exports, identity.SHA256, stderr.String())
+	}
+
+	for _, tc := range []struct {
+		name    string
+		exports []string
+		profile string
+	}{
+		{"members cannot use default legacy", members, ""},
+		{"legacy cannot claim members", binaryadmission.WindowsProcessOwnerExportsV1(), "owner-v1-members-v1"},
+		{"unknown name at correct count", append(append([]string(nil), members[:len(members)-1]...), "mh_unknown1"), "owner-v1-members-v1"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", tc.exports)
+			args := []string{"--runtime-library", path, "--expected-commit", runtimeTestCommit}
+			if tc.profile != "" {
+				args = append(args, "--runtime-library-profile", tc.profile)
+			}
+			var stdout, stderr bytes.Buffer
+			if code := run(args, &stdout, &stderr); code != 1 || stdout.Len() != 0 {
+				t.Fatalf("mismatched PE profile accepted: code=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+			}
+		})
+	}
+}
+
+func TestRuntimeLibraryValidationRejectsPartialMemberExports(t *testing.T) {
+	members := binaryadmission.WindowsProcessOwnerMemberExportsV1()
+	for _, absent := range []string{"mh_members_close1", "mh_members_observe1", "mh_members_revalidate1", "mh_members_snapshot1"} {
+		t.Run(absent, func(t *testing.T) {
+			var exports []string
+			for _, name := range members {
+				if name != absent {
+					exports = append(exports, name)
+				}
+			}
+			candidate := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", exports)
+			var stdout, stderr bytes.Buffer
+			code := run([]string{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit,
+				"--runtime-library-profile", "owner-v1-members-v1"}, &stdout, &stderr)
+			if code != 1 || stdout.Len() != 0 {
+				t.Fatalf("partial member PE accepted: missing=%s code=%d stdout=%q stderr=%q", absent, code, stdout.String(), stderr.String())
+			}
+		})
+	}
+}
+
+func TestRuntimeLibraryValidationRejectsUnknownOrUnboundProfile(t *testing.T) {
+	candidate := writeRuntimeLibraryFixture(t, "mcphub-owner.dll", binaryadmission.WindowsProcessOwnerExportsV1())
+	for _, args := range [][]string{
+		{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit, "--runtime-library-profile", "owner-v2"},
+		{"--runtime-library-profile", "owner-v1-members-v1"},
+		{"--candidate", candidate, "--expected-version", "test", "--expected-commit", runtimeTestCommit,
+			"--expected-build-date", "2026-11-19", "--runtime-library-profile", "owner-v1-members-v1"},
+		{"--runtime-library", candidate, "--expected-commit", runtimeTestCommit, "--runtime-library-profile", "owner-v1",
+			"--candidate", candidate},
+	} {
+		var stdout, stderr bytes.Buffer
+		if code := run(args, &stdout, &stderr); code != 2 || stdout.Len() != 0 {
+			t.Fatalf("invalid profile options accepted: args=%v code=%d stdout=%q stderr=%q", args, code, stdout.String(), stderr.String())
+		}
+	}
+}

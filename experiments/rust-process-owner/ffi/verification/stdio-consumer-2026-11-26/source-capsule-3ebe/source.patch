+		})
+	}
+}
+
+func TestOpenRustOwnerLibrarySettlesPostLoadFailuresOnce(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		mutate func(l rustOwnerTestLayout, api *fakeRustOwnerLibraryAPI, admit *rustOwnerLibraryAdmission)
+		want   string

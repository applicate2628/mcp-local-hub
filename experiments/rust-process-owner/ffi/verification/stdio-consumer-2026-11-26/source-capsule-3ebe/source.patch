+func TestStdioRustOriginalRootBeforeDescendantEOFAndForeignSentinel(t *testing.T) {
+	sentinel, sentinelRoot := newStdioRustOriginalHost(t, "sentinel")
+	if err := sentinel.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	originalTestBarrier(t, filepath.Join(sentinelRoot, "root-ready"))
+	sentinelOwner := stdioRustOriginalOwner(t, sentinel)
+
+	h, root := newStdioRustOriginalHost(t, "wrapper")
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	releaseObservation := func() { releaseOnce.Do(func() { close(release) }) }
+	t.Cleanup(releaseObservation)
+	var calls atomic.Int32
+	var observationArmed atomic.Bool
+	var naturalExit bool
+	h.originalLaunch = &stdioOriginalLaunchOps{
+		observeOriginal: func(owner *process.AtCreateJobProcess, ctx context.Context, natural bool) (process.ContainedNativeSnapshot, error) {
+			// Failed Start receives its real cleanup before returning to the test.
+			if !observationArmed.Load() {
+				return owner.ObserveOriginal(ctx, natural)
+			}
+			if calls.Add(1) == 1 {
+				naturalExit = natural
+				close(entered)
+			}
+			select {
+			case <-release:
+			case <-ctx.Done():
+				return process.ContainedNativeSnapshot{}, ctx.Err()
+			}
+			return owner.ObserveOriginal(ctx, natural)
+		},
+	}
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	observationArmed.Store(true)
+	originalTestBarrier(t, filepath.Join(root, "root-ready"))
+	originalTestBarrier(t, filepath.Join(root, "descendant-ready"))
+	owner := stdioRustOriginalOwner(t, h)
+	if err := os.WriteFile(filepath.Join(root, "root-release"), []byte("release"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	stdioRustOriginalWait(t, "native terminal observation entry", entered)
+	identity, rootWait, original := h.NativeExit()
+	if !original || !naturalExit || !rootWait.Known || rootWait.ExitCode != 17 ||
+		rootWait.Error != nil || identity != owner.identity {
+		t.Fatalf("root exit was not independently published: identity=%+v root=%+v", identity, rootWait)
+	}
+	stdioRustOriginalOpen(t, "stdout EOF", owner.lifecycle.stdoutDone)
+	stdioRustOriginalOpen(t, "stderr EOF", owner.lifecycle.stderrDone)
+	stdioRustOriginalOpen(t, "child exit receiving", h.ChildExited())
+	releaseObservation()
+	result := stdioRustOriginalComplete(t, h, owner)
+	if result.RootWait.ExitCode != 17 || calls.Load() != 1 {
+		t.Fatalf("descendant settlement replaced the root result or repeated native observation: %+v calls=%d", result, calls.Load())
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	live, err := sentinelOwner.original.OriginalLive(ctx)
+	if err != nil || !live {
+		t.Fatalf("foreign original owner was affected: live=%t err=%v", live, err)
+	}
+	stdioRustOriginalOpen(t, "foreign sentinel exit", sentinel.ChildExited())
+}
+
+func TestStdioRustOriginalCanceledObserversKeepHealthyRPC(t *testing.T) {
+	h, root := newStdioRustOriginalHost(t, "echo")
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	originalTestBarrier(t, filepath.Join(root, "root-ready"))
+	owner := stdioRustOriginalOwner(t, h)
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	if source, err := h.OriginalMemberSource(canceled); source != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled member source observation: source=%v err=%v", source, err)
+	}
+	if observation, err := h.ObserveOriginalMembers(canceled); observation != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled member observation: observation=%v err=%v", observation, err)
+	}
+	if result, err := h.StopObserved(canceled); !result.Pending || !errors.Is(err, context.Canceled) {
+		t.Fatalf("pre-canceled stop receiver: %+v err=%v", result, err)
+	}
+	owner.lifecycle.stopMu.Lock()
+	stopping := owner.lifecycle.stopStarted
+	owner.lifecycle.stopMu.Unlock()
+	if stopping {
+		t.Fatal("pre-canceled receiver started terminal ownership")
+	}
+	stdioRustOriginalRPC(t, h, "after-observer-cancellation")
+
+	ctx, stop := context.WithTimeout(context.Background(), 5*time.Second)
+	defer stop()
+	source, err := h.OriginalMemberSource(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	observation, err := h.ObserveOriginalMembers(ctx)
+	if observation != nil {
+		t.Cleanup(func() {
+			cleanupContext, cancelCleanup := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancelCleanup()
+			settlement, stopErr := h.StopObserved(cleanupContext)
+			if stopErr != nil || !settlement.Complete() {
+				t.Errorf("native member observation owner cleanup: %+v err=%v", settlement, stopErr)
+				return
+			}
+			closed, closeErr := observation.CloseObserved()
+			if closeErr != nil || closed == nil || !closed.Finalized() || closed.Validate(source) != nil {
+				t.Errorf("native member observation final receipt: %v", closeErr)
+			}
+		})
+	}
+	if err != nil || observation == nil || !observation.Snapshot().Complete {
+		t.Fatalf("healthy native member observation after cancellation: %v", err)
+	}
+	if err := observation.MatchOwnerPID(ctx, uint32(owner.identity.PID)); err != nil {
+		t.Fatal(err)
+	}
+	stdioRustOriginalRPC(t, h, "with-live-member-observation")
+	// The terminal coordinator seals admission and closes this same observation
+	// before owner termination. Its existing cleanup deadline bounds both steps.
+	stdioRustOriginalComplete(t, h, owner)
+	closed, err := observation.CloseObserved()
+	if err != nil || closed == nil || !closed.Finalized() || closed.Validate(source) != nil {
+		t.Fatalf("original member observation did not retain its source-bound close: %v", err)
+	}
+	repeated, err := observation.CloseObserved()
+	if err != nil || repeated != closed {
+		t.Fatalf("final member close receipt changed: same=%v err=%v", repeated == closed, err)
+	}
+}

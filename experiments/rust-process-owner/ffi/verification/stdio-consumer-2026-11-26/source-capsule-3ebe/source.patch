diff --git a/internal/cli/serena_original_endpoint_windows_test.go b/internal/cli/serena_original_endpoint_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..72488713751bde915d1a931a0f45bce367239357
--- /dev/null
+++ b/internal/cli/serena_original_endpoint_windows_test.go
@@ -0,0 +1,240 @@
+//go:build windows
+
+package cli
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"mcp-local-hub/internal/process"
+)
+
+// The script changes only the delivery order of close results. Successful
+// receipts still come from the real original Job used by stdioCLICustodyHost;
+// these tests do not claim to exercise the process package's query-drain race.
+type serenaEndpointCloseScript struct {
+	*process.OriginalJobMemberObservation
+	close func() (*process.OriginalJobMemberCloseObservation, error)
+}
+
+func (s *serenaEndpointCloseScript) CloseObserved() (*process.OriginalJobMemberCloseObservation, error) {
+	return s.close()
+}
+
+func serenaEndpointMembers(t *testing.T) (*process.OriginalJobMemberObservation, process.OriginalJobMemberSource) {
+	t.Helper()
+	host, fixture := stdioCLICustodyHost(t, context.Background(), false)
+	stdioCLICustodyLive(t, host, fixture.Nonce+":endpoint-close", false)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	source, err := host.OriginalMemberSource(ctx)
+	if err != nil {
+		t.Fatalf("original fixture member source: %v", err)
+	}
+	members, err := host.ObserveOriginalMembers(ctx)
+	if members != nil {
+		// Registered after the host cleanup, so the actual member observation
+		// closes before the original host on every assertion failure.
+		t.Cleanup(func() {
+			proof, closeErr := members.CloseObserved()
+			if err := errors.Join(closeErr, proof.Validate(source)); err != nil {
+				t.Errorf("original fixture member cleanup: %v", err)
+			}
+		})
+	}
+	if err != nil || members == nil {
+		t.Fatalf("original fixture member acquisition: present=%t error=%v", members != nil, err)
+	}
+	return members, source
+}
+
+func TestSerenaOriginalEndpointCloseRetriesPending(t *testing.T) {
+	members, source := serenaEndpointMembers(t)
+	// A non-nil but unqualified receipt must not become a final cache entry.
+	// This zero value carries no original-owner authority.
+	pendingProof := &process.OriginalJobMemberCloseObservation{}
+	var calls int
+	script := &serenaEndpointCloseScript{OriginalJobMemberObservation: members}
+	script.close = func() (*process.OriginalJobMemberCloseObservation, error) {
+		calls++
+		if calls == 1 {
+			return pendingProof, &process.OriginalMemberBorrowPendingError{Stage: "scripted-first-response"}
+		}
+		return members.CloseObserved()
+	}
+	endpoint := &serenaOriginalEndpoint{source: source, members: script}
+	canceled, cancel := context.WithCancel(context.Background())
+	cancel()
+	pending, err := endpoint.CloseObserved(canceled)
+	if pending != pendingProof || !errors.Is(err, process.ErrOriginalMemberBorrowPending) || !errors.Is(err, context.Canceled) {
+		t.Fatalf("first pending/caller result changed: proof=%t error=%v", pending != nil, err)
+	}
+	endpoint.mu.Lock()
+	sealed, cachedErr := endpoint.closing, endpoint.closeErr
+	endpoint.mu.Unlock()
+	if !sealed || errors.Is(cachedErr, context.Canceled) {
+		t.Fatalf("caller cancellation contaminated close facts: sealed=%t error=%v", sealed, cachedErr)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	proof, err := endpoint.CloseObserved(ctx)
+	if err != nil || proof == nil {
+		t.Fatalf("pending close was not retried: calls=%d proof=%t error=%v", calls, proof != nil, err)
+	}
+	if err := proof.Validate(source); err != nil {
+		t.Fatalf("retry did not receive the original final receipt: %v", err)
+	}
+	replayed, err := endpoint.CloseObserved(ctx)
+	if replayed != proof || err != nil || calls != 2 {
+		t.Fatalf("final receipt was not cached: same=%t calls=%d error=%v", replayed == proof, calls, err)
+	}
+	if err := endpoint.ValidateOriginalEndpoint(ctx, "", ""); err == nil {
+		t.Fatal("closed endpoint admitted a fresh endpoint validation")
+	}
+}
+
+func TestSerenaOriginalEndpointCloseKeepsFinalFactsAcrossCallerContexts(t *testing.T) {
+	for _, reportedFailure := range []bool{false, true} {
+		name := "success"
+		if reportedFailure {
+			name = "reported-close-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			members, source := serenaEndpointMembers(t)
+			var closeFailure error
+			if reportedFailure {
+				// This additional error tests CLI caching, not a native handle
+				// failure. The accompanying final receipt is still genuine.
+				closeFailure = errors.New("scripted close-report failure")
+			}
+			var calls int
+			script := &serenaEndpointCloseScript{OriginalJobMemberObservation: members}
+			script.close = func() (*process.OriginalJobMemberCloseObservation, error) {
+				calls++
+				proof, err := members.CloseObserved()
+				return proof, errors.Join(err, closeFailure)
+			}
+			endpoint := &serenaOriginalEndpoint{source: source, members: script}
+			canceled, cancel := context.WithCancel(context.Background())
+			cancel()
+			proof, err := endpoint.CloseObserved(canceled)
+			if proof == nil || !errors.Is(err, context.Canceled) || reportedFailure && !errors.Is(err, closeFailure) {
+				t.Fatalf("canceled caller lost final facts: proof=%t error=%v", proof != nil, err)
+			}
+			if err := proof.Validate(source); err != nil {
+				t.Fatalf("close did not receive the original final receipt: %v", err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			replayed, err := endpoint.CloseObserved(ctx)
+			if replayed != proof || errors.Is(err, context.Canceled) || errors.Is(err, process.ErrOriginalMemberBorrowPending) ||
+				reportedFailure && !errors.Is(err, closeFailure) || !reportedFailure && err != nil {
+				t.Fatalf("fresh caller received changed final facts: same=%t error=%v", replayed == proof, err)
+			}
+			replayed, err = endpoint.CloseObserved(nil)
+			if replayed != proof || err == nil || !strings.Contains(err.Error(), "SERENA_ENDPOINT_CLOSE_CONTEXT_MISSING") ||
+				reportedFailure && !errors.Is(err, closeFailure) {
+				t.Fatalf("missing-context caller lost cached facts: same=%t error=%v", replayed == proof, err)
+			}
+			endpoint.mu.Lock()
+			cachedErr := endpoint.closeErr
+			endpoint.mu.Unlock()
+			if calls != 1 || errors.Is(cachedErr, context.Canceled) ||
+				reportedFailure && !errors.Is(cachedErr, closeFailure) || !reportedFailure && cachedErr != nil {
+				t.Fatalf("final result retried or caller error cached: calls=%d error=%v", calls, cachedErr)
+			}
+		})
+	}
+}
+
+func TestSerenaOriginalEndpointCloseLatePendingCannotReplaceFinal(t *testing.T) {
+	members, source := serenaEndpointMembers(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	var calls atomic.Int32
+	script := &serenaEndpointCloseScript{OriginalJobMemberObservation: members}
+	script.close = func() (*process.OriginalJobMemberCloseObservation, error) {
+		if calls.Add(1) == 1 {
+			close(entered)
+			<-release
+			return nil, &process.OriginalMemberBorrowPendingError{Stage: "scripted-late-response"}
+		}
+		return members.CloseObserved()
+	}
+	endpoint := &serenaOriginalEndpoint{source: source, members: script}
+	type result struct {
+		proof *process.OriginalJobMemberCloseObservation
+		err   error
+	}
+	first, second := make(chan result, 1), make(chan result, 1)
+	firstReceived, secondStarted, secondReceived := false, false, false
+	defer func() {
+		// Always release the delivery barrier and join both test callers before
+		// testing.T starts the member/host cleanups, including baseline RED.
+		unblock()
+		if !firstReceived {
+			select {
+			case <-first:
+			case <-time.After(5 * time.Second):
+				t.Error("first endpoint close caller did not return during cleanup")
+			}
+		}
+		if secondStarted && !secondReceived {
+			select {
+			case <-second:
+			case <-time.After(5 * time.Second):
+				t.Error("second endpoint close caller did not return during cleanup")
+			}
+		}
+	}()
+	go func() {
+		proof, err := endpoint.CloseObserved(ctx)
+		first <- result{proof, err}
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("first scripted close did not enter")
+	}
+	secondStarted = true
+	go func() {
+		proof, err := endpoint.CloseObserved(ctx)
+		second <- result{proof, err}
+	}()
+	var final result
+	select {
+	case final = <-second:
+		secondReceived = true
+	case <-ctx.Done():
+		t.Fatal("an in-flight pending response prevented independent close retry")
+	}
+	if final.err != nil || final.proof == nil {
+		t.Fatalf("independent close did not publish final facts: proof=%t error=%v", final.proof != nil, final.err)
+	}
+	if err := final.proof.Validate(source); err != nil {
+		t.Fatalf("independent close receipt is not original: %v", err)
+	}
+	unblock()
+	select {
+	case late := <-first:
+		firstReceived = true
+		if late.proof != final.proof || late.err != nil {
+			t.Fatalf("late pending replaced the published final result: same=%t error=%v", late.proof == final.proof, late.err)
+		}
+	case <-ctx.Done():
+		t.Fatal("late scripted close did not return")
+	}
+	replayed, err := endpoint.CloseObserved(ctx)
+	if replayed != final.proof || err != nil || calls.Load() != 2 {
+		t.Fatalf("final publication was not monotonic: same=%t calls=%d error=%v", replayed == final.proof, calls.Load(), err)
+	}
+}

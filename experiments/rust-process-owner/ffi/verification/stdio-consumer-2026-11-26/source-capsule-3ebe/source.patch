+func TestRustOwnerRealSplitRetainsResourcesUntilBorrowDrain(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	cwd := t.TempDir()
+	var owner *rustNativeOwner
+	var leave func()
+	t.Cleanup(func() {
+		if leave != nil {
+			leave()
+		}
+		if owner != nil && owner.raw != 0 {
+			_, _ = owner.Stop(93)
+			_, _ = owner.Finish(10000)
+			if err := owner.Release(); err != nil {
+				t.Errorf("retained native owner cleanup: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("native library cleanup: %v", err)
+		}
+	})
+	var created rustOwnerOutcome
+	var err error
+	owner, created, err = library.newRustOwner(program, cwd, []string{"-test.run=^TestRustOwnerOwnedChild$"})
+	if err != nil || owner == nil || created.PID == 0 {
+		t.Fatalf("native create: %+v err=%v", created, err)
+	}
+	original := owner.raw
+	leave, err = owner.memberGate.enterQuery(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := owner.Admit(true); err != nil {
+		t.Fatal(err)
+	}
+	exit, err := owner.Finish(10000)
+	if !errors.Is(err, ErrOriginalMemberBorrowPending) || exit.State != 0 ||
+		exit.PID != created.PID || exit.RootExit != 0 || exit.Flags != 3 || exit.Active != 0 ||
+		owner.raw != original || owner.closeStarted {
+		t.Fatalf("borrowed original closed during wait: result=%+v err=%v", exit, err)
+	}
+	// The real DLL refuses wait after terminal close. A second EXITED from
+	// the same raw owner is evidence that the blocked Product close did not
+	// consume its resources; no process is reopened by numeric PID.
+	again, closing, err := owner.waitForExit(nil, 0)
+	if err != nil || closing || again.State != 2 || again.Flags != 3 ||
+		again.PID != created.PID || again.RootExit != 0 || again.Active != 0 {
+		t.Fatalf("same native resources were consumed before permit: result=%+v closing=%t err=%v", again, closing, err)
+	}
+	if err := owner.Release(); !errors.Is(err, ErrOriginalMemberBorrowPending) || owner.raw != original {
+		t.Fatalf("original allocation released while query remained: err=%v", err)
+	}
+	if err := library.Close(); err == nil || library.activeOwners.Load() != 1 {
+		t.Fatal("wait-only exit lost its native-library pin")
+	}
+	leave()
+	settled, err := owner.Finish(0)
+	if err != nil || settled.State != 2 || settled.PID != created.PID ||
+		settled.RootExit != 0 || owner.raw != original || library.activeOwners.Load() != 1 {
+		t.Fatalf("same-owner close after drain failed: result=%+v err=%v", settled, err)
+	}
+	repeated, err := owner.Finish(0)
+	if err != nil || repeated != settled {
+		t.Fatalf("cached native close changed: result=%+v err=%v", repeated, err)
+	}
+	if err := owner.Release(); err != nil || owner.raw != 0 || library.activeOwners.Load() != 0 {
+		t.Fatalf("explicit original release failed: err=%v", err)
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatalf("idempotent native release failed: %v", err)
+	}
+}

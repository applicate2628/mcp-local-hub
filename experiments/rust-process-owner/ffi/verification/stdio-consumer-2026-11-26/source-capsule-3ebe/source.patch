+// validateCodexInstallObservation runs before public install effects and again
+// at its no-write repeat branch. The first relocation also compares the frozen
+// full config hash inside the existing writer lock.
+func validateCodexInstallObservation(ctx context.Context, server string, update ClientUpdatePlan, client clients.Client) error {
+	original := update.codexObservation
+	if original == nil {
+		return nil
+	}
+	if ctx == nil {
+		ctx = original.context
+	}
+	if ctx == nil {
+		return fmt.Errorf("%w: original Codex install context is unavailable", clients.ErrCodexTargetNameConflict)
+	}
+	if err := ctx.Err(); err != nil {
+		return errors.Join(fmt.Errorf("%w: Codex install observation context ended", clients.ErrCodexTargetNameConflict), err)
+	}
+	if client == nil || client.Name() != "codex-cli" || update.Client != "codex-cli" {
+		return fmt.Errorf("%w: original Codex client is unavailable", clients.ErrCodexTargetNameConflict)
+	}
+	desired := installClientEntryV1(server, update, "")
+	observed, err := clients.CaptureCodexInstallEntry(ctx, client, original.entryName, desired)
+	if err != nil {
+		return err
+	}
+	if observed.Snapshot != original.snapshot || observed.Transport != original.transport || observed.ToolTimeoutSec != update.ToolTimeoutSec || observed.Disabled != original.disabled {
+		return fmt.Errorf("%w: Codex source changed after planning", clients.ErrCodexTargetNameConflict)
+	}
+	request := clients.CodexTransportTargetRequest{
+		LogicalEntryName: server, DesiredTransport: clients.CodexTransportHTTP, DesiredEntry: desired,
+		ProjectRoot: original.projectRoot, WorkingDir: original.workingDir,
+	}
+	if update.codexAlreadyConfigured {
+		received, err := receiveCodexManagedInstallTarget(ctx, server, update, client)
+		if err != nil {
+			return err
+		}
+		if received != original.snapshot || !observed.HTTPMatchesDesired {
+			return fmt.Errorf("%w: received Codex relationship changed after planning", clients.ErrCodexTargetNameConflict)
+		}
+		logical, err := clients.CaptureCodexInstallEntry(ctx, client, server, desired)
+		if err != nil {
+			return err
+		}
+		if logical.Snapshot.Exists || logical.Snapshot.ConfigSHA256 != original.snapshot.ConfigSHA256 {
+			return fmt.Errorf("%w: logical Codex source changed after planning", clients.ErrCodexTargetNameConflict)
+		}
+		request.ExpectedGlobalTarget = &original.snapshot
+	}
+	adapter, ok := clients.AsCodexTransportClient(client)
+	if !ok {
+		return fmt.Errorf("%w: original Codex adapter is unavailable", clients.ErrCodexLayerRootUnresolved)
+	}
+	target, err := adapter.ResolveTransportTarget(request)
+	if err != nil {
+		return err
+	}
+	if target.TargetEntryName != update.EntryName || target.ExistingExactTarget != update.codexAlreadyConfigured {
+		return fmt.Errorf("%w: bounded Codex target changed after planning", clients.ErrCodexTargetNameConflict)
+	}
+	return ctx.Err()
+}

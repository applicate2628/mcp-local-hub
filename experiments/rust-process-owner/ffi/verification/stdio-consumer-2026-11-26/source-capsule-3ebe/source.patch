+//go:build windows
+
+package process
+
+import (
+	"encoding/binary"
+	"runtime"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// Synthetic native-layout buffers cover bounds and final-RID decoding only.
+// Actual Windows token acquisition is exercised by the existing peer tests.
+func TestTokenIntegrityRIDBuffer(t *testing.T) {
+	var label windows.Tokenmandatorylabel
+	labelSize := int(unsafe.Sizeof(label))
+	sidFieldOffset := int(unsafe.Offsetof(label.Label) + unsafe.Offsetof(label.Label.Sid))
+	pointerSize := int(unsafe.Sizeof(label.Label.Sid))
+	for _, tc := range []struct {
+		name    string
+		want    uint32
+		wantErr bool
+	}{
+		{name: "one-subauthority", want: 0x2000},
+		{name: "last-subauthority", want: 0xa1b2c3d4},
+		{name: "zero-rid", want: 0},
+		{name: "intermediate-rid", want: 0x2100},
+		{name: "maximum-subauthorities", want: 0x4000},
+		{name: "empty-buffer", wantErr: true},
+		{name: "zero-returned-length", wantErr: true},
+		{name: "short-label", wantErr: true},
+		{name: "returned-length-exceeds-buffer", wantErr: true},
+		{name: "null-sid", wantErr: true},
+		{name: "sid-before-buffer", wantErr: true},
+		{name: "sid-overlaps-label", wantErr: true},
+		{name: "sid-at-returned-end", wantErr: true},
+		{name: "maximum-sid-address", wantErr: true},
+		{name: "truncated-sid-header", wantErr: true},
+		{name: "unsupported-sid-revision", wantErr: true},
+		{name: "no-subauthorities", wantErr: true},
+		{name: "too-many-subauthorities", wantErr: true},
+		{name: "truncated-last-subauthority", wantErr: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			// Pin before encoding the self-address. Invalid addresses stay integer
+			// bytes; neither the fixture nor the decoder creates malformed pointers.
+			storage := make([]byte, labelSize+8+16*4)
+			var pinner runtime.Pinner
+			pinner.Pin(&storage[0])
+			defer pinner.Unpin()
+			base := uintptr(unsafe.Pointer(&storage[0]))
+			sidAddress := base + uintptr(labelSize)
+			sid := storage[labelSize:]
+			sid[0], sid[1], sid[7] = 1, 1, 16
+			binary.NativeEndian.PutUint32(sid[8:12], 0x2000)
+			binary.NativeEndian.PutUint32(sid[68:72], 0xfeedbeef)
+			input, returned := storage, uint32(len(storage))
+			switch tc.name {
+			case "last-subauthority":
+				sid[1] = 3
+				binary.NativeEndian.PutUint32(sid[8:12], 0x01020304)
+				binary.NativeEndian.PutUint32(sid[12:16], 0x11223344)
+				binary.NativeEndian.PutUint32(sid[16:20], 0xa1b2c3d4)
+			case "zero-rid":
+				binary.NativeEndian.PutUint32(sid[8:12], 0)
+			case "intermediate-rid":
+				binary.NativeEndian.PutUint32(sid[8:12], 0x2100)
+			case "maximum-subauthorities":
+				sid[1] = 15
+				binary.NativeEndian.PutUint32(sid[64:68], 0x4000)
+			case "empty-buffer":
+				input, returned = nil, 0
+			case "zero-returned-length":
+				returned = 0
+			case "short-label":
+				returned = uint32(labelSize - 1)
+			case "returned-length-exceeds-buffer":
+				returned++
+			case "null-sid":
+				sidAddress = 0
+			case "sid-before-buffer":
+				sidAddress = base - 1
+			case "sid-overlaps-label":
+				sidAddress = base + uintptr(labelSize-1)
+			case "sid-at-returned-end":
+				sidAddress = base + uintptr(returned)
+			case "maximum-sid-address":
+				sidAddress = ^uintptr(0)
+			case "truncated-sid-header":
+				returned = uint32(labelSize + 7)
+			case "unsupported-sid-revision":
+				sid[0] = 2
+			case "no-subauthorities":
+				sid[1] = 0
+			case "too-many-subauthorities":
+				sid[1] = 16
+			case "truncated-last-subauthority":
+				sid[1] = 2
+				returned = uint32(labelSize + 8 + 7)
+			}
+			sidField := storage[sidFieldOffset : sidFieldOffset+pointerSize]
+			switch pointerSize {
+			case 4:
+				binary.NativeEndian.PutUint32(sidField, uint32(sidAddress))
+			case 8:
+				binary.NativeEndian.PutUint64(sidField, uint64(sidAddress))
+			default:
+				t.Fatalf("unsupported native pointer size %d", pointerSize)
+			}
+			got, err := tokenIntegrityRIDFromBuffer(input, returned)
+			if tc.wantErr {
+				if err == nil || got != 0 {
+					t.Fatalf("invalid buffer returned RID %#x, error %v", got, err)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("RID = %#x, want %#x; error %v", got, tc.want, err)
+			}
+		})
+	}
+}

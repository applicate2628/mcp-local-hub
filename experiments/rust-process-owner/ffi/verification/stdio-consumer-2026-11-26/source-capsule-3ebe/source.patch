+// setFreshWindowsFixtureOwner sets the promised fixture owner explicitly.
+// Elevated Windows tokens may default new objects to BuiltinAdministrators.
+// Call only immediately after this fixture created the ordinary object; DACL
+// inheritance and hostile-owner test mutations remain separate and unchanged.
+func setFreshWindowsFixtureOwner(t *testing.T, path string, directory bool) {
+	t.Helper()
+	h := openWindowsPathForNamespaceTest(t, path, windows.READ_CONTROL|windows.WRITE_OWNER|windows.FILE_READ_ATTRIBUTES, directory)
+	defer windows.CloseHandle(h)
+	var info windows.ByHandleFileInformation
+	if err := windows.GetFileInformationByHandle(h, &info); err != nil {
+		t.Fatal(err)
+	}
+	if info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 ||
+		(info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY != 0) != directory ||
+		(!directory && info.NumberOfLinks != 1) {
+		t.Fatal("Windows fixture owner requires its fresh ordinary object")
+	}
+	beforeACL, beforeEntries, beforeControl := captureWindowsFixtureDACL(t, h)
+	current, err := currentUserSID()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := windows.SetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION, current, nil, nil, nil); err != nil {
+		t.Fatalf("set fresh Windows fixture owner: %v", err)
+	}
+	owned, err := stateFileOwnerIsCurrentUser(h)
+	if err != nil || !owned {
+		t.Fatalf("fresh Windows fixture owner readback: current=%v err=%v", owned, err)
+	}
+	afterACL, afterEntries, afterControl := captureWindowsFixtureDACL(t, h)
+	if beforeACL != afterACL || !reflect.DeepEqual(beforeEntries, afterEntries) || beforeControl != afterControl {
+		t.Fatalf("fixture owner setup changed DACL: control=%#x/%#x", beforeControl, afterControl)
+	}
+}
+
+// GetSecurityInfo may return owner/group data even for a DACL-only query, and
+// SECURITY_DESCRIPTOR.String serializes those fields too. Compare the actual
+// ACL header, each complete ACE and only DACL control bits across an owner edit.
+func captureWindowsFixtureDACL(t *testing.T, h windows.Handle) (windows.ACL, [][]byte, windows.SECURITY_DESCRIPTOR_CONTROL) {
+	t.Helper()
+	sd, err := windows.GetSecurityInfo(h, windows.SE_FILE_OBJECT, windows.DACL_SECURITY_INFORMATION)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dacl, _, err := sd.DACL()
+	if err != nil || dacl == nil {
+		t.Fatalf("fresh Windows fixture requires a non-null DACL: %v", err)
+	}
+	control, _, err := sd.Control()
+	if err != nil {
+		t.Fatal(err)
+	}
+	entries := make([][]byte, dacl.AceCount)
+	for i := range entries {
+		var ace *windows.ACCESS_ALLOWED_ACE
+		if err := windows.GetAce(dacl, uint32(i), &ace); err != nil {
+			t.Fatal(err)
+		}
+		if ace == nil || uintptr(ace.Header.AceSize) < unsafe.Sizeof(windows.ACE_HEADER{}) {
+			t.Fatal("invalid fresh Windows fixture ACE")
+		}
+		entries[i] = append([]byte(nil), unsafe.Slice((*byte)(unsafe.Pointer(ace)), int(ace.Header.AceSize))...)
+	}
+	const daclControl = windows.SE_DACL_PRESENT | windows.SE_DACL_DEFAULTED |
+		windows.SE_DACL_AUTO_INHERIT_REQ | windows.SE_DACL_AUTO_INHERITED | windows.SE_DACL_PROTECTED
+	return *dacl, entries, control & daclControl
+}

+	child := p.child.(*rustContainedChild)
+	if child.owner == nil || child.owner.raw != 0x4141 || child.noChildKnown || !child.ownsLibrary ||
+		library.activeOwners.Load() != 1 || !library.ready || api.freeCalls != 0 {
+		t.Fatal("post-create decoding error released or replaced its module/native owner")

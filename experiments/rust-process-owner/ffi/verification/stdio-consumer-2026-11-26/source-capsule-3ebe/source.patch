+func TestAutoRegisterSerena_PreparationRechecksRegistrySelection(t *testing.T) {
+	for _, sameKey := range []bool{true, false} {
+		name := "foreign-port-consumed"
+		if sameKey {
+			name = "same-key-winner"
+		}
+		t.Run(name, func(t *testing.T) {
+			regPath := autoRegisterTestEnv(t)
+			workspace := writeSerenaMarker(t, t.TempDir(), validSerenaMarkerYAML)
+			peerWorkspace := t.TempDir()
+			var peer WorkspaceEntry
+			installCalls := 0
+			stubAutoRegisterInstall(t, func(_ context.Context, _ *API, _ *config.ServerManifest, opts InstallParsedManifestOpts) (string, error) {
+				installCalls++
+				if len(opts.Workspaces) != 2 {
+					t.Errorf("final workspaces=%+v, want both fresh rows", opts.Workspaces)
+				}
+				foundPeer, foundNew := false, false
+				for _, row := range opts.Workspaces {
+					if row.WorkspaceKey == peer.WorkspaceKey {
+						foundPeer = true
+						continue
+					}
+					foundNew = true
+					if row.Port == peer.Port {
+						t.Error("reused tentative port consumed during preparation")
+					}
+				}
+				if !foundPeer || !foundNew {
+					t.Errorf("final selection omitted a row: %+v", opts.Workspaces)
+				}
+				return filepath.Join(filepath.Dir(regPath), "state", supervisorIntentFileLeaf), nil
+			})
+			stubAutoRegisterReconcile(t, func(context.Context, bool) (ReconcileResponse, error) { return ReconcileResponse{}, nil })
+			stubAutoRegisterReadiness(t, func(int, time.Duration) error { return nil })
+			previousFactory := autoRegisterNewInstallOperationFn
+			autoRegisterNewInstallOperationFn = func(a *API) (autoRegisterSerenaInstallOperation, error) {
+				operation, err := previousFactory(a)
+				operation.prepare = func(_ context.Context, _ *config.ServerManifest, opts InstallParsedManifestOpts) (time.Time, error) {
+					if len(opts.Workspaces) != 1 {
+						t.Fatalf("candidate rows=%+v", opts.Workspaces)
+					}
+					peer = opts.Workspaces[0]
+					peer.RegisteredVia = "peer"
+					peer.ClientEntries = map[string]string{"fixture-client": "peer-entry"}
+					if !sameKey {
+						peer.WorkspacePath = peerWorkspace
+						peer.WorkspaceKey = WorkspaceKey(peerWorkspace)
+						peer.TaskName = SerenaTaskNameForWorkspace(peerWorkspace)
+					}
+					reg := NewRegistry(regPath)
+					release, held, err := reg.TryLock()
+					if err != nil || !held {
+						t.Fatalf("preparation holds registry exclusion: held=%t cause=%v", held, err)
+					}
+					defer func() {
+						if err := release(); err != nil {
+							t.Error(err)
+						}
+					}()
+					if err := reg.Load(); err != nil {
+						t.Fatal(err)
+					}
+					if err := reg.PutSerena(peer); err != nil {
+						t.Fatal(err)
+					}
+					if err := reg.Save(); err != nil {
+						t.Fatal(err)
+					}
+					return time.Now().Add(time.Second), nil
+				}
+				return operation, err
+			}
+			t.Cleanup(func() { autoRegisterNewInstallOperationFn = previousFactory })
+			entry, err := NewAPI().AutoRegisterSerenaWorkspace(context.Background(), workspace)
+			if err != nil || entry == nil {
+				t.Fatalf("fresh selection: entry=%+v cause=%v", entry, err)
+			}
+			rows := loadRegSerenaRows(t, regPath)
+			if sameKey {
+				if installCalls != 0 || len(rows) != 1 || !reflect.DeepEqual(*entry, peer) {
+					t.Fatalf("concurrent winner replaced: entry=%+v peer=%+v rows=%+v install=%d", entry, peer, rows, installCalls)
+				}
+			} else if installCalls != 1 || len(rows) != 2 || entry.Port == peer.Port {
+				t.Fatalf("fresh port/set lost: entry=%+v peer=%+v rows=%+v install=%d", entry, peer, rows, installCalls)
+			}
+		})
+	}
+}

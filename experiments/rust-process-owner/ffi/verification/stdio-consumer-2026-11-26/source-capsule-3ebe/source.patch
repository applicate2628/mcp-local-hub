+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os/exec"
+)
+
+// These explicit, private construction seams qualify the existing receiving
+// facades with an already admitted library. They do not select a product
+// backend, open a second Job, or assume ownership of the caller's files/module.
+// The command must already name an absolute image and working directory.
+// A finite ctx bounds creation admission; it is never the lifetime wait context.
+func (library *rustOwnerLibrary) startRustProvisional(
+	ctx context.Context, cmd *exec.Cmd, streams rustOwnerStdio,
+	retain func(*ProvisionalProcess) error,
+) (*ProvisionalProcess, error) {
+	if retain == nil {
+		return nil, &ProvisionalNoProcessError{cause: errors.New("Rust provisional retention callback required")}
+	}
+	child := &rustContainedChild{library: library, startContext: ctx}
+	p := &ProvisionalProcess{cmd: cmd, owner: child, waitDone: make(chan struct{})}
+	child.retain = func() error { return retain(p) }
+	err := child.start(cmd, streams.Stdin, streams.Stdout, streams.Stderr)
+	if child.owner == nil {
+		return nil, &ProvisionalNoProcessError{cause: err}
+	}
+	if err == nil {
+		return p, nil
+	}
+	if !child.containedCreated() {
+		return p, p.closeStartupFailure("rust-pre-create", err)
+	}
+	// Partial creation remains with the same retained facade. Do not start a
+	// second cleanup interval or turn missing creation facts into no-child.
+	view, identityErr := p.captureStartupIdentity()
+	view.Error = errors.Join(err, identityErr)
+	return p, &creatorStartupError{owner: p, stage: "rust-post-create", cause: view.Error, observation: view}
+}
+
+func (library *rustOwnerLibrary) startRustOriginal(
+	ctx context.Context, cmd *exec.Cmd, streams rustOwnerStdio,
+	retain func(*AtCreateJobProcess) error,
+) (*AtCreateJobProcess, error) {
+	if retain == nil {
+		return nil, errors.New("Rust original-process retention callback required")
+	}
+	child := &rustContainedChild{library: library, startContext: ctx}
+	p := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	child.retain = func() error { return retain(p) }
+	err := child.start(cmd, streams.Stdin, streams.Stdout, streams.Stderr)
+	if child.owner == nil {
+		return nil, err
+	}
+	// The existing receiver owns no-child observation, the original wait and
+	// final release, including every retained startup error.
+	return p, err
+}
diff --git a/internal/process/rust_owner_facade_windows.go b/internal/process/rust_owner_facade_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..bd1c14cf60aa5f548037726603ae5b939b490cff
--- /dev/null
+++ b/internal/process/rust_owner_facade_windows.go
@@ -0,0 +1,583 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// rustContainedChild adapts capabilities; owner alone owns the native allocation.
+// The existing ProvisionalProcess or AtCreateJobProcess supplies the sole waiter.
+type rustContainedChild struct {
+	library      *rustOwnerLibrary
+	ownsLibrary  bool // immutable; only the Product factory transfers its module
+	startContext context.Context
+	foreground   bool // immutable factory intent; explicit command NoConsole wins
+	retain       func() error
+	beforeAdmit  func() error // synchronous original admission, before native resume
+	owner        *rustNativeOwner
+
+	startAttempted        atomic.Bool
+	startReturned         atomic.Bool
+	waitStarted           atomic.Bool
+	waitReturned          atomic.Bool
+	mu                    sync.Mutex
+	identity              ContainedRootIdentity
+	noChildKnown          bool
+	waitResult            containedWaitResult
+	observation           *rustFacadeObservation
+	closeEntered          bool
+	closeReturned         bool
+	closeError            error
+	nativeCloseKnown      bool
+	nativeCloseOutcome    rustOwnerOutcome
+	libraryAcquired       bool
+	libraryCloseAttempted bool
+	libraryClosed         bool
+	libraryCloseError     error
+	startupStdio          io.Closer // owned Product NUL; consumed once under mu
+	sourceCloseErr        error     // includes any failed temporary-copy close
+}
+
+type rustFacadePolicy uint8
+
+const (
+	rustFacadeObserve rustFacadePolicy = iota
+	rustFacadeAfterExit
+	rustFacadeTerminate
+	rustContainedStopCode = 1
+)
+
+type rustFacadeObservation struct {
+	policy    rustFacadePolicy
+	view      ContainedNativeSnapshot
+	actionErr error
+	err       error
+}
+
+var (
+	_ containedChild                     = (*rustContainedChild)(nil)
+	_ containedObservedChild             = (*rustContainedChild)(nil)
+	_ originalMemberTerminalOwner        = (*rustContainedChild)(nil)
+	_ originalMemberSourceProvider       = (*rustContainedChild)(nil)
+	_ provisionalCreatorObserver         = (*rustContainedChild)(nil)
+	_ provisionalCreatorTerminalObserver = (*rustContainedChild)(nil)
+	_ provisionalCreatorShutdownObserver = (*rustContainedChild)(nil)
+)
+
+func (c *rustContainedChild) start(cmd *exec.Cmd, stdin containedInputFile, stdout, stderr containedWriteFile) (retErr error) {
+	if c == nil || c.library == nil || !c.startAttempted.CompareAndSwap(false, true) {
+		return errors.New("Rust facade requires one original creation attempt")
+	}
+	defer func() {
+		known := c.owner == nil || (!c.owner.preparing.Load() && !c.owner.created.Load() &&
+			(!c.owner.createEntered.Load() || c.owner.createNoChild.Load()))
+		c.mu.Lock()
+		c.noChildKnown = known
+		if errors.Is(retErr, errRustOwnerStdioClose) {
+			// A failed temporary-copy close is not a process failure alone.
+			// Keep it in resource settlement even when native custody closes.
+			c.sourceCloseErr = errors.Join(c.sourceCloseErr, retErr)
+		}
+		c.mu.Unlock()
+		c.startReturned.Store(true)
+	}()
+	if err := creatorClosureContext(c.startContext); err != nil {
+		return err
+	}
+	prepared, err := prepareRustOwnerCommand(cmd)
+	if err != nil {
+		return err
+	}
+	input, inputOK := stdin.(*os.File)
+	output, outputOK := stdout.(*os.File)
+	errorFile, errorOK := stderr.(*os.File)
+	if !inputOK || !outputOK || !errorOK || input == nil || output == nil || errorFile == nil {
+		return errors.New("Rust facade requires three original standard files")
+	}
+	retained, _, err := c.library.startRetainedRustOwnerContext(c.startContext,
+		prepared.program, prepared.cwd, prepared.args,
+		&rustOwnerLaunchIO{argv0: &prepared.argv0, environment: prepared.environment,
+			foreground: c.foreground && !prepared.noConsole,
+			streams:    rustOwnerStdio{Stdin: input, Stdout: output, Stderr: errorFile}},
+		func(owner *rustNativeOwner) error {
+			c.owner = owner
+			if c.retain != nil {
+				return c.retain()
+			}
+			return nil
+		})
+	if retained != c.owner {
+		return errors.Join(err, errors.New("Rust facade original custody changed"))
+	}
+	if err != nil {
+		return err
+	}
+	if !c.containedCreated() {
+		return errors.New("Rust facade start returned without native custody")
+	}
+	identity, err := c.queryOriginal(c.startContext)
+	if err != nil {
+		return err
+	}
+	const ticksPerSecond = uint64(10_000_000)
+	const epochOffsetSeconds = int64(11_644_473_600)
+	birth := identity.CreationTime100ns
+	started := time.Unix(int64(birth/ticksPerSecond)-epochOffsetSeconds, int64(birth%ticksPerSecond)*100).UTC()
+	c.mu.Lock()
+	c.identity = ContainedRootIdentity{Known: true, PID: int(identity.PID),
+		StartedAt: started.Format(time.RFC3339Nano), NativeBirthFILETIME: birth}
+	c.mu.Unlock()
+	if err := creatorClosureContext(c.startContext); err != nil {
+		return err
+	}
+	if c.beforeAdmit != nil {
+		if err := c.beforeAdmit(); err != nil {
+			return err
+		}
+	}
+	if err := creatorClosureContext(c.startContext); err != nil {
+		return err
+	}
+	leave, err := c.owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return err
+	}
+	defer leave()
+	_, _, err = c.owner.callContext(c.startContext, "mh_admit1", 1, nil)
+	return err
+}
+
+func (c *rustContainedChild) queryOriginal(ctx context.Context) (rustOwnerIdentityValue, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	if c == nil || c.owner == nil || c.owner.memberGate == nil {
+		return rustOwnerIdentityValue{}, ErrContainmentUnavailable
+	}
+	leave, err := c.owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	defer leave()
+	if err := lockRustCreatorContext(ctx, &c.owner.mu); err != nil {
+		return rustOwnerIdentityValue{}, err
+	}
+	defer c.owner.mu.Unlock()
+	value, err := c.owner.queryIdentityLocked(ctx)
+	if err == nil && c.owner.originalPID != 0 && value.PID != c.owner.originalPID {
+		err = errors.Join(errRustOwnerIdentity, errors.New("facade identity changed original PID"))
+	}
+	return value, errors.Join(err, ctx.Err())
+}
+
+func (c *rustContainedChild) provisionalCustodyPresent() bool { return c != nil && c.owner != nil }
+func (c *rustContainedChild) containedCreated() bool {
+	return c != nil && c.owner != nil && c.owner.created.Load()
+}
+func (c *rustContainedChild) containedNoChildKnown() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.noChildKnown
+}
+func (c *rustContainedChild) prepareContainedObservation() {}
+func (c *rustContainedChild) containedRootIdentity() (ContainedRootIdentity, error) {
+	if c == nil {
+		return ContainedRootIdentity{}, ErrContainmentUnavailable
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.identity.Known {
+		return c.identity, errors.New("original Rust creation identity unavailable")
+	}
+	return c.identity, nil
+}
+func (c *rustContainedChild) containedStartLive(ctx context.Context) (bool, error) {
+	value, err := c.queryOriginal(ctx)
+	return err == nil && value.WaitState == 1 && value.JobMembership == 1, err
+}
+func (c *rustContainedChild) ObserveCreatorIdentity(ctx context.Context) (*CreatorIdentity, error) {
+	if c == nil || c.owner == nil {
+		return nil, ErrContainmentUnavailable
+	}
+	// The native issuer retains its original query lease through final issuance.
+	return c.owner.ObserveCreatorIdentity(ctx)
+}
+func (c *rustContainedChild) originalMemberSourceCapability(ctx context.Context) (OriginalJobMemberSource, error) {
+	if c == nil || c.owner == nil {
+		return nil, ErrContainmentUnavailable
+	}
+	return c.owner.originalMemberSourceCapability(ctx)
+}
+
+func (c *rustContainedChild) wait() containedWaitResult {
+	if c == nil || c.owner == nil {
+		return containedWaitResult{err: ErrContainmentUnavailable}
+	}
+	if !c.waitStarted.CompareAndSwap(false, true) {
+		return containedWaitResult{err: errors.New("original Rust root waiter already entered")}
+	}
+	root, err := c.owner.waitRoot(nil)
+	if root.Known && err != nil {
+		// mh_wait1 may publish a valid root exit before a separate Job query
+		// fails. This facade waiter owns only the root result: re-read its
+		// immutable cache without another native wait. Terminal observation
+		// must independently establish Job exit before any native close.
+		root, err = c.owner.waitRoot(nil)
+	}
+	result := containedWaitResult{exitCode: int(root.ExitCode), exited: root.Known, err: err}
+	c.mu.Lock()
+	c.waitResult = result
+	c.mu.Unlock()
+	c.waitReturned.Store(true)
+	return result
+}
+
+func (c *rustContainedChild) originalMemberTerminal(ctx context.Context) (*originalMemberTerminalPermit, error) {
+	if c == nil {
+		return nil, nil
+	}
+	// Refuse before sealing or consuming a one-shot terminal action. A
+	// retention receiver may see the owner while start still owns cleanup;
+	// a late close-only refusal would permanently cache an incomplete result.
+	if c.startAttempted.Load() && !c.startReturned.Load() {
+		return nil, &OriginalMemberBorrowPendingError{Stage: "rust-start-return"}
+	}
+	if c.owner == nil {
+		return nil, nil
+	}
+	return c.owner.memberGate.beginTerminal(ctx)
+}
+func (c *rustContainedChild) enterTerminal(ctx context.Context) (*originalMemberTerminalPermit, bool, error) {
+	if c == nil || c.owner == nil {
+		return nil, false, nil
+	}
+	if ctx != nil {
+		if permit, _ := ctx.Value(originalMemberTerminalContextKey{}).(*originalMemberTerminalPermit); permit != nil {
+			return permit, false, permit.validate(c.owner.memberGate)
+		}
+	}
+	permit, err := c.originalMemberTerminal(ctx)
+	return permit, true, err
+}
+
+func (c *rustContainedChild) observeTerminal(ctx context.Context, policy rustFacadePolicy) (result rustFacadeObservation) {
+	result.policy = policy
+	result.view.TerminalAction = string(creatorTerminalNotRequested)
+	if err := creatorClosureContext(ctx); err != nil {
+		result.err = err
+		return
+	}
+	if c == nil {
+		result.err = ErrContainmentUnavailable
+		return
+	}
+	permit, owned, err := c.enterTerminal(ctx)
+	if err != nil {
+		result.err = err
+		return
+	}
+	if owned {
+		defer permit.finish()
+	}
+	c.mu.Lock()
+	prior := c.observation
+	noChild := c.noChildKnown
+	result.view.RootIdentity = c.identity
+	c.mu.Unlock()
+	if prior != nil {
+		if prior.policy != policy {
+			result.err = errors.New("original Rust terminal policy already entered with a different projection")
+			return
+		}
+		return *prior
+	}
+	defer func() {
+		result.view.Error = result.err
+		if permit.nativeWasEntered() || result.view.NoChildKnown {
+			c.mu.Lock()
+			copy := result
+			c.observation = &copy
+			c.mu.Unlock()
+		}
+	}()
+	if noChild {
+		result.view.NoChildKnown = true
+		return
+	}
+	if c.owner == nil {
+		result.err = ErrContainmentUnavailable
+		return
+	}
+	observe := func() (rustOwnerWaitOutcome, error) {
+		value, closing, err := c.owner.waitForExitWithPermit(ctx, 0, permit)
+		if closing {
+			return value, errors.Join(err, errors.New("original Rust native close preceded facade observation"))
+		}
+		if value.Flags&1 != 0 {
+			result.view.RootWaitKnown = true
+			result.view.RootExitCode = int(value.RootExit)
+		}
+		if value.State == 2 {
+			result.view.OriginalJobExited = true
+		}
+		return value, err
+	}
+	if policy == rustFacadeAfterExit {
+		value, err := observe()
+		if err != nil {
+			result.err = err
+			return
+		}
+		if value.Flags&1 == 0 {
+			result.err = errors.New("original root exit required before after-exit policy")
+			return
+		}
+		if value.State == 2 {
+			return
+		}
+	}
+	if policy != rustFacadeObserve {
+		_, entered, stopErr := c.owner.stopWithPermit(ctx, rustContainedStopCode, permit)
+		if entered {
+			result.view.TerminalAction = string(creatorTerminalRequestedUnknown)
+			if !errors.Is(stopErr, errRustOwnerOutcome) {
+				if stopErr == nil {
+					result.view.TerminalAction = string(creatorTerminalRequestSucceeded)
+				} else {
+					result.view.TerminalAction = string(creatorTerminalRequestFailed)
+				}
+			}
+		}
+		result.actionErr = stopErr
+		if stopErr != nil {
+			result.err = errors.Join(stopErr, ctx.Err())
+			return
+		}
+	}
+	for {
+		value, err := observe()
+		if err != nil {
+			result.err = err
+			return
+		}
+		if value.State == 2 {
+			return
+		}
+		select {
+		case <-ctx.Done():
+			result.err = ctx.Err()
+			return
+		case <-time.After(creatorClosureAdmissionInterval):
+		}
+	}
+}
+
+func (c *rustContainedChild) settleContained(ctx context.Context, natural bool) (ContainedNativeSnapshot, error) {
+	policy := rustFacadeTerminate
+	if natural {
+		policy = rustFacadeAfterExit
+	}
+	result := c.observeTerminal(ctx, policy)
+	return result.view, result.err
+}
+func (c *rustContainedChild) terminate(milliseconds uint32) error {
+	return c.terminateBy(time.Now().Add(time.Duration(milliseconds) * time.Millisecond))
+}
+func (c *rustContainedChild) terminateBy(deadline time.Time) error {
+	ctx, cancel := context.WithDeadline(context.Background(), deadline)
+	defer cancel()
+	return c.terminateOriginalWithPermit(ctx)
+}
+func (c *rustContainedChild) terminateOriginalWithPermit(ctx context.Context) error {
+	return c.observeTerminal(ctx, rustFacadeTerminate).err
+}
+func (c *rustContainedChild) creatorBinding() (creatorClosureBinding, error) {
+	identity, err := c.containedRootIdentity()
+	return creatorClosureBinding{pid: identity.PID, startedAt: identity.StartedAt}, err
+}
+func (c *rustContainedChild) creatorStartupSnapshot() (CreatorRootExitSnapshot, error) {
+	binding, err := c.creatorBinding()
+	return CreatorRootExitSnapshot{OriginalPID: binding.pid, OriginalStartedAt: binding.startedAt}, err
+}
+func (c *rustContainedChild) creatorExitObservation() creatorExitObservation {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return creatorExitObservation{known: c.waitResult.exited, code: c.waitResult.exitCode, err: c.waitResult.err}
+}
+func (c *rustContainedChild) creatorJobExitKnown() bool {
+	if c == nil {
+		return false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.observation != nil && c.observation.view.OriginalJobExited
+}
+func (c *rustContainedChild) observeCreatorMembers(ctx context.Context) error {
+	return c.observeTerminal(ctx, rustFacadeObserve).err
+}
+func rustFacadeCreatorObservation(result rustFacadeObservation) (creatorTerminalObservation, error) {
+	return creatorTerminalObservation{action: creatorTerminalAction(result.view.TerminalAction),
+		actionErr: result.actionErr, originalJobExited: result.view.OriginalJobExited}, result.err
+}
+func (c *rustContainedChild) completeCreatorMembers(ctx context.Context) (creatorTerminalObservation, error) {
+	return rustFacadeCreatorObservation(c.observeTerminal(ctx, rustFacadeAfterExit))
+}
+func (c *rustContainedChild) terminateCreatorMembers(ctx context.Context) (creatorTerminalObservation, error) {
+	return rustFacadeCreatorObservation(c.observeTerminal(ctx, rustFacadeTerminate))
+}
+
+func (c *rustContainedChild) originalMemberCloseReady(permit *originalMemberTerminalPermit) error {
+	if c == nil {
+		return nil
+	}
+	if c.startAttempted.Load() && !c.startReturned.Load() {
+		return &OriginalMemberBorrowPendingError{Stage: "rust-start-return"}
+	}
+	if c.owner != nil {
+		if err := permit.validate(c.owner.memberGate); err != nil {
+			return err
+		}
+	}
+	if c.containedCreated() && !c.waitReturned.Load() {
+		return &OriginalMemberBorrowPendingError{Stage: "original-root-wait"}
+	}
+	return nil
+}
+
+func (c *rustContainedChild) closeOriginalWithPermit(permit *originalMemberTerminalPermit) error {
+	if err := c.originalMemberCloseReady(permit); err != nil {
+		return err
+	}
+	if c == nil {
+		return nil
+	}
+	// No other facade operation enters native close. Metadata remains retained
+	// until this finite synchronous phase returns; the root waiter has returned.
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closeReturned {
+		return c.closeError
+	}
+	if c.noChildKnown {
+		c.closeError = c.closeStartupStdioLocked()
+		c.closeError = errors.Join(c.closeError, c.closeOwnedLibraryLocked())
+		c.closeReturned = true
+		return c.closeError
+	}
+	if c.owner == nil {
+		return ErrContainmentUnavailable
+	}
+	if c.owner.preparing.Load() && !c.owner.created.Load() {
+		if c.owner.mu.TryLock() {
+			if c.owner.raw == 0 {
+				c.owner.sealed = true
+			}
+			c.owner.mu.Unlock()
+		}
+		return originalMemberCloseAdmissionPending("rust-preparation", nil)
+	}
+	if c.observation == nil || !c.observation.view.OriginalJobExited {
+		return originalMemberCloseAdmissionPending("rust-job-exit", errors.New("original Rust aggregate Job exit is unproved"))
+	}
+	gate := c.owner.memberGate
+	gate.mu.Lock()
+	deadline, bound := gate.terminalDeadline, gate.terminalBound
+	gate.mu.Unlock()
+	if !bound {
+		return originalMemberCloseAdmissionPending("rust-close-deadline", errors.New("original terminal deadline is unavailable"))
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), deadline)
+	defer cancel()
+	value, entered, closeErr := c.owner.closeExitedNative(ctx, permit)
+	c.closeEntered = c.closeEntered || entered
+	if !c.closeEntered {
+		return originalMemberCloseAdmissionPending("rust-native-close", closeErr)
+	}
+	if !errors.Is(closeErr, errRustOwnerOutcome) && (value.State == 2 || value.State == 3) {
+		c.nativeCloseKnown, c.nativeCloseOutcome = true, value
+		closeErr = errors.Join(closeErr, c.owner.releaseWithPermit(ctx, permit))
+		if c.ownsLibrary && c.library != nil {
+			// Only actual slot clearance drops the native use. Preserve a
+			// native cleanup/decode error even when its allocation is gone.
+			if c.library.activeOwners.Load() == 0 {
+				closeErr = errors.Join(closeErr, c.closeOwnedLibraryLocked())
+			} else {
+				closeErr = errors.Join(closeErr, errors.New("original Rust native allocation remains retained"))
+			}
+		}
+	}
+	closeErr = errors.Join(closeErr, c.closeStartupStdioLocked())
+	c.closeReturned, c.closeError = true, closeErr
+	return closeErr
+}
+
+// closeOwnedLibraryLocked records the actual module close result without
+// observing mutable library state during a later bounded outcome projection.
+func (c *rustContainedChild) closeOwnedLibraryLocked() error {
+	if !c.ownsLibrary || c.library == nil {
+		return nil
+	}
+	c.libraryCloseAttempted = true
+	c.libraryCloseError = c.library.Close()
+	c.libraryClosed = c.libraryCloseError == nil
+	return c.libraryCloseError
+}
+
+// closeStartupStdio also runs after create returns. The terminal path shares
+// this cache, including failure, and never retries a consumed source handle.
+func (c *rustContainedChild) closeStartupStdio() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closeStartupStdioLocked()
+}
+
+func (c *rustContainedChild) closeStartupStdioLocked() error {
+	if source := c.startupStdio; source != nil {
+		c.startupStdio = nil
+		c.sourceCloseErr = errors.Join(c.sourceCloseErr, source.Close())
+	}
+	return c.sourceCloseErr
+}
+
+func (c *rustContainedChild) close() error {
+	permit, err := c.originalMemberTerminal(nil)
+	if err != nil {
+		return err
+	}
+	defer permit.finish()
+	return c.closeOriginalWithPermit(permit)
+}
+
+func (c *rustContainedChild) closeContainedJobBackstop() error {
+	if c == nil {
+		return nil
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.noChildKnown {
+		if c.closeReturned {
+			return c.closeError
+		}
+		if c.startupStdio != nil || (c.ownsLibrary && c.library != nil) {
+			return errors.New("original Rust startup resource close is pending")
+		}
+		return c.sourceCloseErr
+	}
+	if c.closeReturned {
+		return c.closeError
+	}
+	// ABI1 closes only after verified exit; it exposes no pending Job-close
+	// operation. Retain the same owner instead of inventing kill-on-close proof.
+	return errors.New("original Rust pending Job close backstop is unavailable")
+}

+		t.Fatal(err)
+	}
+	waitRustMemberMarker(t, ctx, f.marker+".grandchild")
+	rootWait, err := f.owner.WaitRootWithin(ctx)
+	if err != nil || !rootWait.Known || rootWait.ExitCode != 7 {
+		t.Fatalf("original root exit: %+v %v", rootWait, err)
+	}
+	members, source := acquireRustNativeMembers(t, ctx, f.owner)
+	before := members.Snapshot()
+	state := members.native.(*rustOwnerMemberObservation)
+	if !before.Complete || before.PreTotal != 2 || before.PreActive != 1 || len(before.Rows) != 1 ||
+		before.Rows[0].PID == f.root.PID || before.OriginalCreationSHA256 != expectedRustMemberCreation(f) ||
+		state.snapshot.Original.PID != f.root.PID || state.snapshot.Original.CreationTime100ns != f.root.CreationTime100ns {
+		t.Fatal("child-only census replaced historical original binding")
+	}
+	leaf := before.Rows[0].PID
+	if err := members.MatchOwnerPID(ctx, leaf); err != nil {
+		t.Fatal(err)
+	}
+	if err := members.MatchOwnerPID(ctx, f.root.PID); err == nil {
+		t.Fatal("exited unacquired root matched the live member set")
+	}
+	// Observe real whole-Job completion through the retained original owner;
+	// no PID reopen or sleeping assumption establishes the leaf's exit.
+	for {
+		wait, closed, err := f.owner.waitForExit(ctx, 0)
+		if err != nil || closed {
+			t.Fatalf("retained native wait: closed=%t err=%v", closed, err)
+		}
+		if wait.State == 2 {
+			if wait.Active != 0 || wait.RootExit != 7 {
+				t.Fatal("native whole-Job exit facts disagree")
+			}
+			break
+		}
+	}
+	for _, query := range []func() error{
+		func() error { return members.Revalidate(ctx) },
+		func() error { return members.MatchOwnerPID(ctx, leaf) },
+	} {
+		err := query()
+		var native *rustOwnerMemberQueryError
+		if !errors.As(err, &native) || errors.Is(err, errRustOwnerMembers) || errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("exited retained descendant was accepted or failed only transport/deadline: %v", err)
+		}
+	}
+	if !reflect.DeepEqual(before, members.Snapshot()) {
+		t.Fatal("failed fresh query replaced historical acquisition")
+	}
+	closeProof, err := members.CloseObserved()
+	if err != nil || !closeProof.Finalized() || closeProof.Validate(source) != nil ||
+		len(closeProof.Snapshot().Resources) != 1 || !closeProof.Snapshot().Resources[0].Closed {
+		t.Fatalf("exited retained descendant close: %v", err)
+	}
+	settled, err := f.owner.FinishWithin(ctx)
+	if err != nil || settled.State != 2 || settled.RootExit != 7 {
+		t.Fatalf("original settlement after member drain: %+v %v", settled, err)
+	}
+	if err := f.owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/process/rust_owner_members_windows.go b/internal/process/rust_owner_members_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..56794711c710a7265fac1e3d1bc89ee3b35a4cc5
--- /dev/null
+++ b/internal/process/rust_owner_members_windows.go
@@ -0,0 +1,506 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"runtime"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+	"unicode/utf16"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var _ originalMemberSourceProvider = (*rustNativeOwner)(nil)
+
+var rustOwnerMemberExports = [...]string{
+	"mh_members_observe1", "mh_members_snapshot1", "mh_members_revalidate1", "mh_members_close1",
+}
+
+// Both constructors call this while owner is still private. The gate/source
+// binding is immutable after publication; legacy13 deliberately has no source.
+func installRustOwnerMemberSource(owner *rustNativeOwner) {
+	if owner == nil || owner.library == nil {
+		return
+	}
+	owner.library.mu.Lock()
+	defer owner.library.mu.Unlock()
+	installRustOwnerMemberSourceLocked(owner)
+}
+
+// owner is private and library.mu is held; installation must not reacquire it.
+func installRustOwnerMemberSourceLocked(owner *rustNativeOwner) {
+	if owner.memberGate == nil || owner.memberGate.source != nil ||
+		!owner.library.ready || owner.library.closeAttempted || !rustOwnerMemberExportsPresent(owner.library) {
+		return
+	}
+	gate := owner.memberGate
+	source := &originalMemberSource{gate: gate}
+	gate.source = source
+	source.available = func() error {
+		if owner.memberGate != gate || gate.source != source {
+			return errors.New("original Rust member source binding changed")
+		}
+		return nil
+	}
+	source.acquire = owner.acquireOriginalRustMembers
+	source.revalidate = owner.revalidateOriginalRustMembers
+	source.close = owner.closeOriginalRustMembers
+}
+
+// library.mu is held by the caller.
+func rustOwnerMemberExportsPresent(library *rustOwnerLibrary) bool {
+	for _, name := range rustOwnerMemberExports {
+		if library.procedures[name] == 0 {
+			return false
+		}
+	}
+	return true
+}
+func (owner *rustNativeOwner) originalMemberSourceCapability(ctx context.Context) (OriginalJobMemberSource, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	if owner == nil || owner.memberGate == nil || owner.memberGate.source == nil {
+		return nil, errors.New("original Rust member protocol is unavailable")
+	}
+	exit, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return nil, err
+	}
+	defer exit()
+	if err := lockRustCreatorContext(ctx, &owner.mu); err != nil {
+		return nil, err
+	}
+	defer owner.mu.Unlock()
+	if owner.library == nil {
+		return nil, errors.New("original Rust library is unavailable")
+	}
+	if err := lockRustCreatorContext(ctx, &owner.library.mu); err != nil {
+		return nil, err
+	}
+	defer owner.library.mu.Unlock()
+	if err := owner.memberReadyLocked(); err != nil {
+		return nil, err
+	}
+	return owner.memberGate.source, ctx.Err()
+}
+
+// owner.mu and library.mu are held, in that order.
+func (owner *rustNativeOwner) memberReadyLocked() error {
+	if owner.raw == 0 || owner.originalPID == 0 || owner.closeStarted || owner.library == nil ||
+		!owner.library.ready || owner.library.closeAttempted || !rustOwnerMemberExportsPresent(owner.library) {
+		return errors.New("original Rust member owner or complete protocol is unavailable")
+	}
+	return nil
+}
+
+// The native budget is derived only after mutex admission. It does not cancel
+// an already entered syscall or bound callback copyout and required cleanup.
+func rustOwnerMemberBudget(ctx context.Context) (uint32, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return 0, err
+	}
+	deadline, _ := ctx.Deadline()
+	left := time.Until(deadline)
+	if left <= 0 {
+		return 0, context.DeadlineExceeded
+	}
+	if left >= 60*time.Second {
+		return 60000, nil
+	}
+	return uint32((left + time.Millisecond - 1) / time.Millisecond), nil
+}
+
+type rustOwnerMemberObservation struct {
+	owner          *rustNativeOwner
+	entered        bool
+	noReservation  bool
+	generation     uint64
+	snapshotKnown  bool
+	snapshot       rustOwnerMemberSnapshot
+	closeEntered   bool
+	closeFinalized bool
+	closeView      OriginalJobMemberCloseSnapshotV1
+	closeErr       error
+}
+
+// All foreign-writable records contain only scalars. Pinning the whole record
+// keeps every output slot stable while the copy-only Go receiver grows stacks.
+type rustOwnerMemberBuffers struct {
+	report     rustOwnerMemberReport
+	out        rustOwnerOutcome
+	generation uint64
+	finalized  uint32
+}
+type rustOwnerMemberReceiver struct {
+	generation uint64
+	close      bool
+	calls      int
+	snapshot   rustOwnerMemberSnapshot
+	receipt    rustOwnerMemberClose
+	err        error
+}
+
+var rustOwnerMemberReceivers sync.Map
+var rustOwnerMemberSequence atomic.Uint64
+var rustOwnerMemberCallback = syscall.NewCallback(receiveRustOwnerMembers)
+
+func registerRustOwnerMemberReceiver(state *rustOwnerMemberReceiver) (uintptr, error) {
+	for {
+		prior := rustOwnerMemberSequence.Load()
+		if prior == ^uint64(0) {
+			return 0, invalidRustOwnerMembers("receiver token exhausted")
+		}
+		if rustOwnerMemberSequence.CompareAndSwap(prior, prior+1) {
+			token := uintptr(prior + 1)
+			rustOwnerMemberReceivers.Store(token, state)
+			return token, nil
+		}
+	}
+}
+func receiveRustOwnerMembers(pointer unsafe.Pointer, bytes uint32, token uintptr) (returned uintptr) {
+	value, ok := rustOwnerMemberReceivers.Load(token)
+	if !ok {
+		return 0
+	}
+	state := value.(*rustOwnerMemberReceiver)
+	defer func() {
+		if recover() != nil {
+			state.snapshot = rustOwnerMemberSnapshot{}
+			state.receipt = rustOwnerMemberClose{}
+			state.err = errors.Join(state.err, invalidRustOwnerMembers("member receiver panicked"))
+		}
+	}()
+	state.calls++
+	if state.calls != 1 {
+		state.snapshot = rustOwnerMemberSnapshot{}
+		state.receipt = rustOwnerMemberClose{}
+		state.err = errors.Join(state.err, invalidRustOwnerMembers("repeated member receiver"))
+		return 0
+	}
+	if state.close {
+		state.receipt, state.err = copyRustOwnerMemberClose((*rustOwnerMemberCloseABI)(pointer), bytes, state.generation)
+	} else {
+		state.snapshot, state.err = copyRustOwnerMemberSnapshot((*rustOwnerMemberSnapshotABI)(pointer), bytes, state.generation)
+	}
+	return 0
+}
+func rustOwnerMemberReceiverResult(status uint32, state *rustOwnerMemberReceiver) error {
+	if (status == 0 && state.calls != 1) || (status != 0 && state.calls != 0) {
+		return errors.Join(state.err, invalidRustOwnerMembers("status contradicts member receiver count"))
+	}
+	return state.err
+}
+
+func (owner *rustNativeOwner) acquireOriginalRustMembers(ctx context.Context, observation *OriginalJobMemberObservation) error {
+	state := &rustOwnerMemberObservation{owner: owner}
+	observation.native = state
+	if err := lockRustCreatorContext(ctx, &owner.mu); err != nil {
+		return err
+	}
+	defer owner.mu.Unlock()
+	if owner.library == nil {
+		return errors.New("original Rust library is unavailable")
+	}
+	if err := lockRustCreatorContext(ctx, &owner.library.mu); err != nil {
+		return err
+	}
+	defer owner.library.mu.Unlock()
+	if err := owner.memberReadyLocked(); err != nil {
+		return err
+	}
+	budget, err := rustOwnerMemberBudget(ctx)
+	if err != nil {
+		return err
+	}
+	var wire rustOwnerMemberBuffers
+	var pinned runtime.Pinner
+	pinned.Pin(&wire)
+	defer pinned.Unpin()
+	state.entered = true
+	status, _, _ := syscall.SyscallN(owner.library.procedures["mh_members_observe1"],
+		owner.raw, 1, uintptr(budget), uintptr(unsafe.Pointer(&wire.generation)),
+		uintptr(unsafe.Pointer(&wire.report)), 24, uintptr(unsafe.Pointer(&wire.out)), 48)
+	runtime.KeepAlive(owner)
+	// Never derive this call's reservation from a later historical snapshot.
+	state.generation = wire.generation
+	valid, callErr := decodeRustOwnerMemberCall(uint32(status), wire.out, wire.report, owner.originalPID)
+	if state.generation == 0 {
+		state.noReservation = valid && callErr != nil
+		if callErr == nil {
+			callErr = invalidRustOwnerMembers("acquisition omitted new generation")
+		}
+		return errors.Join(callErr, ctx.Err())
+	}
+	if uint32(status) == 1 || uint32(status) == 2 {
+		callErr = errors.Join(callErr, invalidRustOwnerMembers("preflight refusal transferred a generation"))
+	}
+	snapshot, copyErr := owner.snapshotOriginalRustMembersLocked(state.generation)
+	if copyErr == nil {
+		state.snapshot, state.snapshotKnown = snapshot, true
+		// Publish every acquired resource before fallible Product formatting.
+		// These are facts; the batch hook alone owns the native close operation.
+		for _, resource := range snapshot.Resources {
+			view := rustOwnerMemberResourceView(resource)
+			observation.resources = append(observation.resources, &originalMemberResource{view: view})
+			observation.view.Resources = append(observation.view.Resources, view)
+		}
+		if snapshot.Pre != nil {
+			observation.view.PreTotal, observation.view.PreActive = snapshot.Pre.Total, snapshot.Pre.Active
+		}
+		if snapshot.Post != nil {
+			observation.view.PostTotal, observation.view.PostActive = snapshot.Post.Total, snapshot.Post.Active
+		}
+		if callErr == nil && !snapshot.Complete {
+			copyErr = invalidRustOwnerMembers("successful acquisition returned an incomplete snapshot")
+		}
+		var queryErr *rustOwnerMemberQueryError
+		if snapshot.Complete && errors.As(callErr, &queryErr) && queryErr.Source != 3 {
+			copyErr = errors.Join(copyErr, invalidRustOwnerMembers("failed acquisition returned complete facts"))
+		}
+		for _, resource := range snapshot.Resources {
+			if resource.Flags&rustOwnerMemberAttempted != 0 {
+				copyErr = errors.Join(copyErr, invalidRustOwnerMembers("new acquisition returned already closed resources"))
+				break
+			}
+		}
+	}
+	if err := errors.Join(callErr, copyErr, ctx.Err()); err != nil {
+		return err
+	}
+	return populateOriginalRustMemberFacts(ctx, observation, snapshot)
+}
+
+func (owner *rustNativeOwner) snapshotOriginalRustMembersLocked(generation uint64) (rustOwnerMemberSnapshot, error) {
+	state := &rustOwnerMemberReceiver{generation: generation}
+	token, err := registerRustOwnerMemberReceiver(state)
+	if err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	defer rustOwnerMemberReceivers.Delete(token)
+	var wire rustOwnerMemberBuffers
+	var pinned runtime.Pinner
+	pinned.Pin(&wire)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(owner.library.procedures["mh_members_snapshot1"],
+		owner.raw, 1, uintptr(generation), rustOwnerMemberCallback, token,
+		uintptr(unsafe.Pointer(&wire.report)), 24, uintptr(unsafe.Pointer(&wire.out)), 48)
+	runtime.KeepAlive(owner)
+	_, callErr := decodeRustOwnerMemberCall(uint32(status), wire.out, wire.report, owner.originalPID)
+	err = errors.Join(callErr, rustOwnerMemberReceiverResult(uint32(status), state))
+	if err == nil && state.snapshot.Original.PID != owner.originalPID {
+		err = invalidRustOwnerMembers("historical original PID contradicts retained owner")
+	}
+	if err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	return state.snapshot, nil
+}
+
+func populateOriginalRustMemberFacts(ctx context.Context, observation *OriginalJobMemberObservation, snapshot rustOwnerMemberSnapshot) error {
+	// Same original-creation domain and UTC formatting as the existing provider.
+	// The Rust Job basis describes its constructor-established association; it
+	// deliberately does not pretend to be the Go provider's numeric Job handle.
+	const ticksPerSecond = uint64(10_000_000)
+	const epochOffsetSeconds = int64(11_644_473_600)
+	birth := snapshot.Original.CreationTime100ns
+	started := time.Unix(int64(birth/ticksPerSecond)-epochOffsetSeconds, int64(birth%ticksPerSecond)*100).UTC()
+	observation.view.OriginalCreationSHA256 = sidFormatObservationDigest([]byte(
+		fmt.Sprintf("original-creation-v1|%d|%s", snapshot.Original.PID, started.Format(time.RFC3339Nano))))
+	observation.view.OriginalJobSHA256 = sidFormatObservationDigest([]byte(
+		"original-job-custody-rust-v1|" + observation.view.OriginalCreationSHA256))
+	for _, identity := range snapshot.Rows {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		path := string(utf16.Decode(identity.ImageUTF16))
+		if !slices.Equal(utf16.Encode([]rune(path)), identity.ImageUTF16) {
+			return errors.New("original Rust member image cannot be represented losslessly by Product")
+		}
+		input := slices.Clone(identity.TokenUserSID)
+		sid := (*windows.SID)(unsafe.Pointer(&input[0]))
+		if !sid.IsValid() || sid.Len() != len(input) {
+			return errors.New("original Rust member SID is invalid")
+		}
+		principal, receipt, formatErr := FormatSIDObserved(sid)
+		if formatErr == nil {
+			if receipt == nil {
+				formatErr = errors.New("original Rust member SID receipt missing")
+			} else {
+				formatErr = receipt.ValidateInput(sid, principal)
+			}
+		}
+		runtime.KeepAlive(input)
+		if formatErr != nil {
+			return formatErr
+		}
+		observation.view.Rows = append(observation.view.Rows, OriginalJobMemberRowV1{
+			PID: identity.PID, NativeBirthFILETIME: identity.CreationTime100ns,
+			ImagePathSHA256:    sidFormatObservationDigest([]byte(path)),
+			PrincipalSIDSHA256: sidFormatObservationDigest([]byte(principal)),
+			MembershipDefined:  true, IsMember: true, LiveDefined: true, Live: true,
+		})
+	}
+	raw, err := json.Marshal(observation.view.Rows)
+	if err != nil {
+		return err
+	}
+	observation.view.MembershipSHA256 = sidFormatObservationDigest(raw)
+	return ctx.Err()
+}
+
+func (owner *rustNativeOwner) revalidateOriginalRustMembers(ctx context.Context, observation *OriginalJobMemberObservation, pid uint32) error {
+	state, ok := observation.native.(*rustOwnerMemberObservation)
+	if !ok || state.owner != owner || state.generation == 0 || !state.snapshotKnown || !state.snapshot.Complete {
+		return errors.New("original Rust member acquisition is unavailable")
+	}
+	if err := lockRustCreatorContext(ctx, &owner.mu); err != nil {
+		return err
+	}
+	defer owner.mu.Unlock()
+	if err := lockRustCreatorContext(ctx, &owner.library.mu); err != nil {
+		return err
+	}
+	defer owner.library.mu.Unlock()
+	if err := owner.memberReadyLocked(); err != nil {
+		return err
+	}
+	if state.closeEntered {
+		return errors.New("original Rust member close has entered")
+	}
+	budget, err := rustOwnerMemberBudget(ctx)
+	if err != nil {
+		return err
+	}
+	var wire rustOwnerMemberBuffers
+	var pinned runtime.Pinner
+	pinned.Pin(&wire)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(owner.library.procedures["mh_members_revalidate1"],
+		owner.raw, 1, uintptr(state.generation), uintptr(budget), uintptr(pid),
+		uintptr(unsafe.Pointer(&wire.report)), 24, uintptr(unsafe.Pointer(&wire.out)), 48)
+	runtime.KeepAlive(owner)
+	_, callErr := decodeRustOwnerMemberCall(uint32(status), wire.out, wire.report, owner.originalPID)
+	return errors.Join(callErr, ctx.Err())
+}
+
+func rustOwnerMemberResourceView(resource rustOwnerMemberResource) OriginalJobMemberResourceV1 {
+	view := OriginalJobMemberResourceV1{PID: resource.PID, Acquired: true,
+		BorrowedOriginal: resource.Flags&rustOwnerMemberBorrowed != 0,
+		CloseAttempted:   resource.Flags&rustOwnerMemberAttempted != 0,
+		Closed:           resource.Flags&rustOwnerMemberClosed != 0}
+	if resource.Flags&rustOwnerMemberCloseFailed != 0 {
+		view.CloseError = &SIDFormatFailureV1{Code: "ORIGINAL_MEMBER_HANDLE_CLOSE_FAILED"}
+	}
+	return view
+}
+
+// Called outside gate.mu after admitted queries have drained. Only a proven
+// refusal before SyscallN may request retry; an entered ambiguous result is
+// immutable, even if a later native receipt might look more favorable.
+func (owner *rustNativeOwner) closeOriginalRustMembers(ctx context.Context, observation *OriginalJobMemberObservation) (OriginalJobMemberCloseSnapshotV1, bool, error) {
+	empty := OriginalJobMemberCloseSnapshotV1{Schema: "original-job-member-close-v1", Version: 1,
+		Resources: []OriginalJobMemberResourceV1{}, CleanupErrors: []SIDFormatFailureV1{}, Complete: true}
+	state, ok := observation.native.(*rustOwnerMemberObservation)
+	if observation.native == nil {
+		return empty, true, nil
+	} // acquisition never entered
+	if !ok || state.owner != owner {
+		return OriginalJobMemberCloseSnapshotV1{}, false, errors.New("original Rust member close source changed")
+	}
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("rust-owner-context", err)
+		}
+	}
+	if !owner.mu.TryLock() {
+		return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("rust-owner-mutex", nil)
+	}
+	defer owner.mu.Unlock()
+	if state.closeEntered {
+		return state.closeView, state.closeFinalized, state.closeErr
+	}
+	if !state.entered || state.noReservation {
+		state.closeEntered, state.closeFinalized, state.closeView = true, true, empty
+		return empty, true, nil
+	}
+	if state.generation == 0 {
+		state.closeEntered = true
+		state.closeErr = invalidRustOwnerMembers("entered acquisition left reservation indeterminate")
+		return OriginalJobMemberCloseSnapshotV1{}, false, state.closeErr
+	}
+	if owner.library == nil {
+		return OriginalJobMemberCloseSnapshotV1{}, false, errors.New("original Rust member library missing")
+	}
+	if !owner.library.mu.TryLock() {
+		return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("rust-library-mutex", nil)
+	}
+	defer owner.library.mu.Unlock()
+	if err := owner.memberReadyLocked(); err != nil {
+		return OriginalJobMemberCloseSnapshotV1{}, false, err
+	}
+	receiver := &rustOwnerMemberReceiver{generation: state.generation, close: true}
+	token, err := registerRustOwnerMemberReceiver(receiver)
+	if err != nil {
+		return OriginalJobMemberCloseSnapshotV1{}, false, err
+	}
+	defer rustOwnerMemberReceivers.Delete(token)
+	var wire rustOwnerMemberBuffers
+	var pinned runtime.Pinner
+	pinned.Pin(&wire)
+	defer pinned.Unpin()
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return OriginalJobMemberCloseSnapshotV1{}, false, originalMemberCloseAdmissionPending("rust-native-entry", err)
+		}
+	}
+	state.closeEntered = true
+	status, _, _ := syscall.SyscallN(owner.library.procedures["mh_members_close1"],
+		owner.raw, 1, uintptr(state.generation), uintptr(unsafe.Pointer(&wire.finalized)),
+		rustOwnerMemberCallback, token, uintptr(unsafe.Pointer(&wire.report)), 24,
+		uintptr(unsafe.Pointer(&wire.out)), 48)
+	runtime.KeepAlive(owner)
+	state.closeFinalized = wire.finalized == 1 // independent of callback validity
+	_, callErr := decodeRustOwnerMemberCall(uint32(status), wire.out, wire.report, owner.originalPID)
+	err = errors.Join(callErr, rustOwnerMemberReceiverResult(uint32(status), receiver))
+	if wire.finalized > 1 || (uint32(status) == 0 && wire.finalized != 1) {
+		err = errors.Join(err, invalidRustOwnerMembers("invalid close finalization slot"))
+	}
+	for _, resource := range receiver.receipt.Resources {
+		if (resource.Flags&rustOwnerMemberBorrowed != 0) != (resource.PID == owner.originalPID) {
+			err = errors.Join(err, invalidRustOwnerMembers("close changed borrowed original"))
+			break
+		}
+	}
+	if state.snapshotKnown && !sameRustOwnerMemberResourceSet(state.snapshot.Resources, receiver.receipt.Resources) {
+		err = errors.Join(err, invalidRustOwnerMembers("close omitted or replaced retained resources"))
+	}
+	if err != nil {
+		state.closeErr = err
+		return OriginalJobMemberCloseSnapshotV1{}, state.closeFinalized, err
+	}
+	view := empty
+	view.Complete = receiver.receipt.Complete
+	for _, resource := range receiver.receipt.Resources {
+		value := rustOwnerMemberResourceView(resource)
+		view.Resources = append(view.Resources, value)
+		if value.CloseError != nil {
+			view.CleanupErrors = append(view.CleanupErrors, *value.CloseError)
+			err = errors.Join(err, fmt.Errorf("original Rust member PID %d CloseHandle failed (code %d): %w",
+				resource.PID, resource.CloseError, syscall.Errno(uint32(resource.CloseError))))
+		}
+	}
+	state.closeView, state.closeErr = view, err
+	// A late caller cancellation belongs to that caller's response, not the
+	// retained cleanup verdict. Common custody applies it after publication.
+	return view, state.closeFinalized, err
+}

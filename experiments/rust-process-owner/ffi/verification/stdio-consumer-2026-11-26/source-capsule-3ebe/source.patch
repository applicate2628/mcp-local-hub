+
+func TestRustOwnerIdentityWireValidation(t *testing.T) {
+	image := []uint16{'C', ':', '\\', 'c', 'h', 'i', 'l', 'd'}
+	base := rustOwnerIdentityABI{
+		Size: 120, Version: 1, PID: 42, JobMembership: 1,
+		CreationTime100ns: 123456, WaitState: 1, SIDLen: 12,
+		Image: rustOwnerUTF16{Data: &image[0], Len: uintptr(len(image))},
+	}
+	base.SID[0], base.SID[1] = 1, 1
+	if value, err := copyRustOwnerIdentity(&base, 120); err != nil ||

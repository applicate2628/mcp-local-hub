+package process
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestOriginalJobMemberPendingCloseValidationConcurrentFinalization(t *testing.T) {
+	gate := newOriginalMemberCustody()
+	source := &originalMemberSource{gate: gate}
+	gate.source = source
+	closeCalls := 0
+	owner := &OriginalJobMemberObservation{
+		source: source,
+		resources: []*originalMemberResource{{
+			view: OriginalJobMemberResourceV1{PID: 42, Acquired: true},
+			close: func() error {
+				closeCalls++
+				return nil
+			},
+		}},
+	}
+	if err := gate.reserve(owner); err != nil {
+		t.Fatal(err)
+	}
+	leave, err := gate.enterQuery(owner)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(leave)
+
+	pending, err := owner.CloseObserved()
+	if !errors.Is(err, ErrOriginalMemberBorrowPending) || pending == nil || !pending.Snapshot().Pending {
+		t.Fatalf("entered query did not retain pending close: proof=%v err=%v", pending != nil, err)
+	}
+
+	// These operations have no ordering between them. A Pending proof remains
+	// invalid while the last query publishes the owner's final close receipt.
+	start := make(chan struct{})
+	validation := make(chan error, 1)
+	finalized := make(chan struct{})
+	go func() {
+		<-start
+		validation <- pending.Validate(source)
+	}()
+	go func() {
+		<-start
+		leave()
+		close(finalized)
+	}()
+	close(start)
+	validationErr := <-validation
+	<-finalized
+	if validationErr == nil {
+		t.Fatal("pending close proof was accepted")
+	}
+
+	final, err := owner.CloseObserved()
+	if err != nil || final == nil || final == pending {
+		t.Fatalf("final close receipt not published: proof=%v err=%v", final != nil, err)
+	}
+	if err := final.Validate(source); err != nil {
+		t.Fatalf("same-owner final receipt rejected: %v", err)
+	}
+	if pending.Finalized() {
+		t.Fatal("old pending proof acquired final authority")
+	}
+	if err := pending.Validate(source); err == nil {
+		t.Fatal("old pending proof became final")
+	}
+	if closeCalls != 1 {
+		t.Fatalf("owned resource closed %d times, want exactly once", closeCalls)
+	}
+}
+
+func TestOriginalJobMemberCloseFinality(t *testing.T) {
+	var nilProof *OriginalJobMemberCloseObservation
+	for _, proof := range []*OriginalJobMemberCloseObservation{
+		nilProof,
+		{},
+		{owner: &OriginalJobMemberObservation{}},
+	} {
+		if proof.Finalized() || proof.Validate(nil) == nil {
+			t.Fatal("absent or unowned close receipt acquired final authority")
+		}
+	}
+	for _, tc := range []struct {
+		name                  string
+		owned, borrowed, fail bool
+	}{
+		{name: "empty"},
+		{name: "borrowed-original", borrowed: true},
+		{name: "owned-success", owned: true},
+		{name: "owned-failure", owned: true, fail: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			gate := newOriginalMemberCustody()
+			source := &originalMemberSource{gate: gate}
+			gate.source = source
+			owner := &OriginalJobMemberObservation{source: source}
+			closeCalls := 0
+			var closeFailure error
+			if tc.fail {
+				closeFailure = errors.New("controlled member close failure")
+			}
+			if tc.owned || tc.borrowed {
+				owner.resources = []*originalMemberResource{{
+					view: OriginalJobMemberResourceV1{PID: 42, Acquired: true, BorrowedOriginal: tc.borrowed},
+					close: func() error {
+						closeCalls++
+						return closeFailure
+					},
+				}}
+			}
+			if err := gate.reserve(owner); err != nil {
+				t.Fatal(err)
+			}
+			proof, err := owner.CloseObserved()
+			if !errors.Is(err, closeFailure) || !proof.Finalized() {
+				t.Fatalf("close did not publish final facts: finalized=%t error=%v", proof.Finalized(), err)
+			}
+			wantComplete := !tc.fail
+			if proof.Snapshot().Complete != wantComplete {
+				t.Fatal("close success was confused with finality")
+			}
+			if (proof.Validate(source) == nil) != wantComplete {
+				t.Fatal("same-source validation lost the cleanup result")
+			}
+			foreign := &originalMemberSource{gate: newOriginalMemberCustody()}
+			if proof.Validate(foreign) == nil || proof.Validate(nil) == nil {
+				t.Fatal("final receipt accepted an absent or foreign source")
+			}
+			copied := *proof
+			if copied.Finalized() || copied.Validate(source) == nil {
+				t.Fatal("copied receipt acquired the original receipt's authority")
+			}
+			replayed, replayErr := owner.CloseObserved()
+			if replayed != proof || !errors.Is(replayErr, closeFailure) {
+				t.Fatalf("final result changed on replay: same=%t error=%v", replayed == proof, replayErr)
+			}
+			wantCalls := 0
+			if tc.owned {
+				wantCalls = 1
+			}
+			if closeCalls != wantCalls {
+				t.Fatalf("owned close calls=%d, want %d", closeCalls, wantCalls)
+			}
+		})
+	}
+}

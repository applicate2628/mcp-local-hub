+// These are real FileStreamInfo queries on test-owned files and directories.
+// The local tree value supplies only limits; it cannot claim acquired tree,
+// process settlement, installation or deletion authority.
+func TestSerenaOwnedTreeStreamEnumeration(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		directory bool
+		contents  []byte
+		named     bool
+		invalid   bool
+	}{
+		{name: "directory_no_streams", directory: true},
+		{name: "empty_file", contents: []byte{}},
+		{name: "file", contents: []byte("abc")},
+		{name: "directory_named_stream", directory: true, named: true},
+		{name: "file_named_stream", contents: []byte("abc"), named: true},
+		{name: "invalid_handle", invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			handle := windows.InvalidHandle
+			if !tc.invalid {
+				path := filepath.Join(hardenedTempDir(t), "entry")
+				if tc.directory {
+					if err := os.Mkdir(path, 0o700); err != nil {
+						t.Fatal(err)
+					}
+				} else if err := os.WriteFile(path, tc.contents, 0o600); err != nil {
+					t.Fatal(err)
+				}
+				if tc.named {
+					if err := os.WriteFile(path+":extra", []byte("named"), 0o600); err != nil {
+						t.Fatalf("create actual named data stream: %v", err)
+					}
+				}
+				nativePath, err := windows.UTF16PtrFromString(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				handle, err = windows.CreateFile(nativePath, windows.FILE_READ_ATTRIBUTES,
+					windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE,
+					nil, windows.OPEN_EXISTING,
+					windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() {
+					if err := windows.CloseHandle(handle); err != nil {
+						t.Errorf("close original stream-query handle: %v", err)
+					}
+				})
+				identity, err := serenaTreeHandleIdentity(handle, nil)
+				if err != nil || identity.Directory != tc.directory {
+					t.Fatalf("fixture handle type: directory=%v error=%v", identity.Directory, err)
+				}
+			}
+
+			ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+			defer cancel()
+			tree := &windowsSerenaOwnedTree{
+				request: SerenaOwnedTreeRequest{Limits: DefaultSerenaTreeLimits()},
+			}
+			var nativeErr error
+			if tc.invalid || tc.directory && !tc.named {
+				var raw [32]uint64
+				nativeErr = windows.GetFileInformationByHandleEx(handle, windows.FileStreamInfo,
+					(*byte)(unsafe.Pointer(&raw[0])), uint32(unsafe.Sizeof(raw)))
+				if tc.invalid {
+					if !errors.Is(nativeErr, windows.ERROR_INVALID_HANDLE) {
+						t.Fatalf("fixture did not produce the native invalid-handle error: %v", nativeErr)
+					}
+				} else if !errors.Is(nativeErr, windows.ERROR_HANDLE_EOF) {
+					t.Fatalf("directory fixture did not exercise native no-streams completion: %v", nativeErr)
+				}
+			}
+			streams, err := tree.observeStreams(ctx, handle)
+			switch {
+			case tc.invalid:
+				if !errors.Is(err, nativeErr) || len(streams) != 0 {
+					t.Fatalf("non-EOF native error changed: streams=%v error=%v native=%v", streams, err, nativeErr)
+				}
+			case tc.named:
+				if err == nil || err.Error() != "SERENA_TREE_NONDEFAULT_STREAM_REFUSED" || len(streams) != 0 {
+					t.Fatalf("named data stream was not refused: streams=%v error=%v", streams, err)
+				}
+			case tc.directory:
+				if err != nil || len(streams) != 0 {
+					t.Fatalf("native no-streams result was not received as empty: streams=%v error=%v", streams, err)
+				}
+			default:
+				if err != nil || len(streams) != 1 || streams[0].Name != "::$DATA" || streams[0].Bytes != int64(len(tc.contents)) {
+					t.Fatalf("ordinary default stream changed: streams=%v error=%v", streams, err)
+				}
+			}
+		})
+	}
+}

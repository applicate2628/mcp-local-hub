+func TestRustOwnerIdentityCallbackKeepsOutputBuffersStable(t *testing.T) {
+	image := []uint16{'C', ':', '\\', 'c', 'h', 'i', 'l', 'd'}
+	wire := rustOwnerIdentityABI{
+		Size: 120, Version: 1, PID: 42, JobMembership: 1,
+		CreationTime100ns: 123456, WaitState: 1, SIDLen: 12,
+		Image: rustOwnerUTF16{Data: &image[0], Len: uintptr(len(image))},
+	}
+	wire.SID[0], wire.SID[1] = 1, 1
+	// This fixture stands in for Rust-owned stable callback memory.
+	var payload runtime.Pinner
+	payload.Pin(&wire)
+	payload.Pin(&image[0])
+	defer payload.Unpin()
+	query := syscall.NewCallback(func(raw, version, receiver, token uintptr,
+		report *rustOwnerIdentityReport, reportBytes uintptr,
+		out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		growRustOwnerCallbackStack(64)
+		if raw != 0x4264 || version != 1 || receiver == 0 || report == nil ||
+			reportBytes != 24 || out == nil || outBytes != 48 {
+			return 1
+		}
+		*report = rustOwnerIdentityReport{Size: 24, Version: 1, Stage: 7}
+		syscall.SyscallN(receiver, uintptr(unsafe.Pointer(&wire)), 120, token)
+		// Rust snapshots the original owner after the Go receiver returns.
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		return 0
+	})
+	owner := &rustNativeOwner{raw: 0x4264, memberGate: newOriginalMemberCustody(),
+		library: &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{"mh_query_identity1": query}}}
+	value, err := owner.QueryIdentity()
+	if err != nil || value.PID != 42 || value.CreationTime100ns != 123456 ||
+		len(value.TokenUserSID) != 12 || len(value.ImageUTF16) != len(image) {
+		t.Fatalf("identity callback lost native report buffers: value=%+v err=%v", value, err)
+	}
+	permit, err := owner.memberGate.beginTerminal(nil)
+	if err != nil {
+		t.Fatalf("identity callback retained original query custody: %v", err)
+	}
+	permit.finish()
+}

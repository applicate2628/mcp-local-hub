new file mode 100644
index 0000000000000000000000000000000000000000..54594e5def9e2d522b2078d42e269525792cf085
--- /dev/null
+++ b/internal/api/serena_prepared_interpreter_windows.go
@@ -0,0 +1,144 @@
+//go:build windows
+
+package api
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/sys/windows"
+)
+
+// Discovery may return a managed-Python directory alias. Follow only this
+// already-selected locator, retain the original file, and qualify its canonical
+// name with the unchanged no-reparse reader. Later execution uses that name.
+func qualifyPreparedSerenaInterpreter(ctx context.Context, selected string, capBytes int64) (result PreparedSerenaFile, err error) {
+	if ctx == nil || capBytes <= 0 {
+		return result, errors.New("SERENA_PREPARATION_INTERPRETER_LOCATOR_INVALID")
+	}
+	if err = ctx.Err(); err != nil {
+		return result, err
+	}
+	native, err := serenaInterpreterNativePath(selected)
+	if err != nil {
+		return result, errors.Join(err, ctx.Err())
+	}
+	name, err := windows.UTF16PtrFromString(native)
+	if err != nil {
+		return result, errors.Join(err, ctx.Err())
+	}
+	// Read-only and no write/delete sharing: the selected original stays
+	// pinned while the canonical name is independently qualified.
+	handle, err := windows.CreateFile(name, windows.FILE_READ_DATA|windows.FILE_READ_ATTRIBUTES,
+		windows.FILE_SHARE_READ, nil, windows.OPEN_EXISTING, 0, 0)
+	if err != nil {
+		return result, errors.Join(err, ctx.Err())
+	}
+	defer func() {
+		closeErr := preparedSerenaCloseFileHandle(handle)
+		err = errors.Join(err, ctx.Err(), closeErr)
+	}()
+	return qualifyPreparedSerenaInterpreterHandle(ctx, handle, capBytes)
+}
+
+// The caller retains and closes the original followed handle. This step never
+// reopens the discovery alias and never substitutes another executable.
+func qualifyPreparedSerenaInterpreterHandle(ctx context.Context, handle windows.Handle, capBytes int64) (PreparedSerenaFile, error) {
+	if ctx == nil || capBytes <= 0 {
+		return PreparedSerenaFile{}, errors.New("SERENA_PREPARATION_INTERPRETER_LOCATOR_INVALID")
+	}
+	if err := ctx.Err(); err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	kind, err := windows.GetFileType(handle)
+	if err != nil || kind != windows.FILE_TYPE_DISK {
+		return PreparedSerenaFile{}, errors.Join(err, errors.New("SERENA_PREPARATION_INTERPRETER_FILE_INVALID"))
+	}
+	before, err := serenaTreeHandleIdentity(handle, nil)
+	if err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	if before.Directory || before.Bytes < 0 || before.Bytes > capBytes {
+		return PreparedSerenaFile{}, errors.New("SERENA_PREPARED_FILE_SIZE_INVALID")
+	}
+	// Flags zero request the normalized DOS path. A full/oversized result is
+	// refused; no opened-name or device-namespace fallback is accepted.
+	buffer := make([]uint16, 32768)
+	count, err := windows.GetFinalPathNameByHandle(handle, &buffer[0], uint32(len(buffer)), 0)
+	if err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	if count == 0 || count >= uint32(len(buffer)) {
+		return PreparedSerenaFile{}, errors.New("SERENA_PREPARATION_INTERPRETER_CANONICAL_PATH_INVALID")
+	}
+	canonical, err := serenaInterpreterFinalPath(windows.UTF16ToString(buffer[:count]))
+	if err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	if err := ctx.Err(); err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	qualified, raw, err := qualifyPreparedSerenaFile(ctx, canonical, capBytes)
+	if err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	after, err := serenaTreeHandleIdentity(handle, nil)
+	if err != nil {
+		return PreparedSerenaFile{}, err
+	}
+	// The strict reader's bytes/hash must belong to this same retained file,
+	// including its full 128-bit file identity and unchanged original metadata.
+	if !sameSerenaTreeObject(before, after) || qualified.Device != before.Device ||
+		qualified.FileID != before.FileID || int64(len(raw)) != before.Bytes {
+		return PreparedSerenaFile{}, errors.New("SERENA_PREPARATION_INTERPRETER_IDENTITY_DRIFT")
+	}
+	return qualified, ctx.Err()
+}
+
+// Accept ordinary absolute drive/UNC file locators before CreateFile. IsLocal
+// applies the platform's reserved-device and colon/alternate-stream rules to
+// the relative tail. Extended syntax is constructed here, never accepted as input.
+func serenaInterpreterNativePath(path string) (string, error) {
+	invalid := errors.New("SERENA_PREPARATION_INTERPRETER_LOCATOR_INVALID")
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path || strings.ContainsAny(path, "\x00\r\n") {
+		return "", invalid
+	}
+	volume := filepath.VolumeName(path)
+	drive := len(volume) == 2 && volume[1] == ':' &&
+		(volume[0] >= 'A' && volume[0] <= 'Z' || volume[0] >= 'a' && volume[0] <= 'z')
+	if !drive {
+		if !strings.HasPrefix(volume, `\\`) {
+			return "", invalid
+		}
+		parts := strings.Split(volume[2:], `\`)
+		if len(parts) != 2 || !serenaTreeName(parts[0]) || !serenaTreeName(parts[1]) ||
+			strings.ContainsAny(parts[0]+parts[1], `<>:"|?*`) {
+			return "", invalid
+		}
+	}
+	tail := strings.TrimPrefix(path[len(volume):], `\`)
+	if tail == "" || tail == "." || !filepath.IsLocal(tail) {
+		return "", invalid
+	}
+	if drive {
+		return `\\?\` + path, nil
+	}
+	return `\\?\UNC\` + path[2:], nil
+}
+
+func serenaInterpreterFinalPath(path string) (string, error) {
+	var canonical string
+	if rest, ok := strings.CutPrefix(path, `\\?\UNC\`); ok {
+		canonical = `\\` + rest
+	} else if rest, ok := strings.CutPrefix(path, `\\?\`); ok {
+		canonical = rest
+	} else {
+		return "", errors.New("SERENA_PREPARATION_INTERPRETER_CANONICAL_PATH_INVALID")
+	}
+	if _, err := serenaInterpreterNativePath(canonical); err != nil {
+		return "", errors.Join(err, errors.New("SERENA_PREPARATION_INTERPRETER_CANONICAL_PATH_INVALID"))
+	}
+	return canonical, nil
+}

+		mutate func(*rustOwnerLibrary)
+		calls  int32
+	}{
+		{name: "legacy", mutate: func(l *rustOwnerLibrary) {
+			l.identity.Exports = runtimeidentity.WindowsProcessOwnerExportsV1()
+		}},
+		{name: "partial-receipt", mutate: func(l *rustOwnerLibrary) {
+			l.identity.Exports = l.identity.Exports[:len(l.identity.Exports)-1]
+		}},
+		{name: "partial-procedures", mutate: func(l *rustOwnerLibrary) {
+			delete(l.procedures, "mh_members_revalidate1")
+		}},
+		{name: "full-member-profile", calls: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			library, api, probe := rustProductFakeLibrary(t)
+			if tc.mutate != nil {
+				tc.mutate(library)
+			}

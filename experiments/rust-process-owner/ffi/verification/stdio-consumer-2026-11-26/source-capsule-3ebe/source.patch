+func TestRustOwnerArgv0ABIKeepsExplicitWireAndV1(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		explicit bool
+		argv0    string
+		args     []string
+	}{
+		{name: "v1", args: []string{"plain", ""}},
+		{name: "v2-empty", explicit: true},
+		{name: "v2-leaf", explicit: true, argv0: "git", args: []string{"--version"}},
+		{name: "v2-64-user-arguments", explicit: true, argv0: "git", args: make([]string, 64)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			program := filepath.Join(dir, "not-executed.exe")
+			want := slices.Clone(tc.args)
+			if tc.explicit {
+				want = append([]string{tc.argv0}, want...)
+			}
+			check := func(request *rustOwnerCreate, _ *rustOwnerIOContext, _ *uintptr, _ *rustOwnerOutcome) string {
+				if request.Argc != uintptr(len(want)) {
+					return "argv zero changed the nonzero argument count"
+				}
+				views := unsafe.Slice(request.Args, int(request.Argc))
+				for i, arg := range want {
+					units, _ := syscall.UTF16FromString(arg)
+					if !rustIOABIViewMatches(views[i], units) {
+						return "wire arguments changed or lost their explicit empty string"
+					}
+				}
+				units, _ := syscall.UTF16FromString(program)
+				if !rustIOABIViewMatches(request.Program, units) {
+					return "argv zero replaced the executable image"
+				}
+				return ""
+			}
+			var library *rustOwnerLibrary
+			var probe *rustIOABIProbe
+			launch := &rustOwnerLaunchIO{
+				environment: []rustOwnerEnvironmentEntry{}, streams: rustStdioTestFiles(t),
+			}
+			if tc.explicit {
+				launch.argv0 = &tc.argv0
+				library, probe = rustArgv0ABIRejectingLibrary(check)
+			} else {
+				library, probe = rustIOABIRejectingLibrary(check)
+			}
+			var retained *rustNativeOwner
+			owner, output, err := library.startRetainedRustOwnerContext(
+				rustStdioTestContext(t), program, dir, tc.args, launch,
+				func(original *rustNativeOwner) error { retained = original; return nil },
+			)
+			if err == nil || errors.Is(err, errRustOwnerOutcome) || probe.calls.Load() != 1 ||
+				probe.failure != "" || output != (rustOwnerOutcome{Size: 48, Version: 1}) {
+				t.Fatalf("request transport: calls=%d failure=%q output=%+v err=%v", probe.calls.Load(), probe.failure, output, err)
+			}
+			rustIOABIAssertAbandoned(t, library, owner, retained)
+		})
+	}
+}

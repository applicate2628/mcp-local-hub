+
+var errRustOwnerProcessBorrow = errors.New("invalid original Rust process borrow")
+
+type rustOwnerProcessBorrowCall struct {
+	context context.Context
+	consume func(uintptr) error
+	count   int
+	err     error
+}
+
+// Callback addresses cannot be unregistered on Windows. Keep one trampoline;
+// each opaque token exists only for one synchronous call, and owns no process.
+var rustOwnerProcessBorrowCalls sync.Map
+var rustOwnerProcessBorrowSequence atomic.Uint64
+var rustOwnerProcessBorrowCallback = syscall.NewCallback(func(handle, token uintptr) (ret uintptr) {
+	value, ok := rustOwnerProcessBorrowCalls.Load(token)
+	if !ok {
+		return 0
+	}
+	state, ok := value.(*rustOwnerProcessBorrowCall)
+	if !ok || state == nil {
+		return 0
+	}
+	defer func() {
+		if recover() != nil {
+			state.err = errors.Join(state.err, fmt.Errorf("%w: receiver panic", errRustOwnerProcessBorrow))
+			ret = 0
+		}
+	}()
+	state.count++
+	if state.count != 1 {
+		state.err = errors.Join(state.err, fmt.Errorf("%w: duplicate receiver", errRustOwnerProcessBorrow))
+		return 0
+	}
+	if handle == 0 || handle >= ^uintptr(0)-5 || state.consume == nil {
+		state.err = fmt.Errorf("%w: invalid process handle or receiver", errRustOwnerProcessBorrow)
+		return 0
+	}
+	if state.context != nil {
+		if err := creatorClosureContext(state.context); err != nil {
+			state.err = err
+			return 0
+		}
+	}
+	state.err = state.consume(handle)
+	if state.context != nil {
+		state.err = errors.Join(state.err, creatorClosureContext(state.context))
+	}
+	if state.err != nil {
+		return 0
+	}
+	return 1
+})
+
+func registerRustOwnerProcessBorrowCall(state *rustOwnerProcessBorrowCall) (uintptr, error) {
+	for {
+		prior := rustOwnerProcessBorrowSequence.Load()
+		if prior == ^uint64(0) {
+			return 0, fmt.Errorf("%w: callback token exhausted", errRustOwnerProcessBorrow)
+		}
+		if rustOwnerProcessBorrowSequence.CompareAndSwap(prior, prior+1) {
+			token := uintptr(prior + 1)
+			rustOwnerProcessBorrowCalls.Store(token, state)
+			return token, nil
+		}
+	}
+}
+
+// borrowOriginalProcessHandle lends the original native creation handle only
+// inside consume. No numeric PID lookup, new ownership, handle duplication or
+// retained handle is involved. consume must be a synchronous read-only query:
+// no close, retention, owner reentry, Goexit or unwind across the ABI.
+//
+// A non-nil context must be finite and bounds admission plus the observation of
+// callback completion. It cannot interrupt an entered callback/native call.
+// Nil preserves the existing unbounded query contract outside startup; callers
+// must not reuse a cancelled creation context as a healthy process lifetime.
+func (owner *rustNativeOwner) borrowOriginalProcessHandle(ctx context.Context, consume func(uintptr) error) error {
+	if owner == nil || owner.memberGate == nil || consume == nil {
+		return fmt.Errorf("%w: missing original custody or receiver", errRustOwnerProcessBorrow)
+	}
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return err
+		}
+	}
+	leave, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return err
+	}
+	defer leave()
+	if err := lockRustOwnerCreateContext(ctx, &owner.mu); err != nil {
+		return err
+	}
+	defer owner.mu.Unlock()
+	library := owner.library
+	if library == nil {
+		return fmt.Errorf("%w: original library unavailable", errRustOwnerProcessBorrow)
+	}
+	if err := lockRustOwnerCreateContext(ctx, &library.mu); err != nil {
+		return err
+	}
+	defer library.mu.Unlock()
+	if owner.raw == 0 || owner.originalPID == 0 || owner.closeStarted || !library.ready || library.closeAttempted {
+		return fmt.Errorf("%w: original owner is not live", errRustOwnerProcessBorrow)
+	}
+	address := library.procedures["mh_borrow_process1"]
+	if address == 0 || !runtimeidentity.IsWindowsProcessOwnerBorrowExportProfileV1(library.identity.Exports) {
+		return fmt.Errorf("%w: admitted borrow profile unavailable", errRustOwnerProcessBorrow)
+	}
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return err
+		}
+	}
+	state := &rustOwnerProcessBorrowCall{context: ctx, consume: consume}
+	token, err := registerRustOwnerProcessBorrowCall(state)
+	if err != nil {
+		return err
+	}
+	defer rustOwnerProcessBorrowCalls.Delete(token)
+	var output rustOwnerOutcome
+	var pinned runtime.Pinner
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(address, owner.raw, rustOwnerProcessBorrowCallback, token,
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	outcome, outcomeErr := decodeRustOwnerOutcome(uint32(status), output)
+	var coherenceErr error
+	if state.count > 1 || (status == 0 && (state.count != 1 || state.err != nil || outcome.PID == 0)) {
+		coherenceErr = fmt.Errorf("%w: callback completion contradicts outcome", errRustOwnerProcessBorrow)
+	}
+	if outcome.State != 0 || outcome.Flags&2 != 0 ||
+		(owner.originalPID != 0 && outcome.PID != owner.originalPID) {
+		coherenceErr = errors.Join(coherenceErr, fmt.Errorf("%w: borrow reported foreign or terminal facts", errRustOwnerProcessBorrow))
+	}
+	var contextErr error
+	if ctx != nil {
+		contextErr = creatorClosureContext(ctx)
+	}
+	return errors.Join(outcomeErr, state.err, coherenceErr, contextErr)
+}

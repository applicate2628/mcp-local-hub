+func TestSerenaBuildGitLongPathsPolicy(t *testing.T) {
+	policy := DefaultSerenaPreparationPolicy()
+	ctx, cancel := context.WithTimeout(context.Background(), policy.WorkLimit)
+	defer cancel()
+	// Exercise the pure projection owner. Existing Windows bootstrap tests
+	// separately cover real file qualification; no child is started here.
+	source := &serenaPreparationEnvironmentSource{
+		issuer:                &struct{ marker byte }{1},
+		packageManifestSHA256: strings.Repeat("a", 64), bootstrapSHA256: strings.Repeat("b", 64),
+		bootstrapValues: map[string]string{"PATHEXT": ".EXE"},
+	}
+	baseline, execution, err := BuildSerenaBuildEnvironmentProjection(ctx, source, policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baselineSHA, err := baseline.SHA256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	gitValues := map[string]string{
+		"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.longpaths", "GIT_CONFIG_VALUE_0": "true",
+	}
+	t.Run("platform policy", func(t *testing.T) {
+		want := map[string]string{"PATHEXT": ".EXE", "PYTHONDONTWRITEBYTECODE": "1", "UV_PYTHON_DOWNLOADS": "never"}
+		if runtime.GOOS == "windows" {
+			for key, value := range gitValues {
+				want[key] = value
+			}
+		}
+		if len(execution.values) != len(want) || !reflect.DeepEqual(preparedSerenaEnvironmentMap(execution.values), want) {
+			t.Fatal("platform policy did not produce the exact closed process environment")
+		}
+		found := map[string]bool{}
+		for _, entry := range baseline.Entries {
+			if !strings.HasPrefix(entry.Key, "GIT_") {
+				continue
+			}
+			value, known := gitValues[entry.Key]
+			wantEntry := SerenaBuildEnvironmentEntryV1{
+				Key: entry.Key, ValueKind: "policy", SourceKind: "preparation-policy",
+				SourceRefSHA256: preparedSerenaHash([]byte("serena-windows-git-config-rule-v1:core.longpaths=true")),
+				ValueSHA256:     preparedSerenaHash([]byte(value)),
+			}
+			if runtime.GOOS != "windows" || !known || found[entry.Key] || entry != wantEntry {
+				t.Fatal("Git policy projection is foreign, duplicated, or not identity-bound")
+			}
+			found[entry.Key] = true
+		}
+		if runtime.GOOS == "windows" && len(found) != len(gitValues) {
+			t.Fatal("Git policy entries are missing")
+		}
+	})
+	t.Run("ambient is excluded", func(t *testing.T) {
+		for key, value := range map[string]string{
+			"GIT_CONFIG_COUNT": "2", "GIT_CONFIG_KEY_0": "core.longpaths", "GIT_CONFIG_VALUE_0": "false",
+			"GIT_CONFIG_KEY_1": "core.hooksPath", "GIT_CONFIG_VALUE_1": "ambient-hooks",
+			"GIT_CONFIG_PARAMETERS": "'core.longpaths=false'",
+		} {
+			t.Setenv(key, value)
+		}
+		projection, actual, err := BuildSerenaBuildEnvironmentProjection(ctx, source, policy)
+		if err != nil {
+			t.Fatal(err)
+		}
+		actualSHA, err := projection.SHA256()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if actualSHA != baselineSHA || !reflect.DeepEqual(actual.values, execution.values) {
+			t.Fatal("ambient Git configuration entered preparation identity or environment")
+		}
+	})
+	t.Run("declared overrides refused", func(t *testing.T) {
+		for key, value := range map[string]string{
+			"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.longpaths", "GIT_CONFIG_VALUE_0": "false",
+			"git_config_parameters": "'core.longpaths=true'", "GIT_CONFIG_VALUE_1": "foreign",
+		} {
+			if !IsSerenaPreparationBuildDeclaration(key) {
+				t.Fatal("unsupported Git declaration would be silently dropped", key)
+			}
+			values, provenance, err := secrets.NewResolver(nil, nil).ResolveMapWithProvenance(map[string]string{key: value})
+			if err != nil {
+				t.Fatal(err)
+			}
+			declared := *source
+			declared.values, declared.provenance = values, provenance
+			_, actual, err := BuildSerenaBuildEnvironmentProjection(ctx, &declared, policy)
+			if err == nil || err.Error() != "SERENA_BUILD_INPUT_UNSUPPORTED" || len(actual.values) != 0 {
+				t.Fatalf("declared Git configuration %s was not refused before execution: %v", key, err)
+			}
+		}
+	})
+	t.Run("identity includes policy", func(t *testing.T) {
+		if runtime.GOOS != "windows" {
+			t.Skip("Windows-only Git policy is absent on this platform")
+		}
+		without := baseline
+		without.Entries = nil
+		for _, entry := range baseline.Entries {
+			if !strings.HasPrefix(entry.Key, "GIT_") {
+				without.Entries = append(without.Entries, entry)
+			}
+		}
+		withoutSHA, err := without.SHA256()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if baselineSHA == withoutSHA {
+			t.Fatal("Windows Git policy did not invalidate the previous build environment identity")
+		}
+	})

+func TestProductRustOwnerFactoryRetainsLoaderFailure(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		name := "missing"
+		if partial {
+			name = "partial-module"
+		}
+		t.Run(name, func(t *testing.T) {
+			layout := newRustOwnerMemberTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			loadErr, closeErr := errors.New("module missing"), error(nil)
+			api.lockErr = loadErr
+			if partial {
+				closeErr = errors.New("module unload failed")
+				api.lockErr, api.freeErr = nil, closeErr
+				api.modulePath = layout.library + ".different"
+			}
+			var library *rustOwnerLibrary
+			var retained *AtCreateJobProcess
+			retains, opens := 0, 0
+			p, err := startProductRustOriginal(rustStdioTestContext(t), rustOwnerCommandFixture(), nil, nil, nil,
+				func(p *AtCreateJobProcess) error { retained = p; retains++; return nil },
+				func() (*rustOwnerLibrary, error) {
+					opens++
+					var err error
+					library, err, _ = openFakeRustOwner(t, layout, api)
+					return library, err
+				})
+			if err == nil || p == nil || p != retained || retains != 1 || opens != 1 || p.Created() {
+				t.Fatalf("loader error lost receiving facade: p=%p retained=%p err=%v retains=%d opens=%d",
+					p, retained, err, retains, opens)
+			}
+			child, ok := p.child.(*rustContainedChild)
+			if !ok || child.library != library || child.owner != nil || (partial && (library == nil || !child.ownsLibrary)) {
+				t.Fatal("loader error transferred different module custody")
+			}
+			if (!partial && !errors.Is(err, loadErr)) || (partial && !errors.Is(err, closeErr)) {
+				t.Fatalf("loader cause lost: %v", err)
+			}
+			frees := api.freeCalls
+			rustProductReleaseNoChild(t, p, closeErr)
+			if api.freeCalls != frees {
+				t.Fatalf("failed loader close replayed: before=%d after=%d", frees, api.freeCalls)
+			}
+		})
+	}

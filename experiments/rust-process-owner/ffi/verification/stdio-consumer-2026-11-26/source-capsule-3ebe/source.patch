+    -not $env:MCPHUB_RUST_OWNER_INTEGRATION_COMMIT -or
+    -not $env:MCPHUB_RUST_OWNER_INTEGRATION_SHA256) {
+    throw 'Configure the qualified DLL locator and its original commit/SHA-256 first'
+}
+$rustOwnerTests = '^Test(RustOwner.*|RustRetainedCreator.*|OpenRustOwnerLibrary.*|ProductRustOwner.*|CreatorIdentity.*|SIDFormatSource.*|CreatorRootSoleWaitClaimDoesNotHoldLifetime)$'
+go test -json -count=1 -timeout=180s ./internal/process -run $rustOwnerTests
+if ($LASTEXITCODE -ne 0) { throw 'Rust owner normal qualification failed' }
+go test -json -race -count=1 -timeout=180s ./internal/process -run $rustOwnerTests
+if ($LASTEXITCODE -ne 0) { throw 'Rust owner race qualification failed' }
+```

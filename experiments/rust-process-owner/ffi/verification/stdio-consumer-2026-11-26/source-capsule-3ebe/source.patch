+func foregroundConsoleRetainFixture(t *testing.T, original *AtCreateJobProcess, fixture *rustIONativeFixture, console *foregroundOwnedConsole, files []*os.File) {
+	t.Helper()
+	foregroundConsoleFixtureRetained.Lock()
+	foregroundConsoleFixtureRetained.values = append(foregroundConsoleFixtureRetained.values,
+		foregroundConsoleRetainedFixture{t.Name(), original, fixture, console, append([]*os.File(nil), files...)})
+	foregroundConsoleFixtureRetained.Unlock()
+	t.Error("incomplete fixture recovery: original/native owner, library, console and all source files retained until receiver exit")
+}
+
+// Called only after both existing native-fixture cleanups. It reads their
+// original facts and issues no native action or renewed terminal observation.
+// A cleared raw slot can still carry native cleanup/decode failure.
+func foregroundConsoleRustResourcesReleased(t *testing.T, fixture *rustIONativeFixture) bool {
+	t.Helper()
+	if fixture == nil {
+		return true // Fixture construction returned no creator to this test.
+	}
+	released := true
+	library := fixture.library
+	if owner := fixture.owner; owner != nil {
+		owner.mu.Lock()
+		raw, releaseErr := owner.raw, owner.releaseErr
+		preparing, created := owner.preparing.Load(), owner.created.Load()
+		entered, noChild := owner.createEntered.Load(), owner.createNoChild.Load()
+		closeStarted, root := owner.closeStarted, owner.cachedRootWait()
+		ownerLibrary := owner.library
+		owner.mu.Unlock()
+		if library == nil {
+			library = ownerLibrary
+		} else if library != ownerLibrary {
+			t.Error("console fixture lost its original native library binding")
+			released = false
+		}
+		terminal := !created && (!entered || noChild)
+		if created {
+			terminal = closeStarted && root.Known
+		}
+		if preparing || raw != 0 || releaseErr != nil || !terminal || ownerLibrary == nil {
+			t.Errorf("native console fixture release unproved: raw=%#x preparing=%t created=%t entered=%t noChild=%t closeStarted=%t root=%+v release=%v",
+				raw, preparing, created, entered, noChild, closeStarted, root, releaseErr)
+			released = false
+		}
+	}
+	if library != nil {
+		library.mu.Lock()
+		active, attempted, handle, closeErr := library.activeOwners.Load(), library.closeAttempted, library.handle, library.closeErr
+		guardAttempted, guardErr := library.guardCloseAttempted, library.guardCloseErr
+		library.mu.Unlock()
+		if active != 0 || !attempted || handle != 0 || closeErr != nil || !guardAttempted || guardErr != nil {
+			t.Errorf("native console fixture library remains retained: owners=%d attempted=%t handle=%#x close=%v guardAttempted=%t guard=%v",
+				active, attempted, handle, closeErr, guardAttempted, guardErr)
+			released = false
+		}
+	}
+	return released
+}
+
+// This fallback reports release of the original Go handles, not an empty Job
+// or the absence of every console user. Windows can create a headless console
+// host even when the CUI program spawns no children. The caller must retain its
+// source/console lifetime after an incomplete original settlement regardless of
+// this result. Never rewrite that failure or renew its terminal deadline.
+func foregroundConsoleReleaseGoOriginal(t *testing.T, original *AtCreateJobProcess) bool {
+	t.Helper()
+	if original == nil {
+		t.Error("fixture recovery requires the retained original owner")
+		return false
+	}
+	child, ok := original.child.(*windowsContainedChild)
+	if !ok || child == nil || child.job == nil || original.waitDone == nil {
+		t.Error("fixture recovery requires the same retained Go creator and waiter")
+		return false
+	}
+	// Only the cached original no-child observation may dispense with waiting.
+	// The startup capability alone is not an empty-Job settlement observation.
+	noChild := original.settleReturned.Load() && original.settleResult.NoChildKnown && child.containedNoChildKnown()
+	if !noChild && !original.Created() {
+		t.Error("fixture recovery lacks an original created or observed no-child state")
+		return false
+	}
+	// The existing nil-context backstop does not bind or renew a terminal
+	// deadline. It closes the same Job once and keeps the process handle alive.
+	if err := child.closeContainedJobBackstop(); err != nil || child.job.Handle() != 0 {
+		t.Errorf("Go original fixture Job backstop: handle=%#x err=%v", child.job.Handle(), err)
+		return false
+	}
+	if !noChild {
+		var root OriginalRootWait
+		select {
+		case <-original.waitDone:
+			// A prior release may already have closed the native handle. Read
+			// the synchronized cached waiter; never wait on its old value.
+			root = original.WaitOriginal()
+		default:
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			root = original.WaitOriginalContext(ctx)
+			cancel()
+		}
+		if !root.Known || root.Error != nil {
+			t.Errorf("Go original fixture backstop wait: %+v", root)
+			return false
+		}
+	}
+	settlement, releaseErr := original.ReleaseOriginal()
+	view := settlement.Snapshot()
+	if releaseErr != nil {
+		// Release preserves the original settlement error even when it has
+		// now closed the actual handles; do not turn that error into PASS.
+		t.Errorf("Go original fixture release preserves failure: %v", releaseErr)
+	}
+	if !view.HandlesClosed || child.process != 0 || child.thread != 0 || child.job.Handle() != 0 {
+		t.Errorf("Go original fixture resources remain retained: native=%+v release=%v", view, releaseErr)
+		return false
+	}

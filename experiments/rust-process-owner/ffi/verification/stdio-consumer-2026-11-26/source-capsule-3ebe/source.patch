+		inputWriter: inputWriter, outputReader: outputReader, errorReader: errorReader,
+		flags: [3]uint32{
+			rustStdioTestFileFlags(t, inputReader),
+			rustStdioTestFileFlags(t, outputWriter),
+			rustStdioTestFileFlags(t, errorWriter),
+		},
+	}

+	payload := []byte{'p', 0, 0xff, 0x80, '\r', '\n', 0xc3, 0xa9, 't', 'a', 'i', 'l', 0, 0xff}
+	// Establish this fixture explicitly: Windows os.Pipe creates inheritable handles.
+	for i, source := range []*os.File{pipes.streams.Stdin, pipes.streams.Stdout, pipes.streams.Stderr} {
+		raw, err := source.SyscallConn()
+		if err != nil {
+			t.Fatalf("prepare source slot %d: %v", i, err)
+		}
+		var flagsErr error
+		controlErr := raw.Control(func(handle uintptr) {
+			flagsErr = syscall.SetHandleInformation(syscall.Handle(handle), syscall.HANDLE_FLAG_INHERIT, 0)
+		})
+		if err := errors.Join(controlErr, flagsErr); err != nil {
+			t.Fatalf("clear source slot %d inheritance: %v", i, err)
+		}
+	}
+	before := rustIONativeStreamFlags(t, pipes.streams)
+	for _, flags := range before {
+		if flags&1 != 0 {
+			t.Fatal("Go pipe fixture must start with non-inheritable source handles")
+		}
+	}

+
+// startRetainedRustOwner preserves the existing explicit empty-env/no-IO path.
+// Its identical retained pointer is returned on every post-retention failure.
+func (library *rustOwnerLibrary) startRetainedRustOwner(
+	ctx context.Context, program, cwd string, args []string,
+	retain func(*rustNativeOwner) error,
+) (*rustNativeOwner, rustOwnerOutcome, error) {
+	return library.startRetainedRustOwnerContext(ctx, program, cwd, args, nil, retain)
+}
+
+// startRetainedRustOwnerIO borrows caller-owned files through temporary copies.
+// ctx bounds admission, not an entered CreateProcess call or the child's life.
+func (library *rustOwnerLibrary) startRetainedRustOwnerIO(
+	ctx context.Context, program, cwd string, args []string,
+	environment []rustOwnerEnvironmentEntry, streams rustOwnerStdio,
+	retain func(*rustNativeOwner) error,
+) (*rustNativeOwner, rustOwnerOutcome, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, rustOwnerOutcome{}, err
+	}
+	return library.startRetainedRustOwnerContext(ctx, program, cwd, args,
+		&rustOwnerLaunchIO{environment: environment, streams: streams}, retain)
+}
+
+func (library *rustOwnerLibrary) startRetainedRustOwnerContext(
+	ctx context.Context, program, cwd string, args []string, launchIO *rustOwnerLaunchIO,
+	retain func(*rustNativeOwner) error,
+) (*rustNativeOwner, rustOwnerOutcome, error) {
+	if ctx == nil || retain == nil || library == nil ||
+		!filepath.IsAbs(program) || !filepath.IsAbs(cwd) || len(args) > 64 {
+		return nil, rustOwnerOutcome{}, errors.New("Rust creator needs a context, absolute program/cwd and retention callback")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, rustOwnerOutcome{}, err
+	}
+	admissionCtx := ctx
+	if _, finite := ctx.Deadline(); !finite {
+		// Only the legacy no-IO caller may lack a finite deadline.
+		admissionCtx = nil
+	}
+	if err := lockRustOwnerCreateContext(admissionCtx, &library.mu); err != nil {
+		return nil, rustOwnerOutcome{}, err
+	}
+	if !library.ready || library.closeAttempted {
+		library.mu.Unlock()
+		return nil, rustOwnerOutcome{}, errors.New("Rust owner library was released")
+	}
+	original := &rustNativeOwner{library: library, memberGate: newOriginalMemberCustody()}
+	original.preparing.Store(true)
+	// The module lock covers both reserve acquisition and source installation.
+	// Dropping this reserve cannot wait for a mutex whose admission timed out.
+	library.activeOwners.Add(1)
+	installRustOwnerMemberSourceLocked(original)
+	library.mu.Unlock()
+	defer library.activeOwners.Add(-1)
+	retentionErr := func() (err error) {
+		defer func() {
+			if value := recover(); value != nil {
+				err = fmt.Errorf("Rust owner retention callback panicked: %v", value)
+			}
+		}()
+		return retain(original)
+	}()
+	if err := lockRustOwnerCreateContext(admissionCtx, &original.mu); err != nil {
+		// This invocation has irrevocably abandoned native entry. The owner
+		// can stop advertising preparation even while another operation holds mu.
+		original.preparing.Store(false)
+		return original, rustOwnerOutcome{}, errors.Join(retentionErr, err)
+	}
+	defer original.mu.Unlock()
+	defer original.preparing.Store(false)
+	if retentionErr != nil {
+		original.sealed = true
+		return original, rustOwnerOutcome{}, retentionErr
+	}
+	if original.sealed {
+		return original, rustOwnerOutcome{}, errors.New("original Rust creator was sealed before CreateProcess")
+	}
+	if err := ctx.Err(); err != nil {
+		original.sealed = true
+		return original, rustOwnerOutcome{}, err
+	}
+	created, observed, createErr := library.newRustOwnerIntoContext(admissionCtx, original, program, cwd, args, launchIO)
+	if created != nil && created != original {
+		return original, observed, errors.Join(createErr, errors.New("Rust creation changed its retained owner"))
+	}
+	// A late cancellation cannot roll back CreateProcess. Keep its owner and
+	// the native diagnostic, joining the observer's error separately.
+	return original, observed, errors.Join(createErr, ctx.Err())
+}

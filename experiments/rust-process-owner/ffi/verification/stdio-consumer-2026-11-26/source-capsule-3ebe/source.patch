@@ -0,0 +1,111 @@
+//go:build windows
+
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+	"unicode/utf8"
+)
+
+// One inert COMSPEC command supplies genuine native/IO settlement. It performs
+// no Python/UV discovery, preparation, installation or Product invocation.
+func TestPreparedSerenaFailureDiagnosticsOriginalCommand(t *testing.T) {
+	policy := DefaultSerenaPreparationPolicy()
+	cleanupEnd := time.Now().Add(time.Minute)
+	if deadline, ok := t.Deadline(); ok && deadline.Add(-time.Second).Before(cleanupEnd) {
+		cleanupEnd = deadline.Add(-time.Second)
+	}
+	workEnd := cleanupEnd.Add(-policy.CleanupLimit)
+	if !time.Now().Before(workEnd) {
+		t.Fatal("no remaining original command work interval")
+	}
+	ctx, cancel := context.WithDeadline(t.Context(), workEnd)
+	defer cancel()
+	path := os.Getenv("COMSPEC")
+	if !filepath.IsAbs(path) {
+		t.Fatal("inert command fixture unavailable")
+	}
+	executable, _, err := qualifyPreparedSerenaFile(ctx, path, 64<<20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	policySHA, err := policy.IdentitySHA256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := preparedSerenaInvocation{
+		OperationID: "failure-diagnostic-command", Executable: executable,
+		Args:        []string{"/d", "/u", "/c", "(for /l %i in (1,1,600) do @echo ÿ-original-stdout) & (for /l %i in (1,1,600) do @echo ÿ-original-stderr 1>&2) & exit /b 7"},
+		Environment: os.Environ(), WorkingDir: t.TempDir(), PolicySHA256: policySHA,
+		CleanupLimit: policy.CleanupLimit, AbsoluteCleanupDeadline: cleanupEnd,
+		StdoutLimit: 1 << 20, StderrLimit: 1 << 20,
+	}
+	result, runErr := runPreparedSerenaInvocation(ctx, request)
+	if runErr == nil || !result.Receipt.NativeSettlement.Complete() || !result.Receipt.IOSettlement.Complete() ||
+		!result.Receipt.RootWaitKnown || result.Receipt.RootExitCode != 7 {
+		t.Fatal("original failing command/native/IO fixture did not settle", runErr)
+	}
+	for _, raw := range [][]byte{result.Stdout, result.Stderr} {
+		if len(raw) <= preparedSerenaDiagnosticExcerptLimit || utf8.Valid(raw) {
+			t.Fatal("fixture did not produce long original non-UTF-8 streams")
+		}
+	}
+	failure := &preparedSerenaCommandFailure{
+		cause: runErr, stage: preparedSerenaUVInstallFailure, executable: executable, result: result,
+	}
+	got := PreparedSerenaFailureDiagnostics(failure)
+	if len(got) != 1 || !got[0].NativeComplete || !got[0].IOComplete || !got[0].RootWaitKnown || got[0].RootExitCode != 7 ||
+		got[0].OperationID != request.OperationID || got[0].ExecutableSHA256 != executable.SHA256 ||
+		got[0].ProcessStage != result.Receipt.Stage || got[0].TerminalAction != result.Receipt.TerminalAction {
+		t.Fatal("original command identity or terminal result changed")
+	}
+	for _, stream := range []struct {
+		got *PreparedSerenaFailureStream
+		raw []byte
+	}{{got[0].Stdout, result.Stdout}, {got[0].Stderr, result.Stderr}} {
+		if stream.got == nil || stream.got.Bytes != int64(len(stream.raw)) ||
+			stream.got.SHA256 != preparedSerenaHash(stream.raw) || !stream.got.Truncated ||
+			!bytes.Equal(stream.got.Excerpt, stream.raw[:preparedSerenaDiagnosticExcerptLimit]) {
+			t.Fatal("full stream digest/length or bounded original excerpt changed")
+		}
+	}
+	encoded, err := json.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded []PreparedSerenaFailureDiagnostic
+	if err = json.Unmarshal(encoded, &decoded); err != nil || len(decoded) != 1 ||
+		!bytes.Equal(decoded[0].Stdout.Excerpt, got[0].Stdout.Excerpt) || !bytes.Equal(decoded[0].Stderr.Excerpt, got[0].Stderr.Excerpt) {
+		t.Fatal("JSON did not preserve original invalid-UTF-8 bytes", err)
+	}
+	got[0].Stdout.Excerpt[0] ^= 1
+	if got[0].Stdout.Excerpt[0] == result.Stdout[0] {
+		t.Fatal("diagnostic excerpt aliases the retained original")
+	}
+	_, abiErr := decodeSerenaInterpreterABI(result.Stdout)
+	input := &serenaPreparationInputsError{cause: abiErr, inputs: SerenaPreparationInputs{
+		qualifiedInterpreter: executable, interpreterProbe: &result,
+	}}
+	if abiErr == nil || !errors.Is(input, abiErr) {
+		t.Fatal("original malformed probe error unavailable")
+	}
+	inputData := PreparedSerenaFailureDiagnostics(input)
+	if len(inputData) != 1 || inputData[0].Stage != "interpreter-abi" || inputData[0].Stdout == nil ||
+		inputData[0].Stdout.SHA256 != preparedSerenaHash(result.Stdout) {
+		t.Fatal("existing input carrier lost the settled original probe")
+	}
+	partial := result
+	partial.Receipt.IOSettlement.Stdout.WorkerComplete = false
+	failure.result = partial
+	unknown := PreparedSerenaFailureDiagnostics(failure)
+	if len(unknown) != 1 || unknown[0].IOComplete || unknown[0].Stdout != nil || unknown[0].Stderr != nil {
+		t.Fatal("native completion alone admitted unjoined stream data")
+	}
+}

+//go:build windows
+
+package process
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// The child is a source fixture; only SID conversion and its receipt use real
+// Windows operations. This fixture does not prove original process custody.
+type creatorIdentityGoUnitChild struct {
+	*creatorClosureUnitChild
+	observe    func(context.Context) (CreatorIdentitySnapshot, error)
+	formatting *SIDFormatObservation
+}
+
+func (c *creatorIdentityGoUnitChild) observeCreatorIdentity(ctx context.Context) (CreatorIdentitySnapshot, error) {
+	return c.observe(ctx)
+}
+
+func (c *creatorIdentityGoUnitChild) creatorSIDFormatObservation() *SIDFormatObservation {
+	return c.formatting
+}
+
+func creatorIdentityGoFixture(t *testing.T) (*ProvisionalProcess, *creatorIdentityGoUnitChild, CreatorIdentitySnapshot) {
+	t.Helper()
+	sid, err := currentProcessUserSID()
+	if err != nil {
+		t.Fatal(err)
+	}
+	value, receipt, err := FormatSIDObserved(sid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := receipt.ValidateInput(sid, value); err != nil {
+		t.Fatal(err)
+	}
+	p, base := creatorClosureUnitFixture(creatorExitObservation{})
+	view := CreatorIdentitySnapshot{
+		Version: 1, OriginalPID: base.binding.pid, OriginalStartedAt: base.binding.startedAt,
+		ExecutablePath: "D:\\dev\\ChatGPT\\fixture.exe", OwnerSID: value,
+		OriginalJobBound: true, CurrentJobMembershipKnown: true, CurrentJobMember: true,
+		RootWaitKnown: true, RootWaitResult: uint32(windows.WAIT_TIMEOUT), RootAlive: true,
+	}
+	child := &creatorIdentityGoUnitChild{
+		creatorClosureUnitChild: base, formatting: receipt,
+		observe: func(context.Context) (CreatorIdentitySnapshot, error) { return view, nil },
+	}
+	p.owner = child
+	return p, child, view
+}
+
+func TestCreatorIdentityGoIssuerPreservesBusyAndReceipt(t *testing.T) {
+	p, child, view := creatorIdentityGoFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	calls := 0
+	var nested *CreatorIdentity
+	var nestedErr error
+	child.observe = func(ctx context.Context) (CreatorIdentitySnapshot, error) {
+		calls++
+		if calls == 1 {
+			nested, nestedErr = p.ObserveCreatorIdentity(ctx)
+		}
+		return view, nil
+	}
+	identity, err := p.ObserveCreatorIdentity(ctx)
+	if err != nil || identity == nil {
+		t.Fatalf("Go issuer failed: present=%t err=%v", identity != nil, err)
+	}
+	if nested != nil || !errors.Is(nestedErr, ErrOriginalMemberObservationBusy) || calls != 1 {
+		t.Fatalf("in-flight observer admitted: present=%t calls=%d err=%v", nested != nil, calls, nestedErr)
+	}
+	if identity.owner != p || identity.sidFormatting != child.formatting {
+		t.Fatal("Go issuer substituted the original owner or formatting receipt")
+	}
+	if snapshot := identity.Snapshot(); snapshot.OwnerSID != view.OwnerSID ||
+		snapshot.OriginalPID != view.OriginalPID || len(snapshot.EvidenceSHA256) != 64 {
+		t.Fatalf("issued snapshot lost original fields: %+v", snapshot)
+	}
+	if next, err := p.ObserveCreatorIdentity(ctx); err != nil || next == nil || calls != 2 {
+		t.Fatalf("completed observation left issuer busy: calls=%d err=%v", calls, err)
+	}
+	if child.waits.Load() != 0 || child.closes.Load() != 0 || child.terminations.Load() != 0 {
+		t.Fatal("identity observation changed process lifetime")
+	}
+}
+
+func TestCreatorIdentityGoIssuerContextAndRecovery(t *testing.T) {
+	for _, name := range []string{"nil", "unbounded", "canceled", "expired", "canceled-in-observer", "observer-error"} {
+		t.Run(name, func(t *testing.T) {
+			p, child, view := creatorIdentityGoFixture(t)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			var supplied context.Context = ctx
+			calls := 0
+			sentinel := errors.New("controlled original observation failure")
+			child.observe = func(context.Context) (CreatorIdentitySnapshot, error) {
+				calls++
+				if name == "canceled-in-observer" {
+					cancel()
+				}
+				if name == "observer-error" {
+					return CreatorIdentitySnapshot{}, sentinel
+				}
+				return view, nil
+			}
+			var expected error
+			expectedCalls := 0
+			switch name {
+			case "nil":
+				supplied = nil
+			case "unbounded":
+				supplied = context.Background()
+			case "canceled":
+				cancel()
+				expected = context.Canceled
+			case "expired":
+				expired, expire := context.WithDeadline(ctx, time.Now().Add(-time.Second))
+				defer expire()
+				supplied, expected = expired, context.DeadlineExceeded
+			case "canceled-in-observer":
+				expected, expectedCalls = context.Canceled, 1
+			case "observer-error":
+				expected, expectedCalls = sentinel, 1
+			}
+			identity, err := p.ObserveCreatorIdentity(supplied)
+			if identity != nil || err == nil || (expected != nil && !errors.Is(err, expected)) || calls != expectedCalls {
+				t.Fatalf("context refusal: identity=%t calls=%d err=%v", identity != nil, calls, err)
+			}
+			child.observe = func(context.Context) (CreatorIdentitySnapshot, error) { return view, nil }
+			retry, done := context.WithTimeout(context.Background(), 5*time.Second)
+			defer done()
+			if next, err := p.ObserveCreatorIdentity(retry); err != nil || next == nil {
+				t.Fatalf("failed observation left issuer unusable: %v", err)
+			}
+		})
+	}
+}
+
+func TestCreatorIdentityGoIssuerRejectsIncompleteEvidence(t *testing.T) {
+	for _, name := range []string{
+		"version", "pid", "birth", "image", "sid", "original-job",
+		"membership-unknown", "wait-unknown", "wait-undefined", "alive-disagrees",
+		"live-outside-job", "missing-receipt", "snapshot-receipt", "mismatched-sid",
+	} {
+		t.Run(name, func(t *testing.T) {
+			p, child, valid := creatorIdentityGoFixture(t)
+			view, receipt := valid, child.formatting
+			switch name {
+			case "version":
+				view.Version = 2
+			case "pid":
+				view.OriginalPID = 0
+			case "birth":
+				view.OriginalStartedAt = ""
+			case "image":
+				view.ExecutablePath = ""
+			case "sid":
+				view.OwnerSID = ""
+			case "original-job":
+				view.OriginalJobBound = false
+			case "membership-unknown":
+				view.CurrentJobMembershipKnown = false
+			case "wait-unknown":
+				view.RootWaitKnown = false
+			case "wait-undefined":
+				view.RootWaitResult = 259
+			case "alive-disagrees":
+				view.RootAlive = false
+			case "live-outside-job":
+				view.CurrentJobMember = false
+			case "missing-receipt":
+				child.formatting = nil
+			case "snapshot-receipt":
+				child.formatting = &SIDFormatObservation{view: receipt.Snapshot()}
+			case "mismatched-sid":
+				view.OwnerSID += "-0"
+			}
+			child.observe = func(context.Context) (CreatorIdentitySnapshot, error) { return view, nil }
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			if identity, err := p.ObserveCreatorIdentity(ctx); identity != nil || err == nil {
+				t.Fatalf("incomplete evidence issued authority: present=%t err=%v", identity != nil, err)
+			}
+			view, child.formatting = valid, receipt
+			if next, err := p.ObserveCreatorIdentity(ctx); next == nil || err != nil {
+				t.Fatalf("refusal left issuer busy: %v", err)
+			}
+		})
+	}
+}
+
+func TestCreatorIdentityGoIssuerAcceptsExitedRoot(t *testing.T) {
+	p, child, view := creatorIdentityGoFixture(t)
+	view.RootAlive, view.CurrentJobMember = false, false
+	view.RootWaitResult = uint32(windows.WAIT_OBJECT_0)
+	child.observe = func(context.Context) (CreatorIdentitySnapshot, error) { return view, nil }
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	identity, err := p.ObserveCreatorIdentity(ctx)
+	if err != nil || identity == nil || identity.Snapshot().RootAlive || identity.Snapshot().CurrentJobMember {
+		t.Fatalf("known exited original root refused: %v", err)
+	}
+}

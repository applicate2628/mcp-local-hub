+func TestOpenRustOwnerLibraryOlderProfilesNeverResolveOpportunisticBorrow(t *testing.T) {
+	for _, name := range []string{"legacy13", "member17"} {
+		t.Run(name, func(t *testing.T) {
+			layout := newRustOwnerTestLayout(t)
+			if name == "member17" {
+				layout.expected.Exports = runtimeidentity.WindowsProcessOwnerMemberExportsV1()
+				writeRustOwnerTestIdentity(t, layout.identity, layout.expected)
+			}
+			api := newFakeRustOwnerLibraryAPI(layout)
+			api.procAddrs["mh_borrow_process1"] = 0x4000
+			library, err, calls := openFakeRustOwner(t, layout, api)
+			if library != nil {
+				t.Cleanup(func() { _ = library.Close() })
+			}
+			if err != nil || library == nil || calls != 2 || !reflect.DeepEqual(api.procNames, layout.expected.Exports) {
+				t.Fatalf("older profile changed: error=%v resolved=%v", err, api.procNames)
+			}
+			if address, ok := library.procedure("mh_borrow_process1"); ok || address != 0 {
+				t.Fatal("unadmitted export address extended original capability")
+			}
+		})
+	}
+}

+// These tests use synthetic loader/create callbacks. They do not create a
+// process or qualify an installed Product; marked native selection is separate.
+func rustContainedWrapperFixture(t *testing.T, ctx context.Context, cmd *exec.Cmd) *productRustContainedChild {
+	t.Helper()
+	value, err := newProductRustContainedChild(ctx, cmd)
+	child, ok := value.(*productRustContainedChild)
+	if err != nil || !ok || child.rustContainedChild == nil {
+		t.Fatalf("contained adapter: child=%T err=%v", value, err)
+	}
+	t.Cleanup(func() {
+		if !child.containedCreated() {
+			_ = child.close() // Also safe after an explicitly asserted cached failure.
+		}
+	})
+	return child
+}
+
+func rustContainedAssertNoChildClose(t *testing.T, child *productRustContainedChild, want error) {
+	t.Helper()
+	if !child.noChildKnown || child.containedCreated() {
+		t.Fatal("refused startup lost its positive no-child state")
+	}
+	for i := 0; i < 2; i++ {
+		if err := child.close(); !errors.Is(err, want) {
+			t.Fatalf("no-child close %d: got=%v want=%v", i, err, want)
+		}
+	}
+}

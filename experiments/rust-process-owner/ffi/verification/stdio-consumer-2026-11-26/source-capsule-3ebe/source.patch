+func TestRustOwnerReleaseRejectsClearedSlotWithoutTerminalSettlement(t *testing.T) {
+	callback := syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		if slot == nil || *slot != 0x9876 || out == nil || size != 48 {
+			return 1
+		}
+		*slot = 0
+		*out = rustOwnerOutcome{Size: 48, Version: 1} // wrong: no terminal outcome
+		return 0

+func TestAutoRegisterSerena_CommittedPathRetainsRowOnSettlementFailure(t *testing.T) {
+	for _, committed := range []bool{true, false} {
+		name := "committed-path"
+		if !committed {
+			name = "empty-path-precommit"
+		}
+		t.Run(name, func(t *testing.T) {
+			regPath := autoRegisterTestEnv(t)
+			stateDir := filepath.Join(filepath.Dir(regPath), "state")
+			intentPath := filepath.Join(stateDir, supervisorIntentFileLeaf)
+			intentBytes := []byte("committed intent fixture")
+			closeCause := errors.New("original invocation observed close failed")
+			requestCtx, cancelRequest := context.WithCancel(context.Background())
+			defer cancelRequest()
+			stubAutoRegisterInstall(t, func(context.Context, *API, *config.ServerManifest, InstallParsedManifestOpts) (string, error) {
+				if !committed {
+					return "", closeCause
+				}
+				// This existing installer seam models only the public return
+				// contract; it issues no prepared invocation or publisher authority.
+				if err := os.WriteFile(intentPath, intentBytes, 0o600); err != nil {
+					t.Fatal(err)
+				}
+				cancelRequest()
+				return intentPath, closeCause
+			})
+			reconcileCalls, readinessCalls := 0, 0
+			stubAutoRegisterReconcile(t, func(ctx context.Context, apply bool) (ReconcileResponse, error) {
+				reconcileCalls++
+				if !apply || ctx.Err() != nil {
+					t.Errorf("committed continuation: apply=%t cause=%v", apply, ctx.Err())
+				}
+				return ReconcileResponse{}, nil
+			})
+			stubAutoRegisterReadiness(t, func(int, time.Duration) error {
+				readinessCalls++
+				return nil
+			})
+
+			root := writeSerenaMarker(t, t.TempDir(), validSerenaMarkerYAML)
+			entry, err := NewAPI().AutoRegisterSerenaWorkspace(requestCtx, root)
+			if !errors.Is(err, closeCause) {
+				t.Fatalf("error=%v, want original settlement cause", err)
+			}
+			rows := loadRegSerenaRows(t, regPath)
+			if committed {
+				if entry == nil || len(rows) != 1 {
+					t.Errorf("entry=%+v rows=%+v; committed path must retain the registered row", entry, rows)
+				} else if rows[0].WorkspaceKey != entry.WorkspaceKey {
+					t.Errorf("registry key=%q, committed entry key=%q", rows[0].WorkspaceKey, entry.WorkspaceKey)
+				}
+				if got, readErr := os.ReadFile(intentPath); readErr != nil || !bytes.Equal(got, intentBytes) {
+					t.Errorf("committed intent=%q cause=%v, want original bytes retained", got, readErr)
+				}
+				if reconcileCalls != 1 {
+					t.Errorf("reconcile calls=%d, want one committed continuation", reconcileCalls)
+				}
+			} else {
+				if entry != nil || len(rows) != 0 || reconcileCalls != 0 {
+					t.Errorf("precommit outcome: entry=%+v rows=%+v reconcile=%d; want rollback with no continuation", entry, rows, reconcileCalls)
+				}
+				if _, statErr := os.Stat(intentPath); !errors.Is(statErr, os.ErrNotExist) {
+					t.Errorf("precommit refusal left intent: %v", statErr)
+				}
+			}
+			if readinessCalls != 0 {
+				t.Errorf("readiness calls=%d, want zero after the original lifecycle failure", readinessCalls)
+			}
+		})
+	}
+}

+func TestRustOwnerArgv0ABIRejectsInvalidBeforeNativeEntry(t *testing.T) {
+	for _, name := range []string{"nul", "invalid-utf8", "individual-budget", "aggregate-budget", "encoded-budget", "65-user-arguments"} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			program := filepath.Join(dir, "not-executed.exe")
+			argv0 := "git"
+			args := []string{}
+			switch name {
+			case "nul":
+				argv0 = "git\x00hidden"
+			case "invalid-utf8":
+				argv0 = string([]byte{0xff})
+			case "individual-budget":
+				argv0 = strings.Repeat("a", 32767)
+			case "aggregate-budget":
+				programUnits, _ := syscall.UTF16FromString(program)
+				cwdUnits, _ := syscall.UTF16FromString(dir)
+				argv0 = strings.Repeat("a", 32766-(len(programUnits)-1)-(len(cwdUnits)-1))
+				args = []string{"x"}
+			case "encoded-budget":
+				args = []string{strings.Repeat("\"", 16400)}
+			case "65-user-arguments":
+				args = make([]string, 65)
+			}
+			library, probe := rustArgv0ABIRejectingLibrary(nil)
+			launch := &rustOwnerLaunchIO{
+				argv0: &argv0, environment: []rustOwnerEnvironmentEntry{}, streams: rustStdioTestFiles(t),
+			}
+			var retained *rustNativeOwner
+			owner, _, err := library.startRetainedRustOwnerContext(
+				rustStdioTestContext(t), program, dir, args, launch,
+				func(original *rustNativeOwner) error { retained = original; return nil },
+			)
+			if err == nil || probe.calls.Load() != 0 || probe.failure != "" ||
+				(owner != nil && owner.createEntered.Load()) {
+				t.Fatalf("invalid v2 request crossed native entry: calls=%d failure=%q err=%v", probe.calls.Load(), probe.failure, err)
+			}
+			rustIOABIAssertAbandoned(t, library, owner, retained)
+		})
+	}
+}
+
+func TestRustOwnerArgv0ABIOldDLLRefusesWithoutFallback(t *testing.T) {
+	var ioCalls, legacyCalls atomic.Int32
+	library := &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{}}
+	library.procedures["mh_create_io1"] = syscall.NewCallback(func(
+		_ *rustOwnerCreate, _ uintptr, _ *rustOwnerIOContext, _ uintptr,
+		_ *uintptr, output *rustOwnerOutcome, _ uintptr,
+	) uintptr {
+		ioCalls.Add(1)
+		*output = rustOwnerOutcome{Size: 48, Version: 1}
+		return 2 // An old DLL's MH_ABI refusal, with no owner.
+	})
+	library.procedures["mh_create1"] = syscall.NewCallback(func(_, _, _, _, _ uintptr) uintptr {
+		legacyCalls.Add(1)
+		return 2
+	})
+	library.procedures["mh_create_env1"] = syscall.NewCallback(func(_, _, _, _, _, _, _ uintptr) uintptr {
+		legacyCalls.Add(1)
+		return 2
+	})
+	dir := t.TempDir()
+	argv0 := "git"
+	var retained *rustNativeOwner
+	owner, output, err := library.startRetainedRustOwnerContext(
+		rustStdioTestContext(t), filepath.Join(dir, "not-executed.exe"), dir, nil,
+		&rustOwnerLaunchIO{argv0: &argv0, environment: []rustOwnerEnvironmentEntry{}, streams: rustStdioTestFiles(t)},
+		func(original *rustNativeOwner) error { retained = original; return nil },
+	)
+	if err == nil || errors.Is(err, errRustOwnerOutcome) || ioCalls.Load() != 1 || legacyCalls.Load() != 0 ||
+		output != (rustOwnerOutcome{Size: 48, Version: 1}) || owner == nil || !owner.createNoChild.Load() {
+		t.Fatalf("ABI refusal lost no-child evidence or retried: io=%d legacy=%d output=%+v err=%v", ioCalls.Load(), legacyCalls.Load(), output, err)
+	}
+	rustIOABIAssertAbandoned(t, library, owner, retained)
+}
diff --git a/internal/process/rust_owner_command_windows.go b/internal/process/rust_owner_command_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..b99171980f1fd52a2c53914fa467ab40283f40f6
--- /dev/null
+++ b/internal/process/rust_owner_command_windows.go
@@ -0,0 +1,146 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"errors"
+	"fmt"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// preparedRustOwnerCommand is copied launch data, never execution authority.
+// The native constructor still owns argument and UTF-16 request budgets.
+type preparedRustOwnerCommand struct {
+	program, cwd string
+	argv0        string
+	noConsole    bool // copied explicit NoConsole; background defaults are separate
+	args         []string
+	environment  []rustOwnerEnvironmentEntry
+}
+
+// prepareRustOwnerCommand accepts an already resolved absolute image and cwd.
+// A supplied argv[0] is copied separately from the image. Absent Args use Path,
+// matching exec.Cmd's argv policy. No PATH lookup, cwd sampling, command mutation or stream setup
+// occurs here. The caller must not mutate cmd during this call; the returned
+// slices are independent. Standard files are supplied separately at create.
+func prepareRustOwnerCommand(cmd *exec.Cmd) (preparedRustOwnerCommand, error) {
+	if cmd == nil {
+		return preparedRustOwnerCommand{}, errors.New("Rust command preparation requires a command")
+	}
+	if cmd.Err != nil {
+		return preparedRustOwnerCommand{}, fmt.Errorf("Rust command lookup failed: %w", cmd.Err)
+	}
+	if !filepath.IsAbs(cmd.Path) || !filepath.IsAbs(cmd.Dir) {
+		return preparedRustOwnerCommand{}, errors.New("Rust command preparation requires absolute program and cwd")
+	}
+	if cmd.Process != nil || cmd.ProcessState != nil ||
+		cmd.Stdin != nil || cmd.Stdout != nil || cmd.Stderr != nil ||
+		len(cmd.ExtraFiles) != 0 || cmd.Cancel != nil || cmd.WaitDelay != 0 {
+		return preparedRustOwnerCommand{}, errors.New("Rust command has unsupported state or execution options")
+	}
+	noConsole := false
+	if a := cmd.SysProcAttr; a != nil {
+		zeroWindowOptions := !a.HideWindow && a.CreationFlags == 0
+		noConsoleOptions := a.HideWindow && a.CreationFlags == windows.CREATE_NO_WINDOW
+		noConsole = noConsoleOptions
+		if (!zeroWindowOptions && !noConsoleOptions) || a.CmdLine != "" || a.Token != 0 ||
+			a.ProcessAttributes != nil || a.ThreadAttributes != nil || a.NoInheritHandles ||
+			len(a.AdditionalInheritedHandles) != 0 || a.ParentProcess != 0 {
+			return preparedRustOwnerCommand{}, errors.New("Rust command has unsupported Windows process options")
+		}
+	}
+	environment, err := prepareRustOwnerCommandEnvironment(cmd)
+	if err != nil {
+		return preparedRustOwnerCommand{}, err
+	}
+	argv0 := cmd.Path
+	var args []string
+	if len(cmd.Args) != 0 {
+		argv0 = cmd.Args[0]
+		args = append([]string(nil), cmd.Args[1:]...)
+	}
+	return preparedRustOwnerCommand{
+		program: cmd.Path, cwd: cmd.Dir, argv0: argv0, noConsole: noConsole, args: args, environment: environment,
+	}, nil
+}
+
+// Cmd.Environ supplies the existing Go last-wins and critical-variable policy.
+// Its best-effort API drops NUL entries, so reject them in the raw input first.
+// Drive-directory entries keep their leading '=' as part of the name.
+// Explicit empty Cmd.Env still gets Go's SYSTEMROOT; this does not alter the
+// separate native API's nil-versus-explicit-empty contract.
+func prepareRustOwnerCommandEnvironment(cmd *exec.Cmd) ([]rustOwnerEnvironmentEntry, error) {
+	for _, entry := range cmd.Env {
+		if strings.IndexByte(entry, 0) >= 0 {
+			return nil, errors.New("Rust command environment contains an unsupported entry")
+		}
+	}
+	effective := cmd.Environ()
+	type namedEntry struct {
+		entry rustOwnerEnvironmentEntry
+		name  []uint16
+	}
+	ordered := make([]namedEntry, len(effective))
+	for i, entry := range effective {
+		separator := strings.IndexByte(entry, '=')
+		if separator == 0 {
+			separator = strings.IndexByte(entry[1:], '=') + 1
+		}
+		if separator <= 0 {
+			return nil, errors.New("Rust command environment requires valid name=value entries")
+		}
+		name, value := entry[:separator], entry[separator+1:]
+		units, _, err := rustOwnerWide(name)
+		if err != nil {
+			return nil, fmt.Errorf("Rust command environment name %d: %w", i, err)
+		}
+		ordered[i] = namedEntry{entry: rustOwnerEnvironmentEntry{Name: name, Value: value}, name: units}
+	}
+	if len(ordered) > 1 {
+		if err := rustOwnerCompareStringOrdinal.Find(); err != nil {
+			return nil, fmt.Errorf("Rust command environment ordinal comparison unavailable: %w", err)
+		}
+		var comparisonErr error
+		sort.Slice(ordered, func(i, j int) bool {
+			if comparisonErr != nil {
+				return false
+			}
+			left, right := ordered[i].name, ordered[j].name
+			order, _, callErr := rustOwnerCompareStringOrdinal.Call(
+				uintptr(unsafe.Pointer(&left[0])), uintptr(len(left)-1),
+				uintptr(unsafe.Pointer(&right[0])), uintptr(len(right)-1), 1)
+			runtime.KeepAlive(left)
+			runtime.KeepAlive(right)
+			if order == 0 {
+				if callErr == nil || callErr == syscall.Errno(0) {
+					callErr = syscall.EINVAL
+				}
+				comparisonErr = fmt.Errorf("Rust command environment ordinal comparison failed: %w", callErr)
+				return false
+			}
+			return order == 1 // CSTR_LESS_THAN; equality is refused below.
+		})
+		if comparisonErr != nil {
+			return nil, comparisonErr
+		}
+	}
+	environment := make([]rustOwnerEnvironmentEntry, len(ordered))
+	for i, entry := range ordered {
+		environment[i] = entry.entry
+	}
+	// Keep the established native validation as the single environment budget
+	// and uniqueness rule. In particular, an ordinal collision surviving Go's
+	// lowercase dedup must fail instead of choosing a different winning value.
+	if _, _, err := prepareRustOwnerEnvironment(environment); err != nil {
+		return nil, err
+	}
+	return environment, nil
+}

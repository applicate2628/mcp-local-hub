+func TestStdioRustOriginalInvalidCommandRetainsNoChildFacade(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		mutate    func(*exec.Cmd)
+		wantError string
+	}{
+		{
+			name: "wait-delay",
+			mutate: func(cmd *exec.Cmd) {
+				cmd.WaitDelay = time.Millisecond
+			},
+			wantError: "unsupported state or execution options",
+		},
+		{
+			name: "malformed-hidden-drive-entry",
+			mutate: func(cmd *exec.Cmd) {
+				cmd.Env = append(append([]string(nil), cmd.Env...), "=CD:=D:\\fixture")
+			},
+			wantError: "needs an ordinary name or a drive-directory name",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			h, root := newStdioRustOriginalHost(t, "echo")
+			var retained, returned *process.AtCreateJobProcess
+			var factoryError error
+			factoryCalls, retainCalls := 0, 0
+			h.originalLaunch = &stdioOriginalLaunchOps{
+				startRust: func(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+					retain func(*process.AtCreateJobProcess) error) (*process.AtCreateJobProcess, error) {
+					factoryCalls++
+					// Copy only the not-yet-started command. The ordinary host command
+					// remains unchanged; actual factory preparation rejects this option.
+					invalid := *cmd
+					test.mutate(&invalid)
+					returned, factoryError = process.StartProductRustOriginal(ctx, &invalid, stdin, stdout, stderr,
+						func(p *process.AtCreateJobProcess) error {
+							retained = p
+							retainCalls++
+							return retain(p)
+						})
+					return returned, factoryError
+				},
+			}
+			startErr := h.Start(context.Background())
+			if factoryError == nil || !strings.Contains(factoryError.Error(), test.wantError) ||
+				!errors.Is(startErr, factoryError) || factoryCalls != 1 || retainCalls != 1 ||
+				retained == nil || returned != retained {
+				t.Fatalf("preparation refusal did not retain its acquired module facade: retained=%p returned=%p factory=%d retain=%d actual=%v start=%v",
+					retained, returned, factoryCalls, retainCalls, factoryError, startErr)
+			}
+			result := stdioRustOriginalNoChild(t, h, retained)
+			if !errors.Is(result.PrimaryError, factoryError) || h.cmd.WaitDelay != 0 {
+				t.Fatalf("preparation failure changed the original command or lost its cause: %+v", result)
+			}
+			if _, err := os.Stat(filepath.Join(root, "root-ready")); !errors.Is(err, os.ErrNotExist) {
+				t.Fatal("invalid command executed the helper")
+			}
+		})
+	}

+func loadCanonicalNativeExternalChannel(path, test string) (canonicalnativefixture.Channel, canonicalnativefixture.SlotBinding, time.Time, error) {
+	var channel canonicalnativefixture.Channel
+	if err := canonicalnativefixture.Read(path, &channel); err != nil {
+		return channel, canonicalnativefixture.SlotBinding{}, time.Time{}, err
+	}
+	slot, work, err := canonicalNativeExternalSlot(path, channel, test)
+	if err != nil {
+		return channel, slot, work, err
+	}
+	for _, input := range []canonicalnativefixture.ImageInput{channel.Binary, channel.Fixture} {
+		if err := canonicalnativefixture.CheckedPath(input.Path, false); err != nil {
+			return channel, slot, work, err
+		}
+	}
+	if err := canonicalnativefixture.CheckedPath(channel.SourceDir, true); err != nil {
+		return channel, slot, work, err
+	}
+	image, imageErr := os.Executable()
+	cwd, cwdErr := os.Getwd()
+	if imageErr != nil || cwdErr != nil || !samePath(image, channel.Binary.Path) || !samePath(cwd, channel.SourceDir) ||
+		os.Getenv("MCPHUB_CANONICAL_NATIVE_ACTOR_FIXTURE") != channel.Fixture.Path {
+		return channel, slot, work, errors.Join(imageErr, cwdErr, errors.New("external channel operands differ from the current image, source directory or native fixture"))
+	}
+	for _, input := range []canonicalnativefixture.ImageInput{channel.Binary, channel.Fixture} {
+		if current, err := hashFile(input.Path); err != nil || fmt.Sprintf("%x", current) != input.SHA256 {
+			return channel, slot, work, errors.Join(err, errors.New("external channel input bytes differ"))
+		}
+	}
+	return channel, slot, work, nil
+}

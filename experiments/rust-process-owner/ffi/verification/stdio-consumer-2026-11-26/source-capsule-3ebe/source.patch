+func TestProductRustContainedAdmissionDeadlineAndScope(t *testing.T) {
+	type contextKey struct{}
+	for _, parentTimeout := range []time.Duration{0, time.Second, 30 * time.Second} {
+		t.Run(parentTimeout.String(), func(t *testing.T) {
+			parent := context.WithValue(context.Background(), contextKey{}, "work-context")
+			if parentTimeout != 0 {
+				var cancel context.CancelFunc
+				parent, cancel = context.WithTimeout(parent, parentTimeout)
+				defer cancel()
+			}
+			cmd := rustOwnerCommandFixture()
+			child := rustContainedWrapperFixture(t, parent, cmd)
+			loadErr := errors.New("stop before native creation")
+			var admission context.Context
+			var capturedAt time.Time
+			child.open = func() (*rustOwnerLibrary, error) {
+				admission = child.startContext
+				capturedAt = time.Now()
+				return nil, loadErr
+			}
+			before := time.Now()
+			err := child.start(cmd, nil, nil, nil)
+			if !errors.Is(err, loadErr) || errors.Is(err, context.Canceled) || admission == nil {
+				t.Fatalf("admission result: err=%v context=%v", err, admission)
+			}
+			deadline, finite := admission.Deadline()
+			if !finite || admission.Value(contextKey{}) != "work-context" {
+				t.Fatal("startup lost its finite deadline or caller context values")
+			}
+			if parentTimeout != 0 && parentTimeout < productRustContainedStartTimeout {
+				want, _ := parent.Deadline()
+				if !deadline.Equal(want) {
+					t.Fatalf("startup extended the caller deadline: got=%v want=%v", deadline, want)
+				}
+			} else if deadline.Before(before.Add(productRustContainedStartTimeout)) ||
+				deadline.After(capturedAt.Add(productRustContainedStartTimeout)) {
+				t.Fatal("startup did not select the bounded admission interval")
+			}
+			// Returning cancels only the derived admission context. It must not
+			// cancel the work context or add the deferred cancellation to err.
+			if !errors.Is(admission.Err(), context.Canceled) || parent.Err() != nil {
+				t.Fatalf("startup cancellation escaped its scope: admission=%v parent=%v", admission.Err(), parent.Err())
+			}
+			rustContainedAssertNoChildClose(t, child, nil)
+		})
+	}
+}

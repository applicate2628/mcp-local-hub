+func TestRustOwnerForegroundIORejectsInvalidBeforeNativeEntry(t *testing.T) {
+	for _, name := range []string{"missing-argv0", "nul", "invalid-utf8", "individual-budget", "aggregate-budget", "encoded-budget", "65-user-arguments"} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			program := filepath.Join(dir, "not-executed.exe")
+			argv0 := "alias"
+			args := []string{}
+			switch name {
+			case "nul":
+				argv0 = "alias\x00hidden"
+			case "invalid-utf8":
+				argv0 = string([]byte{0xff})
+			case "individual-budget":
+				argv0 = strings.Repeat("a", 32767)
+			case "aggregate-budget":
+				image, _ := syscall.UTF16FromString(program)
+				cwd, _ := syscall.UTF16FromString(dir)
+				argv0 = strings.Repeat("a", 32766-(len(image)-1)-(len(cwd)-1))
+				args = []string{"x"}
+			case "encoded-budget":
+				args = []string{strings.Repeat("\"", 16400)}
+			case "65-user-arguments":
+				args = make([]string, 65)
+			}
+			library, probe := rustArgv0ABIRejectingLibrary(nil) // No version may reach this trap.
+			launch := &rustOwnerLaunchIO{
+				argv0: &argv0, foreground: true, environment: []rustOwnerEnvironmentEntry{}, streams: rustStdioTestFiles(t),
+			}
+			if name == "missing-argv0" {
+				launch.argv0 = nil
+			}
+			var retained *rustNativeOwner
+			owner, _, err := library.startRetainedRustOwnerContext(rustStdioTestContext(t), program, dir, args, launch,
+				func(original *rustNativeOwner) error { retained = original; return nil })
+			if err == nil || probe.calls.Load() != 0 || probe.failure != "" || (owner != nil && owner.createEntered.Load()) {
+				t.Fatalf("invalid v3 request crossed native entry: calls=%d failure=%q err=%v", probe.calls.Load(), probe.failure, err)
+			}
+			rustIOABIAssertAbandoned(t, library, owner, retained)
+		})
+	}
+}

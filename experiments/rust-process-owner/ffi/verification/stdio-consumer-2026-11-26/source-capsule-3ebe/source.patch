+	task := "\\mcp-local-hub-serena-default"
+	baselineManifest := &config.ServerManifest{Name: api.SerenaServerName, BaseArgs: []string{
+		"--from", "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd", "serena",
+	}}

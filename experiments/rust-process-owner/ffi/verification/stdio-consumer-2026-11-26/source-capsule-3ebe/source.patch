+	firstGeneration := first.native.(*rustOwnerMemberObservation).generation
+	proof, err := first.CloseObserved()
+	if err != nil || !proof.Finalized() || proof.Validate(source) != nil ||
+		len(proof.Snapshot().Resources) != 1 || !proof.Snapshot().Resources[0].BorrowedOriginal ||
+		proof.Snapshot().Resources[0].CloseAttempted {
+		t.Fatalf("root-only native generation did not finalize: %v", err)
+	}
+	identity, err := f.owner.QueryIdentity()
+	if err != nil || identity.PID != f.root.PID || identity.CreationTime100ns != f.root.CreationTime100ns {
+		t.Fatalf("borrowed original was lost during member close: %v", err)

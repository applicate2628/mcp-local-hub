+func TestRustOwnerMemberFiniteAdmissionAndPreEntryCancellation(t *testing.T) {
+	for _, which := range []string{"owner", "library"} {
+		t.Run(which+"-deadline", func(t *testing.T) {
+			f := newRustMemberScript(t)
+			o := f.acquire(t)
+			mu := &f.owner.mu
+			if which == "library" {
+				mu = &f.owner.library.mu
+			}
+			mu.Lock()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+			permit, err := f.owner.memberGate.beginTerminal(ctx)
+			cancel()
+			mu.Unlock()
+			if permit != nil {
+				permit.finish()
+			}
+			if !errors.Is(err, context.DeadlineExceeded) || permit != nil || f.closeCalls != 0 {
+				t.Fatalf("finite terminal admission entered native close: permit=%t calls=%d err=%v", permit != nil, f.closeCalls, err)
+			}
+			fresh, finish := context.WithTimeout(context.Background(), time.Second)
+			defer finish()
+			permit, err = f.owner.memberGate.beginTerminal(fresh)
+			if permit != nil {
+				permit.finish()
+			}
+			if err == nil || permit != nil || fresh.Err() != nil || f.closeCalls != 0 {
+				t.Fatalf("renewed terminal deadline was accepted: permit=%t calls=%d caller=%v err=%v", permit != nil, f.closeCalls, fresh.Err(), err)
+			}
+			proof, err := o.CloseObserved()
+			if err != nil || !proof.Finalized() || f.closeCalls != 1 {
+				t.Fatalf("explicit nonblocking batch close did not settle once: %v", err)
+			}
+		})
+	}
+	t.Run("cancel-before-syscall", func(t *testing.T) {
+		f := newRustMemberScript(t)
+		o := f.acquire(t)
+		base, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		ctx := rustMemberCancelAtNativeEntry{Context: base, owner: f.owner, cancel: cancel}
+		pending, err := o.closeObserved(ctx)
+		if !errors.Is(err, context.Canceled) || pending.Finalized() || f.closeCalls != 0 ||
+			o.native.(*rustOwnerMemberObservation).closeEntered {
+			t.Fatalf("cancellation after locks still entered native close: calls=%d err=%v", f.closeCalls, err)
+		}
+		final, err := o.CloseObserved()
+		if err != nil || !final.Finalized() || f.closeCalls != 1 {
+			t.Fatalf("pre-entry cancellation poisoned native cleanup: %v", err)
+		}
+	})
+}
+
+func TestRustOwnerMemberLegacyHasNoSourceCapability(t *testing.T) {
+	owner := &rustNativeOwner{raw: 0x4264, originalPID: 42, memberGate: newOriginalMemberCustody(),
+		library: &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{}}}
+	installRustOwnerMemberSource(owner)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if source, err := owner.originalMemberSourceCapability(ctx); source != nil || err == nil || owner.memberGate.source != nil {
+		t.Fatal("owner without any member exports issued a member source")
+	}
+}
diff --git a/internal/process/rust_owner_native_windows.go b/internal/process/rust_owner_native_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a9c1d75d964a560abffdd531e4597ee0375d1a90
--- /dev/null
+++ b/internal/process/rust_owner_native_windows.go
@@ -0,0 +1,437 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"unicode/utf8"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// rustNativeOwner holds the single transferred Rust allocation. It is not a
+// PID-based owner and has no finalizer or implicit termination fallback.
+type rustNativeOwner struct {
+	mu            sync.Mutex
+	library       *rustOwnerLibrary
+	raw           uintptr
+	originalPID   uint32                             // validated creation identity, when available; guarded by mu
+	rootWait      atomic.Pointer[rustRootWaitResult] // immutable fact; published under mu, replayed without native locks
+	releaseErr    error                              // cached terminal native release outcome
+	closeStarted  bool                               // invocation history, not proof of successful cleanup; guarded by mu
+	memberGate    *originalMemberCustody             // original query/terminal gate; no Windows Job handle
+	preparing     atomic.Bool                        // false after completed or abandoned creation; Stop may seal it
+	created       atomic.Bool                        // historical native slot transfer, independent of decoded identity
+	createEntered atomic.Bool                        // the synchronous create export was invoked
+	createNoChild atomic.Bool                        // a validated create refusal returned no native owner
+	sealed        bool
+}
+
+func rustOwnerWide(s string) ([]uint16, rustOwnerUTF16, error) {
+	if !utf8.ValidString(s) || strings.IndexByte(s, 0) >= 0 {
+		return nil, rustOwnerUTF16{}, errors.New("invalid Rust owner UTF-16 input")
+	}
+	units, err := syscall.UTF16FromString(s)
+	if err != nil || len(units) > 32767 {
+		return nil, rustOwnerUTF16{}, errors.New("Rust owner UTF-16 input exceeds bound")
+	}
+	return units, rustOwnerUTF16{Data: &units[0], Len: uintptr(len(units) - 1)}, nil
+}
+
+// newRustOwner copies a complete request synchronously. It can return both a
+// native owner and an error: the owner MUST be retained and settled in that case.
+func (library *rustOwnerLibrary) newRustOwner(program, cwd string, args []string) (*rustNativeOwner, rustOwnerOutcome, error) {
+	return library.newRustOwnerInto(nil, program, cwd, args)
+}
+
+// target, when provided, is the object already retained by the product caller.
+// Its mutex is held by that caller through this synchronous native create.
+func (library *rustOwnerLibrary) newRustOwnerInto(target *rustNativeOwner, program, cwd string, args []string) (*rustNativeOwner, rustOwnerOutcome, error) {
+	return library.newRustOwnerIntoContext(nil, target, program, cwd, args, nil)
+}
+
+type rustOwnerLaunchIO struct {
+	argv0       *string // nil keeps v1; non-nil selects explicit argv[0] in IO v2/v3.
+	foreground  bool    // v3: inherit an existing console; requires explicit argv[0]
+	environment []rustOwnerEnvironmentEntry
+	streams     rustOwnerStdio
+}
+
+// ctx is finite for IO; nil retains the original no-IO private contract.
+// target.mu is held when target is supplied. File copies are consumed once,
+// but their close error never revokes a transferred native owner.
+func (library *rustOwnerLibrary) newRustOwnerIntoContext(
+	ctx context.Context, target *rustNativeOwner, program, cwd string, args []string, launchIO *rustOwnerLaunchIO,
+) (owner *rustNativeOwner, observed rustOwnerOutcome, createErr error) {
+	if target != nil && (target.library != library || target.raw != 0) {
+		return nil, rustOwnerOutcome{}, errors.New("Rust owner target does not match retained custody")
+	}
+	if !filepath.IsAbs(program) || !filepath.IsAbs(cwd) || len(args) > 64 {
+		return nil, rustOwnerOutcome{}, errors.New("Rust owner requires absolute program/cwd and at most 64 arguments")
+	}
+	programUnits, programView, err := rustOwnerWide(program)
+	if err != nil {
+		return nil, rustOwnerOutcome{}, err
+	}
+	cwdUnits, cwdView, err := rustOwnerWide(cwd)
+	if err != nil {
+		return nil, rustOwnerOutcome{}, err
+	}
+	if launchIO != nil && launchIO.foreground && launchIO.argv0 == nil {
+		return nil, rustOwnerOutcome{}, errors.New("Rust foreground IO requires explicit argv[0]")
+	}
+	version := uint32(1)
+	wireArgs := args
+	if launchIO != nil && launchIO.argv0 != nil {
+		version = 2
+		if launchIO.foreground {
+			version = 3
+		}
+		wireArgs = make([]string, 1, len(args)+1)
+		wireArgs[0] = *launchIO.argv0
+		wireArgs = append(wireArgs, args...)
+	}
+	total := programView.Len + cwdView.Len
+	argUnits := make([][]uint16, len(wireArgs))
+	argViews := make([]rustOwnerUTF16, len(wireArgs))
+	for i, arg := range wireArgs {
+		var e error
+		argUnits[i], argViews[i], e = rustOwnerWide(arg)
+		if e != nil {
+			return nil, rustOwnerOutcome{}, fmt.Errorf("Rust owner argument %d: %w", i, e)
+		}
+		total += argViews[i].Len
+		if total > 32766 {
+			return nil, rustOwnerOutcome{}, errors.New("Rust owner argument payload exceeds UTF-16 bound")
+		}
+	}
+	if total > 32766 {
+		return nil, rustOwnerOutcome{}, errors.New("Rust owner create request exceeds UTF-16 bound")
+	}
+	if version == 2 || version == 3 {
+		// The raw command line has its own post-escaping bound, independent
+		// of the copied-input budget. Reject before duplicate handles or FFI.
+		if _, _, err := rustOwnerWide(windows.ComposeCommandLine(wireArgs)); err != nil {
+			return nil, rustOwnerOutcome{}, errors.New("Rust owner encoded command line exceeds UTF-16 bound")
+		}
+	}
+	request := rustOwnerCreate{Version: version, Program: programView, Cwd: cwdView, Argc: uintptr(len(argViews))}
+	if len(argViews) != 0 {
+		request.Args = &argViews[0]
+	}
+	// Only this constructor owns and has validated the nested request buffers.
+	// Even an empty argument has the UTF-16 terminator allocated by rustOwnerWide.
+	var inputPins runtime.Pinner
+	defer inputPins.Unpin()
+	inputPins.Pin(&programUnits[0])
+	inputPins.Pin(&cwdUnits[0])
+	if len(argViews) != 0 {
+		inputPins.Pin(&argViews[0])
+	}
+	for _, units := range argUnits {
+		inputPins.Pin(&units[0])
+	}
+	var ioContext *rustOwnerIOContext
+	var environmentViews []rustOwnerEnvironmentEntryWire
+	var environmentUnits [][]uint16
+	if launchIO != nil {
+		environmentViews, environmentUnits, err = prepareRustOwnerEnvironment(launchIO.environment)
+		if err != nil {
+			return nil, rustOwnerOutcome{}, err
+		}
+		if len(environmentViews) != 0 {
+			inputPins.Pin(&environmentViews[0])
+		}
+		for _, units := range environmentUnits {
+			inputPins.Pin(&units[0])
+		}
+		copies, err := duplicateRustOwnerStdio(ctx, launchIO.streams)
+		if err != nil {
+			return nil, rustOwnerOutcome{}, err
+		}
+		defer func() { createErr = errors.Join(createErr, copies.close()) }()
+		ioContext = &rustOwnerIOContext{
+			Environment: rustOwnerEnvironment{Count: uintptr(len(environmentViews))},
+			Streams:     copies.nativeHandles(),
+		}
+		if len(environmentViews) != 0 {
+			ioContext.Environment.Entries = &environmentViews[0]
+		}
+	}
+	var raw uintptr
+	var output rustOwnerOutcome
+	status, callErr := library.callRustOwnerCreateContext(ctx, &request, ioContext, &raw, &output)
+	runtime.KeepAlive(programUnits)
+	runtime.KeepAlive(cwdUnits)
+	runtime.KeepAlive(argUnits)
+	runtime.KeepAlive(argViews)
+	runtime.KeepAlive(environmentViews)
+	runtime.KeepAlive(environmentUnits)
+	if target != nil && callErr == nil {
+		target.createEntered.Store(true)
+	}
+	if raw != 0 {
+		if target == nil {
+			target = &rustNativeOwner{library: library}
+		}
+		if target.memberGate == nil {
+			target.memberGate = newOriginalMemberCustody()
+			installRustOwnerMemberSource(target)
+		}
+		target.raw = raw
+		target.createEntered.Store(true)
+		target.created.Store(true)
+		owner = target
+	}
+	if callErr != nil {
+		return owner, output, callErr
+	}
+	observed, decodeErr := decodeRustOwnerOutcome(status, output)
+	if target != nil && raw == 0 && status != 0 && !errors.Is(decodeErr, errRustOwnerOutcome) &&
+		observed.State == 0 && observed.PID == 0 && observed.Flags == 0 {
+		target.createNoChild.Store(true)
+	}
+	if owner != nil && observed.PID != 0 {
+		owner.originalPID = observed.PID
+	}
+	if status == 0 && (raw == 0 || observed.PID == 0) {
+		decodeErr = errors.Join(decodeErr, errors.New("Rust owner creation succeeded without both ownership and original process identity"))
+	}
+	return owner, observed, decodeErr
+}
+
+func (owner *rustNativeOwner) call(name string, argument uint32) (rustOwnerOutcome, error) {
+	value, _, err := owner.callContext(nil, name, argument, nil)
+	return value, err
+}
+
+// callContext serializes the same original allocation. A permit, when
+// supplied, is consumed only at actual terminal native entry.
+func (owner *rustNativeOwner) callContext(ctx context.Context, name string, argument uint32, permit *originalMemberTerminalPermit) (rustOwnerOutcome, bool, error) {
+	if owner == nil {
+		return rustOwnerOutcome{}, false, errors.New("missing Rust native owner")
+	}
+	if err := lockRustOwnerCreateContext(ctx, &owner.mu); err != nil {
+		return rustOwnerOutcome{}, false, err
+	}
+	defer owner.mu.Unlock()
+	library := owner.library
+	if library == nil {
+		return rustOwnerOutcome{}, false, errors.New("missing Rust owner library")
+	}
+	if err := lockRustOwnerCreateContext(ctx, &library.mu); err != nil {
+		return rustOwnerOutcome{}, false, err
+	}
+	defer library.mu.Unlock()
+	if owner.raw == 0 || !library.ready || library.closeAttempted {
+		return rustOwnerOutcome{}, false, errors.New("Rust native owner is not live")
+	}
+	address := library.procedures[name]
+	if address == 0 {
+		return rustOwnerOutcome{}, false, fmt.Errorf("Rust owner export %s unavailable", name)
+	}
+	if permit != nil {
+		if err := permit.validate(owner.memberGate); err != nil {
+			return rustOwnerOutcome{}, false, err
+		}
+		if err := permit.markNativeEntry(ctx); err != nil {
+			return rustOwnerOutcome{}, false, err
+		}
+	} else if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return rustOwnerOutcome{}, false, err
+		}
+	}
+	var output rustOwnerOutcome
+	var pinned runtime.Pinner
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(address, owner.raw, uintptr(argument),
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	value, err := decodeRustOwnerOutcome(uint32(status), output)
+	if ctx != nil && permit == nil {
+		err = errors.Join(err, ctx.Err())
+	}
+	// A terminal caller records the actual native action before adding its
+	// observer cancellation; late cancellation cannot turn success into failure.
+	return value, true, err
+}
+
+func (owner *rustNativeOwner) Admit(allow bool) (rustOwnerOutcome, error) {
+	if owner == nil {
+		return rustOwnerOutcome{}, errors.New("missing Rust native owner")
+	}
+	// Admission is also an original-owner operation: a terminal seal must
+	// prevent a delayed ResumeThread after Stop has been requested.
+	if owner.memberGate != nil {
+		exit, err := owner.memberGate.enterQuery(nil)
+		if err != nil {
+			return rustOwnerOutcome{}, err
+		}
+		defer exit()
+	}
+	if allow {
+		return owner.call("mh_admit1", 1)
+	}
+	return owner.call("mh_admit1", 0)
+}
+
+func (owner *rustNativeOwner) Stop(code uint32) (rustOwnerOutcome, error) {
+	if owner == nil {
+		return rustOwnerOutcome{}, errors.New("missing Rust native owner")
+	}
+	permit, err := owner.memberGate.beginTerminal(nil)
+	if err != nil {
+		return rustOwnerOutcome{}, err
+	}
+	defer permit.finish()
+	value, _, err := owner.stopWithPermit(nil, code, permit)
+	return value, err
+}
+
+// stopWithPermit receives, rather than reacquires, the caller's original
+// terminal authority. The bool distinguishes a native request from refusal.
+func (owner *rustNativeOwner) stopWithPermit(ctx context.Context, code uint32, permit *originalMemberTerminalPermit) (rustOwnerOutcome, bool, error) {
+	if owner == nil {
+		return rustOwnerOutcome{}, false, errors.New("missing Rust native owner")
+	}
+	if owner.memberGate != nil {
+		if err := permit.validate(owner.memberGate); err != nil {
+			return rustOwnerOutcome{}, false, err
+		}
+	}
+	if err := lockRustOwnerCreateContext(ctx, &owner.mu); err != nil {
+		return rustOwnerOutcome{}, false, err
+	}
+	if owner.preparing.Load() && owner.raw == 0 {
+		owner.sealed = true
+		owner.mu.Unlock()
+		return rustOwnerOutcome{}, false, errors.New("original Rust creator stopped before native creation")
+	}
+	owner.mu.Unlock()
+	return owner.callContext(ctx, "mh_stop1", code, permit)
+}
+
+// rustOwnerCleanupFailure retains the three native close results from ABI1.
+// A cleared native owner pointer is not evidence that its handles closed.
+type rustOwnerCleanupFailure struct {
+	Mask  uint32
+	Codes [3]int32
+}
+
+func (e *rustOwnerCleanupFailure) Error() string {
+	return fmt.Sprintf("Rust owner native cleanup failed: mask=%#x codes=%v", e.Mask, e.Codes)
+}
+
+// Release is explicit and permitted only after native terminal settlement.
+// Clearing the slot is a custody fact even if the outcome decoder later fails.
+func (owner *rustNativeOwner) Release() error {
+	if owner == nil {
+		return nil
+	}
+	owner.mu.Lock()
+	if owner.raw == 0 {
+		if owner.preparing.Load() {
+			owner.sealed = true
+			owner.mu.Unlock()
+			return errors.New("original Rust creator released before native creation")
+		}
+		err := owner.releaseErr
+		owner.mu.Unlock()
+		return err
+	}
+	gate := owner.memberGate
+	owner.mu.Unlock()
+	if gate != nil {
+		gate.mu.Lock()
+		terminalStarted := gate.sealed
+		gate.mu.Unlock()
+		if !terminalStarted {
+			return errors.New("original Rust terminal settlement required before release")
+		}
+	}
+	permit, err := gate.beginTerminal(nil)
+	if err != nil {
+		return err
+	}
+	defer permit.finish()
+	return owner.releaseWithPermit(nil, permit)
+}
+
+func (owner *rustNativeOwner) releaseWithPermit(ctx context.Context, permit *originalMemberTerminalPermit) error {
+	if owner == nil {
+		return nil
+	}
+	if owner.memberGate != nil {
+		if err := permit.validate(owner.memberGate); err != nil {
+			return err
+		}
+	}
+	if err := lockRustOwnerCreateContext(ctx, &owner.mu); err != nil {
+		return err
+	}
+	defer owner.mu.Unlock()
+	if owner.raw == 0 {
+		if owner.preparing.Load() {
+			owner.sealed = true
+			return errors.New("original Rust creator released before native creation")
+		}
+		return owner.releaseErr
+	}
+	library := owner.library
+	if library == nil {
+		return errors.New("Rust owner library is unavailable")
+	}
+	if err := lockRustOwnerCreateContext(ctx, &library.mu); err != nil {
+		return err
+	}
+	defer library.mu.Unlock()
+	if !library.ready || library.closeAttempted {
+		return errors.New("Rust owner library became unavailable")
+	}
+	address := library.procedures["mh_release1"]
+	if address == 0 {
+		return errors.New("Rust owner release export is unavailable")
+	}
+	if err := permit.markNativeEntry(ctx); err != nil {
+		return err
+	}
+	var output rustOwnerOutcome
+	var pinned runtime.Pinner
+	pinned.Pin(&owner.raw)
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	status, _, _ := syscall.SyscallN(address, uintptr(unsafe.Pointer(&owner.raw)),
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	if owner.raw == 0 {
+		library.activeOwners.Add(-1)
+	}
+	_, err := decodeRustOwnerOutcome(uint32(status), output)
+	if err == nil && status == 0 && owner.raw == 0 && output.State != 2 && output.State != 3 {
+		err = fmt.Errorf("%w: release cleared owner without terminal settlement", errRustOwnerOutcome)
+	}
+	if err == nil && output.State == 3 {
+		err = &rustOwnerCleanupFailure{Mask: output.CleanupMask, Codes: output.CleanupCodes}
+	}
+	if owner.raw == 0 {
+		owner.releaseErr = err
+	}
+	if status == 0 && owner.raw != 0 {
+		err = errors.Join(err, errors.New("Rust owner release did not clear its slot"))
+	}
+	if ctx != nil {
+		err = errors.Join(err, ctx.Err())
+	}
+	return err
+}
diff --git a/internal/process/rust_owner_native_windows_test.go b/internal/process/rust_owner_native_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b9455e3ea54769162d47221df2c4f5e697dad879
--- /dev/null
+++ b/internal/process/rust_owner_native_windows_test.go
@@ -0,0 +1,517 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestRustOwnerOwnedChild(t *testing.T) {
+	// The parent suite must not write a marker. The native child alone is
+	// launched with this exact outputdir argument and an empty environment.
+	var directory string
+	for _, arg := range os.Args[1:] {
+		if strings.HasPrefix(arg, "-test.outputdir=") {
+			candidate := strings.TrimPrefix(arg, "-test.outputdir=")
+			if filepath.Base(candidate) == "rust-owner-owned-child" {
+				directory = candidate
+			}
+		}
+	}
+	if directory == "" {
+		return
+	}
+	if err := os.WriteFile(filepath.Join(directory, "started"), []byte("original-child"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRustOwnerRealCreateAdmitFinishRelease(t *testing.T) {
+	product, commit, hash := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT"),
+		os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_COMMIT"),
+		os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_SHA256")
+	if product == "" || commit == "" || hash == "" {
+		t.Skip("needs the exact qualified Product/DLL tuple; no installed binaries")
+	}
+	library, err := openBundledRustOwnerLibrary(product, commit, hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var owner *rustNativeOwner
+	// Testing cleanup is LIFO: settle the Job before removing its cwd.
+	cwd := t.TempDir()
+	t.Cleanup(func() {
+		if owner != nil && owner.raw != 0 {
+			_, _ = owner.Stop(37)
+			_, _ = owner.Finish(10000)
+			if err := owner.Release(); err != nil {
+				t.Errorf("retained owner cleanup: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("library cleanup: %v", err)
+		}
+	})
+	child, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	markerDir := filepath.Join(cwd, "rust-owner-owned-child")
+	if err := os.Mkdir(markerDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	owner, created, err := library.newRustOwner(child, cwd, []string{
+		"-test.run=^TestRustOwnerOwnedChild$",
+		"-test.outputdir=" + markerDir,
+	})
+	if err != nil || owner == nil || created.PID == 0 {
+		t.Fatalf("create owner=%v outcome=%+v err=%v", owner, created, err)
+	}
+	initialIdentity, err := owner.QueryIdentity()
+	if err != nil || initialIdentity.PID != created.PID || initialIdentity.CreationTime100ns == 0 ||
+		initialIdentity.JobMembership != 1 || initialIdentity.WaitState != 1 ||
+		len(initialIdentity.ImageUTF16) == 0 || len(initialIdentity.TokenUserSID) < 8 {
+		t.Fatalf("original suspended identity PID=%d SID bytes=%d err=%v", initialIdentity.PID, len(initialIdentity.TokenUserSID), err)
+	}
+	repeatedIdentity, err := owner.QueryIdentity()
+	if err != nil || repeatedIdentity.PID != initialIdentity.PID ||
+		repeatedIdentity.CreationTime100ns != initialIdentity.CreationTime100ns {
+		t.Fatalf("repeated read-only identity PID=%d err=%v", repeatedIdentity.PID, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	proof, err := owner.FormatOriginalUserSID(ctx)
+	if err != nil || proof == nil || proof.value == "" || proof.receipt == nil || !proof.receipt.Snapshot().Complete ||
+		proof.receipt.ValidateInput(proof.sid, proof.value) != nil {
+		t.Fatalf("original SID formatting complete=%t err=%v", proof != nil && proof.receipt != nil && proof.receipt.Snapshot().Complete, err)
+	}
+	proof.complete = false // simulate an observation returned with a late error
+	if incomplete, err := proof.creatorFacts(); err == nil || incomplete.Version != 0 {
+		t.Fatal("incomplete Rust SID observation was admitted as original creator facts")
+	}
+	proof.complete = true
+	facts, err := proof.creatorFacts()
+	if err != nil || facts.Version != 1 || facts.OriginalPID != int(created.PID) ||
+		facts.OwnerSID != proof.value || facts.ExecutablePath != windows.UTF16ToString(initialIdentity.ImageUTF16) ||
+		!facts.OriginalJobBound || !facts.CurrentJobMembershipKnown || !facts.CurrentJobMember ||
+		!facts.RootWaitKnown || !facts.RootAlive || facts.RootWaitResult != uint32(windows.WAIT_TIMEOUT) ||
+		facts.EvidenceSHA256 != "" {
+		t.Fatalf("unissued Rust creator facts incomplete: pid=%d originalJob=%t alive=%t err=%v",
+			facts.OriginalPID, facts.OriginalJobBound, facts.RootAlive, err)
+	}
+	birth, err := time.Parse(time.RFC3339Nano, facts.OriginalStartedAt)
+	if err != nil {
+		t.Fatalf("Rust creation time is not RFC3339Nano: %v", err)
+	}
+	filetime := windows.NsecToFiletime(birth.UnixNano())
+	if raw := uint64(filetime.HighDateTime)<<32 | uint64(filetime.LowDateTime); raw != initialIdentity.CreationTime100ns {
+		t.Fatalf("Rust FILETIME changed through canonical UTC formatting: got %d want %d", raw, initialIdentity.CreationTime100ns)
+	}
+	if v := (&CreatorIdentity{observation: facts, sidFormatting: proof.receipt}).Snapshot(); v.Version != 0 {
+		t.Fatal("unissued Rust identity facts became product CreatorIdentity authority")
+	}
+	proof.input[0] ^= 1
+	if proof.receipt.ValidateInput(proof.sid, proof.value) == nil {
+		t.Fatal("modified retained SID input was accepted by the receipt")
+	}
+	if facts, err := proof.creatorFacts(); err == nil || facts.Version != 0 {
+		t.Fatal("tampered original SID minted creator facts")
+	}
+	proof.input[0] ^= 1
+	copiedSID := append([]byte(nil), proof.input...)
+	if err := proof.receipt.ValidateInput((*windows.SID)(unsafe.Pointer(&copiedSID[0])), proof.value); err == nil {
+		t.Fatal("identical SID bytes owned by a different input were accepted")
+	}
+	cancelled, cancelQuery := context.WithCancel(ctx)
+	cancelQuery()
+	if denied, err := owner.FormatOriginalUserSID(cancelled); denied != nil || !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled original SID observation returned a value: err=%v", err)
+	}
+	marker := filepath.Join(markerDir, "started")
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("suspended child ran before admission: %v", err)
+	}
+	if err := library.Close(); err == nil {
+		t.Fatal("FreeLibrary allowed while a native owner is live")
+	}
+	if err := owner.Release(); err == nil || owner.raw == 0 {
+		t.Fatalf("premature Release lost pending owner: err=%v raw=%#x", err, owner.raw)
+	}
+	pending, err := owner.Finish(0)
+	if err != nil || pending.State != 1 || pending.PID != created.PID {
+		t.Fatalf("suspended owner was not Pending: outcome=%+v err=%v", pending, err)
+	}
+	if stillOriginal, err := owner.QueryIdentity(); err != nil || stillOriginal.PID != created.PID {
+		t.Fatalf("a Pending-only finish wrongly sealed read-only identity: PID=%d err=%v", stillOriginal.PID, err)
+	}
+	if missing, err := owner.FinishWithin(context.Background()); err == nil || missing.State != 0 || owner.raw == 0 {
+		t.Fatalf("unbounded wait was admitted: state=%d raw=%#x err=%v", missing.State, owner.raw, err)
+	}
+	deadlineCtx, cancelWait := context.WithTimeout(context.Background(), 35*time.Millisecond)
+	waitStart := time.Now()
+	expired, waitErr := owner.FinishWithin(deadlineCtx)
+	cancelWait()
+	if !errors.Is(waitErr, context.DeadlineExceeded) || expired.State != 1 || owner.raw == 0 ||
+		time.Since(waitStart) > time.Second {
+		t.Fatalf("finite wait lost owner or deadline: state=%d err=%v raw=%#x duration=%s",
+			expired.State, waitErr, owner.raw, time.Since(waitStart))
+	}
+	admitted, err := owner.Admit(true)
+	if err != nil {
+		t.Fatalf("admission outcome=%+v err=%v", admitted, err)
+	}
+	postAdmission, err := owner.QueryIdentity()
+	if err != nil || postAdmission.PID != created.PID ||
+		postAdmission.CreationTime100ns != initialIdentity.CreationTime100ns ||
+		(postAdmission.WaitState != 1 && postAdmission.WaitState != 2) {
+		t.Fatalf("post-admission identity PID=%d wait=%d err=%v", postAdmission.PID, postAdmission.WaitState, err)
+	}
+	finishCtx, cancelFinish := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancelFinish()
+	settled, err := owner.FinishWithin(finishCtx)
+	if err != nil || settled.State != 2 || settled.Flags&1 == 0 || settled.PID != created.PID {
+		t.Fatalf("finish outcome=%+v err=%v", settled, err)
+	}
+	if data, err := os.ReadFile(marker); err != nil || string(data) != "original-child" {
+		t.Fatalf("child marker=%q err=%v", data, err)
+	}
+	if after, err := owner.QueryIdentity(); err == nil || after.PID != 0 {
+		t.Fatalf("terminal native identity query was accepted: PID=%d err=%v", after.PID, err)
+	}
+	if enter, err := owner.memberGate.enterQuery(nil); err == nil {
+		enter()
+		t.Fatal("terminal natural finish reopened original member observation gate")
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+	if owner.raw != 0 {
+		t.Fatal("released owner retained native pointer")
+	}
+}

+	waitRustMemberMarker(t, ctx, f.marker)
+	waitRustMemberMarker(t, ctx, f.marker+".grandchild")
+	members, sameSource := acquireRustNativeMembers(t, ctx, f.owner)
+	view := members.Snapshot()
+	if sameSource != source || !view.Complete || view.PreTotal != 2 || view.PreActive != 2 ||
+		len(view.Rows) != 2 || members.native.(*rustOwnerMemberObservation).generation <= firstGeneration ||
+		view.OriginalCreationSHA256 != paused.OriginalCreationSHA256 {

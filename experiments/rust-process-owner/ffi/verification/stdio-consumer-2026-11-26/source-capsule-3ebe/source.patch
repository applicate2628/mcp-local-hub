+
+// Missing operation data deliberately prevents issuance of a selected context.
+// Only the actual retained namespace capabilities and absence readers are under
+// test; this fixture cannot assert successful installation or publication.
+func TestSerenaPriorNamespaceCleanupAfterWorkCancellation(t *testing.T) {
+	root := hardenedTempDir(t)
+	workEnd := time.Now().Add(time.Minute)
+	cleanupEnd := workEnd.Add(time.Minute)
+	work, cancelWork := context.WithDeadline(context.Background(), workEnd)
+	defer cancelWork()
+	cleanup, cancelCleanup := context.WithDeadline(context.Background(), cleanupEnd)
+	defer cancelCleanup()
+
+	request := preparedRequest()
+	request.Namespace = root
+	request.WorkLimit, request.CleanupLimit = time.Minute, time.Minute
+	request.WorkDeadline, request.AbsoluteCleanupDeadline = workEnd, cleanupEnd
+	key, err := request.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	source := strings.Repeat("a", 64)
+	intentPath := filepath.Join(root, "intent.json")
+	io, err := NewPreparedSerenaRecordIO(root, intentPath, request.OperationID, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	effects := &preparedSerenaRuntimeEffects{
+		PreparedSerenaRecordIO: io,
+		acquisition: preparedSerenaAcquisition{
+			inputs: SerenaPreparationInputs{Request: request},
+		},
+	}
+	var seedReady, seedOperation *SerenaRecordNamespaceObservation
+	t.Cleanup(func() {
+		for _, namespace := range []*SerenaRecordNamespaceObservation{
+			effects.priorOperationNamespace, effects.priorReadyNamespace,
+			seedOperation, seedReady,
+		} {
+			if namespace == nil {
+				continue
+			}
+			proof, closeErr := namespace.CloseObserved()
+			if err := errors.Join(closeErr, proof.ValidateSource(namespace)); err != nil {
+				t.Errorf("original namespace close: %v", err)
+			}
+		}
+	})
+
+	// The real creation factories establish the directories and their DACL.
+	// There is intentionally no ready record or previous operation leaf.
+	record := PreparedSerenaRuntimeRecord{OperationID: "prior", RequestIdentitySHA256: key}
+	seedIO, err := NewPreparedSerenaRecordIO(root, intentPath, record.OperationID, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedReady, err = seedIO.AcquireRecordNamespaceObserved(cleanup, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedIO, err = seedIO.BindRecordNamespace(cleanup, seedReady)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seedOperation, err = seedIO.AcquireOperationNamespaceObserved(cleanup, key, record.OperationID, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err := effects.receivePriorSelectedContext(work, record); err == nil {
+		t.Fatal("missing prior operation issued a selected context")
+	}
+	ready, operation := effects.priorReadyNamespace, effects.priorOperationNamespace
+	if ready == nil || operation == nil || len(effects.priorOperationReaders) != 1 {
+		t.Fatal("real prior namespace acquisition did not reach the original operation reader")
+	}
+	firstReader := effects.priorOperationReaders[0]
+	if firstReader == nil {
+		t.Fatal("original missing-leaf outcome was lost")
+	}
+	if err := firstReader.ValidateAbsence(work, operation.path, StateFileReadLeafNotFound); err != nil {
+		t.Fatalf("first call did not observe the missing operation: %v", err)
+	}
+	readySHA, err := ready.NamespaceSHA256(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	operationSHA, err := operation.LeafParentSHA256(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	cancelWork()
+	if !errors.Is(work.Err(), context.Canceled) || cleanup.Err() != nil {
+		t.Fatal("test did not separate canceled work from its original cleanup window")
+	}
+	if _, err := effects.receivePriorSelectedContext(cleanup, record); err == nil {
+		t.Fatal("cleanup issued a selected context from missing operation data")
+	}
+	if effects.priorReadyNamespace != ready || effects.priorOperationNamespace != operation {
+		t.Fatal("cleanup reacquired a prior namespace")
+	}
+	if len(effects.priorOperationReaders) != 2 || effects.priorOperationReaders[0] != firstReader {
+		t.Fatal("cleanup did not retain the first reader and reach a second original read")
+	}
+	secondReader := effects.priorOperationReaders[1]
+	if secondReader == nil || secondReader == firstReader {
+		t.Fatal("cleanup reused or lost the second read observation")
+	}
+	if err := secondReader.ValidateAbsence(cleanup, operation.path, StateFileReadLeafNotFound); err != nil {
+		t.Fatalf("cleanup failed before receiving the same missing operation: %v", err)
+	}
+	if actual, err := ready.NamespaceSHA256(cleanup); err != nil || actual != readySHA {
+		t.Fatalf("retained ready namespace changed across work cancellation: %q, %v", actual, err)
+	}
+	if actual, err := operation.LeafParentSHA256(cleanup); err != nil || actual != operationSHA {
+		t.Fatalf("retained operation namespace changed across work cancellation: %q, %v", actual, err)
+	}
+	if effects.priorContext != nil || effects.priorPublishedRead != nil {
+		t.Fatal("missing operation data acquired selected publication authority")
+	}
+}

+#[derive(Debug, PartialEq, Eq)]
+struct RowCopy {
+    pid: u32,
+    birth: u64,
+    image: Vec<u16>,
+    sid: Vec<u8>,
+}
+#[derive(Debug, PartialEq, Eq)]
+struct CensusCopy {
+    total: u32,
+    active: u32,
+    pids: Vec<u32>,
+}
+#[derive(Debug, PartialEq, Eq)]
+struct SnapshotCopy {
+    generation: u64,
+    flags: u32,
+    original: OriginalCreation,
+    pre: CensusCopy,
+    post: CensusCopy,
+    rows: Vec<RowCopy>,
+    resources: Vec<MemberResource>,
+}
+#[derive(Default)]
+struct SnapshotReceiverState {
+    calls: usize,
+    bytes: u32,
+    value: Option<SnapshotCopy>,
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct CloseCopy {
+    generation: u64,
+    flags: u32,
+    resources: Vec<MemberResource>,
+}
+#[derive(Default)]
+struct CloseReceiverState {
+    calls: usize,
+    bytes: u32,
+    value: Option<CloseCopy>,
+}
+
+unsafe fn copy_view<T: Copy>(data: *const T, len: usize) -> Vec<T> {
+    if len == 0 {
+        return Vec::new();
+    }
+    // SAFETY: used only by these callbacks with the producer's complete valid
+    // views. Zero-length NULL is handled without forming a Rust slice.
+    unsafe { slice::from_raw_parts(data, len).to_vec() }
+}
+unsafe extern "C" fn receive_snapshot(raw: *const MembersSnapshot, bytes: u32, token: usize) {
+    // SAFETY: producer supplies a complete immutable snapshot and views;
+    // this test passes an exclusive live callback state for this synchronous call.
+    unsafe {
+        let state = &mut *(token as *mut SnapshotReceiverState);
+        let value = &*raw;
+        state.calls += 1;
+        state.bytes = bytes;
+        let rows = if value.row_count == 0 {
+            Vec::new()
+        } else {
+            slice::from_raw_parts(value.rows, value.row_count)
+                .iter()
+                .map(|row| RowCopy {
+                    pid: row.pid,
+                    birth: row.creation_time_100ns,
+                    image: copy_view(row.image.data, row.image.len),
+                    sid: row.sid[..row.sid_len as usize].to_vec(),
+                })
+                .collect()
+        };
+        state.value = Some(SnapshotCopy {
+            generation: value.generation,
+            flags: value.flags,
+            original: value.original,
+            pre: CensusCopy {
+                total: value.pre.total_processes,
+                active: value.pre.active_processes,
+                pids: copy_view(value.pre.pids, value.pre.count),
+            },
+            post: CensusCopy {
+                total: value.post.total_processes,
+                active: value.post.active_processes,
+                pids: copy_view(value.post.pids, value.post.count),
+            },
+            rows,
+            resources: copy_view(value.resources, value.resource_count),
+        });
+    }
+}
+unsafe extern "C" fn receive_close(raw: *const MembersClose, bytes: u32, token: usize) {
+    // SAFETY: same complete immutable producer view and call-scoped test state.
+    unsafe {
+        let state = &mut *(token as *mut CloseReceiverState);
+        let value = &*raw;
+        state.calls += 1;
+        state.bytes = bytes;
+        state.value = Some(CloseCopy {
+            generation: value.generation,
+            flags: value.flags,
+            resources: copy_view(value.resources, value.resource_count),
+        });
+    }
+}
+fn suspended_owner() -> Box<Owner> {
+    let executable = std::env::current_exe().unwrap();
+    Box::new(Owner {
+        inner: NativeOwner::create_suspended(&executable, &["--list".into()]).unwrap(),
+        terminal: false,
+    })
+}
+fn settle(owner: &mut Owner, code: u32) {
+    if let Some(generation) = owner
+        .inner
+        .job_member_snapshot()
+        .map(|value| value.generation)
+    {
+        owner.inner.close_job_members(generation).unwrap();
+    }
+    owner.inner.terminate(code).unwrap();
+    assert_eq!(
+        owner.inner.finish(Duration::from_secs(3)).unwrap(),
+        Settlement::Complete { root_exit: code }
+    );
+}
+fn observe(owner: &mut Owner, budget: u32) -> (u32, u64, MembersReport, Outcome) {
+    let mut generation = 0;
+    let mut report = MembersReport::default();
+    let mut out = Outcome::default();
+    // SAFETY: real live owner, separate full outputs, initially zero scalar.
+    let status = unsafe {
+        mh_members_observe1(
+            owner,
+            VERSION,
+            budget,
+            &mut generation,
+            &mut report,
+            REPORT_BYTES,
+            &mut out,
+            OUT_BYTES,
+        )
+    };
+    (status, generation, report, out)
+}
+fn snapshot(
+    owner: &mut Owner,
+    generation: u64,
+) -> (u32, SnapshotReceiverState, MembersReport, Outcome) {
+    let mut receive = SnapshotReceiverState::default();
+    let mut report = MembersReport::default();
+    let mut out = Outcome::default();
+    // SAFETY: real owner and complete disjoint output/state; synchronous copying receiver.
+    let status = unsafe {
+        mh_members_snapshot1(
+            owner,
+            VERSION,
+            generation,
+            Some(receive_snapshot),
+            &mut receive as *mut SnapshotReceiverState as usize,
+            &mut report,
+            REPORT_BYTES,
+            &mut out,
+            OUT_BYTES,
+        )
+    };
+    (status, receive, report, out)
+}
+fn close(
+    owner: &mut Owner,
+    generation: u64,
+) -> (u32, u32, CloseReceiverState, MembersReport, Outcome) {
+    let mut finalized = 0;
+    let mut receive = CloseReceiverState::default();
+    let mut report = MembersReport::default();
+    let mut out = Outcome::default();
+    // SAFETY: live owner, initially zero scalar and complete disjoint copy-only outputs.
+    let status = unsafe {
+        mh_members_close1(
+            owner,
+            VERSION,
+            generation,
+            &mut finalized,
+            Some(receive_close),
+            &mut receive as *mut CloseReceiverState as usize,
+            &mut report,
+            REPORT_BYTES,
+            &mut out,
+            OUT_BYTES,
+        )
+    };
+    (status, finalized, receive, report, out)
+}

+}
+
+func TestRustOwnerRuntimeLibraryRequiresBothSplitExports(t *testing.T) {
+	expected := WindowsProcessOwnerExportsV1()
+	for _, missing := range [][]string{{"mh_wait1"}, {"mh_close1"}, {"mh_wait1", "mh_close1"}} {
+		t.Run(strings.Join(missing, "+"), func(t *testing.T) {
+			var actual []string
+			for _, name := range expected {
+				excluded := false
+				for _, absent := range missing {
+					excluded = excluded || name == absent
+				}
+				if !excluded {
+					actual = append(actual, name)
+				}
+			}
+			path := writeWindowsRuntimeLibraryFixture(t, 0x8664, 0x2002, actual, nil)
+			if identity, err := AdmitWindowsRuntimeLibrary(path, 0x8664, expected, runtimeLibrarySourceCommit); err == nil || identity.SHA256 != "" {
+				t.Fatalf("Product accepted DLL without complete split wait/close pair: missing=%v err=%v", missing, err)
+			}
+		})
+	}
+}

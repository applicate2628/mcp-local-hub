+func TestPrepareRustOwnerCommandCopiesPreparedInputs(t *testing.T) {
+	cmd := rustOwnerCommandFixture()
+	cmd.Args = append(cmd.Args, "--name", "space and \"quote\"", "", "trailing\\")
+	cmd.Env = []string{
+		"Path=old", "=D:=D:\\first", "Z=last", "=C:=C:\\space λ=🦀",
+		"PATH=new", "=d:=D:\\last", "A=λ=value=🦀", "SystemRoot=",
+	}
+	beforeArgs, beforeEnv := slices.Clone(cmd.Args), slices.Clone(cmd.Env)
+	program, cwd := cmd.Path, cmd.Dir
+
+	got, err := prepareRustOwnerCommand(cmd)
+	if err != nil {
+		t.Fatalf("prepared command rejected: %v", err)
+	}
+	if got.program != program || got.cwd != cwd || !slices.Equal(got.args, beforeArgs[1:]) {
+		t.Fatal("prepared program, cwd or arguments changed")
+	}
+	if !slices.Equal(cmd.Args, beforeArgs) || !slices.Equal(cmd.Env, beforeEnv) || cmd.Path != program || cmd.Dir != cwd {
+		t.Fatal("materialization mutated the caller's command")
+	}
+	wantEnvironment := []rustOwnerEnvironmentEntry{
+		{Name: "=C:", Value: "C:\\space λ=🦀"},
+		{Name: "=d:", Value: "D:\\last"},
+		{Name: "A", Value: "λ=value=🦀"},
+		{Name: "PATH", Value: "new"},
+		{Name: "SystemRoot", Value: ""},
+		{Name: "Z", Value: "last"},
+	}
+	if !slices.Equal(got.environment, wantEnvironment) {
+		t.Fatal("effective environment lost last-wins values or exact text")
+	}
+	cmd.Path, cmd.Dir = "changed", "changed"
+	cmd.Args[1], cmd.Env[0] = "changed", "changed"
+	if got.program != program || got.cwd != cwd || !slices.Equal(got.args, beforeArgs[1:]) || !slices.Equal(got.environment, wantEnvironment) {
+		t.Fatal("prepared inputs still alias mutable caller slices")
+	}
+}

+func TestRustOwnerMalformedCreateRetainsTransferredPointer(t *testing.T) {
+	create := syscall.NewCallback(func(request *rustOwnerCreate, size uintptr, slot *uintptr, output *rustOwnerOutcome, outputSize uintptr) uintptr {
+		if request == nil || size != 56 || slot == nil || output == nil || outputSize != 48 {
+			return 1
+		}
+		*slot = 0x1234                                   // a synthetic Rust-transferred owner
+		*output = rustOwnerOutcome{Size: 48, Version: 1} // malformed success: no PID
+		return 0
+	})
+	release := syscall.NewCallback(func(slot *uintptr, output *rustOwnerOutcome, outputSize uintptr) uintptr {
+		if slot == nil || *slot != 0x1234 || output == nil || outputSize != 48 {
+			return 1
+		}
+		*slot = 0
+		*output = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 1, PID: 42, RootExit: 7}
+		return 0
+	})
+	closeExited := syscall.NewCallback(func(raw uintptr, output *rustOwnerOutcome, outputSize uintptr) uintptr {
+		if raw != 0x1234 || output == nil || outputSize != 48 {
+			return 1
+		}
+		*output = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 1, PID: 42, RootExit: 7}
+		return 0
+	})
+	library := &rustOwnerLibrary{
+		ready:      true,
+		procedures: map[string]uintptr{"mh_create1": create, "mh_wait1": rustOwnerExitedCallback(0x1234, 42, 7), "mh_close1": closeExited, "mh_release1": release},
+	}
+	owner, result, err := library.newRustOwner("C:\\Windows\\System32\\not-a-real-child.exe", "C:\\Windows", nil)
+	if owner == nil || owner.raw != 0x1234 || err == nil || library.activeOwners.Load() != 1 {
+		t.Fatalf("transferred owner and malformed result not retained: owner=%v result=%+v err=%v active=%d",
+			owner, result, err, library.activeOwners.Load())
+	}
+	if err := library.Close(); err == nil {
+		t.Fatal("library unloaded after malformed result with live native owner")
+	}
+	if err := owner.Release(); err == nil || owner.raw == 0 || library.activeOwners.Load() != 1 {
+		t.Fatalf("malformed create bypassed terminal settlement: err=%v raw=%#x", err, owner.raw)
+	}
+	if finished, err := owner.Finish(0); err != nil || finished.State != 2 {
+		t.Fatalf("retained malformed owner could not reach terminal state: %+v err=%v", finished, err)
+	}
+	if err := owner.Release(); err != nil || owner.raw != 0 || library.activeOwners.Load() != 0 {
+		t.Fatalf("synthetic owner cleanup failed: err=%v raw=%#x active=%d", err, owner.raw, library.activeOwners.Load())
+	}
+	if err := library.Close(); err != nil {
+		t.Fatal(err)
+	}
+}

+						t.Errorf("write-only console mode observation changed: parent=%d child=%+v", code, final.Streams[i+1].Mode)
+					}
+				}
+			}
+		})
+		if retainedSources {
+			t.Fatal("unsettled fixture custody retained; remaining console controls refused")
+		}
+	}
+}

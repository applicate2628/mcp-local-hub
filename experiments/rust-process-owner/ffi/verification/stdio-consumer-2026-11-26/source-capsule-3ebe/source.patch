+func TestRustOwnerABI1CreateCallbackKeepsBuffersStable(t *testing.T) {
+	for _, retained := range []bool{false, true} {
+		name := "direct"
+		if retained {
+			name = "retained"
+		}
+		t.Run(name, func(t *testing.T) {
+			const program = `D:\dev\ChatGPT\callback-child.exe`
+			const cwd = `D:\dev\ChatGPT\callback-cwd`
+			args := []string{"first", "two words", "π🚀", ""}
+			wantText := append([]string{program, cwd}, args...)
+			wantUnits := make([][]uint16, len(wantText))
+			for i, value := range wantText {
+				units, err := syscall.UTF16FromString(value)
+				if err != nil {
+					t.Fatal(err)
+				}
+				wantUnits[i] = units[:len(units)-1]
+			}
+			const raw = uintptr(0x4264)
+			want := rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 42}
+			calls := 0
+			var addresses [3]uintptr
+			var callbackFailure string
+			validatedRequest, wroteKnownOutput := false, false
+			create := syscall.NewCallback(func(request *rustOwnerCreate, requestBytes uintptr, slot *uintptr, output *rustOwnerOutcome, outputBytes uintptr) uintptr {
+				calls++
+				// Keep only integer observations: capturing a typed pointer to
+				// the caller's buffers would change their escape behavior.
+				addresses = [3]uintptr{uintptr(unsafe.Pointer(request)), uintptr(unsafe.Pointer(slot)), uintptr(unsafe.Pointer(output))}
+				growRustOwnerCallbackStack(64)
+				if request == nil || requestBytes != 56 || slot == nil ||
+					output == nil || outputBytes != 48 {
+					callbackFailure = "invalid create buffer bounds"
+					return 1
+				}
+				if request.Version != 1 || request.Reserved != 0 ||
+					request.Argc != uintptr(len(args)) || request.Argc > 64 || request.Args == nil {
+					callbackFailure = "create request changed across callback"
+					return 1
+				}
+				matches := func(view rustOwnerUTF16, expected []uint16) bool {
+					if view.Data == nil || view.Len > 32766 || view.Len != uintptr(len(expected)) {
+						return false
+					}
+					actual := unsafe.Slice(view.Data, int(view.Len))
+					for i, unit := range actual {
+						if unit != expected[i] {
+							return false
+						}
+					}
+					return true
+				}
+				if !matches(request.Program, wantUnits[0]) || !matches(request.Cwd, wantUnits[1]) {
+					callbackFailure = "program or cwd changed across callback"
+					return 1
+				}
+				argumentViews := unsafe.Slice(request.Args, int(request.Argc))
+				for i, argument := range argumentViews {
+					if !matches(argument, wantUnits[i+2]) {
+						callbackFailure = "argument changed across callback"
+						return 1
+					}
+				}
+				validatedRequest = true
+				if *slot != 0 {
+					callbackFailure = "ownership slot was not initially empty"
+					return 1
+				}
+				*slot = raw
+				*output = want
+				wroteKnownOutput = *slot == raw &&
+					*output == want
+				return 0
+			})
+			// The integer owner and PID are synthetic ABI data. This fixture
+			// never opens a DLL, creates a process or owns Windows resources.
+			library := &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{"mh_create1": create}}
+			type createResult struct {
+				owner, retainedOwner *rustNativeOwner
+				outcome              rustOwnerOutcome
+				err                  error
+				retainCalls          int
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			done := make(chan createResult, 1)
+			// A fresh goroutine keeps the regression independent of the test
+			// runner's previously grown stack.
+			go func() {
+				var result createResult
+				if retained {
+					result.owner, result.outcome, result.err = library.startRetainedRustOwner(ctx, program, cwd, args,
+						func(owner *rustNativeOwner) error {
+							result.retainCalls++
+							result.retainedOwner = owner
+							if owner == nil || owner.raw != 0 || !owner.preparing.Load() || library.activeOwners.Load() != 1 {
+								return errors.New("retention did not precede native create")
+							}
+							return nil
+						})
+				} else {
+					result.owner, result.outcome, result.err = library.newRustOwner(program, cwd, args)
+				}
+				done <- result
+			}()
+			var result createResult
+			select {
+			case result = <-done:
+			case <-ctx.Done():
+				t.Fatalf("create callback did not return within the test bound: %v", ctx.Err())
+			}
+			if calls != 1 || addresses[0] == 0 || addresses[1] == 0 || addresses[2] == 0 ||
+				callbackFailure != "" || !validatedRequest || !wroteKnownOutput {
+				t.Fatalf("create callback did not validate and write the known buffers: calls=%d addresses=%#x validated=%t wrote=%t failure=%q",
+					calls, addresses, validatedRequest, wroteKnownOutput, callbackFailure)
+			}
+			if result.err != nil || result.outcome != want || result.owner == nil {
+				t.Fatalf("create callback lost its known output: outcome=%+v owner=%p err=%v", result.outcome, result.owner, result.err)
+			}
+			if result.owner.raw != raw || result.owner.originalPID != want.PID || result.owner.library != library ||
+				result.owner.memberGate == nil || library.activeOwners.Load() != 1 {
+				t.Fatalf("create callback lost ownership or original PID: raw=%#x pid=%d gate=%t active=%d",
+					result.owner.raw, result.owner.originalPID, result.owner.memberGate != nil, library.activeOwners.Load())
+			}
+			if retained && (result.retainCalls != 1 || result.owner != result.retainedOwner || result.owner.preparing.Load()) {
+				t.Fatalf("retained create changed owner custody: calls=%d owner=%p retained=%p preparing=%t",
+					result.retainCalls, result.owner, result.retainedOwner, result.owner.preparing.Load())
+			}
+		})
+	}
+}

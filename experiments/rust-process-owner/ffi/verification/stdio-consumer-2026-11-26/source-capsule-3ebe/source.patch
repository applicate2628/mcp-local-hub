+package buildinfo
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestRustOwnerBuildBindingClassifiesAbsentMark(t *testing.T) {
+	original := rustOwnerSHA256
+	t.Cleanup(func() { rustOwnerSHA256 = original })
+	for _, tc := range []struct {
+		name     string
+		hash     string
+		unmarked bool
+		valid    bool
+	}{
+		{name: "absent", unmarked: true},
+		{name: "short", hash: "abc"},
+		{name: "uppercase", hash: strings.Repeat("A", 64)},
+		{name: "non-hex", hash: strings.Repeat("g", 64)},
+		{name: "whitespace", hash: strings.Repeat("a", 64) + " "},
+		{name: "canonical", hash: strings.Repeat("a", 64), valid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			rustOwnerSHA256 = tc.hash
+			hash, err := CurrentRustOwnerSHA256()
+			if errors.Is(err, ErrRustOwnerBuildUnmarked) != tc.unmarked {
+				t.Fatalf("absent mark classification: hash=%q err=%v", tc.hash, err)
+			}
+			if tc.valid {
+				if err != nil || hash != tc.hash {
+					t.Fatalf("canonical mark: hash=%q err=%v", hash, err)
+				}
+			} else if err == nil || hash != "" {
+				t.Fatalf("invalid mark authorized a DLL: hash=%q err=%v", hash, err)
+			}
+		})
+	}
+}

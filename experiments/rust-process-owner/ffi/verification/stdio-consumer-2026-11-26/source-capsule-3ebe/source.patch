@@ -0,0 +1,314 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestRustOwnerCreatorIdentityRetainsOriginalIssuer(t *testing.T) {
+	library, program := rustOwnerRetentionFixture(t)
+	cwd := t.TempDir()
+	var retained *rustNativeOwner
+	t.Cleanup(func() {
+		if retained != nil && retained.raw != 0 {
+			_, _ = retained.Stop(23)
+			_, _ = retained.Finish(10000)
+			if err := retained.Release(); err != nil {
+				t.Errorf("retained creator cleanup: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("library cleanup: %v", err)
+		}
+	})
+	markerDir := filepath.Join(cwd, "rust-owner-owned-child")
+	if err := os.Mkdir(markerDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	owner, created, err := library.startRetainedRustOwner(ctx, program, cwd, []string{
+		"-test.run=^TestRustOwnerOwnedChild$", "-test.outputdir=" + markerDir,
+	}, func(original *rustNativeOwner) error {
+		retained = original
+		if original == nil || original.raw != 0 {
+			return errors.New("issuer was not retained before native creation")
+		}
+		return nil
+	})
+	if err != nil || owner == nil || owner != retained || created.PID == 0 {
+		t.Fatalf("original retained owner=%t PID=%d err=%v", owner == retained, created.PID, err)
+	}
+	// This assertion also makes the baseline failure about missing behavior,
+	// rather than a test that fails to compile before the issuer exists.
+	issuer, ok := any(owner).(interface {
+		ObserveCreatorIdentity(context.Context) (*CreatorIdentity, error)
+	})
+	if !ok {
+		t.Fatal("retained Rust owner cannot issue CreatorIdentity")
+	}
+	native, err := owner.QueryIdentity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity, err := issuer.ObserveCreatorIdentity(ctx)
+	if err != nil || identity == nil {
+		t.Fatalf("original identity issuance: %v", err)
+	}
+	if any(identity.owner) != any(retained) {
+		t.Fatal("identity substituted the original retained owner")
+	}
+	view := identity.Snapshot()
+	if view.Version != 1 || view.OriginalPID != int(created.PID) ||
+		view.ExecutablePath != windows.UTF16ToString(native.ImageUTF16) || view.OwnerSID == "" ||
+		!view.OriginalJobBound || !view.CurrentJobMembershipKnown || !view.CurrentJobMember ||
+		!view.RootWaitKnown || !view.RootAlive || view.RootWaitResult != uint32(windows.WAIT_TIMEOUT) {
+		t.Fatalf("incomplete original creator identity: %+v", view)
+	}
+	birth, err := time.Parse(time.RFC3339Nano, view.OriginalStartedAt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	filetime := windows.NsecToFiletime(birth.UnixNano())
+	if raw := uint64(filetime.HighDateTime)<<32 | uint64(filetime.LowDateTime); raw != native.CreationTime100ns {
+		t.Fatalf("original birth changed: got %d want %d", raw, native.CreationTime100ns)
+	}
+	raw, err := json.Marshal(view)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digest := sha256.Sum256(raw)
+	if view.EvidenceSHA256 != hex.EncodeToString(digest[:]) {
+		t.Fatal("creator evidence digest changed its existing JSON convention")
+	}
+	// The formatter's temporary diagnostic wrapper has left scope. The actual
+	// receipt must still retain the original typed SID input after collection.
+	runtime.GC()
+	sid, ok := identity.sidFormatting.inputOwner.(*windows.SID)
+	if !ok || identity.sidFormatting.ValidateInput(sid, view.OwnerSID) != nil {
+		t.Fatal("issued identity lost its original SID input")
+	}
+	sidBytes, err := identity.sidFormatting.inputRead()
+	if err != nil || !bytes.Equal(sidBytes, native.TokenUserSID) {
+		t.Fatalf("issued SID input differs from the original native owner: %v", err)
+	}
+	copySID, err := windows.StringToSid(view.OwnerSID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := identity.sidFormatting.ValidateInput(copySID, view.OwnerSID); err == nil {
+		t.Fatal("identical SID text from a different input acquired original authority")
+	}
+	marker := filepath.Join(markerDir, "started")
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("identity issuance resumed the suspended child: %v", err)
+	}
+	if admitted, err := owner.Admit(true); err != nil || admitted.State != 0 {
+		t.Fatalf("explicit admission: %+v %v", admitted, err)
+	}
+	if settled, err := owner.Finish(10000); err != nil || settled.State != 2 {
+		t.Fatalf("admitted child settlement: %+v %v", settled, err)
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(marker); err != nil {
+		t.Fatalf("explicitly admitted child did not run: %v", err)
+	}
+	if after := identity.Snapshot(); after != view {
+		t.Fatalf("historical identity changed after original owner release: %+v", after)
+	}
+}
+
+func TestRustOwnerCreatorIdentityAdmissionTerminalAndCancellation(t *testing.T) {
+	for _, action := range []string{"terminal-seal", "cancel"} {
+		t.Run(action, func(t *testing.T) {
+			library, program := rustOwnerRetentionFixture(t)
+			cwd := t.TempDir()
+			var owner *rustNativeOwner
+			t.Cleanup(func() {
+				if owner != nil && owner.raw != 0 {
+					_, _ = owner.Stop(29)
+					_, _ = owner.Finish(10000)
+					if err := owner.Release(); err != nil {
+						t.Errorf("owner cleanup: %v", err)
+					}
+				}
+				if err := library.Close(); err != nil {
+					t.Errorf("library cleanup: %v", err)
+				}
+			})
+			var err error
+			owner, _, err = library.newRustOwner(program, cwd, []string{"-test.run=^TestRustOwnerOwnedChild$"})
+			if err != nil || owner == nil {
+				t.Fatalf("original suspended owner: %v", err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			owner.mu.Lock()
+			locked := true
+			type result struct {
+				identity *CreatorIdentity
+				err      error
+			}
+			done := make(chan result, 1)
+			returned := make(chan struct{})
+			go func() {
+				defer close(returned)
+				identity, err := owner.ObserveCreatorIdentity(ctx)
+				done <- result{identity, err}
+			}()
+			// On every assertion failure, drain this query before t.Cleanup
+			// tries to stop the suspended child through the same custody gate.
+			defer func() {
+				cancel()
+				if locked {
+					owner.mu.Unlock()
+					locked = false
+				}
+				<-returned
+			}()
+			// Observe the real admission, not elapsed time. The owner lock
+			// keeps the admitted call before native query until we release it.
+			for {
+				owner.memberGate.mu.Lock()
+				entered := owner.memberGate.entered
+				owner.memberGate.mu.Unlock()
+				if entered == 1 {
+					break
+				}
+				select {
+				case <-ctx.Done():
+					t.Fatal("identity never entered original query custody")
+				case r := <-done:
+					t.Fatalf("identity returned before owner-lock barrier: %v", r.err)
+				default:
+					runtime.Gosched()
+				}
+			}
+			if action == "terminal-seal" {
+				if _, err := owner.Stop(29); !errors.Is(err, ErrOriginalMemberBorrowPending) {
+					t.Fatalf("native stop crossed admitted observation: %v", err)
+				}
+				if late, err := owner.ObserveCreatorIdentity(ctx); late != nil || err == nil {
+					t.Fatalf("terminal seal admitted a new identity: present=%t err=%v", late != nil, err)
+				}
+				owner.mu.Unlock()
+				locked = false
+			} else {
+				cancel()
+			}
+			var observed result
+			select {
+			case observed = <-done:
+			case <-time.After(10 * time.Second):
+				t.Fatal("admitted identity did not return")
+			}
+			if action == "cancel" {
+				if observed.identity != nil || !errors.Is(observed.err, context.Canceled) {
+					t.Fatalf("canceled identity acquired authority: %v", observed.err)
+				}
+				owner.mu.Unlock()
+				locked = false
+			} else if observed.err != nil || observed.identity == nil || !observed.identity.Snapshot().RootAlive {
+				t.Fatalf("already-admitted original observation failed after seal: %v", observed.err)
+			}
+			owner.memberGate.mu.Lock()
+			entered := owner.memberGate.entered
+			owner.memberGate.mu.Unlock()
+			if entered != 0 {
+				t.Fatalf("completed identity retained query admission: %d", entered)
+			}
+			if action == "cancel" {
+				retry, stopRetry := context.WithTimeout(context.Background(), 5*time.Second)
+				defer stopRetry()
+				if identity, err := owner.ObserveCreatorIdentity(retry); err != nil || identity == nil {
+					t.Fatalf("canceled observation damaged original owner: %v", err)
+				}
+			}
+			if _, err := owner.Stop(29); err != nil {
+				t.Fatalf("stop after query drain: %v", err)
+			}
+			if settled, err := owner.Finish(10000); err != nil || settled.State != 2 {
+				t.Fatalf("settlement after query drain: %+v %v", settled, err)
+			}
+			if err := owner.Release(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestRustOwnerCreatorIdentityRefusesMissingAuthority(t *testing.T) {
+	_, child, view := creatorIdentityGoFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var missingGo *ProvisionalProcess
+	var missingRust *rustNativeOwner
+	for _, test := range []struct {
+		name  string
+		owner creatorIdentityOwner
+	}{
+		{"nil-interface", nil},
+		{"typed-nil-go", missingGo},
+		{"typed-nil-rust", missingRust},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if identity, err := newCreatorIdentity(ctx, test.owner, view, child.formatting); identity != nil || err == nil {
+				t.Fatalf("missing owner issued identity: present=%t err=%v", identity != nil, err)
+			}
+			identity := &CreatorIdentity{owner: test.owner, observation: view, sidFormatting: child.formatting}
+			if snapshot := identity.Snapshot(); snapshot != (CreatorIdentitySnapshot{}) {
+				t.Fatalf("missing owner exposed authority: %+v", snapshot)
+			}
+		})
+	}
+	for _, name := range []string{"nil-owner", "missing-gate", "nil-context", "unbounded", "canceled", "expired", "sealed"} {
+		t.Run(name, func(t *testing.T) {
+			owner := &rustNativeOwner{memberGate: newOriginalMemberCustody()}
+			finite, done := context.WithTimeout(context.Background(), 5*time.Second)
+			defer done()
+			var supplied context.Context = finite
+			var expected error
+			switch name {
+			case "nil-owner":
+				owner = nil
+			case "missing-gate":
+				owner.memberGate = nil
+			case "nil-context":
+				supplied = nil
+			case "unbounded":
+				supplied = context.Background()
+			case "canceled":
+				done()
+				expected = context.Canceled
+			case "expired":
+				expired, stopExpired := context.WithDeadline(finite, time.Now().Add(-time.Second))
+				defer stopExpired()
+				supplied, expected = expired, context.DeadlineExceeded
+			case "sealed":
+				permit, err := owner.memberGate.beginTerminal(nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				permit.finish()
+			}
+			identity, err := owner.ObserveCreatorIdentity(supplied)
+			if identity != nil || err == nil || (expected != nil && !errors.Is(err, expected)) {
+				t.Fatalf("invalid admission issued authority: present=%t err=%v", identity != nil, err)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_environment_windows.go b/internal/process/rust_owner_environment_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..a9c3aeedbeaf6626e14002654d6f3e4a270ed043
--- /dev/null
+++ b/internal/process/rust_owner_environment_windows.go
@@ -0,0 +1,94 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"errors"
+	"fmt"
+	"runtime"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// rustOwnerEnvironmentEntry supplies one name/value in the complete child
+// environment. Names are ordinary nonempty names without '=' or drive-directory
+// names matching =[A-Za-z]:. Entries must already be strictly Windows-ordinal-
+// ignore-case sorted and unique. Nil is missing input; a non-nil empty slice
+// explicitly requests an empty environment. No parent variables are merged or
+// inherited.
+type rustOwnerEnvironmentEntry struct {
+	Name, Value string
+}
+
+var rustOwnerCompareStringOrdinal = windows.NewLazySystemDLL("kernel32.dll").NewProc("CompareStringOrdinal")
+
+// prepareRustOwnerEnvironment copies input without sorting or normalizing it.
+// The caller must not mutate entries during this call. Returned views borrow
+// backing[2*i] for the name and backing[2*i+1] for the value, each with its own
+// NUL terminator excluded from the view length. The create caller must pin
+// the view array and every backing buffer through its synchronous native call.
+func prepareRustOwnerEnvironment(entries []rustOwnerEnvironmentEntry) ([]rustOwnerEnvironmentEntryWire, [][]uint16, error) {
+	if entries == nil {
+		return nil, nil, errors.New("Rust owner requires an explicit environment")
+	}
+	if len(entries) > 256 {
+		return nil, nil, errors.New("Rust owner environment exceeds 256 entries")
+	}
+	views := make([]rustOwnerEnvironmentEntryWire, len(entries))
+	backing := make([][]uint16, 2*len(entries))
+	blockUnits := uintptr(1) // final NUL; each entry also has '=' and its own NUL
+	for i, entry := range entries {
+		driveName := len(entry.Name) == 3 && entry.Name[0] == '=' && entry.Name[2] == ':' &&
+			(('A' <= entry.Name[1] && entry.Name[1] <= 'Z') || ('a' <= entry.Name[1] && entry.Name[1] <= 'z'))
+		if entry.Name == "" || (strings.IndexByte(entry.Name, '=') >= 0 && !driveName) {
+			return nil, nil, fmt.Errorf("Rust owner environment entry %d needs an ordinary name or a drive-directory name", i)
+		}
+		nameUnits, name, err := rustOwnerWide(entry.Name)
+		if err != nil {
+			return nil, nil, fmt.Errorf("Rust owner environment entry %d name: %w", i, err)
+		}
+		valueUnits, value, err := rustOwnerWide(entry.Value)
+		if err != nil {
+			return nil, nil, fmt.Errorf("Rust owner environment entry %d value: %w", i, err)
+		}
+		blockUnits += name.Len + value.Len + 2
+		if blockUnits > 32766 {
+			return nil, nil, errors.New("Rust owner environment exceeds the UTF-16 block bound")
+		}
+		if i > 0 {
+			if err := checkRustOwnerEnvironmentNameOrder(views[i-1].Name, name); err != nil {
+				return nil, nil, fmt.Errorf("Rust owner environment entry %d: %w", i, err)
+			}
+		}
+		views[i] = rustOwnerEnvironmentEntryWire{Name: name, Value: value}
+		backing[2*i], backing[2*i+1] = nameUnits, valueUnits
+	}
+	return views, backing, nil
+}
+
+func checkRustOwnerEnvironmentNameOrder(left, right rustOwnerUTF16) error {
+	if err := rustOwnerCompareStringOrdinal.Find(); err != nil {
+		return fmt.Errorf("Rust owner environment ordinal comparison unavailable: %w", err)
+	}
+	// Both names are live, nonempty and bounded by rustOwnerWide. Keep their
+	// typed pointers until direct conversion in the Windows provider's Call.
+	// Exactly 1 requests the same OS uppercase table as native LaunchContext.
+	order, _, callErr := rustOwnerCompareStringOrdinal.Call(
+		uintptr(unsafe.Pointer(left.Data)), left.Len,
+		uintptr(unsafe.Pointer(right.Data)), right.Len, 1)
+	runtime.KeepAlive(left)
+	runtime.KeepAlive(right)
+	if order == 0 {
+		if callErr == nil || callErr == syscall.Errno(0) {
+			callErr = syscall.EINVAL
+		}
+		return fmt.Errorf("Rust owner environment ordinal comparison failed: %w", callErr)
+	}
+	if order != 1 { // CSTR_LESS_THAN; equality and reverse order both reject.
+		return errors.New("Rust owner environment names must be strictly ordinal sorted and unique")
+	}
+	return nil
+}
diff --git a/internal/process/rust_owner_environment_windows_test.go b/internal/process/rust_owner_environment_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1331ef609fe0c0fd76edb6dce88999dd465a08b7
--- /dev/null
+++ b/internal/process/rust_owner_environment_windows_test.go
@@ -0,0 +1,227 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"fmt"
+	"runtime"
+	"slices"
+	"strings"
+	"testing"
+	"unicode/utf16"
+)
+
+func TestRustOwnerEnvironmentRequiresExplicitEntries(t *testing.T) {
+	views, backing, err := prepareRustOwnerEnvironment(nil)
+	if err == nil || views != nil || backing != nil {
+		t.Fatal("missing environment was accepted or published buffers")
+	}
+	views, backing, err = prepareRustOwnerEnvironment([]rustOwnerEnvironmentEntry{})
+	if err != nil || len(views) != 0 || len(backing) != 0 {
+		t.Fatal("explicit empty environment was rejected or gained entries")
+	}
+}
+
+func TestRustOwnerEnvironmentCopiesExactUTF16Views(t *testing.T) {
+	entries := []rustOwnerEnvironmentEntry{
+		{Name: "=C:", Value: "C:\\space λ=value=🦀"},
+		{Name: "=d:", Value: ""},
+		{Name: "A", Value: ""},
+		{Name: "AA", Value: "λ=value=🦀"},
+		{Name: "MCPHUB_ТЕСТ", Value: "значение"},
+	}
+	want := slices.Clone(entries)
+	views, backing, err := prepareRustOwnerEnvironment(entries)
+	if err != nil {
+		t.Fatalf("valid explicit environment was rejected: %v", err)
+	}
+	if !slices.Equal(entries, want) {
+		t.Fatal("preparing an environment mutated the caller's entries")
+	}
+	if len(views) != len(want) || len(backing) != 2*len(want) {
+		t.Fatal("prepared environment has incorrect entry or backing counts")
+	}
+
+	for i := range entries {
+		entries[i] = rustOwnerEnvironmentEntry{Name: "CHANGED", Value: "after preparation"}
+	}
+	entries = nil
+	runtime.GC()
+	for i, entry := range want {
+		for field, text := range []string{entry.Name, entry.Value} {
+			units := backing[2*i+field]
+			expected := append(utf16.Encode([]rune(text)), 0)
+			if !slices.Equal(units, expected) {
+				t.Fatalf("entry %d field %d lost its exact copied UTF-16 units", i, field)
+			}
+			view := views[i].Name
+			if field == 1 {
+				view = views[i].Value
+			}
+			if view.Data != &units[0] || view.Len != uintptr(len(expected)-1) {
+				t.Fatalf("entry %d field %d does not reference its owned backing", i, field)
+			}
+		}
+	}
+	runtime.KeepAlive(backing)
+}
+
+func TestRustOwnerEnvironmentUsesWindowsOrdinalNameOrder(t *testing.T) {
+	// These orders come from Windows ordinal comparison of names, with its
+	// uppercase table and explicit UTF-16 lengths. The prefix/punctuation
+	// and non-ASCII cases distinguish the existing ASCII-byte env sorter.
+	cases := []struct {
+		name        string
+		left, right string
+		valid       bool
+	}{
+		{"ascii-ignore-case", "a", "B", true},
+		{"drive-before-ordinary", "=d:", "A", true},
+		{"drive-ignore-case-order", "=c:", "=D:", true},
+		{"duplicate-drive-case", "=D:", "=d:", false},
+		{"prefix-before-punctuation", "A", "A!", true},
+		{"reversed-prefix", "A!", "A", false},
+		{"unicode-uppercase-order", "é", "Ë", true},
+		{"reversed-unicode-uppercase-order", "Ë", "é", false},
+		{"distinct-composed-spelling", "A\u030a", "Å", true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			entries := []rustOwnerEnvironmentEntry{
+				{Name: tc.left, Value: "first"},
+				{Name: tc.right, Value: "second"},
+			}
+			before := slices.Clone(entries)
+			views, backing, err := prepareRustOwnerEnvironment(entries)
+			if (err == nil) != tc.valid {
+				t.Fatalf("Windows ordinal validation accepted=%t, want %t", err == nil, tc.valid)
+			}
+			if !slices.Equal(entries, before) {
+				t.Fatal("ordinal validation reordered or normalized the caller's entries")
+			}
+			if tc.valid {
+				if len(views) != 2 || len(backing) != 4 {
+					t.Fatal("valid ordinal input lost entries")
+				}
+			} else if views != nil || backing != nil {
+				t.Fatal("rejected ordinal input published partial buffers")
+			}
+		})
+	}
+}
+
+func TestRustOwnerEnvironmentRejectsInvalidEntriesWithoutDisclosure(t *testing.T) {
+	const privateName = "OWNED_PRIVATE_NAME"
+	const privateValue = "owned-private-value-must-not-appear"
+	cases := []struct {
+		name    string
+		entries []rustOwnerEnvironmentEntry
+	}{
+		{"empty-name", []rustOwnerEnvironmentEntry{{Name: "", Value: privateValue}}},
+		{"equals-name", []rustOwnerEnvironmentEntry{{Name: privateName + "=BAD", Value: privateValue}}},
+		{"drive-without-colon", []rustOwnerEnvironmentEntry{{Name: "=D", Value: privateValue}}},
+		{"drive-long-name", []rustOwnerEnvironmentEntry{{Name: "=DD:", Value: privateValue}}},
+		{"drive-numeric", []rustOwnerEnvironmentEntry{{Name: "=1:", Value: privateValue}}},
+		{"drive-non-ascii", []rustOwnerEnvironmentEntry{{Name: "=Ä:", Value: privateValue}}},
+		{"drive-extra-equals", []rustOwnerEnvironmentEntry{{Name: "==D:", Value: privateValue}}},
+		{"drive-suffix", []rustOwnerEnvironmentEntry{{Name: "=D:TAIL", Value: privateValue}}},
+		{"drive-value-nul", []rustOwnerEnvironmentEntry{{Name: "=D:", Value: privateValue + "\x00"}}},
+		{"name-nul", []rustOwnerEnvironmentEntry{{Name: privateName + "\x00TAIL", Value: privateValue}}},
+		{"value-nul", []rustOwnerEnvironmentEntry{{Name: "A", Value: privateValue + "\x00"}}},
+		{"name-invalid-utf8", []rustOwnerEnvironmentEntry{{Name: privateName + "\xff", Value: privateValue}}},
+		{"value-invalid-utf8", []rustOwnerEnvironmentEntry{{Name: "A", Value: privateValue + "\xfe\xff"}}},
+		{"duplicate-name", []rustOwnerEnvironmentEntry{{Name: "A", Value: privateValue}, {Name: "A", Value: "other"}}},
+		{"duplicate-ascii-case", []rustOwnerEnvironmentEntry{{Name: "A", Value: privateValue}, {Name: "a", Value: "other"}}},
+		{"duplicate-unicode-case", []rustOwnerEnvironmentEntry{{Name: "ТЕСТ", Value: privateValue}, {Name: "тест", Value: "other"}}},
+		{"reversed-order", []rustOwnerEnvironmentEntry{{Name: "Z", Value: privateValue}, {Name: "A", Value: "other"}}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			before := slices.Clone(tc.entries)
+			views, backing, err := prepareRustOwnerEnvironment(tc.entries)
+			if err == nil {
+				t.Fatal("invalid environment was accepted")
+			}
+			if views != nil || backing != nil {
+				t.Fatal("invalid environment published partial buffers")
+			}
+			if strings.Contains(err.Error(), privateName) || strings.Contains(err.Error(), privateValue) {
+				t.Fatal("validation error disclosed an environment name or value")
+			}
+			if !slices.Equal(tc.entries, before) {
+				t.Fatal("validation mutated the caller's invalid environment")
+			}
+		})
+	}
+}
+
+func TestRustOwnerEnvironmentEntryCountBound(t *testing.T) {
+	for _, count := range []int{256, 257} {
+		t.Run(fmt.Sprintf("entries-%d", count), func(t *testing.T) {
+			entries := make([]rustOwnerEnvironmentEntry, count)
+			for i := range entries {
+				entries[i] = rustOwnerEnvironmentEntry{Name: fmt.Sprintf("K%03d", i), Value: ""}
+			}
+			views, backing, err := prepareRustOwnerEnvironment(entries)
+			if count == 256 {
+				if err != nil || len(views) != count || len(backing) != 2*count {
+					t.Fatal("maximum allowed entry count was rejected or truncated")
+				}
+			} else if err == nil || views != nil || backing != nil {
+				t.Fatal("entry count over the ABI limit was accepted or published buffers")
+			}
+		})
+	}
+}
+
+func TestRustOwnerEnvironmentUTF16PayloadBounds(t *testing.T) {
+	// Each nonempty block includes every name, '=', value, entry NUL and
+	// one final block NUL. Non-BMP characters consume two UTF-16 units.
+	cases := []struct {
+		name    string
+		entries []rustOwnerEnvironmentEntry
+		valid   bool
+	}{
+		{"drive-value-exact", []rustOwnerEnvironmentEntry{{Name: "=D:", Value: strings.Repeat("v", 32760)}}, true},
+		{"drive-value-over", []rustOwnerEnvironmentEntry{{Name: "=D:", Value: strings.Repeat("v", 32761)}}, false},
+		{"one-value-exact", []rustOwnerEnvironmentEntry{{Name: "A", Value: strings.Repeat("v", 32762)}}, true},
+		{"one-value-over", []rustOwnerEnvironmentEntry{{Name: "A", Value: strings.Repeat("v", 32763)}}, false},
+		{"name-only-exact", []rustOwnerEnvironmentEntry{{Name: strings.Repeat("N", 32763), Value: ""}}, true},
+		{"name-only-over", []rustOwnerEnvironmentEntry{{Name: strings.Repeat("N", 32764), Value: ""}}, false},
+		{"surrogate-pairs-exact", []rustOwnerEnvironmentEntry{{Name: "A", Value: strings.Repeat("🦀", 16381)}}, true},
+		{"surrogate-pairs-over", []rustOwnerEnvironmentEntry{{Name: "A", Value: strings.Repeat("🦀", 16381) + "v"}}, false},
+		{"two-entries-exact", []rustOwnerEnvironmentEntry{
+			{Name: "A", Value: strings.Repeat("v", 16380)},
+			{Name: "B", Value: strings.Repeat("v", 16379)},
+		}, true},
+		{"two-entries-over", []rustOwnerEnvironmentEntry{
+			{Name: "A", Value: strings.Repeat("v", 16380)},
+			{Name: "B", Value: strings.Repeat("v", 16380)},
+		}, false},
+		{"individual-string-over", []rustOwnerEnvironmentEntry{{Name: "A", Value: strings.Repeat("v", 32767)}}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			views, backing, err := prepareRustOwnerEnvironment(tc.entries)
+			if (err == nil) != tc.valid {
+				t.Fatalf("UTF-16 budget validation accepted=%t, want %t", err == nil, tc.valid)
+			}
+			if !tc.valid {
+				if views != nil || backing != nil {
+					t.Fatal("over-budget environment published partial buffers")
+				}
+				return
+			}
+			if len(views) != len(tc.entries) || len(backing) != 2*len(tc.entries) {
+				t.Fatal("boundary input was truncated")
+			}
+			total := uintptr(1)
+			for _, view := range views {
+				total += view.Name.Len + view.Value.Len + 2
+			}
+			if total != 32766 {
+				t.Fatalf("exact-limit input has %d UTF-16 units, want 32766", total)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_facade_native_windows_test.go b/internal/process/rust_owner_facade_native_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..12f9f7c101330059a70980ec32e9f604de76c6bb
--- /dev/null
+++ b/internal/process/rust_owner_facade_native_windows_test.go
@@ -0,0 +1,453 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os/exec"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+// These tests enter the qualified native DLL through the actual process
+// facades. The fixture keeps the same original owner only for failure cleanup.
+func rustFacadeNativeCommand(f *rustIONativeFixture, mode string) *exec.Cmd {
+	return &exec.Cmd{Path: f.child, Args: []string{f.child, mode, f.marker}, Dir: f.cwd, Env: []string{}}
+}
+
+func rustFacadeNativeRetain(t *testing.T, f *rustIONativeFixture, child containedChild) error {
+	t.Helper()
+	c, ok := child.(*rustContainedChild)
+	if !ok || c.owner == nil || c.owner.raw != 0 {
+		return errors.New("facade retention did not precede original native creation")
+	}
+	f.owner = c.owner
+	if err := f.library.Close(); err == nil {
+		return errors.New("facade retention allowed module unload")
+	}
+	return nil
+}
+
+func TestRustOwnerFacadeNativeProvisionalIOIdentityAndLifetime(t *testing.T) {
+	f := newRustFacadeNativeFixture(t)
+	pipes := f.pipes(t)
+	cmd := rustFacadeNativeCommand(f, "stdio")
+	startCtx, cancelStart := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancelStart()
+	var retained *ProvisionalProcess
+	p, err := f.library.startRustProvisional(startCtx, cmd, pipes.streams, func(p *ProvisionalProcess) error {
+		retained = p
+		return rustFacadeNativeRetain(t, f, p.owner)
+	})
+	if err != nil || p == nil || p != retained {
+		t.Fatalf("retained facade start: p=%p retained=%p err=%v", p, retained, err)
+	}
+	cancelStart() // admission deadline/cancellation is not the child's lifetime.
+	f.closeChildEnds(t, pipes)
+	ctx := rustIONativeContext(t)
+	waitRustMemberMarker(t, ctx, f.marker)
+	if p.job != nil || cmd.Process != nil || cmd.ProcessState != nil {
+		t.Fatal("native facade fabricated Go process ownership")
+	}
+	identity, err := p.ObserveCreatorIdentity(ctx)
+	if err != nil || identity == nil || identity.owner != f.owner {
+		t.Fatalf("actual native identity issuer: %v", err)
+	}
+	facts := identity.Snapshot()
+	if facts.OriginalPID <= 0 || facts.OriginalStartedAt == "" || !facts.RootAlive {
+		t.Fatal("facade did not return original live identity")
+	}
+	source, err := p.OriginalMemberSource(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	members, err := p.ObserveOriginalMembers(ctx)
+	if err != nil || members == nil || !members.Snapshot().Complete {
+		t.Fatalf("facade original members: %v", err)
+	}
+	if err := members.MatchOwnerPID(ctx, uint32(facts.OriginalPID)); err != nil {
+		t.Fatal(err)
+	}
+	payload := []byte{'f', 0, 255, 128, '\n', 't', 'a', 'i', 'l'}
+	if n, err := pipes.input.Write(payload); err != nil || n != len(payload) {
+		t.Fatalf("facade input: n=%d err=%v", n, err)
+	}
+	f.closeFile(t, pipes.input)
+	root, err := rustFacadeNativeWaitRoot(t, f, ctx, p)
+	if err != nil || !root.Known || root.ExitCode != 0 || root.RawExitError != nil ||
+		root.OriginalPID != facts.OriginalPID || root.OriginalStartedAt != facts.OriginalStartedAt {
+		t.Fatalf("facade original root result: %+v err=%v", root, err)
+	}
+	if f.owner.raw == 0 || f.owner.closeStarted {
+		t.Fatal("root wait closed or released original resources")
+	}
+	terminal, err := p.CompleteCreatorAfterExit(ctx, true)
+	if err != nil || terminal == nil || terminal.Closure() == nil {
+		t.Fatalf("facade terminal completion: %v", err)
+	}
+	view, closure := terminal.Snapshot(), terminal.Closure().Snapshot()
+	if !view.OriginalJobExited || view.CurrentMembersExited || !view.HandlesClosed ||
+		!closure.OriginalJobExited || closure.CurrentMembersExited || !closure.DirectWaitComplete ||
+		view.Native.InitialAccountingKnown || view.Native.FinalAccountingKnown {
+		t.Fatalf("aggregate proof fabricated legacy census: terminal=%+v closure=%+v", view, closure)
+	}
+	if f.owner.raw != 0 {
+		t.Fatal("facade close did not release original allocation")
+	}
+	proof, err := members.CloseObserved()
+	if err != nil || !proof.Finalized() || proof.Validate(source) != nil {
+		t.Fatalf("terminal operation did not finalize original member batch: %v", err)
+	}
+	again, err := p.CompleteCreatorAfterExit(ctx, true)
+	if err != nil || again != terminal {
+		t.Fatal("facade replaced the terminal receipt")
+	}
+	rustIONativeOutput(t, ctx, f.read(pipes.stdout), payload)
+	rustIONativeOutput(t, ctx, f.read(pipes.stderr), []byte("native-stderr\x00\xff"))
+	if err := f.library.Close(); err != nil {
+		t.Fatalf("facade left module pinned after release: %v", err)
+	}
+}

+//go:build windows && amd64 && !race
+
+package process
+
+import (
+	"errors"
+	"syscall"
+	"testing"
+)
+
+// Go-to-Go syscall.NewCallback trampolines are synthetic ABI fixtures.
+// Under -race their stack-backed out buffers are not a reliable native
+// substitute. The real Rust DLL integration and ownership tests DO run
+// with -race; these existing negative-control fixtures run without -race.
+
+func TestRustOwnerReleaseReportsNativeCleanupFailure(t *testing.T) {
+	calls := 0
+	callback := syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		calls++
+		if slot == nil || *slot != 0x1234 || out == nil || size != 48 {
+			return 1
+		}
+		*out = rustOwnerOutcome{
+			Size: 48, Version: 1, State: 3, PID: 15, RootExit: 7,
+			Flags: 1, CleanupMask: 4, CleanupCodes: [3]int32{0, 0, 6},
+		}
+		*slot = 0
+		return 0
+	})
+	library := &rustOwnerLibrary{
+		ready:      true,
+		procedures: map[string]uintptr{"mh_release1": callback},
+	}
+	library.activeOwners.Store(1)
+	owner := &rustNativeOwner{library: library, raw: 0x1234}
+	err := owner.Release()
+	var cleanup *rustOwnerCleanupFailure
+	if !errors.As(err, &cleanup) || cleanup.Mask != 4 || cleanup.Codes[2] != 6 ||
+		owner.raw != 0 || library.activeOwners.Load() != 0 {
+		t.Fatalf("cleanup lost or double-owned: error=%v owner=%#x active=%d",
+			err, owner.raw, library.activeOwners.Load())
+	}
+	var again *rustOwnerCleanupFailure
+	if second := owner.Release(); !errors.As(second, &again) || again.Mask != 4 ||
+		again.Codes[2] != 6 || calls != 1 {
+		t.Fatalf("second Release lost the cached native cleanup error: err=%v calls=%d", second, calls)
+	}
+}

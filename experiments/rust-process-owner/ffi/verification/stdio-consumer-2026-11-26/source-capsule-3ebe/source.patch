+func retainCanonicalNativeCase(custody *canonicalNativeCaseCustody, cause error) *canonicalNativeRetainedCustody {
+	retained := &canonicalNativeRetainedCustody{Original: custody, Cause: cause}
+	if custody != nil {
+		retained.Cause = errors.Join(custody.Cause, cause)
+	}
+	for {
+		previous := retainedCanonicalNativeCase.Load()
+		retained.Previous = previous
+		if retainedCanonicalNativeCase.CompareAndSwap(previous, retained) {

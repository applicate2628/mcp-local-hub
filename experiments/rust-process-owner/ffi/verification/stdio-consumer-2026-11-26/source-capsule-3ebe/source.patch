+			domain := "creator-terminal-aggregate-v1"
+			if shutdown {
+				domain = "creator-shutdown-aggregate-v1"
+			}
+			digest := sha256.Sum256([]byte(fmt.Sprintf("%s|4242|2026-11-19T00:00:00Z|73|%s", domain, view.Action)))
+			if closure.EvidenceSHA256 != fmt.Sprintf("%x", digest[:]) {
+				t.Fatal("aggregate terminal evidence reused a legacy digest domain")
+			}
+			again, err := p.CompleteCreatorAfterExit(ctx, true)
+			if err != nil || again != result || child.waits.Load() != 1 || child.actions.Load() != 1 || child.closes.Load() != 1 {
+				t.Fatalf("terminal result repeated original work: %v", err)
+			}
+		})
+	}

+		t.Fatalf("whole-generation close: %v", err)
+	}
+	ownedClosed := 0
+	for _, resource := range closed.Snapshot().Resources {
+		if resource.BorrowedOriginal {
+			if resource.CloseAttempted || resource.Closed || resource.CloseError != nil {
+				t.Fatal("borrowed root was closed")

+	if err != nil {
+		t.Fatal(err)
+	}
+	observation, err := observeOriginalJobMembers(ctx, source.originalMemberSourceBinding())
+	if observation != nil {
+		t.Cleanup(func() {
+			if proof, err := observation.CloseObserved(); err != nil || !proof.Finalized() {
+				t.Errorf("member observation cleanup: final=%t err=%v", proof.Finalized(), err)
+			}
+		})
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return observation, source
+}
+func waitRustMemberMarker(t *testing.T, ctx context.Context, marker string) {
+	t.Helper()
+	for {
+		if _, err := os.Stat(marker); err == nil {
+			return
+		} else if !os.IsNotExist(err) {
+			t.Fatal(err)
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatalf("native member readiness: %v", ctx.Err())
+		case <-time.After(time.Millisecond):
+		}
+	}

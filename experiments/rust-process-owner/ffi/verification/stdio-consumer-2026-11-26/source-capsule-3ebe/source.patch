+			l := newRustOwnerTestLayout(t)
+			if tt.mutate != nil {
+				tt.mutate(t, l)
+			}
+			product := l.product
+			if tt.modifyProduct != nil {
+				product = tt.modifyProduct(l)
+			}
+			commit := rustOwnerTestCommit
+			if tt.commit != "" {
+				commit = tt.commit
+			}
+			hash := l.expected.SHA256
+			if tt.hash != "" {
+				hash = tt.hash
+			}
+			api := newFakeRustOwnerLibraryAPI(l)
+			calls := 0
+			library, err := openRustOwnerLibrary(product, commit, hash, rustOwnerLibraryDependencies{api: api, admit: matchingRustOwnerAdmission(l, &calls)})
+			if err == nil || !strings.Contains(err.Error(), tt.want) || library != nil || calls != 0 || api.loadCalls != 0 || api.freeCalls != 0 {
+				t.Fatalf("library=%v err=%v calls=%d load=%d free=%d", library, err, calls, api.loadCalls, api.freeCalls)

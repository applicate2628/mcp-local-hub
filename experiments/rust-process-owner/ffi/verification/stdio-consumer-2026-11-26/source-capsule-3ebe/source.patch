+		t.Fatal("provider mutation changed the published observation")
+	}
+	copy := proof.Snapshot()
+	copy.Resources[0].CloseError.Code = "MUTATED_CALLER_ERROR"
+	copy.CleanupErrors[0].Code = "MUTATED_CALLER_CLEANUP"
+	if proof.Snapshot().Resources[0].CloseError.Code != "ORIGINAL_CLOSE_FAILURE" ||
+		proof.Snapshot().CleanupErrors[0].Code != "ORIGINAL_CLOSE_FAILURE" {
+		t.Fatal("snapshot mutation changed the cached receipt")

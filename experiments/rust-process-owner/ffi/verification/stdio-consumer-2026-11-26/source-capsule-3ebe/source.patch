+func TestInstallParsedManifest_SerenaPreparationAuthorityIsRequired(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		held bool
+		want string
+	}{
+		{"missing preparation assembly", false, "SERENA_PREPARATION_ASSEMBLY_UNAVAILABLE"},
+		{"matching lock without invocation", true, "SERENA_PARSED_PREACQUIRED_INVOCATION_REQUIRED"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			stateDir := daemonIntentTestHelper(t)
+			preparePreflightBinaryChecks(t)
+			f := newInstallFakeScheduler()
+			installFakeScheduler(t, f)
+			audit := &recordingAuditWriter{}
+			installRecordingAudit(t, audit)
+			workspace := t.TempDir()
+			opts := InstallParsedManifestOpts{
+				ManifestHash: testExactManifestHash,
+				Writer:       io.Discard,
+				Workspaces: []WorkspaceEntry{{
+					WorkspaceKey: WorkspaceKey(workspace), WorkspacePath: workspace,
+					Language: SerenaLanguageSentinel, Backend: "serena", Port: 9401,
+				}},
+			}
+			if tc.held {
+				lock, err := AcquireSupervisorLockQuiet(filepath.Join(stateDir, "supervisor.lock"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(lock.Release)
+				opts.SupervisorLockBypass = lock.AllowSpecBearingWriteBypass()
+				if !opts.SupervisorLockBypass.holdsSupervisorLock(stateDir) {
+					t.Fatal("matching original supervisor exclusion is not held")
+				}
+			}
+			path, err := NewAPI().InstallParsedManifest(context.Background(), serenaTemplateManifest(), opts)
+			if path != "" || err == nil || err.Error() != tc.want {
+				t.Fatalf("original Serena admission: path=%q err=%v, want %s", path, err, tc.want)
+			}
+			for _, leaf := range []string{supervisorIntentFileLeaf, SupervisorEventLogFileLeaf} {
+				if _, statErr := os.Stat(filepath.Join(stateDir, leaf)); !errors.Is(statErr, os.ErrNotExist) {
+					t.Errorf("Serena admission refusal changed %s: %v", leaf, statErr)
+				}
+			}
+			if len(audit.entries) != 0 || f.createCount != 0 || f.runCount != 0 || len(f.deleteNames) != 0 {
+				t.Fatalf("Serena refusal reached effects: audit=%d create=%d run=%d deletes=%v", len(audit.entries), f.createCount, f.runCount, f.deleteNames)
+			}
+		})
+	}
+}

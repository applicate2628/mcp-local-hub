+func (c *privateSerenaMigrationCase) Context() context.Context {
+	if c == nil {
+		return context.Background()
+	}
+	if c.blocked != nil {
+		privateSerenaMigrationFailStop(c, "later-call-after-uncertain-operation", c.blocked)
+	}
+	return c.ctx
+}

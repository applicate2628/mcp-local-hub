+type rustMemberCancelAtNativeEntry struct {
+	context.Context
+	owner  *rustNativeOwner
+	cancel context.CancelFunc
+}
+
+func (ctx rustMemberCancelAtNativeEntry) Err() error {
+	// Only the final admission check holds both locks in this synchronous
+	// test. Cancel the real context there; no production timing hook is used.
+	if ctx.owner.mu.TryLock() {
+		ctx.owner.mu.Unlock()
+	} else if ctx.owner.library.mu.TryLock() {
+		ctx.owner.library.mu.Unlock()
+	} else {
+		ctx.cancel()
+	}
+	return ctx.Context.Err()
+}

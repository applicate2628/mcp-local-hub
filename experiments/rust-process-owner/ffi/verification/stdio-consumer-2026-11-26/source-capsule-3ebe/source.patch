new file mode 100644
index 0000000000000000000000000000000000000000..1f9e98d7ccc19deec497140d58a52d8dbe4be4ff
--- /dev/null
+++ b/internal/process/token_integrity_windows.go
@@ -0,0 +1,81 @@
+//go:build windows
+
+package process
+
+import (
+	"encoding/binary"
+	"fmt"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// TokenIntegrityRID synchronously borrows token and returns the final relative
+// identifier of its integrity SID. It neither opens nor closes handles and
+// conveys no process-control authority; the caller retains ownership of token.
+func TokenIntegrityRID(token windows.Token) (uint32, error) {
+	var needed uint32
+	err := windows.GetTokenInformation(token, windows.TokenIntegrityLevel, nil, 0, &needed)
+	if err != windows.ERROR_INSUFFICIENT_BUFFER || needed == 0 {
+		return 0, fmt.Errorf("size token integrity: %w", err)
+	}
+	buf := make([]byte, needed)
+	// Windows writes a SID address pointing back into this buffer. Keep that
+	// address stable until decoding finishes, including after the native call.
+	var pinner runtime.Pinner
+	pinner.Pin(&buf[0])
+	defer pinner.Unpin()
+	if err := windows.GetTokenInformation(token, windows.TokenIntegrityLevel, &buf[0], uint32(len(buf)), &needed); err != nil {
+		return 0, fmt.Errorf("query token integrity: %w", err)
+	}
+	return tokenIntegrityRIDFromBuffer(buf, needed)
+}
+
+// tokenIntegrityRIDFromBuffer decodes only the bytes reported by the native
+// call. The caller must keep buf pinned from creation of its embedded SID
+// address through this call. No pointer into the borrowed buffer escapes.
+func tokenIntegrityRIDFromBuffer(buf []byte, returned uint32) (uint32, error) {
+	var label windows.Tokenmandatorylabel
+	labelSize := int(unsafe.Sizeof(label))
+	if uint64(returned) > uint64(len(buf)) || uint64(returned) < uint64(labelSize) {
+		return 0, fmt.Errorf("invalid token integrity buffer length %d for %d bytes", returned, len(buf))
+	}
+	buf = buf[:int(returned)]
+	sidFieldOffset := int(unsafe.Offsetof(label.Label) + unsafe.Offsetof(label.Label.Sid))
+	pointerSize := int(unsafe.Sizeof(label.Label.Sid))
+	sidField := buf[sidFieldOffset : sidFieldOffset+pointerSize]
+	// Read the native address as integer data, never as an unvalidated Go
+	// pointer. SID accessors returning syscall addresses trip checkptr here.
+	var sidAddress uintptr
+	switch pointerSize {
+	case 4:
+		sidAddress = uintptr(binary.NativeEndian.Uint32(sidField))
+	case 8:
+		sidAddress = uintptr(binary.NativeEndian.Uint64(sidField))
+	default:
+		return 0, fmt.Errorf("unsupported token integrity pointer size %d", pointerSize)
+	}
+	base := uintptr(unsafe.Pointer(&buf[0]))
+	if sidAddress < base {
+		return 0, fmt.Errorf("token integrity SID precedes buffer")
+	}
+	sidOffset := sidAddress - base
+	const sidHeaderSize = 8 // revision, count and six identifier-authority bytes.
+	if sidOffset < uintptr(labelSize) || sidOffset > uintptr(len(buf)-sidHeaderSize) {
+		return 0, fmt.Errorf("token integrity SID header is outside buffer")
+	}
+	sid := buf[int(sidOffset):]
+	if sid[0] != 1 {
+		return 0, fmt.Errorf("unsupported token integrity SID revision %d", sid[0])
+	}
+	count := int(sid[1])
+	if count == 0 || count > 15 {
+		return 0, fmt.Errorf("invalid token integrity SID subauthority count %d", count)
+	}
+	if count > (len(sid)-sidHeaderSize)/4 {
+		return 0, fmt.Errorf("token integrity SID subauthorities exceed buffer")
+	}
+	last := sidHeaderSize + 4*(count-1)
+	return binary.NativeEndian.Uint32(sid[last : last+4]), nil
+}

@@ -0,0 +1,34 @@
+//go:build windows
+
+package process
+
+import (
+	"errors"
+	"runtime"
+
+	"mcp-local-hub/internal/buildinfo"
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+var errProductRustOwnerUnsupported = errors.New("Rust product owner requires windows/amd64")
+
+// ProductRustOwnerEnabled reads only compiled Product metadata, before command
+// materialization or Go Job acquisition. Only an absent Rust mark selects Go;
+// malformed or incomplete marked metadata must not become a fallback.
+func ProductRustOwnerEnabled() (bool, error) {
+	_, err := buildinfo.CurrentRustOwnerSHA256()
+	if errors.Is(err, buildinfo.ErrRustOwnerBuildUnmarked) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	_, commit, _ := buildinfo.Get()
+	if err := runtimeidentity.ValidateWindowsRuntimeSourceCommit(commit); err != nil {
+		return false, err
+	}
+	if runtime.GOARCH != "amd64" {
+		return false, errProductRustOwnerUnsupported
+	}
+	return true, nil
+}

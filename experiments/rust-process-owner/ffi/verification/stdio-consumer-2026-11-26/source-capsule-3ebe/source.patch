+}
+
+#[test]
+fn job_member_revalidation_queries_retained_descendant_and_uses_its_own_creation_time() {
+    let before = member_handle_baseline();
+    let mut owner = member_tree(false);
+    let generation = owner.observe_job_members(Instant::now() + WAIT).unwrap();
+    let baseline = owner.job_member_snapshot().unwrap().clone();
+    let index = baseline
+        .resources
+        .iter()
+        .position(|resource| !resource.borrowed_original)
+        .unwrap();
+    let row = &baseline.rows[index];
+    let raw = descendant_handle(&owner, index).as_raw_handle();
+    let mut flags = 0;
+    // SAFETY: observation retains the non-inheritable real descendant handle.
+    assert_ne!(unsafe { GetHandleInformation(raw, &mut flags) }, 0);
+    assert_eq!(flags & HANDLE_FLAG_INHERIT, 0);
+    // Independent direct Windows oracle; never use the production creation-time
+    // helper to prove that the descendant row belongs to its own process.
+    let mut created = FILETIME {
+        dwLowDateTime: 0,
+        dwHighDateTime: 0,
+    };
+    let mut exited = created;
+    let mut kernel = created;
+    let mut user = created;
+    // SAFETY: this live retained handle and four distinct FILETIME outputs are valid.
+    assert_ne!(
+        unsafe { GetProcessTimes(raw, &mut created, &mut exited, &mut kernel, &mut user) },
+        0
+    );
+    let actual_birth = (u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime);
+    assert_ne!(actual_birth, 0);
+    assert_eq!(row.creation_time_100ns, actual_birth);
+    // SAFETY: independent PID observation on the same live descendant handle.
+    assert_eq!(unsafe { GetProcessId(raw) }, row.pid);
+
+    let restricted = duplicate_with_access(descendant_handle(&owner, index), PROCESS_SYNCHRONIZE);
+    let restricted_raw = restricted.as_raw_handle();
+    let original = replace_descendant_handle(&mut owner, index, restricted);
+    let failure = owner
+        .revalidate_job_members(generation, Instant::now() + WAIT, Some(row.pid))
+        .unwrap_err();
+    denied(&observation_error(failure));
+    assert!(
+        owner.job_member_snapshot().unwrap() == &baseline,
+        "failed revalidation replaced the acquired baseline"
+    );
+    assert_eq!(
+        descendant_handle(&owner, index).as_raw_handle(),
+        restricted_raw,
+        "revalidation replaced the restricted held handle"
+    );
+    assert_eq!(
+        owner.terminate(91).unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+    drop(replace_descendant_handle(&mut owner, index, original));
+    owner
+        .revalidate_job_members(generation, Instant::now() + WAIT, Some(row.pid))
+        .unwrap();
+    assert!(owner.close_job_members(generation).unwrap().complete);
+    stop_and_finish(&mut owner);
+    drop(owner);
+    assert_eq!(
+        handle_count(),
+        before,
+        "descendant revalidation fixture leaked a native handle"
+    );
+}
+
+// This guard owns the entire real NativeOwner before setting protection. Every
+// assertion/unwind therefore removes the fixture's flag before its owner drops.
+// Only an exactly protected, detached handle may be reclaimed numerically;
+// no second OwnedHandle alias or production retry is ever introduced.
+struct ProtectedMemberOwner {
+    owner: NativeOwner,
+    raw: HANDLE,
+}
+impl ProtectedMemberOwner {
+    fn new(owner: NativeOwner, index: usize) -> Self {
+        let raw = descendant_handle(&owner, index).as_raw_handle();
+        let fixture = Self { owner, raw };
+        // SAFETY: the fixture owns the real observation and its selected handle.
+        assert_ne!(
+            unsafe {
+                SetHandleInformation(
+                    raw,
+                    HANDLE_FLAG_PROTECT_FROM_CLOSE,
+                    HANDLE_FLAG_PROTECT_FROM_CLOSE,
+                )
+            },
+            0
+        );
+        fixture
+    }
+}
+impl Drop for ProtectedMemberOwner {
+    fn drop(&mut self) {
+        let mut flags = 0;
+        // SAFETY: protection has remained set since the fixture installed it,
+        // so successful close/recycling was impossible.
+        if unsafe { GetHandleInformation(self.raw, &mut flags) } == 0
+            || flags & HANDLE_FLAG_PROTECT_FROM_CLOSE == 0
+        {
+            eprintln!("member fixture protection lost; refusing numeric-handle cleanup");
+            return;
+        }
+        let retained = self
+            .owner
+            .member_observation
+            .as_ref()
+            .is_some_and(|observation| {
+                observation.held.iter().any(|member| match member {
+                    HeldMember::Owned(handle) => handle.as_raw_handle() == self.raw,
+                    HeldMember::Original => false,
+                })
+            });
+        // SAFETY: still exactly this fixture's protected handle; clear its flag.
+        if unsafe { SetHandleInformation(self.raw, HANDLE_FLAG_PROTECT_FROM_CLOSE, 0) } == 0 {
+            eprintln!("member fixture could not remove close protection");
+            return;
+        }
+        if !retained {
+            // SAFETY: production consumed its sole owner on failed close;
+            // protection proves this is still the same fixture-owned handle.
+            if unsafe { CloseHandle(self.raw) } == 0 {
+                eprintln!("member fixture final close failed");
+            }
+        }
+    }
+}
+
+#[test]
+fn job_member_close_failure_is_cached_drains_guard_and_closes_other_owned_descendant() {
+    let before = member_handle_baseline();
+    let mut owner = member_tree(true);
+    let generation = owner.observe_job_members(Instant::now() + WAIT).unwrap();
+    let acquisition = owner.job_member_snapshot().unwrap().clone();
+    assert_eq!(acquisition.rows.len(), 3);
+    assert_eq!(
+        acquisition
+            .resources
+            .iter()
+            .filter(|resource| !resource.borrowed_original)
+            .count(),
+        2
+    );
+    let index = acquisition
+        .resources
+        .iter()
+        .position(|resource| !resource.borrowed_original)
+        .unwrap();
+    let protected_pid = acquisition.resources[index].pid;
+    let mut fixture = ProtectedMemberOwner::new(owner, index);
+    let with_observation = handle_count();
+
+    // Fixture-only native error oracle, not an owner retry or a fake syscall.
+    // SAFETY: the fixture owns this protected handle; the flag prevents
+    // successful closure/recycling throughout this deliberate rejected probe.
+    let rejected = unsafe { CloseHandle(fixture.raw) };
+    let expected_error = io::Error::last_os_error().raw_os_error().unwrap();
+    assert_eq!(rejected, 0);
+    let first = fixture.owner.close_job_members(generation).unwrap().clone();
+    assert!(!first.complete);
+    let protected = first
+        .resources
+        .iter()
+        .find(|resource| resource.pid == protected_pid)
+        .unwrap();
+    assert!(protected.close_attempted && !protected.closed);
+    assert_eq!(
+        protected.close_error,
+        Some(NativeFailure {
+            operation: "CloseJobMemberProcess",
+            code: expected_error,
+        })
+    );
+    let others: Vec<_> = first
+        .resources
+        .iter()
+        .filter(|resource| !resource.borrowed_original && resource.pid != protected_pid)
+        .collect();
+    assert_eq!(others.len(), 1);
+    assert!(others[0].close_attempted && others[0].closed && others[0].close_error.is_none());
+    let root = first
+        .resources
+        .iter()
+        .find(|resource| resource.borrowed_original)
+        .unwrap();
+    assert!(!root.close_attempted && !root.closed && root.close_error.is_none());
+    assert!(
+        fixture
+            .owner
+            .member_observation
+            .as_ref()
+            .unwrap()
+            .held
+            .is_empty(),
+        "a consumed failed handle remains available for an implicit retry"
+    );
+    assert_eq!(
+        handle_count(),
+        with_observation - 1,
+        "close did not release the second real owned descendant after the first failure"
+    );
+    assert_eq!(fixture.owner.close_job_members(generation).unwrap(), &first);
+    assert_eq!(
+        handle_count(),
+        with_observation - 1,
+        "cached close touched native resources"
+    );
+    let snapshot = fixture.owner.job_member_snapshot().unwrap();
+    assert!(
+        snapshot.pre == acquisition.pre
+            && snapshot.post == acquisition.post
+            && snapshot.rows == acquisition.rows
+            && snapshot.complete,
+        "close rewrote acquisition facts"
+    );
+    assert_eq!(snapshot.resources, first.resources);
+    let mut flags = 0;
+    // SAFETY: the fixture still guards its original protected descendant handle.
+    assert_ne!(unsafe { GetHandleInformation(fixture.raw, &mut flags) }, 0);
+    assert_ne!(flags & HANDLE_FLAG_PROTECT_FROM_CLOSE, 0);
+
+    // Failed cleanup finalizes the observation guard. It must not seal original
+    // termination/close forever, and a later replay must retain the first error.
+    fixture.owner.terminate(83).unwrap();
+    assert_eq!(
+        fixture.owner.finish(WAIT).unwrap(),
+        Settlement::Complete { root_exit: 83 }
+    );
+    assert_eq!(fixture.owner.close_job_members(generation).unwrap(), &first);
+    drop(fixture);
+    assert_eq!(
+        handle_count(),
+        before,
+        "protected member fixture leaked a native handle"
+    );
+}

+	t.Helper()
+	layout := newRustOwnerMemberTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	library, err, _ := openFakeRustOwner(t, layout, api)
+	if err != nil || library == nil {
+		t.Fatalf("fake admitted module: library=%p err=%v", library, err)
+	}
+	rejecting, probe := rustIOABIRejectingLibrary(nil)
+	library.procedures["mh_create_io1"] = rejecting.procedures["mh_create_io1"]
+	return library, api, probe
+}
+
+func rustProductReleaseNoChild(t *testing.T, p *AtCreateJobProcess, wantErr error) {
+	t.Helper()
+	view, err := p.ObserveOriginal(rustStdioTestContext(t), false)
+	if err != nil || !view.NoChildKnown || p.Created() {
+		t.Fatalf("positive no-child observation: view=%+v err=%v created=%t", view, err, p.Created())
+	}
+	for i := 0; i < 2; i++ {
+		settlement, err := p.ReleaseOriginal()
+		if !errors.Is(err, wantErr) || settlement == nil || settlement.Complete() != (wantErr == nil) {
+			t.Fatalf("no-child release %d: settlement=%v err=%v want=%v", i, settlement, err, wantErr)
+		}
+	}
+}
+
+func TestProductRustOwnerFactoryRequiresFiniteAdmissionAndRetain(t *testing.T) {
+	cancelOnly, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	for _, tc := range []struct {
+		name string
+		ctx  context.Context
+	}{
+		{name: "nil"},
+		{name: "background", ctx: context.Background()},
+		{name: "cancel-only", ctx: cancelOnly},
+		{name: "missing-retain", ctx: rustStdioTestContext(t)},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			opens, retains := 0, 0
+			retain := func(*AtCreateJobProcess) error { retains++; return nil }
+			if tc.name == "missing-retain" {
+				retain = nil
+			}
+			p, err := startProductRustOriginal(tc.ctx, rustOwnerCommandFixture(), nil, nil, nil, retain,
+				func() (*rustOwnerLibrary, error) { opens++; return nil, errors.New("unexpected open") })
+			if err == nil || p != nil || opens != 0 || retains != 0 {
+				t.Fatalf("invalid admission reached acquisition: p=%p err=%v opens=%d retains=%d", p, err, opens, retains)
+			}
+		})
+	}
+}
+
+func TestProductRustOwnerFactoryRequiresFullMemberProfile(t *testing.T) {
+	for _, tc := range []struct {

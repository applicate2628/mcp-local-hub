+
+// Register member cleanup after own: testing runs cleanups in reverse order.
+// Record every nonzero generation before checking its observation error.
+func memberFixture(t *testing.T, mode string, extra ...string) (*Library, *Owner, Outcome, string, func(uint64)) {
+	t.Helper()
+	lib, child, dir := setup(t)
+	marker := filepath.Join(dir, "member-proof")
+	args := append([]string{mode, marker}, extra...)
+	o, initial, err := lib.New(child, dir, args)
+	var generation uint64
+	if o != nil {
+		own(t, o)
+		t.Cleanup(func() {
+			o.mu.Lock()
+			released := o.raw == nil
+			o.mu.Unlock()
+			if generation == 0 || released {
+				return
+			}
+			receipt, e := o.CloseJobMembers(generation)
+			if !receipt.CloseFinalized {
+				t.Errorf("member generation %d did not finalize before owner cleanup: %+v %v", generation, receipt, e)
+			}
+		})
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	return lib, o, initial, marker, func(g uint64) {
+		if g != 0 {
+			generation = g
+		}
+	}
+}
+
+// Keep binary account SID bytes out of test diagnostics.
+func memberSummary(v MemberSnapshot) string {
+	return fmt.Sprintf("generation=%d original_pid=%d complete=%v rows=%d resources=%d",
+		v.Generation, v.Original.PID, v.AcquisitionComplete, len(v.Rows), len(v.Resources))
+}
+
+func waitMemberMarker(t *testing.T, marker string) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		_, err := os.Stat(marker)
+		if err == nil {
+			return
+		}
+		if !os.IsNotExist(err) || !time.Now().Before(deadline) {
+			t.Fatalf("owned member marker did not appear: %v", err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func requireMemberClose(t *testing.T, o *Owner, generation uint64) MemberClose {
+	t.Helper()
+	got, err := o.CloseJobMembers(generation)
+	if err != nil || got.Generation != generation || !got.CloseFinalized || !got.CleanupComplete {
+		t.Fatalf("member close: %+v %v", got, err)
+	}
+	again, err := o.CloseJobMembers(generation)
+	if err != nil || !reflect.DeepEqual(again, got) {
+		t.Fatalf("member close replay changed its receipt: %+v %v", again, err)
+	}
+	return got
+}
+
+func TestMemberRootOnlyCopiesRetainOwnerAndHistoricalBinding(t *testing.T) {
+	lib, o, initial, marker, keep := memberFixture(t, "exit", "7", "same-original")
+	generation, got, err := o.ObserveJobMembers(3000)
+	keep(generation)
+	if err != nil || generation == 0 || got.Generation != generation || !got.AcquisitionComplete {
+		t.Fatalf("root-only acquisition: generation=%d %+v %v", generation, memberSummary(got), err)
+	}
+	if got.Original.PID != initial.PID || got.Original.CreationTime100ns == 0 ||
+		got.Pre == nil || got.Post == nil || got.Pre.TotalProcesses != 1 || got.Pre.ActiveProcesses != 1 ||
+		!reflect.DeepEqual(got.Pre, got.Post) || len(got.Rows) != 1 || len(got.Resources) != 1 ||
+		got.Rows[0].PID != initial.PID || got.Rows[0].CreationTime100ns != got.Original.CreationTime100ns ||
+		!got.Resources[0].BorrowedOriginal || got.Resources[0].CloseAttempted {
+		t.Fatalf("root-only facts: %s", memberSummary(got))
+	}
+	baseline, err := o.JobMemberSnapshot(generation)
+	if err != nil || !reflect.DeepEqual(baseline, got) {
+		t.Fatalf("historical copy changed: %s %v", memberSummary(baseline), err)
+	}
+	got.Pre.PIDs[0] = 0
+	got.Post.PIDs[0] = 0
+	got.Rows[0].ImagePathUTF16[0] = 0
+	got.Rows[0].TokenUserSID[0] = 0
+	got.Resources[0].PID = 0
+	runtime.GC()
+	again, err := o.JobMemberSnapshot(generation)
+	if err != nil || !reflect.DeepEqual(again, baseline) {
+		t.Fatalf("returned arrays alias each other or native storage: %s %v", memberSummary(again), err)
+	}
+	if err := o.RevalidateJobMembers(generation, 3000, initial.PID); err != nil {
+		t.Fatal(err)
+	}
+	wait, err := o.WaitForExit(0)
+	if err != nil || wait.State != waitPending {
+		t.Fatalf("pure root/Job wait was blocked by member observation: %+v %v", wait, err)
+	}
+	for _, operation := range []struct {
+		name string
+		call func() (Outcome, error)
+	}{
+		{"admit", func() (Outcome, error) { return o.Admit(true) }},
+		{"stop", func() (Outcome, error) { return o.Stop(99) }},
+		{"finish", func() (Outcome, error) { return o.Finish(0) }},
+		{"close-exited", o.CloseExited},
+	} {
+		if _, err := operation.call(); err == nil {
+			t.Fatalf("%s consumed an active member observation", operation.name)
+		}
+	}
+	absent(t, marker)
+	requireStatus(t, o.Release(), notSettled)
+	if err := lib.Close(); err == nil {
+		t.Fatal("active member owner allowed DLL unload")
+	}
+	closed := requireMemberClose(t, o, generation)
+	if len(closed.Resources) != 1 || !closed.Resources[0].BorrowedOriginal ||
+		closed.Resources[0].CloseAttempted || closed.Resources[0].Closed || closed.Resources[0].CloseFailed {
+		t.Fatalf("member close consumed borrowed root: %+v", closed)
+	}
+	closed.Resources[0].PID = 0
+	if fresh, err := o.CloseJobMembers(generation); err != nil || len(fresh.Resources) != 1 || fresh.Resources[0].PID != initial.PID {
+		t.Fatalf("caller mutation changed cached member close: %+v %v", fresh, err)
+	}
+	if err := o.RevalidateJobMembers(generation, 3000, 0); err == nil {
+		t.Fatal("finalized generation was revalidated")
+	}
+	if _, err := o.Admit(true); err != nil {
+		t.Fatalf("refused terminal operations damaged original admission: %v", err)
+	}
+	out, err := o.Finish(3000)
+	if err != nil || out.State != complete || out.RootExit != 7 {
+		t.Fatalf("same original owner did not settle: %+v %v", out, err)
+	}
+	// mh_out now knows root exit, but the acquisition row is historical.
+	historical, err := o.JobMemberSnapshot(generation)
+	if err != nil || !reflect.DeepEqual(historical, baseline) {
+		t.Fatalf("cached root exit invalidated historical member facts: %s %v", memberSummary(historical), err)
+	}
+	if err := o.Release(); err != nil {
+		t.Fatal(err)
+	}
+	if err := lib.Close(); err != nil {
+		t.Fatal(err)
+	}
+	runtime.GC()
+	if baseline.Rows[0].PID != initial.PID || baseline.Rows[0].TokenUserSID[0] != 1 {
+		t.Fatal("Go member copies did not survive release and unload")
+	}
+	if data, err := os.ReadFile(marker); err != nil || string(data) != "same-original" {
+		t.Fatalf("original child effect mismatch: bytes=%d err=%v", len(data), err)
+	}
+}

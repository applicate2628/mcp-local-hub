+//go:build !windows
+
+package api
+
+import "testing"
+
+// Call sites are guarded by runtime.GOOS. Never substitute a successful native
+// observation when a Windows-only proof is accidentally requested elsewhere.
+func newRecoveryNamespaceDirectoryReleaseProbe(t *testing.T, _ string) recoveryNamespaceDirectoryReleaseProbe {
+	t.Helper()
+	t.Fatal("native directory release probe requires Windows")
+	return recoveryNamespaceDirectoryReleaseProbe{}
+}
diff --git a/internal/api/secrets_init_recovery_directory_probe_windows_test.go b/internal/api/secrets_init_recovery_directory_probe_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ad4ccac3b9053a9937d5f68a0b7f718df416299f
--- /dev/null
+++ b/internal/api/secrets_init_recovery_directory_probe_windows_test.go
@@ -0,0 +1,93 @@
+//go:build windows
+
+package api
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+// The production directory open requests FILE_LIST_DIRECTORY. Windows refuses
+// share=0 while any such original handle remains open, even when that earlier
+// open allowed all sharing. Verify both directions against the same File ID;
+// a whole-process handle total cannot identify a particular directory leak.
+func newRecoveryNamespaceDirectoryReleaseProbe(t *testing.T, originalPath string) recoveryNamespaceDirectoryReleaseProbe {
+	t.Helper()
+	type fileID struct{ volume, high, low uint32 }
+	identity := func(handle windows.Handle) (fileID, error) {
+		var info windows.ByHandleFileInformation
+		if err := windows.GetFileInformationByHandle(handle, &info); err != nil {
+			return fileID{}, err
+		}
+		if info.FileAttributes&windows.FILE_ATTRIBUTE_DIRECTORY == 0 ||
+			info.FileAttributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+			return fileID{}, errors.New("probe requires an ordinary directory")
+		}
+		return fileID{info.VolumeSerialNumber, info.FileIndexHigh, info.FileIndexLow}, nil
+	}
+	observe := func(path string, access, sharing uint32) (id fileID, retErr error) {
+		wide, err := windows.UTF16PtrFromString(path)
+		if err != nil {
+			return id, err
+		}
+		handle, err := windows.CreateFile(wide, access, sharing, nil, windows.OPEN_EXISTING,
+			windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+		if err != nil {
+			return id, err
+		}
+		defer func() {
+			if err := windows.CloseHandle(handle); err != nil {
+				retErr = errors.Join(retErr, fmt.Errorf("close directory probe: %w", err))
+			}
+		}()
+		return identity(handle)
+	}
+	want, err := observe(originalPath, windows.FILE_LIST_DIRECTORY, 0)
+	if err != nil {
+		t.Fatalf("initial exclusive directory observation: %v", err)
+	}
+	if want.high == 0 && want.low == 0 {
+		t.Fatal("directory probe received an empty native File ID")
+	}
+	return recoveryNamespaceDirectoryReleaseProbe{
+		held: func(path string, file *os.File) {
+			t.Helper()
+			actual, err := identity(windows.Handle(file.Fd()))
+			runtime.KeepAlive(file)
+			if err != nil || actual != want {
+				t.Fatalf("callback did not retain the original directory File ID: got=%+v want=%+v error=%v", actual, want, err)
+			}
+			// Metadata-only access is share-neutral. Close that observation
+			// before the negative control, so the test cannot block itself.
+			current, err := observe(path, 0, windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE)
+			if err != nil || current != want {
+				t.Fatalf("negative-control path is not the original directory File ID: got=%+v want=%+v error=%v", current, want, err)
+			}
+			wide, err := windows.UTF16PtrFromString(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			handle, openErr := windows.CreateFile(wide, windows.FILE_LIST_DIRECTORY, 0, nil, windows.OPEN_EXISTING,
+				windows.FILE_FLAG_BACKUP_SEMANTICS|windows.FILE_FLAG_OPEN_REPARSE_POINT, 0)
+			if openErr == nil {
+				closeErr := windows.CloseHandle(handle)
+				t.Fatalf("live original directory permitted an exclusive open; probe close=%v", closeErr)
+			}
+			if !errors.Is(openErr, windows.ERROR_SHARING_VIOLATION) {
+				t.Fatalf("live original directory negative control returned a different refusal: %v", openErr)
+			}
+		},
+		released: func(path string) {
+			t.Helper()
+			actual, err := observe(path, windows.FILE_LIST_DIRECTORY, 0)
+			if err != nil || actual != want {
+				t.Fatalf("original directory handle remained open or its File ID changed: got=%+v want=%+v error=%v", actual, want, err)
+			}
+		},
+	}
+}

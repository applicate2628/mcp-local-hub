+			waitCalls, closeCalls, legacyCalls := 0, 0, 0
+			closed, badPermit := false, false
+			terminal := rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 73, RootExit: 259}
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				waitCalls++
+				growRustOwnerCallbackStack(32)
+				if raw != 0x7531 || out == nil || size != 32 {
+					return 1
+				}
+				if closed {
+					*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, Flags: 1, PID: 73, RootExit: 259}
+					return 5
+				}
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 73, RootExit: 259}
+				return 0
+			})
+			closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				closeCalls++
+				growRustOwnerCallbackStack(64)
+				if raw != 0x7531 || out == nil || size != 48 {
+					return 1
+				}
+				*out = terminal
+				closed = true
+				gate.mu.Lock()
+				badPermit = badPermit || !gate.sealed || !gate.terminalActive || gate.entered != 0 || gate.active != nil
+				gate.mu.Unlock()
+				return 0
+			})
+			legacy := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				legacyCalls++
+				closed = true
+				*out = terminal
+				return 0
+			})
+			library := &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{
+				"mh_wait1": wait, "mh_close1": closeExited, "mh_finish1": legacy,
+			}}
+			library.activeOwners.Store(1)
+			owner := &rustNativeOwner{library: library, raw: 0x7531, memberGate: gate}
+			leave, err := gate.enterQuery(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer leave()
+			var result rustOwnerOutcome
+			if contextual {
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				deadline, _ := ctx.Deadline()
+				done := make(chan struct{})
+				go func() {
+					result, err = owner.FinishWithin(ctx)
+					close(done)
+				}()
+				t.Cleanup(func() {
+					cancel()
+					<-done
+				})
+				for {
+					gate.mu.Lock()
+					waitingForBorrow := gate.sealed && gate.entered == 1
+					gate.mu.Unlock()
+					if waitingForBorrow {
+						break
+					}
+					select {
+					case <-done:
+						t.Fatalf("finish returned before the borrow-drain barrier: %v", err)
+					default:
+						runtime.Gosched()
+					}
+				}
+				cancel()
+				<-done
+				gate.mu.Lock()
+				sameDeadline := gate.terminalDeadline.Equal(deadline)
+				gate.mu.Unlock()
+				if !errors.Is(err, context.Canceled) || !sameDeadline {
+					t.Fatalf("borrow drain lost cancellation or original deadline: err=%v sameDeadline=%t", err, sameDeadline)
+				}
+			} else {
+				result, err = owner.Finish(0)
+			}
+			if !errors.Is(err, ErrOriginalMemberBorrowPending) || result.State != 0 ||
+				result.PID != 73 || result.RootExit != 259 || result.Flags != 3 ||
+				closed || closeCalls != 0 || legacyCalls != 0 || waitCalls != 1 {
+				t.Fatalf("native close entered before original borrow drained: result=%+v err=%v closed=%t wait=%d close=%d legacy=%d",
+					result, err, closed, waitCalls, closeCalls, legacyCalls)
+			}
+			if err := library.Close(); err == nil || owner.raw != 0x7531 {
+				t.Fatal("pending original closure lost its DLL pin or native owner")
+			}
+			leave()
+			result, err = owner.Finish(0)
+			if err != nil || result != terminal || !closed || badPermit || closeCalls != 1 || waitCalls != 2 || legacyCalls != 0 {
+				t.Fatalf("same original permit did not close after drain: result=%+v err=%v badPermit=%t wait=%d close=%d legacy=%d",
+					result, err, badPermit, waitCalls, closeCalls, legacyCalls)
+			}
+			repeated, err := owner.Finish(0)
+			if err != nil || repeated != terminal || waitCalls != 2 || closeCalls != 2 || badPermit {
+				t.Fatalf("repeated finish lost cached native closure: result=%+v err=%v wait=%d close=%d",
+					repeated, err, waitCalls, closeCalls)
+			}
+		})
+	}
+}
+
+// Foreign calls can synchronously reenter Go; keep the buffer regression
+// independent of the compiler's incidental callback frame size.
+func growRustOwnerCallbackStack(depth int) {
+	var frame [1024]byte
+	if depth > 0 {
+		growRustOwnerCallbackStack(depth - 1)
+	} else {
+		runtime.GC()
+	}
+	runtime.KeepAlive(&frame)
+}
+
+func TestRustOwnerSplitCancellationBeforeAndAfterClose(t *testing.T) {
+	for _, afterClose := range []bool{false, true} {
+		name := "after-wait"
+		if afterClose {
+			name = "after-close"
+		}
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			waits, closes := 0, 0
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				waits++
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 7}
+				if !afterClose {
+					cancel()
+				}
+				return 0
+			})
+			closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				closes++
+				*out = rustOwnerOutcome{Size: 48, Version: 1, State: 3, Flags: 3, PID: 42, RootExit: 7,
+					CleanupMask: 4, CleanupCodes: [3]int32{0, 0, 5}}
+				cancel()
+				return 0
+			})
+			owner := &rustNativeOwner{raw: 0x4242, memberGate: newOriginalMemberCustody(),
+				library: &rustOwnerLibrary{ready: true,
+					procedures: map[string]uintptr{"mh_wait1": wait, "mh_close1": closeExited}}}
+			owner.library.activeOwners.Store(1)
+			result, err := owner.FinishWithin(ctx)
+			if !errors.Is(err, context.Canceled) || owner.raw != 0x4242 || owner.library.activeOwners.Load() != 1 ||
+				result.PID != 42 || result.RootExit != 7 || waits != 1 {
+				t.Fatalf("cancellation lost original custody/diagnostics: result=%+v err=%v waits=%d", result, err, waits)
+			}
+			var cleanup *rustOwnerCleanupFailure
+			if !afterClose {
+				if closes != 0 || owner.closeStarted || result.State != 0 || errors.As(err, &cleanup) {
+					t.Fatalf("canceled exit observation closed resources: result=%+v err=%v closes=%d", result, err, closes)
+				}
+				leave, err := owner.memberGate.enterQuery(nil)
+				if err != nil {
+					t.Fatalf("canceled preclose wait sealed the gate: %v", err)
+				}
+				leave()
+			} else {
+				if closes != 1 || !owner.closeStarted || result.State != 3 || !errors.As(err, &cleanup) ||
+					cleanup.Mask != 4 || cleanup.Codes[2] != 5 {
+					t.Fatalf("late cancellation hid native cleanup: result=%+v err=%v closes=%d", result, err, closes)
+				}
+				repeated, err := owner.Finish(0)
+				if repeated != result || !errors.As(err, &cleanup) || errors.Is(err, context.Canceled) ||
+					waits != 1 || closes != 2 {
+					t.Fatalf("explicit repeat lost cached cleanup: result=%+v err=%v waits=%d closes=%d", repeated, err, waits, closes)
+				}
+			}
+		})
+	}
+}

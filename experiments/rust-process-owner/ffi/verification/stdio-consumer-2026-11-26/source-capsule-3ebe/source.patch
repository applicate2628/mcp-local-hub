+	}
+	if _, err := original.ReleaseOriginal(); err != nil || f.closeCalls != 1 || f.releaseCalls != 1 {
+		t.Fatalf("cached release repeated native work: err=%v close=%d release=%d", err, f.closeCalls, f.releaseCalls)
+	}
+}
+
+func TestRustOwnerFacadeLifetimeWaitIgnoresStartContext(t *testing.T) {

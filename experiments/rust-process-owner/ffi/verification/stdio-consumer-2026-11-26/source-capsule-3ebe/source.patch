+func TestOpenRustOwnerLibraryBorrowProfileRequiresResolvedBorrowExport(t *testing.T) {
+	layout := newRustOwnerBorrowTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	delete(api.procAddrs, "mh_borrow_process1")
+	library, err, calls := openFakeRustOwner(t, layout, api)
+	if library != nil {
+		t.Cleanup(func() { _ = library.Close() })
+	}
+	if err == nil || !strings.Contains(err.Error(), "mh_borrow_process1") ||
+		library != nil || calls != 1 || api.loadCalls != 1 || api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+		t.Fatalf("unresolved borrow admitted: error=%v admission=%d load=%d free=%d", err, calls, api.loadCalls, api.freeCalls)
+	}
+}
+
+func TestOpenRustOwnerLibraryRejectsMixedBorrowReceiptBeforeLoad(t *testing.T) {
+	layout := newRustOwnerBorrowTestLayout(t)
+	receipt := layout.expected
+	receipt.Exports = append(runtimeidentity.WindowsProcessOwnerExportsV1(), "mh_borrow_process1")
+	sort.Strings(receipt.Exports)
+	writeRustOwnerTestIdentity(t, layout.identity, receipt)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	library, err, calls := openFakeRustOwner(t, layout, api)
+	if library != nil {
+		t.Cleanup(func() { _ = library.Close() })
+	}
+	if err == nil || library != nil || calls != 0 || api.loadCalls != 0 || api.lockGuard.closeCalls != 1 {
+		t.Fatalf("partial borrow profile reached loader: error=%v admission=%d load=%d", err, calls, api.loadCalls)
+	}
+}
+
+func TestOpenRustOwnerLibraryBorrowProfileDoesNotChangeAcrossAdmission(t *testing.T) {
+	for _, postLoad := range []bool{false, true} {
+		name := "before-load"
+		if postLoad {
+			name = "after-load"
+		}
+		t.Run(name, func(t *testing.T) {
+			layout := newRustOwnerBorrowTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(layout)
+			calls := 0
+			base := matchingRustOwnerAdmission(layout, &calls)
+			admit := func(path string, machine uint16, exports []string, commit string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error) {
+				value, err := base(path, machine, exports, commit)
+				if err == nil && (!postLoad || calls == 2) {
+					value.Exports = runtimeidentity.WindowsProcessOwnerMemberExportsV1()
+				}
+				return value, err
+			}
+			library, err := openRustOwnerLibrary(layout.product, rustOwnerTestCommit, layout.expected.SHA256,
+				rustOwnerLibraryDependencies{api: api, admit: admit})
+			if library != nil {
+				t.Cleanup(func() { _ = library.Close() })
+			}
+			wantCalls, wantLoad := 1, 0
+			if postLoad {
+				wantCalls, wantLoad = 2, 1
+			}
+			if err == nil || library != nil || calls != wantCalls || api.loadCalls != wantLoad ||
+				api.freeCalls != wantLoad || api.lockGuard.closeCalls != 1 {
+				t.Fatalf("receipt changed admitted surface: error=%v calls=%d load=%d free=%d", err, calls, api.loadCalls, api.freeCalls)
+			}
+			if !slices.Equal(layout.expected.Exports, runtimeidentity.WindowsProcessOwnerBorrowExportsV1()) {
+				t.Fatal("revalidation mutated the original profile")
+			}
+		})
+	}
+}

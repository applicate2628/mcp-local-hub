+func (fixture codexPublicInstallFixture) assertClientBytes(t *testing.T, global, project []byte) {
+	t.Helper()
+	for path, want := range map[string][]byte{fixture.codexPath: global, fixture.projectPath: project} {
+		got, err := os.ReadFile(path)
+		if err != nil || !bytes.Equal(got, want) {
+			t.Fatalf("config changed at %s: %v\nwant=%s\ngot=%s", path, err, want, got)
+		}
+	}
+}
+
+func TestReceiveCodexManagedInstallTargetDoesNotCreateMissingState(t *testing.T) {
+	fixture := newCodexPublicInstallFixture(t, "tool_timeout_sec = 45\n")
+	global := fixture.installAndReceive(t, 45, false)
+	missing := filepath.Join(t.TempDir(), "state-not-created")
+	t.Cleanup(SetDaemonStateRootForTest(missing))
+	client, err := clients.NewCodexCLI()
+	if err != nil {
+		t.Fatal(err)
+	}
+	update := ClientUpdatePlan{
+		Client: "codex-cli", Action: ClientUpdateAddReplace, EntryName: fixture.name + "-mcphub",
+		URL: clients.HubLoopbackURL(fixture.port, "/mcp"), ToolTimeoutSec: 45, DaemonName: "default",
+	}
+	snapshot, err := receiveCodexManagedInstallTarget(context.Background(), fixture.name, update, client)
+	if err == nil || snapshot != (clients.ManagedRegistrationEntrySnapshot{}) {
+		t.Fatalf("missing state produced receiving: snapshot=%#v err=%v", snapshot, err)
+	}
+	if _, err := os.Stat(missing); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("read-only receiving created state root: %v", err)
+	}
+	fixture.assertClientBytes(t, global, fixture.projectBytes)
+}

+	callback := syscall.NewCallback(func(request *rustOwnerCreate, requestBytes uintptr, slot *uintptr, out *rustOwnerOutcome, outBytes uintptr) uintptr {
+		*slot = 0x4264
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		return 0

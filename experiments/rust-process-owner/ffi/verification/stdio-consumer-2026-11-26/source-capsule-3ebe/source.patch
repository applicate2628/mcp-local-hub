+// Only integer address observations escape this helper. The callback does not
+// retain typed pointers to constructor buffers and accidentally keep them live.
+func rustIOABIAddresses(request *rustOwnerCreate, context *rustOwnerIOContext, slot *uintptr, output *rustOwnerOutcome) []uintptr {
+	addresses := []uintptr{
+		uintptr(unsafe.Pointer(request)), uintptr(unsafe.Pointer(context)),
+		uintptr(unsafe.Pointer(slot)), uintptr(unsafe.Pointer(output)),
+		uintptr(unsafe.Pointer(request.Program.Data)), uintptr(unsafe.Pointer(request.Cwd.Data)),
+		uintptr(unsafe.Pointer(request.Args)), uintptr(unsafe.Pointer(context.Environment.Entries)),
+	}
+	for _, argument := range unsafe.Slice(request.Args, int(request.Argc)) {
+		addresses = append(addresses, uintptr(unsafe.Pointer(argument.Data)))
+	}
+	for _, entry := range unsafe.Slice(context.Environment.Entries, int(context.Environment.Count)) {
+		addresses = append(addresses, uintptr(unsafe.Pointer(entry.Name.Data)), uintptr(unsafe.Pointer(entry.Value.Data)))
+	}
+	return addresses
+}
+
+func rustIOABIViewMatches(view rustOwnerUTF16, terminated []uint16) bool {
+	return view.Data != nil && view.Len <= 32766 && view.Len+1 == uintptr(len(terminated)) &&
+		slices.Equal(unsafe.Slice(view.Data, len(terminated)), terminated)
+}
+
+type rustIOABICreateResult struct {
+	owner, retained *rustNativeOwner
+	output          rustOwnerOutcome
+	err             error
+}
+
+func TestRustOwnerIOABIRequestSurvivesCallbackStackGrowth(t *testing.T) {
+	directory := t.TempDir()
+	program := filepath.Join(directory, "child-π🚀.exe")
+	args := []string{"first", "two words", "quoted \"x\"\\tail", "π🚀", ""}
+	environment := []rustOwnerEnvironmentEntry{
+		{Name: "EMPTY", Value: ""},
+		{Name: "UNICODE", Value: "значение π🚀"},
+		{Name: "Z_LAST", Value: "value=with=equals"},
+	}
+	text := append([]string{program, directory}, args...)
+	for _, entry := range environment {
+		text = append(text, entry.Name, entry.Value)
+	}
+	terminated := make([][]uint16, len(text))
+	for i, value := range text {
+		var err error
+		terminated[i], err = syscall.UTF16FromString(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	var checked bool
+	var library *rustOwnerLibrary
+	library, probe := rustIOABIRejectingLibrary(func(request *rustOwnerCreate, context *rustOwnerIOContext, slot *uintptr, output *rustOwnerOutcome) string {
+		if request.Argc != uintptr(len(args)) || request.Args == nil ||
+			context.Environment.Count != uintptr(len(environment)) || context.Environment.Entries == nil {
+			return "nested request bounds changed"
+		}
+		before := rustIOABIAddresses(request, context, slot, output)
+		streams := context.Streams
+		for _, address := range before {
+			if address == 0 {
+				return "a required constructor buffer has no address"
+			}
+		}
+		growRustOwnerCallbackStack(64) // Includes GC at the deepest callback frame.
+		runtime.GC()
+		if request.Argc != uintptr(len(args)) || request.Args == nil ||
+			context.Environment.Count != uintptr(len(environment)) || context.Environment.Entries == nil {
+			return "nested request bounds changed across callback stack growth"
+		}
+		if !slices.Equal(before, rustIOABIAddresses(request, context, slot, output)) {
+			return "constructor buffer addresses moved across callback stack growth"
+		}
+		if request.Version != 1 || request.Reserved != 0 || *slot != 0 ||
+			*output != (rustOwnerOutcome{Size: 48, Version: 1}) ||
+			context.Streams != streams || library.activeOwners.Load() != 1 {
+			return "pinned records, stream values or reserved custody changed"
+		}
+		views := []rustOwnerUTF16{request.Program, request.Cwd}
+		views = append(views, unsafe.Slice(request.Args, int(request.Argc))...)
+		for _, entry := range unsafe.Slice(context.Environment.Entries, int(context.Environment.Count)) {
+			views = append(views, entry.Name, entry.Value)
+		}
+		for i, view := range views {
+			if !rustIOABIViewMatches(view, terminated[i]) {
+				return fmt.Sprintf("UTF-16 payload or terminator changed at view %d", i)
+			}
+		}
+		for i, handle := range context.Streams {
+			flags, err := rustStdioTestHandleFlags(handle)
+			if handle == 0 || err != nil || flags&syscall.HANDLE_FLAG_INHERIT == 0 {
+				return fmt.Sprintf("temporary stream %d is not live and inheritable: %v", i, err)
+			}
+		}
+		checked = true
+		return ""
+	})
+	streams := rustStdioTestFiles(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	done := make(chan rustIOABICreateResult, 1)
+	// A fresh goroutine prevents an already-grown test-runner stack from hiding
+	// the reentrant stack-growth regression. This worker performs no pipe I/O.
+	go func() {
+		var result rustIOABICreateResult
+		result.owner, result.output, result.err = library.startRetainedRustOwnerIO(
+			ctx, program, directory, args, environment, streams,
+			func(original *rustNativeOwner) error {
+				result.retained = original
+				if original == nil || original.raw != 0 || !original.preparing.Load() ||
+					library.activeOwners.Load() != 1 || probe.calls.Load() != 0 {
+					return errors.New("retention did not precede native entry")
+				}
+				return nil
+			},
+		)
+		done <- result
+	}()
+	var result rustIOABICreateResult
+	select {
+	case result = <-done:
+	case <-ctx.Done():
+		select {
+		case result = <-done:
+		case <-time.After(3 * time.Second):
+			t.Fatal("synthetic create callback did not return")
+		}
+	}
+	if ctx.Err() != nil || result.err == nil || errors.Is(result.err, errRustOwnerOutcome) ||
+		result.output != (rustOwnerOutcome{Size: 48, Version: 1}) || result.owner == nil ||
+		probe.calls.Load() != 1 || probe.failure != "" || !checked {
+		t.Fatalf("pinned IO boundary: calls=%d checked=%t failure=%q output=%+v err=%v context=%v",
+			probe.calls.Load(), checked, probe.failure, result.output, result.err, ctx.Err())
+	}
+	rustIOABIAssertAbandoned(t, library, result.owner, result.retained)
+}
+
+// The first Done lookup occurs only when admission actually waits on a mutex.
+// Err and Deadline retain the ordinary underlying context semantics.
+type rustIOABIWaitingContext struct {
+	context.Context
+	waiting chan struct{}
+	once    sync.Once
+}
+
+func (ctx *rustIOABIWaitingContext) Done() <-chan struct{} {
+	ctx.once.Do(func() { close(ctx.waiting) })
+	return ctx.Context.Done()
+}

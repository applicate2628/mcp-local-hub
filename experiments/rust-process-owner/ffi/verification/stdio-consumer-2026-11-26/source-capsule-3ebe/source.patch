+func stdioRustOriginalNoChild(t *testing.T, h *StdioHost, retained *process.AtCreateJobProcess) StdioHostSettlement {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	result, err := h.StopObserved(ctx)
+	native := result.NativeSettlement.Snapshot()
+	if err != nil || !result.Complete() || result.NoNativeAttempt ||
+		!native.NoChildKnown || !native.HandlesClosed || result.RootWait.Known || native.RootWaitKnown {
+		t.Fatalf("retained no-child facade was not received: %+v native=%+v err=%v", result, native, err)
+	}
+	if retained == nil || retained.Created() || h.original == nil || h.original.original != retained {
+		t.Fatal("no-child receiving lost the same retained facade")
+	}
+	if h.original.job != nil || h.job != nil || h.cmd == nil ||
+		h.cmd.Process != nil || h.cmd.ProcessState != nil || h.ExitState() != nil {
+		t.Fatal("retained no-child receiving acquired unrelated Go process ownership")
+	}
+	for _, done := range []<-chan struct{}{
+		h.original.rootDone, h.original.stdoutDone, h.original.stderrDone,
+		h.original.watcherDone, h.original.lifetimeDone, h.original.stopDone,
+		h.original.input.joined, h.ChildExited(),
+	} {
+		select {
+		case <-done:
+		default:
+			t.Fatal("no-child receipt preceded an owned worker's completion")
+		}
+	}
+	stdioRustOriginalFilesClosed(t, h)
+	return result
+}

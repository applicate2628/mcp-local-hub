+package api
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"testing/synctest"
+	"time"
+)
+
+func TestSerenaPreparationAcquisitionContextLifetime(t *testing.T) {
+	for _, mode := range []string{"work_cancel", "work_deadline", "release"} {
+		t.Run(mode, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				workEnd := time.Now().Add(time.Minute)
+				cleanupEnd := workEnd.Add(time.Minute)
+				work, cancelWork := context.WithDeadline(context.Background(), workEnd)
+				defer cancelWork()
+				cleanup, cancelCleanup := context.WithDeadline(context.WithoutCancel(work), cleanupEnd)
+				defer cancelCleanup()
+				acquisition, release, err := serenaPreparationAcquisitionContext(work, workEnd, cleanupEnd)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer release()
+				if end, finite := acquisition.Deadline(); !finite || !end.Equal(cleanupEnd) {
+					t.Fatalf("original cleanup bound changed: finite=%v end=%v", finite, end)
+				}
+				switch mode {
+				case "work_cancel":
+					cancelWork()
+				case "work_deadline":
+					time.Sleep(time.Until(workEnd))
+				case "release":
+					release()
+				}
+				synctest.Wait()
+				if !errors.Is(acquisition.Err(), context.Canceled) || cleanup.Err() != nil {
+					t.Fatalf("acquisition=%v cleanup=%v", acquisition.Err(), cleanup.Err())
+				}
+				if mode == "work_deadline" && !errors.Is(errors.Join(acquisition.Err(), work.Err()), context.DeadlineExceeded) {
+					t.Fatal("original work deadline cause lost")
+				}
+				if mode == "release" && work.Err() != nil {
+					t.Fatal("releasing acquisition canceled work")
+				}
+				time.Sleep(time.Until(cleanupEnd))
+				synctest.Wait()
+				if !errors.Is(cleanup.Err(), context.DeadlineExceeded) {
+					t.Fatal("cleanup outlived its original bound")
+				}
+			})
+		})
+	}
+}
+
+func TestSerenaPreparationAcquisitionContextRefusesInvalidBounds(t *testing.T) {
+	for _, mode := range []string{"nil", "unbounded", "zero_work", "zero_cleanup", "reversed", "cleanup_context", "canceled", "expired"} {
+		t.Run(mode, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				workEnd := time.Now().Add(time.Minute)
+				cleanupEnd := workEnd.Add(time.Minute)
+				work, cancel := context.WithDeadline(context.Background(), workEnd)
+				defer cancel()
+				var expected error
+				switch mode {
+				case "nil":
+					work = nil
+				case "unbounded":
+					work = context.Background()
+				case "zero_work":
+					workEnd = time.Time{}
+				case "zero_cleanup":
+					cleanupEnd = time.Time{}
+				case "reversed":
+					cleanupEnd = workEnd.Add(-time.Second)
+				case "cleanup_context":
+					var stop context.CancelFunc
+					work, stop = context.WithDeadline(context.Background(), cleanupEnd)
+					defer stop()
+				case "canceled":
+					cancel()
+					expected = context.Canceled
+				case "expired":
+					time.Sleep(time.Until(workEnd))
+					synctest.Wait()
+					expected = context.DeadlineExceeded
+				}
+				acquisition, release, err := serenaPreparationAcquisitionContext(work, workEnd, cleanupEnd)
+				if acquisition != nil || release != nil || err == nil {
+					if release != nil {
+						release()
+					}
+					t.Fatal("invalid work admitted a new acquisition")
+				}
+				if expected != nil && !errors.Is(err, expected) {
+					t.Fatalf("original cause lost: %v", err)
+				}
+			})
+		})
+	}
+}

+func (fixture codexPublicInstallFixture) installAndReceive(t *testing.T, timeout int, disabled bool) []byte {
+	t.Helper()
+	var output bytes.Buffer
+	opts := fixture.opts
+	opts.Writer = &output
+	if err := NewAPI().Install(opts); err != nil {
+		t.Fatalf("first public Install did not establish receiving prerequisites: %v\n%s", err, output.String())
+	}
+	after, err := os.ReadFile(fixture.codexPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(after, []byte("startup_timeout_sec")) {
+		t.Fatalf("first install introduced an omitted source timeout:\n%s", after)
+	}
+	client, err := clients.NewCodexCLI()
+	if err != nil {
+		t.Fatal(err)
+	}
+	logical, err := client.GetEntry(fixture.name)
+	if err != nil || logical != nil {
+		t.Fatalf("logical source after first install = %#v, %v", logical, err)
+	}
+	alias := fixture.name + "-mcphub"
+	physical, err := client.GetEntry(alias)
+	if err != nil || physical == nil || physical.URL != clients.HubLoopbackURL(fixture.port, "/mcp") || physical.ToolTimeoutSec != timeout || physical.Disabled != disabled {
+		t.Fatalf("physical target after first install = %#v, %v", physical, err)
+	}
+	managed, ok := clients.AsManagedRegistrationClient(client)
+	if !ok {
+		t.Fatalf("client %T has no locked managed receiving port", client)
+	}
+	live, err := managed.SnapshotManagedRegistration(context.Background(), alias)
+	if err != nil {
+		t.Fatal(err)
+	}
+	journal, err := newManagedRegistrationJournalStore(fixture.stateRoot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stored, err := journal.read(context.Background())
+	if err != nil || !managedRegistrationJournalSettled(stored) || len(stored.Rows) != 1 || stored.Rows[0].After != live {
+		t.Fatalf("first public install has no exact settled journal/live snapshot: journal=%#v live=%#v err=%v", stored, live, err)
+	}
+	rawEntries, err := ReadStateFileInodeAnchored(filepath.Join(fixture.stateRoot, managedEntriesFileLeaf))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var entries ManagedEntries
+	if err := json.Unmarshal(rawEntries, &entries); err != nil || len(entries.Entries) != 1 {
+		t.Fatalf("first public install managed projection = %#v, %v", entries, err)
+	}
+	entry := entries.Entries[0]
+	if entry.Client != "codex-cli" || entry.Server != fixture.name || managedRegistrationEntryIsLegacy(entry) ||
+		entry.ConfigSHA256 != live.ConfigSHA256 || entry.EntrySHA256 != live.EntrySHA256 ||
+		entry.DesiredProjectionSHA256 != live.DesiredProjectionSHA256 ||
+		entry.ConfigPathSHA256 != live.ConfigPathSHA256 || entry.EntryKeySHA256 != live.EntryKeySHA256 ||
+		entry.TargetIdentitySHA256 != live.TargetIdentitySHA256 {
+		t.Fatalf("first public install did not project its actual journal/live identity: entry=%#v live=%#v", entry, live)
+	}
+	return after
+}

+		if err != nil {
+			t.Fatal("original tree rejected cleanup context", err)
+		}
+		actual, err := preparedSerenaRootFile(item.root.Path, inventory.RootIdentity)
+		if err != nil || actual != item.root {
+			t.Fatal("cleanup changed original root identity", err)
+		}
+		if _, err := item.tree.WorkingDirectory(context.Background()); err == nil {
+			t.Fatal("unbounded receiving context admitted")
+		}
+		later, cancelLater := context.WithDeadline(context.Background(), r.AbsoluteCleanupDeadline.Add(time.Second))
+		_, err = item.tree.WorkingDirectory(later)
+		cancelLater()
+		if err == nil {
+			t.Fatal("original cleanup bound was renewed")
+		}
+	}
+	// Removing the attempt inventories the SAME generation as its survivor.
+	removed, err := a.cleanupAttempt(cleanup, roots, closure)
+	if err != nil || !removed.AttemptAbsent || !removed.LinksDischarged || !removed.NoPendingResources {
+		t.Fatal("attempt cleanup failed within original bound", err)
+	}
+	if _, err := os.Stat(roots.Attempt.Path); !os.IsNotExist(err) {
+		t.Fatal("attempt still present", err)
+	}
+	if _, err := a.generation.Inventory(cleanup); err != nil {
+		t.Fatal("surviving generation lost its original capability", err)
+	}
+}
+
+func TestSerenaQualificationTreeRetainsCleanupBound(t *testing.T) {
+	r := serenaAcquisitionRequest(t)
+	work, cancelWork := context.WithDeadline(context.Background(), r.WorkDeadline)
+	defer cancelWork()
+	cleanup, cancelCleanup := context.WithDeadline(context.WithoutCancel(work), r.AbsoluteCleanupDeadline)
+	defer cancelCleanup()
+	executable, closure := serenaAcquisitionInertCommand(t, work, r)
+	// The inert command is only constructor input. This test does not claim
+	// a Serena installation or start an unpublished qualification host.
+	installed := PreparedSerenaInstallation{Closure: closure, Entrypoint: executable}
+	resources, err := AcquireUnpublishedSerenaQualificationResources(work, r, installed, "qualification-lifetime")
+	if resources != nil {
+		defer func() {
+			proof, closeErr := resources.CloseUnstartedObserved(cleanup)
+			if closeErr != nil || proof.Validate(cleanup, resources) != nil {
+				t.Error("original qualification cleanup unsettled", closeErr)
+			}
+		}()
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Reuse the original inert-command closure above; these bindings do not
+	// claim a Serena installation or start an additional process.
+	key, err := r.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := &preparedSerenaAcquisition{inputs: SerenaPreparationInputs{Request: r}}
+	defer func() {
+		if err := a.closeOriginalRoots(); err != nil {
+			t.Error(err)
+		}
+	}()
+	roots, err := a.acquireRoots(work, r, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, err := a.generation.Inventory(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	installed.InventorySHA256 = inventory.SHA256
+	// Keep the first fixture's reservation untouched until work cancellation.
+	profiles, err := AcquireUnpublishedSerenaQualificationResources(work, r, installed, "qualification-profiles")
+	if profiles != nil {
+		defer func() {
+			proof, closeErr := profiles.CloseUnstartedObserved(cleanup)
+			if closeErr != nil || proof.Validate(cleanup, profiles) != nil {
+				t.Error("original profile resource cleanup unsettled", closeErr)
+			}
+		}()
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	reservation, err := profiles.ReleaseReservationObserved(work)
+	if err != nil || reservation.Validate(profiles) != nil {
+		t.Fatal("original reservation release failed", err)
+	}
+	host, err := profiles.HostInputs(work, PreparedSerenaQualificationRequest{
+		QualificationID: "qualification-profiles", Request: r,
+		Inputs: SerenaPreparationInputs{Request: r, EnvironmentProjectionSHA256: r.BuildEnvironmentSHA256},
+		Roots:  roots, Installation: installed, WorkDeadline: r.WorkDeadline,
+		CleanupDeadline: r.AbsoluteCleanupDeadline, Resources: profiles,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ownedRoot, err := profiles.tree.WorkingDirectory(work)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ValidatePreparedSerenaEnvironment(preparedSerenaEnvironmentMap(host.Environment)); err != nil {
+		t.Fatal("qualification environment broke import isolation", err)
+	}
+	// No ambient profile may make this pass. t.Setenv restores every change;
+	// this test is deliberately not parallel and starts no profile consumer child.
+	for _, key := range []string{"HOME", "USERPROFILE", "HOMEDRIVE", "HOMEPATH", "APPDATA", "LOCALAPPDATA"} {
+		t.Setenv(key, "")
+	}
+	if _, err := os.UserHomeDir(); err == nil {
+		t.Fatal("closed environment unexpectedly resolved an ambient home")
+	}
+	for _, entry := range host.Environment {
+		key, value, ok := strings.Cut(entry, "=")
+		if !ok || key == "" {
+			t.Fatal("invalid qualification environment entry")
+		}
+		t.Setenv(key, value)
+	}
+	for _, consumer := range []struct {
+		name string
+		read func() (string, error)
+	}{{"home", os.UserHomeDir}, {"config", os.UserConfigDir}, {"cache", os.UserCacheDir}} {
+		path, err := consumer.read()
+		if err != nil || filepath.Clean(path) != ownedRoot {
+			t.Fatalf("%s resolved outside original qualification root: %q, %v", consumer.name, path, err)
+		}
+	}
+	cancelWork()
+	proof, err := resources.CloseUnstartedObserved(cleanup)
+	if err != nil || proof.Validate(cleanup, resources) != nil || !proof.tree.Complete() {
+		t.Fatal("qualification tree rejected original cleanup bound", err)
+	}
+	root := filepath.Join(r.Namespace, resources.key, "qualifications", "qualification-lifetime")
+	if _, err := os.Stat(root); !os.IsNotExist(err) {
+		t.Fatal("qualification tree still present", err)
+	}
+	listener, err := net.Listen("tcp", resources.listener.Addr().String())
+	if err != nil {
+		t.Fatal("original reservation port not released", err)
+	}
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	profileProof, err := profiles.CloseUnstartedObserved(cleanup)
+	if err != nil || profileProof.Validate(cleanup, profiles) != nil || !profileProof.tree.Complete() {
+		t.Fatal("profile tree rejected original cleanup bound", err)
+	}
+	if _, err := os.Stat(ownedRoot); !os.IsNotExist(err) {
+		t.Fatal("profile tree still present", err)
+	}
+}
+
+func TestSerenaPreparationRootsRejectLateAcquisition(t *testing.T) {
+	r := serenaAcquisitionRequest(t)
+	cleanup, cancel := context.WithDeadline(context.Background(), r.AbsoluteCleanupDeadline)
+	defer cancel()
+	key, err := r.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := &preparedSerenaAcquisition{inputs: SerenaPreparationInputs{Request: r}}
+	defer func() {
+		if err := a.closeOriginalRoots(); err != nil {
+			t.Error(err)
+		}
+	}()
+	if _, err := a.acquireRoots(cleanup, r, key); err == nil {
+		t.Fatal("cleanup context admitted new resources")
+	}
+	if a.generationAttempted || a.attemptAttempted || a.generation != nil || a.attempt != nil {
+		t.Fatal("refused acquisition changed original custody")
+	}
+	if _, err := os.Stat(filepath.Join(r.Namespace, key)); !os.IsNotExist(err) {
+		t.Fatal("refused acquisition created package roots", err)
+	}
+}

+func TestRustOwnerMemberErrorPresence(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		source, kind uint32
+		causes       int
+	}{
+		{"native-zero", 1, 1, 1}, {"token-native-zero", 2, 1, 1}, {"token-close-zero", 4, 0, 1}, {"nested-and-close-zero", 4, 1, 2},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err, valid := decodeRustOwnerMemberReport(rustOwnerMemberReport{Size: 24, Version: 1, Source: tc.source, Kind: tc.kind})
+			var native *rustOwnerMemberQueryError
+			if !valid || !errors.As(err, &native) || len(native.Unwrap()) != tc.causes {
+				t.Fatalf("zero-code presence lost: %v", err)
+			}
+		})
+	}
+	for _, raw := range []rustOwnerMemberReport{
+		{Size: 24, Version: 1, Source: 2}, {Size: 24, Version: 1, Source: 1, Kind: 2, NativeError: 5},
+		{Size: 24, Version: 1, Source: 2, Kind: 1, TokenCloseError: 6}, {Size: 24, Version: 1, Kind: 1},
+	} {
+		if err, valid := decodeRustOwnerMemberReport(raw); valid || !errors.Is(err, errRustOwnerMembers) {
+			t.Fatalf("invalid error report accepted: %+v %v", raw, err)
+		}
+	}
+}

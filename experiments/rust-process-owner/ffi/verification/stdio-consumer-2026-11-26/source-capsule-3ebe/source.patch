+func TestHTTPHostEndpointReleaseLatePendingCannotReplaceFinal(t *testing.T) {
+	f, start := newEndpointReleaseFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	f.closeScript = func(ctx context.Context, call int32) (*process.OriginalJobMemberCloseObservation, error) {
+		if call == 1 {
+			close(entered)
+			<-release
+			return nil, &process.OriginalMemberBorrowPendingError{Stage: "scripted-late-delivery"}
+		}
+		return f.closeMembers(ctx)
+	}
+	type result struct {
+		receipt *HTTPHostEndpointReleaseObservation
+		err     error
+	}
+	first, second := make(chan result, 1), make(chan result, 1)
+	firstReceived, secondStarted, secondReceived := false, false, false
+	defer func() {
+		// The delivery barrier and both callers finish before T.Cleanup
+		// touches the real member observation or original host, even on RED.
+		unblock()
+		if !firstReceived {
+			select {
+			case <-first:
+			case <-time.After(5 * time.Second):
+				t.Error("first receiver caller did not return during cleanup")
+			}
+		}
+		if secondStarted && !secondReceived {
+			select {
+			case <-second:
+			case <-time.After(5 * time.Second):
+				t.Error("second receiver caller did not return during cleanup")
+			}
+		}
+	}()
+	go func() {
+		receipt, err := f.host.ReleaseOriginalEndpointObserved(ctx)
+		first <- result{receipt, err}
+	}()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("first scripted receiver call did not enter")
+	}
+	secondStarted = true
+	go func() {
+		receipt, err := f.host.ReleaseOriginalEndpointObserved(ctx)
+		second <- result{receipt, err}
+	}()
+	var final result
+	select {
+	case final = <-second:
+		secondReceived = true
+	case <-ctx.Done():
+		t.Fatal("a delayed pending response prevented independent receiver progress")
+	}
+	if final.err != nil || final.receipt == nil || final.receipt.Validate(ctx, f.host, &start) != nil {
+		t.Fatalf("independent receiver did not publish genuine final facts: present=%t error=%v", final.receipt != nil, final.err)
+	}
+	unblock()
+	select {
+	case late := <-first:
+		firstReceived = true
+		if late.receipt != final.receipt || late.err != nil {
+			t.Fatalf("late pending replaced final receiver facts: same=%t error=%v", late.receipt == final.receipt, late.err)
+		}
+	case <-ctx.Done():
+		t.Fatal("late scripted receiver call did not return")
+	}
+	replayed, err := f.host.ReleaseOriginalEndpointObserved(ctx)
+	if replayed != final.receipt || err != nil || f.closeCalls.Load() != 2 {
+		t.Fatalf("receiver final publication was not monotonic: same=%t calls=%d error=%v", replayed == final.receipt, f.closeCalls.Load(), err)
+	}
+}

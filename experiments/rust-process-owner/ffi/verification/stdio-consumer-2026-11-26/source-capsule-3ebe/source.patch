+func TestRustOwnerIOABICancellationBeforeNativeEntry(t *testing.T) {
+	for _, stage := range []string{"pre-cancelled", "final-library-admission"} {
+		t.Run(stage, func(t *testing.T) {
+			library, probe := rustIOABIRejectingLibrary(nil)
+			pipes := rustIOABINewPipes(t)
+			directory := t.TempDir()
+			base, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			if stage == "pre-cancelled" {
+				cancel()
+				var retained *rustNativeOwner
+				owner, output, err := library.startRetainedRustOwnerIO(
+					base, filepath.Join(directory, "not-executed.exe"), directory, nil,
+					[]rustOwnerEnvironmentEntry{}, pipes.streams,
+					func(original *rustNativeOwner) error { retained = original; return nil },
+				)
+				if !errors.Is(err, context.Canceled) || probe.calls.Load() != 0 ||
+					owner != nil || retained != nil || output != (rustOwnerOutcome{}) {
+					t.Fatalf("pre-cancelled IO entered native: calls=%d output=%+v err=%v", probe.calls.Load(), output, err)
+				}
+				pipes.assertCopiesReleased(t)
+				rustIOABIAssertAbandoned(t, library, owner, retained)
+				return
+			}
+			ctx := &rustIOABIWaitingContext{Context: base, waiting: make(chan struct{})}
+			locked := make(chan struct{})
+			done := make(chan rustIOABICreateResult, 1)
+			go func() {
+				var result rustIOABICreateResult
+				result.owner, result.output, result.err = library.startRetainedRustOwnerIO(
+					ctx, filepath.Join(directory, "not-executed.exe"), directory, nil,
+					[]rustOwnerEnvironmentEntry{}, pipes.streams,
+					func(original *rustNativeOwner) error {
+						result.retained = original
+						library.mu.Lock()
+						close(locked)
+						return nil
+					},
+				)
+				done <- result
+			}()
+			select {
+			case <-locked:
+			case result := <-done:
+				select {
+				case <-locked:
+					library.mu.Unlock()
+				default:
+				}
+				t.Fatalf("start returned before controlled admission: %v", result.err)
+			case <-time.After(3 * time.Second):
+				cancel()
+				select {
+				case <-locked:
+					library.mu.Unlock()
+				case <-done:
+					select {
+					case <-locked:
+						library.mu.Unlock()
+					default:
+					}
+					t.Fatal("retention did not reach controlled admission")
+				case <-time.After(3 * time.Second):
+					t.Fatal("retention worker did not settle after cancellation")
+				}
+				select {
+				case <-done:
+				case <-time.After(3 * time.Second):
+					t.Fatal("start did not join after cleanup unlock")
+				}
+				t.Fatal("retention did not reach admission within the test bound")
+			}
+			var once sync.Once
+			unlock := func() { once.Do(library.mu.Unlock) }
+			defer unlock()
+			select {
+			case <-ctx.waiting:
+				// This is the final module-lock wait after environment and
+				// stdio preparation, not cancellation before acquisition.
+			case <-time.After(3 * time.Second):
+				cancel()
+				unlock()
+				select {
+				case <-done:
+				case <-time.After(3 * time.Second):
+					t.Fatal("start did not join after admission cleanup")
+				}
+				t.Fatal("start never entered context-aware module admission")
+			}
+			cancel()
+			var result rustIOABICreateResult
+			returned := false
+			select {
+			case result = <-done:
+				returned = true
+			case <-time.After(3 * time.Second):
+				t.Error("cancelled IO start waited for the contested library mutex")
+			}
+			unlock()
+			if !returned {
+				select {
+				case result = <-done:
+				case <-time.After(3 * time.Second):
+					t.Fatal("cancelled IO start did not join after unlock")
+				}
+			}
+			if !errors.Is(result.err, context.Canceled) || probe.calls.Load() != 0 ||
+				result.owner == nil || result.output != (rustOwnerOutcome{}) {
+				t.Fatalf("cancelled IO admission: calls=%d owner=%p output=%+v err=%v",
+					probe.calls.Load(), result.owner, result.output, result.err)
+			}
+			pipes.assertCopiesReleased(t)
+			rustIOABIAssertAbandoned(t, library, result.owner, result.retained)
+		})
+	}
+}
+
+func TestRustOwnerIOABIArgumentRefusalClosesTemporaryPipes(t *testing.T) {
+	pipes := rustIOABINewPipes(t)
+	var reservedDuringCall int64
+	var library *rustOwnerLibrary
+	library, probe := rustIOABIRejectingLibrary(func(_ *rustOwnerCreate, context *rustOwnerIOContext, _ *uintptr, _ *rustOwnerOutcome) string {
+		reservedDuringCall = library.activeOwners.Load()
+		for i, handle := range context.Streams {
+			flags, err := rustStdioTestHandleFlags(handle)
+			if handle == 0 || err != nil || flags&syscall.HANDLE_FLAG_INHERIT == 0 {
+				return fmt.Sprintf("temporary pipe slot %d was not acquired: %v", i, err)
+			}
+		}
+		return ""
+	})
+	directory := t.TempDir()
+	var retained *rustNativeOwner
+	owner, output, err := library.startRetainedRustOwnerIO(
+		rustStdioTestContext(t), filepath.Join(directory, "not-executed.exe"), directory, nil,
+		[]rustOwnerEnvironmentEntry{}, pipes.streams,
+		func(original *rustNativeOwner) error { retained = original; return nil },
+	)
+	if err == nil || errors.Is(err, errRustOwnerOutcome) ||
+		output != (rustOwnerOutcome{Size: 48, Version: 1}) || owner == nil ||
+		probe.calls.Load() != 1 || probe.failure != "" || reservedDuringCall != 1 {
+		t.Fatalf("argument refusal lost boundary facts: calls=%d reserved=%d failure=%q output=%+v err=%v",
+			probe.calls.Load(), reservedDuringCall, probe.failure, output, err)
+	}
+	// No temporary numeric handle is queried after return. Natural peer
+	// behavior proves release of all three copies while originals stay owned.
+	pipes.assertCopiesReleased(t)
+	rustIOABIAssertAbandoned(t, library, owner, retained)
+}
diff --git a/internal/process/rust_owner_io_fault_windows_test.go b/internal/process/rust_owner_io_fault_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5b77a0c278c0651c6dde48217242fe7138745e0b
--- /dev/null
+++ b/internal/process/rust_owner_io_fault_windows_test.go
@@ -0,0 +1,224 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+// These are controlled post-create faults around the actual qualified DLL.
+// The forwarding callback creates a real suspended child and returns its real
+// owner. Only the diagnostics, caller cancellation or temporary-close flags
+// are injected. All settlement calls still use the unmodified native exports.
+func TestRustOwnerIONativePostCreateErrorsRetainOriginalOwner(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		malformed bool
+		cancel    bool
+		closeFail bool
+	}{
+		{name: "malformed-outcome", malformed: true},
+		{name: "late-cancellation", cancel: true},
+		{name: "temporary-close-failure", closeFail: true},
+		{name: "all-three-errors", malformed: true, cancel: true, closeFail: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			f := newRustIONativeFixture(t)
+			pipes := f.pipes(t)
+			f.closeFile(t, pipes.input)
+			before := rustIONativeStreamFlags(t, pipes.streams)
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+
+			f.library.mu.Lock()
+			nativeCreate := f.library.procedures["mh_create_io1"]
+			f.library.mu.Unlock()
+			if nativeCreate == 0 {
+				t.Fatal("qualified IO export is absent")
+			}
+			const protectFromClose = 2
+			var protected [3]syscall.Handle
+			recovered := false
+			recoverProtected := func() {
+				if recovered {
+					return
+				}
+				recovered = true
+				for i, handle := range protected {
+					if handle == 0 {
+						continue
+					}
+					// Only exact successfully protected, still-live copies are
+					// eligible for fixture recovery. No consumed slot is retried.
+					ok, _, err := rustStdioTestSetFlags.Call(uintptr(handle), protectFromClose, 0)
+					if ok == 0 {
+						t.Errorf("fixture unprotect slot %d: %v", i, err)
+						continue
+					}
+					protected[i] = 0
+					if err := syscall.CloseHandle(handle); err != nil {
+						t.Errorf("fixture recovery close slot %d: %v", i, err)
+					}
+				}
+			}
+			// Registered after original-owner cleanup, so it runs first even
+			// when an assertion fails before explicit recovery below.
+			t.Cleanup(recoverProtected)
+
+			var callbackErr error
+			var nativeOut rustOwnerOutcome
+			var nativeSlot uintptr
+			var nativeStatus uintptr
+			calls := 0
+			forward := syscall.NewCallback(func(
+				request *rustOwnerCreate, requestSize uintptr,
+				ioContext *rustOwnerIOContext, ioSize uintptr,
+				slot *uintptr, output *rustOwnerOutcome, outputSize uintptr,
+			) uintptr {
+				calls++
+				growRustOwnerCallbackStack(64)
+				runtime.GC()
+				if request == nil || requestSize != 56 || ioContext == nil || ioSize != 40 ||
+					slot == nil || output == nil || outputSize != 48 {
+					callbackErr = errors.New("invalid forwarding fixture buffers")
+					return 1
+				}
+				status, _, _ := syscall.SyscallN(nativeCreate,
+					uintptr(unsafe.Pointer(request)), requestSize,
+					uintptr(unsafe.Pointer(ioContext)), ioSize,
+					uintptr(unsafe.Pointer(slot)), uintptr(unsafe.Pointer(output)), outputSize)
+				runtime.KeepAlive(request)
+				runtime.KeepAlive(ioContext)
+				runtime.KeepAlive(slot)
+				runtime.KeepAlive(output)
+				nativeStatus, nativeOut, nativeSlot = status, *output, *slot
+				if status != 0 || *slot == 0 {
+					return status
+				}
+				if test.closeFail {
+					for _, i := range []int{0, 2} {
+						handle := ioContext.Streams[i]
+						ok, _, err := rustStdioTestSetFlags.Call(handle, protectFromClose, protectFromClose)
+						if ok == 0 {
+							callbackErr = errors.Join(callbackErr, fmt.Errorf("fixture protect slot %d: %w", i, err))
+							continue
+						}
+						protected[i] = syscall.Handle(handle)
+					}
+				}
+				if test.malformed {
+					output.Version = 2
+				}
+				if test.cancel {
+					cancel()
+				}
+				return status
+			})
+			f.library.mu.Lock()
+			f.library.procedures["mh_create_io1"] = forward
+			f.library.mu.Unlock()
+			t.Cleanup(func() {
+				f.library.mu.Lock()
+				defer f.library.mu.Unlock()
+				if !f.library.closeAttempted && f.library.procedures != nil {
+					f.library.procedures["mh_create_io1"] = nativeCreate
+				}
+			})
+
+			retainCalls := 0
+			owner, out, err := f.library.startRetainedRustOwnerIO(ctx, f.child, f.cwd,
+				[]string{"stdio", f.marker}, []rustOwnerEnvironmentEntry{}, pipes.streams,
+				func(original *rustNativeOwner) error {
+					retainCalls++
+					f.owner = original
+					if original == nil || original.raw != 0 || !original.preparing.Load() {
+						return errors.New("retention did not precede real create")
+					}
+					if err := f.library.Close(); err == nil {
+						return errors.New("pre-create reservation allowed unload")
+					}
+					return nil
+				})
+			if callbackErr != nil || calls != 1 || retainCalls != 1 ||
+				nativeStatus != 0 || nativeSlot == 0 || nativeOut.PID == 0 {
+				t.Fatalf("real create fixture: calls=%d retained=%d status=%d raw=%#x native=%+v callback=%v start=%v",
+					calls, retainCalls, nativeStatus, nativeSlot, nativeOut, callbackErr, err)
+			}
+			if err == nil || owner == nil || owner != f.owner || owner.raw != nativeSlot ||
+				owner.preparing.Load() || f.library.activeOwners.Load() != 1 {
+				t.Fatalf("post-create error lost original custody: owner=%p retained=%p out=%+v err=%v",
+					owner, f.owner, out, err)
+			}
+			if errors.Is(err, errRustOwnerOutcome) != test.malformed ||
+				errors.Is(err, context.Canceled) != test.cancel {
+				t.Fatalf("post-create causes were changed: malformed=%t cancel=%t err=%v", test.malformed, test.cancel, err)
+			}
+			if test.malformed {
+				if out != (rustOwnerOutcome{}) || owner.originalPID != 0 {
+					t.Fatal("malformed create facts became authoritative")
+				}
+			} else if out != nativeOut || owner.originalPID != nativeOut.PID {
+				t.Fatal("valid native creation facts were lost on a separate error")
+			}
+			seen := rustIONativeTemporaryCloseFailures(err)
+			want := [3]bool{test.closeFail, false, test.closeFail}
+			if seen != want {
+				t.Fatalf("temporary native close failures: got=%v want=%v err=%v", seen, want, err)
+			}
+			if after := rustIONativeStreamFlags(t, pipes.streams); after != before {
+				t.Fatal("post-create failure changed caller handle flags")
+			}
+			identity, identityErr := owner.QueryIdentity()
+			if identityErr != nil || identity.PID != nativeOut.PID || identity.WaitState != 1 || identity.JobMembership != 1 {
+				t.Fatalf("retained real owner cannot identify its suspended child: %+v err=%v", identity, identityErr)
+			}
+			rustIONativeAbsent(t, f.marker)
+			if err := f.library.Close(); err == nil {
+				t.Fatal("post-create error allowed unload")
+			}
+			if err := owner.Release(); err == nil || owner.raw != nativeSlot {
+				t.Fatalf("post-create error authorized premature release: %v", err)
+			}
+
+			recoverProtected()
+			f.closeChildEnds(t, pipes)
+			if _, err := owner.Stop(91); err != nil {
+				t.Fatal(err)
+			}
+			cleanupCtx := rustIONativeContext(t) // independent of the cancelled admission
+			f.finish(t, cleanupCtx, 91)
+			rustIONativeAbsent(t, f.marker)
+			rustIONativeOutput(t, cleanupCtx, f.read(pipes.stdout), nil)
+			rustIONativeOutput(t, cleanupCtx, f.read(pipes.stderr), nil)
+			f.release(t)
+		})
+	}
+}
+
+func rustIONativeTemporaryCloseFailures(err error) (seen [3]bool) {
+	var visit func(error)
+	visit = func(err error) {
+		switch current := err.(type) {
+		case *rustOwnerStdioError:
+			if current.Operation == "close" && current.Stream >= 0 && current.Stream < len(seen) {
+				var native syscall.Errno
+				seen[current.Stream] = errors.As(current, &native) && native != 0
+			}
+		case interface{ Unwrap() []error }:
+			for _, cause := range current.Unwrap() {
+				visit(cause)
+			}
+		case interface{ Unwrap() error }:
+			visit(current.Unwrap())
+		}
+	}
+	visit(err)
+	return seen
+}
diff --git a/internal/process/rust_owner_io_native_windows_test.go b/internal/process/rust_owner_io_native_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..98a508bef6ff77aae9d5ee7b93bb9ff5d25406a1
--- /dev/null
+++ b/internal/process/rust_owner_io_native_windows_test.go
@@ -0,0 +1,657 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+	"unicode/utf16"
+	"unsafe"
+)
+
+var rustIONativeKernel = syscall.NewLazyDLL("kernel32.dll")
+
+type rustIONativeResult struct {
+	data []byte
+	n    int
+	err  error
+	eof  bool
+}
+
+type rustIONativeWork struct {
+	done   chan rustIONativeResult
+	result rustIONativeResult
+	joined bool
+}
+
+type rustIONativeFixture struct {
+	library *rustOwnerLibrary
+	owner   *rustNativeOwner
+	child   string
+	cwd     string
+	marker  string
+	files   []*os.File
+	closed  map[*os.File]bool
+	work    []*rustIONativeWork
+}
+
+type rustIONativePipes struct {
+	streams rustOwnerStdio
+	input   *os.File
+	stdout  *os.File
+	stderr  *os.File
+}
+
+// Only an explicit four-part tuple may start a native fixture. The Product is
+// an admitted library anchor; the matching Rust fixture is the actual child.
+func newRustIONativeFixture(t *testing.T) *rustIONativeFixture {
+	t.Helper()
+	names := [...]string{
+		"MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_COMMIT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_SHA256",
+		"MCPHUB_RUST_OWNER_MEMBER_CHILD",
+	}
+	var values [4]string
+	present := 0
+	for i, name := range names {
+		values[i] = os.Getenv(name)
+		if values[i] != "" {
+			present++
+		}
+	}
+	if present == 0 {
+		t.Skip("requires the complete qualified Product/DLL/child tuple")
+	}
+	if present != len(values) {
+		t.Fatal("incomplete Product/DLL/child integration tuple")
+	}
+	if !filepath.IsAbs(values[3]) {
+		t.Fatal("qualified child must have an absolute path")
+	}
+	if err := requireOrdinaryWindowsFile(values[3], "qualified IO child"); err != nil {
+		t.Fatal(err)
+	}
+
+	// Register directory cleanup first: retained native custody and owned I/O
+	// must settle before testing removes the fixture's working directory.
+	cwd := filepath.Join(t.TempDir(), "io space \u03a9")
+	if err := os.Mkdir(cwd, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	f := &rustIONativeFixture{
+		child: values[3], cwd: cwd, marker: filepath.Join(cwd, "io-root"),
+		closed: make(map[*os.File]bool),
+	}
+	var err error
+	f.library, err = openBundledRustOwnerLibrary(values[0], values[1], values[2])
+	t.Cleanup(func() { f.cleanup(t) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+
+// One cleanup deadline covers the same original owner and all test workers.
+// There is no PID reopen, process sweep, second Job or replacement owner.
+func (f *rustIONativeFixture) cleanup(t *testing.T) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if f.owner != nil && f.owner.raw != 0 {
+		if _, err := f.owner.Stop(97); err != nil {
+			t.Errorf("IO original Stop cleanup: %v", err)
+		}
+		if out, err := f.owner.FinishWithin(ctx); err != nil || out.State != 2 {
+			t.Errorf("IO original settlement cleanup: %+v err=%v", out, err)
+		}
+		if err := f.owner.Release(); err != nil {
+			t.Errorf("IO original Release cleanup: %v", err)
+		}
+	}
+	for i := len(f.files) - 1; i >= 0; i-- {
+		file := f.files[i]
+		if !f.closed[file] {
+			f.closed[file] = true
+			if err := file.Close(); err != nil {
+				t.Errorf("owned IO endpoint cleanup: %v", err)
+			}
+		}
+	}
+	for _, work := range f.work {
+		if !work.joined {
+			select {
+			case work.result = <-work.done:
+				work.joined = true
+			case <-ctx.Done():
+				t.Errorf("owned IO worker did not join after endpoint close: %v", ctx.Err())
+			}
+		}
+	}
+	if f.library != nil {
+		if err := f.library.Close(); err != nil {
+			t.Errorf("IO library cleanup: %v", err)
+		}
+	}
+}
+
+func (f *rustIONativeFixture) pipe(t *testing.T) (*os.File, *os.File) {
+	t.Helper()
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.files = append(f.files, r, w)
+	return r, w
+}
+
+func (f *rustIONativeFixture) pipes(t *testing.T) rustIONativePipes {
+	t.Helper()
+	inputR, inputW := f.pipe(t)
+	outputR, outputW := f.pipe(t)
+	errorR, errorW := f.pipe(t)
+	return rustIONativePipes{
+		streams: rustOwnerStdio{Stdin: inputR, Stdout: outputW, Stderr: errorW},
+		input:   inputW, stdout: outputR, stderr: errorR,
+	}
+}
+
+func (f *rustIONativeFixture) closeFile(t *testing.T, file *os.File) {
+	t.Helper()
+	if !f.closed[file] {
+		f.closed[file] = true
+		if err := file.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func (f *rustIONativeFixture) closeChildEnds(t *testing.T, pipes rustIONativePipes) {
+	t.Helper()
+	for _, file := range []*os.File{pipes.streams.Stdin, pipes.streams.Stdout, pipes.streams.Stderr} {
+		f.closeFile(t, file)
+	}
+}
+
+func (f *rustIONativeFixture) start(t *testing.T, mode string, environment []rustOwnerEnvironmentEntry, streams rustOwnerStdio, extra ...string) (rustOwnerOutcome, error) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	args := append([]string{mode, f.marker}, extra...)
+	returned, out, err := f.library.startRetainedRustOwnerIO(ctx, f.child, f.cwd, args, environment, streams,
+		func(owner *rustNativeOwner) error {
+			f.owner = owner
+			if owner == nil || owner.raw != 0 {
+				return errors.New("IO retention did not precede native creation")
+			}
+			if err := f.library.Close(); err == nil {
+				return errors.New("IO pre-create reservation allowed library unload")
+			}
+			return nil
+		})
+	if returned != f.owner {
+		t.Fatal("IO create returned a different retained owner")
+	}
+	if err == nil && (f.owner == nil || f.owner.raw == 0 || out.PID == 0) {
+		t.Fatal("IO create succeeded without native custody and original PID")
+	}
+	return out, err
+}
+
+func rustIONativeContext(t *testing.T) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	t.Cleanup(cancel)
+	return ctx
+}
+
+func (f *rustIONativeFixture) finish(t *testing.T, ctx context.Context, code uint32) {
+	t.Helper()
+	out, err := f.owner.FinishWithin(ctx)
+	if err != nil || out.State != 2 || out.Flags&1 == 0 || out.Active != 0 || out.RootExit != code {
+		t.Fatalf("IO native settlement: %+v err=%v want root=%d", out, err, code)
+	}
+	if f.owner.raw == 0 {
+		t.Fatal("native settlement unexpectedly released original allocation")
+	}
+	if err := f.library.Close(); err == nil {
+		t.Fatal("unreleased original owner allowed library unload")
+	}
+}
+
+func (f *rustIONativeFixture) release(t *testing.T) {
+	t.Helper()
+	if err := f.owner.Release(); err != nil || f.owner.raw != 0 {
+		t.Fatalf("IO original Release: raw=%#x err=%v", f.owner.raw, err)
+	}
+	if err := f.library.Close(); err != nil {
+		t.Fatalf("IO library unload after Release: %v", err)
+	}
+}
+
+func rustIONativeAbsent(t *testing.T, path string) {
+	t.Helper()
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("child executed before permission: marker err=%v", err)
+	}
+}
+
+func rustIONativeFlags(t *testing.T, file *os.File) uint32 {
+	t.Helper()
+	connection, err := file.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var flags uint32
+	var nativeErr error
+	err = connection.Control(func(handle uintptr) {
+		ok, _, callErr := rustIONativeKernel.NewProc("GetHandleInformation").Call(handle, uintptr(unsafe.Pointer(&flags)))
+		if ok == 0 {
+			nativeErr = callErr
+		}
+	})
+	if err != nil || nativeErr != nil {
+		t.Fatalf("caller handle flags: %v %v", err, nativeErr)
+	}
+	return flags
+}
+
+func rustIONativeStreamFlags(t *testing.T, streams rustOwnerStdio) [3]uint32 {
+	t.Helper()
+	return [3]uint32{
+		rustIONativeFlags(t, streams.Stdin),
+		rustIONativeFlags(t, streams.Stdout),
+		rustIONativeFlags(t, streams.Stderr),
+	}
+}
+
+// A successful zero-byte peek still observes a connected native pipe. Broken
+// pipe is an error here, so an unscheduled reader cannot fake "still pending".
+// Peek before starting a reader: synchronous handle operations may serialize.
+func rustIONativePipeBytes(t *testing.T, file *os.File) uint32 {
+	t.Helper()
+	connection, err := file.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var count uint32
+	var nativeErr error
+	err = connection.Control(func(handle uintptr) {
+		ok, _, callErr := rustIONativeKernel.NewProc("PeekNamedPipe").Call(handle, 0, 0, 0, uintptr(unsafe.Pointer(&count)), 0)
+		if ok == 0 {
+			nativeErr = callErr
+		}
+	})
+	if err != nil || nativeErr != nil {
+		t.Fatalf("owned native pipe observation: %v %v", err, nativeErr)
+	}
+	return count
+}
+
+func (f *rustIONativeFixture) begin(work func() rustIONativeResult) *rustIONativeWork {
+	task := &rustIONativeWork{done: make(chan rustIONativeResult, 1)}
+	f.work = append(f.work, task)
+	go func() { task.done <- work() }()
+	return task
+}
+
+func (f *rustIONativeFixture) read(file *os.File) *rustIONativeWork {
+	return f.begin(func() rustIONativeResult {
+		data, err := io.ReadAll(io.LimitReader(file, 4097))
+		result := rustIONativeResult{data: data, n: len(data), err: err}
+		if err != nil {
+			return result
+		}
+		if len(data) > 4096 {
+			result.err = errors.New("native fixture exceeded its bounded output")
+			return result
+		}
+		// A LimitReader boundary is not EOF. The original caller endpoint must
+		// still be open and independently report the natural end of stream.
+		var tail [1]byte
+		n, err := file.Read(tail[:])
+		result.eof = n == 0 && errors.Is(err, io.EOF)
+		if !result.eof {
+			result.err = fmt.Errorf("expected natural EOF, got n=%d err=%v", n, err)
+		}
+		return result
+	})
+}
+
+func (work *rustIONativeWork) await(t *testing.T, ctx context.Context) rustIONativeResult {
+	t.Helper()
+	if !work.joined {
+		select {
+		case work.result = <-work.done:
+			work.joined = true
+		case <-ctx.Done():
+			t.Fatalf("owned IO did not complete: %v", ctx.Err())
+		}
+	}
+	return work.result
+}
+
+func (work *rustIONativeWork) pending(t *testing.T) {
+	t.Helper()
+	select {
+	case work.result = <-work.done:
+		work.joined = true
+		t.Fatalf("expected pending IO, got n=%d eof=%t err=%v", work.result.n, work.result.eof, work.result.err)
+	default:
+	}
+}
+
+func rustIONativeOutput(t *testing.T, ctx context.Context, work *rustIONativeWork, want []byte) {
+	t.Helper()
+	got := work.await(t, ctx)
+	if got.err != nil || !got.eof || !bytes.Equal(got.data, want) {
+		t.Fatalf("native output: got=%x want=%x eof=%t err=%v", got.data, want, got.eof, got.err)
+	}
+}
+
+func (f *rustIONativeFixture) observerDeadline(t *testing.T) {
+	t.Helper()
+	original := f.owner.raw
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+	defer cancel()
+	out, err := f.owner.FinishWithin(ctx)
+	if !errors.Is(err, context.DeadlineExceeded) || out.State != 1 || f.owner.raw != original {
+		t.Fatalf("observer cancellation changed native custody: %+v err=%v", out, err)
+	}
+	if err := f.owner.Release(); err == nil || f.owner.raw != original {
+		t.Fatalf("pending observer permitted Release: %v", err)
+	}
+	if err := f.library.Close(); err == nil {
+		t.Fatal("pending observer lost its library pin")
+	}
+}
+
+func readRustIONativeContext(t *testing.T, path string, count int) []*string {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reader := bytes.NewReader(data)
+	fields := make([]*string, count)
+	for i := range fields {
+		var length uint32
+		if err := binary.Read(reader, binary.LittleEndian, &length); err != nil {
+			t.Fatalf("context field %d length: %v", i, err)
+		}
+		if length == ^uint32(0) {
+			continue
+		}
+		if length > 32768 {
+			t.Fatalf("context field %d exceeds fixture bound", i)
+		}
+		units := make([]uint16, int(length))
+		if err := binary.Read(reader, binary.LittleEndian, units); err != nil {
+			t.Fatalf("context field %d payload: %v", i, err)
+		}
+		value := string(utf16.Decode(units))
+		fields[i] = &value
+	}
+	if reader.Len() != 0 {
+		t.Fatal("context fixture returned trailing bytes")
+	}
+	return fields
+}

+// This remains a refusing callback, not a fake successful native owner. Unlike
+// the original v1 helper it demands an explicit first argument in request v2.
+func rustArgv0ABIRejectingLibrary(check func(*rustOwnerCreate, *rustOwnerIOContext, *uintptr, *rustOwnerOutcome) string) (*rustOwnerLibrary, *rustIOABIProbe) {
+	probe := &rustIOABIProbe{}
+	address := syscall.NewCallback(func(
+		request *rustOwnerCreate, requestBytes uintptr,
+		context *rustOwnerIOContext, contextBytes uintptr,
+		slot *uintptr, output *rustOwnerOutcome, outputBytes uintptr,
+	) uintptr {
+		probe.calls.Add(1)
+		if output == nil || outputBytes != 48 || slot == nil {
+			probe.failure = "invalid output bounds"
+			return 1
+		}
+		*output = rustOwnerOutcome{Size: 48, Version: 1}
+		if *slot != 0 || request == nil || requestBytes != 56 || request.Version != 2 ||
+			request.Reserved != 0 || request.Argc == 0 || request.Argc > 65 ||
+			context == nil || contextBytes != 40 {
+			probe.failure = "invalid v2 create or IO layout"
+			return 1
+		}
+		if check != nil {
+			probe.failure = check(request, context, slot, output)
+		}
+		return 1 // MH_ARGUMENT, no owner and no process creation.
+	})
+	return &rustOwnerLibrary{
+		ready: true, procedures: map[string]uintptr{"mh_create_io1": address},
+	}, probe
+}

+func TestRustOwnerFinishReportsNativeCleanupFailureWithoutLosingRoot(t *testing.T) {
+	calls := 0
+	closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		calls++
+		if raw != 0x1234 || out == nil || size != 48 {
+			return 1
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 3,
+			PID: 42, Flags: 1, RootExit: 7, CleanupMask: 4, CleanupCodes: [3]int32{0, 0, 5}}
+		return 0

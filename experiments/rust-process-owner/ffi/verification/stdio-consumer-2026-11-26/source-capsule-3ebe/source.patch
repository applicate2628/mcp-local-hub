+//go:build windows && amd64
+
+package process
+
+import (
+	"errors"
+	"testing"
+)
+
+// This enters the real admitted DLL through the Product ownership factory.
+// The existing explicit tuple supplies its qualified loader result; selecting
+// the marked executable and all six host files is a separate daemon test.
+func TestRustOwnerProductNativeOwnedModuleLifetime(t *testing.T) {
+	f := newRustFacadeNativeFixture(t)
+	pipes := f.pipes(t)
+	f.closeFile(t, pipes.input)
+	ctx := rustIONativeContext(t)
+	cmd := rustFacadeNativeCommand(f, "stdio")
+	var retained *AtCreateJobProcess
+	retains, opens := 0, 0
+	p, err := startProductRustOriginal(ctx, cmd, pipes.streams.Stdin, pipes.streams.Stdout, pipes.streams.Stderr,
+		func(p *AtCreateJobProcess) error {
+			retained, retains = p, retains+1
+			child, ok := p.child.(*rustContainedChild)
+			if !ok || !child.ownsLibrary || child.library != f.library {
+				return errors.New("Product receiver did not own its admitted module")
+			}
+			return rustFacadeNativeRetain(t, f, p.child)
+		}, func() (*rustOwnerLibrary, error) {
+			opens++
+			return f.library, nil
+		})
+	if err != nil || p == nil || p != retained || !p.Created() || retains != 1 || opens != 1 {
+		t.Fatalf("Product original start: p=%p retained=%p err=%v retains=%d opens=%d",
+			p, retained, err, retains, opens)
+	}
+	f.closeChildEnds(t, pipes)
+	if f.owner == nil || f.owner.raw == 0 || f.library.activeOwners.Load() != 1 {
+		t.Fatal("Product start lost its transferred native owner")
+	}
+	if err := f.library.Close(); err == nil || f.library.closeAttempted || f.library.handle == 0 {
+		t.Fatal("live original owner allowed module unload")
+	}
+	root := rustFacadeNativeWaitOriginal(t, f, ctx, p)
+	if !root.Known || root.ExitCode != 0 || root.Error != nil {
+		t.Fatalf("Product original root wait: %+v", root)
+	}
+	view, err := p.ObserveOriginal(ctx, true)
+	if err != nil || !view.OriginalJobExited || view.HandlesClosed || f.library.closeAttempted || f.owner.raw == 0 {
+		t.Fatalf("Product observation closed its retained module/native owner: view=%+v err=%v", view, err)
+	}
+	for i := 0; i < 2; i++ {
+		settlement, err := p.ReleaseOriginal()
+		if err != nil || settlement == nil || !settlement.Complete() || !p.Created() ||
+			f.owner.raw != 0 || f.library.activeOwners.Load() != 0 ||
+			!f.library.closeAttempted || f.library.ready || f.library.handle != 0 {
+			t.Fatalf("Product release %d: settlement=%v err=%v raw=%x owners=%d moduleClosed=%t ready=%t handle=%x",
+				i, settlement, err, f.owner.raw, f.library.activeOwners.Load(),
+				f.library.closeAttempted, f.library.ready, f.library.handle)
+		}
+	}
+	if cmd.Process != nil || cmd.ProcessState != nil {
+		t.Fatal("Product original fabricated Go process state")
+	}
+	// File ownership survives native owner release and module unload.
+	rustIONativeOutput(t, ctx, f.read(pipes.stdout), nil)
+	rustIONativeOutput(t, ctx, f.read(pipes.stderr), []byte("native-stderr\x00\xff"))
+}

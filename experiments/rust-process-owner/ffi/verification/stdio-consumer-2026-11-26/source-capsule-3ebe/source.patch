+func TestStdioRustOriginalDelayedReaderKeepsFirstPendingReceipt(t *testing.T) {
+	// This fixture intentionally keeps one incomplete host receipt. Its cleanup
+	// joins late workers without treating recovery as a new successful attempt.
+	exe := stdioRustOriginalExecutable(t)
+	root := t.TempDir()
+	h, err := NewStdioHost(HostConfig{
+		Command: exe, Args: []string{"-test.run=^TestStdioOriginalHelper$"},
+		WorkingDir: root,
+		Env:        map[string]string{stdioOriginalHelperMode: "echo", stdioOriginalHelperRoot: root},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	readerEntered, readerRelease := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	releaseReader := func() { releaseOnce.Do(func() { close(readerRelease) }) }
+	type nativeObservation struct {
+		view     process.ContainedNativeSnapshot
+		root     process.OriginalRootWait
+		deadline time.Time
+		err      error
+	}
+	type stopResult struct {
+		view StdioHostSettlement
+		err  error
+	}
+	nativeObserved := make(chan nativeObservation, 1)
+	stopReturned := make(chan stopResult, 1)
+	var observationCalls atomic.Int32
+	stopLaunched, stopJoined, expectedPending := false, false, false
+	var first StdioHostSettlement
+	joinWorkers := func(ctx context.Context) {
+		if h.original == nil {
+			return
+		}
+		for _, done := range []<-chan struct{}{
+			h.original.rootDone, h.original.stdoutDone, h.original.stderrDone,
+			h.original.watcherDone, h.original.lifetimeDone, h.original.stopDone,
+			h.ChildExited(),
+		} {
+			if err := originalJoin(ctx, done); err != nil {
+				t.Errorf("late fixture worker was not received: %v", err)
+			}
+		}
+		if h.original.input != nil {
+			if err := originalJoin(ctx, h.original.input.joined); err != nil {
+				t.Errorf("late fixture writer was not received: %v", err)
+			}
+		}
+	}
+	t.Cleanup(func() {
+		releaseReader()
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if stopLaunched && !stopJoined {
+			select {
+			case <-stopReturned:
+				stopJoined = true
+			case <-ctx.Done():
+				t.Errorf("fixture stop receiver did not join: %v", ctx.Err())
+			}
+		}
+		if h.original == nil {
+			return
+		}
+		result, err := h.StopObserved(ctx)
+		joinWorkers(ctx)
+		if expectedPending {
+			if !result.Pending || result.ReadersJoined || result.Complete() ||
+				!result.NativeSettlement.Complete() || !result.Deadline.Equal(first.Deadline) ||
+				!errors.Is(err, context.DeadlineExceeded) {
+				t.Errorf("fixture recovery changed the first incomplete receipt: %+v err=%v", result, err)
+			}
+		} else if err != nil || !result.Complete() {
+			t.Errorf("native fixture failure cleanup: %+v err=%v", result, err)
+		}
+	})
+	h.originalLaunch = &stdioOriginalLaunchOps{
+		beforeStdout: func() { close(readerEntered); <-readerRelease },
+		observeOriginal: func(original *process.AtCreateJobProcess, ctx context.Context, natural bool) (process.ContainedNativeSnapshot, error) {
+			view, err := original.ObserveOriginal(ctx, natural)
+			rootErr := originalJoin(ctx, h.original.rootDone)
+			var rootWait process.OriginalRootWait
+			if rootErr == nil {
+				rootWait = h.original.root
+			}
+			deadline, _ := ctx.Deadline()
+			err = errors.Join(err, rootErr, ctx.Err())
+			if observationCalls.Add(1) == 1 {
+				nativeObserved <- nativeObservation{view: view, root: rootWait, deadline: deadline, err: err}
+			}
+			return view, err
+		},
+	}
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	stdioRustOriginalWait(t, "delayed stdout entry", readerEntered)
+	originalTestBarrier(t, filepath.Join(root, "root-ready"))
+	owner := stdioRustOriginalOwner(t, h)
+	// This receiver's longer bound does not shorten the host's normal two-second
+	// cleanup budget. Native Job exit and the root waiter are received first.
+	receiver, cancelReceiver := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancelReceiver()
+	stopLaunched = true
+	go func() {
+		result, err := h.StopObserved(receiver)
+		stopReturned <- stopResult{view: result, err: err}
+	}()
+	var observed nativeObservation
+	select {
+	case observed = <-nativeObserved:
+	case <-receiver.Done():
+		t.Fatalf("real native observation was not received: %v", receiver.Err())
+	}
+	if observed.err != nil || !observed.view.OriginalJobExited || !observed.view.RootWaitKnown ||
+		!observed.root.Known || observed.root.Error != nil || observed.deadline.IsZero() {
+		t.Fatalf("reader timeout was not isolated from real native exit: %+v", observed)
+	}
+	stdioRustOriginalOpen(t, "deliberately held stdout reader", owner.lifecycle.stdoutDone)
+	var received stopResult
+	select {
+	case received = <-stopReturned:
+		stopJoined = true
+	case <-receiver.Done():
+		t.Fatalf("first host cleanup attempt was not received: %v", receiver.Err())
+	}
+	stdioRustOriginalWait(t, "first bounded cleanup completion", owner.lifecycle.stopDone)
+	first = received.view
+	native := first.NativeSettlement.Snapshot()
+	if !errors.Is(received.err, context.DeadlineExceeded) || !first.Pending || first.Complete() ||
+		first.ReadersJoined || !first.NativeSettlement.Complete() || !native.HandlesClosed ||
+		!first.RootWait.Known || first.OriginalIdentity != owner.identity ||
+		!first.Deadline.Equal(observed.deadline) || observationCalls.Load() != 1 {
+		t.Fatalf("held reader did not produce an honest first receipt: %+v native=%+v err=%v calls=%d",
+			first, native, received.err, observationCalls.Load())
+	}
+	expectedPending = true
+	// Only now release and join the reader. No test-side native ReleaseOriginal
+	// supplies the close that must already be present in the host's receipt.
+	releaseReader()
+	cleanup, cancelCleanup := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancelCleanup()
+	joinWorkers(cleanup)
+	again, againErr := h.StopObserved(cleanup)
+	if !errors.Is(againErr, context.DeadlineExceeded) || !again.Pending || again.Complete() || again.ReadersJoined ||
+		!again.Deadline.Equal(first.Deadline) || again.NativeSettlement != first.NativeSettlement ||
+		again.RootWait != first.RootWait || again.OriginalIdentity != first.OriginalIdentity ||
+		h.original != owner.lifecycle || h.original.original != owner.original || observationCalls.Load() != 1 {
+		t.Fatalf("late reader completion renewed or upgraded the first receipt: first=%+v again=%+v err=%v", first, again, againErr)
+	}
+	stdioRustOriginalFilesClosed(t, h)
+}
diff --git a/internal/daemon/host_rust_original_environment_windows_test.go b/internal/daemon/host_rust_original_environment_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fef2bde035c3e69f08f8d4dff9fc7f73ec1a0db0
--- /dev/null
+++ b/internal/daemon/host_rust_original_environment_windows_test.go
@@ -0,0 +1,127 @@
+//go:build windows && amd64
+
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"syscall"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+const stdioDriveProbeKey = "MCPHUB_STDIO_DRIVE_PROBE_KEY"
+
+type stdioDriveContextReport struct {
+	Directory string
+	Value     string
+	Resolved  string
+}
+
+// This separate helper is selected only by its parent. It observes a single
+// explicitly supplied fixture key, never dumps the inherited environment, and
+// writes its report only in the parent-owned directory on D:.
+func TestStdioOriginalDriveEnvironmentHelper(t *testing.T) {
+	key := os.Getenv(stdioDriveProbeKey)
+	if key == "" {
+		return
+	}
+	root := os.Getenv(stdioOriginalHelperRoot)
+	if root == "" || len(key) != 3 || key[0] != '=' || key[2] != ':' {
+		t.Fatal("drive environment fixture inputs missing")
+	}
+	name, err := syscall.UTF16PtrFromString(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value := make([]uint16, 32768)
+	n, err := windows.GetEnvironmentVariable(name, &value[0], uint32(len(value)))
+	if err != nil || n == 0 || n >= uint32(len(value)) {
+		t.Fatalf("explicit native drive environment was not received: length=%d err=%v", n, err)
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	// FullPath calls Windows GetFullPathNameW. It resolves this drive-relative
+	// name without opening or writing a file on that drive.
+	resolved, err := syscall.FullPath(key[1:] + "mcphub-owned-drive-probe.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	report, err := json.Marshal(stdioDriveContextReport{
+		Directory: cwd,
+		Value:     syscall.UTF16ToString(value[:n]),
+		Resolved:  resolved,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "drive-context.json"), report, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestStdioRustOriginalPreservesCapturedDriveContext(t *testing.T) {
+	h, root := newStdioRustOriginalHost(t, "drive-context")
+	captured, err := CaptureStdioLaunchContext(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The fixture chooses a real directory on another drive; no file is
+	// created there. A single child cwd cannot supply this drive's context.
+	driveDirectory := filepath.Join(os.Getenv("SystemRoot"), "System32")
+	volume := filepath.VolumeName(driveDirectory)
+	if !filepath.IsAbs(driveDirectory) || len(volume) != 2 || volume[1] != ':' ||
+		strings.EqualFold(volume, filepath.VolumeName(root)) {
+		t.Fatal("qualification requires an existing system directory on a different drive")
+	}
+	info, err := os.Stat(driveDirectory)
+	if err != nil || !info.IsDir() {
+		t.Fatalf("read-only drive fixture directory unavailable: %v", err)
+	}
+	key := "=" + strings.ToUpper(volume)
+	// Supply controlled duplicate spellings in the captured context, without
+	// changing process-wide hidden variables. Both directories exist; the
+	// earlier lowercase spelling must lose to the final uppercase spelling.
+	captured.environment = append(captured.environment,
+		strings.ToLower(key)+"="+filepath.Dir(driveDirectory), key+"="+driveDirectory)
+	capturedBefore := append([]string(nil), captured.environment...)
+	ambientBefore := os.Environ()
+	h.launchContext = captured
+	h.cfg.Args = []string{"-test.run=^TestStdioOriginalDriveEnvironmentHelper$"}
+	h.cfg.Env[stdioDriveProbeKey] = key
+
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	owner := stdioRustOriginalOwner(t, h)
+	stdioRustOriginalWait(t, "drive context child exit", h.ChildExited())
+	result := stdioRustOriginalComplete(t, h, owner)
+	if result.RootWait.ExitCode != 0 || result.RootWait.Error != nil {
+		t.Fatalf("drive context helper failed: %+v", result.RootWait)
+	}
+	data, err := os.ReadFile(filepath.Join(root, "drive-context.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var report stdioDriveContextReport
+	if err := json.Unmarshal(data, &report); err != nil {
+		t.Fatal(err)
+	}
+	if report.Directory != root || report.Value != driveDirectory ||
+		report.Resolved != filepath.Join(driveDirectory, "mcphub-owned-drive-probe.txt") {
+		t.Fatalf("captured drive context changed across the actual native launch: %+v", report)
+	}
+	if !slices.Equal(captured.environment, capturedBefore) || !slices.Equal(os.Environ(), ambientBefore) {
+		t.Fatal("native host launch mutated the captured or ambient environment")
+	}
+	if value, ok := captured.LookupEnvironment(key); !ok || value != driveDirectory {
+		t.Fatal("captured source no longer describes the executed drive context")
+	}
+}
diff --git a/internal/daemon/host_rust_original_preparation_windows_test.go b/internal/daemon/host_rust_original_preparation_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ec831fff40c40e46f3f2c5df21eaddb5eac65036
--- /dev/null
+++ b/internal/daemon/host_rust_original_preparation_windows_test.go
@@ -0,0 +1,94 @@
+//go:build windows && amd64
+
+package daemon
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"mcp-local-hub/internal/process"
+)
+
+func TestStdioRustOriginalPreparationUsesCapturedContext(t *testing.T) {
+	exe := stdioRustOriginalExecutable(t)
+	const inheritedName = "MCPHUB_RUST_HOST_CAPTURED_VALUE"
+	const overrideName = "MCPHUB_RUST_HOST_CONFIG_VALUE"
+	t.Setenv("PATH", filepath.Dir(exe))
+	t.Setenv(inheritedName, "captured")
+	lifetime, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	launch, err := CaptureStdioLaunchContext(lifetime)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := launch.NewStdioHost(HostConfig{
+		Command: filepath.Base(exe),
+		Args:    []string{"first argument", "second"},
+		Env:     map[string]string{overrideName: "configured"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The command must use the same captured lookup and environment source
+	// even when the ambient parent changes before this ordinary Start.
+	t.Setenv("PATH", t.TempDir())
+	t.Setenv(inheritedName, "changed-after-capture")
+	failure := errors.New("injected refusal before Rust retention")
+	var received *exec.Cmd
+	var admission context.Context
+	jobCalls := 0
+	h.originalLaunch = &stdioOriginalLaunchOps{
+		job: func(process.JobOptions) (*process.Job, error) {
+			jobCalls++
+			return nil, errors.New("Rust preparation entered the Go Job factory")
+		},
+		startRust: func(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+			retain func(*process.AtCreateJobProcess) error) (*process.AtCreateJobProcess, error) {
+			admission, received = ctx, cmd
+			return nil, failure
+		},
+	}
+	if err := h.Start(lifetime); !errors.Is(err, failure) {
+		t.Fatalf("ordinary Rust preparation lost the injected pre-retention refusal: %v", err)
+	}
+	if received == nil || jobCalls != 0 {
+		t.Fatalf("ordinary marked preparation did not reach its original Rust creator: received=%t Go Job calls=%d",
+			received != nil, jobCalls)
+	}
+	if received.Path != exe || !filepath.IsAbs(received.Dir) || received.Dir != launch.WorkingDirectory() ||
+		len(received.Args) != 3 || received.Args[0] != exe || received.Args[1] != "first argument" || received.Args[2] != "second" {
+		t.Fatal("ordinary Rust command lost captured image, cwd, argv zero or arguments")
+	}
+	value := func(name string) (string, bool) {
+		for i := len(received.Env) - 1; i >= 0; i-- {
+			key, value, ok := strings.Cut(received.Env[i], "=")
+			if ok && strings.EqualFold(key, name) {
+				return value, true
+			}
+		}
+		return "", false
+	}
+	if actual, ok := value(inheritedName); !ok || actual != "captured" {
+		t.Fatal("ordinary Rust preparation resampled the parent environment")
+	}
+	if actual, ok := value(overrideName); !ok || actual != "configured" {
+		t.Fatal("ordinary Rust preparation lost the host environment override")
+	}
+	if admission == nil {
+		t.Fatal("ordinary Rust creator received no admission context")
+	}
+	if _, finite := admission.Deadline(); !finite || !errors.Is(admission.Err(), context.Canceled) || lifetime.Err() != nil {
+		t.Fatal("Rust creation admission was not finite and canceled independently from the service lifetime")
+	}
+	result, err := h.StopObserved(context.Background())
+	if err != nil || !result.Complete() || !result.NoNativeAttempt || !errors.Is(result.PrimaryError, failure) ||
+		h.original == nil || h.original.original != nil || h.original.nativeAttempted || h.original.job != nil {
+		t.Fatalf("pre-retention command preparation lost the original no-child receipt: %+v err=%v", result, err)
+	}
+	stdioRustOriginalFilesClosed(t, h)
+}
diff --git a/internal/daemon/host_rust_original_windows_test.go b/internal/daemon/host_rust_original_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..32837e9a94b987f83281ea9e7004e5b63bf04cdc
--- /dev/null
+++ b/internal/daemon/host_rust_original_windows_test.go
@@ -0,0 +1,462 @@
+//go:build windows && amd64
+
+package daemon
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"mcp-local-hub/internal/buildinfo"
+	"mcp-local-hub/internal/process"
+)
+
+// The environment tuple gates qualification; it never selects a loader.
+// These tests use the normal host constructor and production startup path.
+// The runner supplies a marked mcphub.exe test executable and its admitted
+// adjacent DLL/receipt. This is receiving-path evidence, not a product release.
+func stdioRustOriginalExecutable(t *testing.T) string {
+	t.Helper()
+	names := [...]string{
+		"MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_COMMIT",
+		"MCPHUB_RUST_OWNER_INTEGRATION_SHA256",
+		"MCPHUB_RUST_OWNER_MEMBER_CHILD",
+	}
+	var values [4]string
+	present := 0
+	for i, name := range names {
+		values[i] = os.Getenv(name)
+		if values[i] != "" {
+			present++
+		}
+	}
+	if present == 0 {
+		t.Skip("requires the qualified native tuple and marked mcphub.exe test layout")
+	}
+	if present != len(values) {
+		t.Fatal("incomplete native host qualification tuple")
+	}
+	for _, i := range []int{0, 3} {
+		if !filepath.IsAbs(values[i]) {
+			t.Fatalf("%s must name an absolute qualified file", names[i])
+		}
+		info, err := os.Lstat(values[i])
+		if err != nil || !info.Mode().IsRegular() {
+			t.Fatalf("%s is not an ordinary qualified file: %v", names[i], err)
+		}
+	}
+	hash, err := buildinfo.CurrentRustOwnerSHA256()
+	if err != nil || hash != values[2] {
+		t.Fatalf("test executable lacks the expected embedded Rust hash: %v", err)
+	}
+	_, commit, _ := buildinfo.Get()
+	if commit != values[1] {
+		t.Fatal("test executable commit differs from the qualification tuple")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !filepath.IsAbs(exe) || filepath.Base(exe) != "mcphub.exe" {
+		t.Fatal("native host qualification requires the marked mcphub.exe test executable")
+	}
+	libraryPath := filepath.Join(filepath.Dir(exe), "mcphub-owner.dll")
+	library, err := os.ReadFile(libraryPath)
+	if err != nil {
+		t.Fatalf("read adjacent native library: %v", err)
+	}
+	if actual := fmt.Sprintf("%x", sha256.Sum256(library)); actual != hash {
+		t.Fatal("adjacent native library differs from the executable's embedded hash")
+	}
+	data, err := os.ReadFile(filepath.Join(filepath.Dir(exe), "mcphub-owner-identity.json"))
+	if err != nil {
+		t.Fatalf("read adjacent native identity: %v", err)
+	}
+	var receipt struct {
+		SourceCommit string `json:"sourceCommit"`
+		SHA256       string `json:"sha256"`
+	}
+	if err := json.Unmarshal(data, &receipt); err != nil {
+		t.Fatalf("decode adjacent native identity: %v", err)
+	}
+	if receipt.SourceCommit != commit || receipt.SHA256 != hash {
+		t.Fatal("adjacent native identity differs from the executable's embedded operands")
+	}
+	return exe
+}
+
+func newStdioRustOriginalHost(t *testing.T, mode string) (*StdioHost, string) {
+	t.Helper()
+	exe := stdioRustOriginalExecutable(t)
+	root := t.TempDir()
+	h, err := NewStdioHost(HostConfig{
+		Command: exe, Args: []string{"-test.run=^TestStdioOriginalHelper$"},
+		WorkingDir: root,
+		Env:        map[string]string{stdioOriginalHelperMode: mode, stdioOriginalHelperRoot: root},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// This cleanup uses the same retained host. Barrier cleanups registered by
+	// individual tests run first, so a failed assertion cannot strand a worker.
+	t.Cleanup(func() {
+		h.mu.Lock()
+		retained := h.original != nil
+		h.mu.Unlock()
+		if !retained {
+			return
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		result, err := h.StopObserved(ctx)
+		if err != nil || !result.Complete() {
+			t.Errorf("native host fixture settlement: %+v err=%v", result, err)
+		}
+	})
+	return h, root
+}
+
+type stdioRustOriginalRetention struct {
+	lifecycle *stdioOriginalLifecycle
+	original  *process.AtCreateJobProcess
+	identity  process.ContainedRootIdentity
+}
+
+func stdioRustOriginalOwner(t *testing.T, h *StdioHost) stdioRustOriginalRetention {
+	t.Helper()
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	p := h.original
+	if p == nil || p.original == nil || !p.original.Created() {
+		t.Fatal("normal host startup did not retain a created original facade")
+	}
+	// The pre-integration host opens p.job. These assertions deliberately
+	// distinguish the actual Rust path from a passing legacy host scenario.
+	if p.job != nil || h.job != nil {
+		t.Fatal("marked host startup still acquired a Go Job owner")
+	}
+	if h.cmd == nil || h.cmd.Process != nil || h.cmd.ProcessState != nil || h.ExitState() != nil {
+		t.Fatal("native host fabricated Go process or process-state ownership")
+	}
+	if !p.identity.Known || p.identity.PID <= 0 || p.identity.NativeBirthFILETIME == 0 {
+		t.Fatal("native host lacks the original creation identity")
+	}
+	return stdioRustOriginalRetention{lifecycle: p, original: p.original, identity: p.identity}
+}
+
+func stdioRustOriginalWait(t *testing.T, name string, done <-chan struct{}) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	if err := originalJoin(ctx, done); err != nil {
+		t.Fatalf("%s was not received: %v", name, err)
+	}
+}
+
+func stdioRustOriginalOpen(t *testing.T, name string, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+		t.Fatalf("%s completed before the controlled boundary", name)
+	default:
+	}
+}
+
+func stdioRustOriginalRPC(t *testing.T, h *StdioHost, clientID string) {
+	t.Helper()
+	body, err := json.Marshal(map[string]any{
+		"jsonrpc": "2.0", "id": clientID, "method": "test",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	request := httptest.NewRequestWithContext(ctx, http.MethodPost,
+		"http://127.0.0.1/mcp", strings.NewReader(string(body)))
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Mcp-Session-Id", acquireSessionID(t, h))
+	response := httptest.NewRecorder()
+	h.HTTPHandler().ServeHTTP(response, request)
+	if response.Code != http.StatusOK {
+		t.Fatalf("native host HTTP reply: status=%d body=%s", response.Code, response.Body.String())
+	}
+	var reply struct {
+		JSONRPC string `json:"jsonrpc"`
+		ID      string `json:"id"`
+		Result  struct {
+			Value string `json:"value"`
+		} `json:"result"`
+		Error json.RawMessage `json:"error"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &reply); err != nil {
+		t.Fatalf("native host returned invalid JSON: %v", err)
+	}
+	if reply.JSONRPC != "2.0" || reply.ID != clientID || reply.Result.Value != "received" || len(reply.Error) != 0 {
+		t.Fatalf("native host lost the exact reply or original string ID: %s", response.Body.String())
+	}
+}
+
+func stdioRustOriginalComplete(t *testing.T, h *StdioHost, owner stdioRustOriginalRetention) StdioHostSettlement {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	result, err := h.StopObserved(ctx)
+	if err != nil || !result.Complete() || result.NoNativeAttempt || result.NativeSettlement == nil ||
+		!result.RootWait.Known || result.OriginalIdentity != owner.identity {
+		t.Fatalf("native host did not receive complete original settlement: %+v err=%v", result, err)
+	}
+	if h.original != owner.lifecycle || h.original.original != owner.original || h.ExitState() != nil {
+		t.Fatal("terminal receiving replaced original custody or fabricated ProcessState")
+	}
+	for _, done := range []<-chan struct{}{
+		owner.lifecycle.rootDone, owner.lifecycle.stdoutDone, owner.lifecycle.stderrDone,
+		owner.lifecycle.watcherDone, owner.lifecycle.lifetimeDone, owner.lifecycle.stopDone,
+		owner.lifecycle.input.joined, h.ChildExited(),
+	} {
+		select {
+		case <-done:
+		default:
+			t.Fatal("complete native receipt preceded an owned worker's completion")
+		}
+	}
+	return result
+}
+
+func TestStdioRustOriginalFinalHTTPReplyAndDrain(t *testing.T) {
+	h, root := newStdioRustOriginalHost(t, "final")
+	if err := h.Start(context.Background()); err != nil {
+		t.Fatal(err)

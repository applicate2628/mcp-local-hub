+func TestHTTPHostEndpointReleasePreservesPublishedStartOnStartedFailure(t *testing.T) {
+	root := t.TempDir()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	f := prepareEndpointReleaseFixture(t, ctx, root)
+	rejected := errors.New("synthetic Started rejection after original publication")
+	f.startedError = rejected
+	returned, err := f.host.StartObserved(ctx)
+	published := f.startedReceipt
+	if !errors.Is(err, rejected) || !published.OriginalCreated() || f.members == nil {
+		t.Fatalf("fixture did not reach the intended post-publication failure: created=%t members=%t error=%v",
+			published.OriginalCreated(), f.members != nil, err)
+	}
+	if returned.OriginalStart != published.OriginalStart {
+		t.Fatal("StartObserved replaced the OriginalStart already published to Started")
+	}
+	closeCtx, cancelClose := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancelClose()
+	final, closeErr := f.host.ReleaseOriginalEndpointObserved(closeCtx)
+	if closeErr != nil || final == nil || !final.Snapshot().Complete ||
+		final.Validate(closeCtx, f.host, &published) != nil {
+		t.Fatalf("final endpoint release did not retain the published start binding: present=%t error=%v", final != nil, closeErr)
+	}
+}

+// Only the fresh actor changes its immediate Job. The external V2 controller
+// owns that actor from native creation; V1 retains the original strict case Job.
+func runWindowsCanonicalNativeActorCase(t *testing.T) bool {
+	t.Helper()
+	name := t.Name()
+	if _, err := canonicalnativefixture.Slot(name); err != nil {
+		t.Fatal(err)
+	}
+	if retainedCanonicalNativeCase.Load() != nil {
+		stopCanonicalNativeCase(nil, errors.New("previous canonical native case retains incomplete original custody"))
+		return true
+	}
+	if path, present := os.LookupEnv(canonicalNativeCaseEnv); present {
+		receiveCanonicalNativeCase(t, path)
+		return false
+	}
+	if path, present := os.LookupEnv(canonicalnativefixture.ChannelEnv); present {
+		// Only the external parent dispatch overlaps other isolated parents.
+		// The actor branch above and legacy body below stay sequential.
+		t.Parallel()
+		if retainedCanonicalNativeCase.Load() != nil {
+			stopCanonicalNativeCase(nil, errors.New("previous canonical native case retains incomplete original custody"))
+			return true
+		}
+		if err := runCanonicalNativeExternalCase(t, path); err != nil {
+			t.Fatalf("external original canonical native case: %v", err)
+		}
+		return true
+	}
+	if os.Getenv("MCPHUB_CANONICAL_NATIVE_ACTOR_FIXTURE") == "" {
+		return false // Preserve the original fixture's missing-input/skip rules.
+	}
+	root, err := os.MkdirTemp("", "canonical-native-case-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// This directory is retained evidence, not t.TempDir cleanup.
+	if err := apitest.HardenedDirForTestMain(root); err != nil {
+		t.Fatal(err)
+	}
+	image, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash, err := hashFile(image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := os.Getenv("MCPHUB_CANONICAL_NATIVE_ACTOR_FIXTURE")
+	fixtureHash, err := hashFile(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nonce := make([]byte, 32)
+	if _, err := rand.Read(nonce); err != nil {
+		t.Fatal(err)
+	}
+	cleanupDeadline := time.Now().Add(4 * time.Minute)
+	if deadline, ok := t.Deadline(); ok && deadline.Add(-time.Second).Before(cleanupDeadline) {
+		cleanupDeadline = deadline.Add(-time.Second)
+	}
+	workDeadline := cleanupDeadline.Add(-10 * time.Second)
+	if !time.Now().Before(workDeadline) {
+		t.Fatal("canonical native case has no remaining bounded work budget")
+	}
+	cfg := canonicalNativeCaseConfig{Version: 1, Test: name, Nonce: fmt.Sprintf("%x", nonce), Image: image, ImageSHA256: fmt.Sprintf("%x", hash),
+		Fixture: fixture, FixtureSHA256: fmt.Sprintf("%x", fixtureHash), WorkDeadline: workDeadline.UTC().Format(time.RFC3339Nano),
+		CleanupDeadline: cleanupDeadline.UTC().Format(time.RFC3339Nano), Timeout: time.Until(workDeadline).String()}
+	path := filepath.Join(root, "config.json")
+	if err := publishCanonicalNativeCase(path, cfg); err != nil {
+		if canonicalnativefixture.HasRetainedFile(err) {
+			stopCanonicalNativeCase(nil, err)
+		}
+		t.Fatal(err)
+	}
+	err = runCanonicalNativeCase(t, root, path, cfg, workDeadline, cleanupDeadline)
+	if retainedCanonicalNativeCase.Load() != nil || canonicalnativefixture.HasRetainedFile(err) {
+		stopCanonicalNativeCase(nil, err)
+		return true
+	}
+	t.Logf("canonical native case evidence: %s", root)
+	if err != nil {
+		t.Fatalf("original canonical native case: %v", err)
+	}
+	return true
+}

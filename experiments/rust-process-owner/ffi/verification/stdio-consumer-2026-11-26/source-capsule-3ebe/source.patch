+	if generation == 0 || milliseconds > 60000 {
+		return &CallError{argument, 0}
+	}
+	var report C.mh_members_report
+	var out C.mh_out
+	status := C.bridge_members_revalidate(o.lib.raw, o.raw, C.uint64_t(generation),
+		C.uint32_t(milliseconds), C.uint32_t(requiredPID), &report, &out)
+	_, err := memberCallResult(status, report, out)
+	return err
+}
+
+// CloseJobMembers finalizes one generation without closing the original owner.
+// The native operation attempts owned closes once and caches its receipt.
+// A valid failed native close returns nil error and CleanupComplete=false;
+// callers must inspect that flag and the per-resource CloseFailed/CloseError.
+// Errors here report call or receipt-validation failures separately.
+// A malformed copy can leave CloseFinalized=true with CleanupComplete=false;
+// repeat this method explicitly to reread native evidence, never to retry a
+// numeric handle. No deadline or automatic owner settlement is introduced.
+func (o *Owner) CloseJobMembers(generation uint64) (MemberClose, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	result := MemberClose{Generation: generation,
+		CloseFinalized: generation != 0 && o.membersFinalized == generation}
+	if o.membersClose != nil && o.membersClose.Generation == generation {
+		result = cloneMemberClose(*o.membersClose)
+	}
+	if err := o.memberReadyLocked(); err != nil {
+		return result, err
+	}
+	if generation == 0 {
+		return result, &CallError{argument, 0}
+	}
+	state := &memberCloseCall{generation: generation}
+	token := cgo.NewHandle(state)
+	defer token.Delete()
+	var finalized C.uint32_t
+	var report C.mh_members_report
+	var out C.mh_out
+	status := C.bridge_members_close(o.lib.raw, o.raw, C.uint64_t(generation), &finalized, C.uintptr_t(token), &report, &out)
+	// Preserve the independent native fact before inspecting any other output.
+	if finalized == 1 {
+		o.membersFinalized = generation
+		result.CloseFinalized = true
+	}
+	observed, callErr := memberCallResult(status, report, out)
+	err := errors.Join(callErr, memberReceiverResult(status, state.calls), state.err)
+	if finalized > 1 || (status == 0 && finalized != 1) {
+		err = errors.Join(err, invalidMember("invalid or missing close finalization"))
+	}
+	if finalized == 1 && observed.PID == 0 {
+		err = errors.Join(err, invalidMember("finalized close omitted original PID"))
+	}
+	if err == nil {
+		for _, resource := range state.value.Resources {
+			if resource.BorrowedOriginal != (resource.PID == observed.PID) {
+				err = invalidMember("close receipt misidentified the borrowed original")
+				break
+			}
+		}
+	}
+	if known := o.membersObserved; err == nil && known != nil && known.generation == generation {
+		if known.original.PID != observed.PID || !sameMemberResourceSet(known.resources, state.value.Resources) {
+			err = invalidMember("close receipt omitted or replaced a retained resource")
+		}
+	}
+	if err != nil {
+		return result, err
+	}
+	candidate := state.value
+	candidate.CloseFinalized = true
+	if o.membersClose != nil && o.membersClose.Generation == generation && !sameMemberClose(*o.membersClose, candidate) {
+		return result, invalidMember("cached close receipt changed")
+	}
+	cached := cloneMemberClose(candidate)
+	o.membersClose = &cached
+	return candidate, nil
+}

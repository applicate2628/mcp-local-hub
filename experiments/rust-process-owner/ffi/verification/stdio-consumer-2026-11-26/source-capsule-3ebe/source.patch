+				return errors.New("retained facade lacks its preparing original owner")
+			}
+			if err := library.Close(); err == nil {
+				return errors.New("retention allowed module unload before native entry")
+			}
+			return nil
+		}, func() (*rustOwnerLibrary, error) { return library, nil })
+	if err == nil || p == nil || p != retained || retains != 1 || probe.calls.Load() != 1 || api.freeCalls != 0 {
+		t.Fatalf("retained native refusal: p=%p retained=%p err=%v retains=%d creates=%d frees=%d",
+			p, retained, err, retains, probe.calls.Load(), api.freeCalls)

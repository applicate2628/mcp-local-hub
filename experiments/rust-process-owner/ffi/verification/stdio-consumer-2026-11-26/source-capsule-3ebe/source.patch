@@ -0,0 +1,256 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"runtime"
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+// Finish observes exit before asking the original custody gate for permission
+// to close. A zero interval polls without sealing a Pending owner.
+// After any close attempt, later calls only recheck/replay native close; they
+// do not renew a wait budget or repeat Rust's individual handle-close attempts.
+func (owner *rustNativeOwner) Finish(milliseconds uint32) (rustOwnerOutcome, error) {
+	if milliseconds > 60000 {
+		return rustOwnerOutcome{}, errors.New("Rust owner finish interval exceeds 60 s")
+	}
+	return owner.finish(nil, milliseconds)
+}
+
+// FinishWithin shares one finite deadline across lock acquisition, native
+// wait slices, query drain and close entry. Cancellation neither stops nor
+// releases the owner and cannot interrupt an already-entered native call.
+func (owner *rustNativeOwner) FinishWithin(ctx context.Context) (rustOwnerOutcome, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return rustOwnerOutcome{}, err
+	}
+	return owner.finish(ctx, 0)
+}
+
+func (owner *rustNativeOwner) finish(ctx context.Context, milliseconds uint32) (rustOwnerOutcome, error) {
+	if owner == nil || owner.library == nil {
+		return rustOwnerOutcome{}, errors.New("missing original Rust owner")
+	}
+	var observed rustOwnerOutcome
+	for {
+		wait, closeStarted, err := owner.waitForExit(ctx, milliseconds)
+		if wait.Size != 0 {
+			observed = rustOwnerOutcome{Size: 48, Version: 1, State: wait.State,
+				Flags: wait.Flags, PID: wait.PID, RootExit: wait.RootExit,
+				Active: wait.Active, NativeError: wait.NativeError}
+			if wait.State == 2 {
+				// EXITED is a wait fact, never COMPLETE cleanup authority.
+				observed.State = 0
+			}
+		}
+		if err != nil {
+			return observed, err
+		}
+		if closeStarted || wait.State == 2 {
+			// waitForExit has released BOTH locks. An admitted query may
+			// need either one to leave the gate before close is permitted.
+			closed, err := owner.closeExited(ctx)
+			if closed.Size == 0 {
+				return observed, err
+			}
+			return closed, err
+		}
+		if ctx == nil {
+			return observed, nil
+		}
+	}
+}
+
+// waitForExit serializes only the native observation. It neither seals custody
+// nor consumes admission. The bool records an earlier close invocation, not
+// successful settlement; that path must obtain the same permit again.
+func (owner *rustNativeOwner) waitForExit(ctx context.Context, milliseconds uint32) (rustOwnerWaitOutcome, bool, error) {
+	return owner.waitForExitWithPermit(ctx, milliseconds, nil)
+}
+
+func (owner *rustNativeOwner) waitForExitWithPermit(ctx context.Context, milliseconds uint32, permit *originalMemberTerminalPermit) (rustOwnerWaitOutcome, bool, error) {
+	if ctx == nil {
+		owner.mu.Lock()
+	} else if err := lockRustCreatorContext(ctx, &owner.mu); err != nil {
+		return rustOwnerWaitOutcome{}, false, err
+	}
+	defer owner.mu.Unlock()
+	return owner.waitForExitLockedWithPermit(ctx, milliseconds, permit)
+}
+
+// waitForExitLocked shares native observation with the root-only waiter. The
+// caller holds owner.mu through both publication and copying the root result.
+func (owner *rustNativeOwner) waitForExitLocked(ctx context.Context, milliseconds uint32) (rustOwnerWaitOutcome, bool, error) {
+	return owner.waitForExitLockedWithPermit(ctx, milliseconds, nil)
+}
+
+func (owner *rustNativeOwner) waitForExitLockedWithPermit(ctx context.Context, milliseconds uint32, permit *originalMemberTerminalPermit) (rustOwnerWaitOutcome, bool, error) {
+	if ctx != nil {
+		if err := creatorClosureContext(ctx); err != nil {
+			return rustOwnerWaitOutcome{}, false, err
+		}
+	}
+	return owner.waitForExitObservationLocked(ctx, milliseconds, permit)
+}
+
+// The one native wait/publication implementation also serves a foreground
+// lifetime with cancellation but no deadline. Finite terminal entry is checked
+// by the wrapper above; no close or permission is acquired by observation.
+func (owner *rustNativeOwner) waitForExitObservationLocked(ctx context.Context, milliseconds uint32, permit *originalMemberTerminalPermit) (rustOwnerWaitOutcome, bool, error) {
+	library := owner.library
+	if library == nil {
+		return rustOwnerWaitOutcome{}, false, errors.New("missing Rust owner library")
+	}
+	if err := lockRustRootObservationContext(ctx, &library.mu); err != nil {
+		return rustOwnerWaitOutcome{}, false, err
+	}
+	defer library.mu.Unlock()
+	if owner.raw == 0 || !library.ready || library.closeAttempted {
+		return rustOwnerWaitOutcome{}, false, errors.New("Rust native owner is not live")
+	}
+	address := library.procedures["mh_wait1"]
+	if address == 0 || library.procedures["mh_close1"] == 0 {
+		return rustOwnerWaitOutcome{}, false, errors.New("Rust owner split wait/close exports unavailable")
+	}
+	if owner.closeStarted {
+		return rustOwnerWaitOutcome{}, true, nil
+	}
+	// SyscallN keeps pointers alive but does not fix their addresses across
+	// Go callbacks. Pin the foreign output, including ABI qualification calls.
+	var output rustOwnerWaitOutcome
+	var pinned runtime.Pinner
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	if ctx != nil {
+		if err := ctx.Err(); err != nil {
+			return rustOwnerWaitOutcome{}, false, err
+		}
+		remaining := 50 * time.Millisecond
+		if deadline, bounded := ctx.Deadline(); bounded {
+			if left := time.Until(deadline); left < remaining {
+				remaining = left
+			}
+		}
+		if remaining <= 0 {
+			return rustOwnerWaitOutcome{}, false, context.DeadlineExceeded
+		}
+		milliseconds = uint32(remaining / time.Millisecond)
+		if milliseconds == 0 {
+			milliseconds = 1
+		}
+	}
+	if permit != nil {
+		if err := permit.validate(owner.memberGate); err != nil {
+			return rustOwnerWaitOutcome{}, false, err
+		}
+		if err := permit.markNativeEntry(ctx); err != nil {
+			return rustOwnerWaitOutcome{}, false, err
+		}
+	}
+	status, _, _ := syscall.SyscallN(address, owner.raw, uintptr(milliseconds),
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	value, err := decodeRustOwnerWaitOutcome(uint32(status), output)
+	if !errors.Is(err, errRustOwnerOutcome) {
+		if publicationErr := owner.publishRootWait(value.PID, value.Flags, value.RootExit); publicationErr != nil {
+			value = rustOwnerWaitOutcome{}
+			err = errors.Join(err, publicationErr)
+		}
+	}
+	if ctx != nil {
+		err = errors.Join(err, ctx.Err())
+	}
+	return value, false, err
+}
+
+func (owner *rustNativeOwner) closeExited(ctx context.Context) (rustOwnerOutcome, error) {
+	if owner == nil || owner.memberGate == nil {
+		return rustOwnerOutcome{}, errors.New("missing original Rust close custody")
+	}
+	permit, err := owner.memberGate.beginTerminal(ctx)
+	if err != nil {
+		return rustOwnerOutcome{}, err
+	}
+	defer permit.finish()
+	return owner.closeExitedWithPermit(ctx, permit)
+}
+
+func (owner *rustNativeOwner) closeExitedWithPermit(ctx context.Context, permit *originalMemberTerminalPermit) (rustOwnerOutcome, error) {
+	value, _, err := owner.closeExitedNative(ctx, permit)
+	return value, err
+}
+
+// closeExitedNative reports actual or earlier native close entry separately.
+// Only the caller can classify a wholly pre-entry failure as retryable admission.
+func (owner *rustNativeOwner) closeExitedNative(ctx context.Context, permit *originalMemberTerminalPermit) (rustOwnerOutcome, bool, error) {
+	if owner == nil || owner.memberGate == nil {
+		return rustOwnerOutcome{}, false, errors.New("missing original Rust close custody")
+	}
+	if err := permit.validate(owner.memberGate); err != nil {
+		return rustOwnerOutcome{}, false, err
+	}
+	if err := lockRustOwnerCreateContext(ctx, &owner.mu); err != nil {
+		return rustOwnerOutcome{}, false, err
+	}
+	defer owner.mu.Unlock()
+	entered := owner.closeStarted
+	if !owner.cachedRootWait().Known {
+		return rustOwnerOutcome{}, entered, errors.New("original root exit must be published before native close")
+	}
+	library := owner.library
+	if library == nil {
+		return rustOwnerOutcome{}, entered, errors.New("missing Rust owner library")
+	}
+	if err := lockRustOwnerCreateContext(ctx, &library.mu); err != nil {
+		return rustOwnerOutcome{}, entered, err
+	}
+	defer library.mu.Unlock()
+	if owner.raw == 0 || !library.ready || library.closeAttempted {
+		return rustOwnerOutcome{}, entered, errors.New("Rust native owner is not live")
+	}
+	address := library.procedures["mh_close1"]
+	if address == 0 || library.procedures["mh_wait1"] == 0 {
+		return rustOwnerOutcome{}, entered, errors.New("Rust owner split wait/close exports unavailable")
+	}
+	var output rustOwnerOutcome
+	var pinned runtime.Pinner
+	pinned.Pin(&output)
+	defer pinned.Unpin()
+	if err := permit.markNativeEntry(ctx); err != nil {
+		return rustOwnerOutcome{}, entered, err
+	}
+	// Native close owns its immutable per-handle outcomes. No later call
+	// waits on closed resources or derives success from an invalid response.
+	owner.closeStarted = true
+	entered = true
+	status, _, _ := syscall.SyscallN(address, owner.raw,
+		uintptr(unsafe.Pointer(&output)), uintptr(unsafe.Sizeof(output)))
+	runtime.KeepAlive(owner)
+	code := uint32(status)

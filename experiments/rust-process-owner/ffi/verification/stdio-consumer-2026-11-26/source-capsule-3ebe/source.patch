+// These private layouts mirror members_v1.h. They carry copied evidence, not
+// Win32 handles or a second authority for the retained original Job.
+type rustOwnerMemberOriginal struct {
+	PID, Reserved     uint32
+	CreationTime100ns uint64
+}
+type rustOwnerMemberCensusABI struct {
+	Total, Active uint32
+	PIDs          *uint32
+	Count         uintptr
+}
+type rustOwnerMemberIdentityABI struct {
+	Size, Version, PID, SIDLen uint32
+	CreationTime100ns          uint64
+	Image                      rustOwnerUTF16
+	SID                        [68]byte
+	Reserved                   uint32
+}
+type rustOwnerMemberResourceABI struct {
+	PID, Flags uint32
+	CloseError int32
+	Reserved   uint32
+}
+type rustOwnerMemberSnapshotABI struct {
+	Size, Version   uint32
+	Generation      uint64
+	Flags, Reserved uint32
+	Original        rustOwnerMemberOriginal
+	Pre, Post       rustOwnerMemberCensusABI
+	Rows            *rustOwnerMemberIdentityABI
+	RowCount        uintptr
+	Resources       *rustOwnerMemberResourceABI
+	ResourceCount   uintptr
+}
+type rustOwnerMemberCloseABI struct {
+	Size, Version   uint32
+	Generation      uint64
+	Flags, Reserved uint32
+	Resources       *rustOwnerMemberResourceABI
+	ResourceCount   uintptr
+}
+type rustOwnerMemberReport struct {
+	Size, Version, Source, Kind  uint32
+	NativeError, TokenCloseError int32
+}
+
+var (
+	_ [120 - unsafe.Sizeof(rustOwnerMemberSnapshotABI{})]byte
+	_ [unsafe.Sizeof(rustOwnerMemberSnapshotABI{}) - 120]byte
+	_ [112 - unsafe.Sizeof(rustOwnerMemberIdentityABI{})]byte
+	_ [unsafe.Sizeof(rustOwnerMemberIdentityABI{}) - 112]byte
+	_ [40 - unsafe.Sizeof(rustOwnerMemberCloseABI{})]byte
+	_ [unsafe.Sizeof(rustOwnerMemberCloseABI{}) - 40]byte
+	_ [24 - unsafe.Sizeof(rustOwnerMemberReport{})]byte
+	_ [unsafe.Sizeof(rustOwnerMemberReport{}) - 24]byte
+)
+
+const (
+	rustOwnerMembersMaxCount   = 4096
+	rustOwnerMemberBorrowed    = uint32(1)
+	rustOwnerMemberAttempted   = uint32(2)
+	rustOwnerMemberClosed      = uint32(4)
+	rustOwnerMemberCloseFailed = uint32(8)
+)
+
+var errRustOwnerMembers = errors.New("invalid Rust owner member protocol")
+
+func invalidRustOwnerMembers(reason string) error {
+	return fmt.Errorf("%w: %s", errRustOwnerMembers, reason)
+}
+
+// Source 4 marks a temporary-token cleanup failure, even with code zero.
+// Kind 1 marks the presence of a nested native query error, also including zero.
+type rustOwnerMemberQueryError struct {
+	Source, Kind                 uint32
+	NativeError, TokenCloseError int32
+}
+
+func (e *rustOwnerMemberQueryError) Error() string {
+	return fmt.Sprintf("Rust member source=%d kind=%d native=%d token_close=%d",
+		e.Source, e.Kind, e.NativeError, e.TokenCloseError)
+}
+func (e *rustOwnerMemberQueryError) Unwrap() []error {
+	var causes []error
+	if e.Kind == 1 {
+		causes = append(causes, syscall.Errno(uint32(e.NativeError)))
+	}
+	if e.Source == 4 {
+		causes = append(causes, syscall.Errno(uint32(e.TokenCloseError)))
+	}
+	return causes
+}
+
+func decodeRustOwnerMemberReport(v rustOwnerMemberReport) (error, bool) {
+	if v.Size != 24 || v.Version != 1 || v.Source > 4 || v.Kind > 7 ||
+		(v.Kind != 1 && v.NativeError != 0) || (v.Source != 4 && v.TokenCloseError != 0) ||
+		(v.Source == 0 && (v.Kind != 0 || v.NativeError != 0 || v.TokenCloseError != 0)) ||
+		(v.Source != 0 && v.Source != 4 && v.Kind == 0) {
+		return invalidRustOwnerMembers("incoherent member error report"), false
+	}
+	if v.Source == 0 {
+		return nil, true
+	}
+	return &rustOwnerMemberQueryError{Source: v.Source, Kind: v.Kind,
+		NativeError: v.NativeError, TokenCloseError: v.TokenCloseError}, true
+}
+
+// The boolean distinguishes a valid native refusal from an indeterminate
+// entered call. Independent effect slots must be retained before this decoder.
+func decodeRustOwnerMemberCall(status uint32, out rustOwnerOutcome, report rustOwnerMemberReport, pid uint32) (bool, error) {
+	_, outErr := decodeRustOwnerOutcome(status, out)
+	queryErr, reportValid := decodeRustOwnerMemberReport(report)
+	valid := reportValid && !errors.Is(outErr, errRustOwnerOutcome)
+	if out.State != 0 || out.Flags & ^uint32(1) != 0 ||
+		out.NativeError != 0 || out.CleanupMask != 0 ||
+		(out.PID != 0 && out.PID != pid) {
+		valid = false
+	}
+	switch status {
+	case 0:
+		valid = valid && queryErr == nil && out.PID == pid
+	case 1, 2:
+		valid = valid && queryErr == nil
+	case 5:
+		valid = valid && queryErr != nil && out.PID == pid
+	default:
+		valid = false
+	}
+	if !valid {
+		return false, errors.Join(outErr, queryErr, invalidRustOwnerMembers("member status, report and owner disagree"))
+	}
+	return true, errors.Join(outErr, queryErr)
+}
+
+type rustOwnerMemberCensus struct {
+	Total, Active uint32
+	PIDs          []uint32
+}
+type rustOwnerMemberIdentity struct {
+	PID               uint32
+	CreationTime100ns uint64
+	ImageUTF16        []uint16
+	TokenUserSID      []byte
+}
+type rustOwnerMemberResource struct {
+	PID, Flags uint32
+	CloseError int32
+}
+type rustOwnerMemberSnapshot struct {
+	Generation uint64
+	Original   rustOwnerMemberOriginal
+	Pre, Post  *rustOwnerMemberCensus
+	Rows       []rustOwnerMemberIdentity
+	Resources  []rustOwnerMemberResource
+	Complete   bool
+}
+type rustOwnerMemberClose struct {
+	Generation uint64
+	Resources  []rustOwnerMemberResource
+	Complete   bool
+}
+
+// The qualified DLL remains responsible for readable memory. Bounds, null
+// pairing and alignment are checked before a borrowed view is constructed.
+func rustOwnerMemberArray(pointer unsafe.Pointer, count, size, alignment uintptr) error {
+	if count > rustOwnerMembersMaxCount || (count == 0) != (pointer == nil) {
+		return invalidRustOwnerMembers("invalid array extent")
+	}
+	if count != 0 && (uintptr(pointer)%alignment != 0 || uintptr(pointer) > ^uintptr(0)-count*size) {
+		return invalidRustOwnerMembers("invalid array storage")
+	}
+	return nil
+}
+func copyRustOwnerMemberCensus(raw rustOwnerMemberCensusABI, known bool) (*rustOwnerMemberCensus, error) {
+	if !known {
+		if raw.Total != 0 || raw.Active != 0 || raw.PIDs != nil || raw.Count != 0 {
+			return nil, invalidRustOwnerMembers("absent census contains facts")
+		}
+		return nil, nil
+	}
+	if err := rustOwnerMemberArray(unsafe.Pointer(raw.PIDs), raw.Count, 4, unsafe.Alignof(uint32(0))); err != nil {
+		return nil, err
+	}
+	if raw.Count != uintptr(raw.Active) || raw.Active > raw.Total {
+		return nil, invalidRustOwnerMembers("census counts disagree")
+	}
+	v := &rustOwnerMemberCensus{Total: raw.Total, Active: raw.Active,
+		PIDs: slices.Clone(unsafe.Slice(raw.PIDs, int(raw.Count)))}
+	for i, pid := range v.PIDs {
+		if pid == 0 || (i != 0 && v.PIDs[i-1] >= pid) {
+			return nil, invalidRustOwnerMembers("census PIDs are not sorted and unique")
+		}
+	}
+	return v, nil
+}
+func copyRustOwnerMemberIdentity(raw rustOwnerMemberIdentityABI) (rustOwnerMemberIdentity, error) {
+	if raw.Size != 112 || raw.Version != 1 || raw.PID == 0 || raw.CreationTime100ns == 0 || raw.Reserved != 0 {
+		return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("invalid identity layout")
+	}
+	if raw.SIDLen < 8 || raw.SIDLen > 68 || raw.SID[0] != 1 || raw.SID[1] > 15 ||
+		raw.SIDLen != 8+4*uint32(raw.SID[1]) {
+		return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("invalid SID structure")
+	}
+	for _, b := range raw.SID[raw.SIDLen:] {
+		if b != 0 {
+			return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("nonzero unused SID bytes")
+		}
+	}
+	image := raw.Image
+	start := uintptr(unsafe.Pointer(image.Data))
+	if image.Data == nil || image.Len == 0 || image.Len > 32768 ||
+		start%unsafe.Alignof(uint16(0)) != 0 || start > ^uintptr(0)-image.Len*2 {
+		return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("invalid image storage")
+	}
+	units := slices.Clone(unsafe.Slice(image.Data, int(image.Len)))
+	for _, unit := range units {
+		if unit == 0 {
+			return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("embedded image terminator")
+		}
+	}
+	if !filepath.IsAbs(string(utf16.Decode(units))) {
+		return rustOwnerMemberIdentity{}, invalidRustOwnerMembers("relative image path")
+	}
+	return rustOwnerMemberIdentity{PID: raw.PID, CreationTime100ns: raw.CreationTime100ns,
+		ImageUTF16: units, TokenUserSID: slices.Clone(raw.SID[:raw.SIDLen])}, nil
+}
+func copyRustOwnerMemberResources(pointer *rustOwnerMemberResourceABI, count uintptr) ([]rustOwnerMemberResource, error) {
+	if err := rustOwnerMemberArray(unsafe.Pointer(pointer), count, 16, unsafe.Alignof(rustOwnerMemberResourceABI{})); err != nil {
+		return nil, err
+	}
+	var rows []rustOwnerMemberResource
+	borrowed, attempted, open := false, false, false
+	for i, raw := range unsafe.Slice(pointer, int(count)) {
+		if raw.PID == 0 || raw.Reserved != 0 || raw.Flags & ^uint32(15) != 0 ||
+			(i != 0 && rows[i-1].PID >= raw.PID) {
+			return nil, invalidRustOwnerMembers("invalid resource layout or PID order")
+		}
+		if raw.Flags&rustOwnerMemberBorrowed != 0 {
+			if borrowed || raw.Flags != rustOwnerMemberBorrowed || raw.CloseError != 0 {
+				return nil, invalidRustOwnerMembers("borrowed original has close fields")
+			}
+			borrowed = true
+		} else if raw.Flags&rustOwnerMemberAttempted != 0 {
+			attempted = true
+			closed, failed := raw.Flags&rustOwnerMemberClosed != 0, raw.Flags&rustOwnerMemberCloseFailed != 0
+			if closed == failed || (!failed && raw.CloseError != 0) {
+				return nil, invalidRustOwnerMembers("close attempt has no unique result")
+			}
+		} else {
+			open = true
+			if raw.Flags != 0 || raw.CloseError != 0 {
+				return nil, invalidRustOwnerMembers("unattempted close has result")
+			}
+		}
+		rows = append(rows, rustOwnerMemberResource{PID: raw.PID, Flags: raw.Flags, CloseError: raw.CloseError})
+	}
+	if attempted && open {
+		return nil, invalidRustOwnerMembers("partly published batch close")
+	}
+	return rows, nil
+}
+func sameRustOwnerMemberCensus(a, b *rustOwnerMemberCensus) bool {
+	return a != nil && b != nil && a.Total == b.Total && a.Active == b.Active && slices.Equal(a.PIDs, b.PIDs)
+}
+func sameRustOwnerMemberResourceSet(a, b []rustOwnerMemberResource) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].PID != b[i].PID || a[i].Flags&rustOwnerMemberBorrowed != b[i].Flags&rustOwnerMemberBorrowed {
+			return false
+		}
+	}
+	return true
+}
+
+func copyRustOwnerMemberSnapshot(raw *rustOwnerMemberSnapshotABI, bytes uint32, generation uint64) (rustOwnerMemberSnapshot, error) {
+	if raw == nil || bytes != 120 || uintptr(unsafe.Pointer(raw))%unsafe.Alignof(*raw) != 0 {
+		return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("invalid snapshot storage")
+	}
+	if raw.Size != 120 || raw.Version != 1 || raw.Reserved != 0 || raw.Flags & ^uint32(7) != 0 ||
+		generation == 0 || raw.Generation != generation || raw.Original.Reserved != 0 ||
+		raw.Original.PID == 0 || raw.Original.CreationTime100ns == 0 {
+		return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("invalid snapshot layout or generation")
+	}
+	v := rustOwnerMemberSnapshot{Generation: generation, Original: raw.Original, Complete: raw.Flags&4 != 0}
+	var err error
+	v.Pre, err = copyRustOwnerMemberCensus(raw.Pre, raw.Flags&1 != 0)
+	if err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	v.Post, err = copyRustOwnerMemberCensus(raw.Post, raw.Flags&2 != 0)
+	if err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	v.Resources, err = copyRustOwnerMemberResources(raw.Resources, raw.ResourceCount)
+	if err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	if err := rustOwnerMemberArray(unsafe.Pointer(raw.Rows), raw.RowCount, 112, unsafe.Alignof(rustOwnerMemberIdentityABI{})); err != nil {
+		return rustOwnerMemberSnapshot{}, err
+	}
+	if (v.Pre == nil && (v.Post != nil || len(v.Resources) != 0)) || raw.RowCount > uintptr(len(v.Resources)) ||
+		(v.Pre != nil && len(v.Resources) > len(v.Pre.PIDs)) ||
+		(v.Post != nil && (len(v.Resources) != len(v.Pre.PIDs) || raw.RowCount != uintptr(len(v.Resources)))) {
+		return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("partial snapshot lost its retained prefix")
+	}
+	for i, resource := range v.Resources {
+		if resource.PID != v.Pre.PIDs[i] || (resource.Flags&rustOwnerMemberBorrowed != 0) != (resource.PID == v.Original.PID) {
+			return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("resource contradicts original custody")
+		}
+	}
+	for i, row := range unsafe.Slice(raw.Rows, int(raw.RowCount)) {
+		value, err := copyRustOwnerMemberIdentity(row)
+		if err != nil {
+			return rustOwnerMemberSnapshot{}, err
+		}
+		if value.PID != v.Resources[i].PID || (value.PID == v.Original.PID && value.CreationTime100ns != v.Original.CreationTime100ns) {
+			return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("identity contradicts retained resource")
+		}
+		v.Rows = append(v.Rows, value)
+	}
+	if v.Complete && (!sameRustOwnerMemberCensus(v.Pre, v.Post) || len(v.Rows) == 0 ||
+		len(v.Rows) != len(v.Resources) || len(v.Rows) != len(v.Pre.PIDs)) {
+		return rustOwnerMemberSnapshot{}, invalidRustOwnerMembers("complete snapshot omitted stable full census")
+	}
+	return v, nil
+}
+func copyRustOwnerMemberClose(raw *rustOwnerMemberCloseABI, bytes uint32, generation uint64) (rustOwnerMemberClose, error) {
+	if raw == nil || bytes != 40 || uintptr(unsafe.Pointer(raw))%unsafe.Alignof(*raw) != 0 {
+		return rustOwnerMemberClose{}, invalidRustOwnerMembers("invalid close storage")
+	}
+	if raw.Size != 40 || raw.Version != 1 || raw.Reserved != 0 || raw.Flags & ^uint32(1) != 0 ||
+		generation == 0 || raw.Generation != generation {
+		return rustOwnerMemberClose{}, invalidRustOwnerMembers("invalid close layout or generation")
+	}
+	resources, err := copyRustOwnerMemberResources(raw.Resources, raw.ResourceCount)
+	if err != nil {
+		return rustOwnerMemberClose{}, err
+	}
+	complete := true
+	for _, resource := range resources {
+		if resource.Flags&rustOwnerMemberBorrowed == 0 && resource.Flags&rustOwnerMemberAttempted == 0 {
+			return rustOwnerMemberClose{}, invalidRustOwnerMembers("final close has unattempted resource")
+		}
+		complete = complete && resource.Flags&rustOwnerMemberCloseFailed == 0
+	}
+	if complete != (raw.Flags&1 != 0) {
+		return rustOwnerMemberClose{}, invalidRustOwnerMembers("close completeness contradicts errors")
+	}
+	return rustOwnerMemberClose{Generation: generation, Resources: resources, Complete: complete}, nil
+}

+func TestMemberLiveTreeRetainsAndRevalidatesSameDescendant(t *testing.T) {
+	_, o, initial, marker, keep := memberFixture(t, "tree")
+	if _, err := o.Admit(true); err != nil {
+		t.Fatal(err)
+	}
+	waitMemberMarker(t, marker)
+	waitMemberMarker(t, marker+".grandchild")
+	generation, got, err := o.ObserveJobMembers(3000)
+	keep(generation)
+	if err != nil || !got.AcquisitionComplete || got.Pre == nil || got.Pre.TotalProcesses != 2 ||
+		got.Pre.ActiveProcesses != 2 || len(got.Rows) != 2 || len(got.Resources) != 2 {
+		t.Fatalf("live tree acquisition: %s %v", memberSummary(got), err)
+	}
+	var descendant uint32
+	for _, row := range got.Rows {
+		if row.PID != initial.PID {
+			descendant = row.PID
+		}
+	}
+	if descendant == 0 {
+		t.Fatal("real descendant was not acquired")
+	}
+	for _, pid := range []uint32{0, initial.PID, descendant} {
+		if err := o.RevalidateJobMembers(generation, 3000, pid); err != nil {
+			t.Fatalf("same retained set required PID %d: %v", pid, err)
+		}
+	}
+	if err := o.RevalidateJobMembers(generation, 3000, uint32(os.Getpid())); err == nil {
+		t.Fatal("foreign PID was accepted as a member of the acquisition")
+	}
+	// All workers join before cleanup; each native budget is finite.
+	var wg sync.WaitGroup
+	errs := make(chan error, 6)
+	for i := 0; i < 6; i++ {
+		wg.Add(1)
+		go func(query bool) {
+			defer wg.Done()
+			if query {
+				copy, err := o.JobMemberSnapshot(generation)
+				if err == nil && !reflect.DeepEqual(copy, got) {
+					err = errors.New("concurrent snapshot changed")
+				}
+				errs <- err
+			} else {
+				errs <- o.RevalidateJobMembers(generation, 1000, descendant)
+			}
+		}(i%2 == 0)
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	closed := requireMemberClose(t, o, generation)
+	for _, resource := range closed.Resources {
+		if resource.PID == initial.PID {
+			if !resource.BorrowedOriginal || resource.CloseAttempted {
+				t.Fatalf("root resource was owned by member close: %+v", resource)
+			}
+		} else if resource.PID != descendant || resource.BorrowedOriginal ||
+			!resource.CloseAttempted || !resource.Closed || resource.CloseFailed {
+			t.Fatalf("retained descendant was not explicitly closed: %+v", resource)
+		}
+	}
+	historical, err := o.JobMemberSnapshot(generation)
+	if err != nil || !reflect.DeepEqual(historical.Rows, got.Rows) || !reflect.DeepEqual(historical.Pre, got.Pre) ||
+		!reflect.DeepEqual(historical.Resources, closed.Resources) || !historical.AcquisitionComplete {
+		t.Fatalf("member close replaced acquisition history: %s %v", memberSummary(historical), err)
+	}
+	if _, err := o.Stop(79); err != nil {
+		t.Fatal(err)
+	}
+	out, err := o.Finish(3000)
+	if err != nil || out.State != complete || out.RootExit != 79 {
+		t.Fatalf("original tree settlement after member close: %+v %v", out, err)
+	}
+}

+func TestSerenaRuntimeOutputBuildDeclaration(t *testing.T) {
+	for _, tc := range []struct {
+		key, value, kind, normalized, errorCode string
+		buildDeclaration                        bool
+	}{
+		{key: "PYTHONUNBUFFERED", kind: "runtime-only"},
+		{key: "PYTHONUNBUFFERED", value: "1", kind: "runtime-only"},
+		{key: "pythonunbuffered", value: "0", kind: "runtime-only"},
+		{key: "PythonUnbuffered", value: "secret:ABSENT_RUNTIME", kind: "runtime-only"},
+		{key: "PYTHONUNBUFFERED_EXTRA", value: "1", errorCode: "SERENA_BUILD_INPUT_UNSUPPORTED", buildDeclaration: true},
+		{key: "PYTHONNOUSERSITE", value: "1", errorCode: "SERENA_BUILD_INPUT_UNSUPPORTED", buildDeclaration: true},
+		{key: "PYTHONHOME", value: "other", errorCode: "SERENA_BUILD_IMPORT_OVERRIDE_REFUSED", buildDeclaration: true},
+		{key: "PYTHONPATH", value: "other", errorCode: "SERENA_BUILD_IMPORT_OVERRIDE_REFUSED", buildDeclaration: true},
+		{key: "VIRTUAL_ENV", value: "other", errorCode: "SERENA_BUILD_IMPORT_OVERRIDE_REFUSED", buildDeclaration: true},
+		{key: "PYTHONDONTWRITEBYTECODE", value: "1", kind: "policy", normalized: "1", buildDeclaration: true},
+		{key: "PYTHONDONTWRITEBYTECODE", value: "0", errorCode: "SERENA_BUILD_BYTECODE_POLICY_CONFLICT", buildDeclaration: true},
+		{key: "UV_OFFLINE", value: "true", kind: "boolean", normalized: "true", buildDeclaration: true},
+	} {
+		t.Run(tc.key+"="+tc.value, func(t *testing.T) {
+			if got := IsSerenaPreparationBuildDeclaration(tc.key); got != tc.buildDeclaration {
+				t.Errorf("build declaration = %t, want %t", got, tc.buildDeclaration)
+			}
+			kind, normalized, err := normalizeSerenaBuildValue(strings.ToUpper(tc.key), tc.value)
+			if tc.errorCode != "" {
+				if err == nil || err.Error() != tc.errorCode {
+					t.Fatalf("normalization error = %v, want %s", err, tc.errorCode)
+				}
+				return
+			}
+			if err != nil || kind != tc.kind || normalized != tc.normalized {
+				t.Fatalf("normalization = (%q, %q, %v), want (%q, %q, nil)",
+					kind, normalized, err, tc.kind, tc.normalized)
+			}
+		})
+	}
+}

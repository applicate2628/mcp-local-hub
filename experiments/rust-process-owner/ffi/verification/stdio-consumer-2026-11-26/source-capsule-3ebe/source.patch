+func TestRustOwnerFacadeHeldPermitKeepsWaitCloseSeparate(t *testing.T) {
+	f, _, original := newRustFacadeABIFixture(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)

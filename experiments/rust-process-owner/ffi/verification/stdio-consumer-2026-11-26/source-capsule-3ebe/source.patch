diff --git a/internal/process/rust_owner_library_windows.go b/internal/process/rust_owner_library_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..66b5866eeaf7b5ef92763eef2a13e3aeba8dced1
--- /dev/null
+++ b/internal/process/rust_owner_library_windows.go
@@ -0,0 +1,461 @@
+//go:build windows
+
+package process
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+
+	"mcp-local-hub/internal/buildinfo"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+
+	"golang.org/x/sys/windows"
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+const (
+	rustOwnerProductFilename         = "mcphub.exe"
+	rustOwnerLibraryFilename         = "mcphub-owner.dll"
+	rustOwnerIdentityFilename        = "mcphub-owner-identity.json"
+	rustOwnerIdentityMaxBytes        = 16 << 10
+	rustOwnerMachineAMD64     uint16 = 0x8664
+	rustOwnerABIVersion       uint32 = 1
+	rustOwnerLoadFlags               = windows.LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | windows.LOAD_LIBRARY_SEARCH_SYSTEM32
+)
+
+type rustOwnerLibraryAdmission func(path string, machine uint16, exports []string, sourceCommit string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error)
+
+type rustOwnerLibraryFileGuard interface {
+	Close() error
+}
+
+type rustOwnerLibraryAPI interface {
+	lock(path string) (rustOwnerLibraryFileGuard, error)
+	load(path string, flags uint32) (windows.Handle, error)
+	path(handle windows.Handle) (string, error)
+	proc(handle windows.Handle, name string) (uintptr, error)
+	callVersion(address uintptr) uint32
+	free(handle windows.Handle) error
+}
+
+type rustOwnerLibraryDependencies struct {
+	api   rustOwnerLibraryAPI
+	admit rustOwnerLibraryAdmission
+}
+
+type rustOwnerLibrary struct {
+	mu sync.Mutex
+
+	api          rustOwnerLibraryAPI
+	handle       windows.Handle
+	fileGuard    rustOwnerLibraryFileGuard
+	procedures   map[string]uintptr
+	identity     runtimeidentity.WindowsRuntimeLibraryIdentity
+	ready        bool
+	activeOwners atomic.Int64 // increments also hold mu; abandoned pre-create leases may decrement without it
+
+	guardCloseAttempted bool
+	guardCloseErr       error
+	closeAttempted      bool
+	closeErr            error
+}
+
+func systemRustOwnerLibraryDependencies() rustOwnerLibraryDependencies {
+	return rustOwnerLibraryDependencies{
+		api:   systemRustOwnerLibraryAPI{},
+		admit: runtimeidentity.AdmitWindowsRuntimeLibrary,
+	}
+}
+
+// openBundledRustOwnerLibrary admits and loads the DLL next to the product
+// executable. It performs no process operation and grants no product capability.
+func openBundledRustOwnerLibrary(productExecutable, expectedCommit, expectedSHA256 string) (*rustOwnerLibrary, error) {
+	return openRustOwnerLibrary(productExecutable, expectedCommit, expectedSHA256, systemRustOwnerLibraryDependencies())
+}
+
+// openProductRustOwnerLibrary obtains both trust operands from compiled
+// Product metadata, never from the adjacent, user-writable JSON receipt.
+// Its caller owns the returned module and must close it exactly once.
+func openProductRustOwnerLibrary() (*rustOwnerLibrary, error) {
+	hash, err := buildinfo.CurrentRustOwnerSHA256()
+	if err != nil {
+		return nil, err
+	}
+	_, commit, _ := buildinfo.Get()
+	if err := runtimeidentity.ValidateWindowsRuntimeSourceCommit(commit); err != nil {
+		return nil, err
+	}
+	productExecutable, err := os.Executable()
+	if err != nil {
+		return nil, fmt.Errorf("Rust owner product executable: %w", err)
+	}
+	return openBundledRustOwnerLibrary(productExecutable, commit, hash)
+}
+
+func openRustOwnerLibrary(productExecutable, expectedCommit, expectedSHA256 string, dependencies rustOwnerLibraryDependencies) (*rustOwnerLibrary, error) {
+	if err := runtimeidentity.ValidateWindowsRuntimeSourceCommit(expectedCommit); err != nil {
+		return nil, err
+	}
+	if !canonicalLowerHex(expectedSHA256, 64) {
+		return nil, fmt.Errorf("Rust owner expected SHA-256 must be 64 lowercase hexadecimal characters")
+	}
+	if dependencies.api == nil || dependencies.admit == nil {
+		return nil, fmt.Errorf("Rust owner library dependencies are incomplete")
+	}
+	productPath, err := admittedRustOwnerProductPath(productExecutable)
+	if err != nil {
+		return nil, err
+	}
+	productDirectory := filepath.Dir(productPath)
+	libraryPath := filepath.Join(productDirectory, rustOwnerLibraryFilename)
+	identityPath := filepath.Join(productDirectory, rustOwnerIdentityFilename)
+	fileGuard, err := dependencies.api.lock(libraryPath)
+	if err != nil {
+		return nil, fmt.Errorf("Rust owner stability lock: %w", err)
+	}
+	if fileGuard == nil {
+		return nil, fmt.Errorf("Rust owner stability lock returned no owner")
+	}
+	library := &rustOwnerLibrary{
+		api:       dependencies.api,
+		fileGuard: fileGuard,
+	}
+	settleFailure := func(primary error) (*rustOwnerLibrary, error) {
+		if closeErr := library.Close(); closeErr != nil {
+			return library, errors.Join(primary, closeErr)
+		}
+		return nil, primary
+	}
+	identity, err := readRustOwnerLibraryIdentity(identityPath, expectedCommit, expectedSHA256)
+	if err != nil {
+		return settleFailure(err)
+	}
+	// The receipt selects one complete canonical profile; use it throughout loading.
+	exports := append([]string(nil), identity.Exports...)
+	library.procedures = make(map[string]uintptr, len(exports))
+	library.identity = identity
+	before, err := dependencies.admit(libraryPath, rustOwnerMachineAMD64, exports, expectedCommit)
+	if err != nil {
+		return settleFailure(fmt.Errorf("Rust owner pre-load admission: %w", err))
+	}
+	if !equalRustOwnerLibraryIdentity(identity, before) {
+		return settleFailure(fmt.Errorf("Rust owner identity disagrees with pre-load admission"))
+	}
+	handle, err := dependencies.api.load(libraryPath, uint32(rustOwnerLoadFlags))
+	if err != nil {
+		return settleFailure(fmt.Errorf("Rust owner LoadLibraryEx: %w", err))
+	}
+	library.handle = handle
+	loadedPath, err := dependencies.api.path(handle)
+	if err != nil {
+		return settleFailure(fmt.Errorf("Rust owner loaded module path: %w", err))
+	}
+	if !sameWindowsPath(loadedPath, libraryPath) {
+		return settleFailure(fmt.Errorf("Rust owner loaded module path %q differs from admitted path %q", loadedPath, libraryPath))
+	}
+	for _, name := range exports {
+		address, err := dependencies.api.proc(handle, name)
+		if err != nil {
+			return settleFailure(fmt.Errorf("Rust owner GetProcAddress %s: %w", name, err))
+		}
+		if address == 0 {
+			return settleFailure(fmt.Errorf("Rust owner GetProcAddress %s returned zero", name))
+		}
+		library.procedures[name] = address
+	}
+	if version := dependencies.api.callVersion(library.procedures["mh_version1"]); version != rustOwnerABIVersion {
+		return settleFailure(fmt.Errorf("Rust owner ABI version %d, want %d", version, rustOwnerABIVersion))
+	}
+	after, err := dependencies.admit(libraryPath, rustOwnerMachineAMD64, exports, expectedCommit)
+	if err != nil {
+		return settleFailure(fmt.Errorf("Rust owner post-load admission: %w", err))
+	}
+	if !equalRustOwnerLibraryIdentity(before, after) {
+		return settleFailure(fmt.Errorf("Rust owner library changed after load"))
+	}
+	if guardErr := library.releaseGuard(); guardErr != nil {
+		if closeErr := library.Close(); closeErr != nil {
+			return library, fmt.Errorf("Rust owner stability lock close: %w", closeErr)
+		}
+		return nil, fmt.Errorf("Rust owner stability lock close: %w", guardErr)
+	}
+	library.ready = true
+	return library, nil
+}
+
+func admittedRustOwnerProductPath(path string) (string, error) {
+	if !filepath.IsAbs(path) {
+		return "", fmt.Errorf("product executable path must be absolute")
+	}
+	path = filepath.Clean(path)
+	if filepath.Base(path) != rustOwnerProductFilename {
+		return "", fmt.Errorf("product executable filename must be %s", rustOwnerProductFilename)
+	}
+	if err := requireOrdinaryWindowsFile(path, "product executable"); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+func readRustOwnerLibraryIdentity(path, expectedCommit, expectedSHA256 string) (identity runtimeidentity.WindowsRuntimeLibraryIdentity, err error) {
+	if err := requireOrdinaryWindowsFile(path, "Rust owner identity"); err != nil {
+		return identity, err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return identity, fmt.Errorf("Rust owner identity open: %w", err)
+	}
+	defer func() {
+		if closeErr := file.Close(); closeErr != nil {
+			identity = runtimeidentity.WindowsRuntimeLibraryIdentity{}
+			err = errors.Join(err, fmt.Errorf("Rust owner identity close: %w", closeErr))
+		}
+	}()
+	data, err := io.ReadAll(io.LimitReader(file, rustOwnerIdentityMaxBytes+1))
+	if err != nil {
+		return identity, fmt.Errorf("Rust owner identity read: %w", err)
+	}
+	if len(data) > rustOwnerIdentityMaxBytes {
+		return identity, fmt.Errorf("Rust owner identity exceeds %d bytes", rustOwnerIdentityMaxBytes)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&identity); err != nil {
+		return runtimeidentity.WindowsRuntimeLibraryIdentity{}, fmt.Errorf("Rust owner identity decode: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		if err == nil {
+			err = fmt.Errorf("multiple JSON values")
+		}
+		return runtimeidentity.WindowsRuntimeLibraryIdentity{}, fmt.Errorf("Rust owner identity trailing data: %w", err)
+	}
+	if identity.Schema != runtimeidentity.WindowsRuntimeLibraryIdentitySchemaV1 ||
+		identity.Filename != rustOwnerLibraryFilename ||
+		identity.SourceCommit != expectedCommit ||
+		identity.Machine != rustOwnerMachineAMD64 ||
+		identity.SHA256 != expectedSHA256 ||
+		!canonicalLowerHex(identity.SHA256, 64) ||
+		!runtimeidentity.IsWindowsProcessOwnerExportProfileV1(identity.Exports) {
+		return runtimeidentity.WindowsRuntimeLibraryIdentity{}, fmt.Errorf("Rust owner identity fields are invalid")
+	}
+	return identity, nil
+}
+
+func requireOrdinaryWindowsFile(path, role string) error {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("%s lstat: %w", role, err)
+	}
+	if !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("%s must be an ordinary regular file", role)
+	}
+	wide, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return fmt.Errorf("%s path: %w", role, err)
+	}
+	attributes, err := windows.GetFileAttributes(wide)
+	if err != nil {
+		return fmt.Errorf("%s attributes: %w", role, err)
+	}
+	if attributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+		return fmt.Errorf("%s must not be a reparse point", role)
+	}
+	return nil
+}
+
+func canonicalLowerHex(value string, length int) bool {
+	if len(value) != length {
+		return false
+	}
+	for _, character := range value {
+		if (character < '0' || character > '9') && (character < 'a' || character > 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func equalRustOwnerLibraryIdentity(left, right runtimeidentity.WindowsRuntimeLibraryIdentity) bool {
+	return left.Schema == right.Schema &&
+		left.Filename == right.Filename &&
+		left.SourceCommit == right.SourceCommit &&
+		left.Machine == right.Machine &&
+		left.SHA256 == right.SHA256 &&
+		equalRustOwnerStrings(left.Exports, right.Exports)
+}
+
+func equalRustOwnerStrings(left, right []string) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
+
+func sameWindowsPath(left, right string) bool {
+	leftAbsolute, leftErr := filepath.Abs(left)
+	rightAbsolute, rightErr := filepath.Abs(right)
+	return leftErr == nil && rightErr == nil && strings.EqualFold(filepath.Clean(leftAbsolute), filepath.Clean(rightAbsolute))
+}
+
+func (library *rustOwnerLibrary) procedure(name string) (uintptr, bool) {
+	library.mu.Lock()
+	defer library.mu.Unlock()
+	if !library.ready || library.closeAttempted {
+		return 0, false
+	}
+	address, ok := library.procedures[name]
+	return address, ok
+}
+
+func (library *rustOwnerLibrary) releaseGuard() error {
+	library.mu.Lock()
+	defer library.mu.Unlock()
+	return library.releaseGuardLocked()
+}
+
+func (library *rustOwnerLibrary) releaseGuardLocked() error {
+	if library.guardCloseAttempted {
+		return library.guardCloseErr
+	}
+	library.guardCloseAttempted = true
+	if library.fileGuard == nil {
+		return nil
+	}
+	library.guardCloseErr = library.fileGuard.Close()
+	if library.guardCloseErr == nil {
+		library.fileGuard = nil
+	}
+	return library.guardCloseErr
+}
+
+// Close makes one terminal FreeLibrary and stability-lock close attempt. Failed
+// attempts are cached and never replayed through a second owner or a finalizer.
+func (library *rustOwnerLibrary) Close() error {
+	library.mu.Lock()
+	defer library.mu.Unlock()
+	if library.closeAttempted {
+		return library.closeErr
+	}
+	if active := library.activeOwners.Load(); active != 0 {
+		return fmt.Errorf("cannot unload Rust owner DLL with %d live native owners", active)
+	}
+	library.closeAttempted = true
+	library.ready = false
+	var moduleErr error
+	if library.handle != 0 {
+		moduleErr = library.api.free(library.handle)
+		if moduleErr == nil {
+			library.handle = 0
+			library.procedures = nil
+		}
+	}
+	guardErr := library.releaseGuardLocked()
+	library.closeErr = errors.Join(moduleErr, guardErr)
+	return library.closeErr
+}
+
+type systemRustOwnerLibraryAPI struct{}
+
+type systemRustOwnerLibraryFileGuard struct {
+	mu sync.Mutex
+
+	handle         windows.Handle
+	closeAttempted bool
+	closeErr       error
+}
+
+func (systemRustOwnerLibraryAPI) lock(path string) (rustOwnerLibraryFileGuard, error) {
+	wide, err := windows.UTF16PtrFromString(path)
+	if err != nil {
+		return nil, err
+	}
+	handle, err := windows.CreateFile(
+		wide,
+		windows.GENERIC_READ,
+		windows.FILE_SHARE_READ,
+		nil,
+		windows.OPEN_EXISTING,
+		windows.FILE_ATTRIBUTE_NORMAL|windows.FILE_FLAG_OPEN_REPARSE_POINT,
+		0,
+	)
+	if err != nil {
+		return nil, err
+	}
+	guard := &systemRustOwnerLibraryFileGuard{handle: handle}
+	var information windows.ByHandleFileInformation
+	if err := windows.GetFileInformationByHandle(handle, &information); err != nil {
+		return nil, errors.Join(err, guard.Close())
+	}
+	if information.FileAttributes&(windows.FILE_ATTRIBUTE_DIRECTORY|windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0 {
+		return nil, errors.Join(fmt.Errorf("Rust owner DLL must be an ordinary non-reparse file"), guard.Close())
+	}
+	return guard, nil
+}
+
+func (guard *systemRustOwnerLibraryFileGuard) Close() error {
+	guard.mu.Lock()
+	defer guard.mu.Unlock()
+	if guard.closeAttempted {
+		return guard.closeErr
+	}
+	guard.closeAttempted = true
+	if guard.handle == 0 || guard.handle == windows.InvalidHandle {
+		return nil
+	}
+	guard.closeErr = windows.CloseHandle(guard.handle)
+	if guard.closeErr == nil {
+		guard.handle = 0
+	}
+	return guard.closeErr
+}
+
+func (systemRustOwnerLibraryAPI) load(path string, flags uint32) (windows.Handle, error) {
+	return windows.LoadLibraryEx(path, 0, uintptr(flags))
+}
+
+func (systemRustOwnerLibraryAPI) path(handle windows.Handle) (string, error) {
+	for size := 512; size <= 32768; size *= 2 {
+		buffer := make([]uint16, size)
+		length, err := windows.GetModuleFileName(handle, &buffer[0], uint32(len(buffer)))
+		if err != nil {
+			if errors.Is(err, windows.ERROR_INSUFFICIENT_BUFFER) {
+				continue
+			}
+			return "", err
+		}
+		if length == 0 {
+			return "", fmt.Errorf("GetModuleFileName returned an empty path")
+		}
+		if length < uint32(len(buffer)) {
+			return windows.UTF16ToString(buffer[:length]), nil
+		}
+	}
+	return "", fmt.Errorf("loaded module path exceeds 32768 UTF-16 code units")
+}
+
+func (systemRustOwnerLibraryAPI) proc(handle windows.Handle, name string) (uintptr, error) {
+	return windows.GetProcAddress(handle, name)
+}
+
+func (systemRustOwnerLibraryAPI) callVersion(address uintptr) uint32 {
+	value, _, _ := syscall.SyscallN(address)
+	return uint32(value)
+}
+
+func (systemRustOwnerLibraryAPI) free(handle windows.Handle) error {
+	return windows.FreeLibrary(handle)
+}

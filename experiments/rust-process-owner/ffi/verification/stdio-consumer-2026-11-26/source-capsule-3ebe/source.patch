+func TestPrepareRustOwnerCommandUsesOrdinalEnvironmentOrder(t *testing.T) {
+	cmd := rustOwnerCommandFixture()
+	cmd.Env = []string{"Ë=umlaut", "é=accent", "A!=punctuation", "A=prefix", "SystemRoot="}
+	got, err := prepareRustOwnerCommand(cmd)
+	want := []rustOwnerEnvironmentEntry{
+		{Name: "A", Value: "prefix"},
+		{Name: "A!", Value: "punctuation"},

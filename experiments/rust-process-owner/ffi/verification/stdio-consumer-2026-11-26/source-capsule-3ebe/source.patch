index 0000000000000000000000000000000000000000..6f87e02c93632ddfbd42d26c18a15b7ed3cf6b42
--- /dev/null
+++ b/internal/process/rust_owner_sid_windows.go
@@ -0,0 +1,157 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// rustOwnerSIDObservation is a diagnostic observation, not CreatorIdentity or
+// authority to start/stop a process. Its retained Go-owned SID is the precise
+// input referenced by the existing formatter's private receipt.
+type rustOwnerSIDObservation struct {
+	owner    *rustNativeOwner
+	identity rustOwnerIdentityValue
+	input    []byte
+	sid      *windows.SID
+	value    string
+	receipt  *SIDFormatObservation
+	complete bool // true only after SID receipt and final context gate succeed
+}
+
+// FormatOriginalUserSID serializes identity query and actual SID formatting
+// with the native owner's close/stop operations. Native query is synchronous;
+// a context expiration cannot interrupt an already-entered Windows syscall.
+func (owner *rustNativeOwner) FormatOriginalUserSID(ctx context.Context) (*rustOwnerSIDObservation, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	if owner == nil || owner.memberGate == nil {
+		return nil, errors.New("missing original Rust query custody")
+	}
+	exit, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return nil, err
+	}
+	defer exit()
+	return owner.formatOriginalUserSIDAdmitted(ctx)
+}
+
+// formatOriginalUserSIDAdmitted requires the caller's original memberGate
+// query lease. Sharing this body avoids a second admission after terminal seal.
+func (owner *rustNativeOwner) formatOriginalUserSIDAdmitted(ctx context.Context) (*rustOwnerSIDObservation, error) {
+	if err := lockRustCreatorContext(ctx, &owner.mu); err != nil {
+		return nil, err
+	}
+	defer owner.mu.Unlock()
+
+	identity, err := owner.queryIdentityLocked(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	input := append([]byte(nil), identity.TokenUserSID...)
+	if len(input) < 8 {
+		return nil, errors.New("original Rust TokenUser SID is incomplete")
+	}
+	sid := (*windows.SID)(unsafe.Pointer(&input[0]))
+	if !sid.IsValid() || sid.Len() != len(input) {
+		return nil, errors.New("original Rust TokenUser SID is not valid")
+	}
+	text, receipt, formatErr := FormatSIDObserved(sid)
+	runtime.KeepAlive(input)
+	observation := &rustOwnerSIDObservation{
+		owner: owner, identity: identity, input: input, sid: sid,
+		value: text, receipt: receipt,
+	}
+	if formatErr != nil {
+		return observation, formatErr
+	}
+	if err := receipt.ValidateInput(sid, text); err != nil {
+		return observation, err
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return observation, err
+	}
+	observation.complete = true
+	return observation, nil
+}
+
+// creatorFacts maps one verified Rust observation to the existing Go data
+// convention. It does not issue authority; ObserveCreatorIdentity does so
+// under the original owner's admission. Member enumeration remains separate.
+func (o *rustOwnerSIDObservation) creatorFacts() (CreatorIdentitySnapshot, error) {
+	var empty CreatorIdentitySnapshot
+	if o == nil || !o.complete || o.owner == nil || o.receipt == nil || o.sid == nil {
+		return empty, errors.New("original Rust identity evidence is unavailable")
+	}
+	if err := o.receipt.ValidateInput(o.sid, o.value); err != nil {
+		return empty, err
+	}
+	v := o.identity
+	if v.PID == 0 || v.CreationTime100ns == 0 ||
+		(v.JobMembership != 1 && v.JobMembership != 2) ||
+		(v.WaitState != 1 && v.WaitState != 2) ||
+		(v.WaitState == 1 && v.JobMembership != 1) {
+		return empty, errors.New("original Rust identity facts are inconsistent")
+	}
+	path := windows.UTF16ToString(v.ImageUTF16)
+	if !filepath.IsAbs(path) || o.value == "" {
+		return empty, errors.New("original Rust executable or owner SID is unavailable")
+	}
+	// FILETIME is 100-ns ticks since 1601-01-01 UTC. Separate whole
+	// seconds and subsecond ticks before converting to Unix time to avoid
+	// nanosecond overflow at dates beyond year 2262.
+	const ticksPerSecond = 10_000_000
+	const epochOffsetSeconds = 11_644_473_600
+	created := time.Unix(
+		int64(v.CreationTime100ns/ticksPerSecond)-epochOffsetSeconds,
+		int64(v.CreationTime100ns%ticksPerSecond)*100,
+	).UTC()
+	alive := v.WaitState == 1
+	wait := uint32(windows.WAIT_OBJECT_0)
+	if alive {
+		wait = uint32(windows.WAIT_TIMEOUT)
+	}
+	return CreatorIdentitySnapshot{
+		Version: 1, OriginalPID: int(v.PID),
+		OriginalStartedAt: created.Format(time.RFC3339Nano),
+		ExecutablePath:    path, OwnerSID: o.value,
+		OriginalJobBound: true, CurrentJobMembershipKnown: true,
+		CurrentJobMember: v.JobMembership == 1, RootWaitKnown: true,
+		RootWaitResult: wait, RootAlive: alive,
+	}, nil
+}
+
+// lockRustCreatorContext honors the Product caller's single finite deadline
+// while waiting for original ownership or module serialization. The native
+// syscall itself cannot be interrupted after entry.
+func lockRustCreatorContext(ctx context.Context, mu *sync.Mutex) error {
+	for {
+		if err := creatorClosureContext(ctx); err != nil {
+			return err
+		}
+		if mu.TryLock() {
+			if err := creatorClosureContext(ctx); err != nil {
+				mu.Unlock()
+				return err
+			}
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(creatorClosureAdmissionInterval):
+		}
+	}
+}

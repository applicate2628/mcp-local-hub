+func TestRustOwnerMemberCloseAdmissionAndCallerCancellation(t *testing.T) {
+	for _, which := range []string{"owner", "library"} {
+		t.Run(which, func(t *testing.T) {
+			f := newRustMemberScript(t)
+			o := f.acquire(t)
+			var mu *sync.Mutex = &f.owner.mu
+			if which == "library" {
+				mu = &f.owner.library.mu
+			}
+			mu.Lock()
+			pending, err := o.CloseObserved()
+			mu.Unlock()
+			if err == nil || pending.Finalized() || !pending.Snapshot().Pending || f.closeCalls != 0 {
+				t.Fatal("busy lock entered native close")
+			}
+			final, err := o.CloseObserved()
+			if err != nil || !final.Finalized() || !final.Snapshot().Complete || f.closeCalls != 1 {
+				t.Fatalf("pre-entry close did not retry: %v", err)
+			}
+		})
+	}
+	f := newRustMemberScript(t)
+	o := f.acquire(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	f.onClose = cancel
+	proof, err := o.closeObserved(ctx)
+	if !errors.Is(err, context.Canceled) || !proof.Finalized() || !proof.Snapshot().Complete {
+		t.Fatalf("late caller cancellation changed finality: %v", err)
+	}
+	fresh, err := o.CloseObserved()
+	if err != nil || fresh != proof || f.closeCalls != 1 {
+		t.Fatalf("caller cancellation became retained verdict: %v", err)
+	}
+}

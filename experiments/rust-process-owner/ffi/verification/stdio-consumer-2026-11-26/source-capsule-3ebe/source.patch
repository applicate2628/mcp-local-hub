+// Qualification belongs to this marked test executable and its actual adjacent
+// admitted DLL/child tuple. It is not an installed Product qualification claim.
+func TestRustOwnerForegroundNativeMarkedReceiver(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		mode          string
+		hookPolicy    string
+		wantExit      int
+		wantCancelled bool
+	}{
+		{name: "unbounded-exit-37", mode: "exit", wantExit: 37},
+		{name: "deny-before-resume", mode: "exit", hookPolicy: "deny", wantExit: int(rustContainedStopCode)},
+		{name: "cancel-inside-hook", mode: "exit", hookPolicy: "cancel", wantExit: int(rustContainedStopCode), wantCancelled: true},
+		{name: "panic-hook", mode: "exit", hookPolicy: "panic", wantExit: int(rustContainedStopCode)},
+		{name: "detach-ready", mode: "detach-ready", hookPolicy: "allow", wantExit: 7},
+		{name: "lifetime-cancel", mode: "block", hookPolicy: "allow", wantExit: int(rustContainedStopCode), wantCancelled: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			selected, err := ProductRustOwnerEnabled()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !selected {
+				t.Skip("requires a marked Product test executable and qualified native tuple")
+			}
+			f := newRustFacadeNativeFixture(t)
+			if !runtimeidentity.IsWindowsProcessOwnerBorrowExportProfileV1(f.library.identity.Exports) {
+				t.Fatal("foreground qualification requires the 18-export original-process borrow profile")
+			}
+			initialLibrary := f.library
+			if err := initialLibrary.Close(); err != nil {
+				t.Fatal(err)
+			}
+			f.library = nil // The public receiver must open its own admitted bundle.
+			pipes := f.pipes(t)
+			f.closeFile(t, pipes.input)
+			beforeFlags := rustIONativeStreamFlags(t, pipes.streams)
+			cmd := rustFacadeNativeCommand(f, tc.mode)
+			cmd.Args[0] = "foreground-child.exe"
+			if tc.mode == "exit" {
+				cmd.Args = append(cmd.Args, "37", "foreground-37")
+			}
+			originalArgs := append([]string(nil), cmd.Args...)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if _, bounded := ctx.Deadline(); bounded {
+				t.Fatal("fixture accidentally bounded the foreground lifetime")
+			}
+
+			var original *AtCreateJobProcess
+			var captured *rustContainedChild
+			var admission *foregroundTestAdmission
+			var borrowChecks int
+			denied := errors.New("native foreground admission denied")
+			const panicDetail = "private native foreground hook detail"
+			if tc.hookPolicy != "" {
+				admission = &foregroundTestAdmission{
+					hook: func(p *AtCreateJobProcess) error {
+						child, ok := p.child.(*rustContainedChild)
+						if !ok || child == nil || child.owner == nil || !child.ownsLibrary {
+							return errors.New("marked foreground hook did not receive the original Rust owner")
+						}
+						original, captured = p, child
+						// Failure recovery keeps this exact owner; no PID reopen or
+						// replacement owner participates in the test.
+						f.owner, f.library = child.owner, child.library
+						if err := rustForegroundNativeBorrowBeforeResume(p, f.marker); err != nil {
+							return err
+						}
+						borrowChecks++
+						switch tc.hookPolicy {
+						case "deny":
+							return denied
+						case "cancel":
+							cancel()
+							return nil // The creator must sample cancellation before admit.
+						case "panic":
+							panic(panicDetail)
+						}
+						return nil
+					},
+					close: func() error {
+						if captured == nil {
+							return errors.New("foreground admission closed without retained original")
+						}
+						captured.mu.Lock()
+						defer captured.mu.Unlock()
+						if !captured.closeReturned || !captured.nativeCloseKnown || !captured.libraryClosed {
+							return errors.New("foreground admission closed before original native settlement")
+						}
+						return nil
+					},
+				}
+			}
+
+			var markerWatch *rustIONativeWork
+			var cancelWatch context.CancelFunc
+			if tc.name == "lifetime-cancel" {
+				watchCtx, stopWatch := context.WithTimeout(context.Background(), 5*time.Second)
+				cancelWatch = stopWatch
+				defer stopWatch()
+				// This bounded fixture worker observes only its owned marker.
+				// Production foreground execution creates no observer worker.
+				markerWatch = f.begin(func() rustIONativeResult {
+					defer cancel()
+					for {
+						data, err := os.ReadFile(f.marker)
+						if err == nil && bytes.Equal(data, []byte("ready")) {
+							return rustIONativeResult{n: 1}
+						}
+						if err != nil && !os.IsNotExist(err) {
+							return rustIONativeResult{err: err}
+						}
+						select {
+						case <-watchCtx.Done():
+							return rustIONativeResult{err: watchCtx.Err()}
+						case <-time.After(2 * time.Millisecond):
+						}
+					}
+				})
+			}
+
+			var result ForegroundResult
+			if admission == nil {
+				result, err = RunForeground(ctx, cmd, pipes.streams.Stdin, pipes.streams.Stdout, pipes.streams.Stderr)
+			} else {
+				result, err = RunForegroundAdmitted(ctx, cmd, pipes.streams.Stdin, pipes.streams.Stdout, pipes.streams.Stderr, admission)
+			}
+			if captured == nil && result.Original != nil {
+				captured, _ = result.Original.child.(*rustContainedChild)
+				original = result.Original
+				if captured != nil {
+					f.owner, f.library = captured.owner, captured.library
+				}
+			}
+			if markerWatch != nil {
+				cancelWatch()
+				watched := markerWatch.await(t, rustIONativeContext(t))
+				if watched.err != nil || watched.n != 1 {
+					t.Fatalf("lifetime cancellation was not driven by the owned child marker: %+v", watched)
+				}
+			}
+			if result.Job != nil || result.Original == nil || result.Original != original ||
+				captured == nil || result.Original.child != captured || captured.library == initialLibrary {
+				t.Fatalf("public marked receiver changed original custody or allocated a Go Job: err=%v", err)
+			}
+			if got := rustIONativeStreamFlags(t, pipes.streams); got != beforeFlags {
+				t.Fatalf("foreground closed or changed caller standard handles: before=%v after=%v", beforeFlags, got)
+			}
+			if cmd.Path != f.child || cmd.Dir != f.cwd || !reflect.DeepEqual(cmd.Args, originalArgs) ||
+				cmd.Env == nil || len(cmd.Env) != 0 || cmd.Process != nil || cmd.ProcessState != nil ||
+				cmd.Stdin != nil || cmd.Stdout != nil || cmd.Stderr != nil {
+				t.Fatal("foreground receiver mutated the caller command or manufactured Go process state")
+			}
+			switch tc.hookPolicy {
+			case "deny":
+				if !errors.Is(err, denied) {
+					t.Fatalf("pre-resume denial was lost: %v", err)
+				}
+			case "cancel":
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("pre-admit cancellation was lost: %v", err)
+				}
+			case "panic":
+				if err == nil || !strings.Contains(err.Error(), "pre-resume admission panicked") || strings.Contains(err.Error(), panicDetail) {
+					t.Fatalf("admission panic was not contained with fixed diagnostics: %v", err)
+				}
+			default:
+				if tc.wantCancelled {
+					if !errors.Is(err, context.Canceled) {
+						t.Fatalf("running child cancellation was lost: %v", err)
+					}
+				} else if err != nil {
+					t.Fatalf("foreground root exit became an execution error: %v", err)
+				}
+			}
+			if result.Cancelled != tc.wantCancelled {
+				t.Fatalf("foreground cancellation classification=%t, want %t", result.Cancelled, tc.wantCancelled)
+			}
+			rustForegroundNativeAssertSettlement(t, captured, result, tc.wantExit)
+
+			if admission != nil {
+				if admission.hooks != 1 || admission.closes != 1 || borrowChecks != 1 || result.Admission != admission ||
+					!result.AdmissionCloseAttempted || result.AdmissionCloseError != nil ||
+					!result.Outcome.AdmissionPresent || !result.Outcome.AdmissionCloseAttempted || result.Outcome.AdmissionCloseError != nil {
+					t.Fatalf("admission/borrow lifetime changed: hooks=%d closes=%d borrows=%d outcome=%+v",
+						admission.hooks, admission.closes, borrowChecks, result.Outcome)
+				}
+			} else if result.Admission != nil || result.AdmissionCloseAttempted || result.Outcome.AdmissionPresent {
+				t.Fatal("plain foreground receiver fabricated creation admission")
+			}
+			switch tc.name {
+			case "deny-before-resume", "cancel-inside-hook", "panic-hook":
+				rustIONativeAbsent(t, f.marker)
+			case "unbounded-exit-37":
+				data, readErr := os.ReadFile(f.marker)
+				if readErr != nil || string(data) != "foreground-37" {
+					t.Fatalf("actual exit-37 child did not execute its fixture: data=%q err=%v", data, readErr)
+				}
+			case "detach-ready":
+				data, readErr := os.ReadFile(f.marker + ".grandchild")
+				if readErr != nil || string(data) != "ready" || result.Native.TerminalAction != string(creatorTerminalRequestSucceeded) {
+					t.Fatalf("live descendant was not ready before aggregate termination: data=%q action=%s err=%v",
+						data, result.Native.TerminalAction, readErr)
+				}
+			case "lifetime-cancel":
+				if result.Native.TerminalAction != string(creatorTerminalRequestSucceeded) {
+					t.Fatalf("running child cancellation lacked native stop: %+v", result.Native)
+				}
+			}
+			if replay := result.Original.WaitOriginalContext(context.Background()); !replay.Known || replay.ExitCode != tc.wantExit || replay.Error != nil {
+				t.Fatalf("released original lost its cached root result: %+v", replay)
+			}
+			// The three caller handles were still open above. Close them only
+			// now, then require natural EOF from the actual inherited endpoints.
+			f.closeChildEnds(t, pipes)
+			outputCtx := rustIONativeContext(t)
+			rustIONativeOutput(t, outputCtx, f.read(pipes.stdout), nil)
+			rustIONativeOutput(t, outputCtx, f.read(pipes.stderr), nil)
+		})
+	}
+}
+
+// This callback never retains, closes, duplicates or reopens the handle, and
+// never resumes a thread. Identity is captured before entering the ABI borrow.
+func rustForegroundNativeBorrowBeforeResume(original *AtCreateJobProcess, marker string) error {
+	identity, err := original.Identity()
+	if err != nil || !original.Created() || !identity.Known || identity.PID <= 0 || identity.NativeBirthFILETIME == 0 {
+		return errors.Join(err, errors.New("original suspended identity unavailable"))
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		return fmt.Errorf("child marker exists before original resume: %v", err)
+	}
+	err = original.BorrowOriginalProcessHandle(func(handle uintptr) error {
+		pid, err := windows.GetProcessId(windows.Handle(handle))
+		if err != nil || pid != uint32(identity.PID) {
+			return errors.Join(err, errors.New("borrowed handle differs from original identity"))
+		}
+		state, err := windows.WaitForSingleObject(windows.Handle(handle), 0)
+		if err != nil || state != uint32(windows.WAIT_TIMEOUT) {
+			return errors.Join(err, errors.New("borrowed original is already signaled before admission"))
+		}
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		return fmt.Errorf("child executed during read-only original borrow: %v", err)
+	}
+	return nil
+}
+
+func rustForegroundNativeAssertSettlement(t *testing.T, child *rustContainedChild, result ForegroundResult, wantExit int) {
+	t.Helper()
+	if !result.Original.Created() || !result.Root.Known || result.Root.ExitCode != wantExit || result.Root.Error != nil ||
+		result.Settlement == nil || !result.Settlement.Complete() || result.Settlement.owner != child {
+		t.Fatalf("foreground original wait/settlement incomplete: root=%+v native=%+v pending=%v", result.Root, result.Native, result.Outcome.Pending)
+	}
+	native := result.Settlement.Snapshot()
+	if !result.Native.OriginalJobExited || !native.OriginalJobExited || !native.RootIdentity.Known ||
+		!native.RootWaitKnown || native.RootExitCode != wantExit || !native.HandlesClosed || native.Error != nil ||
+		native.NoChildKnown || native.MembersExited || native.AccountingKnown || native.InitialTotal != 0 ||
+		native.FinalActive != 0 || len(native.CapturedMemberPIDs) != 0 {
+		t.Fatalf("native aggregate proof lost root result or fabricated member census: %+v", native)
+	}
+	if result.Native.MembersExited || result.Native.AccountingKnown || len(result.Native.CapturedMemberPIDs) != 0 {
+		t.Fatalf("foreground native view fabricated individual members: %+v", result.Native)
+	}
+	child.mu.Lock()
+	closeKnown, closed := child.nativeCloseKnown, child.nativeCloseOutcome
+	closeEntered, closeReturned, closeErr := child.closeEntered, child.closeReturned, child.closeError
+	libraryAcquired, libraryAttempted, libraryClosed, libraryErr := child.libraryAcquired, child.libraryCloseAttempted, child.libraryClosed, child.libraryCloseError
+	child.mu.Unlock()
+	if !closeKnown || !closeEntered || !closeReturned || closeErr != nil || closed.Size != 48 || closed.Version != 1 ||
+		closed.State != 2 || closed.Flags != 1 || closed.PID != uint32(native.RootIdentity.PID) ||
+		closed.RootExit != uint32(wantExit) || closed.Active != 0 || closed.CleanupMask != 0 ||
+		closed.CleanupCodes != ([3]int32{}) || closed.NativeError != 0 {
+		t.Fatalf("original native close slots were not confirmed: known=%t entered=%t returned=%t outcome=%+v err=%v",
+			closeKnown, closeEntered, closeReturned, closed, closeErr)
+	}
+	if child.owner == nil || child.owner.raw != 0 || !child.waitStarted.Load() || !child.waitReturned.Load() ||
+		child.library == nil || child.library.handle != 0 || !child.library.closeAttempted || child.library.activeOwners.Load() != 0 ||
+		!libraryAcquired || !libraryAttempted || !libraryClosed || libraryErr != nil {
+		t.Fatal("foreground did not consume its own native allocation, sole wait and library")
+	}
+	outcome := result.Outcome
+	if !outcome.AcquisitionEntered || !outcome.JobAcquired || !outcome.OriginalAcquired || !outcome.ChildObservationKnown ||
+		!outcome.Identity.Known || outcome.Identity.PID != native.RootIdentity.PID || outcome.IdentityError != nil || len(outcome.Pending) != 0 {
+		t.Fatalf("foreground outcome lost original acquisition or closure: %+v", outcome)
+	}
+	for name, slot := range map[string]ForegroundCloseObservation{
+		"thread": outcome.ThreadClose, "process": outcome.ProcessClose, "job": outcome.JobClose, "library": outcome.LibraryClose,
+	} {
+		if !slot.AcquiredKnown || !slot.Acquired || !slot.CloseAttempted || !slot.ClosedKnown || !slot.Closed || slot.Error != nil {
+			t.Fatalf("foreground %s close is unproved: %+v", name, slot)
+		}
+	}
+	if !outcome.WrapperClose.AcquiredKnown || outcome.WrapperClose.Acquired || outcome.WrapperClose.CloseAttempted ||
+		outcome.AttributesPresent || !reflect.DeepEqual(outcome.Attributes, ProcThreadAttributeListCloseObservation{}) ||
+		outcome.MemberObservationPresent || !reflect.DeepEqual(outcome.Members, CreatorJobObservation{}) ||
+		outcome.MemberPolicyError != nil || len(outcome.Inherited) != 0 {
+		t.Fatalf("Rust aggregate owner fabricated Go wrappers, attributes or member observations: %+v", outcome)
+	}
+}

@@ -0,0 +1,96 @@
+package api
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"mcp-local-hub/internal/process"
+)
+
+func TestPreparedSerenaFailureDiagnosticsRequireOriginalSettlement(t *testing.T) {
+	for _, synthetic := range []bool{false, true} {
+		name := "zero-receipt"
+		if synthetic {
+			name = "synthetic-closure"
+		}
+		t.Run(name, func(t *testing.T) {
+			result := preparedSerenaCommandResult{Stdout: []byte("private stdout"), Stderr: []byte("private stderr")}
+			if synthetic {
+				result.Closure = fakeClosure("synthetic-operation")
+				result.Receipt.NativeSettlement = &process.ContainedProcessSettlement{}
+				result.Receipt.RootWaitKnown, result.Receipt.RootExitCode = true, 7
+			}
+			cause := &preparedSerenaCommandFailure{
+				cause: errors.New("original refusal"), stage: preparedSerenaUVInstallFailure,
+				executable: PreparedSerenaFile{SHA256: strings.Repeat("a", 64)}, result: result,
+			}
+			got := PreparedSerenaFailureDiagnostics(cause)
+			if len(got) != 1 || got[0].NativeComplete || got[0].Stdout != nil || got[0].Stderr != nil {
+				t.Fatal("non-original settlement exposed stream data")
+			}
+		})
+	}
+}
+
+func TestPreparedSerenaFailureDiagnosticsSelectLatestInputProbe(t *testing.T) {
+	version := &preparedSerenaCommandResult{Closure: PreparedSerenaExecutionClosure{OriginalOperationID: "version-operation"}}
+	find := &preparedSerenaCommandResult{Closure: PreparedSerenaExecutionClosure{OriginalOperationID: "find-operation"}}
+	abi := &preparedSerenaCommandResult{Closure: PreparedSerenaExecutionClosure{OriginalOperationID: "abi-operation"}}
+	uv, interpreter := strings.Repeat("a", 64), strings.Repeat("b", 64)
+	for _, tc := range []struct {
+		name, stage, operation, executable string
+		version, find, abi                 *preparedSerenaCommandResult
+	}{
+		{name: "none"},
+		{name: "version", stage: "uv-version", operation: "version-operation", executable: uv, version: version},
+		{name: "find", stage: "python-find", operation: "find-operation", executable: uv, version: version, find: find},
+		{name: "interpreter", stage: "interpreter-abi", operation: "abi-operation", executable: interpreter, version: version, find: find, abi: abi},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			input := &serenaPreparationInputsError{cause: errors.New("input refusal"), inputs: SerenaPreparationInputs{
+				qualifiedUV: PreparedSerenaFile{SHA256: uv}, qualifiedInterpreter: PreparedSerenaFile{SHA256: interpreter},
+				uvVersionProbe: tc.version, pythonFindProbe: tc.find, interpreterProbe: tc.abi,
+			}}
+			got := PreparedSerenaFailureDiagnostics(fmt.Errorf("outer: %w", input))
+			if tc.stage == "" {
+				if len(got) != 0 {
+					t.Fatal("missing original probe fabricated a diagnostic")
+				}
+				return
+			}
+			if len(got) != 1 || got[0].Stage != tc.stage || got[0].OperationID != tc.operation || got[0].ExecutableSHA256 != tc.executable {
+				t.Fatal("latest original input probe or executable binding lost")
+			}
+			if got[0].Stdout != nil || got[0].Stderr != nil {
+				t.Fatal("unsettled input probe exposed captures")
+			}
+		})
+	}
+}
+
+func TestPreparedSerenaFailureDiagnosticsPreserveCause(t *testing.T) {
+	primary, cleanup := errors.New("original command cause"), errors.New("original cleanup cause")
+	joined := errors.Join(primary, cleanup)
+	first := &preparedSerenaCommandFailure{
+		cause: joined, stage: preparedSerenaUVInstallFailure,
+		result: preparedSerenaCommandResult{Stdout: []byte("private-output-marker")},
+	}
+	if first.Error() != joined.Error() || !errors.Is(first, primary) || !errors.Is(first, cleanup) || strings.Contains(first.Error(), "private-output-marker") {
+		t.Fatal("diagnostic carrier changed errors or leaked stream content")
+	}
+	wrapped := fmt.Errorf("outer: %w", first)
+	var received *preparedSerenaCommandFailure
+	if !errors.As(wrapped, &received) || received != first {
+		t.Fatal("original error carrier not retained")
+	}
+	second := &preparedSerenaCommandFailure{cause: cleanup, stage: preparedSerenaMetadataFailure}
+	got := PreparedSerenaFailureDiagnostics(errors.Join(wrapped, second, wrapped))
+	if len(got) != 2 || got[0].Stage != "uv-install" || got[1].Stage != "metadata" {
+		t.Fatal("distinct joined failures lost or repeated carrier duplicated")
+	}
+	if len(PreparedSerenaFailureDiagnostics(nil)) != 0 || len(PreparedSerenaFailureDiagnostics(primary)) != 0 {
+		t.Fatal("ordinary error fabricated command diagnostics")
+	}
+}

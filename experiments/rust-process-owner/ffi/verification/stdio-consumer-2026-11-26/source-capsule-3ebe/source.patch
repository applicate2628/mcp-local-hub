--- /dev/null
+++ b/internal/process/contained_stream_product.go
@@ -0,0 +1,19 @@
+package process
+
+import (
+	"context"
+	"os/exec"
+)
+
+// Select before acquiring a Go Job. A present but unusable Product Rust mark
+// is a containment failure; it never selects a second process owner.
+func newContainedStreamChild(ctx context.Context, cmd *exec.Cmd) (containedChild, error) {
+	selected, err := ProductRustOwnerEnabled()
+	if err != nil {
+		return nil, err
+	}
+	if selected {
+		return newProductRustContainedChild(ctx, cmd)
+	}
+	return newPlatformContainedChild(cmd)
+}
diff --git a/internal/process/contained_stream_start_failure_test.go b/internal/process/contained_stream_start_failure_test.go

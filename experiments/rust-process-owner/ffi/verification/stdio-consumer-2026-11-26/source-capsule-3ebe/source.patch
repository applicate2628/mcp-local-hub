+func TestRustOwnerSplitCloseContentionKeepsOriginalDeadline(t *testing.T) {
+	for _, holdLibrary := range []bool{false, true} {
+		name := "owner"
+		if holdLibrary {
+			name = "library"
+		}
+		t.Run(name, func(t *testing.T) {
+			seen := make(chan struct{}, 1)
+			closes := 0
+			wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 51, RootExit: 5}
+				select {
+				case seen <- struct{}{}:
+				default:
+				}
+				return 0
+			})
+			closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+				closes++
+				*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 51, RootExit: 5}
+				return 0
+			})
+			owner := &rustNativeOwner{raw: 0x5151, memberGate: newOriginalMemberCustody(),
+				library: &rustOwnerLibrary{ready: true,
+					procedures: map[string]uintptr{"mh_wait1": wait, "mh_close1": closeExited}}}
+			owner.library.activeOwners.Store(1)
+			leave, err := owner.memberGate.enterQuery(nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			deadline, _ := ctx.Deadline()
+			type completion struct {
+				value rustOwnerOutcome
+				err   error
+			}
+			done := make(chan completion, 1)
+			lock := &owner.mu
+			if holdLibrary {
+				lock = &owner.library.mu
+			}
+			held, joined := false, false
+			t.Cleanup(func() {
+				cancel()
+				leave()
+				if held {
+					lock.Unlock()
+				}
+				if !joined {
+					select {
+					case <-done:
+					case <-time.After(time.Second):
+						t.Error("original completion goroutine did not join")
+					}
+				}
+			})
+			go func() {
+				value, err := owner.FinishWithin(ctx)
+				done <- completion{value, err}
+			}()
+			select {
+			case <-seen:
+			case <-ctx.Done():
+				t.Fatal("native exit observation did not start")
+			}
+			lock.Lock()
+			held = true
+			leave()
+			for {
+				owner.memberGate.mu.Lock()
+				permitted := owner.memberGate.terminalActive
+				owner.memberGate.mu.Unlock()
+				if permitted {
+					break
+				}
+				if err := ctx.Err(); err != nil {
+					t.Fatalf("query did not drain outside native locks: %v", err)
+				}
+				runtime.Gosched()
+			}
+			cancel()
+			var finished completion
+			select {
+			case finished = <-done:
+				joined = true
+			case <-time.After(time.Second):
+				t.Fatal("canceled close remained blocked on native lock")
+			}
+			if !errors.Is(finished.err, context.Canceled) || finished.value.State != 0 ||
+				finished.value.RootExit != 5 || closes != 0 || owner.closeStarted || owner.raw != 0x5151 {
+				t.Fatalf("canceled close acquired authority or lost custody: result=%+v err=%v closes=%d",
+					finished.value, finished.err, closes)
+			}
+			owner.memberGate.mu.Lock()
+			active, savedDeadline := owner.memberGate.terminalActive, owner.memberGate.terminalDeadline
+			owner.memberGate.mu.Unlock()
+			if active || !savedDeadline.Equal(deadline) {
+				t.Fatal("permit leaked or terminal deadline changed")
+			}
+			lock.Unlock()
+			held = false
+			renewed, cancelRenewed := context.WithTimeout(context.Background(), 10*time.Second)
+			_, renewedErr := owner.FinishWithin(renewed)
+			cancelRenewed()
+			if renewedErr == nil || closes != 0 || owner.closeStarted {
+				t.Fatalf("fresh context renewed original terminal budget: err=%v closes=%d", renewedErr, closes)
+			}
+			result, err := owner.Finish(0)
+			if err != nil || result.State != 2 || result.RootExit != 5 || closes != 1 {
+				t.Fatalf("explicit close after contention failed: result=%+v err=%v closes=%d", result, err, closes)
+			}
+		})
+	}
+}

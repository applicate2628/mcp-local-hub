+#[test]
+fn empty_original_job_preserves_zero_resource_reservation_until_close_and_historical_copy() {
+    let mut owner = suspended_owner();
+    let birth = owner.inner.original_creation_time_100ns().unwrap();
+    let pid = owner.inner.root_pid();
+    owner.inner.admit_and_resume(|_| Ok(())).unwrap();
+    assert_eq!(
+        owner.inner.wait_for_exit(Duration::from_secs(3)).unwrap(),
+        ExitObservation::Exited { root_exit: 0 }
+    );
+    let (status, generation, report, out) = observe(&mut owner, 1000);
+    assert_ne!(
+        generation, 0,
+        "a failed empty-census acquisition still reserved"
+    );
+    assert_eq!(
+        (status, report.error_source, report.error_kind),
+        (STATE, SOURCE_OBSERVATION, ERROR_INVALID_DATA)
+    );
+    assert_eq!((out.state, out.native_error, out.cleanup_mask), (0, 0, 0));
+    let native = owner.inner.job_member_snapshot().unwrap();
+    assert_eq!(native.generation, generation);
+    assert!(!native.complete && native.rows.is_empty() && native.resources.is_empty());
+    assert_eq!(
+        owner.inner.close_exited().unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+    let (status, before, report, _) = snapshot(&mut owner, generation);
+    assert_eq!(
+        (status, before.calls, report.error_source),
+        (OK, 1, SOURCE_NONE)
+    );
+    let before = before.value.unwrap();
+    assert_eq!(
+        before.original,
+        OriginalCreation {
+            pid,
+            reserved: 0,
+            creation_time_100ns: birth
+        }
+    );
+    assert_eq!(before.flags, PRE_KNOWN);
+    assert_eq!(before.pre.active, 0);
+    assert!(before.pre.pids.is_empty() && before.rows.is_empty() && before.resources.is_empty());
+
+    let (status, finalized, receipt, _, _) = close(&mut owner, generation);
+    assert_eq!((status, finalized, receipt.calls), (OK, 1, 1));
+    let receipt = receipt.value.unwrap();
+    assert_eq!(receipt.flags, CLOSE_COMPLETE);
+    assert!(receipt.resources.is_empty());
+    assert!(!owner.terminal);
+    let mut out = Outcome::default();
+    // SAFETY: the real caller-owned Box is only borrowed; mh_close1 closes
+    // original handles but does not free the allocation (no mh_release1 here).
+    assert_eq!(
+        unsafe { crate::mh_close1(&mut *owner, &mut out, OUT_BYTES) },
+        OK
+    );
+    assert!(owner.terminal);
+    assert_eq!(out.state, crate::COMPLETE);
+    let (status, after, report, out) = snapshot(&mut owner, generation);
+    assert_eq!(
+        (status, after.calls, report.error_source),
+        (OK, 1, SOURCE_NONE)
+    );
+    assert!(
+        before == after.value.unwrap(),
+        "historical copy must work with original handles closed"
+    );
+    assert_eq!((out.state, out.root_exit), (0, 0));
+    let (status, finalized, replay, _, _) = close(&mut owner, generation);
+    assert_eq!((status, finalized, replay.calls), (OK, 1, 1));
+    assert_eq!(receipt, replay.value.unwrap());
+}

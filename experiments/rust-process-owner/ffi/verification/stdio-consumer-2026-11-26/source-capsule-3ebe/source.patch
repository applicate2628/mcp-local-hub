+// These callbacks wrap the actual marked production factory. No callback
+// fabricates a native owner, outcome, identity or settlement.
+func TestStdioRustOriginalRetainsBeforeActualCreate(t *testing.T) {
+	for _, refuse := range []bool{false, true} {
+		name := "accepted"
+		if refuse {
+			name = "refused"
+		}
+		t.Run(name, func(t *testing.T) {
+			h, root := newStdioRustOriginalHost(t, "echo")
+			refusal := errors.New("host receiver refused the retained original")
+			var retained, returned *process.AtCreateJobProcess
+			var callbackError error
+			factoryCalls, retainCalls := 0, 0
+			h.originalLaunch = &stdioOriginalLaunchOps{
+				startRust: func(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+					retain func(*process.AtCreateJobProcess) error) (*process.AtCreateJobProcess, error) {
+					factoryCalls++
+					var err error
+					returned, err = process.StartProductRustOriginal(ctx, cmd, stdin, stdout, stderr,
+						func(p *process.AtCreateJobProcess) error {
+							retainCalls++
+							retained = p
+							if p == nil || p.Created() {
+								callbackError = errors.New("retention followed actual creation")
+								return callbackError
+							}
+							if err := retain(p); err != nil {
+								callbackError = err
+								return err
+							}
+							// Start holds h.mu while invoking this callback.
+							if h.original == nil || h.original.original != p || p.Created() {
+								callbackError = errors.New("host did not retain the same pre-create facade")
+								return callbackError
+							}
+							if refuse {
+								return refusal
+							}
+							return nil
+						})
+					return returned, err
+				},
+			}
+			startErr := h.Start(context.Background())
+			if callbackError != nil || factoryCalls != 1 || retainCalls != 1 ||
+				retained == nil || returned != retained {
+				t.Fatalf("actual factory retention: retained=%p returned=%p factory=%d retain=%d callback=%v start=%v",
+					retained, returned, factoryCalls, retainCalls, callbackError, startErr)
+			}
+			if refuse {
+				if !errors.Is(startErr, refusal) {
+					t.Fatalf("retention refusal cause was lost: %v", startErr)
+				}
+				result := stdioRustOriginalNoChild(t, h, retained)
+				if !errors.Is(result.PrimaryError, refusal) {
+					t.Fatalf("retention refusal disappeared from the host receipt: %+v", result)
+				}
+				if _, err := os.Stat(filepath.Join(root, "root-ready")); !errors.Is(err, os.ErrNotExist) {
+					t.Fatal("refused pre-create helper executed")
+				}
+				return
+			}
+			if startErr != nil {
+				t.Fatal(startErr)
+			}
+			originalTestBarrier(t, filepath.Join(root, "root-ready"))
+			owner := stdioRustOriginalOwner(t, h)
+			if owner.original != retained {
+				t.Fatal("successful creation replaced the pre-create facade")
+			}
+			stdioRustOriginalRPC(t, h, "retained-before-create")
+			stdioRustOriginalComplete(t, h, owner)
+			stdioRustOriginalFilesClosed(t, h)
+		})
+	}
+}

+func TestRustOwnerSplitCloseUsesUint32Status(t *testing.T) {
+	terminal := rustOwnerOutcome{Size: 48, Version: 1, State: 2, Flags: 3, PID: 73, RootExit: 259}
+	wait := syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 73, RootExit: 259}
+		return 0
+	})
+	closeExited := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		*out = terminal
+		// The ABI returns uint32. Windows x64 leaves the other bits undefined.
+		return uintptr(1) << 32
+	})
+	owner := &rustNativeOwner{
+		library: &rustOwnerLibrary{ready: true, procedures: map[string]uintptr{
+			"mh_wait1": wait, "mh_close1": closeExited,
+		}},
+		raw: 0x7531, memberGate: newOriginalMemberCustody(),
+	}
+	owner.library.activeOwners.Store(1)
+	result, err := owner.Finish(0)
+	if err != nil || result != terminal {
+		t.Fatalf("unused status bits changed valid close: result=%+v err=%v", result, err)
+	}
+}

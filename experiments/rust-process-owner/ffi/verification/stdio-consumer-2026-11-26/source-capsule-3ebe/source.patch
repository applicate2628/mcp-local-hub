+	}
+	raw, err := os.ReadFile(valid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hash := sha256.Sum256(raw)
+	if identity.Schema != WindowsRuntimeLibraryIdentitySchemaV1 || identity.Filename != "mcphub-owner.dll" ||
+		identity.SourceCommit != runtimeLibrarySourceCommit || identity.Machine != 0x8664 ||
+		identity.SHA256 != hex.EncodeToString(hash[:]) || !reflect.DeepEqual(identity.Exports, exports) {
+		t.Fatalf("identity=%+v", identity)
+	}
+
+	for _, tc := range []struct {
+		name            string
+		machine         uint16
+		characteristics uint16
+		exports         []string
+		mutate          func([]byte)
+		want            string
+	}{
+		{name: "wrong machine", machine: 0xaa64, characteristics: 0x2002, exports: exports, want: "machine"},
+		{name: "not a DLL", machine: 0x8664, characteristics: 0x0002, exports: exports, want: "DLL"},
+		{name: "missing export", machine: 0x8664, characteristics: 0x2002, exports: exports[:len(exports)-1], want: "export count"},
+		{name: "extra export", machine: 0x8664, characteristics: 0x2002, exports: append(append([]string(nil), exports...), "mh_unknown1"), want: "export count"},
+		{name: "malformed name RVA", machine: 0x8664, characteristics: 0x2002, exports: exports, mutate: func(data []byte) {
+			binary.LittleEndian.PutUint32(data[0x280:0x284], 0xfffffff0)
+		}, want: "export name"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			path := writeWindowsRuntimeLibraryFixture(t, tc.machine, tc.characteristics, tc.exports, tc.mutate)

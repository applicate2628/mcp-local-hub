+// Native mount-point layout and exact readback follow JunctionBytes/Junction in
+// scripts/test-recovery-namespace/helper.ps1. No command interpreter or elevation
+// is required. Only new leaves inside this test's private root may be created.
+func serenaInterpreterJunctionForTest(t *testing.T, root, link, target string) {
+	t.Helper()
+	for _, path := range []string{link, target} {
+		relative, err := filepath.Rel(root, path)
+		if err != nil || relative == "." || !filepath.IsLocal(relative) {
+			t.Fatalf("junction fixture escaped its own root: %q", path)
+		}
+	}
+	if err := os.Mkdir(link, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.Remove(link); err != nil && !os.IsNotExist(err) {
+			t.Errorf("remove original junction fixture leaf: %v", err)
+		}
+	})
+	name, err := windows.UTF16PtrFromString(`\\?\` + link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := windows.CreateFile(name, windows.GENERIC_WRITE|windows.FILE_READ_ATTRIBUTES,
+		windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE|windows.FILE_SHARE_DELETE, nil, windows.OPEN_EXISTING,
+		windows.FILE_FLAG_OPEN_REPARSE_POINT|windows.FILE_FLAG_BACKUP_SEMANTICS, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := windows.CloseHandle(handle); err != nil {
+			t.Errorf("close original junction fixture handle: %v", err)
+		}
+	}()
+	substitute, printName := utf16.Encode([]rune(`\??\`+target)), utf16.Encode([]rune(target))
+	data := make([]byte, 20+2*(len(substitute)+len(printName)))
+	if len(data) > 16<<10 {
+		t.Fatal("junction fixture target exceeds native buffer")
+	}
+	binary.LittleEndian.PutUint32(data[0:4], windows.IO_REPARSE_TAG_MOUNT_POINT)
+	binary.LittleEndian.PutUint16(data[4:6], uint16(len(data)-8))
+	binary.LittleEndian.PutUint16(data[10:12], uint16(2*len(substitute)))
+	binary.LittleEndian.PutUint16(data[12:14], uint16(2*len(substitute)+2))
+	binary.LittleEndian.PutUint16(data[14:16], uint16(2*len(printName)))
+	for i, c := range substitute {
+		binary.LittleEndian.PutUint16(data[16+2*i:], c)
+	}
+	for i, c := range printName {
+		binary.LittleEndian.PutUint16(data[18+2*len(substitute)+2*i:], c)
+	}
+	var count uint32
+	if err := windows.DeviceIoControl(handle, windows.FSCTL_SET_REPARSE_POINT, &data[0], uint32(len(data)), nil, 0, &count, nil); err != nil {
+		t.Fatalf("required native junction fixture unavailable: %v", err)
+	}
+	readback := make([]byte, 16<<10)
+	if err := windows.DeviceIoControl(handle, windows.FSCTL_GET_REPARSE_POINT, nil, 0, &readback[0], uint32(len(readback)), &count, nil); err != nil {
+		t.Fatal(err)
+	}
+	if count != uint32(len(data)) || !bytes.Equal(readback[:count], data) {
+		t.Fatal("native junction readback differs from the created target")
+	}
+}

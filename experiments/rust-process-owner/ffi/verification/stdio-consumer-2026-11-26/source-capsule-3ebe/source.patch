+func TestRustOwnerRootWaitNativeObserversCancelIndependently(t *testing.T) {
+	owner, pid, markerDir := rustRootWaitNativeFixture(t, "TestRustOwnerOwnedChild", "rust-owner-owned-child")
+	waitEntered := make(chan struct{}, 1)
+	nativeWait := owner.library.procedures["mh_wait1"]
+	owner.library.procedures["mh_wait1"] = syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		select {
+		case waitEntered <- struct{}{}:
+		default:
+		}
+		// Preserve the real native operation; the barrier proves Stop meets
+		// an entered wait instead of winning before its first invocation.
+		status, _, _ := syscall.SyscallN(nativeWait, raw, ms, uintptr(unsafe.Pointer(out)), size)
+		runtime.KeepAlive(out)
+		return status
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	cancelled, cancelFirst := context.WithTimeout(context.Background(), 5*time.Second)
+	blocked := [2]chan struct{}{make(chan struct{}, 1), make(chan struct{}, 1)}
+	done := [2]chan rustRootWaitCompletion{make(chan rustRootWaitCompletion, 1), make(chan rustRootWaitCompletion, 1)}
+	joined := [2]bool{}
+	owner.mu.Lock()
+	held := true
+	t.Cleanup(func() {
+		cancelFirst()
+		cancel()
+		if held {
+			owner.mu.Unlock()
+		}
+		for i := range done {
+			if !joined[i] {
+				select {
+				case <-done[i]:
+				case <-time.After(2 * time.Second):
+					t.Errorf("native root observer %d did not join", i)
+				}
+			}
+		}
+	})
+	for i, parent := range []context.Context{cancelled, ctx} {
+		go func() {
+			result, err := owner.WaitRootWithin(rustRootWaitBlockedContext{parent, blocked[i]})
+			done[i] <- rustRootWaitCompletion{result, err}
+		}()
+	}
+	for i := range blocked {
+		select {
+		case <-blocked[i]:
+		case <-ctx.Done():
+			t.Fatalf("native root observer %d did not reach barrier", i)
+		}
+	}
+	cancelFirst()
+	select {
+	case got := <-done[0]:
+		joined[0] = true
+		if !errors.Is(got.err, context.Canceled) || got.result.Known {
+			t.Fatalf("cancelled native observer invented root exit: got=%+v err=%v", got.result, got.err)
+		}
+	case <-ctx.Done():
+		t.Fatal("first native observer did not cancel")
+	}
+	select {
+	case got := <-done[1]:
+		joined[1] = true
+		t.Fatalf("other observer ended while original root remained suspended: %+v %v", got.result, got.err)
+	default:
+	}
+	owner.mu.Unlock()
+	held = false
+	// The surviving observer is still waiting for this suspended original root.
+	// Stop must remain possible while that observer waits on the same owner.
+	select {
+	case <-waitEntered:
+	case <-ctx.Done():
+		t.Fatal("surviving observer did not enter original native wait")
+	}
+	if _, err := owner.Stop(19); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case got := <-done[1]:
+		joined[1] = true
+		if got.err != nil || got.result != (rustRootWaitResult{Known: true, PID: pid, ExitCode: 19}) {
+			t.Fatalf("first cancellation poisoned surviving observer: got=%+v err=%v", got.result, got.err)
+		}
+	case <-ctx.Done():
+		t.Fatal("surviving native observer did not observe root exit")
+	}
+	if _, err := os.Stat(filepath.Join(markerDir, "started")); !os.IsNotExist(err) {
+		t.Fatalf("suspended original child ran before Stop: %v", err)
+	}
+	if complete, err := owner.FinishWithin(ctx); err != nil || complete.State != 2 || complete.PID != pid || complete.RootExit != 19 {
+		t.Fatalf("native observer completion lost custody: got=%+v err=%v", complete, err)
+	}
+	if err := owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+}

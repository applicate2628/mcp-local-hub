+func TestCanonicalNativeExternalReplyRejectsCrossGenerationAndUnknownCustody(t *testing.T) {
+	cases := []struct {
+		name   string
+		change func(*canonicalnativefixture.Reply)
+	}{
+		{"different-run", func(r *canonicalnativefixture.Reply) { r.RunNonce = strings.Repeat("e", 64) }},
+		{"different-slot", func(r *canonicalnativefixture.Reply) { r.Slot = "successor" }},
+		{"different-case-nonce", func(r *canonicalnativefixture.Reply) { r.Bind.Nonce = strings.Repeat("f", 64) }},
+		{"different-absolute-end", func(r *canonicalnativefixture.Reply) { r.Bind.CleanupDeadline = "2026-11-20T12:00:41Z" }},
+		{"unknown", func(r *canonicalnativefixture.Reply) { r.Kind = "unknown" }},
+		{"refused", func(r *canonicalnativefixture.Reply) { r.Kind = "refused" }},
+		{"physical-incomplete", func(r *canonicalnativefixture.Reply) { r.PhysicalComplete = false }},
+		{"custody-retained", func(r *canonicalnativefixture.Reply) { r.CustodyRetained = true }},
+		{"sink-close-unreceived", func(r *canonicalnativefixture.Reply) { r.Stdout.Closed = false }},
+		{"other-slot-capture", func(r *canonicalnativefixture.Reply) {
+			r.Stdout.Path = filepath.Join(filepath.Dir(filepath.Dir(r.Stdout.Path)), "successor", "stdout.raw")
+		}},
+		{"wait-unreceived", func(r *canonicalnativefixture.Reply) { r.RootExitCode = -1 }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			request, reply, root := canonicalNativeExternalReplyData()
+			tc.change(&reply)
+			if err := validateCanonicalNativeExternalReply(request, reply, root); err == nil {
+				t.Fatal("foreign or unreceived control DATA unlocked the capture-read gate")
+			}

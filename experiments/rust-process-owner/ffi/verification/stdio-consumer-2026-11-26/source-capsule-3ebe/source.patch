+func newRustMemberNativeFixture(t *testing.T, mode string) rustMemberNativeFixture {
+	t.Helper()
+	product, commit, hash := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT"),
+		os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_COMMIT"), os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_SHA256")
+	if product == "" && commit == "" && hash == "" {
+		t.Skip("requires the qualified member17 Product/DLL tuple")
+	}
+	if product == "" || commit == "" || hash == "" {
+		t.Fatal("incomplete member17 integration tuple")
+	}
+	child := os.Getenv("MCPHUB_RUST_OWNER_MEMBER_CHILD")
+	info, err := os.Stat(child)
+	if err != nil || !filepath.IsAbs(child) || !info.Mode().IsRegular() {
+		t.Fatalf("matching qualified member child is required: %v", err)
+	}
+	cwd := t.TempDir()
+	library, err := openBundledRustOwnerLibrary(product, commit, hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fixture := rustMemberNativeFixture{marker: filepath.Join(cwd, "member-root")}
+	t.Cleanup(func() {
+		if fixture.owner != nil && fixture.owner.raw != 0 {
+			if _, err := fixture.owner.Stop(37); err != nil {
+				t.Errorf("member original stop cleanup: %v", err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			_, err := fixture.owner.FinishWithin(ctx)
+			cancel()
+			if err != nil {
+				t.Errorf("member original finish cleanup: %v", err)
+			}
+			if err := fixture.owner.Release(); err != nil {
+				t.Errorf("member original release cleanup: %v", err)
+			}
+		}
+		if err := library.Close(); err != nil {
+			t.Errorf("member library cleanup: %v", err)
+		}
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	var retained *rustNativeOwner
+	fixture.owner, _, err = library.startRetainedRustOwner(ctx, child, cwd, []string{mode, fixture.marker}, func(owner *rustNativeOwner) error {
+		retained = owner
+		if owner.raw != 0 || owner.memberGate == nil || owner.memberGate.source == nil {

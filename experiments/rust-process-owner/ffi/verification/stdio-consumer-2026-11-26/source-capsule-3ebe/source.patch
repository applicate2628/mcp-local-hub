+func TestSerenaRuntimeOutputExcludedBeforeBuildResolution(t *testing.T) {
+	policy := DefaultSerenaPreparationPolicy()
+	ctx, cancel := context.WithTimeout(context.Background(), policy.WorkLimit)
+	defer cancel()
+	bootstrap := map[string]string{}
+	for _, key := range SerenaBuildBootstrapDeclarationKeys() {
+		value, present := os.LookupEnv(key)
+		if !present || value == "" {
+			t.Fatal("required bootstrap input unavailable", key)
+		}
+		bootstrap[key] = value
+	}
+	// Read one real command directory without changing the process PATH.
+	bootstrap["PATH"] = filepath.Dir(bootstrap["COMSPEC"])
+	manifest := &config.ServerManifest{Name: SerenaServerName, BaseArgs: []string{
+		"--from", "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd", "serena",
+	}}
+	baselineSource, err := NewSerenaPreparationEnvironmentSource(ctx, manifest, secrets.NewResolver(nil, nil), nil, nil, bootstrap)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseline, baselineExecution, err := BuildSerenaBuildEnvironmentProjection(ctx, baselineSource, policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baselineSHA, err := baseline.SHA256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, key, value string
+	}{
+		{name: "absent"},
+		{name: "manifest", key: "PYTHONUNBUFFERED", value: "1"},
+		{name: "empty", key: "PYTHONUNBUFFERED"},
+		{name: "other runtime value", key: "PYTHONUNBUFFERED", value: "0"},
+		{name: "case alias", key: "PythonUnbuffered", value: "1"},
+		{name: "unavailable runtime secret", key: "PYTHONUNBUFFERED", value: "secret:ABSENT_RUNTIME"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			declarations := map[string]string{}
+			if tc.key != "" {
+				declarations[tc.key] = tc.value
+			}
+			source, err := NewSerenaPreparationEnvironmentSource(ctx, manifest, secrets.NewResolver(nil, nil), declarations, nil, bootstrap)
+			if err != nil {
+				t.Fatal("runtime declaration blocked build source", err)
+			}
+			actual := source.(*serenaPreparationEnvironmentSource)
+			if len(actual.values) != 0 || len(actual.provenance) != 0 || len(actual.originKinds) != 0 {
+				t.Fatal("runtime declaration retained as a build input")
+			}
+			projection, execution, err := BuildSerenaBuildEnvironmentProjection(ctx, source, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			sha, err := projection.SHA256()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if sha != baselineSHA || !reflect.DeepEqual(execution.values, baselineExecution.values) {
+				t.Fatal("runtime-only declaration changed build identity or execution environment")
+			}
+			if len(projection.CredentialReferences) != 0 {
+				t.Fatal("runtime secret became a build credential")
+			}
+			for _, entry := range projection.Entries {
+				if strings.EqualFold(entry.Key, "PYTHONUNBUFFERED") {
+					t.Fatal("runtime declaration entered build projection")
+				}
+			}
+			for _, entry := range execution.values {
+				key, _, _ := strings.Cut(entry, "=")
+				if strings.EqualFold(key, "PYTHONUNBUFFERED") {
+					t.Fatal("runtime declaration entered preparation process environment")
+				}
+			}
+			if execution.networkPolicy == nil || execution.networkPolicy.decisionSource != "uv-default" ||
+				execution.networkPolicy.offline || execution.networkPolicy.validateExecution(execution.values, nil) != nil {
+				t.Fatal("runtime declaration changed package network policy")
+			}
+		})
+	}
+}

+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	source, err := NewSerenaPreparationEnvironmentSource(ctx, manifest, secrets.NewResolver(nil, nil), nil, nil, bootstrap)

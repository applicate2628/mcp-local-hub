+func TestRustOwnerFinishWithinDoesNotWaitPastBusyOwnerMutex(t *testing.T) {
+	owner := &rustNativeOwner{library: &rustOwnerLibrary{}, raw: 0x1234}
+	owner.mu.Lock()
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+	returned := make(chan error, 1)
+	go func() { _, err := owner.FinishWithin(ctx); returned <- err }()
+	select {
+	case err := <-returned:
+		owner.mu.Unlock()
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("got %v, want deadline", err)
+		}
+	case <-time.After(250 * time.Millisecond):
+		owner.mu.Unlock()
+		<-returned
+		t.Fatal("FinishWithin blocked on busy owner mutex after context deadline")
+	}
+}

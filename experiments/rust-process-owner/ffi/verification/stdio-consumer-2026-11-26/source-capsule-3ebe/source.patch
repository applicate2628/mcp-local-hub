+			a.modulePath = filepath.Join(filepath.Dir(l.library), "other.dll")
+		}, want: "loaded module path"},
+		{name: "missing export", mutate: func(_ rustOwnerTestLayout, a *fakeRustOwnerLibraryAPI, _ *rustOwnerLibraryAdmission) {
+			a.procErrors["mh_create1"] = errors.New("no export")
+		}, want: "mh_create1"},
+		{name: "zero export", mutate: func(_ rustOwnerTestLayout, a *fakeRustOwnerLibraryAPI, _ *rustOwnerLibraryAdmission) {
+			a.procAddrs["mh_create1"] = 0
+		}, want: "mh_create1"},
+		{name: "ABI mismatch", mutate: func(_ rustOwnerTestLayout, a *fakeRustOwnerLibraryAPI, _ *rustOwnerLibraryAdmission) { a.version = 9 }, want: "ABI version"},
+		{name: "post-load identity change", mutate: func(l rustOwnerTestLayout, _ *fakeRustOwnerLibraryAPI, admit *rustOwnerLibraryAdmission) {
+			base := *admit
+			n := 0
+			*admit = func(p string, m uint16, e []string, c string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error) {
+				n++
+				v, err := base(p, m, e, c)
+				if n == 2 {
+					v.SHA256 = strings.Repeat("f", 64)
+				}
+				return v, err
+			}
+		}, want: "changed after load"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			l := newRustOwnerTestLayout(t)
+			api := newFakeRustOwnerLibraryAPI(l)
+			calls := 0
+			admit := matchingRustOwnerAdmission(l, &calls)
+			tt.mutate(l, api, &admit)
+			library, err := openRustOwnerLibrary(l.product, rustOwnerTestCommit, l.expected.SHA256, rustOwnerLibraryDependencies{api: api, admit: admit})
+			if err == nil || !strings.Contains(err.Error(), tt.want) || library != nil || api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+				t.Fatalf("library=%v err=%v free=%d guard=%d", library, err, api.freeCalls, api.lockGuard.closeCalls)
+			}
+		})
+	}
+}
+func TestRustOwnerLibraryCloseFailureIsTerminal(t *testing.T) {
+	l := newRustOwnerTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(l)
+	api.freeErr = errors.New("free denied")
+	library, err, _ := openFakeRustOwner(t, l, api)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := library.Close()
+	second := library.Close()
+	if first == nil || second == nil || first.Error() != second.Error() || api.freeCalls != 1 || library.ready || api.lockGuard.closeCalls != 1 {
+		t.Fatalf("first=%v second=%v api=%+v", first, second, api)
+	}
+}
+func TestOpenRustOwnerLibraryPreservesGuardCleanupFailureWithoutRetry(t *testing.T) {
+	l := newRustOwnerTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(l)
+	api.lockGuard.closeErr = errors.New("guard close failed")
+	library, err, _ := openFakeRustOwner(t, l, api)
+	if err == nil || !strings.Contains(err.Error(), "guard close failed") || library == nil || library.ready ||
+		api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+		t.Fatalf("owner=%+v error=%v api=%+v", library, err, api)
+	}
+	if library.Close() == nil || api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+		t.Fatal("guard or module retried")
+	}
+}
+
+func TestOpenRustOwnerLibraryRequiresResolvedSplitPair(t *testing.T) {
+	for _, name := range []string{"mh_wait1", "mh_close1"} {
+		for _, resolutionError := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/error=%t", name, resolutionError), func(t *testing.T) {
+				layout := newRustOwnerTestLayout(t)
+				api := newFakeRustOwnerLibraryAPI(layout)
+				if resolutionError {
+					api.procErrors[name] = errors.New("fixture export unavailable")
+				} else {
+					api.procAddrs[name] = 0
+				}
+				library, err, _ := openFakeRustOwner(t, layout, api)
+				if library != nil {
+					t.Cleanup(func() { _ = library.Close() })
+				}
+				if err == nil || !strings.Contains(err.Error(), name) || library != nil ||
+					api.freeCalls != 1 || api.lockGuard.closeCalls != 1 {
+					t.Fatalf("Product accepted unresolved split export: name=%s error=%v library=%v free=%d guard=%d",
+						name, err, library != nil, api.freeCalls, api.lockGuard.closeCalls)
+				}
+			})
+		}
+	}
+}

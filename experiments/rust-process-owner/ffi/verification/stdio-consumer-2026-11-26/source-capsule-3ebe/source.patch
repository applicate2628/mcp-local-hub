@@ -0,0 +1,304 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+type rustBorrowABIProbe struct {
+	calls    int
+	token    uintptr
+	contract string
+}
+
+// Numeric values here are ABI fixtures, never handles used in an OS query.
+// The native Rust tests separately prove original creation HANDLE identity.
+func rustBorrowABIOwner(action func(uintptr, uintptr, *rustOwnerOutcome) uintptr) (*rustNativeOwner, *rustBorrowABIProbe) {
+	probe := &rustBorrowABIProbe{}
+	address := syscall.NewCallback(func(raw, inspect, token uintptr, out *rustOwnerOutcome, bytes uintptr) uintptr {
+		probe.calls++
+		probe.token = token
+		if raw != 0x1234 || inspect == 0 || token == 0 || out == nil || bytes != 48 {
+			probe.contract = "invalid borrow ABI arguments"
+			return 1
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, PID: 42}
+		return action(inspect, token, out)
+	})
+	library := &rustOwnerLibrary{
+		ready:      true,
+		procedures: map[string]uintptr{"mh_borrow_process1": address},
+	}
+	library.identity.Exports = runtimeidentity.WindowsProcessOwnerBorrowExportsV1()
+	owner := &rustNativeOwner{
+		library: library, raw: 0x1234, originalPID: 42,
+		memberGate: newOriginalMemberCustody(),
+	}
+	return owner, probe
+}
+
+func rustBorrowABIVisit(handle uintptr, inspect, token uintptr) uintptr {
+	decision, _, _ := syscall.SyscallN(inspect, handle, token)
+	if decision == 1 {
+		return 0
+	}
+	return 4
+}
+
+func TestRustOriginalProcessBorrowIsSynchronousAndRemovesTemporaryToken(t *testing.T) {
+	owner, probe := rustBorrowABIOwner(func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+		return rustBorrowABIVisit(0x880, inspect, token)
+	})
+	calls := 0
+	for range 2 {
+		err := owner.borrowOriginalProcessHandle(nil, func(handle uintptr) error {
+			calls++
+			if handle != 0x880 {
+				return errors.New("borrow changed original handle")
+			}
+			if _, present := rustOwnerProcessBorrowCalls.Load(probe.token); !present {
+				return errors.New("callback token did not span synchronous query")
+			}
+			return nil
+		})
+		if err != nil || probe.contract != "" {
+			t.Fatalf("borrow=%v contract=%s", err, probe.contract)
+		}
+		if _, present := rustOwnerProcessBorrowCalls.Load(probe.token); present {
+			t.Fatal("call token retained after synchronous return")
+		}
+	}
+	if calls != 2 || probe.calls != 2 || owner.raw != 0x1234 || owner.closeStarted {
+		t.Fatalf("query changed custody: receiver=%d native=%d owner=%#x", calls, probe.calls, owner.raw)
+	}
+}
+
+func TestRustOriginalProcessBorrowPreservesReceiverErrorAndContainsPanic(t *testing.T) {
+	sentinel := errors.New("original image check refused")
+	for _, tc := range []struct {
+		name    string
+		consume func(uintptr) error
+		want    error
+	}{
+		{"error", func(uintptr) error { return sentinel }, sentinel},
+		{"panic", func(uintptr) error { panic("private receiver details") }, errRustOwnerProcessBorrow},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			owner, probe := rustBorrowABIOwner(func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+				return rustBorrowABIVisit(0x880, inspect, token)
+			})
+			err := owner.borrowOriginalProcessHandle(nil, tc.consume)
+			if !errors.Is(err, tc.want) || probe.calls != 1 || owner.raw != 0x1234 {
+				t.Fatalf("borrow error=%v calls=%d raw=%#x", err, probe.calls, owner.raw)
+			}
+			if strings.Contains(err.Error(), "private receiver details") {
+				t.Fatal("receiver panic contents escaped the boundary")
+			}
+			if _, present := rustOwnerProcessBorrowCalls.Load(probe.token); present {
+				t.Fatal("failed receiver retained its temporary token")
+			}
+		})
+	}
+}
+
+func TestRustOriginalProcessBorrowRejectsContradictoryCallbacksAndOutcomes(t *testing.T) {
+	cases := []struct {
+		name     string
+		action   func(uintptr, uintptr, *rustOwnerOutcome) uintptr
+		consumed int
+	}{
+		{"missing", func(uintptr, uintptr, *rustOwnerOutcome) uintptr { return 0 }, 0},
+		{"duplicate", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			rustBorrowABIVisit(0x880, inspect, token)
+			rustBorrowABIVisit(0x880, inspect, token)
+			return 0
+		}, 1},
+		{"zero-handle", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			return rustBorrowABIVisit(0, inspect, token)
+		}, 0},
+		{"pseudo-handle", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			return rustBorrowABIVisit(^uintptr(0), inspect, token)
+		}, 0},
+		{"foreign-pid", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			out.PID = 43
+			return rustBorrowABIVisit(0x880, inspect, token)
+		}, 1},
+		{"terminal-facts", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			out.State, out.Flags = 2, 1
+			return rustBorrowABIVisit(0x880, inspect, token)
+		}, 1},
+		{"active-facts", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			out.Flags = 2
+			return rustBorrowABIVisit(0x880, inspect, token)
+		}, 1},
+		{"malformed-output", func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+			out.Size = 47
+			return rustBorrowABIVisit(0x880, inspect, token)
+		}, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			owner, probe := rustBorrowABIOwner(tc.action)
+			calls := 0
+			err := owner.borrowOriginalProcessHandle(nil, func(uintptr) error { calls++; return nil })
+			if err == nil || calls != tc.consumed || probe.calls != 1 {
+				t.Fatalf("error=%v consumed=%d native=%d", err, calls, probe.calls)
+			}
+			if owner.raw != 0x1234 || owner.closeStarted {
+				t.Fatal("invalid observation discarded original custody")
+			}
+		})
+	}
+}
+
+func TestRustOriginalProcessBorrowRejectsUnavailableAuthorityBeforeNativeEntry(t *testing.T) {
+	for _, name := range []string{"nil-receiver", "missing-owner", "missing-original-pid", "closed-owner", "missing-library",
+		"closed-library", "profile17", "profile13", "missing-export", "sealed-custody"} {
+		t.Run(name, func(t *testing.T) {
+			owner, probe := rustBorrowABIOwner(func(uintptr, uintptr, *rustOwnerOutcome) uintptr { return 0 })
+			consume := func(uintptr) error { return nil }
+			switch name {
+			case "nil-receiver":
+				consume = nil
+			case "missing-owner":
+				owner.raw = 0
+			case "missing-original-pid":
+				owner.originalPID = 0
+			case "closed-owner":
+				owner.closeStarted = true
+			case "missing-library":
+				owner.library = nil
+			case "closed-library":
+				owner.library.closeAttempted = true
+			case "profile17":
+				owner.library.identity.Exports = runtimeidentity.WindowsProcessOwnerMemberExportsV1()
+			case "profile13":
+				owner.library.identity.Exports = runtimeidentity.WindowsProcessOwnerExportsV1()
+			case "missing-export":
+				delete(owner.library.procedures, "mh_borrow_process1")
+			case "sealed-custody":
+				owner.memberGate.sealed = true
+			}
+			if err := owner.borrowOriginalProcessHandle(nil, consume); err == nil || probe.calls != 0 {
+				t.Fatalf("error=%v native=%d", err, probe.calls)
+			}
+		})
+	}
+}
+
+func TestRustOriginalProcessBorrowUsesFiniteCallerContextWithoutRenewal(t *testing.T) {
+	owner, probe := rustBorrowABIOwner(func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+		return rustBorrowABIVisit(0x880, inspect, token)
+	})
+	if err := owner.borrowOriginalProcessHandle(context.Background(), func(uintptr) error { return nil }); err == nil {
+		t.Fatal("non-nil unbounded startup context admitted")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	cancel()
+	if err := owner.borrowOriginalProcessHandle(ctx, func(uintptr) error { return nil }); !errors.Is(err, context.Canceled) {
+		t.Fatalf("pre-entry cancellation=%v", err)
+	}
+	if probe.calls != 0 {
+		t.Fatal("invalid context entered native query")
+	}
+	ctx, cancel = context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	calls := 0
+	err := owner.borrowOriginalProcessHandle(ctx, func(uintptr) error { calls++; cancel(); return nil })
+	if !errors.Is(err, context.Canceled) || probe.calls != 1 || calls != 1 {
+		t.Fatalf("late cancellation=%v native=%d callback=%d", err, probe.calls, calls)
+	}
+	// The per-call startup deadline is not stored as the original owner's life.
+	if err := owner.borrowOriginalProcessHandle(nil, func(uintptr) error { return nil }); err != nil {
+		t.Fatalf("completed startup context leaked into later query: %v", err)
+	}
+}
+
+func TestRustOriginalProcessBorrowRetainsQueryLeaseAndLibraryUntilReturn(t *testing.T) {
+	owner, _ := rustBorrowABIOwner(func(inspect, token uintptr, out *rustOwnerOutcome) uintptr {
+		return rustBorrowABIVisit(0x880, inspect, token)
+	})
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		done <- owner.borrowOriginalProcessHandle(nil, func(uintptr) error {
+			close(entered)
+			<-release
+			return nil
+		})
+	}()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		close(release)
+		t.Fatal("callback did not enter")
+	}
+	ownerLocked := !owner.mu.TryLock()
+	if !ownerLocked {
+		owner.mu.Unlock()
+	}
+	libraryLocked := !owner.library.mu.TryLock()
+	if !libraryLocked {
+		owner.library.mu.Unlock()
+	}
+	permit, terminalErr := owner.memberGate.beginTerminal(nil)
+	if permit != nil {
+		permit.finish()
+	}
+	close(release)
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("query did not release synchronous callback")
+	}
+	if !ownerLocked || !libraryLocked || !errors.Is(terminalErr, ErrOriginalMemberBorrowPending) {
+		t.Fatalf("borrow custody owner=%v library=%v terminal=%v", ownerLocked, libraryLocked, terminalErr)
+	}
+	permit, err := owner.memberGate.beginTerminal(nil)
+	if err != nil || permit == nil {
+		t.Fatalf("drained query did not release terminal admission: %v", err)
+	}
+	permit.finish()
+}
+
+func TestRustOriginalProcessBorrowBoundsOwnerAndLibraryMutexAdmission(t *testing.T) {
+	for _, libraryLock := range []bool{false, true} {
+		name := "owner"
+		if libraryLock {
+			name = "library"
+		}
+		t.Run(name, func(t *testing.T) {
+			owner, probe := rustBorrowABIOwner(func(uintptr, uintptr, *rustOwnerOutcome) uintptr { return 0 })
+			lock := &owner.mu
+			if libraryLock {
+				lock = &owner.library.mu
+			}
+			lock.Lock()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+			err := owner.borrowOriginalProcessHandle(ctx, func(uintptr) error { return nil })
+			cancel()
+			lock.Unlock()
+			if !errors.Is(err, context.DeadlineExceeded) || probe.calls != 0 {
+				t.Fatalf("mutex admission error=%v native=%d", err, probe.calls)
+			}
+			owner.memberGate.mu.Lock()
+			entered := owner.memberGate.entered
+			owner.memberGate.mu.Unlock()
+			if entered != 0 {
+				t.Fatalf("expired admission retained %d query leases", entered)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_product_module_windows_test.go b/internal/process/rust_owner_product_module_windows_test.go

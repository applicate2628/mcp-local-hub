+func TestSerenaBuildBootstrapPathExt(t *testing.T) {
+	policy := DefaultSerenaPreparationPolicy()
+	ctx, cancel := context.WithTimeout(context.Background(), policy.WorkLimit)
+	defer cancel()
+	bootstrap := map[string]string{}
+	for _, key := range []string{"SYSTEMROOT", "WINDIR", "COMSPEC"} {
+		value, present := os.LookupEnv(key)
+		if !present || value == "" {
+			t.Fatal("required bootstrap input unavailable", key)
+		}
+		bootstrap[key] = value
+	}
+	// Qualify existing files only; no child process or package installation.
+	bootstrap["PATH"] = filepath.Dir(bootstrap["COMSPEC"])
+	manifest := &config.ServerManifest{Name: SerenaServerName, BaseArgs: []string{
+		"--from", "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd", "serena",
+	}}
+	type identity struct{ bootstrap, projection string }
+	identities := map[string]identity{}
+	for _, tc := range []struct {
+		name, key, value string
+	}{
+		{name: "declared", key: "PATHEXT", value: ".EXE;.COM;.CMD"},
+		{name: "extension order", key: "PATHEXT", value: ".COM;.EXE;.CMD"},
+		{name: "extension set", key: "PATHEXT", value: ".EXE;.CMD"},
+		{name: "case alias", key: "pathext", value: ".EXE;.COM;.CMD"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			declarations := map[string]string{}
+			for key, value := range bootstrap {
+				declarations[key] = value
+			}
+			declarations[tc.key] = tc.value
+			source, err := NewSerenaPreparationEnvironmentSource(ctx, manifest, secrets.NewResolver(nil, nil), nil, nil, declarations)
+			if err != nil {
+				t.Fatal(err)
+			}
+			projection, execution, err := BuildSerenaBuildEnvironmentProjection(ctx, source, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := map[string]string{
+				"PATHEXT": tc.value, "PYTHONDONTWRITEBYTECODE": "1", "UV_PYTHON_DOWNLOADS": "never",
+				"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.longpaths", "GIT_CONFIG_VALUE_0": "true",
+			}
+			for key, value := range bootstrap {
+				want[key] = value
+			}
+			if len(execution.values) != len(want) || !reflect.DeepEqual(preparedSerenaEnvironmentMap(execution.values), want) {
+				t.Fatal("declared bootstrap values or closed execution environment changed")
+			}
+			sha, err := projection.SHA256()
+			if err != nil {
+				t.Fatal(err)
+			}
+			identities[tc.name] = identity{projection.BootstrapSHA256, sha}
+		})
+	}
+	baseline := identities["declared"]
+	if identities["case alias"] != baseline {
+		t.Error("bootstrap key casing changed build identity")
+	}
+	for _, name := range []string{"extension order", "extension set"} {
+		got := identities[name]
+		if got.bootstrap == baseline.bootstrap || got.projection == baseline.projection {
+			t.Error("executable extension lookup changed without a new build identity:", name)
+		}
+	}
+	for _, tc := range []struct {
+		name      string
+		pathExt   map[string]string
+		wantError string
+	}{
+		{name: "missing", wantError: "SERENA_BUILD_BOOTSTRAP_INPUT_MISSING"},
+		{name: "empty", pathExt: map[string]string{"PATHEXT": ""}, wantError: "SERENA_BUILD_BOOTSTRAP_INPUT_MISSING"},
+		{name: "case alias collision", pathExt: map[string]string{"PATHEXT": ".EXE", "pathext": ".CMD"}, wantError: "SERENA_BUILD_BOOTSTRAP_CASE_ALIAS_COLLISION"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			declarations := map[string]string{}
+			for key, value := range bootstrap {
+				declarations[key] = value
+			}
+			for key, value := range tc.pathExt {
+				declarations[key] = value
+			}
+			_, err := NewSerenaPreparationEnvironmentSource(ctx, manifest, secrets.NewResolver(nil, nil), nil, nil, declarations)
+			if err == nil || err.Error() != tc.wantError {
+				t.Fatalf("bootstrap declaration error = %v, want %s", err, tc.wantError)
+			}
+		})
+	}
+}

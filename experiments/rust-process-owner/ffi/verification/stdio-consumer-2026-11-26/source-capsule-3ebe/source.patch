+func TestAutoRegisterSerena_PreparationDeadlineSurvivesRegistryWait(t *testing.T) {
+	regPath := autoRegisterTestEnv(t)
+	installCalls, continuationCalls := 0, 0
+	stubAutoRegisterInstall(t, func(context.Context, *API, *config.ServerManifest, InstallParsedManifestOpts) (string, error) {
+		installCalls++
+		return filepath.Join(filepath.Dir(regPath), "state", supervisorIntentFileLeaf), nil
+	})
+	stubAutoRegisterReconcile(t, func(context.Context, bool) (ReconcileResponse, error) {
+		continuationCalls++
+		return ReconcileResponse{}, nil
+	})
+	stubAutoRegisterReadiness(t, func(int, time.Duration) error { continuationCalls++; return nil })
+	previousFactory := autoRegisterNewInstallOperationFn
+	var deadline time.Time
+	autoRegisterNewInstallOperationFn = func(a *API) (autoRegisterSerenaInstallOperation, error) {
+		operation, err := previousFactory(a)
+		operation.prepare = func(context.Context, *config.ServerManifest, InstallParsedManifestOpts) (time.Time, error) {
+			deadline = time.Now().Add(200 * time.Millisecond)
+			return deadline, nil
+		}
+		return operation, err
+	}
+	t.Cleanup(func() { autoRegisterNewInstallOperationFn = previousFactory })
+	acquires := 0
+	stubAutoRegisterRegistryLock(t, func(reg *Registry) (func() error, error) {
+		acquires++
+		if acquires == 2 {
+			// Model a finite foreign-holder wait that outlives the ORIGINAL
+			// preparation budget; no real foreign lock or leaked goroutine.
+			timer := time.NewTimer(time.Until(deadline) + 10*time.Millisecond)
+			<-timer.C
+		}
+		return reg.Lock()
+	})
+	workspace := writeSerenaMarker(t, t.TempDir(), validSerenaMarkerYAML)
+	entry, err := NewAPI().AutoRegisterSerenaWorkspace(context.Background(), workspace)
+	if entry != nil || !errors.Is(err, context.DeadlineExceeded) || acquires != 2 || installCalls != 0 || continuationCalls != 0 {
+		t.Fatalf("expired preparation: entry=%+v cause=%v acquire=%d install=%d continuation=%d", entry, err, acquires, installCalls, continuationCalls)
+	}
+	if _, err := os.Stat(regPath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expired preparation saved registry: %v", err)
+	}
+}

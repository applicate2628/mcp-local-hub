+func TestRustOwnerWaitOutcomeRejectsContradictoryFacts(t *testing.T) {
+	exited := rustOwnerWaitOutcome{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+	for _, valid := range []struct {
+		status uint32
+		value  rustOwnerWaitOutcome
+	}{
+		{0, exited},
+		{0, rustOwnerWaitOutcome{Size: 32, Version: 1, State: 1, PID: 42}},
+		{0, rustOwnerWaitOutcome{Size: 32, Version: 1, State: 1, Flags: 3, PID: 42, RootExit: 7, Active: 1}},
+		{3, rustOwnerWaitOutcome{Size: 32, Version: 1, Flags: 1, PID: 42, RootExit: 7, NativeError: 5}},
+		{5, rustOwnerWaitOutcome{Size: 32, Version: 1, Flags: 1, PID: 42, RootExit: 7}},
+	} {
+		got, err := decodeRustOwnerWaitOutcome(valid.status, valid.value)
+		if got != valid.value || (err == nil) != (valid.status == 0) || errors.Is(err, errRustOwnerOutcome) {
+			t.Fatalf("valid observation/status rejected: got=%+v status=%d err=%v", got, valid.status, err)
+		}
+	}
+	for _, tc := range []struct {
+		name   string
+		status uint32
+		mutate func(*rustOwnerWaitOutcome)
+	}{
+		{"old-48-byte-layout", 0, func(v *rustOwnerWaitOutcome) { v.Size = 48 }},
+		{"unknown-version", 0, func(v *rustOwnerWaitOutcome) { v.Version = 2 }},
+		{"unknown-status", 7, func(v *rustOwnerWaitOutcome) {}},
+		{"cleanup-state-in-wait", 0, func(v *rustOwnerWaitOutcome) { v.State = 3 }},
+		{"unknown-flags", 0, func(v *rustOwnerWaitOutcome) { v.Flags = 7 }},
+		{"success-without-observation", 0, func(v *rustOwnerWaitOutcome) { v.State = 0 }},
+		{"failure-with-exited", 5, func(v *rustOwnerWaitOutcome) {}},
+		{"native-failure-without-code", 3, func(v *rustOwnerWaitOutcome) { v.State, v.Flags = 0, 1 }},
+		{"unexpected-native-code", 0, func(v *rustOwnerWaitOutcome) { v.NativeError = 5 }},
+		{"unflagged-root", 0, func(v *rustOwnerWaitOutcome) { v.Flags = 2 }},
+		{"unflagged-active", 0, func(v *rustOwnerWaitOutcome) { v.Flags, v.Active = 1, 2 }},
+		{"missing-pid", 0, func(v *rustOwnerWaitOutcome) { v.PID = 0 }},
+		{"failure-with-active-observation", 5, func(v *rustOwnerWaitOutcome) { v.State = 0 }},
+		{"pending-root-without-count", 0, func(v *rustOwnerWaitOutcome) { v.State, v.Flags = 1, 1 }},
+		{"pending-count-without-root", 0, func(v *rustOwnerWaitOutcome) { v.State, v.Flags, v.RootExit, v.Active = 1, 2, 0, 1 }},
+		{"pending-with-zero-members", 0, func(v *rustOwnerWaitOutcome) { v.State = 1 }},
+		{"exited-without-count", 0, func(v *rustOwnerWaitOutcome) { v.Flags = 1 }},
+		{"exited-with-live-member", 0, func(v *rustOwnerWaitOutcome) { v.Active = 1 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			input := exited
+			tc.mutate(&input)
+			got, err := decodeRustOwnerWaitOutcome(tc.status, input)
+			if got != (rustOwnerWaitOutcome{}) || !errors.Is(err, errRustOwnerOutcome) {
+				t.Fatalf("contradictory wait fact survived decoding: got=%+v err=%v", got, err)
+			}
+		})
+	}
+}

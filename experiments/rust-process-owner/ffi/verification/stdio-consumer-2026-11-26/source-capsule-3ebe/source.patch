@@ -0,0 +1,238 @@
+package process
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"os/exec"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// This fixture models the owner's publication contract only. No native child
+// or handle is created. The release channel makes the close/wait race explicit.
+type partialStartContainedChild struct {
+	*scriptedContainedChild
+	noChild         bool
+	created         bool
+	waitReturned    atomic.Bool
+	prematureCloses atomic.Int32
+	backstops       atomic.Int32
+	waitRelease     chan struct{}
+	releaseOnce     sync.Once
+	natural         bool
+	deadline        time.Time
+	settleErr       error
+}
+
+func newPartialStartContainedChild(code int) *partialStartContainedChild {
+	c := &partialStartContainedChild{
+		scriptedContainedChild: newScriptedContainedChild(containedWaitResult{exited: true, exitCode: code}),
+		created:                true,
+		waitRelease:            make(chan struct{}),
+	}
+	c.releaseWait()
+	return c
+}
+func (c *partialStartContainedChild) releaseWait() {
+	c.releaseOnce.Do(func() { close(c.waitRelease) })
+}
+func (c *partialStartContainedChild) wait() containedWaitResult {
+	<-c.waitRelease
+	result := c.scriptedContainedChild.wait()
+	c.waitReturned.Store(true)
+	return result
+}
+func (c *partialStartContainedChild) close() error {
+	if !c.noChild && !c.waitReturned.Load() {
+		c.prematureCloses.Add(1)
+		// Release the synthetic waiter even for the old, incorrect call order,
+		// so the negative control cannot leave a fixture goroutine blocked.
+		c.releaseWait()
+		c.closeCalls.Add(1)
+		return &OriginalMemberBorrowPendingError{Stage: "original-root-wait"}
+	}
+	return c.scriptedContainedChild.close()
+}
+func (c *partialStartContainedChild) containedNoChildKnown() bool  { return c.noChild }
+func (c *partialStartContainedChild) prepareContainedObservation() {}
+func (c *partialStartContainedChild) containedCreated() bool       { return c.created }
+func (c *partialStartContainedChild) containedStartLive(context.Context) (bool, error) {
+	return c.created, nil
+}
+func (c *partialStartContainedChild) containedRootIdentity() (ContainedRootIdentity, error) {
+	if !c.created {
+		return ContainedRootIdentity{}, errors.New("synthetic identity unavailable")
+	}
+	return ContainedRootIdentity{Known: true, PID: 4242, StartedAt: "2026-11-20T00:00:00Z"}, nil
+}
+func (c *partialStartContainedChild) closeContainedJobBackstop() error {
+	c.backstops.Add(1)
+	c.releaseWait()
+	return nil
+}
+func (c *partialStartContainedChild) settleContained(ctx context.Context, natural bool) (ContainedNativeSnapshot, error) {
+	c.deadline, _ = ctx.Deadline()
+	c.natural = natural
+	if c.noChild {
+		return ContainedNativeSnapshot{NoChildKnown: true, TerminalAction: "not_requested"}, nil
+	}
+	identity, _ := c.containedRootIdentity()
+	return ContainedNativeSnapshot{
+		RootIdentity: identity, OriginalJobExited: c.settleErr == nil,
+		TerminalAction: "request_succeeded", Error: c.settleErr,
+	}, c.settleErr
+}
+
+func runPartialStartContained(t *testing.T, child containedChild, observed bool, consume func(io.Reader) error) (ContainedStreamReceiptV1, error, string, time.Time) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	workDeadline, _ := ctx.Deadline()
+	deadline := workDeadline.Add(time.Second)
+	var stderr bytes.Buffer
+	options := ContainedStreamOptions{
+		CleanupTimeout: time.Second, AbsoluteCleanupDeadline: deadline,
+		StdoutByteLimit: 128, StderrByteLimit: 128, Stderr: &stderr,
+	}
+	deps := containedStreamDependencies{
+		newChild: func(*exec.Cmd) (containedChild, error) { return child, nil },
+		pipe: func() (containedReadFile, containedWriteFile, error) {
+			r, w := newMemoryContainedPipe()
+			return r, w, nil
+		},
+		openNull: func() (containedInputFile, error) { return &fakeContainedInput{}, nil },
+	}
+	var receipt ContainedStreamReceiptV1
+	var output *ContainedStreamReceiptV1
+	if observed {
+		output = &receipt
+	}
+	err := runContainedStreamCore(ctx, &exec.Cmd{Path: "synthetic"}, options, consume, deps, output)
+	return receipt, err, stderr.String(), deadline
+}
+
+func TestContainedStreamPostCreateStartFailureSettlesOriginal(t *testing.T) {
+	for _, observed := range []bool{false, true} {
+		name := "ordinary"
+		if observed {
+			name = "observed"
+		}
+		t.Run(name, func(t *testing.T) {
+			child := newPartialStartContainedChild(7)
+			startErr := errors.New("post-create start sentinel")
+			child.startFn = func(_ containedInputFile, stdout, stderr containedWriteFile) error {
+				_, outErr := io.WriteString(stdout, "stdout-tail")
+				_, errErr := io.WriteString(stderr, "stderr-tail")
+				return errors.Join(startErr, outErr, errErr)
+			}
+			var stdout bytes.Buffer
+			receipt, err, stderr, deadline := runPartialStartContained(t, child, observed, func(r io.Reader) error {
+				_, err := io.Copy(&stdout, r)
+				return err
+			})
+			var lifecycle *ContainedRunError
+			if !errors.As(err, &lifecycle) || lifecycle.Stage != ContainedStageStart || !errors.Is(lifecycle.Cause, startErr) {
+				t.Fatalf("original start cause replaced: %#v", err)
+			}
+			if child.waitCalls.Load() != 1 || child.closeCalls.Load() != 1 || child.prematureCloses.Load() != 0 {
+				t.Fatalf("partial-start wait/close/premature=%d/%d/%d, want 1/1/0", child.waitCalls.Load(), child.closeCalls.Load(), child.prematureCloses.Load())
+			}
+			if stdout.String() != "stdout-tail" || stderr != "stderr-tail" {
+				t.Fatalf("partial-start output was not drained: stdout=%q stderr=%q", stdout.String(), stderr)
+			}
+			if observed && (!receipt.RootWaitKnown || receipt.RootExitCode != 7 || !receipt.NativeSettlement.Complete() || !receipt.IOSettlement.Complete() || child.natural || !child.deadline.Equal(deadline)) {
+				t.Fatalf("partial-start settlement/deadline changed: %+v natural=%t deadline=%v", receipt, child.natural, child.deadline)
+			}
+		})
+	}
+}
+
+func TestContainedStreamNoChildStartFailureDoesNotWait(t *testing.T) {
+	child := newPartialStartContainedChild(0)
+	child.noChild, child.created = true, false
+	startErr := errors.New("confirmed no-child sentinel")
+	child.startFn = func(containedInputFile, containedWriteFile, containedWriteFile) error { return startErr }
+	receipt, err, _, _ := runPartialStartContained(t, child, true, drainContainedReader)
+	if !errors.Is(err, startErr) || child.waitCalls.Load() != 0 || child.closeCalls.Load() != 1 ||
+		!receipt.NativeSettlement.Complete() || !receipt.NativeSettlement.Snapshot().NoChildKnown || !receipt.IOSettlement.Complete() {
+		t.Fatalf("confirmed no-child was waited or lost: receipt=%+v err=%v wait/close=%d/%d", receipt, err, child.waitCalls.Load(), child.closeCalls.Load())
+	}
+}
+
+func TestContainedStreamUnknownCreationStillRunsOriginalWaiter(t *testing.T) {
+	for _, observed := range []bool{false, true} {
+		name := "ordinary"
+		if observed {
+			name = "observed"
+		}
+		t.Run(name, func(t *testing.T) {
+			child := newPartialStartContainedChild(0)
+			child.created = false // This is deliberately not positive no-child evidence.
+			child.settleErr = errors.New("unknown native creation")
+			child.closeFn = func() error { return child.settleErr }
+			child.waitCh = make(chan containedWaitResult, 1)
+			child.waitCh <- containedWaitResult{err: child.settleErr}
+			startErr := errors.New("malformed creation sentinel")
+			child.startFn = func(containedInputFile, containedWriteFile, containedWriteFile) error { return startErr }
+			receipt, err, _, _ := runPartialStartContained(t, child, observed, drainContainedReader)
+			var lifecycle *ContainedRunError
+			if !errors.As(err, &lifecycle) || !errors.Is(lifecycle.Cause, startErr) ||
+				child.waitCalls.Load() != 1 || child.prematureCloses.Load() != 0 ||
+				receipt.RootWaitKnown || receipt.NativeSettlement.Complete() {
+				t.Fatalf("unknown create became no-child or lost waiter: receipt=%+v err=%v waits=%d", receipt, err, child.waitCalls.Load())
+			}
+			if lifecycle.owner != child || !errors.Is(lifecycle.CleanupCause, child.settleErr) {
+				t.Fatal("incomplete close lost original custody or secondary failure")
+			}
+		})
+	}
+}
+
+func TestContainedStreamUnobservedFailureUsesBackstopBeforeClose(t *testing.T) {
+	runContainedSynctest(t, func(t *testing.T) {
+		child := newPartialStartContainedChild(13)
+		child.waitRelease, child.releaseOnce = make(chan struct{}), sync.Once{}

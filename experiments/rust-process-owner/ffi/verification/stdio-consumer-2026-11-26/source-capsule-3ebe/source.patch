diff --git a/internal/process/rust_owner_foreground_windows.go b/internal/process/rust_owner_foreground_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..cd0120e8b1dda116dba05311244d608ed1fcf883
--- /dev/null
+++ b/internal/process/rust_owner_foreground_windows.go
@@ -0,0 +1,164 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"syscall"
+	"unicode/utf8"
+
+	"mcp-local-hub/internal/buildinfo"
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+func startProductRustForeground(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+	admission ForegroundCreateAdmission, retain func(*AtCreateJobProcess) error, productPath string,
+) (*AtCreateJobProcess, error) {
+	return startProductRustForegroundWithLibrary(ctx, cmd, stdin, stdout, stderr, admission, retain, func() (*rustOwnerLibrary, error) {
+		if productPath == "" {
+			return openProductRustOwnerLibrary()
+		}
+		expected, err := buildinfo.CurrentRustOwnerSHA256()
+		if err != nil {
+			return nil, err
+		}
+		_, commit, _ := buildinfo.Get()
+		return openBundledRustOwnerLibrary(productPath, commit, expected)
+	})
+}
+
+// The foreground operation owns this facade before create. Admission can borrow
+// its original process handle while suspended; it never manufactures an owner.
+func startProductRustForegroundWithLibrary(ctx context.Context, cmd *exec.Cmd, stdin, stdout, stderr *os.File,
+	admission ForegroundCreateAdmission, retain func(*AtCreateJobProcess) error,
+	open func() (*rustOwnerLibrary, error),
+) (*AtCreateJobProcess, error) {
+	if cmd == nil || retain == nil || open == nil {
+		return nil, errors.New("Rust foreground command, retention and library source required")
+	}
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	prepared := *cmd
+	prepared.Args, prepared.Env = slices.Clone(cmd.Args), slices.Clone(cmd.Env)
+	var err error
+	if prepared.Err == nil {
+		if !utf8.ValidString(prepared.Path) || !utf8.ValidString(prepared.Dir) {
+			return nil, errors.New("Rust foreground command path is not valid UTF-8")
+		}
+		if prepared.Dir == "" {
+			prepared.Dir, err = os.Getwd()
+		} else {
+			prepared.Dir, err = filepath.Abs(prepared.Dir)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+	child := &rustContainedChild{startContext: ctx, foreground: true, ownsLibrary: true, noChildKnown: true}
+	original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	child.retain = func() error { return retain(original) }
+	if admission != nil {
+		child.beforeAdmit = func() (err error) {
+			defer func() {
+				if recover() != nil {
+					err = errors.New("Rust original pre-resume admission panicked")
+				}
+			}()
+			return admission.AfterCreateBeforeResume(original)
+		}
+	}
+	err = startProductRustChild(child, open, func() error {
+		if err := lockRustOwnerCreateContext(ctx, &child.library.mu); err != nil {
+			return err
+		}
+		complete := runtimeidentity.IsWindowsProcessOwnerBorrowExportProfileV1(child.library.identity.Exports) &&
+			child.library.procedures["mh_borrow_process1"] != 0
+		child.library.mu.Unlock()
+		if !complete {
+			return errors.New("Rust foreground requires the original-process borrow export profile")
+		}
+		return child.start(&prepared, stdin, stdout, stderr)
+	})
+	return original, errors.Join(err, ctx.Err())
+}
+
+func (child *rustContainedChild) waitForegroundRoot(ctx context.Context) (bool, error) {
+	if child == nil || child.owner == nil || ctx == nil {
+		return false, ErrContainmentUnavailable
+	}
+	root, err := child.owner.waitRoot(ctx)
+	return root.Known, err
+}
+
+func (child *rustContainedChild) borrowForegroundHandle(consume func(uintptr) error) error {
+	if child == nil || child.owner == nil || consume == nil {
+		return ErrContainmentUnavailable
+	}
+	var ctx context.Context
+	if child.startAttempted.Load() && !child.startReturned.Load() {
+		ctx = child.startContext
+	}
+	return child.owner.borrowOriginalProcessHandle(ctx, consume)
+}
+
+// This reads only the same facade's cached facts. Aggregate Job exit never
+// creates a Go member census, attributes receipt, process wrapper or Job owner.
+func (child *rustContainedChild) appendForegroundOutcome(out *ForegroundOutcome) {
+	if child == nil {
+		out.Pending = append(out.Pending, "original-resource-observation-unknown")
+		return
+	}
+	child.mu.Lock()
+	defer child.mu.Unlock()
+	created := child.containedCreated()
+	out.JobAcquired = created
+	out.ChildObservationKnown = created || child.noChildKnown
+	out.Identity = child.identity
+	if !out.ChildObservationKnown {
+		out.Pending = append(out.Pending, "original-resource-observation-unknown")
+	}
+	if created && !out.Identity.Known {
+		out.IdentityError = errors.New("original Rust creation identity unavailable")
+	}
+	closeView := func(index uint) ForegroundCloseObservation {
+		view := ForegroundCloseObservation{AcquiredKnown: created || child.noChildKnown, Acquired: created}
+		if created && child.nativeCloseKnown {
+			view.CloseAttempted = true
+			code := child.nativeCloseOutcome.CleanupCodes[index]
+			view.ClosedKnown, view.Closed = code == 0, code == 0
+			if code != 0 {
+				view.Error = syscall.Errno(uint32(code))
+			}
+		}
+		return view
+	}
+	// ABI1 slot order is CloseThread, CloseProcess, CloseJob.
+	out.ThreadClose, out.ProcessClose, out.JobClose = closeView(0), closeView(1), closeView(2)
+	out.WrapperClose = ForegroundCloseObservation{AcquiredKnown: true}
+	out.LibraryClose = ForegroundCloseObservation{
+		AcquiredKnown: true, Acquired: child.ownsLibrary && child.libraryAcquired,
+		CloseAttempted: child.libraryCloseAttempted,
+		ClosedKnown:    child.libraryCloseAttempted && child.libraryClosed,
+		Closed:         child.libraryClosed, Error: child.libraryCloseError,
+	}
+	for _, slot := range []struct {
+		name string
+		view ForegroundCloseObservation
+	}{
+		{"job-handle", out.JobClose}, {"original-process-handle", out.ProcessClose},
+		{"original-thread-handle", out.ThreadClose}, {"rust-owner-library", out.LibraryClose},
+	} {
+		if slot.view.Acquired && (!slot.view.ClosedKnown || !slot.view.Closed) {
+			out.Pending = append(out.Pending, slot.name)
+		}
+	}
+	if child.sourceCloseErr != nil {
+		out.Pending = append(out.Pending, "native-stdio-copies")
+	}
+}
diff --git a/internal/process/rust_owner_foreground_windows_test.go b/internal/process/rust_owner_foreground_windows_test.go

+func TestRustOwnerMemberCloseFinalityAndFailureAreImmutable(t *testing.T) {
+	for _, mode := range []string{"cleanup-zero", "missing", "repeat", "omit", "wrong-generation", "bad-report", "no-finality", "invalid-finality"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newRustMemberScript(t)
+			o := f.acquire(t)
+			f.closeMode = mode
+			proof, err := o.CloseObserved()
+			wantFinal := mode != "no-finality" && mode != "invalid-finality"
+			if err == nil || proof.Finalized() != wantFinal || proof.Snapshot().Complete || f.closeCalls != 1 {
+				t.Fatalf("close classification: final=%t calls=%d err=%v", proof.Finalized(), f.closeCalls, err)
+			}
+			if mode == "cleanup-zero" {
+				v := proof.Snapshot()
+				if len(v.Resources) != 2 || v.Resources[1].CloseError == nil || v.Resources[1].Closed || !v.Resources[1].CloseAttempted {
+					t.Fatal("present zero-code close failure lost")
+				}
+				v.Resources[1].CloseError.Code = "tampered"
+				if proof.Snapshot().Resources[1].CloseError.Code == "tampered" {
+					t.Fatal("receipt aliases external error pointer")
+				}
+			}
+			f.closeMode = ""
+			again, againErr := o.CloseObserved()
+			if againErr == nil || f.closeCalls != 1 || again.Finalized() != wantFinal || (wantFinal && again != proof) {
+				t.Fatal("repeat improved or repeated an entered close")
+			}
+			f.owner.memberGate.mu.Lock()
+			active := f.owner.memberGate.active
+			f.owner.memberGate.mu.Unlock()
+			if (active == nil) != wantFinal {
+				t.Fatal("native finality and common guard disagree")
+			}
+		})
+	}
+}

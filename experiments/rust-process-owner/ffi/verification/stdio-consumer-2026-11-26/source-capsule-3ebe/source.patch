+	baseline, _, err := api.BuildSerenaBuildEnvironmentProjection(ctx, baselineSource, policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baselineSHA, err := baseline.SHA256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name, declaration, overlay, runtimeValue string
+		present, omitted                         bool
+	}{
+		{name: "absent"},
+		{name: "manifest", present: true, declaration: "1", runtimeValue: "1"},
+		{name: "operator override", present: true, declaration: "1", overlay: "0", runtimeValue: "0"},
+		{name: "unavailable runtime secret", present: true, declaration: "secret:ABSENT_RUNTIME", omitted: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			manifest := &config.ServerManifest{Name: api.SerenaServerName, BaseArgs: []string{
+				"--from", "git+https://github.com/oraios/serena@949a27ef1e5fda1a6e7b561e777bcece345c6ffd", "serena",
+			}, Env: map[string]string{}}
+			if tc.present {
+				manifest.Env["PYTHONUNBUFFERED"] = tc.declaration
+			}
+			overlayValues := map[string]string{}
+			if tc.overlay != "" {
+				overlayValues["PYTHONUNBUFFERED"] = tc.overlay
+			}
+			overlay := &daemon_env_overlay.Overlay{Daemons: map[string]daemon_env_overlay.DaemonRow{
+				task: {Source: "operator", Env: overlayValues},
+			}}
+			resolver := secrets.NewResolver(nil, nil)
+			source, err := buildSerenaEnvironmentSourceFromOverlay(ctx, manifest, resolver, task, nil, bootstrap, overlay)
+			if err != nil {
+				t.Fatal("runtime declaration blocked preparation source", err)
+			}
+			projection, _, err := api.BuildSerenaBuildEnvironmentProjection(ctx, source, policy)
+			if err != nil {
+				t.Fatal(err)
+			}
+			sha, err := projection.SHA256()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if sha != baselineSHA {
+				t.Fatal("runtime manifest or overlay changed build identity")
+			}
+
+			// Exercise the normal runtime resolver and merge with an in-memory
+			// overlay reader. This does not start the server or prepare packages.
+			load := func(gotTask string) (map[string]string, error) {
+				if gotTask != task {
+					t.Fatalf("runtime overlay task = %q, want %q", gotTask, task)
+				}
+				return overlayValues, nil
+			}
+			lookup := func(string) (string, bool) { return "", false }
+			environment, unset, err := daemonEnvWithOverlayReader("serena", "default", manifest.Env, resolver, load, lookup)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, present := environment["PYTHONUNBUFFERED"]
+			if got != tc.runtimeValue || present != (tc.present && !tc.omitted) {
+				t.Fatalf("runtime output environment = (%q, %t), want (%q, %t)",
+					got, present, tc.runtimeValue, tc.present && !tc.omitted)
+			}
+			if tc.omitted {
+				if len(unset) != 1 || unset[0] != "PYTHONUNBUFFERED" {
+					t.Fatalf("unresolved optional runtime secret not unset: %v", unset)
+				}
+			} else if len(unset) != 0 {
+				t.Fatalf("unexpected runtime unset list: %v", unset)
+			}
+			if tc.present && manifest.Env["PYTHONUNBUFFERED"] != tc.declaration {
+				t.Fatal("preparation or runtime overlay mutated the manifest")
+			}
+		})
+	}
+}

+				!strings.Contains(err.Error(), "fallback retention panic") || probe.calls.Load() != 0 || api.freeCalls != 0 {
+				t.Fatalf("fallback panic lost module: p=%p retained=%p escaped=%v err=%v retains=%d creates=%d frees=%d",
+					p, retained, escaped, err, retains, probe.calls.Load(), api.freeCalls)

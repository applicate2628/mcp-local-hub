+func TestOriginalJobMemberBatchCloseFinality(t *testing.T) {
+	for _, tc := range []struct {
+		name                     string
+		resource, borrowed, fail bool
+	}{
+		{name: "zero-owned"},
+		{name: "borrowed-original", resource: true, borrowed: true},
+		{name: "owned-success", resource: true},
+		{name: "owned-failure", resource: true, fail: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls, legacyCalls := 0, 0
+			binding := &struct{ generation uint64 }{generation: 7}
+			view := originalMemberBatchTestView()
+			var failure error
+			var owner *OriginalJobMemberObservation
+			owner, source := originalMemberBatchTestOwner(t, func(ctx context.Context, got *OriginalJobMemberObservation) (OriginalJobMemberCloseSnapshotV1, bool, error) {
+				calls++
+				if ctx != nil || got != owner || got.native != binding {
+					t.Error("batch lost its original observation or nil admission context")
+				}
+				if !got.source.gate.mu.TryLock() {
+					t.Error("batch callback ran with custody metadata locked")
+				} else {
+					got.source.gate.mu.Unlock()
+				}
+				return view, true, failure
+			})
+			owner.native = binding
+			if tc.resource {
+				held := OriginalJobMemberResourceV1{PID: 42, Acquired: true, BorrowedOriginal: tc.borrowed}
+				owner.resources = []*originalMemberResource{{
+					view: held,
+					close: func() error {
+						legacyCalls++
+						t.Error("batch close delegated to a per-resource closer")
+						return nil
+					},
+				}}
+				owner.view.Resources = []OriginalJobMemberResourceV1{held}
+				closed := held
+				if !tc.borrowed {
+					closed.CloseAttempted = true
+					closed.Closed = !tc.fail
+				}
+				if tc.fail {
+					failure = errors.New("controlled batch cleanup failure")
+					closed.CloseError = &SIDFormatFailureV1{Code: "CONTROLLED_CLOSE_FAILURE"}
+					view.Complete = false
+					view.CleanupErrors = []SIDFormatFailureV1{*closed.CloseError}
+				}
+				view.Resources = []OriginalJobMemberResourceV1{closed}
+			}
+
+			proof, err := owner.CloseObserved()
+			if proof == nil || !proof.Finalized() || !errors.Is(err, failure) {
+				t.Fatalf("batch did not publish finality: proof=%t err=%v", proof != nil, err)
+			}
+			if proof.Snapshot().Complete != !tc.fail || (proof.Validate(source) == nil) != !tc.fail {
+				t.Fatal("batch finality was confused with cleanup success")
+			}
+			replay, replayErr := owner.CloseObserved()
+			if replay != proof || !errors.Is(replayErr, failure) || calls != 1 || legacyCalls != 0 {
+				t.Fatalf("batch replay repeated close: batch=%d legacy=%d err=%v", calls, legacyCalls, replayErr)
+			}
+			source.gate.mu.Lock()
+			active, drained := source.gate.active, source.gate.drained
+			source.gate.mu.Unlock()
+			if active != nil {
+				t.Fatal("finalized batch retained the active guard")
+			}
+			select {
+			case <-drained:
+			default:
+				t.Fatal("finalized batch did not publish drain")
+			}
+		})
+	}
+}

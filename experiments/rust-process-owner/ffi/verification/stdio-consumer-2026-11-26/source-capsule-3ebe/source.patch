+// Every write remains beneath the approved D root; reject ancestor junctions.
+func foregroundConPTYDirectory(path string) error {
+	const root = "D:\\dev\\ChatGPT"
+	if !filepath.IsAbs(path) {
+		return errors.New("ConPTY path must be absolute")
+	}
+	relative, err := filepath.Rel(root, filepath.Clean(path))
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(os.PathSeparator)) || filepath.IsAbs(relative) {
+		return errors.New("ConPTY path must remain under D:\\dev\\ChatGPT")
+	}
+	current := filepath.VolumeName(path) + string(os.PathSeparator)
+	parts := strings.Split(strings.TrimPrefix(filepath.Clean(path), current), string(os.PathSeparator))
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		current = filepath.Join(current, part)
+		wide, err := windows.UTF16PtrFromString(current)
+		if err != nil {
+			return err
+		}
+		attributes, err := windows.GetFileAttributes(wide)
+		if err != nil {
+			return err
+		}
+		if attributes&windows.FILE_ATTRIBUTE_DIRECTORY == 0 || attributes&windows.FILE_ATTRIBUTE_REPARSE_POINT != 0 {
+			return errors.New("ConPTY directory is not an ordinary non-reparse directory")
+		}
+	}
+	return nil
+}
+
+func foregroundConPTYRead(path string, limit int64) ([]byte, error) {
+	if err := foregroundConPTYDirectory(filepath.Dir(path)); err != nil {
+		return nil, err
+	}
+	if err := requireOrdinaryWindowsFile(path, "ConPTY evidence"); err != nil {
+		return nil, err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	raw, readErr := io.ReadAll(io.LimitReader(file, limit+1))
+	err = errors.Join(readErr, file.Close())
+	if int64(len(raw)) > limit {
+		err = errors.Join(err, errors.New("ConPTY evidence exceeds its byte bound"))
+	}
+	return raw, err
+}
+
+func foregroundConPTYHashFile(path string) (string, error) {
+	if err := foregroundConPTYDirectory(filepath.Dir(path)); err != nil {
+		return "", err
+	}
+	if err := requireOrdinaryWindowsFile(path, "ConPTY input"); err != nil {
+		return "", err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	hash := sha256.New()
+	count, readErr := io.Copy(hash, io.LimitReader(file, (128<<20)+1))
+	err = errors.Join(readErr, file.Close())
+	if count > 128<<20 {
+		err = errors.Join(err, errors.New("ConPTY image exceeds the fixture input bound"))
+	}
+	return hex.EncodeToString(hash.Sum(nil)), err
+}
+
+func foregroundConPTYDecode(raw []byte, value any) error {
+	decoder := json.NewDecoder(strings.NewReader(string(raw)))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(value); err != nil {
+		return err
+	}
+	var tail any
+	if err := decoder.Decode(&tail); !errors.Is(err, io.EOF) {
+		return errors.Join(err, errors.New("trailing ConPTY JSON"))
+	}
+	return nil
+}
+
+func foregroundConPTYWrite(path string, value any) ([]byte, error) {
+	if err := foregroundConPTYDirectory(filepath.Dir(path)); err != nil {
+		return nil, err
+	}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	if len(raw) > foregroundConPTYOutputLimit {
+		return nil, errors.New("ConPTY report exceeds its byte bound")
+	}
+	raw = append(raw, '\n')
+	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	n, writeErr := file.Write(raw)
+	if writeErr == nil && n != len(raw) {
+		writeErr = io.ErrShortWrite
+	}
+	return raw, errors.Join(writeErr, file.Close())
+}
+
+// The data file is closed before its completion marker can become observable.
+func foregroundConPTYPublish(path string, value any) ([]byte, error) {
+	raw, err := foregroundConPTYWrite(path, value)
+	if err != nil {
+		return nil, err
+	}
+	marker, err := os.OpenFile(path+".ready", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	return raw, marker.Close()
+}
+
+func foregroundConPTYReadPublished(path string) ([]byte, bool, error) {
+	if _, err := os.Lstat(path + ".ready"); os.IsNotExist(err) {
+		return nil, false, nil
+	} else if err != nil {
+		return nil, false, err
+	}
+	marker, err := foregroundConPTYRead(path+".ready", 0)
+	if err != nil || len(marker) != 0 {
+		return nil, false, errors.Join(err, errors.New("invalid ConPTY completion marker"))
+	}
+	raw, err := foregroundConPTYRead(path, foregroundConPTYOutputLimit)
+	return raw, true, err
+}
+
+func foregroundConPTYAwaitPublished(ctx context.Context, path string) ([]byte, error) {
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		raw, ready, err := foregroundConPTYReadPublished(path)
+		if err != nil || ready {
+			return raw, errors.Join(err, ctx.Err())
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}

@@ -0,0 +1,37 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+)
+
+func (owner *rustNativeOwner) creatorIdentityOwnerPresent() bool { return owner != nil }
+
+// ObserveCreatorIdentity issues historical identity evidence from this
+// retained native owner. Its one query lease covers native observation,
+// actual SID formatting, validation and the final capability return.
+func (owner *rustNativeOwner) ObserveCreatorIdentity(ctx context.Context) (*CreatorIdentity, error) {
+	if err := creatorClosureContext(ctx); err != nil {
+		return nil, err
+	}
+	if owner == nil || owner.memberGate == nil {
+		return nil, creatorClosureUnavailable(errors.New("original Rust creator identity unavailable"))
+	}
+	leave, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		return nil, err
+	}
+	defer leave()
+
+	observation, err := owner.formatOriginalUserSIDAdmitted(ctx)
+	if err != nil {
+		return nil, err
+	}
+	view, err := observation.creatorFacts()
+	if err != nil {
+		return nil, err
+	}
+	return newCreatorIdentity(ctx, owner, view, observation.receipt)
+}

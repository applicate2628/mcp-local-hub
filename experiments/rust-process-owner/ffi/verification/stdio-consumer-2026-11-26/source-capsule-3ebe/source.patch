+
+type foregroundConPTYAPI struct{ create, release, close *windows.LazyProc }
+
+// HPCON is a native VOID pointer. Keep that representation through Update;
+// no integer-to-Go-pointer reconstruction or replacement process is involved.
+type foregroundConPTYNativeResult struct {
+	handle unsafe.Pointer
+	status uint32
+}
+type foregroundConPTYNativeWork struct {
+	done   chan foregroundConPTYNativeResult
+	joined bool
+	result foregroundConPTYNativeResult
+}
+type foregroundConPTYIOResult struct {
+	data          []byte
+	n             int64
+	eof, overflow bool
+	err           error
+}
+type foregroundConPTYIOWork struct {
+	done   chan foregroundConPTYIOResult
+	joined bool
+	result foregroundConPTYIOResult
+}
+type foregroundConPTYRunResult struct {
+	result ForegroundResult
+	err    error
+}
+type foregroundConPTYStarted struct {
+	original *AtCreateJobProcess
+	config   foregroundConPTYConfig
+	digest   string
+}
+type foregroundConPTYHost struct {
+	api                                            foregroundConPTYAPI
+	config                                         foregroundConPTYConfig
+	console                                        *foregroundOwnedConsole
+	inputRead, inputWrite, outputRead, outputWrite *os.File
+	stdin, stdout, stderr, outputCapture           *os.File
+	create, release, close                         *foregroundConPTYNativeWork
+	reader, writer                                 *foregroundConPTYIOWork
+	hpc                                            unsafe.Pointer
+	run                                            chan foregroundConPTYRunResult
+	started                                        chan foregroundConPTYStarted
+	runJoined                                      bool
+	runResult                                      foregroundConPTYRunResult
+	original                                       *AtCreateJobProcess
+	admission                                      *foregroundTestAdmission
+	cancel                                         context.CancelFunc
+	closed                                         map[*os.File]error
+	finished, retained, closeBeforeEOF             bool
+	finishErr                                      error
+}
+
+var foregroundConPTYRetainedHosts []*foregroundConPTYHost
+
+func foregroundConPTYStartNative(call func() foregroundConPTYNativeResult) *foregroundConPTYNativeWork {
+	work := &foregroundConPTYNativeWork{done: make(chan foregroundConPTYNativeResult, 1)}
+	go func() { work.done <- call() }()
+	return work
+}
+func (work *foregroundConPTYNativeWork) await(ctx context.Context) error {
+	if work == nil || work.joined {
+		return nil
+	}
+	select {
+	case work.result = <-work.done:
+		work.joined = true
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+func (work *foregroundConPTYIOWork) await(ctx context.Context) error {
+	if work == nil || work.joined {
+		return nil
+	}
+	select {
+	case work.result = <-work.done:
+		work.joined = true
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func foregroundConPTYStartReader(source, evidence *os.File) *foregroundConPTYIOWork {
+	work := &foregroundConPTYIOWork{done: make(chan foregroundConPTYIOResult, 1)}
+	go func() {
+		var result foregroundConPTYIOResult
+		var buffer [4096]byte
+		var writeErr error
+		for {
+			n, err := source.Read(buffer[:])
+			result.n += int64(n)
+			if n > 0 {
+				keep := n
+				if keep > foregroundConPTYOutputLimit-len(result.data) {
+					keep = foregroundConPTYOutputLimit - len(result.data)
+					result.overflow = true
+				}
+				if keep > 0 {
+					result.data = append(result.data, buffer[:keep]...)
+					if writeErr == nil {
+						written, cause := evidence.Write(buffer[:keep])
+						if cause == nil && written != keep {
+							cause = io.ErrShortWrite
+						}
+						writeErr = cause
+					}
+				}
+			}
+			if err != nil {
+				result.eof = errors.Is(err, io.EOF)
+				if !result.eof {
+					result.err = err
+				}
+				break
+			}
+			if n == 0 {
+				result.err = io.ErrNoProgress
+				break
+			}
+		}
+		result.err = errors.Join(result.err, writeErr, evidence.Close())
+		work.done <- result // Publishes the immutable payload and file-close result.
+	}()
+	return work
+}
+
+func (host *foregroundConPTYHost) awaitRun(ctx context.Context) error {
+	if host.run == nil || host.runJoined {
+		return nil
+	}
+	select {
+	case host.runResult = <-host.run:
+		host.runJoined = true
+		if host.original == nil {
+			host.original = host.runResult.result.Original
+		}
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (host *foregroundConPTYHost) awaitStarted(ctx context.Context) (foregroundConPTYStarted, error) {
+	select {
+	case started := <-host.started:
+		host.original, host.config = started.original, started.config
+		return started, nil
+	case host.runResult = <-host.run:
+		host.runJoined = true
+		host.original = host.runResult.result.Original
+		return foregroundConPTYStarted{}, errors.Join(host.runResult.err, errors.New("ConPTY original actor did not reach its pre-resume binding"))
+	case <-ctx.Done():
+		return foregroundConPTYStarted{}, ctx.Err()
+	}
+}
+
+func (host *foregroundConPTYHost) awaitReady(ctx context.Context) ([]byte, error) {
+	ticker := time.NewTicker(10 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		raw, ready, err := foregroundConPTYReadPublished(filepath.Join(host.config.Directory, "actor-ready.json"))
+		if err != nil || ready {
+			return raw, errors.Join(err, ctx.Err())
+		}
+		select {
+		case host.runResult = <-host.run:
+			host.runJoined = true
+			return nil, errors.Join(host.runResult.err, errors.New("ConPTY original actor exited before ready acknowledgment"))
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+func foregroundConPTYValidateReady(config foregroundConPTYConfig, digest string, ready foregroundConPTYReady) error {
+	if ready.Schema != "foreground-conpty-ready-v1" || ready.Nonce != config.Nonce || ready.ConfigSHA256 != digest ||
+		ready.PID != config.ActorPID || ready.Born != config.ActorBorn ||
+		!ready.Processes.Attempted || !ready.Processes.Completed || !ready.Processes.OK || ready.Processes.Code != 0 || ready.Processes.Error != "" ||
+		ready.Processes.Count == 0 || ready.Processes.Count > 64 || ready.Processes.Count != uint32(len(ready.PIDs)) ||
+		!ready.Window.Attempted || !ready.Window.Completed || !ready.Window.OK || ready.Window.Code != 0 || ready.Window.Error != "" ||
+		ready.Modes[0]&(windows.ENABLE_LINE_INPUT|windows.ENABLE_ECHO_INPUT) != 0 {
+		return errors.New("ConPTY ready acknowledgment lacks its original identity or native observations")
+	}
+	seen := make(map[uint32]bool, len(ready.PIDs))
+	for _, pid := range ready.PIDs {
+		if pid == 0 || seen[pid] {
+			return errors.New("ConPTY ready PID list is malformed")
+		}
+		seen[pid] = true
+	}
+	if !seen[config.ActorPID] || seen[config.HostPID] {
+		return errors.New("ConPTY actor console membership differs from its original host")
+	}
+	return nil
+}
+
+func (host *foregroundConPTYHost) closeFile(file *os.File) error {
+	if file == nil {
+		return nil
+	}
+	if err, attempted := host.closed[file]; attempted {
+		return err
+	}
+	err := file.Close()
+	host.closed[file] = err
+	return err
+}
+
+func (host *foregroundConPTYHost) keep(err error) error {
+	host.retained = true
+	host.finishErr = errors.Join(host.finishErr, err, errors.New("ConPTY fixture custody retained until receiver exit"))
+	return host.finishErr
+}
+
+func (host *foregroundConPTYHost) closeConsole() error {
+	for _, file := range host.console.files {
+		if err := host.closeFile(file); err != nil {
+			return err
+		}
+	}
+	if host.console.allocated {
+		if err := foregroundConsoleBoolean("FreeConsole"); err != nil {
+			return err
+		}
+		host.console.allocated = false
+		if count, err := foregroundConsoleProcessCount(); err != nil || count != 0 {
+			return errors.Join(err, errors.New("owned host console detach unproved"))
+		}
+	}
+	if host.console.saved {
+		for i, id := range [...]uint32{windows.STD_INPUT_HANDLE, windows.STD_OUTPUT_HANDLE, windows.STD_ERROR_HANDLE} {
+			if err := windows.SetStdHandle(id, host.console.original[i]); err != nil {
+				return err
+			}
+		}
+		host.console.saved = false
+	}
+	return nil
+}
+
+// A single immutable fixture deadline bounds joins. This never re-observes or
+// renews any original owner's cached terminal action.
+func (host *foregroundConPTYHost) finish() error {
+	if host.finished {
+		return host.finishErr
+	}
+	host.finished = true
+	if host.cancel != nil {
+		host.cancel()
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), host.config.CleanupDeadline)
+	defer cancel()
+	if err := host.awaitRun(ctx); err != nil {
+		return host.keep(err)
+	}
+	if err := host.create.await(ctx); err != nil {
+		return host.keep(err)
+	}
+	if host.create != nil {
+		host.hpc = host.create.result.handle
+		if host.create.result.status != 0 && host.hpc != nil {
+			return host.keep(errors.New("failed pseudoconsole create returned an ambiguous handle"))
+		}
+	}
+	if err := host.release.await(ctx); err != nil {
+		return host.keep(err)
+	}
+	if host.run != nil {
+		result := host.runResult.result
+		if !host.runJoined || !result.Settlement.Complete() || !result.Native.HandlesClosed || len(result.Outcome.Pending) != 0 {
+			return host.keep(errors.New("original actor/descendant settlement is incomplete"))
+		}
+	}
+	// An unjoined input writer retains every session resource, including HPCON.
+	if err := host.writer.await(ctx); err != nil {
+		return host.keep(err)
+	}
+	// These are unused host copies supplied to CreatePseudoConsole. Retaining
+	// outputWrite would conceal EOF after the actual console clients depart.
+	for _, file := range []*os.File{host.inputRead, host.outputWrite} {
+		if err := host.closeFile(file); err != nil {
+			return host.keep(err)
+		}
+	}
+	released := host.release != nil && host.release.joined && host.release.result.status == 0
+	if host.hpc != nil && released {
+		drain, stop := context.WithDeadline(context.Background(), host.config.CleanupDeadline.Add(-2*time.Second))
+		err := host.reader.await(drain)
+		stop()
+		if err != nil {
+			host.finishErr = errors.Join(host.finishErr, fmt.Errorf("natural ConPTY output drain: %w", err))
+		}
+	}
+	if host.hpc != nil {
+		host.closeBeforeEOF = host.reader == nil || !host.reader.joined || !host.reader.result.eof
+		if ctx.Err() != nil {
+			return host.keep(ctx.Err())
+		}
+		hpc := host.hpc
+		host.close = foregroundConPTYStartNative(func() foregroundConPTYNativeResult {
+			host.api.close.Call(uintptr(hpc)) // void: only return is observed, no invented HRESULT.
+			runtime.KeepAlive(host)
+			return foregroundConPTYNativeResult{}
+		})
+		if err := host.close.await(ctx); err != nil {
+			return host.keep(err)
+		}
+		host.hpc = nil
+	}
+	if err := host.reader.await(ctx); err != nil {
+		return host.keep(err)
+	}
+	if host.reader != nil && (host.reader.result.err != nil || !host.reader.result.eof) {
+		return host.keep(errors.Join(host.reader.result.err, errors.New("ConPTY reader did not receive natural pipe EOF")))
+	}
+	for _, file := range []*os.File{host.inputWrite, host.outputRead, host.stdin, host.stdout, host.stderr} {
+		if err := host.closeFile(file); err != nil {
+			return host.keep(err)
+		}
+	}
+	if err := host.closeConsole(); err != nil {
+		return host.keep(err)
+	}
+	return host.finishErr
+}
+
+func (host *foregroundConPTYHost) receipt(t *testing.T) {
+	t.Helper()
+	if err := host.finish(); err != nil {
+		t.Error(err)
+	}
+	if host.retained {
+		foregroundConPTYRetainedHosts = append(foregroundConPTYRetainedHosts, host)
+		foregroundConsoleRetainFixture(t, host.original, nil, host.console, []*os.File{
+			host.inputRead, host.inputWrite, host.outputRead, host.outputWrite, host.stdin, host.stdout, host.stderr, host.outputCapture})
+	}
+	record := map[string]any{
+		"schema": "foreground-conpty-host-v1", "test_failed": t.Failed(), "retained": host.retained,
+		"run_joined": host.runJoined, "close_before_eof": host.closeBeforeEOF, "hpc_retained": host.hpc != nil,
+		"finish_error": foregroundConPTYError(host.finishErr), "config": host.config,
+	}
+	if host.runJoined {
+		record["original_root"] = fmt.Sprintf("%+v", host.runResult.result.Root)
+		record["original_native"] = fmt.Sprintf("%+v", host.runResult.result.Native)
+		record["original_outcome"] = fmt.Sprintf("%+v", host.runResult.result.Outcome)
+		record["original_error"] = foregroundConPTYError(host.runResult.err)
+		record["original_complete"] = host.runResult.result.Settlement.Complete()
+		record["hooks"], record["closes"] = host.admission.hooks, host.admission.closes
+	}
+	for name, call := range map[string]*foregroundConPTYNativeWork{"create": host.create, "release": host.release, "close": host.close} {
+		if call != nil {
+			view := map[string]any{"joined": call.joined}
+			if call.joined && name != "close" {
+				view["hresult"] = call.result.status
+			}
+			record[name] = view
+		}
+	}
+	for name, work := range map[string]*foregroundConPTYIOWork{"reader": host.reader, "writer": host.writer} {
+		if work != nil {
+			view := map[string]any{"joined": work.joined}
+			if work.joined {
+				view["bytes"], view["eof"], view["overflow"], view["error"] = work.result.n, work.result.eof, work.result.overflow, foregroundConPTYError(work.result.err)
+			}
+			record[name] = view
+		}
+	}
+	if _, err := foregroundConPTYWrite(filepath.Join(host.config.Directory, "host-final.json"), record); err != nil {
+		t.Error(err)
+	}
+}

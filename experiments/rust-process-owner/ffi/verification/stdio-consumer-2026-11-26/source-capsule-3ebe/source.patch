+func TestFacadeCustodyCloseRetriesOnlyPositiveAdmissionRefusal(t *testing.T) {
+	for _, wrapper := range []bool{false, true} {
+		for _, entered := range []bool{false, true} {
+			name := map[bool]string{false: "provisional", true: "at-create"}[wrapper] + "/" +
+				map[bool]string{false: "pre-entry", true: "entered-unknown"}[entered]
+			t.Run(name, func(t *testing.T) {
+				p, child := newFacadeCustodyFixture()
+				child.created = false
+				admission := originalMemberCloseAdmissionPending("synthetic-lock", context.DeadlineExceeded)
+				first := admission
+				if entered {
+					first = errors.Join(errors.New("entered native outcome unknown"), admission)
+				}
+				child.closeFn = func() error {
+					if child.closes.Load() == 1 {
+						return first
+					}
+					return nil
+				}
+				var closeOwner func() error
+				if wrapper {
+					owner := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{}),
+						settleResult: ContainedNativeSnapshot{NoChildKnown: true}}
+					closeOwner = func() error { _, err := owner.ReleaseOriginal(); return err }
+				} else {
+					closeOwner = p.close
+				}
+				if err := closeOwner(); !errors.Is(err, ErrOriginalMemberBorrowPending) {
+					t.Fatalf("first refusal cause lost: %v", err)
+				}
+				err := closeOwner()
+				if entered {
+					if !errors.Is(err, first) || child.closes.Load() != 1 {
+						t.Fatal("nested admission marker replayed an entered close")
+					}
+				} else if err != nil || child.closes.Load() != 2 {
+					t.Fatalf("positive pre-entry refusal permanently consumed close: calls=%d err=%v", child.closes.Load(), err)
+				}
+			})
+		}
+	}

+	if !errors.Is(err, errRustOwnerOutcome) || p == nil || p != retained || !p.Created() || retains != 1 || creates != 1 {
+		t.Fatalf("post-create error lost historical custody: p=%p retained=%p err=%v retains=%d creates=%d",
+			p, retained, err, retains, creates)

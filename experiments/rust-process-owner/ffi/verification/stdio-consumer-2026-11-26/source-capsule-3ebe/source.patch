+_Static_assert(sizeof(mh_member_resource)==16 &&
+    offsetof(mh_member_resource,close_error)==8, "member resource layout");
+_Static_assert(sizeof(mh_members_snapshot)==120 &&
+    offsetof(mh_members_snapshot,original)==24 && offsetof(mh_members_snapshot,pre)==40 &&
+    offsetof(mh_members_snapshot,post)==64 && offsetof(mh_members_snapshot,rows)==88 &&
+    offsetof(mh_members_snapshot,resources)==104, "member snapshot layout");
+_Static_assert(sizeof(mh_members_close)==40 &&
+    offsetof(mh_members_close,resources)==24, "member close layout");
+_Static_assert(sizeof(mh_members_report)==24 &&
+    offsetof(mh_members_report,native_error)==16 &&
+    offsetof(mh_members_report,token_close_error)==20, "member report layout");

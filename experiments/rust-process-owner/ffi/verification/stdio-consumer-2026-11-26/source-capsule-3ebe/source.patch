+func TestSerenaInterpreterSelectedLocator(t *testing.T) {
+	for _, kind := range []string{"ordinary", "junction", "long-path"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			targetDir := filepath.Join(root, "target")
+			if kind == "long-path" {
+				for i := 0; i < 4; i++ {
+					targetDir = filepath.Join(targetDir, strings.Repeat("p", 64))
+				}
+			}
+			if err := os.MkdirAll(targetDir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			target := filepath.Join(targetDir, "python.exe")
+			payload := []byte("ordinary file qualification fixture; never executed\n")
+			if err := os.WriteFile(target, payload, 0600); err != nil {
+				t.Fatal(err)
+			}
+			selected := target
+			if kind == "junction" {
+				link := filepath.Join(root, "selected")
+				serenaInterpreterJunctionForTest(t, root, link, targetDir)
+				selected = filepath.Join(link, "python.exe")
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			baseline, _, err := qualifyPreparedSerenaFile(ctx, target, 1<<20)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if kind == "junction" {
+				if _, _, err := qualifyPreparedSerenaFile(ctx, selected, 1<<20); err == nil {
+					t.Fatal("general file qualifier accepted the discovery alias")
+				}
+			}
+			actual, err := qualifyPreparedSerenaInterpreter(ctx, selected, 1<<20)
+			if err != nil {
+				t.Fatal(err)
+			}
+			wantHash := sha256.Sum256(payload)
+			if actual.Device != baseline.Device || actual.FileID != baseline.FileID ||
+				actual.SHA256 != baseline.SHA256 || actual.SHA256 != hex.EncodeToString(wantHash[:]) {
+				t.Fatalf("selected original identity or bytes changed: got=%+v baseline=%+v", actual, baseline)
+			}
+			canonical, err := qualifyPreparedSerenaInterpreter(ctx, target, 1<<20)
+			if err != nil || actual != canonical {
+				t.Fatalf("alias and ordinary target differ: got=%+v canonical=%+v err=%v", actual, canonical, err)
+			}
+			if err := revalidatePreparedSerenaFile(ctx, actual); err != nil {
+				t.Fatalf("canonical target does not pass unchanged strict revalidation: %v", err)
+			}

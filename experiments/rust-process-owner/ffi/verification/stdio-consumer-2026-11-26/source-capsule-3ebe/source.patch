+	if err != nil || second != first+1 {
+		t.Fatalf("refused operations consumed a generation: %d -> %d, %v", first, second, err)
+	}
+	if _, err := o.CloseJobMembers(first); err == nil {
+		t.Fatal("old generation was silently replaced by the new one")
+	}
+	requireMemberClose(t, o, second)
+	absent(t, marker)

+func foregroundConPTYValidateConfig(config foregroundConPTYConfig, path string) error {
+	if config.Schema != "foreground-conpty-config-v1" || !canonicalLowerHex(config.Nonce, 32) ||
+		!canonicalLowerHex(config.ActorSHA256, 64) || !canonicalLowerHex(config.LeafSHA256, 64) ||
+		!canonicalLowerHex(config.NativeSHA256, 64) || !canonicalLowerHex(config.NativeCommit, 40) ||
+		!sameWindowsPath(config.Directory, filepath.Dir(path)) || filepath.Base(path) != "actor-config.json" ||
+		config.HostPID == 0 || config.ActorPID == 0 || config.HostPID == config.ActorPID || config.ActorBorn == 0 {
+		return errors.New("ConPTY actor config binding is invalid")
+	}
+	if err := foregroundConPTYDirectory(config.Directory); err != nil {
+		return err
+	}
+	if config.Started.IsZero() || !config.ActorDeadline.Equal(config.Started.Add(15*time.Second)) ||
+		!config.HostDeadline.Equal(config.ActorDeadline.Add(RetainedTerminationAllowance()+5*time.Second)) ||
+		!config.CleanupDeadline.Equal(config.HostDeadline.Add(RetainedTerminationAllowance()+5*time.Second)) ||
+		time.Until(config.ActorDeadline) <= 0 || time.Until(config.ActorDeadline) > 15*time.Second {
+		return errors.New("ConPTY actor requires the original finite live deadline")
+	}
+	self, err := os.Executable()
+	if err != nil || !sameWindowsPath(self, config.ActorExecutable) || filepath.Base(self) != "mcphub.exe" {
+		return errors.Join(err, errors.New("ConPTY actor image path differs"))
+	}
+	hash, err := foregroundConPTYHashFile(self)
+	if err != nil || hash != config.ActorSHA256 {
+		return errors.Join(err, errors.New("ConPTY actor image hash differs"))
+	}
+	hash, err = foregroundConPTYHashFile(config.LeafExecutable)
+	if err != nil || hash != config.LeafSHA256 {
+		return errors.Join(err, errors.New("ConPTY leaf image hash differs"))
+	}
+	var born, exited, kernel, user windows.Filetime
+	err = windows.GetProcessTimes(windows.CurrentProcess(), &born, &exited, &kernel, &user)
+	if err != nil || windows.GetCurrentProcessId() != config.ActorPID ||
+		uint64(born.HighDateTime)<<32|uint64(born.LowDateTime) != config.ActorBorn {
+		return errors.Join(err, errors.New("ConPTY config does not name this original actor"))
+	}
+	selected, err := ProductRustOwnerEnabled()
+	hash, hashErr := buildinfo.CurrentRustOwnerSHA256()
+	_, commit, _ := buildinfo.Get()
+	if err != nil || hashErr != nil || !selected || hash != config.NativeSHA256 || commit != config.NativeCommit {
+		return errors.Join(err, hashErr, errors.New("ConPTY actor compiled native trust operands differ"))
+	}
+	return foregroundConPTYNativeBinding(self, commit, hash)
+}
+
+func foregroundConPTYObserveReady(config foregroundConPTYConfig, digest string, files [3]*os.File) (foregroundConPTYReady, error) {
+	ready := foregroundConPTYReady{Schema: "foreground-conpty-ready-v1", Nonce: config.Nonce, ConfigSHA256: digest, PID: config.ActorPID, Born: config.ActorBorn}
+	proc := foregroundConsoleKernel.NewProc("GetConsoleProcessList")
+	if err := proc.Find(); err != nil {
+		return ready, err
+	}
+	var pids [64]uint32
+	count, _, callErr := proc.Call(uintptr(unsafe.Pointer(&pids[0])), uintptr(len(pids)))
+	if count == 0 {
+		return ready, errors.Join(callErr, errors.New("ConPTY actor GetConsoleProcessList returned zero"))
+	}
+	if count > uintptr(len(pids)) {
+		return ready, fmt.Errorf("ConPTY actor console list requires %d entries, limit=%d", count, len(pids))
+	}
+	ready.Processes = foregroundConsoleCall{Attempted: true, Completed: true, OK: true, Count: uint32(count)}
+	ready.PIDs = append([]uint32(nil), pids[:count]...)
+	seen := make(map[uint32]bool, len(ready.PIDs))
+	for _, pid := range ready.PIDs {
+		if pid == 0 || seen[pid] {
+			return ready, errors.New("invalid ConPTY console process list")
+		}
+		seen[pid] = true
+	}
+	if !seen[config.ActorPID] || seen[config.HostPID] {
+		return ready, errors.New("actor did not join a console separate from its host")
+	}
+	window := foregroundConsoleKernel.NewProc("GetConsoleWindow")
+	if err := window.Find(); err != nil {
+		return ready, err
+	}
+	hwnd, _, _ := window.Call()
+	ready.Window = foregroundConsoleCall{Attempted: true, Completed: true, OK: true}
+	ready.WindowHandle = uint64(hwnd) // Observed only; not a ConPTY classifier.
+	for i, file := range files {
+		if err := windows.GetConsoleMode(windows.Handle(file.Fd()), &ready.Modes[i]); err != nil {
+			return ready, err
+		}
+	}
+	return ready, nil
+}
+
+func TestForegroundConPTYActorMarkedReceiver(t *testing.T) {
+	configPath := os.Getenv(foregroundConPTYActorConfigEnv)
+	if configPath == "" {
+		t.Skip("requires the original ConPTY host's explicit actor config")
+	}
+	if len(os.Args) != 4 || os.Args[1] != foregroundConPTYActorRun || os.Args[2] != "-test.count=1" || os.Args[3] != "-test.timeout=30s" {
+		t.Fatal("ConPTY actor requires the exact isolated test argv")
+	}
+	raw, err := foregroundConPTYRead(configPath, foregroundConPTYOutputLimit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var config foregroundConPTYConfig
+	if err := foregroundConPTYDecode(raw, &config); err != nil {
+		t.Fatal(err)
+	}
+	if err := foregroundConPTYValidateConfig(config, configPath); err != nil {
+		t.Fatal(err)
+	}
+	foregroundConsoleRequirePE(t, config.ActorExecutable, 3)
+	foregroundConsoleRequirePE(t, config.LeafExecutable, 3)
+	if deadline, ok := t.Deadline(); !ok || deadline.Before(config.ActorDeadline.Add(RetainedTerminationAllowance()+2*time.Second)) {
+		t.Fatal("actor test deadline does not reserve original native cleanup")
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), config.ActorDeadline)
+	defer cancel()
+	report := foregroundConPTYActorReport{Schema: "foreground-conpty-actor-v1", Nonce: config.Nonce, ConfigSHA256: foregroundConPTYDigest(raw), PID: config.ActorPID, Born: config.ActorBorn}
+	console := &foregroundOwnedConsole{} // Only files: never AllocConsole/FreeConsole.
+	var result ForegroundResult
+	var captured *rustContainedChild
+	var admission *foregroundTestAdmission
+	borrows := 0
+	defer func() {
+		report.Complete = result.Settlement.Complete()
+		report.RootKnown, report.RootExit, report.RootError = result.Root.Known, result.Root.ExitCode, foregroundConPTYError(result.Root.Error)
+		report.LeafIdentity = result.Native.RootIdentity
+		report.NativeDetails, report.OutcomeDetails = fmt.Sprintf("%+v", result.Native), fmt.Sprintf("%+v", result.Outcome)
+		if admission != nil {
+			report.Hooks, report.Closes, report.Borrows = admission.hooks, admission.closes, borrows
+		}
+		if captured == nil && result.Original != nil {
+			captured, _ = result.Original.child.(*rustContainedChild)
+		}
+		var fixture *rustIONativeFixture
+		if captured != nil {
+			fixture = &rustIONativeFixture{owner: captured.owner, library: captured.library}
+		}
+		report.NativeReleased = !report.Attempted || report.Complete && captured != nil && foregroundConsoleRustResourcesReleased(t, fixture)
+		if report.NativeReleased {
+			for _, file := range console.files {
+				if file != nil {
+					if closeErr := file.Close(); closeErr != nil {
+						report.CloseErrors = append(report.CloseErrors, closeErr.Error())
+						t.Error(closeErr)
+						break // No further source close after an unproved close result.
+					}
+				}
+			}
+		}
+		if !report.NativeReleased || len(report.CloseErrors) != 0 {
+			report.Retained = true
+			foregroundConsoleRetainFixture(t, result.Original, fixture, console, nil)
+		}
+		report.Failed = t.Failed()
+		report.Qualified = !report.Failed && report.Attempted && report.Complete && report.NativeReleased && !report.Retained && len(report.CloseErrors) == 0
+		if _, err := foregroundConPTYPublish(filepath.Join(config.Directory, "actor-final.json"), report); err != nil {
+			t.Error(err)
+		}
+	}()
+	for i, name := range [...]string{"CONIN$", "CONOUT$", "CONOUT$"} {
+		console.files[i], err = os.OpenFile(name, os.O_RDWR, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	var inputMode uint32
+	input := windows.Handle(console.files[0].Fd())
+	if err := windows.GetConsoleMode(input, &inputMode); err != nil {
+		t.Fatal(err)
+	}
+	inputMode = inputMode&^(windows.ENABLE_LINE_INPUT|windows.ENABLE_ECHO_INPUT|windows.ENABLE_QUICK_EDIT_MODE) | windows.ENABLE_EXTENDED_FLAGS
+	if err := windows.SetConsoleMode(input, inputMode); err != nil {
+		t.Fatal(err)
+	}
+	if err := foregroundConsoleBoolean("FlushConsoleInputBuffer", uintptr(input)); err != nil {
+		t.Fatal(err)
+	}
+	ready, err := foregroundConPTYObserveReady(config, report.ConfigSHA256, console.files)
+	if err != nil {
+		t.Fatalf("actual ConPTY actor ready observation: %+v; %v", ready, err)
+	}
+	if err := ctx.Err(); err != nil {
+		t.Fatal(err)
+	}
+	readyRaw, err := foregroundConPTYPublish(filepath.Join(config.Directory, "actor-ready.json"), ready)
+	if err != nil {
+		t.Fatal(err)
+	}
+	grantRaw, err := foregroundConPTYAwaitPublished(ctx, filepath.Join(config.Directory, "host-grant.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var grant foregroundConPTYGrant
+	if err := foregroundConPTYDecode(grantRaw, &grant); err != nil {
+		t.Fatal(err)
+	}
+	if grant.Schema != "foreground-conpty-grant-v1" || grant.Nonce != config.Nonce || grant.ConfigSHA256 != report.ConfigSHA256 ||
+		grant.ReadySHA256 != foregroundConPTYDigest(readyRaw) || grant.InputBytes != 1 || !grant.ReleaseReturned || grant.ReleaseHRESULT != 0 {
+		t.Fatal("ConPTY host grant does not acknowledge this ready actor and one actual input byte")
+	}
+	if err := ctx.Err(); err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(config.Directory, "leaf-initial.json")
+	admission = &foregroundTestAdmission{hook: func(original *AtCreateJobProcess) error {
+		captured, _ = original.child.(*rustContainedChild)
+		if captured == nil || captured.owner == nil || !captured.ownsLibrary {
+			return errors.New("ConPTY leaf lacks its original Rust owner")
+		}
+		if err := rustForegroundNativeBorrowBeforeResume(original, marker); err != nil {
+			return err
+		}
+		borrows++
+		return nil
+	}}
+	cmd := exec.Command(config.LeafExecutable, "console-stdio", marker)
+	cmd.Dir, cmd.Env = config.Directory, foregroundConPTYEnvironment()
+	report.Attempted = true
+	result, err = RunForegroundAdmitted(ctx, cmd, console.files[0], console.files[1], console.files[2], admission)
+	report.RunError = foregroundConPTYError(err)
+	report.Initial, err = foregroundConsoleReadReport(t, marker)
+	if err != nil {
+		report.ReportErrors = append(report.ReportErrors, err.Error())
+	}
+	report.Final, err = foregroundConsoleReadReport(t, marker+".final.json")
+	if err != nil {
+		report.ReportErrors = append(report.ReportErrors, err.Error())
+	}
+	if report.RunError != "" || len(report.ReportErrors) != 0 || captured == nil || result.Original == nil {
+		t.Fatalf("ConPTY leaf execution failed: %+v", report)
+	}
+	rustForegroundNativeAssertSettlement(t, captured, result, 37)
+	if admission.hooks != 1 || admission.closes != 1 || borrows != 1 || result.Admission != admission ||
+		!result.AdmissionCloseAttempted || result.AdmissionCloseError != nil {
+		t.Fatal("ConPTY leaf admission/borrow lifecycle differs")
+	}
+	for _, observed := range [...]foregroundConsoleReport{report.Initial, report.Final} {
+		if observed.Schema != "foreground-console-child-v2" || observed.Mode != "console-stdio" || observed.PID != uint32(result.Native.RootIdentity.PID) {
+			t.Fatalf("ConPTY leaf report identity differs: %+v", observed)
+		}
+		foregroundConsoleAssertAssociation(t, observed, true)
+		for _, pid := range observed.ConsolePIDs {
+			if pid == config.HostPID {
+				t.Error("leaf joined the host's independent ordinary console")
+			}
+		}
+	}
+	final := report.Final
+	if !final.ExitKnown || final.ExitCode != 37 || !final.Read.Attempted || !final.Read.Completed || !final.Read.OK ||
+		final.Read.Code != 0 || final.Read.Count != 1 || final.Character != 'Q' {
+		t.Fatalf("ConPTY input did not reach the actual leaf ReadConsole: %+v", final)
+	}
+	for _, stream := range final.Streams {
+		if !stream.Handle.OK || !stream.Mode.Attempted || !stream.Mode.Completed || !stream.Mode.OK || stream.Mode.Code != 0 {
+			t.Errorf("ConPTY leaf standard console mode failed: %+v", stream)
+		}
+	}
+	for _, write := range final.Writes {
+		if !write.Attempted || !write.Completed || !write.OK || write.Code != 0 || write.Count != 11 {
+			t.Errorf("ConPTY leaf console write failed: %+v", write)
+		}
+	}
+}

+// Run only against an explicitly supplied DLL missing one or both new exports.
+func TestSplitMissingExportsPreserveLegacyLifecycle(t *testing.T) {
+	lib, child, dir := setup(t)
+	marker := filepath.Join(dir, "legacy-split")
+	owner, _, err := lib.New(child, dir, []string{"exit", marker, "7", "legacy"})
+	if owner != nil {
+		own(t, owner)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := owner.raw
+	got, err := owner.WaitForExit(0)
+	if !errors.Is(err, ErrWaitCloseUnsupported) || got != (ExitObservation{}) {
+		t.Fatalf("missing wait/close silently substituted: %+v %v", got, err)
+	}
+	out, err := owner.CloseExited()
+	if !errors.Is(err, ErrWaitCloseUnsupported) || out != (Outcome{}) || owner.raw != original {
+		t.Fatalf("missing close changed owner: %+v %v", out, err)
+	}
+	absent(t, marker)
+	if _, err = owner.Admit(true); err != nil {
+		t.Fatal(err)
+	}
+	out, err = owner.Finish(3000)
+	if err != nil || out.State != complete || out.RootExit != 7 {
+		t.Fatalf("legacy lifecycle regressed: %+v %v", out, err)
+	}
+	if err = owner.Release(); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/experiments/rust-process-owner/ffi/go/wait_windows.go b/experiments/rust-process-owner/ffi/go/wait_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..064a3777627712b04f29eef73704ca4897a150f6
--- /dev/null
+++ b/experiments/rust-process-owner/ffi/go/wait_windows.go
@@ -0,0 +1,71 @@
+//go:build windows && amd64 && cgo
+
+package caller
+
+import (
+	"errors"
+	"fmt"
+)
+
+const (
+	waitPending = 1
+	waitExited  = 2
+)
+
+// ErrWaitCloseUnsupported refuses the split protocol unless both exports exist.
+var ErrWaitCloseUnsupported = errors.New("native wait/close extension unavailable")
+
+// ExitObservation contains exit facts, never cleanup or release permission.
+// State is 0=unknown, 1=pending, 2=exited. Flags bit0 validates RootExit; bit1
+// validates Active. PID is diagnostic only. Exited retains the original owner.
+type ExitObservation struct {
+	State, Flags, PID, RootExit, Active uint32
+	NativeError                         int32
+}
+
+func exitResult(status, size, version uint32, v ExitObservation) (ExitObservation, error) {
+	layoutKnown := size == 32 && version == 1
+	var callErr error
+	if status != ok {
+		var native int32
+		if layoutKnown && status == nativeFailure {
+			native = v.NativeError
+		}
+		callErr = &CallError{status, native}
+	}
+	var reason string
+	switch {
+	case !layoutKnown:
+		reason = "incompatible layout"
+	case status > notSettled:
+		reason = "unknown call status"
+	case v.State > waitExited:
+		reason = "unknown exit state"
+	case v.Flags & ^uint32(3) != 0:
+		reason = "unknown observation flags"
+	case status == ok && v.State == 0:
+		reason = "success omitted exit observation"
+	case status != ok && v.State != 0:
+		reason = "failure supplied successful exit state"
+	case status == nativeFailure && v.NativeError == 0:
+		reason = "native failure without its code"
+	case status != nativeFailure && v.NativeError != 0:
+		reason = "native code without native failure"
+	case v.Flags&1 == 0 && v.RootExit != 0:
+		reason = "root code without a known root result"
+	case v.Flags&2 == 0 && v.Active != 0:
+		reason = "active count without a known observation"
+	case (v.State != 0 || v.Flags != 0) && v.PID == 0:
+		reason = "exit facts without a process identity"
+	case v.State == 0 && v.Flags&2 != 0:
+		reason = "failure supplied an active observation"
+	case v.State == waitPending && v.Flags != 0 && (v.Flags != 3 || v.Active == 0):
+		reason = "pending requires unknown facts or a known root with live members"
+	case v.State == waitExited && (v.Flags != 3 || v.Active != 0):
+		reason = "exited requires a known root and zero active members"
+	}
+	if reason != "" {
+		return ExitObservation{}, errors.Join(callErr, fmt.Errorf("%w: exit observation: %s", ErrInvalidOutcome, reason))
+	}
+	return v, callErr
+}

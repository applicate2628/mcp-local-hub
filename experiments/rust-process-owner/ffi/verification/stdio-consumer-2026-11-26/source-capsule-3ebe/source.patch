@@ -0,0 +1,220 @@
+//go:build windows
+
+package api
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// These are real owned trees and inert command closures, not a Serena install.
+func TestSerenaOwnedAttemptCompactLayout(t *testing.T) {
+	r := serenaAcquisitionRequest(t)
+	r.OperationID = "operation-" + strings.Repeat("1", 32)
+	r.GenerationID = "generation-" + strings.Repeat("2", 32)
+	work, cancelWork := context.WithDeadline(context.Background(), r.WorkDeadline)
+	defer cancelWork()
+	cleanup, cancelCleanup := context.WithDeadline(context.WithoutCancel(work), r.AbsoluteCleanupDeadline)
+	defer cancelCleanup()
+	key, err := r.Identity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := &preparedSerenaAcquisition{inputs: SerenaPreparationInputs{Request: r}}
+	defer func() {
+		if err := a.closeOriginalRoots(); err != nil {
+			t.Error(err)
+		}
+	}()
+	roots, err := a.acquireRoots(work, r, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual, err := a.attempt.WorkingDirectory(work)
+	if err != nil || actual != roots.Attempt.Path || filepath.Dir(actual) != filepath.Join(r.Namespace, "a") || !preparedSerenaDigest(filepath.Base(actual)) {
+		t.Fatalf("attempt is not the original compact owned tree: %q, %v", actual, err)
+	}
+	legacyAttempt := filepath.Join(r.Namespace, key, "attempts", r.OperationID)
+	if len(legacyAttempt)-len(actual) != 50 {
+		t.Fatal("generated identifiers did not recover the expected path budget")
+	}
+	if roots.Generation.Path != filepath.Join(r.Namespace, key, "generations", r.GenerationID) {
+		t.Fatal("published generation layout changed")
+	}
+	generationMarker := filepath.Join(roots.Generation.Path, "generation.txt")
+	originalMarker := filepath.Join(roots.Attempt.Path, "original.txt")
+	for _, path := range []string{generationMarker, originalMarker} {
+		if err := os.WriteFile(path, []byte("retained original\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	otherKey := key[:63] + "0"
+	if otherKey == key {
+		otherKey = key[:63] + "1"
+	}
+	otherOperation := r.OperationID[:len(r.OperationID)-1] + "2"
+	peers := []struct {
+		key, operation string
+		tree           *SerenaOwnedTree
+		path           string
+	}{{key: otherKey, operation: r.OperationID}, {key: key, operation: otherOperation}}
+	defer func() {
+		for _, peer := range peers {
+			if peer.tree != nil {
+				closed, err := peer.tree.Close()
+				if err != nil || !closed.Attempted || !closed.Closed || closed.Error != nil {
+					t.Error("peer tree close did not complete", err)
+				}
+			}
+		}
+	}()
+	acquisition, release, err := serenaPreparationAcquisitionContext(work, r.WorkDeadline, r.AbsoluteCleanupDeadline)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	seen := map[string]bool{roots.Attempt.Path: true}
+	for i := range peers {
+		peer := &peers[i]
+		peer.tree, err = AcquireSerenaOwnedTree(acquisition, SerenaOwnedTreeRequest{Namespace: r.Namespace, PackageIdentitySHA256: peer.key, OperationID: peer.operation, GenerationID: r.GenerationID, Kind: "attempt", Limits: r.OwnedTreeLimits})
+		if err != nil {
+			t.Fatal("full package/operation identities did not acquire separate attempts", err)
+		}
+		peer.path, err = peer.tree.WorkingDirectory(work)
+		if err != nil || seen[peer.path] || filepath.Dir(peer.path) != filepath.Join(r.Namespace, "a") {
+			t.Fatalf("distinct attempt escaped or reused a locator: %q, %v", peer.path, err)
+		}
+		seen[peer.path] = true
+		if err := os.WriteFile(filepath.Join(peer.path, "peer.txt"), []byte(peer.operation), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	duplicate, duplicateErr := AcquireSerenaOwnedTree(acquisition, a.attempt.request)
+	if duplicate != nil {
+		closed, closeErr := duplicate.Close()
+		if closeErr != nil || !closed.Attempted || !closed.Closed || closed.Error != nil {
+			t.Error("refused duplicate acquisition retained resources", closeErr)
+		}
+	}
+	if duplicateErr == nil {
+		t.Fatal("existing attempt was adopted by a repeated acquisition")
+	}
+	if raw, err := os.ReadFile(originalMarker); err != nil || string(raw) != "retained original\n" {
+		t.Fatal("refused duplicate changed the original attempt", err)
+	}
+	_, closure := serenaAcquisitionInertCommand(t, work, r)
+	peerRequest := r
+	peerRequest.OperationID = otherOperation
+	_, peerClosure := serenaAcquisitionInertCommand(t, work, peerRequest)
+	cancelWork()
+	for i, peer := range peers {
+		originalClosure := closure
+		if i == 1 {
+			originalClosure = peerClosure
+		}
+		removed, err := peer.tree.RemoveOwned(cleanup, true, originalClosure)
+		if err != nil || !removed.Complete() {
+			t.Fatal("original peer cleanup did not complete", err)
+		}
+		if _, err := os.Stat(peer.path); !os.IsNotExist(err) {
+			t.Fatal("completed peer attempt remains", err)
+		}
+		if raw, err := os.ReadFile(originalMarker); err != nil || string(raw) != "retained original\n" {
+			t.Fatal("peer cleanup changed another original attempt", err)
+		}
+	}
+	removed, err := a.cleanupAttempt(cleanup, roots, closure)
+	if err != nil || !removed.AttemptAbsent || !removed.LinksDischarged || !removed.NoPendingResources {
+		t.Fatal("compact attempt cleanup did not retain original ownership", err)
+	}
+	if _, err := os.Stat(roots.Attempt.Path); !os.IsNotExist(err) {
+		t.Fatal("completed original attempt remains", err)
+	}
+	inventory, err := a.generation.Inventory(cleanup)
+	if err != nil || inventory.RootIdentity.Device != roots.Generation.Device || inventory.RootIdentity.FileID != roots.Generation.FileID {
+		t.Fatal("surviving generation lost its original identity", err)
+	}
+	if raw, err := os.ReadFile(generationMarker); err != nil || string(raw) != "retained original\n" {
+		t.Fatal("attempt cleanup changed the surviving generation", err)
+	}
+}

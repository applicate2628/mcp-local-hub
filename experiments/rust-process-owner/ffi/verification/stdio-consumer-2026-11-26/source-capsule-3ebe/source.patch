+	if err != nil || actual != hash {
+		return errors.Join(err, errors.New("ConPTY actor native image hash differs"))
+	}
+	identity, err := readRustOwnerLibraryIdentity(filepath.Join(filepath.Dir(executable), "mcphub-owner-identity.json"), commit, hash)
+	if err != nil {
+		return err
+	}
+	if !runtimeidentity.IsWindowsProcessOwnerBorrowExportProfileV1(identity.Exports) {
+		return errors.New("ConPTY actor requires the exact original-process borrow profile")
+	}
+	return nil
+}

+// An unsuccessful fixture backstop cannot authorize closing borrowed files or
+// detaching the actor's console. Keep these exact resources strongly reachable
+// until receiver exit; skipping Close alone would leave os.File finalizers free
+// to close them. This is custody retention, not a recovery-success receipt.
+type foregroundConsoleRetainedFixture struct {
+	name     string
+	original *AtCreateJobProcess
+	fixture  *rustIONativeFixture
+	console  *foregroundOwnedConsole
+	files    []*os.File
+}
+
+var foregroundConsoleFixtureRetained struct {
+	sync.Mutex
+	values []foregroundConsoleRetainedFixture
+}
+
+func foregroundConsoleRequireAvailable(t *testing.T) {
+	t.Helper()
+	foregroundConsoleFixtureRetained.Lock()
+	var name string
+	if len(foregroundConsoleFixtureRetained.values) != 0 {
+		name = foregroundConsoleFixtureRetained.values[0].name
+	}
+	foregroundConsoleFixtureRetained.Unlock()
+	if name != "" {
+		t.Fatalf("console fixture custody is still retained from %s; further console qualification refused", name)
+	}
+}

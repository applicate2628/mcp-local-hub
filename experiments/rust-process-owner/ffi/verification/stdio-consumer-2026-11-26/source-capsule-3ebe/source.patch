+        owner.job_member_snapshot().unwrap() == &partial,
+        "expired capture changed its partial facts"
+    );
+    assert!(!owner.job_member_snapshot().unwrap().complete);
+    assert_eq!(descendant_handle(&owner, index).as_raw_handle(), raw);
+    let mut flags = 0;
+    // SAFETY: the exact acquired slot must remain owned after stage expiry.
+    assert_ne!(unsafe { GetHandleInformation(raw, &mut flags) }, 0);
+    let closed = owner.close_job_members(generation).unwrap().clone();
+    assert!(closed.complete);

+func TestHTTPHostEndpointReleaseCallerCancellationDoesNotPoisonFinal(t *testing.T) {
+	for _, reportedFailure := range []bool{false, true} {
+		name := "success"
+		if reportedFailure {
+			name = "reported-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			f, start := newEndpointReleaseFixture(t)
+			// This is a stable endpoint-reported error, not a native close failure.
+			reported := errors.New("synthetic stable close-report failure")
+			if reportedFailure {
+				f.reportedError = reported
+			}
+			firstCtx, cancelFirst := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancelFirst()
+			f.closeScript = func(ctx context.Context, call int32) (*process.OriginalJobMemberCloseObservation, error) {
+				proof, err := f.closeMembers(ctx)
+				if call == 1 {
+					cancelFirst() // Cancel only after obtaining the genuine close.
+					err = errors.Join(err, ctx.Err())
+				}
+				return proof, err
+			}
+			first, err := f.host.ReleaseOriginalEndpointObserved(firstCtx)
+			if first == nil || first.Snapshot().Complete || first.proof == nil || !first.proof.Finalized() || !errors.Is(err, context.Canceled) ||
+				reportedFailure && !errors.Is(err, reported) {
+				t.Fatalf("canceled caller lost actual final facts: present=%t error=%v", first != nil, err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			final, err := f.host.ReleaseOriginalEndpointObserved(ctx)
+			if final == nil || final.proof != first.proof || !final.proof.Finalized() || errors.Is(err, context.Canceled) ||
+				reportedFailure && !errors.Is(err, reported) || !reportedFailure && err != nil {
+				t.Fatalf("fresh caller retained cancellation or lost final facts: present=%t error=%v", final != nil, err)
+			}
+			if final == first || first.Validate(ctx, f.host, &start) == nil {
+				t.Fatal("the canceled validation attempt acquired final receiver authority")
+			}
+			wantComplete := !reportedFailure
+			if final.Snapshot().Complete != wantComplete || (final.Validate(ctx, f.host, &start) == nil) != wantComplete {
+				t.Fatal("receiver authority does not match the actual close and stable reported result")
+			}
+			calls := f.closeCalls.Load()
+			replayed, err := f.host.ReleaseOriginalEndpointObserved(ctx)
+			if replayed != final || f.closeCalls.Load() != calls || errors.Is(err, context.Canceled) ||
+				reportedFailure && !errors.Is(err, reported) || !reportedFailure && err != nil {
+				t.Fatalf("fresh final result was retried or changed: same=%t calls=%d error=%v", replayed == final, f.closeCalls.Load(), err)
+			}
+		})
+	}
+}

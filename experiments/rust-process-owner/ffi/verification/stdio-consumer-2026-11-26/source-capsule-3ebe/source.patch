+func TestRustOwnerABI1Layout(t *testing.T) {
+	if unsafe.Sizeof(rustOwnerUTF16{}) != 16 || unsafe.Sizeof(rustOwnerCreate{}) != 56 ||
+		unsafe.Offsetof(rustOwnerCreate{}.Args) != 40 || unsafe.Sizeof(rustOwnerOutcome{}) != 48 ||
+		unsafe.Offsetof(rustOwnerOutcome{}.CleanupCodes) != 36 ||
+		unsafe.Sizeof(rustOwnerWaitOutcome{}) != 32 || unsafe.Offsetof(rustOwnerWaitOutcome{}.NativeError) != 28 {
+		t.Fatal("Rust ABI1 layout differs from include/owner_v1.h")
+	}
+}
+
+func TestRustOwnerOutcomeRequiresCanonicalFields(t *testing.T) {
+	valid := rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 3}
+	if _, err := decodeRustOwnerOutcome(0, valid); err != nil {
+		t.Fatal(err)
+	}
+	knownRootPending := rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 3, Flags: 3, Active: 1}
+	if _, err := decodeRustOwnerOutcome(0, knownRootPending); err != nil {
+		t.Fatalf("valid root-known pending was rejected: %v", err)
+	}
+	cases := []struct {
+		name   string
+		status uint32
+		value  rustOwnerOutcome
+	}{
+		{"layout", 0, rustOwnerOutcome{Size: 40, Version: 1}},
+		{"native-without-code", 3, rustOwnerOutcome{Size: 48, Version: 1}},
+		{"unknown-state", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 9}},
+		{"wrong-root-flag", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 2, PID: 3}},
+		{"invalid-cleanup", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 3, PID: 3, Flags: 1}},
+		{"stale-error-code", 0, rustOwnerOutcome{Size: 48, Version: 1, NativeError: 5}},
+		{"pending-active-without-root", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 3, Flags: 2, Active: 1}},
+		{"pending-root-without-active", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 3, Flags: 1}},
+		{"pending-root-no-live-member", 0, rustOwnerOutcome{Size: 48, Version: 1, State: 1, PID: 3, Flags: 3}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := decodeRustOwnerOutcome(tc.status, tc.value)
+			if !errors.Is(err, errRustOwnerOutcome) {
+				t.Fatalf("invalid observation accepted: %v", err)
+			}
+		})
+	}
+	native := rustOwnerOutcome{Size: 48, Version: 1, NativeError: 5}
+	_, err := decodeRustOwnerOutcome(3, native)
+	if err == nil || !strings.Contains(err.Error(), "native") {
+		t.Fatalf("native error not preserved: %v", err)
+	}
+}
+
+func TestRustOwnerABI1PreflightOnQualifiedDLL(t *testing.T) {
+	product, commit, hash := os.Getenv("MCPHUB_RUST_OWNER_INTEGRATION_PRODUCT"),

+// Test failures normally use stdout, which is the hosted protocol channel.
+// Mirror the original failure to the fixture stderr sink before reporting it
+// to testing.T so a parent can retain the cause after original host settlement.
+func staleExitCustodyDiagnostic(t *testing.T, format string, args ...any) string {
+	t.Helper()
+	message := fmt.Sprintf(format, args...)
+	if _, err := fmt.Fprintln(os.Stderr, message); err != nil {
+		return fmt.Sprintf("%s; fixture diagnostic write failed: %v", message, err)
+	}
+	return message
+}

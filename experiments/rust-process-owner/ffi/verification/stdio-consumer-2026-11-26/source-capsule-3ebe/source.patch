+// This boundary fixture refuses the original inputs. It never constructs a
+// ready generation, consumer invocation, publisher, or qualification result.
+type refusingAutoRegisterSerenaPreparation struct {
+	t                                *testing.T
+	root, registryPath, task, rawSHA string
+	registryBefore                   []byte
+	expectedDeadline                 time.Time
+	cause                            error
+	calls                            int
+}
+
+func (assembly *refusingAutoRegisterSerenaPreparation) QualificationPort() PreparedSerenaQualificationPort {
+	assembly.t.Fatal("refused original inputs reached package qualification")
+	return nil
+}
+
+func (assembly *refusingAutoRegisterSerenaPreparation) PrepareInputs(ctx context.Context, manifest *config.ServerManifest, rawSHA string, tasks []string, _ *SerenaPreparationPolicyV2) (SerenaPreparationInputs, error) {
+	assembly.calls++
+	deadline, finite := time.Time{}, false
+	if ctx != nil {
+		deadline, finite = ctx.Deadline()
+	}
+	if ctx == nil || ctx.Err() != nil || !finite || deadline.After(assembly.expectedDeadline) {
+		assembly.t.Errorf("original preparation lost request deadline: finite=%t actual=%v expected<=%v", finite, deadline, assembly.expectedDeadline)
+	}
+	if manifest == nil || manifest.DaemonTemplate == nil || rawSHA != assembly.rawSHA || len(tasks) != 1 || tasks[0] != assembly.task {
+		assembly.t.Errorf("original preparation lost source/task: rawSHA=%q tasks=%v", rawSHA, tasks)
+	}
+	unlock, held, err := NewRegistry(assembly.registryPath).TryLock()
+	if err != nil || !held {
+		assembly.t.Errorf("original preparation ran under registry exclusion: held=%t err=%v", held, err)
+	} else if err := unlock(); err != nil {
+		assembly.t.Errorf("release observed registry lock: %v", err)
+	}
+	release, held, err := tryLockSupervisorIntent(filepath.Join(assembly.root, supervisorIntentFileLeaf))
+	if err != nil || !held {
+		assembly.t.Errorf("original preparation ran under intent exclusion: held=%t err=%v", held, err)
+	} else if err := release(); err != nil {
+		assembly.t.Errorf("release observed intent lock: %v", err)
+	}
+	if got, err := os.ReadFile(assembly.registryPath); err != nil || !bytes.Equal(got, assembly.registryBefore) {
+		assembly.t.Errorf("registry mutated before preparation accepted: cause=%v", err)
+	}
+	return SerenaPreparationInputs{}, assembly.cause
+}
+
+func TestAutoRegisterSerena_OriginalPreparationPrecedesRegistrationAndCutover(t *testing.T) {
+	for _, tc := range []struct {
+		name                  string
+		priorHasSpec, running bool
+	}{
+		{name: "live-add", priorHasSpec: true, running: true},
+		{name: "introduce-running", running: true},

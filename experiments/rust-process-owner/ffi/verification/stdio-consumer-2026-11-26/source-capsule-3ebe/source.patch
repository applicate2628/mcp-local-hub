+
+type fakeRustOwnerLibraryFileGuard struct {
+	closeCalls int
+	closeErr   error
+}
+
+func (g *fakeRustOwnerLibraryFileGuard) Close() error { g.closeCalls++; return g.closeErr }
+
+type fakeRustOwnerLibraryAPI struct {
+	lockGuard     *fakeRustOwnerLibraryFileGuard
+	lockCalls     int
+	lockErr       error
+	lockPath      string
+	loadHandle    windows.Handle
+	loadCalls     int
+	loadErr       error
+	loadPath      string
+	loadFlags     uint32
+	modulePath    string
+	modulePathErr error
+	moduleCalls   int
+	procAddrs     map[string]uintptr
+	procErrors    map[string]error
+	procNames     []string
+	version       uint32
+	versionCalls  int
+	freeCalls     int
+	freeErr       error
+	freedHandle   windows.Handle
+}
+
+func (api *fakeRustOwnerLibraryAPI) lock(path string) (rustOwnerLibraryFileGuard, error) {
+	api.lockCalls++
+	api.lockPath = path
+	if api.lockErr != nil {
+		return nil, api.lockErr
+	}
+	if api.lockGuard == nil {
+		return nil, nil
+	}
+	return api.lockGuard, nil
+}
+func (api *fakeRustOwnerLibraryAPI) load(path string, flags uint32) (windows.Handle, error) {
+	api.loadCalls++
+	api.loadPath = path
+	api.loadFlags = flags
+	if api.loadErr != nil {
+		return 0, api.loadErr
+	}
+	return api.loadHandle, nil
+}
+func (api *fakeRustOwnerLibraryAPI) path(handle windows.Handle) (string, error) {
+	api.moduleCalls++
+	if handle != api.loadHandle {
+		return "", errors.New("wrong module handle")
+	}
+	return api.modulePath, api.modulePathErr
+}
+func (api *fakeRustOwnerLibraryAPI) proc(handle windows.Handle, name string) (uintptr, error) {
+	if handle != api.loadHandle {
+		return 0, errors.New("wrong module handle")
+	}
+	api.procNames = append(api.procNames, name)
+	if err := api.procErrors[name]; err != nil {
+		return 0, err
+	}
+	return api.procAddrs[name], nil
+}
+func (api *fakeRustOwnerLibraryAPI) callVersion(address uintptr) uint32 {
+	api.versionCalls++
+	if address != api.procAddrs["mh_version1"] {
+		return 0
+	}
+	return api.version
+}
+func (api *fakeRustOwnerLibraryAPI) free(handle windows.Handle) error {
+	api.freeCalls++
+	api.freedHandle = handle
+	return api.freeErr
+}
+
+type rustOwnerTestLayout struct {
+	product  string
+	library  string
+	identity string
+	expected runtimeidentity.WindowsRuntimeLibraryIdentity
+}
+
+func newRustOwnerTestLayout(t *testing.T) rustOwnerTestLayout {
+	t.Helper()
+	dir := t.TempDir()
+	layout := rustOwnerTestLayout{
+		product:  filepath.Join(dir, rustOwnerProductFilename),
+		library:  filepath.Join(dir, rustOwnerLibraryFilename),
+		identity: filepath.Join(dir, rustOwnerIdentityFilename),
+		expected: runtimeidentity.WindowsRuntimeLibraryIdentity{
+			Schema:       runtimeidentity.WindowsRuntimeLibraryIdentitySchemaV1,
+			Filename:     rustOwnerLibraryFilename,
+			SourceCommit: rustOwnerTestCommit,
+			Machine:      rustOwnerMachineAMD64,
+			SHA256:       strings.Repeat("a", 64),
+			Exports:      runtimeidentity.WindowsProcessOwnerExportsV1(),
+		},
+	}
+	for _, path := range []string{layout.product, layout.library} {
+		if err := os.WriteFile(path, []byte("ordinary fixture"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	writeRustOwnerTestIdentity(t, layout.identity, layout.expected)
+	return layout
+}
+func writeRustOwnerTestIdentity(t *testing.T, path string, identity runtimeidentity.WindowsRuntimeLibraryIdentity) {
+	t.Helper()
+	raw, err := json.Marshal(identity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, append(raw, '\n'), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+func newFakeRustOwnerLibraryAPI(layout rustOwnerTestLayout) *fakeRustOwnerLibraryAPI {
+	api := &fakeRustOwnerLibraryAPI{
+		lockGuard:  &fakeRustOwnerLibraryFileGuard{},
+		loadHandle: windows.Handle(0x44),
+		modulePath: layout.library,
+		procAddrs:  map[string]uintptr{},
+		procErrors: map[string]error{},
+		version:    rustOwnerABIVersion,
+	}
+	for index, name := range layout.expected.Exports {
+		api.procAddrs[name] = uintptr(0x1000 + index*16)
+	}
+	return api
+}
+func matchingRustOwnerAdmission(layout rustOwnerTestLayout, calls *int) rustOwnerLibraryAdmission {
+	return func(path string, machine uint16, exports []string, commit string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error) {
+		(*calls)++
+		if path != layout.library || machine != rustOwnerMachineAMD64 || commit != rustOwnerTestCommit ||
+			!reflect.DeepEqual(exports, layout.expected.Exports) {
+			return runtimeidentity.WindowsRuntimeLibraryIdentity{}, fmt.Errorf("admission contract mismatch")
+		}
+		return layout.expected, nil
+	}
+}
+func openFakeRustOwner(t *testing.T, layout rustOwnerTestLayout, api *fakeRustOwnerLibraryAPI) (*rustOwnerLibrary, error, int) {
+	t.Helper()
+	calls := 0
+	library, err := openRustOwnerLibrary(layout.product, rustOwnerTestCommit, layout.expected.SHA256,
+		rustOwnerLibraryDependencies{api: api, admit: matchingRustOwnerAdmission(layout, &calls)})
+	return library, err, calls
+}
+
+func TestOpenRustOwnerLibraryValidatesAndOwnsOneModule(t *testing.T) {
+	layout := newRustOwnerTestLayout(t)
+	api := newFakeRustOwnerLibraryAPI(layout)
+	calls := 0
+	base := matchingRustOwnerAdmission(layout, &calls)
+	admit := func(path string, machine uint16, exports []string, commit string) (runtimeidentity.WindowsRuntimeLibraryIdentity, error) {
+		if api.lockCalls != 1 || api.lockGuard.closeCalls != 0 {
+			return runtimeidentity.WindowsRuntimeLibraryIdentity{}, errors.New("admission without stability guard")
+		}
+		return base(path, machine, exports, commit)
+	}
+	library, err := openRustOwnerLibrary(layout.product, rustOwnerTestCommit, layout.expected.SHA256, rustOwnerLibraryDependencies{api: api, admit: admit})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if library == nil || !library.ready || calls != 2 || api.lockCalls != 1 || api.loadCalls != 1 ||
+		api.lockGuard.closeCalls != 1 || api.moduleCalls != 1 || api.versionCalls != 1 ||
+		api.loadPath != layout.library || api.loadFlags != uint32(rustOwnerLoadFlags) ||
+		!reflect.DeepEqual(api.procNames, layout.expected.Exports) {
+		t.Fatalf("owner=%+v calls=%d api=%+v guard=%+v", library, calls, api, api.lockGuard)
+	}
+	for _, name := range layout.expected.Exports {
+		addr, ok := library.procedure(name)
+		if !ok || addr != api.procAddrs[name] {
+			t.Fatalf("%s address=%#x ok=%v", name, addr, ok)
+		}
+	}
+	if err := library.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := library.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if api.freeCalls != 1 || api.lockGuard.closeCalls != 1 || library.ready {
+		t.Fatalf("double release: free=%d guard=%d ready=%v", api.freeCalls, api.lockGuard.closeCalls, library.ready)
+	}
+	if _, ok := library.procedure("mh_create1"); ok {
+		t.Fatal("closed library exposed procedure")
+	}
+}
+
+func TestOpenRustOwnerLibraryRefusesUntrustedInputsBeforeNativeLoad(t *testing.T) {
+	for _, tt := range []struct {
+		name          string
+		mutate        func(t *testing.T, l rustOwnerTestLayout)
+		modifyProduct func(l rustOwnerTestLayout) string
+		commit        string
+		hash          string
+		want          string
+	}{
+		{name: "relative product", modifyProduct: func(l rustOwnerTestLayout) string { return filepath.Base(l.product) }, want: "absolute"},
+		{name: "wrong product name", modifyProduct: func(l rustOwnerTestLayout) string { return l.library }, want: "filename"},
+		{name: "invalid commit", commit: "ABC", want: "source commit"},
+		{name: "bad trusted digest", hash: "ABC", want: "SHA-256"},
+		{name: "missing receipt", mutate: func(t *testing.T, l rustOwnerTestLayout) {
+			t.Helper()
+			if err := os.Remove(l.identity); err != nil {
+				t.Fatal(err)
+			}
+		}, want: "identity"},
+		{name: "unrecognized field", mutate: func(t *testing.T, l rustOwnerTestLayout) {
+			t.Helper()
+			raw, _ := os.ReadFile(l.identity)

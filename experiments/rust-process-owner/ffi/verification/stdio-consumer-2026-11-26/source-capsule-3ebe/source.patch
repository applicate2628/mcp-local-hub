+func waitForAsyncWorkerRecord(t *testing.T, owner *asyncRunOwner, runID string) *asyncRunRecord {
+	t.Helper()
+	owner.mu.Lock()
+	record := owner.runs[runID]
+	var done <-chan struct{}
+	if record != nil {
+		done = record.workerDone
+	}
+	owner.mu.Unlock()
+	if done == nil {
+		t.Fatalf("run %q has no worker", runID)
+	}
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatalf("run %q worker did not return", runID)

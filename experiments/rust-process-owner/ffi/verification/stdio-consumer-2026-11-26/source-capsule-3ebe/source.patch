+func TestRustOwnerTerminalFinishDoesNotClaimDrainedMemberBorrow(t *testing.T) {
+	calls := 0
+	nativeClose := syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, bytes uintptr) uintptr {
+		calls++
+		if raw != 0x7531 || out == nil || bytes != 48 {
+			return 1
+		}
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, PID: 73, Flags: 1, RootExit: 0}
+		return 0
+	})
+	releaseCalls := 0
+	nativeRelease := syscall.NewCallback(func(slot *uintptr, out *rustOwnerOutcome, bytes uintptr) uintptr {
+		releaseCalls++
+		if slot == nil || *slot != 0x7531 || out == nil || bytes != 48 {
+			return 1
+		}
+		*slot = 0
+		*out = rustOwnerOutcome{Size: 48, Version: 1, State: 2, PID: 73, Flags: 1}
+		return 0
+	})
+	library := &rustOwnerLibrary{ready: true,
+		procedures: map[string]uintptr{"mh_wait1": rustOwnerExitedCallback(0x7531, 73, 0), "mh_close1": nativeClose, "mh_release1": nativeRelease}}
+	library.activeOwners.Store(1)
+	owner := &rustNativeOwner{library: library, raw: 0x7531, memberGate: newOriginalMemberCustody()}
+	leave, err := owner.memberGate.enterQuery(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := owner.Finish(0)
+	if !errors.Is(err, ErrOriginalMemberBorrowPending) || result.State != 0 ||
+		result.PID != 73 || calls != 0 {
+		leave()
+		t.Fatalf("native terminal result falsely claims drained query: result=%+v err=%v calls=%d", result, err, calls)
+	}
+	if err := owner.Release(); !errors.Is(err, ErrOriginalMemberBorrowPending) ||
+		owner.raw != 0x7531 || releaseCalls != 0 {
+		leave()
+		t.Fatalf("native owner released before original borrow drained: err=%v raw=%#x calls=%d",
+			err, owner.raw, releaseCalls)
+	}
+	leave()
+	result, err = owner.Finish(0)
+	if err != nil || result.State != 2 || calls != 1 {
+		t.Fatalf("cached native terminal cannot be observed after query drains: result=%+v err=%v calls=%d", result, err, calls)
+	}
+	if err := owner.Release(); err != nil || owner.raw != 0 || releaseCalls != 1 || library.activeOwners.Load() != 0 {
+		t.Fatalf("native owner release after drain: err=%v raw=%#x calls=%d", err, owner.raw, releaseCalls)
+	}
+}

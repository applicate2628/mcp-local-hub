+func runCanonicalNativeExternalCase(t *testing.T, channelPath string) error {
+	channel, slot, outerWork, err := loadCanonicalNativeExternalChannel(channelPath, t.Name())
+	if err != nil {
+		if canonicalnativefixture.HasRetainedFile(err) {
+			return stopCanonicalNativeCase(nil, err)
+		}
+		return err
+	}
+	parentDeadline, ok := t.Deadline()
+	if !ok {
+		return errors.New("external canonical case requires the original test deadline")
+	}
+	cleanupDeadline := time.Now().Add(4 * time.Minute)
+	if parentDeadline.Add(-time.Second).Before(cleanupDeadline) {
+		cleanupDeadline = parentDeadline.Add(-time.Second)
+	}
+	workDeadline := cleanupDeadline.Add(-10 * time.Second)
+	if !time.Now().Before(workDeadline) || cleanupDeadline.After(outerWork) {
+		return errors.New("external canonical case has no original bounded work/cleanup budget")
+	}
+	birth, err := canonicalNativeCurrentBirth()
+	if err != nil {
+		return err
+	}
+	cfg := canonicalNativeCaseConfig{Version: canonicalnativefixture.Version, Test: t.Name(), Nonce: slot.Nonce,
+		Image: channel.Binary.Path, ImageSHA256: channel.Binary.SHA256, Fixture: channel.Fixture.Path, FixtureSHA256: channel.Fixture.SHA256,
+		WorkDeadline: workDeadline.UTC().Format(time.RFC3339Nano), CleanupDeadline: cleanupDeadline.UTC().Format(time.RFC3339Nano),
+		Timeout: time.Until(workDeadline).String()}
+	request := canonicalnativefixture.Request{Version: canonicalnativefixture.Version, RunNonce: channel.RunNonce, Slot: slot.Slot,
+		ParentPID: uint32(os.Getpid()), ParentBirth: birth, ParentDeadline: parentDeadline.UTC().Format(time.RFC3339Nano), Bind: cfg}
+	slotRoot := filepath.Join(channel.Root, "channel", slot.Slot)
+	if err := canonicalnativefixture.CheckedPath(slotRoot, true); err != nil {
+		return err
+	}
+	ctx, cancel := context.WithDeadline(t.Context(), cleanupDeadline)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	custody := &canonicalNativeCaseCustody{Request: &request}
+	// From the first publication attempt, only the original controller's
+	// settled reply permits this receiver to continue. No t.Cleanup can
+	// replace the external native owner on an uncertain return.
+	if err := publishCanonicalNativeCase(filepath.Join(slotRoot, "request.json"), request); err != nil {
+		return stopCanonicalNativeCase(custody, err)
+	}
+	var reply canonicalnativefixture.Reply
+	custody.Reply = &reply
+	if err := awaitCanonicalNativeCase(ctx, filepath.Join(slotRoot, "reply.json"), &reply, nil); err != nil {
+		return stopCanonicalNativeCase(custody, err)
+	}
+	if err := validateCanonicalNativeExternalReply(request, reply, slotRoot); err != nil {
+		return stopCanonicalNativeCase(custody, err)
+	}
+	// This checks the private wire binding. The actual external owner remains
+	// in the controller; the final composite also binds this parent's native
+	// identity and original strict owner before whole-suite post-observations.
+	stdout, err := readCanonicalNativeExternalArtifact(ctx, reply.Stdout, custody)
+	if err != nil {
+		return stopCanonicalNativeCase(custody, err)
+	}
+	if _, err := readCanonicalNativeExternalArtifact(ctx, reply.Stderr, custody); err != nil {
+		return stopCanonicalNativeCase(custody, err)
+	}
+	t.Logf("external canonical native case evidence: %s", slotRoot)
+	var resultErr error
+	if !reply.Passed {
+		resultErr = fmt.Errorf("external canonical case failed after original settlement: exit=%d error=%s", reply.RootExitCode, reply.Error)
+	} else {
+		resultErr = validateCanonicalNativeCaseOutput(cfg.Test, stdout)
+	}
+	return errors.Join(resultErr, ctx.Err())
+}

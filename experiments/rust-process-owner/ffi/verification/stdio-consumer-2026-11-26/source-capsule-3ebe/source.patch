+func TestRustOwnerSIDFormattingHonorsContentionDeadline(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		holdLibrary bool
+	}{
+		{"original-owner-mutex", false},
+		{"native-library-mutex", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			library := &rustOwnerLibrary{ready: true}
+			owner := &rustNativeOwner{library: library, memberGate: newOriginalMemberCustody()}
+			var unlock func()
+			if tc.holdLibrary {
+				library.mu.Lock()
+				unlock = library.mu.Unlock
+			} else {
+				owner.mu.Lock()
+				unlock = owner.mu.Unlock
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+			defer cancel()
+			done := make(chan error, 1)
+			go func() {
+				observed, err := owner.FormatOriginalUserSID(ctx)
+				if observed != nil {
+					err = errors.Join(err, errors.New("busy query published an observation"))
+				}
+				done <- err
+			}()
+			select {
+			case err := <-done:
+				unlock()
+				if !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("deadline got %v", err)
+				}
+			case <-time.After(250 * time.Millisecond):
+				unlock()
+				<-done
+				t.Fatal("SID observation blocked behind mutex after deadline")
+			}
+			permit, err := owner.memberGate.beginTerminal(nil)
+			if err != nil {
+				t.Fatalf("canceled SID query retained custody: %v", err)
+			}
+			permit.finish()
+		})
+	}
+}

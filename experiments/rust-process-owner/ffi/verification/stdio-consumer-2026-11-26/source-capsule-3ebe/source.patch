+	"testing"
+)
+
+// Each case uses an original inert command closure; none installs Serena.
+func TestSerenaOwnedTreeReadOnlyCleanup(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		link         string
+		readOnlyRoot bool
+	}{
+		{name: "read_only_leaf"},
+		{name: "read_only_root", readOnlyRoot: true},
+		{name: "generation_hardlink", link: "generation"},
+		{name: "foreign_hardlink", link: "foreign"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r := serenaAcquisitionRequest(t)
+			work, cancelWork := context.WithDeadline(context.Background(), r.WorkDeadline)
+			defer cancelWork()
+			cleanup, cancelCleanup := context.WithDeadline(context.WithoutCancel(work), r.AbsoluteCleanupDeadline)
+			defer cancelCleanup()
+			key, err := r.Identity()
+			if err != nil {
+				t.Fatal(err)
+			}
+			a := &preparedSerenaAcquisition{inputs: SerenaPreparationInputs{Request: r}}
+			defer func() {
+				if err := a.closeOriginalRoots(); err != nil {
+					t.Error(err)
+				}
+			}()
+			roots, err := a.acquireRoots(work, r, key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(roots.Attempt.Path, "z-read-only.bin")
+			content := []byte("immutable cached artifact\n")
+			if err := os.WriteFile(path, content, 0600); err != nil {
+				t.Fatal(err)
+			}
+			var survivor string
+			switch tc.link {
+			case "generation":
+				survivor = filepath.Join(roots.Generation.Path, "survivor.bin")
+			case "foreign":
+				survivor = filepath.Join(r.Namespace, "foreign.bin")
+			}
+			if survivor != "" {
+				if err := os.Link(path, survivor); err != nil {
+					t.Fatal(err)
+				}
+			}
+			// Go handles long fixture paths. Stat also avoids a second open
+			// conflicting with the retained root handle's DELETE access.
+			attributes := func(path string) uint32 {
+				t.Helper()
+				info, err := os.Stat(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				value, ok := info.Sys().(*syscall.Win32FileAttributeData)
+				if !ok {
+					t.Fatal("Windows file attributes unavailable")
+				}
+				return value.FileAttributes
+			}
+			markReadOnly := func(path string) {
+				t.Helper()
+				if err := os.Chmod(path, 0400); err != nil {
+					t.Fatal(err)
+				}
+				if attributes(path)&syscall.FILE_ATTRIBUTE_READONLY == 0 {
+					t.Fatal("fixture did not acquire the read-only attribute")
+				}
+			}
+			markReadOnly(path)
+			if tc.readOnlyRoot {
+				markReadOnly(roots.Attempt.Path)
+			}
+			// File.Stat captures the original ID before the attempt name disappears;
+			// path-based Stat would defer this lookup until SameFile after cleanup.
+			original, err := os.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before, statErr := original.Stat()
+			closeErr := original.Close()
+			if statErr != nil || closeErr != nil {
+				t.Fatalf("original fixture identity/close: %v, %v", statErr, closeErr)
+			}
+			beforeAttributes := attributes(path)
+			// A refused foreign link must stop deletion before an earlier ordinary entry.
+			sentinel := filepath.Join(roots.Attempt.Path, "a-ordinary.bin")
+			if tc.link == "foreign" {
+				if err := os.WriteFile(sentinel, content, 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			_, closure := serenaAcquisitionInertCommand(t, work, r)
+			cancelWork()
+			removed, err := a.cleanupAttempt(cleanup, roots, closure)
+			if tc.link == "foreign" {
+				if err == nil || !strings.Contains(err.Error(), "SERENA_TREE_FOREIGN_HARDLINK") || removed.AttemptAbsent {
+					t.Fatalf("foreign hardlink cleanup was not refused: %+v, %v", removed, err)
+				}
+				for _, retained := range []string{path, sentinel} {
+					actual, err := os.ReadFile(retained)
+					if err != nil || !bytes.Equal(actual, content) {
+						t.Fatalf("refused cleanup changed %s: %v", retained, err)
+					}
+				}
+				if attributes(path) != beforeAttributes {
+					t.Fatal("refused cleanup changed original attributes")
+				}
+			} else {
+				if err != nil || !removed.AttemptAbsent || !removed.LinksDischarged || !removed.NoPendingResources {
+					t.Fatalf("read-only attempt cleanup failed: %+v, %v", removed, err)
+				}
+				if _, err := os.Stat(roots.Attempt.Path); !os.IsNotExist(err) {
+					t.Fatal("attempt remains after completed cleanup", err)
+				}
+				if _, err := a.generation.Inventory(cleanup); err != nil {
+					t.Fatal("surviving generation lost its original capability", err)
+				}
+			}
+			if survivor != "" {
+				after, err := os.Stat(survivor)
+				if err != nil || !os.SameFile(before, after) {
+					t.Fatal("surviving hardlink identity changed", err)
+				}
+				actual, err := os.ReadFile(survivor)
+				if err != nil || !bytes.Equal(actual, content) || attributes(survivor) != beforeAttributes {
+					t.Fatal("surviving hardlink content or attributes changed", err)
+				}
+			}
+		})
+	}
+}

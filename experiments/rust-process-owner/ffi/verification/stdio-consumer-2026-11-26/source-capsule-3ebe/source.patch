+func TestRustOwnerFacadeNativeLifetimeWaitAllowsStop(t *testing.T) {
+	f := newRustFacadeNativeFixture(t)
+	pipes := f.pipes(t)
+	ctx := rustIONativeContext(t)
+	p, err := f.library.startRustOriginal(ctx, rustFacadeNativeCommand(f, "stdio"), pipes.streams,
+		func(p *AtCreateJobProcess) error { return rustFacadeNativeRetain(t, f, p.child) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.closeChildEnds(t, pipes)
+	waitRustMemberMarker(t, ctx, f.marker)
+	entered := make(chan struct{}, 1)
+	f.library.mu.Lock()
+	nativeWait := f.library.procedures["mh_wait1"]
+	f.library.procedures["mh_wait1"] = syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		status, _, _ := syscall.SyscallN(nativeWait, raw, ms, uintptr(unsafe.Pointer(out)), size)
+		runtime.KeepAlive(out)
+		return status
+	})
+	f.library.mu.Unlock()
+	var root OriginalRootWait
+	work := f.begin(func() rustIONativeResult {
+		root = p.WaitOriginal()
+		return rustIONativeResult{err: root.Error}
+	})
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal("lifetime root waiter did not enter actual native wait")
+	}
+	view, err := p.ObserveOriginal(ctx, false)
+	if err != nil || !view.OriginalJobExited || view.TerminalAction != string(creatorTerminalRequestSucceeded) {
+		t.Fatalf("finite Stop could not pass the live lifetime waiter: view=%+v err=%v", view, err)
+	}
+	work.await(t, ctx)
+	if !root.Known || root.ExitCode != rustContainedStopCode || root.Error != nil {
+		t.Fatalf("lifetime waiter did not publish actual stopped root: %+v", root)
+	}
+	proof, err := p.ReleaseOriginal()
+	if err != nil || !proof.Complete() || f.owner.raw != 0 {
+		t.Fatalf("same original lifetime settlement: complete=%t err=%v", proof.Complete(), err)
+	}
+	f.closeFile(t, pipes.input)
+	for _, output := range []*os.File{pipes.stdout, pipes.stderr} {
+		result := f.read(output).await(t, ctx)
+		if result.err != nil || !result.eof {
+			t.Fatalf("stopped pipe did not reach natural EOF: %+v", result)
+		}
+	}
+}
+
+func TestRustOwnerFacadeRootFactSurvivesJobQueryFailure(t *testing.T) {
+	for _, scenario := range []struct {
+		name                 string
+		rootKnown, malformed bool
+	}{
+		{"known-root", true, false},
+		{"unknown-root", false, false},
+		{"malformed-root", true, true},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			f, child, _ := newRustFacadeABIFixture(t)
+			f.owner.library.procedures["mh_wait1"] = syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+				f.waitCalls++
+				if f.waitCalls > 1 {
+					*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 259}
+					return 0
+				}
+				*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, PID: 42, NativeError: 5}
+				if scenario.rootKnown {
+					out.Flags, out.RootExit = 1, 259
+				}
+				if scenario.malformed {
+					out.Version = 2
+				}
+				return 3
+			})
+			p := &ProvisionalProcess{owner: child, waitDone: make(chan struct{})}
+			root, err := p.WaitCreatorRoot()
+			validRoot := scenario.rootKnown && !scenario.malformed
+			if !validRoot {
+				if err == nil || root.Known || f.owner.cachedRootWait().Known {
+					t.Fatalf("unvalidated root became fact: root=%+v err=%v cache=%+v", root, err, f.owner.cachedRootWait())
+				}
+				if scenario.malformed && !errors.Is(err, errRustOwnerOutcome) {
+					t.Fatalf("malformed root lost ABI error: %v", err)
+				}
+				return
+			}
+			if err != nil || !root.Known || root.ExitCode != 259 || root.RawExitError != nil || f.waitCalls != 1 {
+				t.Fatalf("secondary Job query failure poisoned verified root: root=%+v err=%v waits=%d", root, err, f.waitCalls)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			terminal, err := p.CompleteCreatorAfterExit(ctx, true)
+			if err != nil || terminal == nil || terminal.Closure() == nil || !terminal.Snapshot().OriginalJobExited ||
+				f.waitCalls != 2 || f.stopCalls != 0 || f.closeCalls != 1 || f.releaseCalls != 1 {
+				t.Fatalf("terminal path did not independently observe original Job: terminal=%v err=%v counts=%d/%d/%d/%d",
+					terminal, err, f.waitCalls, f.stopCalls, f.closeCalls, f.releaseCalls)
+			}
+		})
+	}
+}
diff --git a/internal/process/rust_owner_foreground_cache_windows_test.go b/internal/process/rust_owner_foreground_cache_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..dae28dc48130b620ee9808991a1b72d3b4a9daeb
--- /dev/null
+++ b/internal/process/rust_owner_foreground_cache_windows_test.go
@@ -0,0 +1,115 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"errors"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Once validated, the historical root result does not need a live owner lock,
+// module, or a new operation deadline. The sole facade waiter still receives it.
+func TestRustForegroundCachedRootSurvivesCancelledContextAndNativeLocks(t *testing.T) {
+	calls := 0
+	owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		calls++
+		*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 1, Flags: 3, PID: 42, RootExit: 259, Active: 1}
+		return 0
+	}))
+	observedCtx, cancelObserved := context.WithTimeout(context.Background(), time.Second)
+	defer cancelObserved()
+	if root, err := owner.WaitRootWithin(observedCtx); err != nil || !root.Known {
+		t.Fatalf("initial root observation: %+v %v", root, err)
+	}
+	child := &rustContainedChild{owner: owner, library: owner.library}
+	original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	owner.mu.Lock()
+	owner.library.mu.Lock()
+	locked, joined := true, false
+	done := make(chan OriginalRootWait, 1)
+	t.Cleanup(func() {
+		if locked {
+			owner.library.mu.Unlock()
+			owner.mu.Unlock()
+		}
+		if !joined {
+			select {
+			case <-done:
+			case <-time.After(3 * time.Second):
+				t.Error("cached foreground receiver did not join")
+			}
+		}
+	})
+	go func() { done <- original.WaitOriginalContext(ctx) }()
+	select {
+	case root := <-done:
+		joined = true
+		if !root.Known || root.ExitCode != 259 || !errors.Is(root.Error, context.Canceled) {
+			t.Fatalf("cancellation discarded the already-published root: %+v", root)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("historical root replay waited for native locks")
+	}
+	owner.library.mu.Unlock()
+	owner.mu.Unlock()
+	locked = false
+	if calls != 1 || !child.waitStarted.Load() || !child.waitReturned.Load() || owner.closeStarted {
+		t.Fatalf("cached replay entered native work or lost the sole waiter: calls=%d", calls)
+	}
+	if root := original.WaitOriginal(); root != (OriginalRootWait{Known: true, ExitCode: 259}) {
+		t.Fatalf("operation cancellation contaminated the historical waiter: %+v", root)
+	}
+	owner.memberGate.mu.Lock()
+	sealed, bounded := owner.memberGate.sealed, owner.memberGate.terminalBound
+	owner.memberGate.mu.Unlock()
+	if sealed || bounded {
+		t.Fatal("historical replay acquired terminal authority")
+	}
+}
+
+func TestRustForegroundReceivesRootPublishedAtTerminalDeadline(t *testing.T) {
+	cleanupCtx, cancelCleanup := context.WithTimeout(context.Background(), 250*time.Millisecond)
+	defer cancelCleanup()
+	waits, closes := 0, 0
+	owner := rustRootWaitTestOwner(t, syscall.NewCallback(func(raw, ms uintptr, out *rustOwnerTestWaitOutput, size uintptr) uintptr {
+		waits++
+		*out = rustOwnerTestWaitOutput{Size: 32, Version: 1, State: 2, Flags: 3, PID: 42, RootExit: 71}
+		<-cleanupCtx.Done()
+		return 0
+	}))
+	owner.created.Store(true)
+	owner.library.procedures["mh_close1"] = syscall.NewCallback(func(raw uintptr, out *rustOwnerOutcome, size uintptr) uintptr {
+		closes++
+		return 1
+	})
+	child := &rustContainedChild{owner: owner, library: owner.library}
+	original := &AtCreateJobProcess{child: child, observer: child, waitDone: make(chan struct{})}
+	native, err := original.ObserveOriginal(cleanupCtx, true)
+	if !errors.Is(err, context.DeadlineExceeded) || !native.RootWaitKnown || native.RootExitCode != 71 || !native.OriginalJobExited {
+		t.Fatalf("last native observation lost facts or deadline: native=%+v err=%v", native, err)
+	}
+	root := original.WaitOriginalContext(cleanupCtx)
+	if !root.Known || root.ExitCode != 71 || !errors.Is(root.Error, context.DeadlineExceeded) {
+		t.Fatalf("foreground receipt lost root published at cleanup deadline: %+v", root)
+	}
+	before, _ := cleanupCtx.Deadline()
+	settlement, releaseErr := original.ReleaseOriginal()
+	if settlement != nil || !errors.Is(releaseErr, context.DeadlineExceeded) || original.closeAttempted || closes != 0 {
+		t.Fatalf("expired cleanup entered native close: settlement=%+v err=%v closes=%d", settlement, releaseErr, closes)
+	}
+	owner.memberGate.mu.Lock()
+	after, bounded := owner.memberGate.terminalDeadline, owner.memberGate.terminalBound
+	owner.memberGate.mu.Unlock()
+	if !bounded || !after.Equal(before) || waits != 1 || owner.closeStarted || owner.library.activeOwners.Load() != 1 {
+		t.Fatalf("cached receipt renewed cleanup or lost custody: waits=%d before=%v after=%v", waits, before, after)
+	}
+	if replay := original.WaitOriginal(); replay != (OriginalRootWait{Known: true, ExitCode: 71}) {
+		t.Fatalf("sole waiter retained a cleanup-operation error: %+v", replay)
+	}
+}
diff --git a/internal/process/rust_owner_foreground_console_windows_test.go b/internal/process/rust_owner_foreground_console_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..40fb044e0e51f749efaa4761a6c3c30b18f2bf17
--- /dev/null
+++ b/internal/process/rust_owner_foreground_console_windows_test.go
@@ -0,0 +1,476 @@
+//go:build windows && amd64
+
+package process
+
+import (
+	"context"
+	"debug/pe"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+
+	"mcp-local-hub/internal/runtimeidentity"
+)
+
+var foregroundConsoleKernel = windows.NewLazySystemDLL("kernel32.dll")
+
+type foregroundConsoleCall struct {
+	Attempted bool   `json:"attempted"`
+	Completed bool   `json:"completed"`
+	OK        bool   `json:"ok"`
+	Code      uint32 `json:"native_error"`
+	Error     string `json:"error,omitempty"`
+	Count     uint32 `json:"count"`
+}
+
+type foregroundConsoleStream struct {
+	Name   string                `json:"name"`
+	Handle foregroundConsoleCall `json:"handle"`
+	Mode   foregroundConsoleCall `json:"mode"`
+	Value  uint32                `json:"mode_value"`
+}
+
+type foregroundConsoleReport struct {
+	Schema       string                     `json:"schema"`
+	PID          uint32                     `json:"pid"`
+	Mode         string                     `json:"mode"`
+	Attachment   foregroundConsoleCall      `json:"attachment"`
+	ConsolePIDs  []uint32                   `json:"console_pids"`
+	Window       foregroundConsoleCall      `json:"window"`
+	WindowHandle uint64                     `json:"window_handle"`
+	Streams      [3]foregroundConsoleStream `json:"streams"`
+	Read         foregroundConsoleCall      `json:"read"`
+	Character    uint16                     `json:"character"`
+	Writes       [2]foregroundConsoleCall   `json:"writes"`
+	ExitKnown    bool                       `json:"exit_known"`
+	ExitCode     int                        `json:"exit_code"`
+}
+
+type foregroundOwnedConsole struct {
+	files     [3]*os.File
+	original  [3]windows.Handle
+	saved     bool
+	allocated bool
+}
+
+func foregroundConsoleBoolean(name string, args ...uintptr) error {
+	proc := foregroundConsoleKernel.NewProc(name)
+	if err := proc.Find(); err != nil {
+		return err
+	}
+	ok, _, err := proc.Call(args...)
+	if ok != 0 {
+		return nil
+	}
+	if err == syscall.Errno(0) {
+		return fmt.Errorf("%s returned false without a native error", name)
+	}
+	return fmt.Errorf("%s: %w", name, err)
+}
+
+func foregroundConsoleProcessCount() (uint32, error) {
+	proc := foregroundConsoleKernel.NewProc("GetConsoleProcessList")
+	if err := proc.Find(); err != nil {
+		return 0, err
+	}
+	var ids [32]uint32
+	count, _, err := proc.Call(uintptr(unsafe.Pointer(&ids[0])), uintptr(len(ids)))
+	if count != 0 {
+		return uint32(count), nil
+	}
+	if errors.Is(err, windows.ERROR_INVALID_HANDLE) {
+		return 0, nil
+	}
+	if err == nil || err == syscall.Errno(0) {
+		err = errors.New("GetConsoleProcessList failed without an error code")
+	}
+	return 0, err
+}
+
+func (console *foregroundOwnedConsole) acquire() error {
+	count, err := foregroundConsoleProcessCount()
+	if err != nil {
+		return err
+	}
+	if count != 0 {
+		return errors.New("actor already has a console; refusing foreign detach or mutation")
+	}
+	for i, id := range [...]uint32{windows.STD_INPUT_HANDLE, windows.STD_OUTPUT_HANDLE, windows.STD_ERROR_HANDLE} {
+		console.original[i], err = windows.GetStdHandle(id)
+		if err != nil {
+			return err
+		}
+	}
+	console.saved = true
+	if err := foregroundConsoleBoolean("AllocConsole"); err != nil {
+		return err
+	}
+	console.allocated = true
+	if count, err := foregroundConsoleProcessCount(); err != nil || count == 0 {
+		return errors.Join(err, errors.New("new actor console membership was not observed"))
+	}
+	// This window can only belong to the console just created by this actor.
+	// Its presence is not the console-IO oracle.
+	window, _, _ := foregroundConsoleKernel.NewProc("GetConsoleWindow").Call()
+	if window != 0 {
+		windows.NewLazySystemDLL("user32.dll").NewProc("ShowWindow").Call(window, 0)
+	}
+	for i, name := range [...]string{"CONIN$", "CONOUT$", "CONOUT$"} {
+		console.files[i], err = os.OpenFile(name, os.O_RDWR, 0)
+		if err != nil {
+			return fmt.Errorf("open actor %s: %w", name, err)
+		}
+		var mode uint32
+		if err := windows.GetConsoleMode(windows.Handle(console.files[i].Fd()), &mode); err != nil {
+			return fmt.Errorf("actor console mode %d: %w", i, err)
+		}
+	}
+	return nil
+}
+
+func (console *foregroundOwnedConsole) close(t *testing.T) {
+	t.Helper()
+	for i, file := range console.files {
+		if file != nil {
+			console.files[i] = nil
+			if err := file.Close(); err != nil {
+				t.Errorf("close owned console file %d: %v", i, err)
+			}
+		}
+	}
+	if console.allocated {
+		console.allocated = false
+		if err := foregroundConsoleBoolean("FreeConsole"); err != nil {
+			t.Errorf("release actor console: %v", err)
+		}
+		if count, err := foregroundConsoleProcessCount(); err != nil || count != 0 {
+			t.Errorf("actor console detach unconfirmed: count=%d cause=%v", count, err)
+		}
+	}
+	if console.saved {
+		console.saved = false
+		for i, id := range [...]uint32{windows.STD_INPUT_HANDLE, windows.STD_OUTPUT_HANDLE, windows.STD_ERROR_HANDLE} {
+			if err := windows.SetStdHandle(id, console.original[i]); err != nil {
+				t.Errorf("restore actor original standard slot %d: %v", i, err)
+			}
+		}
+	}
+}
+
+func (console *foregroundOwnedConsole) prepareInput() error {
+	input, output := windows.Handle(console.files[0].Fd()), windows.Handle(console.files[1].Fd())
+	var mode uint32
+	if err := windows.GetConsoleMode(input, &mode); err != nil {
+		return err
+	}
+	mode = mode&^(windows.ENABLE_LINE_INPUT|windows.ENABLE_ECHO_INPUT|windows.ENABLE_QUICK_EDIT_MODE) | windows.ENABLE_EXTENDED_FLAGS
+	if err := windows.SetConsoleMode(input, mode); err != nil {
+		return err
+	}
+	if err := foregroundConsoleBoolean("FlushConsoleInputBuffer", uintptr(input)); err != nil {
+		return err
+	}
+	type inputRecord struct {
+		kind, padding               uint16
+		down                        int32
+		repeat, virtual, scan, char uint16
+		control                     uint32
+	}
+	record := inputRecord{kind: 1, down: 1, repeat: 1, virtual: 'Q', char: 'Q'}
+	if unsafe.Sizeof(record) != 20 {
+		return errors.New("INPUT_RECORD layout differs from Windows ABI")
+	}
+	var count uint32
+	if err := foregroundConsoleBoolean("WriteConsoleInputW", uintptr(input), uintptr(unsafe.Pointer(&record)), 1, uintptr(unsafe.Pointer(&count))); err != nil {
+		return err
+	}
+	if count != 1 {
+		return fmt.Errorf("owned input events written=%d, want 1", count)
+	}
+	var info windows.ConsoleScreenBufferInfo
+	if err := windows.GetConsoleScreenBufferInfo(output, &info); err != nil {
+		return err
+	}
+	// Leave a spare column so writing the last token cannot wrap or scroll.
+	if info.Size.X <= 22 || info.Size.Y < 1 {
+		return errors.New("owned screen buffer is too small for the bounded fixture")
+	}
+	if err := windows.SetConsoleCursorPosition(output, windows.Coord{}); err != nil {
+		return err
+	}
+	count = 0
+	if err := foregroundConsoleBoolean("FillConsoleOutputCharacterW", uintptr(output), uintptr(' '), 22, 0, uintptr(unsafe.Pointer(&count))); err != nil {
+		return err
+	}
+	if count != 22 {
+		return fmt.Errorf("owned screen cells cleared=%d, want 22", count)
+	}
+	return nil
+}
+
+func (console *foregroundOwnedConsole) modes() ([3]uint32, error) {
+	var values [3]uint32
+	for i, file := range console.files {
+		if err := windows.GetConsoleMode(windows.Handle(file.Fd()), &values[i]); err != nil {
+			return values, err
+		}
+	}
+	return values, nil
+}

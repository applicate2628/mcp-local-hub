diff --git a/internal/api/serena_prepared_diagnostics.go b/internal/api/serena_prepared_diagnostics.go
new file mode 100644
index 0000000000000000000000000000000000000000..602f3177d357f0687e3ccaf7e49c5e270d9de1fa
--- /dev/null
+++ b/internal/api/serena_prepared_diagnostics.go
@@ -0,0 +1,131 @@
+package api
+
+import (
+	"errors"
+
+	"mcp-local-hub/internal/process"
+)
+
+const preparedSerenaDiagnosticExcerptLimit = 8192
+
+type preparedSerenaFailureStage string
+
+const (
+	preparedSerenaUVVersionFailure   preparedSerenaFailureStage = "uv-version"
+	preparedSerenaPythonFindFailure  preparedSerenaFailureStage = "python-find"
+	preparedSerenaInterpreterFailure preparedSerenaFailureStage = "interpreter-abi"
+	preparedSerenaUVInstallFailure   preparedSerenaFailureStage = "uv-install"
+	preparedSerenaMetadataFailure    preparedSerenaFailureStage = "metadata"
+)
+
+// PreparedSerenaFailureStream is bounded diagnostic DATA from a settled
+// original command. Excerpt is bytes so JSON preserves invalid UTF-8 as base64.
+type PreparedSerenaFailureStream struct {
+	Bytes     int64  `json:"bytes"`
+	SHA256    string `json:"sha256"`
+	Excerpt   []byte `json:"excerpt"`
+	Truncated bool   `json:"truncated"`
+}
+
+// PreparedSerenaFailureDiagnostic grants no execution or settlement authority.
+// Streams are absent unless both original native and IO owners completed.
+type PreparedSerenaFailureDiagnostic struct {
+	OperationID          string                       `json:"operation_id"`
+	ExecutableSHA256     string                       `json:"executable_sha256"`
+	Stage                string                       `json:"stage"`
+	ProcessStage         process.ContainedRunStage    `json:"process_stage"`
+	RootWaitKnown        bool                         `json:"root_wait_known"`
+	RootExitCode         int                          `json:"root_exit_code"`
+	TerminalAction       string                       `json:"terminal_action"`
+	NativeComplete       bool                         `json:"native_complete"`
+	IOComplete           bool                         `json:"io_complete"`
+	NativeHandlesClosed  bool                         `json:"native_handles_closed"`
+	NativeFinalActive    uint32                       `json:"native_final_active"`
+	StdoutWorkerComplete bool                         `json:"stdout_worker_complete"`
+	StderrWorkerComplete bool                         `json:"stderr_worker_complete"`
+	Stdout               *PreparedSerenaFailureStream `json:"stdout,omitempty"`
+	Stderr               *PreparedSerenaFailureStream `json:"stderr,omitempty"`
+}
+
+type preparedSerenaCommandFailure struct {
+	cause      error
+	stage      preparedSerenaFailureStage
+	executable PreparedSerenaFile
+	result     preparedSerenaCommandResult
+}
+
+func (e *preparedSerenaCommandFailure) Error() string { return e.cause.Error() }
+func (e *preparedSerenaCommandFailure) Unwrap() error { return e.cause }
+
+// PreparedSerenaFailureDiagnostics observes retained original failure results.
+// It performs no IO or execution and exposes no environment, argv or handles.
+// errors.As receives the existing input-error carrier through wrapped/joined
+// causes; walking those causes also retains distinct joined command failures.
+func PreparedSerenaFailureDiagnostics(err error) []PreparedSerenaFailureDiagnostic {
+	var out []PreparedSerenaFailureDiagnostic
+	commands := map[*preparedSerenaCommandFailure]bool{}
+	inputs := map[*serenaPreparationInputsError]bool{}
+	var visit func(error)
+	visit = func(current error) {
+		if current == nil {
+			return
+		}
+		var command *preparedSerenaCommandFailure
+		if errors.As(current, &command) && command != nil && !commands[command] {
+			commands[command] = true
+			out = append(out, preparedSerenaFailureDiagnostic(command.stage, command.executable, &command.result))
+		}
+		var input *serenaPreparationInputsError
+		if errors.As(current, &input) && input != nil && !inputs[input] {
+			inputs[input] = true
+			switch {
+			case input.inputs.interpreterProbe != nil:
+				out = append(out, preparedSerenaFailureDiagnostic(preparedSerenaInterpreterFailure, input.inputs.qualifiedInterpreter, input.inputs.interpreterProbe))
+			case input.inputs.pythonFindProbe != nil:
+				out = append(out, preparedSerenaFailureDiagnostic(preparedSerenaPythonFindFailure, input.inputs.qualifiedUV, input.inputs.pythonFindProbe))
+			case input.inputs.uvVersionProbe != nil:
+				out = append(out, preparedSerenaFailureDiagnostic(preparedSerenaUVVersionFailure, input.inputs.qualifiedUV, input.inputs.uvVersionProbe))
+			}
+		}
+		switch wrapped := current.(type) {
+		case interface{ Unwrap() []error }:
+			for _, cause := range wrapped.Unwrap() {
+				visit(cause)
+			}
+		case interface{ Unwrap() error }:
+			visit(wrapped.Unwrap())
+		}
+	}
+	visit(err)
+	return out
+}
+
+func preparedSerenaFailureDiagnostic(stage preparedSerenaFailureStage, executable PreparedSerenaFile, result *preparedSerenaCommandResult) PreparedSerenaFailureDiagnostic {
+	receipt := result.Receipt
+	native := receipt.NativeSettlement.Snapshot()
+	diagnostic := PreparedSerenaFailureDiagnostic{
+		OperationID: result.Closure.OriginalOperationID, ExecutableSHA256: executable.SHA256, Stage: string(stage),
+		ProcessStage: receipt.Stage, RootWaitKnown: receipt.RootWaitKnown, RootExitCode: receipt.RootExitCode,
+		TerminalAction: receipt.TerminalAction, NativeComplete: receipt.NativeSettlement.Complete(),
+		IOComplete: receipt.IOSettlement.Complete(), NativeHandlesClosed: native.HandlesClosed,
+		NativeFinalActive: native.FinalActive, StdoutWorkerComplete: receipt.IOSettlement.Stdout.WorkerComplete,
+		StderrWorkerComplete: receipt.IOSettlement.Stderr.WorkerComplete,
+	}
+	if !diagnostic.NativeComplete || !diagnostic.IOComplete {
+		return diagnostic
+	}
+	// Access and hash the retained byte slices only after both original owners
+	// completed; synthetic Closure flags cannot pass this receipt boundary.
+	diagnostic.Stdout = preparedSerenaFailureStream(result.Stdout)
+	diagnostic.Stderr = preparedSerenaFailureStream(result.Stderr)
+	return diagnostic
+}
+
+func preparedSerenaFailureStream(raw []byte) *PreparedSerenaFailureStream {
+	length := len(raw)
+	excerpt := raw[:min(length, preparedSerenaDiagnosticExcerptLimit)]
+	return &PreparedSerenaFailureStream{
+		Bytes: int64(length), SHA256: preparedSerenaHash(raw),
+		Excerpt: append([]byte{}, excerpt...), Truncated: len(excerpt) < length,
+	}
+}

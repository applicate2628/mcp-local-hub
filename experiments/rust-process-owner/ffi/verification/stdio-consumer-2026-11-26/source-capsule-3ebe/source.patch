+
+func TestCodexGlobalRelocationRejectsChangedFrozenConfig(t *testing.T) {
+	root := t.TempDir()
+	t.Setenv("CODEX_HOME", root)
+	path := filepath.Join(root, "config.toml")
+	original := []byte("[mcp_servers.fixture]\nurl = \"http://127.0.0.1:9292/mcp\"\ntool_timeout_sec = 90\nenabled = false\n")
+	if err := os.WriteFile(path, original, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	client, err := NewCodexCLI()
+	if err != nil {
+		t.Fatal(err)
+	}
+	managed, ok := AsManagedRegistrationClient(client)
+	if !ok {
+		t.Fatal("global adapter did not retain its config-lock owner")
+	}
+	captured, err := managed.SnapshotManagedRegistration(context.Background(), "fixture")
+	if err != nil {
+		t.Fatal(err)
+	}
+	changed := append(append([]byte(nil), original...), []byte("\n# concurrent sibling edit\n")...)
+	if err := os.WriteFile(path, changed, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	adapter, ok := AsCodexTransportClient(client)
+	if !ok {
+		t.Fatal("Codex transport capability unavailable")
+	}
+	writes := 0
+	_, err = adapter.RelocateHTTPEntry(CodexHTTPRelocation{
+		SourceEntryName: "fixture", TargetEntryName: "fixture-mcphub",
+		Entry:          MCPEntry{Name: "fixture-mcphub", URL: "http://127.0.0.1:9401/mcp", ToolTimeoutSec: 90, Disabled: true},
+		ExpectedSource: CodexTransportHTTP, ExpectedConfigSHA256: captured.ConfigSHA256.String(),
+		WriteConfig: func(string, []byte) error { writes++; return errors.New("stale request reached writer") },
+	})
+	if !errors.Is(err, ErrCodexLayerCollisionUnowned) || writes != 0 {
+		t.Fatalf("stale global source: writes=%d err=%v", writes, err)
+	}
+	after, readErr := os.ReadFile(path)
+	if readErr != nil || !bytes.Equal(after, changed) {
+		t.Fatalf("stale source rejection changed config: %v\n%s", readErr, after)
+	}
+}
+
+func TestCodexExpectedGlobalTargetMustMatchDesiredHTTP(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		entry string
+	}{
+		{name: "stdio", entry: "command = \"foreign-stdio\"\nargs = [\"--serve\"]\n"},
+		{name: "different URL", entry: "url = \"http://127.0.0.1:9402/mcp\"\ntool_timeout_sec = 45\n"},
+		{name: "different policy", entry: "url = \"http://127.0.0.1:9401/mcp\"\ntool_timeout_sec = 90\nenabled = false\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root := t.TempDir()
+			globalDir := filepath.Join(root, "global")
+			project := filepath.Join(root, "project")
+			if err := os.MkdirAll(globalDir, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.MkdirAll(filepath.Join(project, ".codex"), 0o700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("CODEX_HOME", globalDir)
+			path := filepath.Join(globalDir, "config.toml")
+			raw := []byte("[mcp_servers.fixture-mcphub]\n" + tc.entry)
+			if err := os.WriteFile(path, raw, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(project, ".codex", "config.toml"), []byte("[mcp_servers.fixture]\ncommand = \"project-stdio\"\nargs = [\"--serve\"]\n"), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			client, err := NewCodexCLI()
+			if err != nil {
+				t.Fatal(err)
+			}
+			managed, ok := AsManagedRegistrationClient(client)
+			if !ok {
+				t.Fatal("managed read owner unavailable")
+			}
+			actual, err := managed.SnapshotManagedRegistration(context.Background(), "fixture-mcphub")
+			if err != nil {
+				t.Fatal(err)
+			}
+			adapter, ok := AsCodexTransportClient(client)
+			if !ok {
+				t.Fatal("Codex transport adapter unavailable")
+			}
+			result, err := adapter.ResolveTransportTarget(CodexTransportTargetRequest{
+				LogicalEntryName: "fixture", DesiredTransport: CodexTransportHTTP,
+				DesiredEntry: MCPEntry{Name: "fixture-mcphub", URL: "http://127.0.0.1:9401/mcp", ToolTimeoutSec: 45},
+				ProjectRoot:  project, WorkingDir: project, ExpectedGlobalTarget: &actual,
+			})
+			if !errors.Is(err, ErrCodexTargetNameConflict) || result.ExistingExactTarget {
+				t.Fatalf("matching snapshot mislabeled a different desired entry as exact: result=%#v err=%v", result, err)
+			}
+			after, readErr := os.ReadFile(path)
+			if readErr != nil || !bytes.Equal(after, raw) {
+				t.Fatalf("read-only classification changed config: %v", readErr)
+			}
+		})
+	}
+}

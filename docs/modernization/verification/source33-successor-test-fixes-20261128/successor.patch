+func TestMain(m *testing.M) {
+	if os.Getenv(jobFixtureFullSuiteEnv) == "" {
+		os.Exit(m.Run())
+	}
+	if os.Getenv(jobFixtureFullSuiteEnv) != "1" {
+		fmt.Fprintln(os.Stderr, "invalid full-suite Job entry mode")
+		os.Exit(2)
+	}
+	jobFixtureEntryLease.Lock()
+	jobFixtureEntryLease.attempted = true
+	jobFixtureEntryLease.token, jobFixtureEntryLease.err = receiveJobFixtureEntry()
+	token, err := jobFixtureEntryLease.token, jobFixtureEntryLease.err
+	jobFixtureEntryLease.Unlock()
+	if err != nil || token == nil || token.Ready.PID != uint32(os.Getpid()) {
+		fmt.Fprintln(os.Stderr, "qualified full-suite original entry refused:", err)
+		os.Exit(2)
+	}
+	// Self helper children must not start a second entry handshake.
+	if err := errors.Join(os.Unsetenv(jobFixtureEntryConfigEnv), os.Unsetenv(jobFixtureFullSuiteEnv)); err != nil {
+		fmt.Fprintln(os.Stderr, "clear consumed full-suite entry environment:", err)
+		os.Exit(2)
+	}
+	// receiveJobFixtureEntry received EOF and closed its control pipe. Restore
+	// the actual NUL input used by the ordinary noninteractive Go test driver,
+	// both for os.Stdin readers and native GetStdHandle consumers.
+	input, err := os.Open(os.DevNull)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "open full-suite NUL stdin:", err)
+		os.Exit(2)
+	}
+	if err := windows.SetStdHandle(windows.STD_INPUT_HANDLE, windows.Handle(input.Fd())); err != nil {
+		fmt.Fprintln(os.Stderr, "set full-suite NUL stdin:", errors.Join(err, input.Close()))
+		os.Exit(2)
+	}
+	os.Stdin = input
+	code := m.Run()
+	if err := errors.Join(windows.SetStdHandle(windows.STD_INPUT_HANDLE, 0), input.Close()); err != nil {
+		fmt.Fprintln(os.Stderr, "close full-suite NUL stdin:", err)
+		if code == 0 {
+			code = 1
+		}
+	}
+	os.Exit(code)

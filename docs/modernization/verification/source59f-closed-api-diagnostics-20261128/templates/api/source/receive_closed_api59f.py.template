            need(path==CASE/"inventory/result.json","API inventory control path escaped its owner")
        else:
            parent=Path(r["namespace_private_scope"]["parent"])
            need(path==parent/"namespace-suite-receipt.json" and parent.name=="n"
                 and parent.parent.parent==RUNS and re.fullmatch("n[0-9a-f]{12}",parent.parent.name)
                 and r["namespace_private_scope"]["path"]==str(parent.parent),"API namespace control path escaped its owner")
        proof=control(path,record["sha256"],16<<20)
        need(proof==record["proof"]==row["completion_receiving"],"original API owner proof differs")
        if label=="inventory-owner":
            need(record["kind"]=="contained" and path==CASE/"inventory/result.json"
                 and proof.get("schema")=="literal-contained-test-run-v1" and proof.get("inventory") is True
                 and proof.get("binary")==binary and proof.get("binary_sha256")==sha
                 and proof.get("source_dir")==cwd and proof.get("args")==["-test.list=."]
                 and proof.get("root_wait_known") is True and proof.get("settlement_complete") is True
                 and proof.get("custody_retained") is False and row["exit_code"]==0
                 and row["argv"]==[cfg["controllers"]["contained"]["path"],"--test-binary",binary,"--expected-sha256",sha,
                    "--source-dir",cwd,"--run-root",str(CASE/"inventory"),"--inventory","--timeout","90s","--","-test.list=."],
                 "same-image original API inventory owner differs or is unclosed")
            native_closed(proof["native"]);native_io_closed(proof["io"])
        else:
            parent=Path(r["namespace_private_scope"]["parent"])
            need(record["kind"]=="namespace" and path==parent/"namespace-suite-receipt.json"
                 and parent.name=="n" and parent.parent.parent==RUNS
                 and re.fullmatch("n[0-9a-f]{12}",parent.parent.name)
                 and r["namespace_private_scope"]["path"]==str(parent.parent),"API namespace scope differs")
            binding={"request_sha256":r["request_sha256"],"request_nonce":r["request_nonce"],
                     "binary":binary,"expected_sha256":sha,"source_dir":cwd,"parent":str(parent),
                     "args":r["original_argv"],"controller_argv":row["argv"],"test_state_path_env":False}
            argv=[cfg["controllers"]["namespace"]["path"],"--test-binary",binary,"--expected-sha256",sha,
                  "--source-dir",cwd,"--repo",str(SOURCE),"--go",cfg["tools"]["go"]["path"],
                  "--pwsh",cfg["tools"]["pwsh"]["path"],"--parent",str(parent),"--test-timeout","5m",
                  "--request-sha256",r["request_sha256"],"--request-nonce",r["request_nonce"],"--",*r["original_argv"]]
            need(r["namespace_request"]==binding and row["argv"]==argv,"original API namespace request differs")
            terminal=validate_namespace_terminal(proof,binding)
            if terminal=="prechild-refusal":
                need(row["exit_code"]!=0 and r["status"]=="FAIL" and r.get("namespace_prechild_refusal") is True,
                     "pre-child refusal cannot qualify PASS")
            else:
                native_closed(proof["native"]);native_io_closed(proof["io"])
                PAYLOAD_ROOTS.append(parent/"r")
                for side in ("stdout","stderr"):queue_capture(proof[side+"_path"],proof[side+"_sha256"])
            originals[key]={"path":str(path),"sha256":record["sha256"],"proof":proof,"terminal":terminal}
            continue
        originals[key]={"path":str(path),"sha256":record["sha256"],"proof":proof}
    for stream in (ack["streams"] or {}).values():queue_capture(stream["path"],stream["sha256"])
    raw=r.get("raw_output_binding",{})
    for side in ("stdout","stderr"):
        if side in raw:queue_capture(raw[side],raw[side+"_sha256"])
    need(r["command_quiescence"]["complete"] is True,"API original final command registry remains unclosed")
    return cfg,r,plan,originals,ack

def after_closure(cfg,r,originals,result):
    errors=result["receiving_issues"]
    measured={}
    for path,expected in CAPTURES.items():
        ordinary(path);before=Path(path).stat();actual=digest(path);after=Path(path).stat()
        need(actual==expected and (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns)
             ==(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns),"closed API capture changed: "+path)
        measured[path]={"bytes":after.st_size,"sha256":actual}
    result["capture_measurements"]=measured
    result["capture_files_checked"]=len(measured)
    result["command_count"]=len(COMMANDS)
    result["original_status"]=r["status"]
    result["adapter_exit_code"]=r["adapter_exit_code"]
    result["original_error"]=r.get("error")
    result["original_replay_error"]=r.get("replay_error")
    result["owner_failure"]=originals["owner"]["proof"].get("failure")
    result["owner_root_exit_code"]=originals["owner"]["proof"].get("root_exit_code")
    result["original_owner_receipts"]={key:{"path":value["path"],"sha256":value["sha256"]} for key,value in originals.items()}
    result["recorded_receiver_environment"]=r.get("receiver_environment")
    result["original_qualification_flags"]={key:r.get(key) for key in
        ("image_unchanged","bundle_unchanged","original_inputs_unchanged","headless_configuration_received")}
    inventory=r.get("inventory",{}).get("tests",{}).get(API)
    need(isinstance(inventory,list) and inventory==sorted(set(inventory)),"original API full inventory is missing or duplicate")
    inventory_path=CASE/"inventory-owner.stdout.txt"
    need(str(inventory_path) in measured,"inventory payload was not received")
    names=[line.strip() for line in inventory_path.read_text(encoding="utf-8").splitlines() if NAME.fullmatch(line.strip())]
    need(len(names)==len(set(names)) and sorted(n for n in names if not n.startswith("Benchmark"))==inventory,
         "actual same-image inventory differs from original receiving")
    original_copy=CASE/"incoming-original.exe"
    need(digest(original_copy)==r["incoming_sha256"],"preserved original API image differs")
    result["preserved_incoming"]={"path":str(original_copy),"sha256":r["incoming_sha256"]}
    owner=originals["owner"]
    if owner["terminal"]=="suite":
        execution=Path(owner["proof"]["execution_binary"])
        need(execution.is_relative_to(PAYLOAD_ROOTS[-1]) and digest(execution)==r["incoming_sha256"],
             "closed namespace execution copy differs from same incoming image")
        result["closed_execution_copy"]={"path":str(execution),"sha256":r["incoming_sha256"]}
    converted=[c for c in COMMANDS if Path(c["stdout"]).name=="suite-events.stdout.txt"]
    need(len(converted)==1 and converted[0]["argv"]==[cfg["controllers"]["test2json"]["path"],"-p",API]
         and converted[0]["exit_code"]==0 and converted[0]["stdout"] in measured,
         "original closed test2json conversion absent or differs")
    with Path(converted[0]["stdout"]).open("r",encoding="utf-8-sig") as stream:
        rows=[json.loads(line,object_pairs_hook=unique) for line in stream if line.strip()]
    need(len(r.get("coverage",[]))==1,"original API coverage ledger absent")
    recorded=r["coverage"][0]
    ledger=event_ledger("literal-default",{API:inventory},rows,recorded["exit_code"],[(API,t) for t in MANDATORY])
    need(json.loads(json.dumps(ledger))==recorded,"recomputed original API full event ledger differs")
    result["inventory_count"]=len(inventory)
    result["full_inventory_ledger"]=ledger
    result["top_level_counts"]=dict(collections.Counter(x["outcome"] for x in ledger["top_level"]))
    result["all_terminal_counts"]=dict(collections.Counter(x["outcome"] for x in ledger["all_terminal"]))
    outcomes={x["test"]:x["outcome"] for x in ledger["all_terminal"] if x["package"]==API}
    counts=collections.Counter(x.get("Test") for x in rows if x.get("Package")==API and x.get("Action")=="run")
    result["mandatory_api_stderr"]=[{"test":t,"runs":counts[t],"outcome":outcomes.get(t,"NOT_RUN")} for t in API_STDERR]
    failed=sorted(name for name,outcome in outcomes.items() if outcome=="fail")
    result["failed_tests"]=[{"test":name,"original_output":"".join(row.get("Output","") for row in rows
                             if row.get("Package")==API and row.get("Test")==name and row.get("Action")=="output")}
                            for name in failed]
    result["package_output_without_test"]="".join(row.get("Output","") for row in rows
                            if row.get("Package")==API and not row.get("Test") and row.get("Action")=="output")
    stderr=CASE/"suite-owner.stderr.txt"
    need(str(stderr) in measured,"original API owner stderr was not received")
    with stderr.open("rb") as stream:raw_stderr=stream.read(65537)
    result["owner_stderr"]={"text":raw_stderr[:65536].decode("utf-8",errors="replace"),
                            "truncated":len(raw_stderr)>65536,"path":str(stderr)}
    result["namespace_qualification_recorded"]={key:owner["proof"].get(key) for key in
        ("observations_verified","mandatory_tests_passed","mandatory_tests","binary_unchanged",
         "execution_binary_unchanged","failure","cleanup_error","native_error")}
    for path,sha in CONTROL_PINS.items():
        need(digest(path)==sha,"original API control changed during receiving: "+path)
    required_passed=all(outcomes.get(name)=="pass" and counts[name]==1 for name in MANDATORY)
    return bool(r["status"]=="PASS" and r["adapter_exit_code"]==0 and ledger["passed"] and required_passed
                and not errors and not r.get("error") and not r.get("replay_error"))

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--receipt-sha256",required=True)
    parser.add_argument("--output",required=True,type=Path)
    args=parser.parse_args()
    need(re.fullmatch("[0-9a-f]{64}",args.receipt_sha256),"exact original API receipt SHA256 required")
    here=Path(__file__).absolute().parent
    need(args.output.parent==here and args.output.suffix==".json" and not os.path.lexists(args.output),
         "receiving output must be a fresh JSON sibling of this script")
    ordinary(here,True)
    result={"schema":"successor-closed-api-subtree-receiving-v1","source_commit":COMMIT,"source_tree":TREE,
        "package":API,"phase":PHASE,"case":str(CASE),"original_receipt_sha256":args.receipt_sha256,
        "classification":"UNKNOWN","physical_complete":False,"diagnostic_payload_access":False,
        "api_qualification_passed":False,"data_verification":"NOT_RECEIVED","receiving_issues":[],
        "full_run_qualification_claimed":False,"full_run_physical_closure_claimed":False,
        "cli_physical_closure_claimed":False,"other_package_payload_access":False,
        "source_payload_access":False,"cache_payload_access":False,"cache_handoff_eligible":False,
        "new_native_or_test_execution":False,"deadline_extension":False}
    code=1
    try:
        cfg,r,plan,originals,ack=receive_physical(args.receipt_sha256)
        result.update(physical_complete=True,diagnostic_payload_access=True,
                      exact_payload_roots=[str(path) for path in PAYLOAD_ROOTS],
                      original_replay=ack,original_status=r["status"],adapter_exit_code=r["adapter_exit_code"])
        passed=after_closure(cfg,r,originals,result)
        result.update(classification="PASS/CLOSED" if passed else "FAIL/CLOSED",
                      api_qualification_passed=passed,data_verification="PASS")
        code=0
    except Exception as error:
        result["receiving_issues"].append(type(error).__name__+": "+str(error))
        if result["physical_complete"]:
            result.update(classification="FAIL/CLOSED",data_verification="FAIL")
    result["control_pins"]=dict(CONTROL_PINS)
    result["allowed_capture_pins"]=dict(CAPTURES)
    with args.output.open("xb") as stream:
        stream.write((json.dumps(result,indent=2,ensure_ascii=False)+"\n").encode("utf-8"))
        stream.flush();os.fsync(stream.fileno())
    print(json.dumps({key:result[key] for key in
        ("classification","physical_complete","diagnostic_payload_access","api_qualification_passed",
         "data_verification","receiving_issues")},ensure_ascii=False))
    return code
if __name__=="__main__":raise SystemExit(main())

         and start["request_nonce"]==end["request_nonce"]==r["request_nonce"]
         and start["input"]==r["incoming"] and start["input_sha256"]==r["incoming_sha256"]
         and start["args"]==r["original_argv"] and start["cwd"]==r["original_cwd"],
         "API original start/completion identity differs")
    channel=REGISTRY/"requests"
    request=control(channel/(KEY+".request.json"),r["request_sha256"],8<<20)
    response_path=channel/(KEY+".response.json")
    response=control(response_path,limit=8<<20)
    ack=control(channel/(KEY+".replayed.json"),limit=8<<20)
    need(request["schema"]=="literal-original-owner-request-v1" and request["issuer_nonce"]==plan["original_issuer"]["nonce"]
         and request["nonce"]==r["request_nonce"] and request["phase"]==PHASE and request["package"]==API
         and request["commit"]==COMMIT and request["plan"]==str(plan_path) and request["plan_sha256"]==r["plan_sha256"]
         and request["source_snapshot_sha256"]==plan["source_snapshot_sha256"]
         and request["binary"]==r["incoming"] and request["binary_sha256"]==r["incoming_sha256"]
         and request["argv"]==r["original_argv"] and request["cwd"]==r["original_cwd"]
         and Path(request["binary"]).is_relative_to(Path(plan["temporary_directory"]))
         and type(request["started_ns"]) is int and type(request["deadline_ns"]) is int
         and request["started_ns"]>=plan["original_issuer"]["started_monotonic_ns"]

         and response["original_custody_complete"] is True and response["qualification_deadlines_extended"] is False
         and response["replay"]==r.get("raw_replay") and type(response["replay_deadline_monotonic_ns"]) is int
         and response["replay_deadline_monotonic_ns"]<=request["deadline_ns"],"original API response differs")
    validate_replay_ack(request,response,CONTROL_PINS[str(response_path)],ack)

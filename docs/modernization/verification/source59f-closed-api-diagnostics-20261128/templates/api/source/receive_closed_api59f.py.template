def need(ok,message):
    if not ok:raise RuntimeError(message)
def ordinary(path,directory=False):
    path=Path(path)
    need(path.is_absolute() and ".." not in path.parts,"absolute clean path required")
    for item in (*reversed(path.parents),path):
        st=item.lstat()
        need(not stat.S_ISLNK(st.st_mode) and not getattr(st,"st_file_attributes",0)&0x400,"reparse path refused")
    need(path.is_dir() if directory else path.is_file(),"ordinary path kind differs")
    return path
def digest(path):
    with ordinary(path).open("rb") as stream:return hashlib.file_digest(stream,"sha256").hexdigest()
def unique(pairs):
    result={}
    for key,value in pairs:
        need(key not in result,"duplicate JSON field")
        result[key]=value
    return result
def control(path,expected=None,limit=32<<20):
    path=ordinary(path)
    with path.open("rb") as stream:raw=stream.read(limit+1)
    need(len(raw)<=limit,"original control exceeds its existing bound")
    actual=hashlib.sha256(raw).hexdigest()
    need(expected is None or actual==expected,"original control hash differs: "+str(path))
    need(str(path) not in CONTROL_PINS or CONTROL_PINS[str(path)]==actual,"original control changed during receiving")
    CONTROL_PINS[str(path)]=actual
    return json.loads(raw.decode("utf-8-sig"),object_pairs_hook=unique)
def queue_capture(path,sha):
    path=Path(path)
    need(any(path.is_relative_to(root) for root in PAYLOAD_ROOTS)
         and re.fullmatch("[0-9a-f]{64}",sha or "") is not None,"capture escaped the exact API subtree")
    need(str(path) not in CAPTURES or CAPTURES[str(path)]==sha,"conflicting original API capture pins")
    CAPTURES[str(path)]=sha
def native_closed(n):
    need(isinstance(n,dict) and all(n.get(k) is True for k in
         ("RootWaitKnown","MembersExited","AccountingKnown","HandlesClosed"))
         and type(n.get("FinalActive")) is int and n["FinalActive"]==0 and not n.get("Error"),
         "original native settlement incomplete")
def native_io_closed(io):
    need(isinstance(io,dict),"original IO receipt missing")
    for key in ("Stdin","StdoutRead","StdoutWrite","StderrRead","StderrWrite"):
        row=io.get(key,{})
        need(type(row.get("Acquired")) is bool and (not row["Acquired"] or
             row.get("CloseAttempted") is True and row.get("Closed") is True and not row.get("CloseError")),
             "original pipe close incomplete: "+key)
    for key in ("Stdout","Stderr"):
        row=io.get(key,{})
        need(all(row.get(k) is True for k in ("WorkerStarted","WorkerComplete","EOF"))
             and not row.get("LimitExceeded") and not row.get("Error"),"original reader incomplete: "+key)
def command_closed(row):
    need(row.get("quiescence_state")=="complete" and row.get("captures_measured") is True
         and type(row.get("exit_code")) is int,"API command original completion is unreceived")
    for side in ("stdout","stderr"):
        need(Path(row[side]).parent==CASE,"API command capture escaped its original owner")
        queue_capture(row[side],row.get(side+"_sha256"))
    if row.get("native"):
        n=row["native"]
        need(all(n.get(k) is True for k in ("direct_reaped","active_zero","handles_closed"))
             and not n.get("issues") and row.get("original_readers_joined") is True,"ordinary original owner incomplete")
        for side in ("stdout","stderr"):
            io=row.get("io",{}).get(side,{})
            need(all(io.get(k) is True for k in ("worker_complete","eof","pipe_close_returned","capture_close_returned"))
                 and not io.get("error"),"ordinary original reader close incomplete")
    else:
        need(isinstance(row.get("completion_receiving"),dict) and row["completion_receiving"]
             and type(row.get("original_pid")) is int and row["original_pid"]>0
             and "wait_returned" in row.get("phases_elapsed_seconds",{})
             and Path(row["stdout"]).name in ("inventory-owner.stdout.txt","suite-owner.stdout.txt"),
             "unreceived or unreviewed external API owner")
    COMMANDS.append(row)
# Pure functions copied unchanged from the reviewed full59f receiver v2.
def flags_are_literal(args):
    if len(args) != 4 or args.count("-test.paniconexit0") != 1:
        return False
    values = {}
    for arg in args:
        key, sep, value = arg.partition("=")
        if key in values:
            return False
        values[key] = value
    return (set(values)=={"-test.paniconexit0","-test.v","-test.count","-test.timeout"}
            and values["-test.v"]=="test2json" and values["-test.count"]=="1"
            and values["-test.timeout"] in ("5m","5m0s"))

def native_settled(kind, proof):
    if kind == "job":
        return (proof.get("originalWaitKnown") is True and proof.get("settlementComplete") is True
                and proof.get("streamsJoined") is True and proof.get("controlWriterJoined") is True
                and proof.get("stdoutEOF") is True and proof.get("stderrEOF") is True
                and proof.get("custodyRetained",False) is False)
    return (kind in ("namespace", "contained")
            and proof.get("root_wait_known") is True and proof.get("settlement_complete") is True
            and proof.get("custody_retained") is False
            and (kind!="namespace" or (proof.get("native_complete") is True and proof.get("io_complete") is True)))

def validate_namespace_terminal(proof, binding):
    """Classify original terminal data; this function owns no process or files."""
    keys = {"request_sha256", "request_nonce", "binary", "expected_sha256", "source_dir",
            "parent", "args", "controller_argv", "test_state_path_env"}
    if (not isinstance(proof, dict) or not isinstance(binding, dict) or set(binding) != keys
            or any(not isinstance(binding.get(key), str) or not binding[key]
                   for key in ("request_sha256", "request_nonce", "binary", "expected_sha256", "source_dir", "parent"))
            or not re.fullmatch("[0-9a-f]{64}", binding.get("request_sha256", ""))
            or not re.fullmatch("[0-9a-f]{32}", binding.get("request_nonce", ""))
            or not re.fullmatch("[0-9a-f]{64}", binding.get("expected_sha256", ""))
            or type(binding.get("test_state_path_env")) is not bool
            or not isinstance(binding.get("args"), list)
            or any(not isinstance(value, str) for value in binding["args"])
            or not flags_are_literal(binding["args"])
            or not isinstance(binding.get("controller_argv"), list) or not binding["controller_argv"]
            or any(not isinstance(value, str) or not value for value in binding["controller_argv"])):
        raise RuntimeError("namespace terminal request binding is incomplete")
    if proof.get("schema") == "api-namespace-prechild-refusal-v1":
        if (set(proof) != {"schema", "binding", "contained_stage_entered", "failure"}
                or not isinstance(proof.get("binding"), dict)
                or proof.get("binding") != binding
                or type(proof["binding"].get("test_state_path_env")) is not bool
                or proof.get("contained_stage_entered") is not False
                or not isinstance(proof.get("failure"), str) or not proof["failure"]):
            raise RuntimeError("namespace pre-child refusal differs from the original request")
        return "prechild-refusal"
    if (proof.get("schema") != "api-namespace-full-suite-v2"
            or proof.get("mode") != "incoming-go-image-copy"
            or proof.get("binary") != binding["binary"]
            or proof.get("expected_sha256") != binding["expected_sha256"]
            or proof.get("binary_sha256") != binding["expected_sha256"]
            or proof.get("evidence_root") != str(Path(binding["parent"])/"r")
            or proof.get("execution_binary") != str(Path(binding["parent"])/"r"/"bin"/"api.test.exe")
            or proof.get("execution_sha256") != binding["expected_sha256"]
            or proof.get("source_dir") != binding["source_dir"] or proof.get("args") != binding["args"]
            or proof.get("compiled_tags") != (["test_state_path_env"] if binding["test_state_path_env"] else [])
            or not native_settled("namespace", proof)):
        raise RuntimeError("original namespace native/IO settlement remains unverified")
    return "suite"

def validate_replay_ack(request, response, response_sha256, ack):
    expected = {"schema": ACK_SCHEMA, "request_nonce": request["nonce"],
                "request_sha256": response["request_sha256"], "response_sha256": response_sha256,
                "run": response["run"], "receipt_sha256": response["receipt_sha256"],
                "exit_code": response["exit_code"], "streams": response["replay"],
                "replayed_identical": True}
    finished = ack.get("finished_monotonic_ns")
    if (set(ack) != set(expected) | {"finished_monotonic_ns"}
            or any(ack[key] != value for key, value in expected.items())
            or type(finished) is not int
            or not request["started_ns"] <= finished <= response["replay_deadline_monotonic_ns"]):
        raise RuntimeError("original raw replay acknowledgment is missing, late or unbound")

def event_ledger(lane, expected, rows, exit_code, mandatory=()):
    selected = {(p,t) for p,names in expected.items() for t in names}
    outcomes,started,package_ends = {},collections.Counter(),{}
    package_terminal_counts = collections.Counter()
    duplicates = []
    for event in rows:
        package,test,action = event.get("Package"),event.get("Test"),event.get("Action")
        if test:
            key = (package,test)
            if action == "run":
                started[key] += 1
            if action in TERMINAL:
                if key in outcomes:
                    duplicates.append(key)
                outcomes[key] = action
        elif action in TERMINAL:
            package_terminal_counts[package] += 1
            package_ends[package] = action
    top = {key:action for key,action in outcomes.items() if "/" not in key[1]}
    missing = sorted(selected-set(top))
    unexpected = sorted(set(top)-selected)
    unsettled = sorted(set(started)-set(outcomes))
    terminal_without_start = sorted(set(outcomes)-set(started))
    duplicate_start = sorted(key for key,count in started.items() if count!=1)
    duplicate_package_terminal = sorted(p for p,n in package_terminal_counts.items() if n!=1)
    missing_packages = sorted(set(expected)-set(package_ends))
    unexpected_packages = sorted(set(package_ends)-set(expected))
    unexpected_roots = sorted(key for key in outcomes if (key[0],key[1].split("/",1)[0]) not in selected)
    required_passes = all(outcomes.get(key) == "pass" for key in mandatory)
    passed = (exit_code == 0 and not missing and not unexpected and not duplicates and not unsettled
              and not missing_packages and not unexpected_packages and not unexpected_roots and not duplicate_package_terminal
              and not terminal_without_start and not duplicate_start and required_passes and "fail" not in outcomes.values()
              and "fail" not in package_ends.values())
    result = {"lane":lane,"expected":expected,"exit_code":exit_code,"passed":passed,
              "top_level":[{"package":p,"test":t,"outcome":top.get((p,t),"NOT_RUN")} for p,t in sorted(selected)],
              "all_terminal":[{"package":p,"test":t,"outcome":action} for (p,t),action in sorted(outcomes.items())],
              "started_without_terminal":unsettled,"missing_top_level":missing,"unexpected_top_level":unexpected,
              "duplicate_terminal":duplicates,"duplicate_start":duplicate_start,"terminal_without_start":terminal_without_start,
              "missing_package_terminal":missing_packages,"unexpected_package_terminal":unexpected_packages,"unexpected_test_roots":unexpected_roots,
              "package_terminal":package_ends,"package_terminal_counts":dict(package_terminal_counts),
              "duplicate_package_terminal":duplicate_package_terminal,"mandatory_passes":[list(x) for x in mandatory],
              "mandatory_passes_satisfied":required_passes}
    return result




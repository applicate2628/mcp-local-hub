def begin(args,lane,retain=None):
    if args.name!=core.FULL_RUN.name or args.commit!=core.CACHE_COMMIT:
        raise RuntimeError("fixed current source and run name required")
    producers=core.receive_closed_producers()
    inputs=core.pinned_inputs()
    root=core.private_run(args.name)
    env=core.clean_environment(root)
    run=core.Run(root,env)
    if retain is not None: retain(run)
    try:
        run.receipt.update({"lane":lane,"input_files":inputs,"closed_producer_metadata":producers,
                           "source_context":core.CFG["source_context"],
                           "cache_bootstrap":{"owner":str(root),"path":str(root/"cache-bootstrap.json"),
                                              "sha256":sha(root/"cache-bootstrap.json")},
                           "ambient_opt_ins_absent":["MCPHUB_TARGET_SCHEDULER_QA","MCPHUB_GUI_SPAWN_TESTS"]})
        for path in [Path(__file__),CORE,core.HELPER,core._guard_path,Path(core.CFG["windows_job"]["path"])]:
            run.receipt["input_files"][str(path)]=sha(core.ordinary(path,False))
        run.save()
        run.receipt["source_before"]=core.source_snapshot(run,"before")
        run.receipt["product_test_source_compatibility"]=core.receive_original_source_compatibility(run.receipt["source_before"])
        short_pin,short_record=core.receive_short_temp(run)
        run.receipt["short_temp"]={"input":short_pin,"record":short_record}
        if required(run,[core.GIT,"-C",core.REPO,"status","--porcelain"],"status-before",timeout=30).strip():
            raise RuntimeError("current TestSource must be clean")
        if any(path.exists() for path in SOURCE_RESOURCES):
            raise RuntimeError("pre-existing compiler resource is not owned by this run")
        run.save()
    except BaseException as exc:
        run.finish("FAIL",exc)
        raise
    return run

"""Successor-source literal core using the original native guard and issuer lifetime.
Receives one marked CLI Product, a separate unmarked native Product, and exact
same-source byte maps. No recovered727 private publisher protocol is imported.
"""
import sys
sys.dont_write_bytecode = True
import ctypes, hashlib, importlib.util, json, os, re, shutil, stat, subprocess, time
from pathlib import Path
from types import SimpleNamespace

CONFIG = Path(@@CONFIG_PATH_REPR@@)
CONFIG_SHA256 = @@CONFIG_SHA_REPR@@
raw_config = CONFIG.read_bytes()
if hashlib.sha256(raw_config).hexdigest() != CONFIG_SHA256:
    raise RuntimeError("current literal input configuration changed")
CFG = json.loads(raw_config)
WORK = Path(CFG["task_root"])
REPO = Path(CFG["source_dir"])
RUNS = Path(CFG["runs_root"])
FULL_RUN = RUNS / CFG["run_name"]
FOCUSED_RUN = RUNS / "not-enabled-focused"
CACHE_COMMIT = CFG["source_commit"]
PRODUCT_SOURCE_COMMIT = CFG["source_commit"]
GO, GIT, CC, PWSH, PYTHON = (Path(CFG["tools"][key]["path"]) for key in ("go","git","gcc","pwsh","python"))
WINPS = Path(CFG["canonical_tools"]["powershell"]["path"])
HELPER = Path(@@SCOPE_PATH_REPR@@)
HELPER_SHA = @@SCOPE_SHA_REPR@@
REPARSE = 0x400
BUNDLE_FILES = ("mcphub.exe", "windows-product-identity.json", "mcphub-product/mcphub.exe")
PRODUCT_SYSO = REPO / "cmd/mcphub/zz_product_versioninfo.syso"
CLI_SYSO = REPO / "internal/cli/zz_qualified_cli_versioninfo_windows_amd64.syso"
API_SYSO = REPO / "internal/api/zz_qualified_api_versioninfo_windows_amd64.syso"
CACHE_BOOTSTRAP = None
TOOL_RECORDS = {name:dict(row, configured=row["path"], resolved=row["path"])
                for name,row in CFG["tools"].items()}

def require(ok, message):
    if not ok:
        raise RuntimeError(message)

def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def new_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("x", encoding="utf-8", newline="\n") as f:
        json.dump(value, f, indent=2)
        f.write("\n")

def ordinary(path, directory=None):
    path = Path(os.path.abspath(path))
    for p in list(reversed(path.parents)) + [path]:
        info = p.lstat()
        if getattr(info, "st_file_attributes", 0) & REPARSE or stat.S_ISLNK(info.st_mode):
            raise RuntimeError("reparse path refused: " + str(p))
    if directory is True and not path.is_dir():
        raise RuntimeError("directory required: " + str(path))
    if directory is False and not path.is_file():
        raise RuntimeError("ordinary file required: " + str(path))
    return path


def scope_name(name):
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,80}", name):
        raise ValueError("name must be 1..80 ASCII letters, digits, underscore or hyphen")
    return name

def scope_helper():
    ordinary(HELPER, False)
    if sha(HELPER) != HELPER_SHA:
        raise RuntimeError("private scope helper changed; coordinate and pin its reviewed hash")
    spec = importlib.util.spec_from_file_location("qualified_private_scope", HELPER)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    if module.RUNS != RUNS or module.ARTIFACTS != REPO / ".scratch":
        raise RuntimeError("private scope helper does not bind this source and run parent")
    return module

def private_run(name):
    run = RUNS / scope_name(name)
    security = scope_helper().create_private_run_scope(run)
    new_json(run / "run-scope-security.json", security)
    return run

def tree(root):
    root = ordinary(root, True)
    result = {}
    for p in sorted(root.rglob("*")):
        ordinary(p)
        if p.is_file():
            result[p.relative_to(root).as_posix()] = {"bytes":p.stat().st_size, "sha256":sha(p)}
    return result

def copy_file(src, dst):
    src = ordinary(src, False)
    dst = Path(dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    with src.open("rb") as reader, dst.open("xb") as writer:
        shutil.copyfileobj(reader, writer)
    if sha(src) != sha(dst):
        raise RuntimeError("copy hash mismatch: " + str(src))
    return sha(dst)

def copy_tree(src, dst):
    before = tree(src)
    dst.mkdir(parents=True, exist_ok=False)
    for rel in before:
        copy_file(src / Path(rel), dst / Path(rel))
    if tree(src) != before or tree(dst) != before:
        raise RuntimeError("tree changed during copy")
    return before


def ensure_private_telemetry_off(run):
    parent = ordinary(run / "appdata", True)
    for component in ("go", "telemetry"):
        parent = parent / component
        try:
            parent.mkdir()
        except FileExistsError:
            pass
        ordinary(parent, True)
    mode = parent / "mode"
    try:
        with mode.open("xb") as stream:
            stream.write(b"off")
    except FileExistsError:
        pass
    if ordinary(mode, False).read_bytes() != b"off":
        raise RuntimeError("private telemetry mode must remain exactly off")


# Fixed per-run configuration for both complete literal test phases. This is
# private test environment data; no repository/source or native predicate changes.
HEADLESS_BYTES = (b"projects: []\n"
                  b"gui_log_window: false\n"
                  b"web_dashboard: false\n"
                  b"web_dashboard_open_on_launch: false\n")
HEADLESS_SHA = "96f52df38eddbfd3bef53d29ca5f445099a2c63e292b06be8c63616172ec1484"
HEADLESS_SETTINGS = {"gui_log_window": False, "web_dashboard": False, "web_dashboard_open_on_launch": False}


def headless_config_snapshot(root, raw):
    """Pure DATA for our own generated YAML; matching the headless10 predicate."""
    if type(raw) is not bytes or len(raw) > 1 << 20:
        raise RuntimeError("headless configuration exceeds its fixed bound")
    text = raw.decode("utf-8").replace("\r\n", "\n")
    for key in HEADLESS_SETTINGS:
        if (len(re.findall(r"^" + key + r"[ \t]*:", text, re.MULTILINE)) != 1
                or len(re.findall(r"^" + key + r":[ \t]*false[ \t]*(?:#.*)?$", text, re.MULTILINE)) != 1):
            raise RuntimeError("private headless setting changed: " + key)
    if len(re.findall(r"^projects[ \t]*:", text, re.MULTILINE)) != 1:
        raise RuntimeError("required Serena projects field is missing or duplicated")
    return {"path": str(Path(root) / "profile/serena_config.yml"), "bytes": len(raw),
            "sha256": hashlib.sha256(raw).hexdigest(), "settings": dict(HEADLESS_SETTINGS),
            "projects_are_mutable_output": True}


def prepare_headless_environment(root, env):
    """Exclusive immutable seed and mutable private copy, before any test launch."""
    root = ordinary(root, True)
    if root.parent != RUNS or hashlib.sha256(HEADLESS_BYTES).hexdigest() != HEADLESS_SHA:
        raise RuntimeError("fixed private headless scope and seed required")
    for path in (root / "headless-config-input.yml", root / "profile/serena_config.yml"):
        ordinary(path.parent, True)
        with path.open("xb") as stream:
            stream.write(HEADLESS_BYTES)
            stream.flush()
            os.fsync(stream.fileno())
        if sha(ordinary(path, False)) != HEADLESS_SHA:
            raise RuntimeError("new private headless configuration differs")
    env["SERENA_HOME"] = str(root / "profile")


def receive_headless_before(root, env):
    """Called immediately before the original full-suite owner is acquired."""
    root = ordinary(root, True)
    seed, config = root / "headless-config-input.yml", root / "profile/serena_config.yml"
    if env.get("SERENA_HOME") != str(root / "profile") or root.parent != RUNS:
        raise RuntimeError("actual full-suite headless environment escaped its private scope")
    for path in (seed, config):
        with ordinary(path, False).open("rb") as stream:
            raw = stream.read((1 << 20) + 1)
        if raw != HEADLESS_BYTES or hashlib.sha256(raw).hexdigest() != HEADLESS_SHA:
            raise RuntimeError("fixed headless seed/config changed before suite creation")
    return {"schema": "serena-private-headless-config-v1",
        "seed": {"path": str(seed), "sha256": HEADLESS_SHA, "bytes": len(HEADLESS_BYTES)},
        "mutable_config": str(config), "settings": dict(HEADLESS_SETTINGS), "initial_projects_empty": True,
        "before": headless_config_snapshot(root, HEADLESS_BYTES), "before_launch_verified": True,
        "scope": "supported private headless configuration; default GUI behavior is not qualified"}


def receive_headless_after(root, env, record):
    """Read only after original native/IO closure; projects are mutable output."""
    root = ordinary(root, True)
    seed, config = root / "headless-config-input.yml", root / "profile/serena_config.yml"
    if (root.parent != RUNS or env.get("SERENA_HOME") != str(root / "profile")
            or record.get("schema") != "serena-private-headless-config-v1"
            or record.get("seed") != {"path": str(seed), "sha256": HEADLESS_SHA, "bytes": len(HEADLESS_BYTES)}
            or record.get("mutable_config") != str(config) or record.get("settings") != HEADLESS_SETTINGS
            or record.get("initial_projects_empty") is not True or record.get("before_launch_verified") is not True
            or record.get("before") != headless_config_snapshot(root, HEADLESS_BYTES)
            or record.get("scope") != "supported private headless configuration; default GUI behavior is not qualified"):
        raise RuntimeError("original full-suite headless configuration binding differs")
    with ordinary(seed, False).open("rb") as stream:
        seed_raw = stream.read((1 << 20) + 1)
    if seed_raw != HEADLESS_BYTES or hashlib.sha256(seed_raw).hexdigest() != HEADLESS_SHA:
        raise RuntimeError("immutable headless input changed during the full suite")
    with ordinary(config, False).open("rb") as stream:
        raw = stream.read((1 << 20) + 1)
    return headless_config_snapshot(root, raw)




def checked_input(row):
    require(isinstance(row,dict) and set(row)=={"path","sha256"}
            and isinstance(row["sha256"],str) and re.fullmatch("[0-9a-f]{64}",row["sha256"]),
            "an explicit path/SHA256 input is required")
    path=ordinary(row["path"],False)
    require(str(path)==row["path"] and sha(path)==row["sha256"],"current input bytes differ: "+str(path))
    return path

def read_input(row):
    return json.loads(checked_input(row).read_text(encoding="utf-8-sig"))

def receive_closed_producers():
    facts=[]
    require(CFG["closed_producer_receipts"],"original producer closures must be supplied")
    for pin in CFG["closed_producer_receipts"]:
        value=read_input(pin)
        require(value.get("terminal_exit_received") is True
                and value.get("parent_capture_files_closed") is True
                and value.get("physical_complete") is True,
                "original producer physical completion is not received")
        facts.append({"input":pin,"original_status":value.get("status"),
                      "original_exit_code":value.get("exit_code"),"qualification_inherited":False})
    return facts

def pinned_inputs():
    result={str(CONFIG):CONFIG_SHA256}
    pairs=[*CFG["tools"].values(),*CFG["controllers"].values(),*CFG["canonical_tools"].values(),
           *CFG["serena_preparation_tools"].values(),*CFG["closed_producer_receipts"],
           CFG["source_context"],CFG["source_snapshot"],CFG["product_snapshot"],
           CFG["guard"],CFG["windows_job"],CFG["cache_copy"],CFG["cache_parent"]]
    for role in ("product","native_product"):
        entry=CFG[role]
        pairs.extend(entry[key] for key in ("inputs","build_plan","fixture"))
        if role=="product": pairs.append(entry["compiler_resource"])
    if CFG["acceptance"]["migration_fixture"] is not None:
        pairs.append(CFG["acceptance"]["migration_fixture"])
    pairs += [{"path":path,"sha256":digest} for path,digest in CFG["input_files"].items()]
    for row in pairs:
        checked_input(row); result[row["path"]]=row["sha256"]
    require(re.fullmatch("[0-9a-f]{40}",CACHE_COMMIT)
            and re.fullmatch("[0-9a-f]{40}",CFG["source_tree"])
            and CFG["source_file_count"]==3369,
            "concrete reviewed successor commit/tree and complete 3369-path map required")
    return result

def unique_object(pairs):
    value={}
    for key,item in pairs:
        require(key not in value,"duplicate JSON input field: "+key)
        value[key]=item
    return value

def create_short_temp(run, owner, scope):
    """Create only fresh temp directories through the existing private helper."""
    cfg = CFG
    run, owner = Path(run), Path(owner)
    require(owner == FULL_RUN
            and (run == owner or run.parent == owner.parent and re.fullmatch(r"x[0-9a-f]{12}", run.name)),
            "short temp requires the actual full run or its existing adapter name")
    parent = Path(cfg["short_temp_parent"])
    parent_record = owner / "short-temp-parent-security.json"
    if run == owner:
        require(not os.path.lexists(parent), "fresh short temp parent already exists")
        creation = scope._create_private_scope(parent, parent.parent, ())
        new_json(parent_record, creation)
    else:
        creation = json.loads(ordinary(parent_record, False).read_text(encoding="utf-8"), object_pairs_hook=unique_object)
    rows = creation.get("directories", [])
    require(creation.get("scope") == str(parent) and len(rows) == 1
            and rows[0].get("path") == str(parent) and rows[0].get("created_exclusively") is True
            and creation.get("existing_objects_mutated") is False and creation.get("recursive_acl_operations") is False,
            "short temp parent lacks its original exclusive creation")
    with scope.open_directory(ordinary(parent, True)) as handle:
        observed = {**scope.directory_identity(handle), **scope.security_receipt(handle, creation["token"]["user_sid"])}
    require(all(rows[0].get(key) == value for key, value in observed.items()), "short temp parent changed")
    temp = parent / ("d" if run == owner else run.name)
    require(len(str(temp)) <= 31 and not os.path.lexists(temp), "one fresh bounded temp child required")
    private = scope._create_private_scope(temp, parent, ())
    record = {"schema": "full-run-short-temp-v1", "owner": str(owner), "consumer": str(run),
        "path": str(temp), "environment_keys": ["TEMP", "TMP", "TMPDIR", "GOTMPDIR"],
        "parent_creation": {"path": str(parent_record), "sha256": sha(parent_record)}, "creation": private,
        "workspace_generation_cwd_max_characters": len(str(temp)) + 216,
        "path_bound_scope": "current Go TempDir name64, suffix<=10, child001, hardened-parent and generation ID; later executable/qualification paths not covered"}
    new_json(run / "short-temp-security.json", record)
    return temp


def serena_preparation_path(controlled_path):
    tools=CFG["serena_preparation_tools"]
    for row in tools.values(): checked_input(row)
    prefixes=[str(ordinary(Path(tools[name]["path"]).parent,True)) for name in ("uv","python")]
    require(len(set(prefixes))==2,"two distinct original preparation tool directories required")
    return os.pathsep.join([*prefixes,controlled_path])

def receive_short_temp(run):
    path=Path(run.root)/"short-temp-security.json"
    pair={"path":str(path),"sha256":sha(path)}
    record=read_input(pair)
    require(record.get("schema")=="full-run-short-temp-v1" and record.get("consumer")==str(run.root)
            and all(run.env.get(key)==record.get("path") for key in record["environment_keys"]),
            "actual full-run temporary environment differs")
    return pair,record

def copy_closed_cache_inputs(owner,environment):
    pin=CFG["cache_copy"]
    raw=checked_input(pin).read_bytes()
    module=SimpleNamespace(__file__=pin["path"],__name__="literal_successor_closed_cache_copy")
    exec(compile(raw,pin["path"],"exec"),module.__dict__)
    parent=checked_input(CFG["cache_parent"])
    require(parent.is_relative_to(WORK),"explicit original closed cache producer must be in the task scope")
    # The independently reviewed donor-copy helper receives its exact PASS
    # producer, full byte inventory and fresh target before copying any cache.
    return module.copy_closed_caches(owner,CFG["cache_parent"]["sha256"],environment)

def snapshot_files(value,expected_count):
    require(value.get("schema")=="reused-graphify-source-snapshot-v1" and set(value)=={"schema","files"}
            and isinstance(value.get("files"),dict) and len(value["files"])==expected_count,
            "exact complete source snapshot schema/count required")
    files={name:row["sha256"] for name,row in value["files"].items()}
    require(all(isinstance(name,str) and not Path(name).is_absolute() and ".." not in Path(name).parts
                and isinstance(digest,str) and re.fullmatch("[0-9a-f]{64}",digest)
                for name,digest in files.items()),"source snapshot path/digest differs")
    return files

def receive_original_source_compatibility(snapshot):
    expected=read_input(CFG["source_snapshot"])
    require(set(expected)=={"head","files"} and expected["head"]==CACHE_COMMIT
            and isinstance(expected["files"],dict) and len(expected["files"])==CFG["source_file_count"]
            and all(isinstance(name,str) and not Path(name).is_absolute() and ".." not in Path(name).parts
                    and isinstance(digest,str) and re.fullmatch("[0-9a-f]{64}",digest)
                    for name,digest in expected["files"].items()),
            "complete current TestSource map required")
    product=snapshot_files(read_input(CFG["product_snapshot"]),CFG["source_file_count"])
    require(snapshot==expected and product==expected["files"],
            "actual TestSource and marked Product source bytes are not identical")
    return {"schema":"successor-product-test-source-identity-v1",
        "test_source_commit":CACHE_COMMIT,"product_source_commit":PRODUCT_SOURCE_COMMIT,
        "source_tree":CFG["source_tree"],"source_file_count":CFG["source_file_count"],
        "all_source_bytes_identical":True,"source_snapshot":CFG["source_snapshot"],
        "product_snapshot":CFG["product_snapshot"],"historical_runtime_qualification_inherited":False}

def receive_product_inputs(role):
    require(role in ("product","native_product"),"one of the two explicit Product roles required")
    cfg=CFG[role]
    value=read_input(cfg["inputs"])
    plan=read_input(cfg["build_plan"])
    marked=role=="product"
    require(value.get("schema")=="current-source-product-receiver-inputs-v1"
            and value.get("source_commit")==CACHE_COMMIT and value.get("build_plan")==plan
            and value.get("build_plan_file",{}).get("sha256")==cfg["build_plan"]["sha256"]
            and plan.get("commit")==CACHE_COMMIT
            and plan.get("testOnly") is (not marked)
            and plan.get("buildTags")==([] if marked else ["test_state_path_env"]),
            "actual same-source marked or isolated-native Product producer differs")
    publisher=value.get("publisher_source",{})
    if marked:
        require(value.get("receiver_linker_flags")==["-s","-w"]
                and value.get("resource",{}).get("sha256")==cfg["compiler_resource"]["sha256"]
                and publisher==plan.get("publisherSource")
                and publisher.get("file_count")==CFG["source_file_count"]
                and publisher.get("source_snapshot_sha256")==CFG["product_snapshot"]["sha256"]
                and isinstance(publisher.get("source_epoch"),str)
                and re.fullmatch("[0-9a-f]{64}",publisher["source_epoch"]),
                "incoming CLI resource/source epoch differs from the actual complete Product issuance")
    else:
        require(not publisher and not plan.get("publisherSource"),
                "native actor Product must be the separate unmarked tagged build")
    root=ordinary(cfg["bundle_root"],True)
    files=tree(root)
    require(set(files)==set(BUNDLE_FILES) and files==value["actual_product"]["files"],
            "complete original three-file Product bundle differs")
    fixture=read_input(cfg["fixture"])
    expected={"product_root":str(root),"source_epoch":publisher["source_epoch"] if marked else "",
              "product_version":plan["version"],"build_id":plan["entrySetBuildID"],
              "reverse_projection":"../mcphub.exe",
              "canonical_entry_sha256":files["mcphub.exe"]["sha256"],
              "product_sha256":files["mcphub-product/mcphub.exe"]["sha256"],
              "identity_sha256":files["windows-product-identity.json"]["sha256"]}
    require(fixture==expected,"Product fixture does not bind its exact original three files")
    result=dict(value)
    result["actual_product"]={"path":str(root),"files":files,"fixture":cfg["fixture"]["path"]}
    result["source_inputs"]={key:cfg[key] for key in ("inputs","build_plan","fixture")}
    if marked: result["resource"]=cfg["compiler_resource"]
    return result



def clean_environment(run, cache_owner=None, *, cache_bootstrap=None):
    run=ordinary(run,True)
    owner=run if cache_owner is None else ordinary(cache_owner,True)
    require(owner==FULL_RUN and (run==owner or run.parent==RUNS and re.fullmatch("x[0-9a-f]{12}",run.name)),
            "one original driver and its explicit original receiver scope required")
    env=dict(CFG["environment"])
    require(not any(key.upper().startswith(("MCPHUB_","PYTHON")) or key.upper() in
                    ("SERENA_HOME","TEST_TELEMETRY_DIR","GIT_ALLOW_PROTOCOL") for key in env),
            "caller environment contains an ambient test/runtime opt-in or Git transport deny-list")
    require(env.get("ProgramFiles")==r"@@RECOVERY_PROGRAM_FILES_RAW@@"
            and env.get("ProgramFiles(x86)")==r"@@RECOVERY_PROGRAM_FILES_X86_RAW@@",
            "explicit received Windows Program Files operands are required")
    temporary=create_short_temp(run,owner,scope_helper())
    directories={"TEMP":temporary,"TMP":temporary,"TMPDIR":temporary,"GOTMPDIR":temporary,
                 "HOME":run/"profile","USERPROFILE":run/"profile","APPDATA":run/"appdata",
                 "LOCALAPPDATA":run/"localappdata","GOPATH":run/"go-path",
                 "GOCACHE":owner/"private/go-build","GOMODCACHE":owner/"private/go-mod"}
    for key,path in directories.items():
        path.mkdir(parents=True,exist_ok=True)
        ordinary(path,True); env[key]=str(path)
    if run==owner:
        copied=copy_closed_cache_inputs(owner,env)
        new_json(owner/"cache-bootstrap.json",{"schema":"literal-independent-cache-copy-successor-v1","owner":str(owner),
             "GOCACHE":env["GOCACHE"],"GOMODCACHE":env["GOMODCACHE"],
             "copy_receipt":{"path":str(owner/"cache-copy-receipt.json"),"sha256":sha(owner/"cache-copy-receipt.json")},
             "original_donor_closed":True,"byte_inventory_received":copied,
             "historical_relocated_cache_authority_inherited":False})
    else:
        require(cache_bootstrap=={"owner":str(owner),"path":str(owner/"cache-bootstrap.json"),
                                  "sha256":sha(owner/"cache-bootstrap.json")},
                "original receiver cache binding differs")
    env.update({"GOROOT":str(GO.parent.parent),"GOENV":"off","GOWORK":"off","GOTOOLCHAIN":"local",
                "GOFLAGS":"-mod=readonly","GOOS":"windows","GOARCH":"amd64","CGO_ENABLED":"1","CC":str(CC),
                "GOTELEMETRY":"off","GIT_OPTIONAL_LOCKS":"0","GIT_TERMINAL_PROMPT":"0",
                "PYTHONDONTWRITEBYTECODE":"1","PYTHONUTF8":"1",
                "PSMODULEANALYSISCACHEPATH":str(run/"localappdata/powershell-module-analysis.cache")})
    ensure_private_telemetry_off(run)
    prepare_headless_environment(run,env)
    return env

class OriginalRun:
    def __init__(self,root,env):
        self.root,self.env=ordinary(root,True),dict(env)
        self.receipt={"schema":"original-literal-successor-run-v1","run":str(root),"commands":[],
                      "status":"RUNNING","started_utc":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime()),
                      "read_only_tool_aliases":TOOL_RECORDS}
        self.save()
    def save(self):
        path=self.root/"receipt.json"
        pending=path.with_name(path.name+".pending")
        with pending.open("w",encoding="utf-8",newline="\n") as stream:
            json.dump(self.receipt,stream,indent=2)
            stream.write("\n"); stream.flush(); os.fsync(stream.fileno())
        os.replace(pending,path)
    def validator(self,flags,name):
        return json.loads(self.command([CFG["controllers"]["validator"]["path"],*flags],name,timeout=10))
    def retain_failed_full_workers(self, failure_published):
        """Keep this actual failed owner; receive closure without changing its gate."""
        if getattr(self, "_failed_full_physical_closed", False):
            return
        pending_exception = sys.exc_info()[0] is not None
        original_receipt = self.root / "receipt.json"
        metadata_error = None
        try:
            original_digest = sha(original_receipt)
        except BaseException as error:
            original_digest = None
            metadata_error = error
        original_states = self.quiescence_snapshot()
        while True:
            try:
                proof = self.receive_failed_worker_closure(time.monotonic() + 30)
                valid = (proof.get("schema") == "failed-original-worker-physical-closure-v1"
                    and proof.get("original_command_states_unchanged") is True
                    and proof.get("capture_access_issued") is False
                    and proof.get("new_commands_permitted") is False
                    and proof.get("qualification_passed") is False
                    and self.quiescence_snapshot() == original_states)
                if (valid and proof.get("status") == "CLOSED" and proof.get("commands")
                        and all(row.get("state") == "CLOSED" for row in proof["commands"])):
                    self._failed_full_physical_receiving = proof
                    self._failed_full_physical_closed = True
                    break
            except BaseException:
                pass
            # The actual Run, native owner and original workers remain retained.
            # This wait grants no qualification time and starts no new work.
            try:
                time.sleep(0.05)
            except BaseException:
                continue
        try:
            new_json(self.root / "failed-original-physical-closure.json", {
                "schema": "literal-full-failed-original-physical-closure-v1", "status": "CLOSED",
                "original_receipt": {"path": str(original_receipt), "sha256": original_digest},
                "receipt_digest_scope": "actual observed on-disk metadata only",
                "original_failure_publication_completed": failure_published,
                "intended_failure_receipt_bound": failure_published and original_digest is not None,
                "original_gate_status": "FAIL", "original_gate_reclassified": False,
                "original_command_states": original_states, "commands_quiescent": False,
                "physical_receiving": proof, "capture_access_issued": False,
                "new_commands_permitted": False, "source_or_cache_access_issued": False,
                "qualification_deadlines_extended": False})
        except BaseException:
            # Preserve an earlier save/print failure after actual physical closure.
            if not pending_exception:
                raise
        if metadata_error is not None and not pending_exception:
            raise metadata_error

    def finish(self, status, error=None):
        owned_failure = (Path(self.root) == FULL_RUN and any(
            item["state"] != "complete" and any(custody.get("run") is self and custody["row"] is item["row"]
                for custody in _guard.RETAINED_COMMANDS)
            for item in self._command_receiving.values()))
        if owned_failure:
            status = "FAIL"
            self.receipt["commands_quiescent"] = False
            self.receipt["command_quiescence"] = self.quiescence_snapshot()
        self.receipt["status"] = status
        self.receipt["finished_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        if error is not None:
            self.receipt["error"] = type(error).__name__+": "+str(error)
        published = False
        self._failure_receipt_published = False
        try:
            self.save()
            published = True
            if owned_failure:
                self._failure_receipt_published = True
            print(json.dumps({"status":status,"run":str(self.root),"receipt":str(self.root/"receipt.json")}), flush=True)
        finally:
            if owned_failure:
                self.retain_failed_full_workers(published)




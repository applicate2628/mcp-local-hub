def source_snapshot(run,suffix):
    head=run.command([GIT,"-C",REPO,"rev-parse","HEAD"],"head-"+suffix,timeout=30).strip()
    require(head==CACHE_COMMIT,"actual current TestSource commit differs")
    paths=run.command([GIT,"-C",REPO,"ls-files","--cached","--others","--exclude-standard","-z"],
                      "source-files-"+suffix,timeout=30).split("\0")
    files={rel:sha(ordinary(REPO/Path(rel),False)) for rel in sorted(set(x for x in paths if x))}
    snapshot={"head":head,"files":files}
    new_json(run.root/("source-"+suffix+".json"),snapshot)
    return snapshot

def bundle_admission(run, bundle, plan, name, *, source_epoch=None):
    if source_epoch is not None and (not re.fullmatch(r"[0-9a-f]{64}",source_epoch)
            or plan.get("publisherSource",{}).get("source_epoch")!=source_epoch):
        raise RuntimeError("marked bundle requires its exact original issued source epoch")
    launcher=bundle/"mcphub.exe"
    product=bundle/"mcphub-product/mcphub.exe"
    identity=bundle/"windows-product-identity.json"
    expected={"build_id":plan["entrySetBuildID"],"canonical_entry_sha256":sha(launcher),
              "product_sha256":sha(product),"identity_sha256":sha(identity)}
    if (set(tree(bundle))!=set(BUNDLE_FILES)
            or expected["canonical_entry_sha256"]!=plan["canonicalEntry"]["expectedCanonicalEntrySHA256"]):
        raise RuntimeError("copied three-file bundle differs from its original launcher")
    common=["--expected-entry-set-build-id",expected["build_id"],
            "--expected-canonical-entry-sha256",expected["canonical_entry_sha256"],
            "--canonical-entry-reverse-projection","../mcphub.exe",
            "--expected-version",plan["version"],"--expected-commit",plan["commit"],"--expected-build-date",plan["buildDate"]]
    observations={}
    for mode,schema in (("validate-entry-set-build","windows-canonical-entry-build-observation-v1"),
                        ("validate-entry-set","windows-canonical-entry-set-v1")):
        flags=["--"+mode,str(launcher),*common]
        if mode=="validate-entry-set-build" and source_epoch is not None:
            flags += ["--expected-source-epoch",source_epoch]
        observed=run.validator(flags,name+"-"+mode)
        if mode=="validate-entry-set-build" and source_epoch is not None and observed.get("source_epoch")!=source_epoch:
            raise RuntimeError("portable entry set lost its original source epoch")
        if observed.get("schema")!=schema or any(observed.get(k)!=v for k,v in expected.items()):
            raise RuntimeError("complete entry-set admission disagrees with original bytes")
        observations[mode]=observed
    fixture={"product_root":str(bundle),"source_epoch":source_epoch or "","product_version":plan["version"],
             "build_id":expected["build_id"],"reverse_projection":"../mcphub.exe",
             "canonical_entry_sha256":expected["canonical_entry_sha256"],"product_sha256":expected["product_sha256"],
             "identity_sha256":expected["identity_sha256"]}
    new_json(run.root/(name+"-fixture.json"),fixture)
    return {"path":str(bundle),"files":tree(bundle),"fixture":str(run.root/(name+"-fixture.json")),"observations":observations}


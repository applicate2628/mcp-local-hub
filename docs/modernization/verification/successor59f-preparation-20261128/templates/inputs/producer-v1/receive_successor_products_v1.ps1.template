 # This receiver handles ordinary started commands and no-command FAIL.
 # Prestart/pre-resume refusal requires the existing exact typed receiver; do not infer it here.
 Require ($c.completion_receiving.lifecycle_state-ceq'CLOSED' -and ($c.original_pid-is[long] -or $c.original_pid-is[int])) ('ordinary original owner required: '+$i)
 Require ($c.original_pid-gt0 -and $c.native_owner.sha256-ceq$p.payload.windows_job -and $c.exit_code-eq$c.native.direct_exit_code -and $c.native.direct_reaped-eq$true -and $c.native.active_zero-eq$true -and $c.native.handles_closed-eq$true -and @($c.native.issues).Count-eq0) ('original process/Job closure: '+$i)
 Require ($c.original_owner_retained-eq$true -and $c.original_readers_retained-eq$true -and $c.original_readers_joined-eq$true -and $c.stdin_mode-ceq'null' -and @($c.worker_join_observations).Count-eq2) ('original reader custody: '+$i)
 Require ($c.completion_receiving.schema-ceq'ordinary-original-native-io-completion-v1' -and (EqualData $c.completion_receiving.native $c.native) -and (EqualData $c.completion_receiving.io $c.io) -and $c.io.Count-eq2) ('received original proof: '+$i)
 foreach($join in $c.worker_join_observations){Require ($join.joined-eq$true -and $join.alive_after-eq$false -and $join.join_error_count-eq0) ('original join: '+$i)}
 foreach($side in @('stdout','stderr')){
  $io=$c.io[$side]
  Require ($io.acquired-eq$true -and $io.worker_started-eq$true -and $io.worker_complete-eq$true -and $io.eof-eq$true -and $io.pipe_close_returned-eq$true -and $io.capture_close_returned-eq$true -and -not $io.error) ('original IO closure: '+$i+' '+$side)
  Require ($c[$side]-ceq($OutputRoot+'\commands\'+$planned.name+'.'+$side+'.txt')) ('original capture operand: '+$i+' '+$side)
 }
}

# Phase 2 starts only after every actual original owner/reader above is CLOSED.
$rows=@();$captureCount=0;$allCommandsSuccessful=($commands.Count-eq12)
for($i=0;$i-lt$commands.Count;$i++){
 $c=$commands[$i];$captures=[ordered]@{}

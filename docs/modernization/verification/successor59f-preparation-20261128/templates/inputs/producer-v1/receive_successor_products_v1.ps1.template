  $measured=Artifact $c[$side]
  Require ($measured.bytes-eq$c.io[$side].bytes_stored) ('closed capture size: '+$i+' '+$side)
  if($c.Contains($side+'_sha256')){Require ($measured.sha256-ceq$c[$side+'_sha256']) ('closed capture SHA: '+$i+' '+$side)}
  $captures[$side]=$measured;$captureCount++
 }
 $ok=($c.command_success-eq$true -and $c.exit_code-eq0 -and $c.timed_out-eq$false -and $c.work_deadline_exceeded-eq$false -and $c.cleanup_deadline_exceeded-eq$false -and $c.native.job_terminated-eq$false -and $c.captures_measured-eq$true -and $c.io.stdout.limit_exceeded-eq$false -and $c.io.stderr.limit_exceeded-eq$false)
 $allCommandsSuccessful=$allCommandsSuccessful-and$ok

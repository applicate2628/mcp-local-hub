$result=[ordered]@{
 schema='successor-product-helper-root-receiving-v1';status=$(if($passed){'PASS'}else{'FAIL'});closure='CLOSED';physical_complete=$true
 original_parent_status=$parent.status;original_execution_status=$r.status;original_exit_code=$parent.exit_code
 source_commit=$Commit;source_tree=$Tree;plan_sha256=$PlanSHA;parent_sha256=(SHA $ParentPath);outer_sha256=(SHA $OuterPath);execution_sha256=(SHA $ExecutionPath)
 actual_commands=$commands.Count;planned_commands=12;input_files_verified=$verified;step_maps_verified=$stepMaps;command_captures_verified=$captureCount;parent_captures=$parentCaptures
 commands=$rows;input_issues=$issues.ToArray();compiled_outputs=$outputs;output_receiving_errors=$outputErrors.ToArray()

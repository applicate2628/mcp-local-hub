 try{if((SHA $path)-ceq$p.input_files[$path]){$verified++}else{$issues.Add('actual input changed: '+$path)}}catch{$issues.Add('actual input unreadable: '+$path)}
}
$originalPass=($parent.status-ceq'PASS' -and $parent.deadline_exceeded-eq$false -and $r.status-ceq'PASS' -and $r.input_files_unchanged-eq$true -and $allCommandsSuccessful -and $stepMaps-eq24 -and @($r.step_inputs).Count-eq12 -and $verified-eq3398 -and $issues.Count-eq0)
$outputs=[ordered]@{};$outputErrors=[Collections.Generic.List[string]]::new()
if($originalPass){
 try{
  $bindingPath=$InputRoot+'\helper-build-bindings-v2.json'
  Require ((SHA $bindingPath)-ceq'd078d88d6455056efc71fd5dfa800d1bd2dd026b8debb41997445590f58b1b01') 'helper binding'
  $binding=ReadData $bindingPath
  $compiledPath=$OutputRoot+'\compiled-inputs.json';$compiled=ReadData $compiledPath
  Require ($compiled.schema-ceq'successor-compiled-inputs-v1' -and $compiled.status-ceq'COMPILED_DATA_ONLY' -and $compiled.source_commit-ceq$Commit -and $compiled.source_tree-ceq$Tree -and $compiled.source_file_count-eq3369 -and $compiled.full_acceptance_executed-eq$false -and $compiled.qualification_passed-eq$false -and $compiled.native_authority_transferred-eq$false) 'compiled DATA scope'
  Require ($compiled.binding.path-ceq$bindingPath -and $compiled.binding.sha256-ceq(SHA $bindingPath) -and $compiled.binaries.Count-eq6 -and $compiled.products.Count-eq2 -and $compiled.staged_sources.Count-eq7) 'compiled DATA inventory'
  $outputs.compiled_inputs=Artifact $compiledPath
  $outputs.preparation=VerifyArtifact $compiled.preparation ($OutputRoot+'\source-helper-preparation.json')
  $prepared=ReadData $compiled.preparation.path
  Require ($prepared.schema-ceq'successor-source-helper-preparation-v1' -and $prepared.status-ceq'STAGED_DATA_ONLY' -and $prepared.source_commit-ceq$Commit -and $prepared.source_tree-ceq$Tree -and $prepared.source_file_count-eq3369 -and $prepared.all_export_source_bytes_equal-eq$true -and $prepared.tracked_source_mutated-eq$false -and (EqualData $prepared.binding $compiled.binding) -and (EqualData $prepared.staged_sources $compiled.staged_sources)) 'prepared source/helper DATA'
  $outputs.binaries=[ordered]@{}
  foreach($role in @('validator','test2json','job','contained','namespace','cli')){$outputs.binaries[$role]=VerifyArtifact $compiled.binaries[$role] $binding.binaries[$role]}
  $outputs.staged_sources=[ordered]@{}
  foreach($role in @('job','contained','namespace','cli')){
   foreach($leaf in $binding.auxiliary_sources[$role].Keys){
    $path=$Source+'\.scratch\'+$binding.scope_names[$role]+'\'+$leaf
    $actual=Artifact $path
    Require ($actual.sha256-ceq$binding.auxiliary_sources[$role][$leaf].sha256 -and $actual.sha256-ceq$compiled.staged_sources[$path].sha256 -and $actual.bytes-eq$compiled.staged_sources[$path].bytes) 'staged source bytes'
    $outputs.staged_sources[$path]=$actual
   }
  }
  $config=ReadData ($InputRoot+'\product-build-config.json')
  $outputs.products=[ordered]@{}
  foreach($role in @('product','native_product')){
   $prefix=if($role-ceq'product'){'marked'}else{'native'}
   $receiptRoot=$config[$prefix+'_receipt_root'];$bundle=$config[$prefix+'_output']
   $inputPath=$receiptRoot+'\product-inputs.json'
   $pin=VerifyArtifact $compiled.products[$role] $inputPath
   $value=ReadData $inputPath;$planPath=$receiptRoot+'\actual-build-plan.json'
   $actualPlanPin=VerifyArtifact $value.build_plan_file $planPath
   $build=ReadData $planPath
   Require ($value.schema-ceq'current-source-product-receiver-inputs-v1' -and $value.source_commit-ceq$Commit -and (EqualData $value.build_plan $build) -and $build.schemaVersion-eq3 -and $build.commit-ceq$Commit -and $build.canonicalEntry.received-eq$true -and $value.actual_product.path-ceq$bundle -and $value.actual_product.files.Count-eq3) 'actual same-source Product'
   $files=[ordered]@{}
   foreach($rel in @('mcphub.exe','windows-product-identity.json','mcphub-product/mcphub.exe')){
    $artifact=Artifact (Join-Path $bundle $rel)
    Require ($artifact.sha256-ceq$value.actual_product.files[$rel].sha256 -and $artifact.bytes-eq$value.actual_product.files[$rel].bytes) 'Product bundle bytes'
    $files[$rel]=$artifact
   }
   $actualNames=@(Get-ChildItem -LiteralPath $bundle -File -Recurse|ForEach-Object{[IO.Path]::GetRelativePath($bundle,$_.FullName).Replace('\','/')}|Sort-Object)
   Require ((EqualData $actualNames @('mcphub-product/mcphub.exe','mcphub.exe','windows-product-identity.json'))) 'exact three Product files'
   $epoch=if($role-ceq'product'){'861852f807c36673755014ef4657bf10252b4e75505bc8b73819bcf8cded7a3a'}else{''}
   if($role-ceq'product'){
    Require ($build.testOnly-eq$false -and @($build.buildTags).Count-eq0 -and $build.buildDate-ceq$config.release_build_date -and (EqualData $value.receiver_linker_flags @('-s','-w')) -and (EqualData $value.publisher_source $build.publisherSource) -and $build.publisherSource.file_count-eq3369 -and $build.publisherSource.source_epoch-ceq$epoch -and $build.publisherSource.source_snapshot_sha256-ceq$config.source_snapshot.sha256) 'marked Product source/resource role'
    $outputs.resource=VerifyArtifact $value.resource ($receiptRoot+'\captured-product-versioninfo.syso')
   }else{Require ($build.testOnly-eq$true -and (EqualData $build.buildTags @('test_state_path_env')) -and -not $build.Contains('publisherSource') -and -not $value.Contains('publisher_source')) 'unmarked tagged native Product role'}
   $fixturePath=$receiptRoot+'\product-fixture.json'
   Require ($value.actual_product.fixture-ceq$fixturePath) 'actual fixture path'
   $fixture=ReadData $fixturePath
   $expected=[ordered]@{product_root=$bundle;source_epoch=$epoch;product_version=$build.version;build_id=$build.entrySetBuildID;reverse_projection='../mcphub.exe';canonical_entry_sha256=$files['mcphub.exe'].sha256;product_sha256=$files['mcphub-product/mcphub.exe'].sha256;identity_sha256=$files['windows-product-identity.json'].sha256}
   Require ((EqualData $fixture $expected) -and $files['mcphub.exe'].sha256-ceq$build.canonicalEntry.expectedCanonicalEntrySHA256) 'exact Product fixture'
   $outputs.products[$role]=[ordered]@{inputs=$pin;build_plan=$actualPlanPin;files=$files;fixture=(Artifact $fixturePath);source_epoch=$epoch;qualification='COMPILED_INPUT_DATA_ONLY'}
  }
  $outputs.cache_copy_receipt=Artifact ($OutputRoot+'\cache-copy-receipt.json')
 }catch{$outputErrors.Add($_.Exception.Message)}
}

Require ($p.schema-ceq'fresh-owned-commands-v1' -and $p.reviewed-eq$true -and $p.output-ceq$OutputRoot -and @($p.commands).Count-eq12 -and $p.input_files.Count-eq3398) 'approved plan scope'
Require ($parent.schema-ceq'fresh-owned-commands-v1-parent' -and $parent.status-in@('PASS','FAIL') -and $parent.physical_complete-eq$true -and $parent.terminal_exit_received-eq$true -and $parent.parent_capture_files_closed-eq$true) 'original parent closure'
Require (-not $parent.Contains('command_capture_access_issued') -or $parent.command_capture_access_issued-eq$true) 'original failure denies capture access'
Require ($outer.schema-ceq'successor-product-helper-original-parent-v1' -and $outer.same_process_start_object-eq$true -and $outer.wait_returned-eq$true -and $outer.original_process_object_disposed-eq$true -and $outer.new_job_or_tree_wait-eq$false -and @($outer.wait_errors).Count-eq0) 'original outer closure'
Require ($outer.exit_code-eq$(if($parent.status-ceq'PASS'){0}else{1}) -and $parent.exit_code-eq$(if($parent.child_status-ceq'PASS'){0}else{1})) 'original exit/status binding'
Require ($parent.plan_sha256-ceq$PlanSHA -and $outer.plan_sha256-ceq$PlanSHA -and $parent.execution_sha256-ceq(SHA $ExecutionPath)) 'original plan/execution pins'
Require ($r.schema-ceq'fresh-owned-commands-v1' -and $r.status-in@('PASS','FAIL') -and $r.status-ceq$parent.child_status -and $r.plan_sha256-ceq$PlanSHA -and (EqualData $r.payload $p.payload)) 'original execution binding'
Require ($r.commands_quiescent-eq$true -and $r.command_quiescence.complete-eq$true) 'unresolved original commands; captures remain unread'
$commands=@($r.commands);$states=@($r.command_quiescence.commands)

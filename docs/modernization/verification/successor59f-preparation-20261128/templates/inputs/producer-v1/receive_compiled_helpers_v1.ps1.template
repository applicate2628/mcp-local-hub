function Require($Value,[string]$Message){if(-not $Value){throw $Message}}
function SHA([string]$Path){
 $a=[Security.Cryptography.SHA256]::Create()
 try{[BitConverter]::ToString($a.ComputeHash([IO.File]::ReadAllBytes($Path))).Replace('-','').ToLowerInvariant()}finally{$a.Dispose()}
}
function ReadData([string]$Path){return ([IO.File]::ReadAllText($Path)|ConvertFrom-Json -AsHashtable -DateKind String)}
function EqualData($Left,$Right){
 if($null-eq$Left -or $null-eq$Right){return ($null-eq$Left -and $null-eq$Right)}
 if($Left-is[Collections.IDictionary]){
  if($Right-isnot[Collections.IDictionary] -or $Left.Count-ne$Right.Count){return $false}
  foreach($key in $Left.Keys){if(-not $Right.Contains($key) -or -not(EqualData $Left[$key] $Right[$key])){return $false}}
  return $true
 }
 if($Left-is[Array]){
  if($Right-isnot[Array] -or $Left.Count-ne$Right.Count){return $false}
  for($index=0;$index-lt$Left.Count;$index++){if(-not(EqualData $Left[$index] $Right[$index])){return $false}}
  return $true
 }
 if($Left-is[bool] -or $Right-is[bool]){return ($Left-is[bool] -and $Right-is[bool] -and $Left-eq$Right)}
 return ($Left-ceq$Right)
}
function Artifact([string]$Path){
 $item=Get-Item -LiteralPath $Path -Force
 Require (-not $item.PSIsContainer) ('regular file required: '+$Path)
 for($ancestor=$item;$null-ne$ancestor;){
  Require (($ancestor.Attributes-band[IO.FileAttributes]::ReparsePoint)-eq0) ('reparse entry: '+$Path)
  $ancestor=if($ancestor-is[IO.FileInfo]){$ancestor.Directory}else{$ancestor.Parent}
 }
 return [ordered]@{path=$Path;bytes=$item.Length;sha256=(SHA $Path)}
}
function VerifyArtifact($Pair,[string]$ExpectedPath){
 Require ($Pair.path-ceq$ExpectedPath -and $Pair.sha256-cmatch'^[0-9a-f]{64}$') 'artifact binding'
 $actual=Artifact $ExpectedPath
 Require ($actual.sha256-ceq$Pair.sha256) ('artifact SHA: '+$ExpectedPath)
 if($Pair.Contains('bytes')){Require ($actual.bytes-eq$Pair.bytes) ('artifact size: '+$ExpectedPath)}
 return $actual
}



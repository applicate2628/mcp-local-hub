+//go:build windows
+
+package main
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestNamespacePrechildRefusalRequiresOriginalUnstartedScope(t *testing.T) {
+	binding := namespaceRefusalBinding{
+		RequestSHA256: strings.Repeat("a", 64), RequestNonce: strings.Repeat("b", 32),
+		Binary: `__APPROVED_WORK_AREA__\fixture\api.exe`, ExpectedSHA256: strings.Repeat("c", 64),
+		SourceDir: `__APPROVED_WORK_AREA__\source\internal\api`, Parent: `__APPROVED_WORK_AREA__\fixture\n`,
+		Args:           []string{"-test.paniconexit0", "-test.v=test2json", "-test.count=1", "-test.timeout=5m"},
+		ControllerArgv: []string{"namespace.exe", "--test-binary", `__APPROVED_WORK_AREA__\fixture\api.exe`},
+	}
+	cause := errors.New("original admission refusal")
+	record, err := namespacePrechildRefusalRecord(binding, true, false, cause)
+	if err != nil || record == nil || record.Schema != "api-namespace-prechild-refusal-v1" ||
+		record.ContainedStageEntered || record.Failure != cause.Error() || !reflect.DeepEqual(record.Binding, binding) {
+		t.Fatalf("original refusal binding changed: record=%+v error=%v", record, err)
+	}
+	for _, tc := range []struct {
+		name         string
+		parentPinned bool
+		stageEntered bool
+		cause        error
+	}{
+		{name: "unadmitted parent", cause: cause},
+		{name: "stage already entered", parentPinned: true, stageEntered: true, cause: cause},
+		{name: "no refusal", parentPinned: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := namespacePrechildRefusalRecord(binding, tc.parentPinned, tc.stageEntered, tc.cause)
+			if err != nil || got != nil {
+				t.Fatalf("ineligible path produced refusal evidence: %+v %v", got, err)
+			}
+		})
+	}
+	legacy := binding
+	legacy.RequestSHA256, legacy.RequestNonce = "", ""
+	if got, err := namespacePrechildRefusalRecord(legacy, true, false, cause); got != nil || err != nil {
+		t.Fatalf("legacy caller acquired a new receipt: %+v %v", got, err)
+	}
+	for _, mutate := range []func(*namespaceRefusalBinding){
+		func(b *namespaceRefusalBinding) { b.RequestSHA256 = "" },
+		func(b *namespaceRefusalBinding) { b.RequestNonce = strings.Repeat("B", 32) },
+		func(b *namespaceRefusalBinding) { b.Parent = `C:\outside` },
+	} {
+		invalid := binding
+		mutate(&invalid)
+		if got, err := namespacePrechildRefusalRecord(invalid, true, false, cause); got != nil || err == nil {
+			t.Fatalf("invalid request/output binding produced a certificate: %+v %v", got, err)
+		}
+	}
+}

+				"product_root":    `__APPROVED_WORK_AREA__\namespace-unused-product`,
+				"source_epoch":    epoch,
+				"product_version": "test",
+				"product_sha256":  expected,
+				"identity_sha256": strings.Repeat("b", 64),
+			}
+			raw, err := json.Marshal(input)
+			if err != nil {

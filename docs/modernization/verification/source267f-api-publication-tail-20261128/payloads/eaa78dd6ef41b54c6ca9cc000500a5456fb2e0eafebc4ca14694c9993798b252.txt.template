    Add-Expected $groups[2] $row[0] ([long]$row[2]) $row[3]
    $counterpartChecks.Add([pscustomobject]@{ source_relative = $row[0]; local_counterpart = $path; bytes = $actual.bytes; sha256 = $actual.sha256 })
}
$verifiedGroups = [Collections.Generic.List[object]]::new()
$totalFiles = 0
$totalBytes = [long]0
foreach ($group in $groups) {
    if ($group.expected.Count -ne $group.expected_count) { throw "Wrong expected filename count: $($group.name)" }
    $actualFiles = Enumerate-PlainFiles $group.source
    if ($actualFiles.Count -ne $group.expected.Count) { throw "Extra or missing files: $($group.name)" }
    foreach ($rel in $actualFiles.Keys) { if (-not $group.expected.ContainsKey($rel)) { throw "Unexpected file: $rel" } }
    $records = [Collections.Generic.List[object]]::new()
    $paths = [string[]]@($group.expected.Keys)
    [Array]::Sort($paths, [StringComparer]::Ordinal)
    $groupBytes = [long]0
    foreach ($rel in $paths) {
        $pin = $group.expected[$rel]
        $actual = Assert-Measurement $actualFiles[$rel] $pin.bytes $pin.sha256
        $records.Add([pscustomobject]@{ path = $rel; bytes = $actual.bytes; sha256 = $actual.sha256 })
        $groupBytes += $actual.bytes
    }
    $verifiedGroups.Add([pscustomobject]@{ source = $group.source; proposed_destination = $group.destination; files = $records.ToArray(); file_count = $records.Count; bytes = $groupBytes; moved = $false })
    $totalFiles += $records.Count
    $totalBytes += $groupBytes
}

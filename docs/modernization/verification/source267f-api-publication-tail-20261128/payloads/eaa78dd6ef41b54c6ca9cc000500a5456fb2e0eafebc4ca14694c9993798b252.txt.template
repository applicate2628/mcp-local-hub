function Assert-PlainPath([string]$Path, [bool]$Directory) {
    $attributes = [IO.File]::GetAttributes($Path)
    if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw "Reparse point refused: $Path" }
    if ((($attributes -band [IO.FileAttributes]::Directory) -ne 0) -ne $Directory) { throw "Wrong path kind: $Path" }
}
function Assert-PlainAncestors([string]$Path) {
    $current = [IO.Path]::GetFullPath($Path)
    while ($current) {
        Assert-PlainPath $current $true
        $parent = [IO.Directory]::GetParent($current)
        if ($null -eq $parent) { break }
        $current = $parent.FullName
    }
}
function Hash-Bytes([byte[]]$Bytes) {
    $hash = [Security.Cryptography.SHA256]::Create()
    try { return [BitConverter]::ToString($hash.ComputeHash($Bytes)).Replace('-', '').ToLowerInvariant() }
    finally { $hash.Dispose() }
}
function Measure-File([string]$Path) {
    Assert-PlainPath $Path $false
    $stream = [IO.File]::Open($Path, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
    $hash = [Security.Cryptography.SHA256]::Create()
    try {
        $size = $stream.Length
        $digest = [BitConverter]::ToString($hash.ComputeHash($stream)).Replace('-', '').ToLowerInvariant()
        if ($stream.Length -ne $size) { throw "File extent changed: $Path" }
        return [pscustomobject]@{ bytes = $size; sha256 = $digest }
    } finally { $hash.Dispose(); $stream.Dispose() }
}
function Assert-Measurement([string]$Path, [long]$Bytes, [string]$Sha256) {
    $actual = Measure-File $Path
    if ($actual.bytes -ne $Bytes -or $actual.sha256 -cne $Sha256) { throw "Byte pin mismatch: $Path" }
    return $actual
}
function Read-PinnedBytes([string]$Path, [long]$Bytes, [string]$Sha256) {
    Assert-PlainPath $Path $false
    $raw = [IO.File]::ReadAllBytes($Path)
    if ($raw.LongLength -ne $Bytes -or (Hash-Bytes $raw) -cne $Sha256) { throw "Receipt pin mismatch: $Path" }
    return ,$raw
}
function Write-NewBytes([string]$Path, [byte[]]$Bytes) {
    $stream = [IO.File]::Open($Path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    try { $stream.Write($Bytes, 0, $Bytes.Length); $stream.Flush($true) }
    finally { $stream.Dispose() }
}
function Add-Expected($Group, [string]$Relative, [long]$Bytes, [string]$Sha256) {
    $rel = $Relative.Replace('\', '/')
    if ([IO.Path]::IsPathRooted($rel) -or $rel -match '(^|/)\.\.?(/|$)|:|//|/$' -or $rel.Length -eq 0) { throw "Invalid relative path: $Relative" }
    if ($Bytes -lt 0 -or $Sha256 -cnotmatch '^[0-9a-f]{64}$') { throw "Invalid byte pin: $Relative" }
    if ($Group.expected.ContainsKey($rel)) { throw "Duplicate expected path: $rel" }
    $Group.expected.Add($rel, [pscustomobject]@{ bytes = $Bytes; sha256 = $Sha256 })
}
function Enumerate-PlainFiles([string]$Root) {
    $result = [Collections.Generic.Dictionary[string,string]]::new([StringComparer]::Ordinal)
    $pending = [Collections.Generic.Stack[string]]::new()
    $pending.Push($Root)
    while ($pending.Count -gt 0) {
        $dir = $pending.Pop()
        Assert-PlainPath $dir $true
        foreach ($entry in [IO.Directory]::EnumerateFileSystemEntries($dir)) {
            $attributes = [IO.File]::GetAttributes($entry)
            if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw "Reparse entry refused: $entry" }
            if (($attributes -band [IO.FileAttributes]::Directory) -ne 0) { $pending.Push($entry); continue }
            $rel = $entry.Substring($Root.Length + 1).Replace('\', '/')
            $result.Add($rel, $entry)
        }
    }
    return ,$result
}


$retained = [Collections.Generic.List[object]]::new()
foreach ($row in $receiptRows) {
    $group = $groups[[int]$row[0]]
    Assert-PlainAncestors $group.source
    $prefix = [string]$row[1]
    $rel = if ($prefix) { $prefix + '/reconstruction-receipt.json' } else { 'reconstruction-receipt.json' }
    $path = Join-Path $group.source $rel
    Assert-PlainAncestors ([IO.Path]::GetDirectoryName($path))
    $raw = Read-PinnedBytes $path ([long]$row[3]) $row[4]
    $receipt = ConvertFrom-Json -InputObject ([Text.Encoding]::UTF8.GetString($raw))
    if ($receipt.schema -cne 'original-v6-exact-data-reconstruction-v1' -or $receipt.status -cne 'EXACT_DATA_RECONSTRUCTED') { throw "Wrong reconstruction schema/status: $path" }
    if ($receipt.source_bindings_sha256 -cne $row[5] -or @($receipt.files).Count -ne [int]$row[2]) { throw "Wrong reconstruction binding/count: $path" }

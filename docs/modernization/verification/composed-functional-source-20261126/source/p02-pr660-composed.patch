+		).Replace(taskDefinitionFixture)},
+		{name: "unordered_settings_and_path_case", xml: strings.NewReplacer(
+			"<Enabled>true</Enabled><Hidden>false</Hidden>", "<Hidden>false</Hidden><Enabled>true</Enabled>",

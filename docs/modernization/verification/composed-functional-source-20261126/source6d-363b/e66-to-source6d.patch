+		if rows[0]["state"] != "Running" {
+			t.Fatalf("snapshot error row state = %v, want Running via port_owner_unverified: %+v", rows[0]["state"], rows[0])
+		}
+		if _, hasStale := rows[0]["stale_pid"]; hasStale {

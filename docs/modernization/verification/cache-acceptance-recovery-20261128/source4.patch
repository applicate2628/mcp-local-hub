+
+func startLostChildEventLoop(t *testing.T, ctx context.Context, loop *api.EventLoop) {
+	t.Helper()
+	loopCtx, cancel := context.WithCancel(ctx)
+	loopDone := make(chan struct{})
+	t.Cleanup(func() {
+		cancel()
+		// A published state can precede the handler's final file write.
+		// Join before fixture cleanup closes the log or removes its directory.
+		<-loopDone
+	})
+	go func() {
+		defer close(loopDone)
+		loop.Run(loopCtx)
+	}()
 }
 

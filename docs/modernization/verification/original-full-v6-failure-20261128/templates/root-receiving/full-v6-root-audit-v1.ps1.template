   'job' {Need ($v.originalWaitKnown -and $v.settlementComplete -and $v.stdoutEOF -and $v.stderrEOF -and $v.streamsJoined -and $v.controlWriterJoined) 'Job original custody incomplete';NativeClosed $v.nativeSettlement}
   default {throw ('Unreviewed owner kind '+$owner.kind)}
  }

$ErrorActionPreference='Stop'
$t='@@RECOVERY_APPROVED_WORK_AREA@@\mcp-acceptance-rebuild-20261127-v1'
function TaskSHA([string]$p){$h=[Security.Cryptography.SHA256]::Create();try{[BitConverter]::ToString($h.ComputeHash([IO.File]::ReadAllBytes($p))).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()}}
function Need($v,[string]$message){if(-not $v){throw $message}}
function SameHash([string]$p,[string]$sha){Need ((TaskSHA $p) -ceq $sha) ('Hash mismatch '+$p)}
function NativeClosed($n){Need ($n.RootWaitKnown -and $n.MembersExited -and $n.AccountingKnown -and $n.FinalActive -eq 0 -and $n.HandlesClosed -and -not $n.Error) 'Original native settlement incomplete'}
function NativeIOClosed($io){
 foreach($name in @('Stdin','StdoutRead','StdoutWrite','StderrRead','StderrWrite')){$v=$io.$name;Need (-not $v.Acquired -or ($v.CloseAttempted -and $v.Closed -and -not $v.CloseError)) ('Native pipe '+$name)}
 foreach($name in @('Stdout','Stderr')){$v=$io.$name;Need ($v.WorkerStarted -and $v.WorkerComplete -and $v.EOF -and -not $v.LimitExceeded -and -not $v.Error) ('Native reader '+$name)}
}
$script:captureCount=0;$script:commandCount=0
function CommandClosed($c){
 Need ($c.quiescence_state -ceq 'complete' -and $c.captures_measured) 'Command closure/captures incomplete'
 if($c.native){
  Need ($c.native.direct_reaped -and $c.native.active_zero -and $c.native.handles_closed -and -not $c.native.issues -and $c.original_readers_joined) 'Native command incomplete'

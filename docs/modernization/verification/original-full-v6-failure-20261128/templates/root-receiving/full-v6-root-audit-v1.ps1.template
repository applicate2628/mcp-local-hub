 if($item.original_replay.exit_code -ne 0){$nonzero+=[ordered]@{phase=$r.phase;package=$item.package;exit=$item.original_replay.exit_code;receipt_sha256=$item.receipt_sha256}}
 foreach($owner in $item.original_owners){

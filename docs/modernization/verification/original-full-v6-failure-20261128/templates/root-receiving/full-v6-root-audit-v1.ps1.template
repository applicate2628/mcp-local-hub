Need ($j.status -ceq 'FAIL' -and -not $j.literal_pre_push_commands_passed -and $j.all_original_invocations_closed -and $j.commands_quiescent -and $j.source_unchanged -and $j.original_inputs_unchanged -and $j.actual_product_unchanged -and $j.private_migration_exports_unchanged) 'Main closed flags differ'

    "url": "https://github.com/applicate2628/mcp-local-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applicate2628/mcp-local-hub.git",
    "directory": "npm"
  },
  "license": "MPL-2.0",
  "author": "Dmitry Denisenko (@applicate2628)",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test sync-version.test.js postinstall.test.js platform-packages.test.js"
  },
  "bin": {
    "mcphub": "bin/cli.js"
  },
  "files": [
    "bin/cli.js",
    "lib/platform-binary.js",
    "scripts/postinstall.js",
    "README.md"
  ],
  "optionalDependencies": {

# Identity (NEVER commit) — age private key that decrypts secrets.age.
.age-key

# Encrypted vault — user policy: keep OUT of git, transfer manually.
# Even though secrets.age is ciphertext (safe with .age-key absent),
# user preference is no secrets in repo at all. Transfer both files
# between machines via password manager / encrypted USB / scp.
secrets.age

# Local config (gitignored per §3.8 of spec)
config.local.yaml

# Build outputs — drops from `go build ./cmd/<name>` at repo root
/mcp
/mcp.exe
/mcp.exe~
/mcphub
/mcphub.exe
/mcphub.exe~
/godbolt
/godbolt.exe
/godbolt.exe~
/lldb-bridge
/lldb-bridge.exe
/lldb-bridge.exe~
/perftools
/perftools.exe
/perftools.exe~
/bin/

# Build outputs from in-directory `go build` inside cmd/* — not the
# canonical path (root is), but some workflows still land them here.
/cmd/mcphub/mcphub.exe
/cmd/mcphub/mcphub.exe~
/cmd/godbolt/godbolt.exe
/cmd/godbolt/godbolt.exe~
/cmd/lldb-bridge/lldb-bridge.exe
/cmd/lldb-bridge/lldb-bridge.exe~
/cmd/perftools/perftools.exe
/cmd/perftools/perftools.exe~

# Session reports / transcripts from subagent tooling
/.reports/

# Editor saved-copy backups
*.saved.bak
~*.bak

# Go
*.test
*.prof
coverage.out

# Editor
.vscode/
.idea/
*.swp

# Serena LSP runtime (cache, memories, per-project overrides regenerated at activate_project)
.serena/

# Note: cmd/mcphub/resource.syso is committed (Windows version resource,
# generated from versioninfo.json via `go generate ./cmd/mcphub`). Keeping
# it in the repo so `go build` works without first running goversioninfo.
# Regenerate when versioninfo.json changes, then commit both.

# Tool artifacts from Claude Code / superpowers skills
/.claude/
/.scratch/
/.superpowers/

# Playwright MCP browser session captures (per-session ad-hoc)
/.playwright-mcp/

# tools/genicon leftover binary when invoked via plain `go build` instead
# of `go run`. Canonical generation is `go run ./tools/genicon`; an .exe
# in the repo root would otherwise sneak into commits.
/genicon.exe
/tools/genicon/genicon.exe

# Ad-hoc smoke-test screenshots dropped in repo root by interactive
# sessions. Real evidence belongs in .scratch/ per the canonical
# convention; smoke-* / a3-* / b1-* are old patterns from pre-v0.5.0
# sessions that should never be committed to master.
/smoke-*.png
/a3-*.png
/b1-*.png

# Internal consolidated roadmap (carries paid-tier split — keep OUT of the public repo)
work-items/ROADMAP.md
work-items/roadmap-scan-*.md

# Stray build/vet/test output redirects accidentally created in the repo root —
# e.g. `go build > r:\Temp\build_out.txt` whose Windows path collapsed into a
# literal repo-root filename (the ':' becomes a PUA glyph). Also a bare `> null`.
*build_out.txt
*vet_out.txt
*test_out.txt
/null
graphify-out/
